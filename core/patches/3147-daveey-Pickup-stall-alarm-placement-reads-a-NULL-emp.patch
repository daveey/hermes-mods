From f102cd3370dd3561671d2458214bf70b38eb8848 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 04:35:34 +0000
Subject: [PATCH] [daveey] Pickup-stall alarm placement reads a NULL/empty
 assignee as profile:default like the Board

alarm_placement and _replace_stranded built profile:{assignee} raw, so a NULL or
empty assignee produced profile:None / profile: (no machine attests it), unlike the
Board's requiredLabels and kanban_repin_notice.required_labels, which read it as
profile:default. Latent today (alarm rows get _supervisor_profile()), but a card
with no assignee would look stranded on a healthy pin and be re-placed. Both spots
now share _profile_label(assignee) = profile:{assignee or 'default'}.

Proof: tests/hermes_cli/test_kanban_pickup_alarm_placement.py gains
test_a_null_or_empty_assignee_needs_profile_default_like_the_board and
test_an_alarm_with_no_assignee_is_judged_as_profile_default_and_not_re_pinned
(None and ''): 4 RED on base, GREEN with the fix; 7 pickup-stall suites 209 passed;
scripts/check --base origin/main ok.

Card: t_01a1d32a914ed152 (nit from review t_01a1d32444038288 of PR #1869)
---
 hermes_cli/kanban_pickup_stall.py             | 12 ++++++++---
 .../test_kanban_pickup_alarm_placement.py     | 21 +++++++++++++++++++
 2 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_pickup_stall.py b/hermes_cli/kanban_pickup_stall.py
index 995aa9f13b..da3e3ff927 100644
--- a/hermes_cli/kanban_pickup_stall.py
+++ b/hermes_cli/kanban_pickup_stall.py
@@ -298,7 +298,13 @@ def _ready_now(entry: Mapping[str, Any], now_ms: int) -> bool:
     return free is None or free > 0
 
 
-def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]], *, assignee: str,
+def _profile_label(assignee: Optional[str]) -> str:
+    """``profile:<assignee>``, a NULL/empty assignee read as ``default`` like the Board's ``requiredLabels`` and
+    :func:`hermes_cli.kanban_repin_notice.required_labels` (never ``profile:None`` or ``profile:``)."""
+    return f"profile:{assignee or 'default'}"
+
+
+def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]], *, assignee: Optional[str],
                     requires: tuple[str, ...] = _REQUIRES, now_ms: Optional[int] = None,
                     ) -> tuple[Optional[list[str]], str]:
     """``(runs_on, why)`` for an alarm about machine ``own``; never ``machine:<own>``. ``machines`` is the registry
@@ -309,7 +315,7 @@ def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]
     from hermes_cli import kanban_worker_node as wn
     now_ms = _now_ms() if now_ms is None else now_ms
     from hermes_cli.kanban_placement_coordination import requirement_label
-    need = {requirement_label(r) for r in requires} | {f"profile:{assignee}"}
+    need = {requirement_label(r) for r in requires} | {_profile_label(assignee)}
     if machines is None:
         if own != OPERATOR_LANE:
             return [f"machine:{OPERATOR_LANE}"], f"the machine registry is unreadable from {own}: hub operator lane"
@@ -355,7 +361,7 @@ def _replace_stranded(conn, task_id: str, own: str, machines, runs_on: list[str]
                            (task_id,)).fetchone()
         if row is None or row["status"] in ("running", "done", "archived") or row["claim_lock"] is not None:
             return
-        need = {requirement_label(r) for r in _REQUIRES} | {f"profile:{row['assignee']}"}
+        need = {requirement_label(r) for r in _REQUIRES} | {_profile_label(row["assignee"])}
         if not _stranded(row["runs_on"], own, machines, need) or wn._parse(row["runs_on"]) == runs_on:
             return
         wn.set_runs_on(conn, task_id, runs_on)
diff --git a/tests/hermes_cli/test_kanban_pickup_alarm_placement.py b/tests/hermes_cli/test_kanban_pickup_alarm_placement.py
index 5eaa9cfae1..85f5670e19 100644
--- a/tests/hermes_cli/test_kanban_pickup_alarm_placement.py
+++ b/tests/hermes_cli/test_kanban_pickup_alarm_placement.py
@@ -169,6 +169,19 @@ def test_an_alarm_on_a_healthy_machine_stays_when_a_better_one_appears(gws, monk
     assert _pin(worker.conn, alarm) == [f"machine:{OTHER}"] and not _replaced(worker.conn, alarm)
 
 
+@pytest.mark.parametrize("assignee", [None, ""])
+def test_an_alarm_with_no_assignee_is_judged_as_profile_default_and_not_re_pinned(gws, monkeypatch, assignee):
+    # t_01a1d32a914ed152: the Board reads a NULL/empty assignee as profile:default; ``profile:None``/``profile:``
+    # made the healthy pin look stranded, so it moved to the newly better machine with a Re-placed comment.
+    worker, alarm = _held_alarm(gws, monkeypatch)
+    with kb.write_txn(worker.conn):
+        worker.conn.execute("UPDATE tasks SET assignee = ? WHERE id = ?", (assignee, alarm))
+    monkeypatch.setitem(support.MACHINES, "worker-3", _worker("worker-3", metrics={"active_card_runs": 0}))
+    worker.enter()
+    kps.sweep(worker.conn)
+    assert _pin(worker.conn, alarm) == [f"machine:{OTHER}"] and not _replaced(worker.conn, alarm)
+
+
 def test_a_stranded_alarm_already_on_the_only_choice_is_not_re_commented(gws, monkeypatch):
     worker, alarm = _held_alarm(gws, monkeypatch, other=False, hub=_hub(hold=True))
     assert _pin(worker.conn, alarm) == [f"machine:{HUB}"]  # held too, but not the stalled machine
@@ -291,6 +304,14 @@ def test_an_alarm_about_the_hub_lands_on_a_worker():
     assert _place(pool, own=HUB) == ["machine:worker-3"]
 
 
+@pytest.mark.parametrize("assignee", [None, ""])
+def test_a_null_or_empty_assignee_needs_profile_default_like_the_board(assignee):
+    pool = _pool(**{"worker-3": _worker("worker-3", last_seen=NOW)})
+    assert kps.alarm_placement(WORKER, pool, assignee=assignee, now_ms=NOW)[0] == ["machine:worker-3"]
+    off_hub = kps.alarm_placement(HUB, None, assignee=assignee, now_ms=NOW)[0] or []
+    assert "profile:default" in off_hub and not {"profile:None", "profile:"} & set(off_hub)
+
+
 @pytest.mark.parametrize("runs_on,machines,want", [
     ([f"machine:{WORKER}"], None, True),  # pinned to M: stranded even with no registry
     (["machine:worker-3"], None, False),  # unknown without a registry: left alone
-- 
