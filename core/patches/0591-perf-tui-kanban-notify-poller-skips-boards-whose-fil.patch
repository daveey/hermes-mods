From d6abd375a165a052183a1d4b86ef78f3cacd7466 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:34:04 -0700
Subject: [PATCH] perf(tui): kanban notify poller skips boards whose files have
 not moved [daveey]

Every live chat polls every board every 5 s; with a subscription it opens
the board writable and runs a claim per sub even when nothing was
committed. With 21 open chats this was ~10% of the Desktop backend's busy
samples (py-spy, 2026-10-27). Record each board's kanban.db/-wal file
signature (mtime_ns, size, inode) per session before polling and skip the
board while it is unchanged; any commit (new event, claim, rewind) moves
it and is polled on the next tick. Consumer-health `polled` still fires.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../tui_gateway/test_kanban_notify_poller.py  | 30 +++++++++++++
 tui_gateway/session_notifications.py          | 43 +++++++++++++++++--
 2 files changed, 70 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_kanban_notify_poller.py b/tests/tui_gateway/test_kanban_notify_poller.py
index 691b36bc27..a67b66dfe8 100644
--- a/tests/tui_gateway/test_kanban_notify_poller.py
+++ b/tests/tui_gateway/test_kanban_notify_poller.py
@@ -385,3 +385,33 @@ class TestPollerReadsOnlyItsOwnSubscriptions:
 
         assert fetched == [1]
         assert len(texts) == 1 and tid in texts[0] and "mine finished" in texts[0]
+
+
+class TestUnchangedBoardSkip:
+    """A live chat polls every board every 5 s; a board whose files have not moved since its last poll is skipped
+    (no writable open, no claim), and any commit (a completion) is picked up on the next tick."""
+
+    def test_unchanged_board_is_not_reopened_and_a_commit_is_delivered(self):
+        tid = _create_subscribed_task()
+        session = _session()
+        assert _collect_kanban_notifications(session) == []  # first poll: nothing yet, records the board signature
+        assert _collect_kanban_notifications(session) == []  # its own (empty) claim may move the files once
+        with patch.object(kbc, "connect", wraps=kbc.connect) as opened, \
+                patch.object(kbn, "count_notify_subs", wraps=kbn.count_notify_subs) as probed:
+            assert _collect_kanban_notifications(session) == []
+            assert opened.call_count == 0 and probed.call_count == 0
+        _complete(tid)
+        texts = _collect_kanban_notifications(session)
+        assert len(texts) == 1 and tid in texts[0]
+        assert session["_kb_board_seen"]
+
+    def test_skip_is_per_session(self):
+        tid = _create_subscribed_task()
+        quiet = _session()
+        _collect_kanban_notifications(quiet)
+        _collect_kanban_notifications(quiet)
+        _complete(tid)
+        # a different session (no recorded signature) still polls; the subscribed one delivers once
+        assert _collect_kanban_notifications(_session("someone-else")) == []
+        texts = _collect_kanban_notifications(quiet)
+        assert len(texts) == 1 and tid in texts[0]
diff --git a/tui_gateway/session_notifications.py b/tui_gateway/session_notifications.py
index f32e3b99f4..122bbc0be6 100644
--- a/tui_gateway/session_notifications.py
+++ b/tui_gateway/session_notifications.py
@@ -420,12 +420,48 @@ def _kb_board_key(_kb, board_meta) -> tuple[str, str]:
         return slug, f"slug:{slug}"
 
 
-def _kb_poll_board(_kb, slug: str, session_key: str, claims: list | None = None) -> list:
+def _kb_board_file_sig(db_path) -> tuple | None:
+    """(mtime_ns, size, inode) of a board's kanban.db and -wal: every commit (a new event, a claim) moves one of them."""
+    import os
+    out = []
+    for path in (str(db_path), f"{db_path}-wal"):
+        try:
+            st = os.stat(path)
+        except OSError:
+            out.append(None)
+            continue
+        out.append((st.st_mtime_ns, st.st_size, st.st_ino))
+    return tuple(out) if out[0] is not None else None
+
+
+def _kb_poll_board(_kb, slug: str, session_key: str, claims: list | None = None, seen: dict | None = None) -> list:
     """Claim + format this session's unseen events on one board. One poller per live session: the board is not opened
     writable unless it has a subscription owned by this exact session (a failed read-only probe — locked/corrupt DB —
-    falls through so delivery is preserved)."""
+    falls through so delivery is preserved).
+
+    *seen* (the session's ``{db path: file signature}``) skips a board whose files have not moved since this
+    session's last completed poll: no commit means no new event to claim. 21 open chats each probing every board
+    every 5 s, and opening it writable to re-claim nothing, kept the Desktop backend busy. The signature is taken
+    before the poll, so a commit during it is polled again next tick."""
     from hermes_cli import kanban_db_connect as _kbc
     from hermes_cli import kanban_db_notify as _kbn
+    db_path = sig = None
+    if seen is not None:
+        with contextlib.suppress(Exception):
+            db_path = str(_kb.kanban_db_path(board=slug))
+            sig = _kb_board_file_sig(db_path)
+        if sig is not None and seen.get(db_path) == sig:
+            from hermes_constants import get_hermes_home
+            from tui_gateway.kanban_consumer_health import polled
+            polled(get_hermes_home(), session_key, db_path)
+            return []
+    texts = _kb_poll_board_now(_kb, _kbc, _kbn, slug, session_key, claims)
+    if sig is not None:
+        seen[db_path] = sig
+    return texts
+
+
+def _kb_poll_board_now(_kb, _kbc, _kbn, slug: str, session_key: str, claims: list | None) -> list:
     with contextlib.suppress(Exception):
         if _kbn.count_notify_subs(board=slug, platform="tui", chat_id=session_key) == 0:
             return []
@@ -499,7 +535,8 @@ def _collect_kanban_notifications(session: dict, claims: list | None = None) ->
     unique = {}
     for slug, resolved in (_kb_board_key(_kb, board_meta) for board_meta in boards):
         unique.setdefault(resolved, slug)
-    return [t for slug in unique.values() for t in _kb_poll_board(_kb, slug, session_key, claims)]
+    seen = session.setdefault("_kb_board_seen", {})
+    return [t for slug in unique.values() for t in _kb_poll_board(_kb, slug, session_key, claims, seen)]
 
 
 def _notif_poll_kanban(sid: str, session: dict) -> None:
