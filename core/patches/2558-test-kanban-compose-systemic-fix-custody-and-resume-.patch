---
 .../test_kanban_real_board_systemic.py        | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_real_board_systemic.py

diff --git a/tests/hermes_cli/test_kanban_real_board_systemic.py b/tests/hermes_cli/test_kanban_real_board_systemic.py
new file mode 100644
index 0000000000..e715e41d8f
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_real_board_systemic.py
@@ -0,0 +1,68 @@
+"""Systemic crash custody crosses the real Board transport, then resumes."""
+import json
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as dispatch
+from hermes_cli import kanban_db_sync as sync, kanban_sync_client as client
+from hermes_cli import kanban_owner_recovery as recovery
+from tests.hermes_cli import kanban_sync_support as support
+from tests.hermes_cli import test_kanban_real_board_failure as bridge_support
+
+board_peer = bridge_support.board_peer
+
+
+def test_systemic_release_links_unpushed_fix_and_resumes_after_completion(tmp_path, monkeypatch, board_peer):
+    _bridge, hub = board_peer
+    home = support.kanban_home(tmp_path, monkeypatch)
+    support.write_sync_config(home, True)
+    conn = kbc.connect(home / 'kanban.db')
+    client.ensure_identity(conn, 'default', 'failure-fixture')
+    sync.set_mode(conn, 'primary')
+    previous = sync.set_lease_client(client.HubLeaseClient(hub))
+    def flush():
+        result = client.push(conn, hub, 'default', 'failure-fixture', primary=True)
+        assert result.rejected == 0
+        client.pull(conn, hub, 'default', observers=True)
+    try:
+        tasks = [kb.create_task(conn, title=f'systemic fixture {i}', assignee='worker', runs_on=[])
+                 for i in range(3)]
+        flush()
+        for tid in tasks:
+            assert kb.claim_task(conn, tid, ttl_seconds=900, claimer=kb._host_prefix() + 'fixture')
+            with kbc.write_txn(conn):
+                conn.execute('UPDATE tasks SET worker_pid=987654, started_at=1 WHERE id=?', (tid,))
+        flush()
+        monkeypatch.setattr(dispatch, '_worker_alive', lambda *a: False)
+        monkeypatch.setattr(recovery, 'owner_reclaim_blocked', lambda *a, **kw: False)
+        monkeypatch.setattr(recovery, 'managed_run_exit_code', lambda *a: 1)
+        monkeypatch.setattr(recovery, 'apply_attempt_note', lambda *a: None)
+        monkeypatch.setattr(dispatch._host_reboot, 'victims', lambda *a: (None, []))
+        monkeypatch.setattr(dispatch._host_reboot, 'note', lambda *a: None)
+        monkeypatch.setattr(dispatch._owner_death, 'note', lambda *a: None)
+        monkeypatch.setattr(dispatch, '_classify_dead_worker', lambda *a, **kw:
+                            dispatch._DeadWorker('crashed', 1, 'same systemic fixture error', 'crashed', {'exit_code': 1}))
+        assert set(dispatch.detect_crashed_workers(conn)) == set(tasks)
+        fixes = conn.execute("SELECT id FROM tasks WHERE idempotency_key LIKE 'systemic-crash:%'").fetchall()
+        assert len(fixes) == 1
+        fix = fixes[0]['id']
+        assert dispatch.detect_crashed_workers(conn) == []
+        flush()
+        remote_links = hub.snapshot_page('default', 'task_links')['rows']
+        assert {r['child_id'] for r in remote_links if r['parent_id'] == fix} == set(tasks)
+        for tid in tasks:
+            row = conn.execute('SELECT status,consecutive_failures FROM tasks WHERE id=?', (tid,)).fetchone()
+            assert tuple(row) == ('triage', 1)
+            events = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='gave_up'", (tid,)).fetchall()
+            assert len(events) == 1
+            assert not json.loads(events[0]['payload']).get('fix_card_link_failed')
+        kb.recompute_ready(conn)
+        assert all(kb.get_task(conn, tid).status == 'triage' for tid in tasks)
+        assert kb.complete_task(conn, fix, summary='fixture owner completed')
+        flush()
+        kb.recompute_ready(conn)
+        flush()
+        assert all(kb.get_task(conn, tid).status == 'ready' for tid in tasks)
+        remote = {r['id']: r for r in hub.snapshot_page('default', 'tasks')['rows']}
+        assert all(remote[tid]['status'] == 'ready' for tid in tasks)
+    finally:
+        sync.set_lease_client(previous)
+        conn.close()
