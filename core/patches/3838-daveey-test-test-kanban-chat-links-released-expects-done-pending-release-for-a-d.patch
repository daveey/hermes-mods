From d9cbfd19f887dbd1951b6760231cdca6be1c0836 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:12:46 +0000
Subject: [PATCH] [daveey] test: test_kanban_chat_links_released expects
 done_pending_release for a done, unreleased replica link

Problem: required CI red on PR #2433 head 3d1598f31bb8 (run 43495122574, Python tests 8/8):
test_a_closed_card_reader_lists_no_other_profiles_released_link expected ('t_unreleased', 'unknown', False).
Why 1: that test landed on main (027f934ea5a, pins #2312's claims) after #2433 was reviewed; it pinned the old
'unknown' label for a done replica card whose link the owner has not released yet.
Why 2: #2433 changes exactly that label to done_pending_release (the card's point); the land-lane turn rebase was
textually clean, so range-diff showed '=' and only CI could see the semantic conflict.
Fix: the fixture's t_unreleased row now expects done_pending_release (released stays False). No production change.
Proof: 34 test files importing kanban_chat_links / release / remote outcomes: 654 passed.
---
 tests/hermes_cli/test_kanban_chat_links_released.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_chat_links_released.py b/tests/hermes_cli/test_kanban_chat_links_released.py
index 97acdaf054..49d95ed0d3 100644
--- a/tests/hermes_cli/test_kanban_chat_links_released.py
+++ b/tests/hermes_cli/test_kanban_chat_links_released.py
@@ -70,7 +70,8 @@ def test_a_closed_card_reader_lists_no_other_profiles_released_link(rep):
     got = {c["id"]: c for c in links.replica_cards(["s1"], ME, CLOSED, replicas=[("default", rep)])}
     assert sorted((t, c["status"], c["released"]) for t, c in got.items()) == [
         ("t_arch", "archived", True), ("t_open", "running", False), ("t_released", "done", True),
-        ("t_unreleased", "unknown", False)]
+        # Done on the replica, link not yet released by the owner: pending release, not unknown (#2433).
+        ("t_unreleased", "done_pending_release", False)]
     assert {c["origin_profile"] for c in got.values()} == {"default"}
 
 
-- 
2.43.0

