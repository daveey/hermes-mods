Subject: [PATCH 6534] Bounded owner reassessment

Public mirror of source commit e510327bc6b281e9101c5b50976ba82269c70abe.

---
diff --git a/hermes_cli/kanban_owner_target.py b/hermes_cli/kanban_owner_target.py
index fb3919335be..bf3b4162efa 100644
--- a/hermes_cli/kanban_owner_target.py
+++ b/hermes_cli/kanban_owner_target.py
@@ -112,7 +112,7 @@
         if proc.poll() is None:
             proc.kill()
         try:
-            proc.wait(timeout=GIT_TIMEOUT)
+            proc.wait(timeout=max(1.0, GIT_TIMEOUT))
         finally:
             proc.stdout.close()
 
