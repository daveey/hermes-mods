From c34694e325d89ccf5454e6a8e740847af79ef6ac Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:59:57 +0000
Subject: [PATCH] test: add unittest-discovery guard line to new fence/offline
 test modules [daveey]

---
 tests/test_external_network_fence.py       | 3 +--
 tests/test_offline_catalog_defaults.py     | 1 +
 tests/test_offline_cli_catalog_defaults.py | 1 +
 tests/test_offline_metadata_defaults.py    | 1 +
 tests/test_offline_registry_defaults.py    | 1 +
 5 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/test_external_network_fence.py b/tests/test_external_network_fence.py
index d80596ce206..bf4c16eb46b 100644
--- a/tests/test_external_network_fence.py
+++ b/tests/test_external_network_fence.py
@@ -1,6 +1,5 @@
 """External resolution is opt-in; local HTTP and explicit resolver fakes remain usable."""
-if not __name__.startswith("tests."):
-    raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 
 import http.server
 import socket
diff --git a/tests/test_offline_catalog_defaults.py b/tests/test_offline_catalog_defaults.py
index ef0fe07ae93..a3f191f3713 100644
--- a/tests/test_offline_catalog_defaults.py
+++ b/tests/test_offline_catalog_defaults.py
@@ -1,4 +1,5 @@
 """Incidental catalog defaults keep real fallbacks and explicit HTTP fakes usable."""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 import http.server
 import threading
 from types import SimpleNamespace
diff --git a/tests/test_offline_cli_catalog_defaults.py b/tests/test_offline_cli_catalog_defaults.py
index deb647c64da..cb209b8de11 100644
--- a/tests/test_offline_cli_catalog_defaults.py
+++ b/tests/test_offline_cli_catalog_defaults.py
@@ -1,4 +1,5 @@
 """CLI catalog defaults must not consult live manifests or provider inventories."""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 import socket
 import urllib.error
 import urllib.request
diff --git a/tests/test_offline_metadata_defaults.py b/tests/test_offline_metadata_defaults.py
index ddf7eec798a..bf79877d066 100644
--- a/tests/test_offline_metadata_defaults.py
+++ b/tests/test_offline_metadata_defaults.py
@@ -1,4 +1,5 @@
 """Catalog lookup defaults use transport errors, not real remote DNS."""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 import socket
 
 import httpx
diff --git a/tests/test_offline_registry_defaults.py b/tests/test_offline_registry_defaults.py
index 776af2aba10..ad2deb714fe 100644
--- a/tests/test_offline_registry_defaults.py
+++ b/tests/test_offline_registry_defaults.py
@@ -1,4 +1,5 @@
 """Default registry transport stays offline while explicit responses stay real."""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 import socket
 from types import SimpleNamespace
 
