From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:39:16 +0000
Subject: [PATCH 5957] Test fixture and flake hardening (no production behavior)

Public mirror of source commit 2c21e993768742517165284cc18c99dbd5666086.

---
diff --git a/tests/hermes_cli/test_moa_preset_deletion.py b/tests/hermes_cli/test_moa_preset_deletion.py
index 4f7e0de6f2d..595c5ffb200 100644
--- a/tests/hermes_cli/test_moa_preset_deletion.py
+++ b/tests/hermes_cli/test_moa_preset_deletion.py
@@ -274,8 +274,18 @@
     real_load = utils.fast_safe_load
     failed_reads = []
 
+    def in_moa_save():
+        # Only the PUT handler's own read: a background config reader (watchers,
+        # app startup) must not consume the single injected failure first.
+        frame = sys._getframe(1)
+        while frame is not None:
+            if frame.f_code.co_name == "set_moa_models":
+                return True
+            frame = frame.f_back
+        return False
+
     def fail_once(stream):
-        if getattr(stream, "name", None) == str(config_path) and not failed_reads:
+        if getattr(stream, "name", None) == str(config_path) and not failed_reads and in_moa_save():
             failed_reads.append(str(config_path))
             raise OSError(errno.EMFILE, "Too many open files")
         return real_load(stream)
