From ea2e4d2d5e4f8568f040033058ef1e1631e21d6c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:07:04 +0000
Subject: [PATCH] [daveey] kanban placement: linux-label check shares
 label_machines' list-of-str guard; hoist registry_carries

PR #2202 review nits (t_01a1d4f2803ab733, GitHub review 5891340823; card t_01a1d4fa8dc195ef).

1. markers_unmeetable_here tested `"linux" in (entry.get("labels") or [])`: an int `labels`
   raised TypeError and a str ("linux", "linux-arm") substring-matched, so a malformed registry
   row could make a worker judge every local marker unmeetable here. It now uses the same
   list-of-str check as label_machines and fails closed.
2. The inline `carries()` closure in label_machines is hoisted to module-level
   `registry_carries(entry, wanted)` (null labels = empty set, then coordination `_carries`),
   reused by both sites.

Tests (tests/hermes_cli/test_kanban_placement_labels_shape.py):
- RED on origin/main f247892909: 13 failed (labels 5, "linux", "linux-arm", dict, tuple,
  ["linux", 5] counted as linux or raised; registry_carries missing).
- GREEN: labels_shape + pool_queue + placement + worker_placement, 429 passed.
---
 hermes_cli/kanban_placement.py                | 18 ++++++++------
 .../test_kanban_placement_labels_shape.py     | 24 +++++++++++++++++++
 2 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index d2ec8e3c5f..1e3dfe010c 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -287,19 +287,23 @@ def label_machines(label: str | Iterable[str], machines: Optional[dict] = None)
     worker-first (:func:`kanban_hub_admission_placement.pool_route`) and portable cards keep their local placement
     (:func:`kanban_worker_placement.queue_decision`) instead of queueing on a pool label nobody may lease."""
     from hermes_cli import kanban_worker_node as wn
-    from hermes_cli.kanban_placement_coordination import _carries, _fresh
+    from hermes_cli.kanban_placement_coordination import _fresh
     if machines is None:
         machines = (wn.registry() or {}).get("machines") or {}
     wanted = {label} if isinstance(label, str) else set(label)
-
-    def carries(entry):
-        labels = entry.get("labels")
-        return _carries({"labels": [] if labels is None else labels}, wanted)
     now = time.time()
     return sorted(name for name, entry in machines.items()
                   if isinstance(entry, dict) and entry.get("state", "active") == "active" and not entry.get("hold")
                   and ("pickup" not in entry or wn.advertises_pickup(entry)) and _fresh(entry, now)
-                  and carries(entry))
+                  and registry_carries(entry, wanted))
+
+
+def registry_carries(entry: dict, wanted: set) -> bool:
+    """True when registry ``entry`` carries every label in ``wanted``. ``labels`` must be a list of str
+    (coordination's ``_carries``); missing or null is the empty set; any other shape fails closed. [daveey]"""
+    from hermes_cli.kanban_placement_coordination import _carries
+    labels = entry.get("labels")
+    return _carries({"labels": [] if labels is None else labels}, wanted)
 
 
 class _Cfg:
@@ -533,7 +537,7 @@ def markers_unmeetable_here(self_gw: Optional[str], cfg: Optional[dict], machine
         from hermes_cli import kanban_worker_node as wn
         machines = dict((wn.registry() or {}).get("machines") or {})
     entry = machines.get(self_gw)
-    return isinstance(entry, dict) and "linux" in (entry.get("labels") or [])
+    return isinstance(entry, dict) and registry_carries(entry, {"linux"})
 
 
 def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
diff --git a/tests/hermes_cli/test_kanban_placement_labels_shape.py b/tests/hermes_cli/test_kanban_placement_labels_shape.py
index ab120ff479..6c1577c46d 100644
--- a/tests/hermes_cli/test_kanban_placement_labels_shape.py
+++ b/tests/hermes_cli/test_kanban_placement_labels_shape.py
@@ -6,6 +6,11 @@ TypeError and a str matched its characters (``"x"`` carried label ``x``). Since
 ``_machine_picks_up`` also goes through ``label_machines`` (empty label set), so one malformed entry crashed named
 routing too. Like ``kanban_placement_coordination._carries``, labels must be a list of str; a missing or null list is
 empty; any other shape does not qualify.
+
+PR #2202 review nits (t_01a1d4f2803ab733, GitHub review 5891340823; fixed in t_01a1d4fa8dc195ef):
+``markers_unmeetable_here`` tested ``"linux" in (entry.get("labels") or [])``, the same shape bug: an int raised
+TypeError and a str (``"linux"``, ``"linux-arm"``) substring-matched. It now shares ``label_machines``'s list-of-str
+check (module-level ``registry_carries``), failing closed.
 """
 from __future__ import annotations
 
@@ -46,3 +51,22 @@ def test_well_formed_labels_still_qualify(monkeypatch):
     assert kp.label_machines(("pool:worker", "capability:hub-write")) == ["worker-1"]
     assert kp._machine_picks_up("pool:worker") is True
     assert kp._machine_picks_up("worker-1") is True
+
+
+@pytest.mark.parametrize("labels", [5, "linux", "linux-arm", {"linux": 1}, ("linux",), ["linux", 5], None])
+def test_malformed_labels_are_not_linux(labels):
+    machines = {"worker-1": {"state": "active", "labels": labels}}
+    assert kp.markers_unmeetable_here("worker-1", {}, machines) is False
+
+
+def test_linux_list_label_is_linux():
+    assert kp.markers_unmeetable_here("worker-1", {}, {"worker-1": {"labels": ["pool:worker", "linux"]}}) is True
+    assert kp.markers_unmeetable_here("worker-1", {}, {"worker-1": {"labels": ["linux-arm"]}}) is False
+
+
+@pytest.mark.parametrize("entry, ok", [({}, True), ({"labels": None}, True), ({"labels": []}, True),
+                                       ({"labels": ["a"]}, True), ({"labels": 5}, False), ({"labels": "a"}, False),
+                                       ({"labels": ["a", 5]}, False)])
+def test_registry_carries_shape(entry, ok):
+    assert kp.registry_carries(entry, set()) is ok
+    assert kp.registry_carries(entry, {"a"}) is (ok and entry.get("labels") == ["a"])
-- 
