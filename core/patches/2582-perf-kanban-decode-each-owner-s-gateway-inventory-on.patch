From 9524e1958e0f01acd706431777ba1eb075da8cda Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:58:37 +0000
Subject: [PATCH] perf(kanban): decode each owner's gateway inventory once per
 origin projection [daveey]

kanban_origin_ledger.project re-read and re-decoded the owner's gateway/info
row for every obligation, under _links_lock (part of the ~16 thread-seconds in
_store_links > _project_remote_links). Decode it once per owner gateway per
projection; a decode error is cached and re-raised per obligation as before.
---
 hermes_cli/kanban_origin_ledger.py            | 19 ++++++++--
 .../test_kanban_origin_projection.py          | 37 +++++++++++++++++++
 2 files changed, 52 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_origin_ledger.py b/hermes_cli/kanban_origin_ledger.py
index aacb27d814..16fc65e71f 100644
--- a/hermes_cli/kanban_origin_ledger.py
+++ b/hermes_cli/kanban_origin_ledger.py
@@ -431,6 +431,7 @@ def project(path: Path, *, replica: Path | None, gateway: str, profile: str,
         # still raises if the authoritative store itself is broken.
         fresh = False
     result = []
+    infos: dict[str, tuple] = {}  # owner gateway -> (decoded gateway/info, or the error decoding it)
     try:
         with closing(_ro(path)) as conn:
             from hermes_cli.kanban_origin_legacy import aliases_for_projection
@@ -459,11 +460,21 @@ def project(path: Path, *, replica: Path | None, gateway: str, profile: str,
                     # A successful origin pull does not prove the owner could
                     # read this board. Consume the collector's qualified scope
                     # inventory; missing/ambiguous inventory is not healthy.
-                    inventory = source.execute(
-                        "SELECT data FROM replica WHERE gw=? AND coll='gateway' AND key='info'",
-                        (owner['gateway'],)).fetchone()
+                    # [daveey] Decoded once per owner gateway per projection, not once per obligation: the info row
+                    # lists every scope the owner collects, and every hub card re-decoded it under ``_links_lock``.
+                    gw_info = infos.get(owner['gateway'])
+                    if gw_info is None:
+                        inventory = source.execute(
+                            "SELECT data FROM replica WHERE gw=? AND coll='gateway' AND key='info'",
+                            (owner['gateway'],)).fetchone()
+                        try:
+                            gw_info = infos[owner['gateway']] = (json.loads(inventory[0]) if inventory else {}, None)
+                        except (ValueError, TypeError) as exc:
+                            gw_info = infos[owner['gateway']] = (None, exc)
                     try:
-                        info = json.loads(inventory[0]) if inventory else {}
+                        if gw_info[1] is not None:
+                            raise gw_info[1]
+                        info = gw_info[0]
                         scopes = info.get('task_scopes')
                         if not isinstance(scopes, list):
                             scopes = []
diff --git a/tests/hermes_cli/test_kanban_origin_projection.py b/tests/hermes_cli/test_kanban_origin_projection.py
index 44b656ccea..1ab3bf1c74 100644
--- a/tests/hermes_cli/test_kanban_origin_projection.py
+++ b/tests/hermes_cli/test_kanban_origin_projection.py
@@ -125,3 +125,40 @@ def test_fresh_origin_sync_does_not_make_unreadable_owner_scope_current(world, s
     row = ledger.project(path, replica=replica, gateway='origin', profile='default', now=1001)[0]
     assert row['status'] == 'unknown'
     assert row['unfinished'] and row['stale']
+
+
+@pytest.mark.parametrize('info', [{'gateway': 'owner', 'task_scopes': [
+    {'profile': 'work', 'board': 'build', 'state': 'ok', 'observed_at': 1000}]}, '{bad'])
+def test_projection_decodes_each_owner_inventory_once(world, monkeypatch, info):
+    """[daveey] Every obligation to one owner reads that owner's ``gateway/info`` row: once per projection."""
+    from hermes_cli import kanban_origin
+
+    path, replica, binding = world
+    second = {**binding, 'binding_id': 'binding-0002', 'task_record_key': 'work/build/t_two',
+              'owner': {**binding['owner'], 'task_id': 't_two'}}
+    publish(replica, second)
+    accept((path, replica, second), request_id='request-0002')
+    publish(replica, binding)
+    accept(world)
+    tasks = [(b['task_record_key'], {**b['owner'], 'id': b['owner']['task_id'], 'status': 'running',
+                                     'origin_bindings': [b]}) for b in (binding, second)]
+    with sqlite3.connect(replica) as db:
+        db.execute('DELETE FROM replica')
+        db.executemany("INSERT INTO replica VALUES ('owner','tasks',?,3,?)", [(k, json.dumps(t)) for k, t in tasks])
+        db.execute('CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT)')
+        db.execute("INSERT INTO meta VALUES ('last_ok','1000')")
+        db.execute("INSERT INTO replica VALUES ('owner','gateway','info',5,?)",
+                   (info if isinstance(info, str) else json.dumps(info),))
+    statements = []
+    real_ro = kanban_origin._ro
+
+    def traced(p, *args, **kwargs):
+        conn = real_ro(p, *args, **kwargs)
+        conn.set_trace_callback(statements.append)
+        return conn
+
+    monkeypatch.setattr(kanban_origin, '_ro', traced)
+    rows = ledger.project(path, replica=replica, gateway='origin', profile='default', now=1001)
+    assert sorted(r['id'] for r in rows) == ['t_one', 't_two']
+    assert [r['stale'] for r in rows] == [isinstance(info, str)] * 2
+    assert sum("key='info'" in s for s in statements) == 1
-- 
