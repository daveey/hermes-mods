From e48cd40f3e9f16d7285737945613747520cf9e84 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:52:51 +0000
Subject: [PATCH] [daveey] kanban: `hermes kanban assign` on a card under
 another machine's live Board lease is refused before it writes

Follow-up to #2254 (review 5891943917, card t_01a1d521cbaaa88e).

#2254 fences every CLI lifecycle verb (`cli_refusal`) but not `assign`.
`kb.assign_task` refuses a running card only under a local `claim_lock`; a
remote Board lease is mirrored as `lease_holder`/`lease_expires` with
`claim_lock` NULL, so `hermes kanban assign <id> <profile>` rewrote the
assignee locally (and the Board accepted it: assignee is not fenced) while the
holder kept running the card. A non-holder could change who owns a live run.
`reassign` was already fenced by #2254; `assign` now matches it.

Fix: add `assign` to `kanban_remote_stop.CLI_FENCED_VERBS`. The command now
exits non-zero with `cannot assign <id>: it is running under <holder>'s live
lease. Nothing changed. Let <holder>'s run finish, or archive it to stop it.`
and writes nothing. There is no kanban_* tool that assigns, so no tool handler
changes.

RED (on #2254 head c7979969ce): `assign {tid} other` under worker-1's live
lease -> rc 0, "Assigned <id> to other".
GREEN: test_every_cli_status_verb_under_a_remote_lease_is_refused[assign]
(rc != 0, names the holder, every table incl. tasks/task_events/
kanban_sync_outbox byte-identical). Regressions: assign after the lease
expired, and with this gateway as lease holder, still assigns.
Related suites: 45 kanban_command files (1284 passed) + 15 assign/remote-stop
files (242 passed).
---
 hermes_cli/kanban_remote_stop.py              |  3 +++
 .../test_kanban_remote_lease_status_writes.py | 24 +++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/hermes_cli/kanban_remote_stop.py b/hermes_cli/kanban_remote_stop.py
index 05591bfa58..0ea199e9c6 100644
--- a/hermes_cli/kanban_remote_stop.py
+++ b/hermes_cli/kanban_remote_stop.py
@@ -72,6 +72,9 @@ def refusal(verb: str, task_id: str, holder: str) -> str:
 CLI_FENCED_VERBS = frozenset({
     "complete", "block", "schedule", "unblock", "request-review", "request-changes", "reopen-review", "reclaim",
     "move", "reassign", "promote", "reopen",
+    # Not a status write, and the Board accepts it, but it changes who owns the holder's live run
+    # (``assign_task`` refuses only a local claim_lock).
+    "assign",
 })
 
 
diff --git a/tests/hermes_cli/test_kanban_remote_lease_status_writes.py b/tests/hermes_cli/test_kanban_remote_lease_status_writes.py
index 76ce7b75f4..cf02a1021e 100644
--- a/tests/hermes_cli/test_kanban_remote_lease_status_writes.py
+++ b/tests/hermes_cli/test_kanban_remote_lease_status_writes.py
@@ -125,6 +125,7 @@ _CLI_LINES = [
     ("reclaim", "reclaim {tid}"),
     ("move", "move {tid} --pool --reason x --reclaim"),
     ("reassign", "reassign {tid} other --reclaim"),
+    ("assign", "assign {tid} other"),  # not a status write, but it changes who owns the holder's live run
     ("promote", "promote {tid}"),
     ("reopen", "reopen {tid} --reason x"),
     ("edit", "edit {tid} --result x"),
@@ -211,3 +212,26 @@ def test_cli_complete_when_this_gateway_holds_the_lease_completes_as_before(gws,
     rc, out = _cli(f"complete {tid} --summary x")
     assert rc == 0 and f"Completed {tid}" in out, out
     assert kb.get_task(hub.conn, tid).status == "done"
+
+
+def test_cli_assign_after_the_remote_lease_expired_assigns_as_before(gws, svc, kills):
+    hub, worker = gws
+    tid = _running_on_worker(hub, worker, svc)
+    hub.enter()
+    with kb.write_txn(hub.conn):
+        hub.conn.execute("UPDATE tasks SET lease_expires = ? WHERE id = ?", (int(time.time() * 1000) - 1000, tid))
+    rc, out = _cli(f"assign {tid} other")
+    assert rc == 0 and f"Assigned {tid} to other" in out, out
+    assert kb.get_task(hub.conn, tid).assignee == "other"
+
+
+def test_cli_assign_when_this_gateway_holds_the_lease_assigns_as_before(gws, svc, kills):
+    hub, worker = gws
+    tid = _running_on_worker(hub, worker, svc)
+    hub.enter()
+    own = str(sync._state(hub.conn)["gateway_id"])
+    with kb.write_txn(hub.conn):
+        hub.conn.execute("UPDATE tasks SET lease_holder = ? WHERE id = ?", (own, tid))
+    rc, out = _cli(f"assign {tid} other")
+    assert rc == 0 and f"Assigned {tid} to other" in out, out
+    assert kb.get_task(hub.conn, tid).assignee == "other"
-- 
