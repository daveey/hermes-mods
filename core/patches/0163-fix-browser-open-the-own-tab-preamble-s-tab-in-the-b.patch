From ca8e9575ff0a767baf07b48a29c2fca788400841 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:18:50 -0700
Subject: [PATCH] fix(browser): open the own-tab preamble's tab in the
 background [daveey]

A foreground Target.createTarget makes macOS hand Chrome keyboard focus, so
every new browser_exec session pulled the agent Chrome in front of the
user's app. The harness's own new_tab() already passes background=True.
---
 tests/tools/test_browser_use_cli.py | 16 ++++++++++++++++
 tools/browser_use_cli.py            |  4 +++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_browser_use_cli.py b/tests/tools/test_browser_use_cli.py
index 511aea1fb8..dc47f551df 100644
--- a/tests/tools/test_browser_use_cli.py
+++ b/tests/tools/test_browser_use_cli.py
@@ -706,6 +706,22 @@ class TestOwnTabPreamble:
         # and composes with model code
         ast.parse(bu_cli._OWN_TAB_PREAMBLE + "print('x')")
 
+    def test_preamble_opens_its_tab_in_the_background(self):
+        """A foreground Target.createTarget makes macOS hand Chrome keyboard focus, so every new
+        browser_exec session stole focus from the user's app. The harness's own new_tab() passes
+        background=True; the preamble must too."""
+        import ast
+
+        calls = [
+            n for n in ast.walk(ast.parse(bu_cli._OWN_TAB_PREAMBLE))
+            if isinstance(n, ast.Call) and n.args and isinstance(n.args[0], ast.Constant)
+            and n.args[0].value == "Target.createTarget"
+        ]
+        assert calls, "preamble no longer creates its own tab"
+        for call in calls:
+            kw = {k.arg: k.value for k in call.keywords}
+            assert isinstance(kw.get("background"), ast.Constant) and kw["background"].value is True
+
 
 class TestProviderPickerIntegration:
     """The `hermes tools` Browser Automation picker row (browser_backend
diff --git a/tools/browser_use_cli.py b/tools/browser_use_cli.py
index 6cf86d1b8d..d06cc827b8 100644
--- a/tools/browser_use_cli.py
+++ b/tools/browser_use_cli.py
@@ -63,7 +63,9 @@ def _hermes_ensure_own_tab():
     try:
         # Force a fresh target: new_tab() would REUSE a blank current tab,
         # which is exactly the tab a sibling daemon may also hold.
-        _tid = cdp("Target.createTarget", url="about:blank").get("targetId")
+        # background=True: a foreground createTarget makes macOS hand Chrome
+        # keyboard focus, stealing it from the user's app on every new session.
+        _tid = cdp("Target.createTarget", url="about:blank", background=True).get("targetId")
         if _tid:
             switch_tab(_tid)
     except Exception:
