@@ -2486,8 +2486,8 @@ def _dispatch_once_locked(
     next_ready = 0
 
     def _run_ready(limit: Optional[int]) -> None:
-        # Resumable: a deferred or refused claim never ends the tick, the loop moves on to the next row, and
