From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 21:35:20 +0000
Subject: [PATCH] test(kanban): classify preclaim review refusal observation
 [daveey]

Problem: exact-head CI source-scanning ready-entry registry rejects review_admission_refused from record_refusal. Root (happened): new status writer observation omitted from explicit non-entry audit. Root (not caught): import-selected consumer gate omitted AST source scanner. Register only this non-entry observation; exhaustion remains triage, not ready release. Preserve unknown-event detection and add no-ready-age-reset control. Proof: unchanged whole file 22 passed/1 failed; focused four whole files 83 passed/0 failed, retries OFF; scripts/check 21 checks ok. Fleet remediation/deployment remains unfinished.
---
 .../test_kanban_ready_entry_registry.py         | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_ready_entry_registry.py b/tests/hermes_cli/test_kanban_ready_entry_registry.py
index 64fd3e118d..fb7d8dad53 100644
--- a/tests/hermes_cli/test_kanban_ready_entry_registry.py
+++ b/tests/hermes_cli/test_kanban_ready_entry_registry.py
@@ -103,9 +103,26 @@ NON_ENTRY_WRITER_EVENTS = {
     "archive_worker_termination", "archived", "request_withdrawn", "claimed",
     "agent_block_escalated", "timed_out", "stale", "reconciled", "parent_found",
     "parent_missing", "status_healed",
+    # Preclaim observation; exhaustion moves to triage, never releases to ready.
+    "review_admission_refused",
 }
 
 
+def test_review_admission_refusal_does_not_reset_ready_age(conn):
+    tid = kb.create_task(conn, title="review refusal observation", assignee="default")
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET created_at=100 WHERE id=?", (tid,))
+        conn.execute("UPDATE task_events SET created_at=100 WHERE task_id=?", (tid,))
+        kb._append_event(conn, tid, "review_admission_refused", {"preclaim": True})
+        conn.execute(
+            "UPDATE task_events SET created_at=200 WHERE task_id=? AND kind=?",
+            (tid, "review_admission_refused"),
+        )
+    assert pu.ready_since(conn, tid, 100) == 100
+    assert score._ready_since(conn, [tid])[tid] == 100
+    assert "'review_admission_refused'" not in cw._floor_kinds()
+
+
 def _writer_events(source):
     for node in ast.walk(ast.parse(source)):
         if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
