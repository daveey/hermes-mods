From dbed984c137fdbccbf24f89c96a8d25fc538b152 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:16:27 +0000
Subject: [PATCH] [daveey] kanban: CI-run sweep never raises out of the scope
 bind; per-home warning test proves the home key

PR #2068 review nits (review 5889224988):

1. `_sweep_db` binds the dispatching home before `sweep()`'s never-raises
   guard. A refused bind (ScopeSwitchRefused, scope read error) or a
   connect error raised out of the pool future, and
   `run_due_wake_checks(wait=True)` only catches FutureTimeout /
   CancelledError around `fut.result`, so it escaped the tick. Wrap the
   bind + connect + sweep in a logged `except Exception: return []`.
   RED: test_refused_scope_bind_does_not_escape_the_wake_check_tick raised
   hermes_scope.ScopeSwitchRefused; GREEN after the guard.

2. test_no_credential_warning_is_per_home now asserts both homes read the
   SAME board db (the default board is the root kanban.db), so only the
   home half of the `_WARNED_AT` key separates them. RED with a db-only
   key (`("", db)`): [1, 0] == [1, 1] fails; GREEN with (home, db).
---
 hermes_cli/kanban_ci_progress.py            | 20 +++++++----
 tests/hermes_cli/test_kanban_ci_progress.py | 40 +++++++++++++++++++--
 2 files changed, 51 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_ci_progress.py b/hermes_cli/kanban_ci_progress.py
index a2b350362a..0e9dfca069 100644
--- a/hermes_cli/kanban_ci_progress.py
+++ b/hermes_cli/kanban_ci_progress.py
@@ -291,17 +291,23 @@ def sweep(conn: sqlite3.Connection, *, fetch: Optional[Fetch] = None) -> list[st
 
 def _sweep_db(db_path: str, home: str) -> list[str]:
     """:func:`sweep` on a pool thread with the dispatching ``home`` bound: a pool thread does not inherit the
-    caller's context-local home, so ``dispatcher_gh_argv`` would read the launch home's gh_command_prefix."""
+    caller's context-local home, so ``dispatcher_gh_argv`` would read the launch home's gh_command_prefix.
+    Never raises: a refused bind (``ScopeSwitchRefused``) or connect error would land in the future, and the
+    wake-check tick's ``fut.result`` loop only catches timeouts, so it would escape the tick."""
     from pathlib import Path
 
     from agent.runtime_scope import bind_profile_scope
     from hermes_cli import kanban_db_connect as kbc
-    with bind_profile_scope(home, hydrate_secrets=False):
-        conn = kbc.connect(Path(db_path))
-        try:
-            return sweep(conn)
-        finally:
-            conn.close()
+    try:
+        with bind_profile_scope(home, hydrate_secrets=False):
+            conn = kbc.connect(Path(db_path))
+            try:
+                return sweep(conn)
+            finally:
+                conn.close()
+    except Exception:
+        logger.warning("kanban ci run progress: sweep of %s for home %s failed", db_path, home, exc_info=True)
+        return []
 
 
 def submit_sweep(conn: sqlite3.Connection, pool) -> Optional[Future]:
diff --git a/tests/hermes_cli/test_kanban_ci_progress.py b/tests/hermes_cli/test_kanban_ci_progress.py
index bdad332a9c..50615194b3 100644
--- a/tests/hermes_cli/test_kanban_ci_progress.py
+++ b/tests/hermes_cli/test_kanban_ci_progress.py
@@ -349,16 +349,52 @@ def test_sweep_on_a_pool_thread_uses_the_dispatching_homes_prefix(kanban_home, t
 
 
 def test_no_credential_warning_is_per_home(kanban_home, tmp_path, no_login, monkeypatch, caplog) -> None:
-    """One home's hourly no-credential WARNING must not hide another home's in the same process."""
+    """One home's hourly no-credential WARNING must not hide another home's in the same process. Both homes
+    read the same board db (the default board is the root ``kanban.db``), so only the home half of the
+    ``_WARNED_AT`` key tells them apart: a key on the board db alone warns once (PR #2068 review)."""
     from hermes_constants import reset_hermes_home_override, set_hermes_home_override
     other = _other_home(tmp_path)
-    warned = []
+    warned, dbs = [], []
     for home in (kanban_home, other):
         _tid, db = _park_stuck_card_in(home, monkeypatch, no_login)
+        dbs.append(db)
         token = set_hermes_home_override(home)
         try:
             with kbc.connect_closing(Path(db)) as conn:
                 warned.append(_sweep_warnings(caplog, conn))
         finally:
             reset_hermes_home_override(token)
+    assert dbs[0] == dbs[1], dbs
     assert [len(w) for w in warned] == [1, 1], warned
+
+
+def test_refused_scope_bind_does_not_escape_the_wake_check_tick(kanban_home, fake_gh, monkeypatch, caplog) -> None:
+    """PR #2068 review: ``_sweep_db`` binds the dispatching home before ``sweep``'s never-raises guard. A refused
+    bind (``ScopeSwitchRefused``) raised out of the pool future, and ``run_due_wake_checks(wait=True)`` only
+    catches timeouts there, so it escaped the tick."""
+    from contextlib import contextmanager
+
+    from agent import runtime_scope
+    from hermes_cli import kanban_ci_progress as kcp
+    from hermes_scope import ScopeSwitchRefused
+
+    fake_gh.serve(age=2 * 60)
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+        _as_worker(monkeypatch, conn, tid)
+        assert _park_on_run().get("status") == "scheduled"
+        monkeypatch.delenv("HERMES_KANBAN_TASK")
+        fake_gh.serve(age=20 * 60)
+        kcp._LAST_CHECK.clear()
+
+        @contextmanager
+        def refused(home, **_kw):
+            raise ScopeSwitchRefused("refused inside a hosted scope")
+            yield  # pragma: no cover
+
+        monkeypatch.setattr(runtime_scope, "bind_profile_scope", refused)
+        with caplog.at_level("WARNING", logger=kcp.logger.name):
+            out = kwc.run_due_wake_checks(conn, wait=True)
+        assert isinstance(out, dict), out
+        assert kb.get_task(conn, tid).status == "scheduled"
+        assert any("ci run progress" in r.getMessage() and r.exc_info for r in caplog.records), caplog.text
