From 83df199ff5454778a297258bf7b67a743b2b2963 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:24:16 +0000
Subject: [PATCH] fix(kanban): label_publish label cap tracks the Board's 512,
 not the stale 32 [t_01a1cefefcad176a]

Review t_01a1cfa6176e9556: hermes-hub #78 raised MAX_LABELS to 512 and live workers carry
~230 labels, so every label_publish to a worker was falsely refused too_many_labels.
Adds a regression test with a realistic (231-label) worker registry.
---
 hermes_cli/kanban_operator_labels.py            |  2 +-
 tests/hermes_cli/test_kanban_operator_labels.py | 12 ++++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_operator_labels.py b/hermes_cli/kanban_operator_labels.py
index 0253ce74dc..949ecaa7f9 100644
--- a/hermes_cli/kanban_operator_labels.py
+++ b/hermes_cli/kanban_operator_labels.py
@@ -53,7 +53,7 @@ LABEL_RE = re.compile(r"(skill|capability):[a-z0-9][a-z0-9._-]*")
 LABEL_MAX_CHARS = 64  # the Board's LABEL_RE length
 MACHINE_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")
 MAX_LABELS_PER_CALL = 16
-BOARD_MAX_LABELS = 32  # the Board's MAX_LABELS (worker/src/mailbox.ts), machine:<name> not counted
+BOARD_MAX_LABELS = 512  # the Board's MAX_LABELS (hermes-hub worker/src/mailbox.ts, 512 since hub #78), machine:<name> not counted
 PROBE_TIMEOUT_S = 240
 ADMIN_TIMEOUT_S = 45
 ADMIN_CALLS_PER_JOB = 2  # one registry read, one labels_add
diff --git a/tests/hermes_cli/test_kanban_operator_labels.py b/tests/hermes_cli/test_kanban_operator_labels.py
index b249fb33c9..41376099ff 100644
--- a/tests/hermes_cli/test_kanban_operator_labels.py
+++ b/tests/hermes_cli/test_kanban_operator_labels.py
@@ -292,6 +292,18 @@ def test_board_answer_without_a_label_set_is_a_failure(hub):
     assert req["status"] == "failed" and "carries no label set" in req["error"], req
 
 
+def test_worker_with_a_full_skill_inventory_is_published_not_capped(hub):
+    """Live workers carry ~230 labels (213 skill:*). The cap must track the Board's (512), or every publish to a
+    worker is falsely refused too_many_labels."""
+    f = hub
+    f.reg.labels["worker-3"] |= {f"skill:s{i}" for i in range(226)}
+    out = _submit(f, _op())
+    _round(f)
+    req = ksr.get_request(f.w, out["request_id"])
+    assert req["status"] == "done" and req["result"][0]["outcome"] == "applied", req
+    assert "capability:hub-read" in f.reg.labels["worker-3"] and len(f.reg.labels["worker-3"]) == 231
+
+
 def test_delta_past_the_board_label_cap_is_refused_without_a_write(hub):
     f = hub
     f.reg.labels["worker-3"] |= {f"skill:s{i}" for i in range(kol.BOARD_MAX_LABELS - 4)}
-- 
2.43.0

