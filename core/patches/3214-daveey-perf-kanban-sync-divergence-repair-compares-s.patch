@@ -77,6 +92,59 @@ def repair_divergence(live: sqlite3.Connection, shadow: sqlite3.Connection, gate
     return repaired
 
 
+def _db_file(conn: sqlite3.Connection) -> str | None:
+    """The main database file of ``conn``; None for an in-memory or temporary database."""
+    for _seq, name, file in conn.execute("PRAGMA database_list").fetchall():
+        if name == "main":
+            return file or None
+    return None
+
+
+def _task_columns(conn: sqlite3.Connection, schema: str = "main") -> set[str]:
+    return {r[1] for r in conn.execute(f"PRAGMA {schema}.table_info(tasks)").fetchall()}
+
+
+def _differing_settled(live: sqlite3.Connection, shadow: sqlite3.Connection, gateway: str) -> set[str] | None:
+    """Ids of this gateway's settled cards (same ``sync_version`` in both copies) whose synced columns differ.
+
+    One SQLite join over both files, in a private read-only connection: the comparison runs in C and only the
+    differing ids cross into Python. Scanning every settled card in Python made each round fetch every task row
+    twice (``SELECT *``, ~5.5k rows on the hub); under the gateway's GIL contention each fetched row waits for the
+    GIL, so the scan held the sync loop 40+ s per pass and the replica went 11+ min stale (hub py-spy 04:17Z
+    2026-11-13, t_01a1d2cc49634a78: 100% of the sync thread in ``repair_divergence``). Equal raw values always
+    give equal ``_row_fields`` values, so this is a superset of the cards the Python comparison flags; the caller
+    re-compares each candidate exactly. None when the pre-filter cannot run: the caller scans every card. [daveey]"""
+    from hermes_cli import kanban_lockguard
+    live_file, replica_file = _db_file(live), _db_file(shadow)
+    if not live_file or not replica_file:
+        return None
+    try:
+        conn = kanban_lockguard.connect(Path(live_file).resolve().as_uri() + "?mode=ro", uri=True)
+    except (sqlite3.Error, OSError, ValueError):
+        return None
+    try:
+        conn.execute("ATTACH DATABASE ? AS rep", (Path(replica_file).resolve().as_uri() + "?mode=ro",))
+        skip = sync.LOCAL_COLUMNS["tasks"] | sync.KEY_COLUMNS["tasks"] | sync.SERVER_COLUMNS.get("tasks", frozenset())
+        columns = sorted((sync.SYNCED_COLUMNS["tasks"] - skip) & _task_columns(conn) & _task_columns(conn, "rep"))
+        terms = []
+        for column in columns:
+            if ("tasks", column) in sync.REF_COLUMNS:  # local run ids differ per file: compare the run uids
+                terms.append(f"(SELECT uid FROM main.task_runs WHERE id = l.{column}) IS NOT "
+                             f"(SELECT uid FROM rep.task_runs WHERE id = r.{column})")
+            else:
+                terms.append(f"l.{column} IS NOT r.{column}")
+        if not terms:
+            return set()
+        return {row[0] for row in conn.execute(
+            "SELECT l.id FROM main.tasks l JOIN rep.tasks r ON r.id = l.id "
+            "WHERE l.sync_version IS NOT NULL AND r.sync_version = l.sync_version "
+            "AND (r.created_on = ? OR r.created_on IS NULL) AND (" + " OR ".join(terms) + ")", (gateway,))}
+    except sqlite3.Error as exc:
+        _log.debug("kanban sync: divergence pre-filter unavailable (%s); scanning every card", exc)
+        return None
+    finally:
+        conn.close()
+
 _TERMINAL = frozenset({"done", "archived"})
 
 
diff --git a/hermes_cli/kanban_sync_links_pass.py b/hermes_cli/kanban_sync_links_pass.py
new file mode 100644
index 0000000000..6c501d5e17
--- /dev/null
+++ b/hermes_cli/kanban_sync_links_pass.py
@@ -0,0 +1,72 @@
+"""The sync loop's chat-link pass, on its own thread so it can never hold up a sync round. [daveey]
+
+Inline in ``kanban_sync_client._run_forever``, a slow pass held the replica pull, the remote-parent mirror and the
+outbox push for its whole length: on the hub 2026-11-13 one pass took ~10 min (04:14-04:24Z, its strict ledger read
+queued on ``_links_lock`` behind Desktop readers) and the replica went 13 min stale, so hub cards waiting on worker
+cards did not promote (t_01a1d2cc49634a78). The loop asks for a pass on its cadence; a request while one is running
+is refused and asked again on a later iteration, so passes never pile up. The thread owns its own connection scope
+and never calls the loop's ``keep_running`` (callers count its calls); the loop stops it.
+"""
+from __future__ import annotations
+
+import logging
+import threading
+from pathlib import Path
+from typing import Optional
+
+_log = logging.getLogger("hermes_cli.kanban_sync_client")
+
+
+class LinksPass:
+    JOIN_S = 5.0
+
+    def __init__(self, gateway: str) -> None:
+        self._gateway = gateway
+        self._want = threading.Event()
+        self._idle = threading.Event()
+        self._idle.set()
+        self._stopped = False
+        self._boards: list[tuple[str, Path]] = []
+        self._thread: Optional[threading.Thread] = None
+
+    def request(self, boards: list[tuple[str, Path]]) -> bool:
+        """Start a pass over ``boards`` unless one is running. True when it started."""
+        if not self._idle.is_set():
+            return False
+        self._boards = list(boards)
+        self._idle.clear()
+        self._want.set()
+        if self._thread is None or not self._thread.is_alive():
+            from agent.memory_provider import spawn_context_thread
+            self._thread = spawn_context_thread(self._run, name="kanban-sync-links")
+            self._thread.start()
+        return True
+
+    def wait_idle(self, timeout: Optional[float] = None) -> bool:
+        return self._idle.wait(timeout)
+
+    def stop(self) -> None:
+        self._stopped = True
+        self._want.set()
+        if self._thread is not None:
+            self._thread.join(self.JOIN_S)
+
+    def _run(self) -> None:
+        from hermes_cli import kanban_sync_client as client  # module attribute: tests replace reconcile_links
+        from hermes_cli.kanban_sync_connections import connection_scope
+        with connection_scope():
+            try:
+                while not self._stopped:
+                    if not self._want.wait(timeout=1.0):
+                        continue
+                    self._want.clear()
+                    if self._stopped:
+                        break
+                    try:
+                        client.reconcile_links(self._boards, self._gateway, skip_unchanged=True)
+                    except Exception as exc:  # health: allow BLE001 -- a failed pass must not end the thread
+                        _log.warning("kanban sync: chat links pass failed (%s: %s)", type(exc).__name__, exc)
+                    finally:
+                        self._idle.set()
+            finally:
+                self._idle.set()
