 import time
+from pathlib import Path
 from hermes_cli import kanban_db_sync as sync
 
 _log = logging.getLogger(__name__)
@@ -25,12 +26,23 @@ def repair_divergence(live: sqlite3.Connection, shadow: sqlite3.Connection, gate
