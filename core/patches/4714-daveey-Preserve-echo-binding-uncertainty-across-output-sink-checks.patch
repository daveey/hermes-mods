 .../cron/test_lifecycle_guard_echo_binding.py | 86 +++++++++++++++++++
 .../test_lifecycle_guard_quoted_echo_sink.py  |  4 +-
 tools/shell_heredoc.py                        | 21 ++++-
 4 files changed, 109 insertions(+), 5 deletions(-)
