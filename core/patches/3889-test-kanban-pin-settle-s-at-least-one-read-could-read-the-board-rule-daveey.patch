From be43111c4c39e977b7bb5b2b16ccae8afa41ce4a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:52:47 +0000
Subject: [PATCH] test(kanban): pin settle's "at least one read could read the
 board" rule [daveey]

Post-merge mutant check of #2520 (t_01a1d6a623306970): replacing
`any(_board(e) not in bad for _e, bad in reads)` in `_split` with `True`
(mutant B2) passed all 64 tests in the settle/links/parity suites. Under it
an entry on a board unreadable in EVERY read became persistent
(`only_in_ledger`) instead of `in_flight`, the shape the #2520 review chose.

New test: every read lists t_x on board B and none can read B; asserts the
entry is in `in_flight`, not `only_in_ledger`, and `clean` is False with
`unreadable == ["B"]`.

RED: with B2 applied, 64 passed / 1 failed (only the new test).
GREEN: 65 passed, 0 failed, 0 skipped. scripts/check --base origin/main ok.

Card: t_01a1d6e19f8d9d4b
---
 tests/hermes_cli/test_kanban_chat_links_settle.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_chat_links_settle.py b/tests/hermes_cli/test_kanban_chat_links_settle.py
index b6966e44c1..a18842a307 100644
--- a/tests/hermes_cli/test_kanban_chat_links_settle.py
+++ b/tests/hermes_cli/test_kanban_chat_links_settle.py
@@ -166,6 +166,15 @@ def test_a_difference_on_a_board_first_unreadable_counts_from_its_first_readable
     assert report["clean"] is True and report["in_flight"]["only_in_ledger"] == {"s1": [stuck[1]]}
 
 
+def test_an_entry_on_a_board_no_read_could_read_is_in_flight_not_a_difference(clock):
+    # Every read lists t_x on B and none could read B: no read confirms it, so it stays in flight (the merged
+    # #2520 review kept this shape there); the report is unclean through ``unreadable``, not ``only_in_*``.
+    stuck = ("s1", ("hub", "B", "t_x"))
+    report = _run(clock, [_report([stuck], unreadable=["B"]), _report([stuck], unreadable=["B"])])
+    assert report["clean"] is False and report["unreadable"] == ["B"]
+    assert report["only_in_ledger"] == {} and report["in_flight"]["only_in_ledger"] == {"s1": [stuck[1]]}
+
+
 def test_the_last_sleep_stops_at_the_window(clock):
     _run(clock, [_report([("s1", ("hub", "default", "t_x"))])], settle_s=25.0)
     assert clock["sleeps"] == [10.0, 10.0, 5.0]
