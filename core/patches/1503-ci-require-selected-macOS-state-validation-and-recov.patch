+    if selected == "true":
+        return {"ok": lane == "success", "reason": f"{MACOS_STATE_LANE} selected, {MACOS_STATE_JOB} {lane}"}
+    if selected == "false":
+        return {"ok": lane in ("skipped", "success"),
+                "reason": f"{MACOS_STATE_LANE} not selected, {MACOS_STATE_JOB} {lane}"}
