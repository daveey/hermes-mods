+class FakeApi:
+    """In-memory stand-in for the gh client: GET by exact path, records POSTs."""
+
+    def __init__(self, routes):
+        self.routes = routes
+        self.gets: list[str] = []
+        self.posts: list[str] = []
+
+    def get(self, path):
+        self.gets.append(path)
+        value = self.routes[path]
+        if callable(value):
+            value = value()
+        return copy.deepcopy(value)
+
+    def post(self, path):
+        self.posts.append(path)
+        return {}
