From 3de04d8928d687859196c08aee46c4bf57ae264f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:36:38 +0000
Subject: [PATCH] [daveey] ci: hermes_state mini lane post-#1912 nits (comment
 direction, trigger invariant, scheduled-red alert doc)

Follow-up to the #1912 review (pullrequestreview-5888040701), card t_01a1d3fedc7fdd14.

1. ci.yaml gate-lanes comment had the queueing direction backwards. It now
   says required PR jobs never queue behind a main-push CI run on the one
   mini runner.
2. test_main_push_never_starts_the_standalone_lane no longer pins the full
   trigger set (a change detector). It asserts the invariant: any push
   trigger on hermes-state-macos.yml has a branches filter and no pattern
   in it matches main or master (fnmatch, so `*`/`**`/`ma*` count). The
   ci.yaml main-push mask assertion stays.
   Mutant: adding 'ma*' to on.push.branches turns the test red.
3. Scheduled-run alerting: no new workflow_run watcher. The hub's main-CI
   watcher (hermes-state hosts/hermes-hub/ci-watch/ci_main_watch.py) already
   merges this workflow's schedule runs on main (SCHEDULED =
   {.github/workflows/hermes-state-macos.yml}) and opens one ci-red Kanban
   card per red streak. It is live: it is in the hub's cron jobs.json and the
   deployed ~/.hermes/scripts/ci_main_watch.py carries that SCHEDULED entry,
   state file written 2026-11-13 15:22 UTC. hermes-state-macos.yml now
   says so, and says to update SCHEDULED when the file moves.

Tests: scripts/run_tests.sh tests/ci/test_macos_state_routing.py passes;
scripts/check --base origin/main: 19 checks ok.
---
 .github/workflows/ci.yaml                | 4 ++--
 .github/workflows/hermes-state-macos.yml | 7 +++++++
 tests/ci/test_macos_state_routing.py     | 8 ++++++--
 3 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 89053e7763..3cd6a338f0 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -135,8 +135,8 @@ jobs:
         # or a push to main, whatever the diff or labels say. The macOS state and
         # native memory lanes are off on a main push (hermes-state-macos.yml tests
         # main from its own 4-hourly schedule, and native-memory-macos.yml from
-        # its own push trigger, so a main push never queues the one mini runner
-        # behind required PR jobs) and on for a dispatch or a release.
+        # its own push trigger, so required PR jobs never queue behind a main-push
+        # CI run on the one mini runner) and on for a dispatch or a release.
         id: gate-lanes
         env:
           RELEASE: ${{ inputs.release }}
diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
index e0dca84f41..47a36321a3 100644
--- a/.github/workflows/hermes-state-macos.yml
+++ b/.github/workflows/hermes-state-macos.yml
@@ -23,6 +23,13 @@ name: hermes_state (macOS)
 # regression (disk, runner loss, host timeouts; t_01a1d37abf5db0ae). ci-probe/**
 # branches keep an unfiltered push trigger for probing the runner.
 #
+# Alerting on a red scheduled run: no workflow_run watcher here on purpose. The
+# hub's main-CI watcher (hermes-state hosts/hermes-hub/ci-watch/ci_main_watch.py,
+# SCHEDULED) reads this workflow's schedule runs on main and opens one ci-red
+# Kanban fix card per red streak, as for a red main push. hermes-state-recovery.yml
+# reruns a runner-lost job once; the watcher reads the run's latest conclusion.
+# Renaming or moving this file needs that SCHEDULED entry updated too.
+#
 # HERMES_HOME points at a throwaway temp dir, so the lane writes none of the live
 # ~/.hermes's config, state, sessions or environments. The runner is the daveey
 # login (HOME=/Users/me, same APFS volume as RUNNER_TEMP), so the temp home
diff --git a/tests/ci/test_macos_state_routing.py b/tests/ci/test_macos_state_routing.py
index 6e83a65f58..752a014868 100644
--- a/tests/ci/test_macos_state_routing.py
+++ b/tests/ci/test_macos_state_routing.py
@@ -1,4 +1,5 @@
 """Replay the macOS state lane's real workflow wiring, without running a mini job."""
+import fnmatch
 import json
 import os
 import subprocess
@@ -132,8 +133,11 @@ def test_main_push_never_starts_the_standalone_lane():
     # merged tree; the 4-hourly schedule tests main HEAD. ci-probe branches keep a
     # push trigger, unfiltered, for probing the runner.
     on = workflow('hermes-state-macos.yml')['on']
-    assert on['push'] == {'branches': ['ci-probe/**']}
-    assert set(on) == {'push', 'schedule', 'workflow_dispatch', 'workflow_call'}
+    if 'push' in on:
+        branches = (on['push'] or {}).get('branches')
+        assert branches, 'a push trigger without a branches filter fires on main pushes'
+        assert not [pattern for pattern in branches for ref in ('main', 'master')
+                    if fnmatch.fnmatchcase(ref, pattern)], branches
     # ci.yaml must keep masking its main-push call too, or main pushes come back
     # through CI instead.
     assert detect(['hermes_state.py'], context('push', 'refs/heads/main'))['hermes_state'] == 'false'
-- 
