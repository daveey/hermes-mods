 hermes_cli/kanban_db_dispatch_admission.py   |   6 +
 hermes_cli/kanban_dispatch_skip.py           |   2 +-
 hermes_cli/kanban_spend_budget.py            | 219 +++++++++++++
 tests/hermes_cli/test_kanban_spend_budget.py | 318 +++++++++++++++++++
 website/docs/user-guide/features/kanban.md   |  25 ++
 6 files changed, 571 insertions(+), 1 deletion(-)
 create mode 100644 hermes_cli/kanban_spend_budget.py
