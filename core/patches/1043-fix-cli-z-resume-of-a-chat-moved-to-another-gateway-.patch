From d2b08adf9bdd46040b05baace1e598a793799033 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:30:38 +0000
Subject: [PATCH] fix(cli): -z --resume of a chat moved to another gateway
 exits SESSION_MOVED again [daveey]

Upstream routes -z through launch_gateway_chat, which skipped the fork's _refuse_moved_session fence.
The test stubs main_resume_args.import_foreign_resume (upstream moved it out of main) and the
gateway launcher so 'before the turn' is checked on the real route.
---
 hermes_cli/main.py                        | 5 +++++
 tests/hermes_cli/test_session_handover.py | 8 ++++++--
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/main.py b/hermes_cli/main.py
index 2ce038e2400..dfa068b69c6 100644
--- a/hermes_cli/main.py
+++ b/hermes_cli/main.py
@@ -3042,6 +3042,11 @@ def _run_oneshot_from_args(args) -> None:
     Bypasses cli.py entirely; the transport launcher never returns.
     """
     from hermes_cli.gateway_chat_startup import launch_gateway_chat
+    # [daveey] -z --resume of a chat handed over to another gateway fails fast with SESSION_MOVED before
+    # any turn, as chat and the TUI do (_resolve_chat_session_args); upstream's gateway route skipped it.
+    resume_val = getattr(args, "resume", None)
+    if isinstance(resume_val, str) and resume_val.strip() and resume_val.strip().lower() != "latest":
+        _refuse_moved_session(_resolve_session_by_name_or_id(resume_val) or resume_val)
     sys.exit(launch_gateway_chat(args))
 
 
diff --git a/tests/hermes_cli/test_session_handover.py b/tests/hermes_cli/test_session_handover.py
index cb938d46d49..57a4d776395 100644
--- a/tests/hermes_cli/test_session_handover.py
+++ b/tests/hermes_cli/test_session_handover.py
@@ -205,7 +205,8 @@ def _resume_args(**kw):
 def test_cli_resume_of_a_moved_session_exits_with_session_moved(gw, monkeypatch, capsys):
     from hermes_cli import main as hm
     monkeypatch.setattr(hm, "_apply_in_dir", lambda args: None)
-    monkeypatch.setattr(hm, "_import_foreign_resume", lambda args: None)
+    # Fork: upstream moved the foreign-resume import out of main into main_resume_args.
+    monkeypatch.setattr("hermes_cli.main_resume_args.import_foreign_resume", lambda args: None)
     monkeypatch.setattr(hm, "_resolve_session_by_name_or_id", lambda value: value)
     hm._resolve_chat_session_args(_resume_args(), use_tui=False)  # not moved: resumes
     _moved_away(gw)
@@ -219,11 +220,14 @@ def test_cli_resume_of_a_moved_session_exits_with_session_moved(gw, monkeypatch,
 def test_oneshot_resume_of_a_moved_session_exits_before_the_turn(gw, monkeypatch, capsys):
     from hermes_cli import main as hm
     monkeypatch.setattr(hm, "_apply_in_dir", lambda args: None)
-    monkeypatch.setattr(hm, "_import_foreign_resume", lambda args: None)
+    # Fork: upstream moved the foreign-resume import out of main into main_resume_args.
+    monkeypatch.setattr("hermes_cli.main_resume_args.import_foreign_resume", lambda args: None)
     monkeypatch.setattr(hm, "_resolve_session_by_name_or_id", lambda value: value)
     monkeypatch.setattr(hm, "_confirm_startup_expensive_model_override", lambda args: None)
     ran = []
     monkeypatch.setattr(hm, "_run_and_exit_oneshot", lambda *a, **k: ran.append(k))
+    # Fork: upstream runs -z through the gateway chat launcher; the moved fence must stop it too.
+    monkeypatch.setattr("hermes_cli.gateway_chat_startup.launch_gateway_chat", lambda args: ran.append(args) or 0)
     _moved_away(gw)
     with pytest.raises(SystemExit) as exc:
         hm._run_oneshot_from_args(_resume_args(oneshot="hi"))
