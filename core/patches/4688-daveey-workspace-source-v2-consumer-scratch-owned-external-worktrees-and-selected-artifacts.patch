new file mode 100644
index 0000000000000000000000000000000000000000..ba56edecbfaa02739a4816b6bd687d148969277c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_source_metadata_deadline.py
@@ -0,0 +1,81 @@
+"""Metadata writes need the same interruptible deadline as selected blob writes."""
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_source_artifacts as artifacts
+from hermes_cli import kanban_source_publish as pub
+from hermes_cli.kanban_sync_client import Hub, HubError
+
+
+@pytest.mark.parametrize("reply", ["trickle", "ok", "refused", "redirect"])
+def test_private_metadata_client_bounds_response_and_never_replays(reply):
+    stop = threading.Event()
+    closed = threading.Event()
+    calls = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            calls.append((self.path, self.headers.get("Content-Type"),
+                          json.loads(self.rfile.read(int(self.headers["Content-Length"])))))
+            status = {"ok": 200, "trickle": 200, "refused": 409, "redirect": 307}[reply]
+            self.send_response(status)
+            self.send_header("Content-Length", "100000" if reply == "trickle" else "2")
+            self.send_header("Location", "/must-not-follow")
+            self.end_headers()
+            try:
+                if reply == "trickle":
+                    while not stop.wait(0.04):
+                        self.wfile.write(b" ")
+                        self.wfile.flush()
+                else:
+                    self.wfile.write(b"{}")
+                    self.wfile.flush()
+            except OSError:
+                closed.set()
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever)
+    thread.start()
+    shared = Hub(SimpleNamespace(url=f"http://127.0.0.1:{server.server_port}", key="fixture"), timeout=5)
+    hub = artifacts.bounded_transport(shared, pub._Deadline(2))
+    completed = threading.Event()
+    result = {}
+
+    def invoke():
+        try:
+            result["value"] = hub.ops("fixture", [{"id": "one"}])
+        except (OSError, HubError) as exc:
+            result["error"] = exc
+        finally:
+            completed.set()
+
+    caller = threading.Thread(target=invoke)
+    caller.start()
+    try:
+        assert completed.wait(5), "metadata trickle escaped the absolute deadline"
+        if reply == "trickle":
+            assert isinstance(result.get("error"), OSError)
+            assert closed.wait(3), "deadline must close the reader's socket, not just abandon it"
+        elif reply == "ok":
+            assert result == {"value": {}}
+        else:
+            assert isinstance(result.get("error"), HubError)
+            assert result["error"].status == (409 if reply == "refused" else 307)
+        assert calls == [("/v2/boards/fixture/ops", "application/json", {"ops": [{"id": "one"}]})]
+        assert shared.deadline is None
+    finally:
+        stop.set()
+        server.shutdown()
+        server.server_close()
+        thread.join(5)
+        caller.join(5)
+        hub.close()
+        shared.close()
+        assert not caller.is_alive() and not thread.is_alive()
diff --git a/tests/hermes_cli/test_kanban_source_origin_deadline.py b/tests/hermes_cli/test_kanban_source_origin_deadline.py
new file mode 100644
index 0000000000000000000000000000000000000000..d36a276ad05e74d03ab0864c64dde1b3eda600ec
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_source_origin_deadline.py
@@ -0,0 +1,96 @@
+"""The ending's origin proof shares the preflight deadline and runs once per ending (card t_0a6a9f59d9af4492)."""
+from dataclasses import replace
+
+import pytest
+
+from hermes_cli import kanban_source_board as board_calls
+from hermes_cli import kanban_source_clones as kcl
+from hermes_cli import kanban_source_publish as pub
+from hermes_cli import kanban_source_registration as reg
+from tests.hermes_cli import test_kanban_source_publish as helpers
+
+world = helpers.world
+board = helpers.board
+card = helpers.card
+
+
+class Clock:
+    def __init__(self):
+        self.now = 1000.0
+
+    def __call__(self):
+        return self.now
+
+
+def _v2(card):
+    run = replace(card.run(), source_protocol=2, source_identity=reg.source_identity(str(card.path), "task_worktree"))
+    board_calls.record_run(card.conn, run)
+    assert card.receipt()["state"] == "published"
+    return card.run()
+
+
+def _count_proofs(monkeypatch):
+    calls = []
+    real = kcl.prove_clone
+
+    def counted(*a, **kw):
+        calls.append(a)
+        return real(*a, **kw)
+    monkeypatch.setattr(kcl, "prove_clone", counted)
+    return calls
+
+
+def test_v2_new_commit_ending_proves_origin_once(card, monkeypatch):
+    _v2(card)
+    helpers.commit(card.path, "next.txt", "new")
+    calls = _count_proofs(monkeypatch)
+    assert card.receipt()["state"] == "published"
+    assert len(calls) == 1
+
+
+def test_origin_proof_git_calls_are_capped_by_the_remaining_deadline(card, monkeypatch):
+    clock = Clock()
+    deadline = pub._Deadline(3, clock=clock)
+    seen = []
+    real = kcl.git
+
+    def recording(path, *args, timeout=30, check=True):
+        seen.append(timeout)
+        return real(path, *args, timeout=timeout, check=check)
+    monkeypatch.setattr(kcl, "git", recording)
+    pub.prove_origin(str(card.path), card.cfg, deadline=deadline)
+    assert seen and max(seen) <= 3
+
+
+def test_origin_proof_github_lookup_is_capped_by_the_remaining_deadline(card, monkeypatch):
+    clock = Clock()
+    seen = []
+    monkeypatch.setattr(kcl, "_cache_path", lambda: card.world.tmp / "no-cache" / "proof.json")
+    monkeypatch.setattr(kcl, "github_repo", lambda name, timeout=30: seen.append(timeout) or
+                        {"id": 42, "full_name": "acme/widget"})
+    pub.prove_origin(str(card.path), card.cfg, deadline=pub._Deadline(4, clock=clock))
+    assert seen and max(seen) <= 4
+
+
+def test_deadline_spent_during_origin_proof_is_preflight_timeout(card, monkeypatch):
+    clock = Clock()
+    monkeypatch.setattr(kcl, "_cache_path", lambda: card.world.tmp / "no-cache" / "proof.json")
+
+    def slow_lookup(name, timeout=30):
+        clock.now += 10  # the API call used up the whole budget, then timed out
+        raise TimeoutError("gh api timed out")
+    monkeypatch.setattr(kcl, "github_repo", slow_lookup)
+    with pytest.raises(pub.PublishRefused) as err:
+        pub.prove_origin(str(card.path), card.cfg, deadline=pub._Deadline(5, clock=clock))
+    assert err.value.code == "preflight_timeout"
+
+
+def test_unbounded_origin_proof_keeps_its_own_failure_code(card, monkeypatch):
+    monkeypatch.setattr(kcl, "_cache_path", lambda: card.world.tmp / "no-cache" / "proof.json")
+
+    def failing(name, timeout=30):
+        raise TimeoutError("gh api timed out")
+    monkeypatch.setattr(kcl, "github_repo", failing)
+    with pytest.raises(pub.PublishRefused) as err:
+        pub.prove_origin(str(card.path), card.cfg)
+    assert err.value.code == "origin_unreachable"
diff --git a/tests/hermes_cli/test_kanban_source_publication_fence.py b/tests/hermes_cli/test_kanban_source_publication_fence.py
new file mode 100644
index 0000000000000000000000000000000000000000..4d4d543aba2d66f51b77c516ef9730bf02a05b98
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_source_publication_fence.py
@@ -0,0 +1,207 @@
+"""Selected artifacts: publication and receipt-consumption fences after ``portable`` returns.
+
+``portable`` proves the selection did not change during its own transport. A later
+authenticated selection (heartbeat/lifecycle stage) can still land before the
+manifest RPC, during it, or before the ending's status UPDATE consumes the receipt.
+None of those may let a superseded selection be reported portable.
+"""
+from __future__ import annotations
+
+import json
+import time
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_source_artifacts as artifacts
+from hermes_cli import kanban_source_board as board_calls
+from hermes_cli import kanban_source_receipt as carrier
+from tests.hermes_cli import test_kanban_source_publish as helpers
+from tests.hermes_cli.test_kanban_source_resolver import commit
+
+world = helpers.world
+board = helpers.board
+card = helpers.card
+
+ONE = [{"attachment_uid": "artifact-one", "filename": "one.txt", "sha256": "a" * 64}]
+TWO = [{"attachment_uid": "artifact-two", "filename": "two.txt", "sha256": "b" * 64}]
+
+
+def _select(card, entries):
+    with kbc.write_txn(card.conn):
+        artifacts._setup(card.conn)
+        card.conn.execute("INSERT INTO kanban_source_artifact_selection VALUES (?,?,?) "
+                          "ON CONFLICT(task_id,run_uid) DO UPDATE SET entries=excluded.entries",
+                          (card.id, card.run_uid, json.dumps(entries)))
+
+
+def _portable(monkeypatch, after=None):
+    """Transport stand-in that returns the current selection, then lets a racer act."""
+    def portable(conn, task_id, prior, run_uid, *, bound=None):
+        current = artifacts.selected(conn, task_id, run_uid)
+        result = list(current if current is not None else (prior or {}).get("artifacts", []))
+        if after:
+            after()
+        return result
+    monkeypatch.setattr(artifacts, "portable", portable)
+
+
+def test_selection_change_after_portable_refuses_before_manifest_rpc(card, board, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    calls = []
+
+    def racer():  # the preflight's own transport is first; publish() transports again right before the RPC
+        calls.append(1)
+        if len(calls) == 2:
+            _select(card, TWO)
+
+    _portable(monkeypatch, after=racer)
+    receipt = card.receipt()
+    assert len(calls) == 2
+    assert receipt["state"] == "retained"
+    assert "artifact_selection_changed" in receipt["reason"]
+    assert "publish_source" not in board.actions()
+
+
+def test_selection_change_during_manifest_rpc_is_not_portable(card, board, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+    real = board_calls.publish
+
+    def racing_publish(*a, **kw):
+        out = real(*a, **kw)
+        _select(card, TWO)
+        return out
+
+    monkeypatch.setattr(board_calls, "publish", racing_publish)
+    receipt = card.receipt()
+    assert receipt["state"] == "retained"
+    assert "artifact_selection_changed" in receipt["reason"]
+    # The Board's applied revision is still recorded, so a retry publishes on top of it.
+    assert card.run().manifest["manifest_revision"] == 1
+    assert card.run().manifest["artifacts"] == ONE
+    monkeypatch.setattr(board_calls, "publish", real)
+    retry = card.receipt()
+    assert (retry["state"], retry["manifest_revision"]) == ("published", 2)
+    assert card.run().manifest["artifacts"] == TWO
+
+
+def test_publication_refused_when_run_ended_after_portable(card, board, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+
+    def end_run():
+        with kbc.write_txn(card.conn):
+            card.conn.execute("UPDATE task_runs SET ended_at=? WHERE id=?", (int(time.time()), card.run_id))
+
+    _portable(monkeypatch, after=end_run)
+    receipt = card.receipt()
+    assert receipt["state"] == "retained"
+    assert "publish_run_ended" in receipt["reason"]
+    assert "publish_source" not in board.actions()
+
+
+def _consumed(card, receipt, *, ends=True):
+    seen = {}
+
+    def update():
+        row = card.conn.execute(f"SELECT receipt FROM {carrier.TABLE} WHERE task_id=?", (card.id,)).fetchone()
+        seen["receipt"] = json.loads(row[0])
+        if not ends:
+            return 0  # a CAS miss: the ending did not happen
+        return card.conn.execute("UPDATE tasks SET status='ready' WHERE id=? AND status='running'",
+                                 (card.id,)).rowcount
+
+    with kbc.write_txn(card.conn):
+        carrier.ensure_schema(card.conn)
+        carrier.with_source_receipt(card.conn, card.id, update, run_id=card.run_id, receipt=receipt)
+    return seen["receipt"]
+
+
+def _refusal_events(card):
+    return [e[0] for e in card.conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind=?",
+                                            (card.id, "workspace_source_publish_refused")).fetchall()
+            if "artifact_selection_changed" in (e[0] or "")]
+
+
+def test_consumption_keeps_receipt_when_selection_is_unchanged(card, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+    receipt = card.receipt()
+    assert receipt["state"] == "published"
+    assert _consumed(card, receipt) == receipt
+
+
+def test_consumption_downgrades_receipt_when_selection_changed_after_preflight(card, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+    receipt = card.receipt()
+    assert receipt["state"] == "published"
+    _select(card, TWO)
+    consumed = _consumed(card, receipt)
+    assert consumed["state"] == "retained"
+    assert consumed["run_uid"] == receipt["run_uid"]
+    assert consumed["reason"] == "artifact_selection_changed"
+    assert len(_refusal_events(card)) == 1
+
+
+def test_consumption_cas_miss_records_no_refusal(card, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+    receipt = card.receipt()
+    _select(card, TWO)
+    assert _consumed(card, receipt, ends=False)["state"] == "retained"
+    assert _refusal_events(card) == []
+
+
+def test_consumption_unreadable_selection_is_not_portable(card, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+    receipt = card.receipt()
+    with kbc.write_txn(card.conn):
+        card.conn.execute("UPDATE kanban_source_artifact_selection SET entries='[{\"bad\": 1}]' "
+                          "WHERE task_id=?", (card.id,))
+    assert _consumed(card, receipt)["state"] == "retained"
+
+
+def test_move_rolls_back_when_its_portable_receipt_goes_stale(card, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_move as km
+    from hermes_cli import kanban_source_move as ksm
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+
+    def publish_for_move(conn, task_id):
+        receipt = card.receipt(publish=True)
+        assert receipt["state"] == "published"
+        _select(card, TWO)  # an authenticated stage lands after the move's publish
+        return receipt, (card.run().manifest, None), ""
+
+    plan = {"runs_on": ["machine:worker-1"], "me": "hub", "previous": [], "move_no": 1, "forced": False,
+            "matches": ["worker-1"], "host": {}}
+    monkeypatch.setattr(ksm, "publish_for_move", publish_for_move)
+    monkeypatch.setattr(km, "check", lambda *a, **kw: plan)
+    monkeypatch.setattr("hermes_cli.kanban_hub_admission_placement.gate_move", lambda *a, **kw: None)
+    res = km.move_task(card.conn, card.id, runs_on=["machine:worker-1"], reason="r", checkpoint="c")
+    assert (res["ok"], res["reason_code"]) == (False, "artifact_selection_changed")
+    task = kb.get_task(card.conn, card.id)
+    assert task is not None
+    assert (task.status, task.current_run_id) == ("running", card.run_id)
+    assert not card.conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND kind=?",
+                                 (card.id, km.MOVED_EVENT)).fetchone()
+
+
+def test_consumption_downgrades_unchanged_receipt_too(card, monkeypatch):
+    commit(card.path, "feature.txt", "work")
+    _select(card, ONE)
+    _portable(monkeypatch)
+    assert card.receipt()["state"] == "published"
+    receipt = card.receipt()
+    assert receipt["state"] == "unchanged"
+    _select(card, [])
+    assert _consumed(card, receipt)["state"] == "retained"
