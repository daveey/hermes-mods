From 5f7bc64a3a6dc9cbfead7d3dcdc14ddd042a3e1c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 14:16:33 +0000
Subject: [PATCH 6460] Class-authorised credential staging for managed workers

Public mirror of source commit 5f7bc64a3a6dc9cbfead7d3dcdc14ddd042a3e1c.

---
diff --git a/gateway/session_worker_credentials.py b/gateway/session_worker_credentials.py
index 185307bbca3..7e683e597de 100644
--- a/gateway/session_worker_credentials.py
+++ b/gateway/session_worker_credentials.py
@@ -96,15 +96,15 @@
     for route in routes:
         if not isinstance(route, dict):
             continue
-        model = route.get('model') or route.get('default')
-        if is_class_selector(model):
+        route_model = route.get('model') or route.get('default')
+        if is_class_selector(route_model):
             # A class is not provider auto-detection. The adopted worker resolves
             # it later, with its session identity; give it only this class's
             # policy-authorized providers, never every registry/profile secret.
             routing = config.get('model_routing', {})
             validate_policy(routing)
             if routing.get('enabled') and route.get('provider', 'auto') in (None, '', 'auto'):
-                for candidate in eligible_routes(routing, model.removeprefix('class:')):
+                for candidate in eligible_routes(routing, route_model.removeprefix('class:')):
                     block = config.get('providers', {}).get(candidate['provider'], {})
                     if is_provider_enabled(block):
                         names.update(_route_names(candidate, config, values))
diff --git a/tests/gateway/test_kanban_class_credential_boundary.py b/tests/gateway/test_kanban_class_credential_boundary.py
index 20cb9f6962d..98e1717a5b8 100644
--- a/tests/gateway/test_kanban_class_credential_boundary.py
+++ b/tests/gateway/test_kanban_class_credential_boundary.py
@@ -101,6 +101,24 @@
         'ANTHROPIC_API_KEY': 'synthetic-anthropic'}
 
 
+@pytest.mark.parametrize('primary,expected', [
+    ({'provider': 'anthropic'}, {'ANTHROPIC_API_KEY': 'synthetic-anthropic'}),
+    ({'provider': 'custom', 'base_url': 'https://inference.example.com/v1',
+      'key_env': 'GEMINI_API_KEY'}, {'GEMINI_API_KEY': 'synthetic-gemini'}),
+])
+def test_primary_override_preserves_provider_metadata(tmp_path, monkeypatch, primary, expected):
+    from gateway.session_worker_credentials import route_environment
+
+    config = {'model': {'default': 'profile-default', **primary}, 'auxiliary': {}}
+    original = json.dumps(config, sort_keys=True)
+    monkeypatch.setattr('gateway.session_worker_credentials._profile_values', lambda *args: {
+        'GEMINI_API_KEY': 'synthetic-gemini', 'ANTHROPIC_API_KEY': 'synthetic-anthropic',
+        'OPENROUTER_API_KEY': 'synthetic-openrouter', 'UNDECLARED_SECRET': 'synthetic-unrelated'})
+    assert route_environment(SimpleNamespace(profile_id=str(tmp_path)),
+        SimpleNamespace(ignore_user_config=False), config, model='concrete-launch') == expected
+    assert json.dumps(config, sort_keys=True) == original
+
+
 def test_primary_override_preserves_declared_auxiliary_inheritance(tmp_path, monkeypatch, class_config):
     from gateway.session_worker_credentials import route_environment
 
