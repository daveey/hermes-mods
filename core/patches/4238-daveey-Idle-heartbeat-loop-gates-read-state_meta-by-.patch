From bee84d7bb1bbda1ca7f64463f3bb9764e2e9e3fb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 06:42:44 -0800
Subject: [PATCH] [daveey] Idle heartbeat/loop gates: read state_meta by key
 range, not a LIKE table scan

`run_idle_gates._ConnMeta.list_meta_prefix` used `key LIKE ? ESCAPE '\'`, which SQLite cannot serve
from the primary key (ESCAPE form, case-insensitive LIKE on a BINARY key): every probe was
`SCAN state_meta`, reading every stored value. On the mini's gateway store that is 22,168 rows and
244 MB of values: 48-160 ms CPU per probe across its 10 stores, 1.1% of a core on the turn-executor
thread in a 60 s profile (kanban card t_01a1d889abf75d78). The empty-proof memo does not help
while workers commit, because every commit moves the revision it is keyed on.

Fix: a primary-key range (`key >= prefix AND key < next`) plus a literal startswith filter:
0.4-0.5 ms across the same stores. `_` and `%` stay literal; an empty prefix names no rows, as in
SessionDB.list_meta_prefix. SessionDB.list_meta_prefix itself is unchanged (not in the measured path).

Why not caught: the gate tests counted scans per revision but never looked at what one scan costs.
New test requires an index SEARCH plan for each prefix read. RED on the old query: ['SCAN state_meta'].
---
 gateway/run_idle_gates.py                     | 12 +++++----
 .../test_run_idle_gates_empty_proofs.py       | 26 +++++++++++++++++--
 2 files changed, 31 insertions(+), 7 deletions(-)

diff --git a/gateway/run_idle_gates.py b/gateway/run_idle_gates.py
index e4b20ebf87..7e1069a5e2 100644
--- a/gateway/run_idle_gates.py
+++ b/gateway/run_idle_gates.py
@@ -60,11 +60,13 @@ class _ConnMeta:
         self._conn = conn
 
     def list_meta_prefix(self, prefix: str) -> list[tuple[str, str]]:
-        from hermes_state_common import escape_like
-
-        rows = self._conn.execute(
-            "SELECT key, value FROM state_meta WHERE key LIKE ? ESCAPE '\\'", (escape_like(prefix) + "%",))
-        return [(row[0], row[1]) for row in rows]
+        # A primary-key range, not ``LIKE ? ESCAPE``: that form cannot use the index and reads every
+        # state_meta value (244 MB on one gateway store) on each probe. The filter keeps the match literal.
+        if not prefix:
+            return []
+        rows = self._conn.execute("SELECT key, value FROM state_meta WHERE key >= ? AND key < ?",
+                                  (prefix, prefix[:-1] + chr(min(ord(prefix[-1]) + 1, 0x10FFFF))))
+        return [(row[0], row[1]) for row in rows if row[0].startswith(prefix)]
 
 
 def _store_has_work_cached(db: Any, kind: str, store_has_work: Callable[[Any], bool]) -> bool:
diff --git a/tests/gateway/test_run_idle_gates_empty_proofs.py b/tests/gateway/test_run_idle_gates_empty_proofs.py
index cdbfeb4ede..091f41998b 100644
--- a/tests/gateway/test_run_idle_gates_empty_proofs.py
+++ b/tests/gateway/test_run_idle_gates_empty_proofs.py
@@ -1,7 +1,6 @@
 """Idle heartbeat/loop gates reuse a proven-EMPTY answer only while the store's committed revision holds.
 
-The gates scan ``state_meta`` by prefix (a full-table LIKE plus a JSON parse of every retained row) on
-every poll tick. These contracts pin the reuse: an unchanged store is scanned once across K checks; any
+The gates read ``state_meta`` by prefix (a JSON parse of every retained row) on every poll tick. These contracts pin the reuse: an unchanged store is scanned once across K checks; any
 commit (this process's writer or another connection) is seen on the very next check; active work,
 unparseable rows and read errors are never remembered, so they are re-examined on every check.
 """
@@ -234,3 +233,26 @@ def test_root_loop_gate_does_not_warn_on_a_corrupt_row_every_tick(work, caplog):
         assert warned == []
     finally:
         root_db.close()
+
+
+def test_conn_meta_prefix_read_is_a_literal_index_range_not_a_table_scan():
+    """The gate's own prefix read reaches rows through the primary key (never every stored value) and
+    still matches the prefix literally: ``_`` and ``%`` are not wildcards, neighbours stay out."""
+    conn = sqlite3.connect(":memory:")
+    conn.execute("CREATE TABLE state_meta (key TEXT PRIMARY KEY, value TEXT)")
+    conn.executemany("INSERT INTO state_meta VALUES (?, ?)", [
+        ("loop:a", "1"), ("loop:b", "2"), ("loop", "x"), ("loop;z", "x"), ("loopy:a", "x"), ("heartbeat:a", "x"),
+        ("a_b:1", "u"), ("axb:1", "x"), ("a%b:1", "p"), ("aqqb:1", "x")])
+    meta = gates._ConnMeta(conn)
+    seen: list[str] = []
+    conn.set_trace_callback(seen.append)
+    assert meta.list_meta_prefix("loop:") == [("loop:a", "1"), ("loop:b", "2")]
+    assert meta.list_meta_prefix("a_b:") == [("a_b:1", "u")]
+    assert meta.list_meta_prefix("a%b:") == [("a%b:1", "p")]
+    assert meta.list_meta_prefix("nope:") == []
+    conn.set_trace_callback(None)
+    assert len(seen) == 4
+    for sql in seen:
+        plan = [row[3] for row in conn.execute("EXPLAIN QUERY PLAN " + sql)]
+        assert plan and all(step.startswith("SEARCH") for step in plan), plan
+    assert meta.list_meta_prefix("") == []  # as SessionDB.list_meta_prefix: no prefix names no rows
