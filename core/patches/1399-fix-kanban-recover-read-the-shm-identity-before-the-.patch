From c6acc8f8e4af3bbeacbf1d98c3c549b0df7df5af Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 03:45:37 +0000
Subject: [PATCH] fix(kanban): recover() read the -shm identity before the
 handle list, evicting a reader registered by a concurrent first open [daveey]

---
 hermes_cli/kanban_generation.py          |  5 ++++-
 tests/hermes_cli/test_kanban_ro_cache.py | 25 ++++++++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_generation.py b/hermes_cli/kanban_generation.py
index b9e5e472dad..e86792ec5c5 100644
--- a/hermes_cli/kanban_generation.py
+++ b/hermes_cli/kanban_generation.py
@@ -117,8 +117,11 @@ def recover(database) -> None:
     path = _path(database)
     if path is None:
         return
-    current = shm_identity(path)
+    # Snapshot the handles BEFORE reading the live identity. The other order races a concurrent first open:
+    # ``current`` is read while no -shm exists (None), the opener then creates it and registers its handle
+    # with the new identity, and this call would call that healthy handle stale and evict it.
     handles = _handles(path)
+    current = shm_identity(path)
     stale = any(c._hermes_generation_shm is not None and c._hermes_generation_shm != current for c in handles)
     with _lock:
         poisoned = path in _poisoned
diff --git a/tests/hermes_cli/test_kanban_ro_cache.py b/tests/hermes_cli/test_kanban_ro_cache.py
index 4c45fc9e205..f1d1d0605e5 100644
--- a/tests/hermes_cli/test_kanban_ro_cache.py
+++ b/tests/hermes_cli/test_kanban_ro_cache.py
@@ -108,3 +108,28 @@ def test_threads_share_the_connection_safely(tmp_path):
     for t in threads:
         t.join()
     assert errors == [] and len(seen) == 1
+
+
+def test_recover_does_not_evict_a_reader_registered_during_the_check(tmp_path, monkeypatch):
+    """A first open racing ``recover`` registers its handle (with the freshly created -shm identity) between
+    recover's reads; that healthy handle must not be judged stale (the source of the 'evicted while waiting' flake)."""
+    from hermes_cli import kanban_generation as kg
+
+    path = tmp_path / "b.db"
+    _db(path, "v").close()  # last close removes -wal/-shm: the next open mints a new -shm
+    evicted, opened = [], []
+    monkeypatch.setattr(kg, "_reader_caches", [evicted.append])
+    real_handles = kg._handles
+
+    def handles_after_concurrent_open(p):
+        if not opened:
+            opened.append(None)  # open_ro re-enters recover() -> _handles(): mark first so it runs once
+            opened[0] = kg.open_ro(path)
+        return real_handles(p)
+
+    monkeypatch.setattr(kg, "_handles", handles_after_concurrent_open)
+    try:
+        kg.recover(path)
+    finally:
+        opened[0].close()
+    assert evicted == []
-- 
