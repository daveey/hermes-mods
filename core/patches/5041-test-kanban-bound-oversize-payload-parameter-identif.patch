From 5ef45f63b9e4a8aa12bf89995f7a172621b992a4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:33:47 +0000
Subject: [PATCH] test(kanban): bound oversize payload parameter identifiers
 [daveey]

Fix point 6: pytest copied the 128 KiB string parameter into PYTEST_CURRENT_TEST, causing execve E2BIG in the live git config guard. Isolated runs hid it because initial path discovery swallowed the spawn failure. Keep every payload and assertion unchanged; use semantic IDs instead of serializing test data into the environment. Combined fairness plus recovery: baseline 441 passed/1 setup error, fixed 463 passed twice (71.12s, 71.92s). Task t_eeeeee000000001a.
---
 tests/hermes_cli/test_kanban_fairness_runtime.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_fairness_runtime.py b/tests/hermes_cli/test_kanban_fairness_runtime.py
index 6dbf3400eb..7aa189ff01 100644
--- a/tests/hermes_cli/test_kanban_fairness_runtime.py
+++ b/tests/hermes_cli/test_kanban_fairness_runtime.py
@@ -16,8 +16,11 @@ def activate(tmp_path, monkeypatch):
                             clock_error_ns=0)
 
 
+# Keep PYTEST_CURRENT_TEST below execve's per-environment-entry limit: the
+# default string ID embeds the oversized payload and breaks guard subprocesses.
 @pytest.mark.parametrize("value", ["x" * (runtime.MAX_PAYLOAD_BYTES + 1),
-                                   [None] * (runtime.MAX_PAYLOAD_BYTES + 1), 10**400])
+                                   [None] * (runtime.MAX_PAYLOAD_BYTES + 1), 10**400],
+                         ids=["oversize-string", "oversize-list", "oversize-integer"])
 def test_oversize_is_rejected_before_serializing(monkeypatch, value):
     monkeypatch.setattr(runtime.json, "dumps", lambda *a, **kw: pytest.fail("unbounded serialization"))
     with pytest.raises(runtime.PayloadLimit):
