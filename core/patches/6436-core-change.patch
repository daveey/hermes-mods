@@ -291,11 +293,18 @@
             logger.exception("kanban: spend review skipped %s; hold retained", task_id)
             continue
         if not events or events[-1]["kind"] not in (QUEUED, STARTED):
+            if events and (task_id, episode) in frozen:
+                ended.append((task_id, episode))
             continue
         last = events[-1]
