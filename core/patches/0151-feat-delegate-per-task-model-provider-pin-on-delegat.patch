+# Route keys that drop out of a per-task route when the task names a DIFFERENT provider: they belong to the
+# delegation.provider endpoint, and carrying them over would send the new provider's model to the old endpoint.
+_PROVIDER_SCOPED_ROUTE_KEYS = ("base_url", "api_key", "api_mode", "command", "args")
+
+
+def _task_route_cfg(task: dict[str, Any], routing_cfg: dict[str, Any]) -> tuple[Optional[dict[str, Any]], Optional[str]]:
+    """[daveey] Per-task ``model`` / ``provider`` pin → ``(route_cfg, None)``; ``(None, None)`` when the task pins
+    nothing (it uses the call-wide route); ``(None, error)`` for a malformed pin. The task's values win over the
+    ``delegation`` block: ``model`` alone keeps the configured (or inherited) provider, ``provider`` alone keeps
+    the configured model only when the provider is unchanged."""
+    pins: dict[str, str] = {}
+    for key in ("model", "provider"):
+        raw = task.get(key)
+        if raw is None:
+            continue
+        if not isinstance(raw, str):
+            return None, f"Task '{key}' must be a string (e.g. \"claude-sonnet-5-5\"), got {type(raw).__name__}."
+        if raw.strip():
+            pins[key] = raw.strip()
+    if not pins:
+        return None, None
+    cfg = dict(routing_cfg or {})
+    provider = pins.get("provider")
+    if provider and provider.lower() != str(cfg.get("provider") or "").strip().lower():
+        for key in _PROVIDER_SCOPED_ROUTE_KEYS:
+            cfg.pop(key, None)
+        cfg["provider"] = provider
+        cfg["model"] = ""  # the old provider's model name means nothing on the new provider
+    if "model" in pins:
+        cfg["model"] = pins["model"]
+    return cfg, None
+
+
+def _resolve_task_routes(
+    task_list: list[dict[str, Any]], creds: dict[str, Any], routing_cfg: dict[str, Any], parent_agent,
+) -> tuple[list[tuple[dict[str, Any], dict[str, Any]]], Optional[str]]:
+    """``[(creds, routing_cfg), ...]`` per task: the call-wide route, or the task's own ``model``/``provider`` pin
+    resolved through the same credential path as ``delegation.*``. ``([], error)`` on a bad pin."""
+    routes: list[tuple[dict[str, Any], dict[str, Any]]] = []
+    for i, t in enumerate(task_list):
+        task_cfg, err = _task_route_cfg(t, routing_cfg)
+        if err:
+            return [], f"Task {i}: {err}"
+        if task_cfg is None:
+            routes.append((creds, routing_cfg))
+            continue
+        try:
+            task_creds = _resolve_delegation_credentials(task_cfg, parent_agent)
+        except ValueError as exc:
+            return [], f"Task {i}: {exc}"
+        routes.append((task_creds, task_cfg))
+    return routes, None
+
