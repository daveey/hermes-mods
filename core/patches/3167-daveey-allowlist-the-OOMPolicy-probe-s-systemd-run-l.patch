---
 tests/fixtures/resolution_allowlist.json | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/fixtures/resolution_allowlist.json b/tests/fixtures/resolution_allowlist.json
index 0690435b06..be212c49f5 100644
--- a/tests/fixtures/resolution_allowlist.json
+++ b/tests/fixtures/resolution_allowlist.json
@@ -227,6 +227,12 @@
     "symbol": "_resolve_hermes_argv",
     "kind": "bare_which"
   },
+  {
+    "path": "hermes_cli/kanban_worker_scope.py",
+    "symbol": "_probe_oom_policy_continue",
+    "kind": "bare_which",
+    "reason": "systemd-run is a host system binary (not a Hermes-managed runtime); same lookup as process_registry._systemd_run_user_scope_available."
+  },
   {
     "path": "hermes_cli/linux_desktop_entry.py",
     "symbol": "_refresh_hicolor_cache",
