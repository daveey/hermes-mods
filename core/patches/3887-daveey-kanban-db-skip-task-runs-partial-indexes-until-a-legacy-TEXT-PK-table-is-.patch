From 46b8b195005cf6a9391f3b58527f649998b42074 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:31:28 +0000
Subject: [PATCH] [daveey] kanban db: skip task_runs partial indexes until a
 legacy TEXT-PK table is rebuilt (G2)

A legacy task_runs table can lack ended_at, which the additive pass never adds; creating
idx_runs_* there raised 'no such column: ended_at' (CI: test_kanban_db_init legacy rebuild +
idempotency). The rebuild recreates the table with these indexes from _REBUILD_SPECS.
---
 hermes_cli/kanban_db_connect.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/hermes_cli/kanban_db_connect.py b/hermes_cli/kanban_db_connect.py
index 3aabe80a50..7625bbda5d 100644
--- a/hermes_cli/kanban_db_connect.py
+++ b/hermes_cli/kanban_db_connect.py
@@ -1359,6 +1359,10 @@ _RUN_PARTIAL_INDEXES = (
 
 
 def _ensure_run_partial_indexes(conn: sqlite3.Connection) -> None:
+    # A legacy TEXT-PK task_runs can lack base columns (``ended_at``) that the additive pass never adds; the
+    # rebuild (``_REBUILD_SPECS``) recreates the table with these indexes, so skip them here until then.
+    if not {"ended_at", "worker_pid", "outcome", "metadata"} <= _column_names(conn, "task_runs"):
+        return
     for ddl in _RUN_PARTIAL_INDEXES:
         conn.execute(ddl.replace("CREATE INDEX ", "CREATE INDEX IF NOT EXISTS ", 1))
 
-- 
