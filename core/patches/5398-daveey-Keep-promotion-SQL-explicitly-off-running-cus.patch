From 72524da2fee716443e6d6a794611dd7d91bbed06 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 05:45:36 +0000
Subject: [PATCH] [daveey] Keep promotion SQL explicitly off running custody

CI caught the parameterized status predicate as an unclassified source-receipt ending. Retain an explicit off-running allowlist as well as the exact observed-status CAS; no source-custody exemption is needed. Extend the race test to a different promotable status so removing the exact CAS is detected.

Proof: source-receipt sites and spend hold suites 43 passed before added triage control; final hold baseline 27 passed. Four mutants killed: missing scheduled exception, ignored pending hold, missing writer decision recheck, missing exact-status CAS.
---
 hermes_cli/kanban_db_promote.py                   | 2 +-
 tests/hermes_cli/test_kanban_spend_budget_hold.py | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_db_promote.py b/hermes_cli/kanban_db_promote.py
index e6ce5c15b8..c2b40f5070 100644
--- a/hermes_cli/kanban_db_promote.py
+++ b/hermes_cli/kanban_db_promote.py
@@ -45,7 +45,7 @@ def promote_task(
             return False, f"task {task_id} spend decision changed during promotion"
         upd = conn.execute(
             "UPDATE tasks SET status = 'ready' "
-            "WHERE id = ? AND status = ?", (task_id, cur_status),
+            "WHERE id = ? AND status IN ('todo', 'blocked', 'triage', 'scheduled') AND status = ?", (task_id, cur_status),
         )
         if upd.rowcount != 1:
             return False, f"task {task_id} status changed during promotion"
diff --git a/tests/hermes_cli/test_kanban_spend_budget_hold.py b/tests/hermes_cli/test_kanban_spend_budget_hold.py
index 6a8c1655cc..6dda58c345 100644
--- a/tests/hermes_cli/test_kanban_spend_budget_hold.py
+++ b/tests/hermes_cli/test_kanban_spend_budget_hold.py
@@ -193,7 +193,7 @@ def test_scheduled_spend_decision_can_be_promoted(kanban_home, held):
         assert kb.get_task(conn, tid).status == "ready"
 
 
-@pytest.mark.parametrize("changed", ["decision", "status"])
+@pytest.mark.parametrize("changed", ["decision", "running", "triage"])
 def test_scheduled_promotion_rechecks_under_writer(kanban_home, changed):
     with kbc.connect_closing() as conn:
         tid = kb.create_task(conn, title="Promotion race", assignee="default")
@@ -204,10 +204,10 @@ def test_scheduled_promotion_rechecks_under_writer(kanban_home, changed):
             if changed == "decision":
                 kb._append_event(c, tid, "promoted_manual", {"actor": "other"})
             else:
-                c.execute("UPDATE tasks SET status='running' WHERE id=?", (tid,))
+                c.execute("UPDATE tasks SET status=? WHERE id=?", (changed, tid))
         ok, why = kb.promote_task(conn, tid, actor="operator", precondition=racing)
         assert not ok and why and "changed during promotion" in why
-        assert kb.get_task(conn, tid).status == ("scheduled" if changed == "decision" else "running")
+        assert kb.get_task(conn, tid).status == ("scheduled" if changed == "decision" else changed)
         assert len(helpers._events(conn, tid, "promoted_manual")) == int(changed == "decision")
 
 
