From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:46:31 +0000
Subject: [PATCH 6869] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit 198717c4f6097ac3da1e33064d8f4be5cd4ca9cd.

---
diff --git a/tests/hermes_cli/test_kanban_replay_sender.py b/tests/hermes_cli/test_kanban_replay_sender.py
index 8c38fb438b8367636522e0ac0f2e5e67459969d9..bd8b8d37c0dd236505ce9c7d58b317dbe3dd5072 100644
--- a/tests/hermes_cli/test_kanban_replay_sender.py
+++ b/tests/hermes_cli/test_kanban_replay_sender.py
@@ -779,8 +779,12 @@
     kb.create_task(live, title='mode custody', assignee='worker')
     receiver = Receiver()
     receiver.lose_reply = True
-    with pytest.raises(OSError, match='reply lost after commit'):
+    error = None
+    try:
         client.push(live, receiver, 'default', 'macbook', primary=True, max_batches=1)
+    except (OSError, ValueError) as exc:
+        error = exc
+    assert isinstance(error, OSError), 'primary must reach the controlled lost committed reply'
     assert len(receiver.sent) == 1 and journal.pending_wire(live) is not None
     assert journal.snapshot(live)['settled'] == '0' and receiver.slot['a'] == '0'
 
