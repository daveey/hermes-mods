From e667441167eb8a1f3213456a7da9a79bd9a5b67b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 02:47:00 +0000
Subject: [PATCH] [daveey] Test canary title lookup and missing-run summary

Answer review test gap: fake gh returns a run only for the exact expected canary title; cover six empty lookups and fallback summary. Proof: wrong-title mutant fails test_manual_dispatch_runs_the_canary; restored script passes 12 tests across 3 CI suites. Hermes-Card: t_eeeeee0000000039
---
 tests/ci/test_state_contract_dispatch.py | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/tests/ci/test_state_contract_dispatch.py b/tests/ci/test_state_contract_dispatch.py
index 0d0310173c..e5e06d7745 100644
--- a/tests/ci/test_state_contract_dispatch.py
+++ b/tests/ci/test_state_contract_dispatch.py
@@ -29,7 +29,11 @@ FAKE_GH = r"""#!/usr/bin/env bash
 echo "$*" >> "$FAKE_GH_LOG"
 case "$1 $2" in
   "workflow run") exit 0 ;;
-  "run list") echo 987654321; exit 0 ;;
+  "run list")
+    if [[ "$*" == *"$FAKE_CANARY_TITLE"* ]] && [ "$FAKE_RUN_MISSING" = 0 ]; then
+      echo 987654321
+    fi
+    exit 0 ;;
 esac
 if [ "$1" = api ]; then
   case "$2" in
@@ -46,7 +50,7 @@ exit 9
 """
 
 
-def _run(tmp_path: Path, event: str, cron: str = "") -> tuple[list[str], str]:
+def _run(tmp_path: Path, event: str, cron: str = "", *, missing_run: bool = False) -> tuple[list[str], str]:
     bindir = tmp_path / "bin"
     bindir.mkdir()
     gh = bindir / "gh"
@@ -63,6 +67,8 @@ def _run(tmp_path: Path, event: str, cron: str = "") -> tuple[list[str], str]:
         "HOME": str(tmp_path),
         "FAKE_GH_LOG": str(log),
         "FAKE_PINS_B64": base64.b64encode(PINS_YAML.encode()).decode(),
+        "FAKE_CANARY_TITLE": CANARY_TITLE,
+        "FAKE_RUN_MISSING": "1" if missing_run else "0",
         "GITHUB_REPOSITORY": REPO,
         "GITHUB_SHA": PUSH_SHA,
         "GITHUB_EVENT_NAME": event,
@@ -112,6 +118,15 @@ def test_manual_dispatch_runs_the_canary(tmp_path):
     _assert_canary(*_run(tmp_path, "workflow_dispatch"))
 
 
+def test_canary_missing_run_records_title_and_bounded_lookups(tmp_path):
+    runs, summary = _run(tmp_path, "workflow_dispatch", missing_run=True)
+    assert len(runs) == 1
+    assert f"run not found yet; title: {CANARY_TITLE}" in summary
+    calls = (tmp_path / "gh.log").read_text().splitlines()
+    assert sum(call.startswith("run list") for call in calls) == 6
+    assert "actions/runs/987654321" not in summary
+
+
 def test_workflow_wires_script_and_crons():
     text = WORKFLOW.read_text()
     assert "- cron: '17 11 * * *'" in text
