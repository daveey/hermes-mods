From f9bf245dffca0f96b8b0dac3347a677a1b249a83 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 13 Oct 2026 20:26:27 -0700
Subject: [PATCH] fix(desktop): green status stripe stays after the session is
 opened (any finished turn) [daveey]

---
 .../src/app/chat/sidebar/session-row.tsx        |  6 +++---
 .../desktop/src/store/session-dot-state.test.ts | 17 ++++++++++-------
 apps/desktop/src/store/session-dot-state.ts     | 16 +++++++++++-----
 3 files changed, 24 insertions(+), 15 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row.tsx b/apps/desktop/src/app/chat/sidebar/session-row.tsx
index cede624b56..0041b67725 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.tsx
@@ -278,9 +278,9 @@ function SidebarSessionRowImpl({
   const dotState = useStoreSelector($sessionDotStateById, states => states[session.id] ?? 'idle')
   const liveTurn = hasLiveTurn(dotState)
   // [daveey] The left stripe is the session's status: green = its turn is done
-  // and waiting on you (finished, not yet opened); red = not done but stuck
-  // (blocked on a prompt, or gone quiet mid-turn). Working and idle: no stripe.
-  const statusStripe = sessionStatusStripe(dotState)
+  // and waiting on you (stays after you open it); red = not done but stuck
+  // (blocked on a prompt, or gone quiet mid-turn). Working: no stripe.
+  const statusStripe = session.archived ? null : sessionStatusStripe(dotState, session.message_count > 0)
 
   // Card header line: the workspace this belongs to — the project when it
   // resolves (same function the session color reads, so name and tint agree;
diff --git a/apps/desktop/src/store/session-dot-state.test.ts b/apps/desktop/src/store/session-dot-state.test.ts
index 13488ca9c8..d3be36451c 100644
--- a/apps/desktop/src/store/session-dot-state.test.ts
+++ b/apps/desktop/src/store/session-dot-state.test.ts
@@ -44,19 +44,22 @@ describe('showsRunningArc', () => {
 })
 
 describe('sessionStatusStripe', () => {
-  it('paints done (green) when a finished turn waits on the user', () => {
-    expect(sessionStatusStripe('unread')).toBe('done')
+  it('paints done (green) when a finished turn waits on the user, read or not', () => {
+    expect(sessionStatusStripe('unread', true)).toBe('done')
+    expect(sessionStatusStripe('idle', true)).toBe('done')
   })
 
   it('paints stuck (red) when an unfinished turn needs help', () => {
-    expect(sessionStatusStripe('needs-input')).toBe('stuck')
-    expect(sessionStatusStripe('stalled')).toBe('stuck')
+    expect(sessionStatusStripe('needs-input', true)).toBe('stuck')
+    expect(sessionStatusStripe('stalled', true)).toBe('stuck')
   })
 
-  it('paints nothing while working, idle, or drafting', () => {
-    for (const state of ['working', 'background', 'idle', 'draft'] as const) {
-      expect(sessionStatusStripe(state)).toBeNull()
+  it('paints nothing while working, or before any turn', () => {
+    for (const state of ['working', 'background', 'draft'] as const) {
+      expect(sessionStatusStripe(state, true)).toBeNull()
     }
+
+    expect(sessionStatusStripe('idle', false)).toBeNull()
   })
 })
 
diff --git a/apps/desktop/src/store/session-dot-state.ts b/apps/desktop/src/store/session-dot-state.ts
index feb7a640a5..083f11c91f 100644
--- a/apps/desktop/src/store/session-dot-state.ts
+++ b/apps/desktop/src/store/session-dot-state.ts
@@ -74,13 +74,19 @@ export type SessionDotState = 'background' | 'draft' | 'idle' | 'needs-input' |
  *  louder cue and two treatments at once fight each other. */
 export const showsRunningArc = (state: SessionDotState): boolean => state === 'stalled' || state === 'working'
 
-/** [daveey] The sidebar row's status stripe: `done` (green) when a finished
- *  turn waits on the user, `stuck` (red) when an unfinished one needs help —
- *  blocked on a prompt or gone quiet. Working, idle and drafts get none. */
+/** [daveey] The sidebar row's status stripe: `done` (green) when the agent
+ *  finished its turn and is waiting on the user — read or not, so it stays
+ *  after the row is opened; `stuck` (red) when an unfinished turn needs help —
+ *  blocked on a prompt or gone quiet. Working, background and drafts (no turn
+ *  yet) get none. */
 export type SessionStatusStripe = 'done' | 'stuck'
 
-export const sessionStatusStripe = (state: SessionDotState): null | SessionStatusStripe =>
-  state === 'unread' ? 'done' : state === 'needs-input' || state === 'stalled' ? 'stuck' : null
+export const sessionStatusStripe = (state: SessionDotState, hasTurns: boolean): null | SessionStatusStripe =>
+  state === 'needs-input' || state === 'stalled'
+    ? 'stuck'
+    : state === 'unread' || (state === 'idle' && hasTurns)
+      ? 'done'
+      : null
 
 /** Whether this turn is the session's own, live: brighter title, and the row's
  *  age yields to the actions menu. Wider than the arc — a turn waiting on an
-- 
