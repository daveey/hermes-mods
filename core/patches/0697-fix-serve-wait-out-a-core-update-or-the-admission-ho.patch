From a4ba7217bd700094dc53c36cd4588826f7fe5c31 Mon Sep 17 00:00:00 2001
From: David Bloomin <452472+daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:01:15 -0700
Subject: [PATCH] fix(serve): wait out a core update or the admission hold
 before loading the agent [daveey]

A Desktop-spawned SSH backend booted at 00:51:23 on David-MBP (2026-10-28), after
hermes-sync took the admission hold (00:51:19) but before `hermes update` wrote its
marker (00:51:25); the checkout moved at 00:51:44 and the backend served pre-update
code for 41 min. `hermes serve` now waits, before consuming the one-shot SSH token
and importing the agent stack, while a live update holds the marker/checkout lock
(bound 600 s, the always-on dashboard's policy) or the admission hold is set (bound
60 s; an update that starts meanwhile gets the update bound). Both bounds fail open
and are logged to stderr; our own update tree is exempt; HERMES_SERVE_UPDATE_WAIT_S=0
disables the gate.
---
 hermes_cli/main.py                         |   8 +
 hermes_cli/serve_update_wait.py            | 135 +++++++++++++
 tests/hermes_cli/test_serve_update_wait.py | 214 +++++++++++++++++++++
 3 files changed, 357 insertions(+)
 create mode 100644 hermes_cli/serve_update_wait.py
 create mode 100644 tests/hermes_cli/test_serve_update_wait.py

diff --git a/hermes_cli/main.py b/hermes_cli/main.py
index eeec79140a..27246bcea0 100644
--- a/hermes_cli/main.py
+++ b/hermes_cli/main.py
@@ -2795,6 +2795,14 @@ def cmd_dashboard(args):
 
     apply_nofile_soft_limit()
 
+    if _headless_backend:
+        # [daveey] Never boot a backend on a tree a core update is about to swap: wait out a live
+        # update or hermes-sync's admission hold (bounded, logged) before the one-shot SSH token is
+        # consumed and before the agent stack is imported (hermes_cli/serve_update_wait.py).
+        from hermes_cli.serve_update_wait import wait_for_update_clear
+
+        wait_for_update_clear()
+
     _ssh_session_token = _read_ssh_session_token_file(_token_file) if _token_file else None
     _mcp_discovery_after_bind = _dashboard_prepare_runtime(args, _headless_backend)
 
diff --git a/hermes_cli/serve_update_wait.py b/hermes_cli/serve_update_wait.py
new file mode 100644
index 0000000000..0a1c4b8271
--- /dev/null
+++ b/hermes_cli/serve_update_wait.py
@@ -0,0 +1,135 @@
+"""[daveey] ``hermes serve`` waits out a core update before it imports the agent stack.
+
+A backend that boots while ``hermes update`` is between its drain and its checkout imports the old
+tree and keeps serving it until something retires it (``web_server_skew_exit``, which only fires
+between turns). David-MBP 2026-10-28: the mac-mini Desktop respawned its SSH backend (pid 75803) at
+00:51:23.55, after hermes-sync had taken the admission hold (00:51:19) but before ``hermes update``
+had started and written its marker (00:51:25). The checkout moved at 00:51:44, the backend had
+finished its imports by 00:51:31, and it served pre-update code until 01:32.
+
+So the startup gate watches both signals:
+
+* a live update (the ``.hermes-update-in-progress`` marker or a held checkout lock, the same
+  ``update_lock`` reads the always-on dashboard and Desktop's spawn gate use). Waited out up to
+  :data:`UPDATE_WAIT_S` (the always-on dashboard's 600 s policy). A Desktop client that stops waiting
+  for READY kills this process and its own spawn gate then parks on the marker, so a long wait never
+  wedges a client.
+* the hermes-sync admission hold (``<root>/core-update/holds/hermes-sync``), which is set seconds
+  before ``hermes update`` starts. A hold alone does not prove an update is coming (a drain window
+  holds it while turns finish), so it is waited out for at most :data:`HOLD_WAIT_S`; if a marker
+  appears meanwhile, the update bound applies.
+
+Both bounds fail open: after them the backend starts anyway (a stale marker must not keep it down),
+and the code-skew watchdog still retires it once the checkout has moved. Our own update tree is
+exempt (an updater that spawns ``serve`` must not wait on itself). ``HERMES_SERVE_UPDATE_WAIT_S=0``
+turns the gate off.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import time
+from pathlib import Path
+from typing import Callable, Optional
+
+UPDATE_WAIT_S = 600.0
+HOLD_WAIT_S = 60.0
+POLL_S = 1.0
+
+
+def _env_seconds(name: str, default: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        return max(0.0, float(raw))
+    except ValueError:
+        return default
+
+
+def update_live() -> bool:
+    """A live ``hermes update`` owns this install, and it is not the update that spawned us."""
+    try:
+        from hermes_cli import update_lock as ul
+
+        holder = ul.read_live_update()
+        if holder is not None and holder.pid:
+            return not (holder.pid == os.getpid() or ul._is_ancestor_pid(holder.pid))
+        if holder is None and not ul.checkout_lock_held():
+            return False
+        # A held checkout lock (with or without a dead marker): ours if we inherited it.
+        return ul._inherited_lock_fd(ul.checkout_lock_path()) is None
+    except Exception:
+        return False  # the marker read fails open everywhere else too (update_lock doc)
+
+
+def admission_hold_present(root: Optional[Path] = None) -> bool:
+    """hermes-sync's admission hold is set: an update may start any second."""
+    try:
+        from hermes_cli.admission_fence import is_held
+
+        if root is None:
+            from hermes_constants import get_default_hermes_root
+
+            root = get_default_hermes_root()
+        return is_held(Path(root) / "core-update")
+    except Exception:
+        return False  # a hint, not a fence: an unreadable hold must not delay every start
+
+
+def _stderr(msg: str) -> None:
+    print(msg, file=sys.stderr, flush=True)
+
+
+def wait_for_update_clear(*, update_probe: Optional[Callable[[], bool]] = None,
+                          hold_probe: Optional[Callable[[], bool]] = None,
+                          update_timeout_s: Optional[float] = None,
+                          hold_timeout_s: Optional[float] = None,
+                          sleep: Callable[[float], None] = time.sleep,
+                          now: Callable[[], float] = time.monotonic,
+                          log: Optional[Callable[[str], None]] = None) -> str:
+    """Block until no update is live and no admission hold is set, within the bounds.
+
+    Returns ``"clear"`` (nothing to wait for), ``"cleared"`` (waited, now clear),
+    ``"update-timeout"`` or ``"hold-timeout"`` (gave up; the caller starts anyway).
+    """
+    if update_timeout_s is None:
+        update_timeout_s = _env_seconds("HERMES_SERVE_UPDATE_WAIT_S", UPDATE_WAIT_S)
+    if hold_timeout_s is None:
+        hold_timeout_s = min(update_timeout_s, _env_seconds("HERMES_SERVE_HOLD_WAIT_S", HOLD_WAIT_S))
+    emit = log or _stderr
+    update_probe = update_probe or update_live
+    hold_probe = hold_probe or admission_hold_present
+    if update_timeout_s <= 0:
+        return "clear"
+    start = now()
+    waiting_on = ""
+    seen_update = False
+    while True:
+        live = update_probe()
+        seen_update = seen_update or live
+        # Once an update has run and released its marker, the checkout is the new one: a hold
+        # hermes-sync has not dropped yet is no reason to keep waiting.
+        held = not live and not seen_update and hold_probe()
+        elapsed = now() - start
+        if not live and not held:
+            if waiting_on:
+                emit(f"serve: core update clear after {elapsed:.0f}s; starting on the current checkout")
+                return "cleared"
+            return "clear"
+        reason = "update" if live else "hold"
+        if live and elapsed >= update_timeout_s:
+            emit(f"serve: core update still in progress after {elapsed:.0f}s; starting anyway")
+            return "update-timeout"
+        if held and elapsed >= hold_timeout_s:
+            emit(f"serve: update admission hold still set after {elapsed:.0f}s and no update started; "
+                "starting anyway")
+            return "hold-timeout"
+        if reason != waiting_on:
+            what = ("a core update is in progress" if live
+                    else "the update admission hold is set (an update is about to start)")
+            emit(f"serve: {what}; waiting before loading the agent so this backend runs the new code "
+                f"(bound {update_timeout_s if live else hold_timeout_s:.0f}s)")
+            waiting_on = reason
+        sleep(_env_seconds("HERMES_SERVE_UPDATE_POLL_S", POLL_S) or POLL_S)
diff --git a/tests/hermes_cli/test_serve_update_wait.py b/tests/hermes_cli/test_serve_update_wait.py
new file mode 100644
index 0000000000..609cbac586
--- /dev/null
+++ b/tests/hermes_cli/test_serve_update_wait.py
@@ -0,0 +1,214 @@
+"""[daveey] ``hermes serve`` must not load the agent stack while a core update is about to swap it.
+
+David-MBP 2026-10-28: a Desktop-spawned SSH backend booted at 00:51:23, between hermes-sync's
+admission hold (00:51:19) and the checkout move (00:51:44), and served pre-update code for 41 min.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import textwrap
+import threading
+import time
+import types
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import serve_update_wait as suw
+
+
+# ── cmd_dashboard harness: everything but the update gate is stubbed ─────────────────────────
+
+
+@pytest.fixture
+def serve_harness(monkeypatch):
+    import hermes_cli.main as main_mod
+
+    calls: list[str] = []
+    started = threading.Event()
+
+    for name in ("_dashboard_lifecycle_flags", "_dashboard_sanitize_desktop_env", "_attach_to_host_backend",
+                 "_route_named_profile_dashboard", "_maybe_setup_dashboard_auth_interactively"):
+        monkeypatch.setattr(main_mod, name, lambda *a, **k: None)
+    monkeypatch.setattr(main_mod, "_dashboard_validate_serve_args", lambda *a, **k: "nonce")
+    monkeypatch.setattr(main_mod, "_dashboard_prepare_runtime", lambda *a, **k: False)
+    monkeypatch.setattr(main_mod, "_ssh_bootstrap_server_kwargs", lambda *a, **k: {})
+
+    def _read_token(path):
+        calls.append("token")
+        return "tok"
+
+    monkeypatch.setattr(main_mod, "_read_ssh_session_token_file", _read_token)
+
+    import hermes_cli.resource_limits as rl
+    monkeypatch.setattr(rl, "apply_nofile_soft_limit", lambda: None)
+    import hermes_cli.observability.shared_metrics_process as smp
+    monkeypatch.setattr(smp, "begin_process", lambda *a, **k: None)
+
+    def _start_server(**kwargs):
+        calls.append("start_server")
+        started.set()
+
+    fake_web = types.ModuleType("hermes_cli.web_server")
+    fake_web.start_server = _start_server  # type: ignore[attr-defined]
+    monkeypatch.setitem(sys.modules, "hermes_cli.web_server", fake_web)
+    monkeypatch.setenv("HERMES_SERVE_UPDATE_POLL_S", "0.02")
+
+    args = types.SimpleNamespace(
+        ssh_session_token_file="/nonexistent/token", headless_backend=True, isolated=True,
+        host="127.0.0.1", port=0, no_open=True, insecure=False, open_profile="",
+    )
+
+    def run_in_thread():
+        t = threading.Thread(target=main_mod.cmd_dashboard, args=(args,), daemon=True)
+        t.start()
+        return t
+
+    return types.SimpleNamespace(calls=calls, started=started, run=run_in_thread,
+                                 call=lambda: main_mod.cmd_dashboard(args))
+
+
+def test_serve_started_while_update_live_does_not_serve_until_it_clears(serve_harness, monkeypatch):
+    held = threading.Event()
+    held.set()
+    monkeypatch.setattr(suw, "update_live", held.is_set)
+    monkeypatch.setattr(suw, "admission_hold_present", lambda: False)
+
+    thread = serve_harness.run()
+    assert not serve_harness.started.wait(0.6), "serve started while the update marker was live"
+    assert serve_harness.calls == [], "the one-shot SSH token was consumed before the update cleared"
+
+    held.clear()
+    assert serve_harness.started.wait(3.0), "serve never started after the update cleared"
+    thread.join(3.0)
+    assert serve_harness.calls == ["token", "start_server"]
+
+
+def test_serve_with_no_update_starts_immediately(serve_harness, monkeypatch):
+    monkeypatch.setattr(suw, "update_live", lambda: False)
+    monkeypatch.setattr(suw, "admission_hold_present", lambda: False)
+    slept: list[float] = []
+    monkeypatch.setattr(suw.time, "sleep", lambda s: slept.append(s))
+
+    t0 = time.monotonic()
+    serve_harness.call()
+    assert serve_harness.calls == ["token", "start_server"]
+    assert slept == []
+    assert time.monotonic() - t0 < 1.0
+
+
+def test_serve_waits_on_a_real_admission_hold_file(serve_harness, monkeypatch, tmp_path):
+    # The incident's live signal: hermes-sync's hold, set before `hermes update` wrote any marker.
+    monkeypatch.setattr(suw, "update_live", lambda: False)
+    hold = tmp_path / "core-update" / "holds" / "hermes-sync"
+    hold.parent.mkdir(parents=True)
+    hold.write_text("x")
+    real_hold = suw.admission_hold_present
+    assert real_hold(tmp_path) is True
+    monkeypatch.setattr(suw, "admission_hold_present", lambda: real_hold(tmp_path))
+
+    thread = serve_harness.run()
+    assert not serve_harness.started.wait(0.6), "serve started while the admission hold was set"
+    hold.unlink()
+    assert serve_harness.started.wait(3.0)
+    thread.join(3.0)
+
+
+def test_serve_waits_on_a_real_marker_held_by_a_live_updater(serve_harness, monkeypatch, tmp_path):
+    """End to end on the real marker protocol: another process holds UpdateLock."""
+    home = tmp_path / "home"
+    home.mkdir()
+    (tmp_path / "install").mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    import hermes_constants
+    monkeypatch.setattr(hermes_constants, "_default_hermes_root_memo", None, raising=False)
+    monkeypatch.setattr(suw, "admission_hold_present", lambda: False)
+    repo = Path(__file__).resolve().parents[2]
+    holder = subprocess.Popen(
+        [sys.executable, "-c", textwrap.dedent(f"""
+            import sys
+            sys.path.insert(0, {str(repo)!r})
+            from hermes_cli.update_lock import UpdateLock
+            lock = UpdateLock(install_root={str(tmp_path / 'install')!r})
+            print('acquired' if lock.acquire() else 'refused', flush=True)
+            sys.stdin.readline()
+        """)],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
+        env={**os.environ, "HERMES_HOME": str(home)},
+    )
+    try:
+        assert holder.stdout.readline().strip() == "acquired"
+        assert (home / ".hermes-update-in-progress").exists()
+        assert suw.update_live() is True
+        thread = serve_harness.run()
+        assert not serve_harness.started.wait(0.8), "serve started while a live updater held the marker"
+        holder.stdin.write("\n")
+        holder.stdin.flush()
+        holder.wait(10)
+        assert serve_harness.started.wait(5.0), "serve never started after the updater released"
+        thread.join(3.0)
+    finally:
+        if holder.poll() is None:
+            holder.kill()
+
+
+# ── the wait policy itself ────────────────────────────────────────────────────────────────────
+
+
+class _Clock:
+    def __init__(self):
+        self.t = 0.0
+
+    def now(self):
+        return self.t
+
+    def sleep(self, s):
+        self.t += s
+
+
+def test_wait_is_bounded_and_logged_then_proceeds():
+    clock, lines = _Clock(), []
+    out = suw.wait_for_update_clear(update_probe=lambda: True, hold_probe=lambda: False,
+                                    update_timeout_s=10, sleep=clock.sleep, now=clock.now, log=lines.append)
+    assert out == "update-timeout"
+    assert 10 <= clock.t <= 11
+    assert any("waiting" in line for line in lines) and any("starting anyway" in line for line in lines)
+
+
+def test_hold_alone_has_a_shorter_bound():
+    clock, lines = _Clock(), []
+    out = suw.wait_for_update_clear(update_probe=lambda: False, hold_probe=lambda: True,
+                                    update_timeout_s=600, hold_timeout_s=5,
+                                    sleep=clock.sleep, now=clock.now, log=lines.append)
+    assert out == "hold-timeout" and 5 <= clock.t <= 6
+
+
+def test_hold_then_update_uses_the_update_bound_and_ignores_the_trailing_hold():
+    clock, lines = _Clock(), []
+
+    def update():  # hold at t<3, update 3..100, trailing hold after
+        return 3 <= clock.t < 100
+
+    out = suw.wait_for_update_clear(update_probe=update, hold_probe=lambda: True,
+                                    update_timeout_s=600, hold_timeout_s=5,
+                                    sleep=clock.sleep, now=clock.now, log=lines.append)
+    assert out == "cleared"
+    assert 100 <= clock.t <= 101
+
+
+def test_zero_bound_disables_the_gate():
+    assert suw.wait_for_update_clear(update_probe=lambda: True, hold_probe=lambda: True,
+                                     update_timeout_s=0, log=lambda s: None) == "clear"
+
+
+def test_update_spawned_by_our_own_updater_is_not_waited_on(monkeypatch):
+    from hermes_cli import update_lock as ul
+
+    monkeypatch.setattr(ul, "read_live_update", lambda **k: ul.UpdateHolder(pid=os.getppid(), age_seconds=1.0))
+    assert suw.update_live() is False
+    monkeypatch.setattr(ul, "read_live_update", lambda **k: ul.UpdateHolder(pid=1, age_seconds=1.0))
+    monkeypatch.setattr(ul, "_is_ancestor_pid", lambda pid: False)
+    assert suw.update_live() is True
