From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 02:45:27 +0000
Subject: [PATCH 6331] Semantic annotation parts and fail-fresh caching

Public mirror of source commit fb75b963ff5f3c5478575c2c74cb11d5eb7f0fbf.

---
diff --git a/tests/hermes_cli/test_kanban_annotation_done_inputs.py b/tests/hermes_cli/test_kanban_annotation_done_inputs.py
index 41f5ff6d2d5..971a9f6ce2e 100644
--- a/tests/hermes_cli/test_kanban_annotation_done_inputs.py
+++ b/tests/hermes_cli/test_kanban_annotation_done_inputs.py
@@ -110,4 +110,8 @@
     a, b = make(), make()
     di.declaration('c', a, list)
     assert di.key({'c': a}) == di.key({'c': a})
-    assert di.key({'c': b}) != di.key({'c': b})  # undeclared fn b
+    old = di.key({'c': a})
+    di.declaration('c', b, list)
+    assert di.key({'c': b}) != old  # same code and inputs, distinct closure
+    assert di.key({'c': b}) == di.key({'c': b})
+    assert di.key({'c': a}) != di.key({'c': a})  # replaced fn a is undeclared
