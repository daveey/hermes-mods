From 11d34ebf2f31f0e84cdc7e1b3028072d80ea7084 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:20:05 +0000
Subject: [PATCH] [daveey] Require a concrete locality reason before hub helper
 pins

Producer guidance: check attested worker reach for hub reads, remote Macs, GitHub and shipping; name the unavailable operation or input. Preserve foreign-card and registry write authority boundaries. Proof: schema guidance regression passes; no placement eligibility or admission changes.
---
 tests/tools/test_kanban_helper_placement_guidance.py | 10 ++++++++++
 tools/kanban_tools_schemas.py                        |  5 +++++
 2 files changed, 15 insertions(+)
 create mode 100644 tests/tools/test_kanban_helper_placement_guidance.py

diff --git a/tests/tools/test_kanban_helper_placement_guidance.py b/tests/tools/test_kanban_helper_placement_guidance.py
new file mode 100644
index 00000000000..d9358b720b6
--- /dev/null
+++ b/tests/tools/test_kanban_helper_placement_guidance.py
@@ -0,0 +1,10 @@
+"""Placement hints distinguish reachable evidence from host-only operations."""
+from tools.kanban_tools_schemas import KANBAN_CREATE_SCHEMA
+
+
+def test_helper_placement_guidance_checks_reach_without_granting_write_authority():
+    description = KANBAN_CREATE_SCHEMA["parameters"]["properties"]["placement"]["description"]
+    assert "workers' attested capabilities" in description
+    assert "hub-local write, unavailable runtime access or unpublished input" in description
+    assert "A hub name in evidence is not a locality requirement" in description
+    assert "Read access does not grant foreign-card or registry write authority" in description
diff --git a/tools/kanban_tools_schemas.py b/tools/kanban_tools_schemas.py
index 7b1e023cea2..7bb70acc7c4 100644
--- a/tools/kanban_tools_schemas.py
+++ b/tools/kanban_tools_schemas.py
@@ -808,6 +808,11 @@ KANBAN_CREATE_SCHEMA = _schema(
                     "machine picks up this board; then use placement='<name>'."},
         "placement": _prop("string", (
                 "Where the card runs. 'auto' uses configured worker pools for portable work, queueing without hub overflow. "
+                "Before pinning a helper to the hub, check the workers' attested capabilities: hub log/DB reads, "
+                "remote Mac access, GitHub work and shipping may already run there. Pin only for a concrete "
+                "hub-local write, unavailable runtime access or unpublished input; name that operation or path "
+                "in the body. A hub name in evidence is not a locality requirement. Read access does not grant "
+                "foreign-card or registry write authority. "
                 "Without a pool, kanban.placement routes (e.g. MacBook -> hub; hermes-hub aliases hub) create "
                 "portable cards on that gateway, linked to this chat. 'local' pins it here "
                 "(use it when the work needs this machine: its Chrome, "
-- 
