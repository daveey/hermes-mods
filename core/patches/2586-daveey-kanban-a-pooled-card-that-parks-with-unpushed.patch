+def _placement_events(conn, tid):
+    return [(k, json.loads(p)) for k, p in conn.execute(
+        "SELECT kind, payload FROM task_events WHERE task_id = ? AND kind IN ('pool_pinned', 'pool_unpinned') "
+        "ORDER BY id", (tid,))]
