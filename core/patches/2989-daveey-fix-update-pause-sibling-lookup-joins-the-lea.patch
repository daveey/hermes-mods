From 19b294eee2060cfe7d990bdf8ee3a171885580c3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:18:28 +0000
Subject: [PATCH] [daveey] fix(update-pause): sibling lookup joins the lead
 alarm; refusal class keeps the busy cause

Review t_01a1d0af43dbe05a of 994bc0813f:
- find_sibling preferred the oldest match, but created_at has one-second
  resolution and ids are random, so a follower filed in the same second
  could sort first and a third host linked to it (test_b flaked 5/8). It
  now prefers the oldest match naming no open sibling (the lead).
- refusal_class cut at the first ": ", which falls at "[cause: " in the
  real busy refusal, so every busy cause was one class. The cause's head
  is kept; only its own detail is dropped.
- Nits: an own card is adopted under any name the host carries (a host
  enrolling in the Board mid-streak keeps its card); an empty created_on
  counts as own; both sides of the class comparison use the first line.
---
 hermes_cli/update_pause_deferrals.py          | 19 +++--
 hermes_cli/update_pause_siblings.py           | 35 ++++++---
 .../hermes_cli/test_update_pause_deferrals.py | 73 +++++++++++++++++++
 3 files changed, 109 insertions(+), 18 deletions(-)

diff --git a/hermes_cli/update_pause_deferrals.py b/hermes_cli/update_pause_deferrals.py
index faf7bd327c..653f6f5ecd 100644
--- a/hermes_cli/update_pause_deferrals.py
+++ b/hermes_cli/update_pause_deferrals.py
@@ -162,16 +162,20 @@ def main(argv: list[str] | None = None) -> int:
     return 0
 
 
-def _own_row(conn, key: str, legacy: str, own: frozenset):
-    """This host's newest non-archived alarm under ``key``, or under the pre-host ``legacy`` key when
-    this host created it (a streak open across the upgrade keeps its owner; another host's never)."""
+def _own_row(conn, keys: frozenset, legacy: str, own: frozenset):
+    """This host's newest non-archived alarm under one of its ``keys`` (one per name the host has
+    carried: a host that enrolls in the Board mid-streak keeps its hostname-keyed card), or under the
+    pre-host ``legacy`` key when this host created it (a streak open across the upgrade keeps its
+    owner; another host's never). An empty ``created_on`` is a card this board file created."""
     cols = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
     on = "created_on" if "created_on" in cols else "NULL"
+    wanted = sorted(keys | {legacy})
     for row in conn.execute(
-        f"SELECT id, status, idempotency_key, {on} FROM tasks WHERE idempotency_key IN (?, ?) "
-        "AND status != 'archived' ORDER BY created_at DESC, rowid DESC", (key, legacy),
+        f"SELECT id, status, idempotency_key, {on} FROM tasks WHERE idempotency_key IN "
+        f"({','.join('?' * len(wanted))}) AND status != 'archived' ORDER BY created_at DESC, rowid DESC",
+        wanted,
     ):
-        if row[2] == key or row[3] is None or row[3] in own:
+        if row[2] in keys or not row[3] or row[3] in own:
             return row
     return None
 
@@ -189,7 +193,8 @@ def _report(conn, unit: str, count: int, first_at: str, reason: str) -> str:
                 f"Latest refusal: {reason}")
     # Serialize lookup + create so overlapping unattended updates cannot create two owners.
     with kb.write_txn(conn, allow_nested=True):
-        row = _own_row(conn, key, sib.legacy_key(root, unit), own)
+        keys = frozenset({key, *(sib.alarm_key(name, root, unit) for name in own)})
+        row = _own_row(conn, keys, sib.legacy_key(root, unit), own)
         if row and row[1] not in {"done", "failed", "cancelled"}:
             if count % REFRESH_EVERY == 0 and not conn.execute(
                 "SELECT 1 FROM task_comments WHERE task_id = ? AND author = ? AND body = ?",
diff --git a/hermes_cli/update_pause_siblings.py b/hermes_cli/update_pause_siblings.py
index b86f8b6af4..dc4d7e84c1 100644
--- a/hermes_cli/update_pause_siblings.py
+++ b/hermes_cli/update_pause_siblings.py
@@ -34,6 +34,7 @@ _HOST = re.compile(r"^On `([^`]+)`", re.MULTILINE)
 _REFUSAL = re.compile(r"Latest refusal: (.*)$", re.MULTILINE)
 _SIBLING = re.compile(r"^Sibling alarm: (t_\w+)", re.MULTILINE)
 _NUMBER = re.compile(r"\d+(?:\.\d+)?")
+_CAUSE = re.compile(r"\[cause: (.*)\]")
 
 
 def alarm_key(host: str, root, unit: str) -> str:
@@ -55,13 +56,21 @@ def host_identity(conn: sqlite3.Connection) -> tuple[str, frozenset]:
 
 
 def refusal_class(unit: str, reason) -> str:
-    """The refusal without its variable parts: the unit name, numbers (pids, seconds) and the detail
-    after the first ``": "`` (stderr, exception text). Two hosts refused alike when the classes match."""
-    text = str(reason or "")
+    """The refusal's first line without its variable parts: the unit name, numbers (pids, seconds) and
+    detail (stderr, exception text) after a ``": "``. Two hosts refused alike when the classes match.
+
+    The busy refusal carries its cause as ``[cause: <cause>]`` (``update_cmd_posix_pause``): the cause's
+    head is kept and only its own detail dropped, so "refused the update checkpoint", "did not answer
+    the pause request (TimeoutError" and "gave no answer on its control socket" stay distinct classes."""
+    lines = str(reason or "").strip().splitlines()
+    text = lines[0] if lines else ""  # the body keeps only this line (``_REFUSAL``): class both alike
     if unit:
         text = text.replace(unit, "<unit>")
-    text = _NUMBER.sub("N", text.split(": ", 1)[0])
-    return " ".join(text.lower().split())[:200]
+    if m := _CAUSE.search(text):
+        text = f"{text[:m.start()]}[cause: {m.group(1).split(': ', 1)[0]}]{text[m.end():]}"
+    else:
+        text = text.split(": ", 1)[0]
+    return " ".join(_NUMBER.sub("N", text).lower().split())[:200]
 
 
 def _db_path(conn: sqlite3.Connection) -> Optional[str]:
@@ -108,13 +117,17 @@ def _board_alarms(conn: sqlite3.Connection, unit: str) -> list[dict]:
 
 
 def find_sibling(conn: sqlite3.Connection, unit: str, reason, own: frozenset) -> Optional[dict]:
-    """The oldest open alarm another host filed for ``unit`` with this refusal's class, else None.
-    Oldest, so a third host joins the first investigation rather than a follower of it."""
+    """The open alarm another host filed for ``unit`` with this refusal's class that leads the shared
+    investigation, else None: the oldest one that names no open sibling itself, so a third host joins
+    the first investigation rather than a follower of it. ``created_at`` has one-second resolution and
+    ids are random, so age alone cannot order two alarms filed in the same second."""
     want = refusal_class(unit, reason)
-    for alarm in _board_alarms(conn, unit):
-        if alarm["host"] and alarm["host"] not in own and refusal_class(unit, alarm["refusal"]) == want:
-            return alarm
-    return None
+    alarms = _board_alarms(conn, unit)
+    open_ids = {a["id"] for a in alarms}
+    matches = [a for a in alarms
+               if a["host"] and a["host"] not in own and refusal_class(unit, a["refusal"]) == want]
+    leads = [a for a in matches if a["sibling"] not in open_ids]
+    return (leads or matches or [None])[0]
 
 
 def sibling_section(sibling: dict, host: str) -> str:
diff --git a/tests/hermes_cli/test_update_pause_deferrals.py b/tests/hermes_cli/test_update_pause_deferrals.py
index adcd08c7fe..d270dd9f4e 100644
--- a/tests/hermes_cli/test_update_pause_deferrals.py
+++ b/tests/hermes_cli/test_update_pause_deferrals.py
@@ -270,6 +270,24 @@ def test_b_second_host_names_the_open_sibling_and_comments_on_it(tmp_path, monke
     assert _file(monkeypatch, "worker-1", count=4) == w1 and len(_card(w5)[2]) == 2
 
 
+def test_b_a_third_host_joins_the_lead_alarm_even_when_a_follower_sorts_first(tmp_path, monkeypatch):
+    """created_at has one-second resolution and ids are random: a follower filed in the same second can
+    sort before the alarm it follows. A third host must still join the lead (the alarm naming no open
+    sibling), never the follower. Pinned here by making the follower look older."""
+    from hermes_cli.kanban_db_connect import connect_closing
+    _board(tmp_path, monkeypatch)
+    w5 = _file(monkeypatch, "worker-5")
+    w1 = _file(monkeypatch, "worker-1")
+    assert f"Sibling alarm: {w5}" in _card(w1)[0]
+    with connect_closing() as conn:
+        conn.execute("UPDATE tasks SET created_at = (SELECT created_at FROM tasks WHERE id = ?) - 1 "
+                     "WHERE id = ?", (w5, w1))
+        conn.commit()
+    w6 = _file(monkeypatch, "worker-6")
+    assert f"Sibling alarm: {w5}" in _card(w6)[0], "worker-6 joined worker-1's follower card"
+    assert _card(w1)[2] == []
+
+
 def test_b_the_cli_child_entry_links_the_sibling(tmp_path, monkeypatch, capsys):
     """(b) via ``main`` (the child interpreter ``report`` spawns): same linking."""
     _board(tmp_path, monkeypatch)
@@ -373,6 +391,61 @@ def test_refusal_classes_ignore_pids_seconds_and_detail():
     assert sib.refusal_class(FLEET, FLEET_BUSY) != sib.refusal_class(FLEET, DRAINING)
 
 
+def _busy(cause):
+    return f"{FLEET} is busy or cannot acknowledge an idle pause [cause: {cause}]; retry when idle"
+
+
+def test_refusal_classes_keep_the_head_of_the_busy_cause():
+    """The real busy refusal carries ``[cause: ...]``: its head separates host failures, its detail does not."""
+    from hermes_cli import update_pause_siblings as sib
+    refused = _busy("gateway refused the update checkpoint: 2 turns running")
+    timeout = _busy("did not answer the pause request (TimeoutError: timed out after 8.0s)")
+    silent = _busy("gave no answer on its control socket")
+    classes = {sib.refusal_class(FLEET, r) for r in (refused, timeout, silent, FLEET_BUSY)}
+    assert len(classes) == 4, "different host failures were linked as one shared cause"
+    assert sib.refusal_class(FLEET, refused) == \
+        sib.refusal_class(FLEET, _busy("gateway refused the update checkpoint: 5 turns running"))
+    assert sib.refusal_class(FLEET, timeout) == \
+        sib.refusal_class(FLEET, _busy("did not answer the pause request (TimeoutError: timed out after 3s)"))
+    # The card body keeps one line of the refusal: a multi-line reason classes alike on both sides.
+    assert sib.refusal_class(FLEET, silent + "\nstderr: boom") == sib.refusal_class(FLEET, silent)
+
+
+def test_c_another_cause_on_another_host_is_no_sibling(tmp_path, monkeypatch):
+    """(c) Same unit, both busy, different causes: no link, no comment."""
+    _board(tmp_path, monkeypatch)
+    w5 = _file(monkeypatch, "worker-5", reason=_busy("gave no answer on its control socket"))
+    w1 = _file(monkeypatch, "worker-1", reason=_busy("gateway refused the update checkpoint: busy"))
+    assert "Sibling alarm" not in _card(w1)[0] and _card(w5)[2] == []
+
+
+def test_a_host_that_enrolls_in_the_board_mid_streak_keeps_its_card(tmp_path, monkeypatch):
+    """The key names the Board gateway id, else the hostname: gaining a gateway id mid-streak must not
+    file a second card for the same host."""
+    from hermes_cli import kanban_capability_routing as kcr
+    _board(tmp_path, monkeypatch)
+    before = _file(monkeypatch, "hermes-worker-1")
+    monkeypatch.setattr(kcr, "_own_gateway", lambda conn: "worker-1")
+    assert _file(monkeypatch, "hermes-worker-1", count=4) == before
+
+
+def test_an_own_pre_host_key_card_with_an_empty_created_on_is_kept(tmp_path, monkeypatch):
+    """An empty ``created_on`` is this board file's own card (as elsewhere in kanban)."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import update_pause_siblings as sib
+    from hermes_cli.kanban_db_connect import connect_closing
+    from hermes_cli.update_pause_record import install_root
+    _board(tmp_path, monkeypatch)
+    with connect_closing() as conn:
+        old = kb.create_task(conn, title=sib.TITLE + FLEET, assignee="default", created_by="update-pause",
+                             idempotency_key=sib.legacy_key(install_root(), FLEET), body="On `worker-1` ...")
+        if "created_on" not in {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}:
+            conn.execute("ALTER TABLE tasks ADD COLUMN created_on TEXT")  # as a synced board has it
+        conn.execute("UPDATE tasks SET created_on = '' WHERE id = ?", (old,))
+        conn.commit()
+    assert _file(monkeypatch, "worker-1") == old
+
+
 def test_an_open_pre_host_key_card_of_this_host_is_kept(tmp_path, monkeypatch):
     """A streak open across the upgrade keeps its owner (legacy key)."""
     from hermes_cli import kanban_db as kb
