From dfa1c94864cc5dc8381187be2b6b28199a13aaf5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:50:21 +0000
Subject: [PATCH] redactor: drop primary_key from the identifier allowlist
 (Azure shared-access key name) [daveey]

Review t_01a1cf56c1c4cc35 (GitHub review 5873037398) found that allowlisting primary_key unmasks real Azure
shared-access keys (azurerm *.primary_key, azure-mgmt AccessKeys.primary_key): PRIMARY_KEY=, export
PRIMARY_KEY=, primary_key = "...", cosmos.primary_key= all passed through, and the wake_check refusal stopped
firing for them. Remove it; add still-masked controls (88-char base64) and a wake_check refusal case.
RED on fd50b4ad6c: 5 failed / 30 passed; green here.
---
 agent/redact_identifier_keys.py                 | 5 ++++-
 tests/agent/test_redact_identifier_key_names.py | 8 +++++++-
 tests/tools/test_kanban_probe_verbatim.py       | 1 +
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/agent/redact_identifier_keys.py b/agent/redact_identifier_keys.py
index 5f1c8adcbe..66038ae4dc 100644
--- a/agent/redact_identifier_keys.py
+++ b/agent/redact_identifier_keys.py
@@ -4,9 +4,12 @@ Their values are hashes or ``kind:ref:<sha>`` strings shaped like an opaque toke
 value-shape test masked ``idempotency_key='review:pr1305:<sha>'`` inside a Kanban wake_check, and the stored
 probe could never match (t_01a1cf477dece56b). Exact names only, any case: ``my_cache_key_secret`` is not on
 the list, and every credential name (``api_key``, ``secret_key``, ``private_key``, ``access_key``) still masks.
+``primary_key``/``secondary_key`` are deliberately absent: Azure names its shared-access keys that way (azurerm
+``*.primary_key``, azure-mgmt ``AccessKeys.primary_key``). A dotted name is judged on its last segment, so
+``cosmos.primary_key=`` masks too.
 """
 from __future__ import annotations
 
 IDENTIFIER_KEY_NAMES = frozenset({
-    "idempotency_key", "cache_key", "sort_key", "primary_key", "partition_key", "dedupe_key", "dedup_key",
+    "idempotency_key", "cache_key", "sort_key", "partition_key", "dedupe_key", "dedup_key",
 })
diff --git a/tests/agent/test_redact_identifier_key_names.py b/tests/agent/test_redact_identifier_key_names.py
index e170921601..8da3d48714 100644
--- a/tests/agent/test_redact_identifier_key_names.py
+++ b/tests/agent/test_redact_identifier_key_names.py
@@ -12,6 +12,7 @@ import pytest
 from agent.redact import redact_sensitive_text
 
 SHA = "848af5adae9e29a2ac677f26c732c996997a26b2"
+AZURE_KEY = "Zm9vYmFyYmF6cXV4" * 5 + "K3Rlc3Q="  # 88-char base64, the Azure shared-access key shape
 
 
 def _r(text: str) -> str:
@@ -28,7 +29,6 @@ def _r(text: str) -> str:
     f"idempotency_key='review:pr1305:{SHA}'\\\"\"",
     f"cache_key={SHA}",
     f"sort_key=Zz9{SHA}",
-    f"primary_key=user_id_{SHA}",
     f"partition_key=tenantA:{SHA}",
     f"dedupe_key=selfheal:{SHA}",
     f"dedup_key=selfheal:{SHA}",
@@ -49,6 +49,12 @@ def test_already_elided_idempotency_key_is_not_masked_further():
     ("secret_key=Qm9vbGVhbkZhbHNlVHJ1ZTEy", "Qm9vbGVhbkZhbHNlVHJ1ZTEy"),
     ("access_key=AKIA1234567890ABCDEF", "AKIA1234567890ABCDEF"),
     ("openai_key=" + "Ab3dE" * 8, "Ab3dE" * 8),
+    # Azure shared-access keys are named primary_key / PRIMARY_KEY (88-char base64): never allowlisted
+    ("PRIMARY_KEY=" + AZURE_KEY, AZURE_KEY),
+    ("export PRIMARY_KEY=" + AZURE_KEY, AZURE_KEY),
+    ('primary_key = "' + AZURE_KEY + '"', AZURE_KEY),
+    ("cosmos.primary_key=" + AZURE_KEY, AZURE_KEY),
+    ("secondary_key=" + AZURE_KEY, AZURE_KEY),
     # a name that only ends in an allowlisted name is not on the list
     ("my_cache_key_secret=" + "Ab3dE" * 8, "Ab3dE" * 8),
 ])
diff --git a/tests/tools/test_kanban_probe_verbatim.py b/tests/tools/test_kanban_probe_verbatim.py
index fa648e4386..d0848382ea 100644
--- a/tests/tools/test_kanban_probe_verbatim.py
+++ b/tests/tools/test_kanban_probe_verbatim.py
@@ -83,6 +83,7 @@ def test_schedule_stores_idempotency_key_probe_byte_identical(worker_env):
     "OPENAI_API_KEY=sk-proj-" + "Ab3dE" * 8,
     "api_key='sk-" + "Zq9" * 12 + "'",
     "AWS_SECRET_ACCESS_KEY=" + "wJalrXUtnFEMI/K7MDENG/bPxRfiCY" + "EXAMPLEKEY",
+    "PRIMARY_KEY=" + "Zm9vYmFyYmF6cXV4" * 5 + "K3Rlc3Q=",  # Azure shared-access key: not an identifier name
 ])
 def test_block_with_inline_secret_is_refused_not_masked(worker_env, secret_assignment):
     probe = f"{secret_assignment} curl -sf https://api.example.com/ready"
