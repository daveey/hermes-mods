From acedc3429f419dbd1fe905f467358ad4cec041e6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 10:42:31 +0000
Subject: [PATCH] [daveey] Make archive comment boundary fixture deterministic

---
 tests/hermes_cli/test_kanban_continue_archive.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_continue_archive.py b/tests/hermes_cli/test_kanban_continue_archive.py
index c65af280dffd046a19834788af56ab15d51b6334..f8f5175387dbb43717cc769fc58ddbce273d0c01 100644
--- a/tests/hermes_cli/test_kanban_continue_archive.py
+++ b/tests/hermes_cli/test_kanban_continue_archive.py
@@ -123,6 +123,10 @@ def test_comment_window_starts_at_current_run(w2, monkeypatch):
     tid, text = _task(w2, monkeypatch)
     monkeypatch.setattr(archive, "verify", lambda *args: True)
     kb.add_comment(w2.conn, tid, author="default", body=text)
+    with kb.write_txn(w2.conn):
+        w2.conn.execute("UPDATE task_comments SET created_at = (SELECT started_at FROM task_runs "
+                        "WHERE id = (SELECT current_run_id FROM tasks WHERE id = ?)) WHERE task_id = ?",
+                        (tid, tid))
     assert not archive.portable(w2.conn, tid, "resume")
     _backdate_run(w2.conn, tid, 5)
     assert archive.portable(w2.conn, tid, "resume")
