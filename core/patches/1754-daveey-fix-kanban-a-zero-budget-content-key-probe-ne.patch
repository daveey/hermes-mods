From edea0871e4db23598b4d7ef99bd0fec89eaa6132 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:03:02 +0000
Subject: [PATCH] [daveey] fix(kanban): a zero-budget content-key probe never
 waits in SQLite on a warm cached reader

PR #696 (ec2cfc7b931) made the content-key probe open with a zero busy
budget, but a warm cached reader keeps its own 500 ms SQLite busy_timeout,
so the probe body still waited the full 0.5 s on a busy board
(measured: 0.50 s warm vs 0.00 s cold). cached_ro now applies a lower
budget to the body's statements and restores the reader's timeout after.

Adds deterministic regressions: one busy budget per annotation pass on a
busy board (fingerprint key, memo key, real read), no open-retry sleep for
the probe, and the statement budget is lowered then restored.

Why the original timeout escaped CI: PR #475's required CI ran on its head
c058c7e3d3a, which lacked ab8d9bb45db (the content-key probes), and the merge
cf4ec3f1a15 combined them untested; the probes tripled a busy board's cost
per pass (t_01a19e082c8721b1).
---
 hermes_cli/kanban_session_activity.py         | 12 +++
 .../test_kanban_content_key_busy_budget.py    | 92 +++++++++++++++++++
 2 files changed, 104 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_content_key_busy_budget.py

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index f8db97c64c0..c1008ca018a 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -528,6 +528,11 @@ def cached_ro(path: Path, *, busy_budget: float = 0.5) -> Iterator[sqlite3.Conne
                 from hermes_cli.kanban_generation import DeletedWalGenerationError
                 raise DeletedWalGenerationError(f"kanban DB {path}: reader was evicted while waiting; retry")
         conn.row_factory = None
+        # [daveey] The budget covers the body's statements too: a warm cached reader otherwise spends its own 500 ms
+        # SQLite busy timeout on a busy board even when the open was asked for less (t_01a19e082c8721b1).
+        lowered = busy_budget < _RO_BUSY_TIMEOUT_S
+        if lowered:
+            conn.execute(f"PRAGMA busy_timeout={max(0, int(busy_budget * 1000))}")
         try:
             yield conn
         except sqlite3.Error:
@@ -536,6 +541,13 @@ def cached_ro(path: Path, *, busy_budget: float = 0.5) -> Iterator[sqlite3.Conne
                     del _RO_CACHE[key]
             _close_quietly(conn)
             raise
+        finally:
+            if lowered and _RO_CACHE.get(key) is entry:
+                conn.execute(f"PRAGMA busy_timeout={int(_RO_BUSY_TIMEOUT_S * 1000)}")
+
+
+# The cached reader's own SQLite busy timeout, set when ``kanban_reader_lifecycle`` opens it.
+_RO_BUSY_TIMEOUT_S = 0.5
 
 
 def _close_quietly(conn: sqlite3.Connection) -> None:
diff --git a/tests/hermes_cli/test_kanban_content_key_busy_budget.py b/tests/hermes_cli/test_kanban_content_key_busy_budget.py
new file mode 100644
index 00000000000..09c6cc12410
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_content_key_busy_budget.py
@@ -0,0 +1,92 @@
+"""One annotation pass spends one busy budget per board, not one per content-key read.
+
+The content key is advisory (a failed read falls back to the file stat), so a busy board must not
+make each key read wait out the reader's busy budget before the real read waits out its own.
+"""
+
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_reader_lifecycle as lifecycle
+from hermes_cli import kanban_session_activity as activity
+from hermes_cli.sqlite_safe_read import has_live_connection
+
+
+@pytest.fixture
+def busy_board(tmp_path, monkeypatch):
+    activity._reset_cache_for_tests()
+    board = tmp_path / "board.db"
+    monkeypatch.setattr(activity, "_board_db_paths", lambda: [board])
+    monkeypatch.setattr(activity, "_replica_paths", list)
+    blocker = sqlite3.connect(board)
+    blocker.execute("PRAGMA journal_mode=DELETE")
+    blocker.execute("CREATE TABLE marker(value)")
+    blocker.commit()
+    yield board, blocker
+    if blocker.in_transaction:
+        blocker.rollback()
+    blocker.close()
+    activity._reset_cache_for_tests()
+
+
+def _spy_budgets(monkeypatch):
+    budgets = []
+    original = lifecycle.cached_entry
+
+    def spy(path, busy_budget=0.5):
+        budgets.append(busy_budget)
+        return original(path, busy_budget)
+
+    monkeypatch.setattr(lifecycle, "cached_entry", spy)
+    return budgets
+
+
+def test_busy_board_counts_pass_waits_once(busy_board, monkeypatch):
+    _board, blocker = busy_board
+    budgets = _spy_budgets(monkeypatch)
+    blocker.execute("BEGIN EXCLUSIVE")
+    with pytest.raises(sqlite3.OperationalError, match="locked"):
+        activity._all_counts(include_snapshot=True)
+    # Fingerprint key, board-memo key, then the real read: only the read may wait.
+    assert len(budgets) == 3
+    assert [b for b in budgets if b > 0] == [0.5]
+    assert budgets[-1] == 0.5
+
+
+def test_content_key_on_busy_board_falls_back_without_waiting(busy_board, monkeypatch):
+    board, blocker = busy_board
+    stat_key = ("stat", activity._revision.file_stat(board))
+    sleeps = []
+    from hermes_cli import kanban_generation
+
+    monkeypatch.setattr(kanban_generation.time, "sleep", lambda s: sleeps.append(s))
+    blocker.execute("BEGIN EXCLUSIVE")
+    assert activity._board_content_key(board) == stat_key
+    assert sleeps == []  # no open retry loop behind a busy board
+    assert not has_live_connection(board)
+
+
+def test_cached_reader_statement_budget_restored_after_no_wait_key(busy_board):
+    board, _blocker = busy_board
+    with activity.cached_ro(board) as conn:  # warm: the key read reuses this cached handle
+        assert conn.execute("PRAGMA busy_timeout").fetchone()[0] == 500
+    seen = []
+    with activity.cached_ro(board, busy_budget=0) as conn:
+        seen.append(conn.execute("PRAGMA busy_timeout").fetchone()[0])
+    assert seen == [0]
+    with activity.cached_ro(board) as again:
+        assert again is conn
+        assert again.execute("PRAGMA busy_timeout").fetchone()[0] == 500
+
+
+def test_warm_key_read_on_busy_board_does_not_wait_in_sqlite(busy_board):
+    board, blocker = busy_board
+    with activity.cached_ro(board) as conn:
+        conn.execute("SELECT count(*) FROM marker").fetchone()
+    blocker.execute("BEGIN EXCLUSIVE")
+    # The cached handle is reused; with busy_timeout=0 SQLite raises at once and the key falls back.
+    assert activity._board_content_key(board)[0] == "stat"
+    blocker.rollback()
+    with activity.cached_ro(board) as reopened:
+        assert reopened.execute("PRAGMA busy_timeout").fetchone()[0] == 500
-- 
