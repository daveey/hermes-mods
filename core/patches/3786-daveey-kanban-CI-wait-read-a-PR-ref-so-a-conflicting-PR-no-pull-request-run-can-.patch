+def test_park_on_a_conflicting_pr_is_refused_naming_the_pr_and_rebase(kanban_home, api, monkeypatch) -> None:
+    api.dirty()
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+        out = _park(monkeypatch, conn, tid)
+        err = out.get("error") or ""
+        assert kcp.CI_RUN_UNSTARTABLE in err, out
+        assert f"#{PR}" in err and "rebase" in err and "state" in err, out
+        assert kb.get_task(conn, tid).status == "running"
