 gateway/run_bootstrap.py                 | 16 +++++-
 hermes_cli/gateway_exit_diag.py          |  3 +-
 tests/gateway/test_exit_deadline.py      | 27 ++++++++-
 tests/gateway/test_update_exit_target.py | 70 ++++++++++++++++++++++++
 5 files changed, 130 insertions(+), 9 deletions(-)

diff --git a/gateway/exit_deadline.py b/gateway/exit_deadline.py
index 402bf8d70e..b34f04044c 100644
--- a/gateway/exit_deadline.py
+++ b/gateway/exit_deadline.py
@@ -43,6 +43,9 @@ DRAIN_DB_PATIENCE_S = 2.0
 
 _lock = threading.Lock()
 _done = threading.Event()
+# Set when the post-tail bound's exit funnel failed and it gave the exit back: wakes a main thread
+# already parked in enter_exit_funnel so it runs the funnel itself.
+_handback = threading.Event()
 _state: dict[str, Any] = {}
 
 
@@ -51,6 +54,7 @@ def _reset_for_tests() -> None:
     with _lock:
         _state.clear()
         _done.clear()
+        _handback.clear()
 
 
 def margin_for(budget_s: float) -> float:
@@ -150,16 +154,24 @@ def bound_post_tail(exit_code: int, exit_fn: Callable[[int], None], *,
                 return
             _state["exit_owner"] = threading.get_ident()  # the main thread's funnel now parks (disarm)
         mark_phase("post_tail_bound")
+        over_s = round(time.monotonic() - target, 3)
         with contextlib.suppress(Exception):
             logger.warning("Shutdown still running %.1fs after the core update exit target (%s): asyncio.run "
                            "shutdown / outer finally did not finish; exiting %s now (phase marks: %s)",
-                           time.monotonic() - target, _state.get("target_reason"), exit_code, phases())
+                           over_s, _state.get("target_reason"), exit_code, phases())
+        # This exit skips the caller's own records (`hermes gateway run`: asyncio.run.returned,
+        # gateway.exit_clean / nonzero_exit_record), so the exit-diag log gets one of its own.
+        with contextlib.suppress(Exception):
+            from hermes_cli.gateway_exit_diag import make_exit_diag
+            make_exit_diag()("gateway.post_tail_bound", exit_code=exit_code, over_target_s=over_s,
+                             target_reason=_state.get("target_reason"), phases=phases())
         try:
             exit_fn(exit_code)
         except Exception:  # health: allow BLE001 -- hand the exit back to the main thread's funnel
             logger.exception("Post-tail exit bound: the exit funnel failed")
             with _lock:
                 _state.pop("exit_owner", None)
+            _handback.set()  # a main thread parked in enter_exit_funnel wakes and runs the funnel
 
     try:
         threading.Thread(target=_watch, daemon=True, name=POST_TAIL_THREAD_NAME).start()
@@ -280,11 +292,12 @@ def disarm() -> bool:
 
 def enter_exit_funnel() -> None:
     """The graceful exit funnel's disarm: marks ``exit_funnel`` and disarms. When the post-tail bound
-    already took the exit on another thread, the caller parks for good instead: that thread is running
-    the same funnel and ``os._exit``s."""
+    already took the exit on another thread, the caller parks instead: that thread is running the same
+    funnel and ``os._exit``s. If that funnel fails, the bound gives the exit back and the caller wakes
+    and runs it."""
     mark_phase("exit_funnel")
-    if not disarm():
-        threading.Event().wait()
+    while not disarm():
+        _handback.wait()
 
 
 def _exit_diag_record() -> dict[str, Any]:
diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index 4e604c1980..ebc9ce660d 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -2,6 +2,7 @@
 from __future__ import annotations
 
 import logging
+import sys
 import threading
 import time
 from pathlib import Path
@@ -527,6 +528,9 @@ async def _start_gateway_shutdown_tail(
     """Post-``wait_for_shutdown`` teardown; returns the process exit verdict (True = exit 0)."""
     from gateway.run import (_CRON_SHUTDOWN_DRAIN_TIMEOUT, _HOUSEKEEPING_SHUTDOWN_DRAIN_TIMEOUT, _await_thread_exit, _best_effort, _resolve_gateway_exit_verdict, _shutdown_mcp_servers_nonblocking, _stop_cron_provider, exit_deadline)
     tail_started = time.monotonic()
+    # The tail runs in start_gateway's finally: an active exception here means runner.stop() or
+    # wait_gateway_runtime raised, so the process exits with that exception's code, not the verdict.
+    unwinding = sys.exc_info()[1]
     exit_deadline.mark_phase("tail_start")  # the slow-tail line's phase marks count from the stop's start
     # Control socket first: once shutdown begins we are no longer a truthful "serving here" answer and a
     # successor must be able to bind. Early-exit paths rely on the atexit cleanup_files hook instead.
@@ -590,10 +594,20 @@ async def _start_gateway_shutdown_tail(
         exit_deadline.bound_post_tail(
             0 if exc.code is None else exc.code if isinstance(exc.code, int) else 1, _exit_after_graceful_shutdown)
         raise
-    exit_deadline.bound_post_tail(0 if verdict else 1, _exit_after_graceful_shutdown)
+    exit_deadline.bound_post_tail(
+        _unwind_exit_code(unwinding) if unwinding is not None else 0 if verdict else 1,
+        _exit_after_graceful_shutdown)
     return verdict
 
 
+def _unwind_exit_code(exc: BaseException) -> int:
+    """The code the process exits with once ``exc`` escapes ``asyncio.run``: main() routes a SystemExit's
+    code through the funnel, and any other exception is uncaught (1)."""
+    if isinstance(exc, SystemExit):
+        return 0 if exc.code is None else exc.code if isinstance(exc.code, int) else 1
+    return 1
+
+
 
 def _launch_home_may_multiplex(config=None) -> bool:
     """A named profile serving ``default`` as a secondary splits default's local sessions between
diff --git a/hermes_cli/gateway_exit_diag.py b/hermes_cli/gateway_exit_diag.py
