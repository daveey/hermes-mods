From 5c5b61ca2863bd3e32c2ecaffa2da2055760fb71 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:29:34 +0000
Subject: [PATCH] test(kanban): preserve continuation and progress gates with
 real class policies [daveey]

---
 tests/hermes_cli/test_kanban_dependency_review.py | 8 ++++++++
 tests/hermes_cli/test_kanban_no_progress.py       | 7 +++++++
 2 files changed, 15 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_dependency_review.py b/tests/hermes_cli/test_kanban_dependency_review.py
index 7b5548ff42..89d19354a2 100644
--- a/tests/hermes_cli/test_kanban_dependency_review.py
+++ b/tests/hermes_cli/test_kanban_dependency_review.py
@@ -16,6 +16,14 @@ PR = "https://github.com/example/repo/pull/10"
 def board(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setattr(prs, "pr_state", lambda _: "OPEN")
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    assert _assignee_config("dev") is None
+    profile = tmp_path / "profiles" / "dev"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config("dev")
+    assert config is not None and config["model_routing"]["enabled"]
     kb.init_db()
     with kbc.connect() as conn:
         yield conn
diff --git a/tests/hermes_cli/test_kanban_no_progress.py b/tests/hermes_cli/test_kanban_no_progress.py
index 771374d8e3..8724b4337b 100644
--- a/tests/hermes_cli/test_kanban_no_progress.py
+++ b/tests/hermes_cli/test_kanban_no_progress.py
@@ -37,6 +37,13 @@ def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
                 "HERMES_KANBAN_RUN_ID"):
         monkeypatch.delenv(var, raising=False)
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from hermes_cli.kanban_model_tier import class_unroutable_reason
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    assert class_unroutable_reason("class:standard", _assignee_config("default")) == "routing_disabled"
+    (home / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config("default")
+    assert config is not None and config["model_routing"]["enabled"]
     # Probes and capability refreshes run real commands off-thread; the clock wake is what is under test.
     monkeypatch.setattr(kwc, "run_due_wake_checks", lambda conn, *a, **k: [])
     monkeypatch.setattr(kcr, "maybe_refresh_async", lambda *a, **k: None)
-- 
2.43.0

