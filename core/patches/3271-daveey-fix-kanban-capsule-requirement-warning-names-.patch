From abadf0aba7649e88878aa68484b25e58ab6f8f76 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:16:43 +0000
Subject: [PATCH] [daveey] fix(kanban): capsule requirement warning names the
 policy exception

capsule_requirement fails closed when the assignee's policy cannot be read, and its
warning said only "default policy unreadable". On worker-3 (11-13 07:21-07:38Z) that
line was the only summary of a ScopeSwitchRefused from _profile_policy (fixed in
50e6ed804e) that refused t_01a1d1197fa00599 at spawn with capsule_observation_missing;
the cause sat only in the multi-line traceback. The warning now carries the exception
type and message on the line itself, so a grep of errors.log names the cause.

Task: t_01a1d3e3f49d9c46
---
 gateway/session_kanban_capsule.py               |  7 ++++---
 .../test_session_kanban_capsule_guard.py        | 17 +++++++++++++++++
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/gateway/session_kanban_capsule.py b/gateway/session_kanban_capsule.py
index c3209d86d0..9c224809d1 100644
--- a/gateway/session_kanban_capsule.py
+++ b/gateway/session_kanban_capsule.py
@@ -41,9 +41,10 @@ def capsule_requirement(task) -> dict:
     # when the assignee's own policy does not grant host_repo (non-local backend).
     try:
         granted = 'host_repo' in kanban_capabilities._profile_capabilities(task.assignee, ['host_repo'])
-    except Exception:  # an unreadable policy cannot prove the grant: require
-        logging.getLogger(__name__).warning('capsule requirement: %s policy unreadable; requiring a capsule',
-                                            task.assignee, exc_info=True)
+    except Exception as exc:  # an unreadable policy cannot prove the grant: require
+        logging.getLogger(__name__).warning(
+            'capsule requirement: %s policy unreadable (%s: %s); requiring a capsule',
+            task.assignee, type(exc).__name__, exc, exc_info=True)
         granted = False
     return dict(NOT_REQUIRED) if granted else dict(REQUIRED)
 
diff --git a/tests/gateway/test_session_kanban_capsule_guard.py b/tests/gateway/test_session_kanban_capsule_guard.py
index f60924752e..f25a491033 100644
--- a/tests/gateway/test_session_kanban_capsule_guard.py
+++ b/tests/gateway/test_session_kanban_capsule_guard.py
@@ -106,6 +106,23 @@ def test_unreadable_backend_policy_fails_closed(tmp_path, monkeypatch):
         require_capsule_transport(policy)
 
 
+def test_unreadable_policy_warning_names_the_exception(tmp_path, monkeypatch, caplog):
+    """The fail-closed warning carries the exception type and message, not only a traceback."""
+    import logging
+    from gateway.session_kanban_capsule import REQUIRED, capsule_requirement
+    from hermes_cli import kanban_capabilities
+
+    def boom(assignee, required=None):
+        raise RuntimeError('policy exploded')
+
+    monkeypatch.setattr(kanban_capabilities, '_profile_capabilities', boom)
+    task = SimpleNamespace(assignee='default', workspace_kind='dir', requires=['host_repo'])
+    monkeypatch.setattr('hermes_cli.kanban_capsule_admission._requires_host_repo', lambda task: True)
+    with caplog.at_level(logging.WARNING, logger='gateway.session_kanban_capsule'):
+        assert capsule_requirement(task) == REQUIRED
+    assert 'default policy unreadable (RuntimeError: policy exploded)' in caplog.text
+
+
 def test_no_config_or_param_grant_accepted(tmp_path, monkeypatch):
     """Caller params/config cannot flip the derived requirement (exact param set still enforced)."""
     from gateway.session_kanban import build_kanban_policy
