From c49e356b6bea30492cea57f867b3f38ec7505c18 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 08:39:23 +0000
Subject: [PATCH] [daveey] test: isolate gateway stop routing from host process
 discovery

The stop-routing fixture left find_gateway_pids live, so a running host gateway led profile comparison to resolve its real home. Supply a synthetic current-profile inventory; production behavior and home_io_guard stay unchanged.

Proof: exact targeted test failed before and passes after; full gateway service file passes 113 tests, 5 platform skips on Linux.
---
 tests/hermes_cli/test_gateway_service.py | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/tests/hermes_cli/test_gateway_service.py b/tests/hermes_cli/test_gateway_service.py
index d25a9b9a9b4..c777d43060e 100644
--- a/tests/hermes_cli/test_gateway_service.py
+++ b/tests/hermes_cli/test_gateway_service.py
@@ -429,19 +429,18 @@ class TestWslInteropPaths:
 class TestGatewayStopCleanup:
     @pytest.mark.platforms("linux")
     def test_stop_only_kills_current_profile_by_default(self, tmp_path, monkeypatch):
-        """Without --all, stop uses systemd (if available) and does NOT call
-        the global kill_gateway_processes().
-
-        Linux-gated: the routing under test is the systemd arm, and it is only
-        reached when the host really isn't macOS/Windows (the old
-        ``is_macos → False`` stub is gone).
-        """
+        """On Linux, stop without --all uses systemd, not global process killing."""
         unit_path = tmp_path / "hermes-gateway.service"
         unit_path.write_text("unit\n", encoding="utf-8")
 
         monkeypatch.setattr(gateway_cli, "supports_systemd_services", lambda: True)
         monkeypatch.setattr(gateway_cli, "get_systemd_unit_path", lambda system=False: unit_path)
 
+        # This tests stop routing, not host process discovery. A real scan can
+        # resolve another running gateway's home outside the isolated HERMES_HOME.
+        # Model a current-profile gateway without probing or signalling a real PID.
+        monkeypatch.setattr(gateway_cli, "find_gateway_pids", lambda: [4242])
+
         service_calls = []
         kill_calls = []
 
-- 
