From d090f6410d6f2778e0ad27dcaacfaa9f7ff4c245 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:38:43 +0000
Subject: [PATCH] [daveey] test(multiplex): name the boot-time park when the
 downtime-ensure test's precondition misses

test_named_profile_ensure_during_multiplexer_downtime_starts_the_multiplexer failed once on CI
(run 43419340371, job 131865382461) with a bare `assert ['default'] == ['default', 'boot']` right
after the first daemon's READY + SIGINT stop, before any of the behaviour under test ran.

What the recorded ['default'] can mean (traced locally with a write/publish trace on
gateway_state.json): the first daemon publishes `served_profiles` exactly once, from
`_record_served_profiles` at the end of secondary startup, BEFORE READY (READY is published only
after `runner.start()`, which runs `_start_secondary_profiles`). So ['default'] is not a
lost/late write racing the SIGINT: boot was already out of the reserved set when the secondaries
started, i.e. a boot-time park (`_park_reserved_profile`: store unusable, or
`_recover_profile_bot_mailbox`: startup recovery failed). Both log `[MULTIPLEX] Profile 'boot' not
served: ...` and name the reason under `parked_profiles`.

Could not reproduce: ~500 runs of the test (and of its phase-1 alone) under SIGSTOP/SIGCONT duty
cycles, 8-12 CPU hogs, dsync disk contention and a 12 s injected delay in the secondary store open
all passed. The CI failure printed nothing but the list, so the park reason is lost.

Change (test-only): assert the precondition at READY, where the multiplexer's own verdict is live
(`identify` served set == {default, boot}), and on either miss print the identify served/parked
maps, the recorded served/parked fields and every `[MULTIPLEX]`/ERROR line from the root's and each
profile's logs. The next occurrence names the park cause instead of a bare list diff.

Tests: tests/gateway/test_multiplex_hot_serve_live.py (9 passed).
---
 .../gateway/test_multiplex_hot_serve_live.py  | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_multiplex_hot_serve_live.py b/tests/gateway/test_multiplex_hot_serve_live.py
index 5859761531..0ee02a19d5 100644
--- a/tests/gateway/test_multiplex_hot_serve_live.py
+++ b/tests/gateway/test_multiplex_hot_serve_live.py
@@ -130,6 +130,22 @@ def served_homes(desc):
     return {Path(entry['home']).resolve() for entry in desc.get('served_profiles', [])}
 
 
+def serve_verdicts(mux, desc):
+    """Why a boot-time secondary is missing from the served set: the ``identify`` answer's served and
+    parked maps, the recorded state, and every ``[MULTIPLEX]``/ERROR line of the root's and each
+    secondary's log (a park after per-profile log routing lands in that profile's own ``logs/``)."""
+    logs = [mux['log'], *sorted(mux['root'].glob('logs/*.log')), *sorted(mux['root'].glob('profiles/*/logs/*.log'))]
+    lines = [f'{p.name}: {line}' for p in logs if p.exists()
+             for line in p.read_text(encoding='utf-8', errors='replace').splitlines()
+             if '[MULTIPLEX]' in line or ' ERROR ' in line]
+    state = mux['root'] / 'gateway_state.json'
+    recorded = json.loads(state.read_text(encoding='utf-8')) if state.exists() else {}
+    return {'identify_served': sorted(str(h) for h in served_homes(desc)),
+            'identify_parked': desc.get('parked_profiles'),
+            'recorded_served': recorded.get('served_profiles'), 'recorded_parked': recorded.get('parked_profiles'),
+            'log': lines[-40:]}
+
+
 def recorded_served(root):
     return json.loads((root / 'gateway_state.json').read_text(encoding='utf-8')).get('served_profiles')
 
@@ -221,8 +237,12 @@ def test_named_profile_ensure_during_multiplexer_downtime_starts_the_multiplexer
     block the multiplexer's next all-or-nothing reserve with ``Cannot reserve gateway profiles``)."""
     root, env, boot = mux['root'], mux['env'], mux['boot']
     proc, desc = start_daemon(mux)
+    # Precondition, checked at READY where the multiplexer's own verdict is still live: boot is served
+    # by it. A boot-time park (unusable store, failed startup recovery) leaves the recorded set at
+    # ['default'] and is logged; name it instead of failing later on the bare recorded list.
+    assert served_homes(desc) == {root.resolve(), boot.resolve()}, serve_verdicts(mux, desc)
     stop(proc)
-    assert recorded_served(root) == ['default', 'boot']
+    assert recorded_served(root) == ['default', 'boot'], serve_verdicts(mux, desc)
     try:
         ensured = subprocess.run([sys.executable, '-m', 'hermes_cli.main', '-p', 'boot', 'gateway', 'ensure',
                                   '--json', '--timeout', '90'], cwd=ROOT, env=env, capture_output=True, text=True, timeout=120, check=False)
