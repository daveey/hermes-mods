From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 00:56:23 +0000
Subject: [PATCH 6670] Profile resource custody and retirement before deletion

Public mirror of source commit d47751f0043e26c071c2c5e2cf5d83b000207027.

---
diff --git a/tests/hermes_state/test_profile_session_read_lease_fds.py b/tests/hermes_state/test_profile_session_read_lease_fds.py
new file mode 100644
index 0000000000000000000000000000000000000000..da1e7d7aa39b0835615b9c4d6209064a2f8c2686
--- /dev/null
+++ b/tests/hermes_state/test_profile_session_read_lease_fds.py
@@ -0,0 +1,65 @@
+"""Repeated sidebar reads must not retain a lease behind a live profile owner."""
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli.web_routers.profiles import _read_profile_db
+from hermes_cli.sqlite_safe_read import pread_lock_safe
+from hermes_constants import mark_named_profile_deleted
+from hermes_profile_resources import wait_profile_resources
+from hermes_state import SessionDB
+from hermes_state_dbfile import _pread_db_range
+from tests.hermes_state import test_profile_retirement_custody as helpers
+from tests.waiting import wait_until
+
+profile_home = helpers.profile_home
+
+
+def _lease_fds(home):
+    directory = str(home.parent / '.resource-leases' / home.name) + '/'
+    found = []
+    for fd in Path('/proc/self/fd').iterdir():
+        try:
+            target = os.readlink(fd)
+        except FileNotFoundError:  # the retirement monitor can close between listing and readlink
+            continue
+        if target.startswith(directory):
+            found.append(target)
+    return found
+
+
+@pytest.mark.skipif(not Path('/proc/self/fd').is_dir(), reason='Linux descriptor census')
+def test_500_profile_session_reads_keep_lease_fds_bounded(profile_home):
+    path = profile_home / 'state.db'
+    keeper = SessionDB(path)
+    errors = []
+    try:
+        keeper.create_session('kept', source='cli', model='test')
+        # Both caches really own raw descriptors. The keeper must keep their safe-close
+        # barriers active throughout the reads, reproducing the long-lived daemon.
+        assert _pread_db_range(path, 0, 16) == b'SQLite format 3\x00'
+        assert pread_lock_safe(path, 0, 16) == b'SQLite format 3\x00'
+        wait_until(lambda: len(_lease_fds(profile_home)) <= 2, timeout=10)
+        baseline = len(_lease_fds(profile_home))
+        assert baseline == 2  # live SQLite owner and the dedicated raw-probe owner
+        samples = []
+        for _ in range(5):
+            for _ in range(100):
+                row = _read_profile_db('example', profile_home, errors,
+                                       lambda db: db.get_session('kept'))
+                assert row is not None and row['id'] == 'kept'
+            samples.append(len(_lease_fds(profile_home)))
+            assert keeper.get_session('kept') is not None
+        print({'reads': 500, 'before_settlement': samples})
+        # Let the real monitor acknowledge closes; do not manually finish leases.
+        wait_until(lambda: len(_lease_fds(profile_home)) <= baseline, timeout=10)
+        settled = len(_lease_fds(profile_home))
+        assert errors == []
+        assert settled == baseline
+        print({'reads': 500, 'baseline': baseline, 'settled_lease_fds': settled})
+    finally:
+        keeper.close()
+        mark_named_profile_deleted(profile_home)
+        assert wait_profile_resources(profile_home, timeout=10)
+        assert _lease_fds(profile_home) == []
