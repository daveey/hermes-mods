From 1c1f2d0cb8e8694d070d5a02ad38c0dff4855583 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 04:39:31 +0000
Subject: [PATCH] [daveey] Isolate scratch lifecycle fixture process
 inventories

Root: filesystem-only fixtures inherited host process discovery from the owned-job cleanup veto. psutil stats deleted cwd targets, crossing the live-home guard; swallowed cleanup errors can also preserve the workspace.

Proof: with an unrelated live process in a deleted cwd under the real Hermes home, baseline 687b316b516 fails all 12 reported cases. With synthetic empty inventories in the two fixture families, the three full files plus real-owned-writer controls pass: 79 tests, retries disabled. The deferred-parent regression also passes alone. Production cleanup and home-I/O protection unchanged.
---
 tests/hermes_cli/test_kanban_scratch_gc_archive.py | 4 ++++
 tests/hermes_cli/test_kanban_worktree_teardown.py  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
index cb734f57de3..ec3204de5e4 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_archive.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -7,6 +7,7 @@ import tarfile
 import time
 from pathlib import Path
 
+import psutil
 import pytest
 
 from hermes_cli import kanban_db as kb
@@ -18,6 +19,9 @@ OLD = int(time.time()) - 10 * 86400
 
 @pytest.fixture
 def board(tmp_path, monkeypatch):
+    # No external jobs belong to this synthetic board. Host cwd probes can stat
+    # deleted directories under the real Hermes home, outside fixture isolation.
+    monkeypatch.setattr(psutil, "process_iter", lambda *args, **kwargs: iter(()))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
diff --git a/tests/hermes_cli/test_kanban_worktree_teardown.py b/tests/hermes_cli/test_kanban_worktree_teardown.py
index a3013b05ac9..5f8897ff6a4 100644
--- a/tests/hermes_cli/test_kanban_worktree_teardown.py
+++ b/tests/hermes_cli/test_kanban_worktree_teardown.py
@@ -15,6 +15,7 @@ import json
 import subprocess
 from pathlib import Path
 
+import psutil
 import pytest
 
 from hermes_cli import kanban_db as kb
@@ -44,6 +45,9 @@ def _git(*args: str, cwd: str | None = None) -> str:
 
 @pytest.fixture
 def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    # Filesystem-only lifecycle fixtures own no external jobs. Keep discovery
+    # synthetic as well as HOME; live-writer coverage supplies its own processes.
+    monkeypatch.setattr(psutil, "process_iter", lambda *args, **kwargs: iter(()))
     home = tmp_path / ".hermes"
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
-- 
