                     if _DARWIN_SCAN_IN_FLIGHT is self:
@@ -455,7 +546,8 @@ _DARWIN_SCAN_CACHED = _DarwinFdScan(0.0)  # sentinel, never run: a clean verdict
 
 
 def _join_darwin_fd_scan(base: str | None = None, key: tuple | None = None,
