From 5771f191ced31399ab59912fc3f03ed0bd85dec9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:43:35 +0000
Subject: [PATCH] [daveey] kanban queue reason tests: a chain of uncommented
 events keeps the refresh clock at the last comment

Post-merge check t_01a1d615bccc192f of #2424 found mutant 2424-M6 surviving: stamping an uncommented event's
commented_at_ms with the previous event's time instead of carrying the comment's. The carry only differs on the
2nd+ uncommented event in a row, and no test drove such a chain, so "sightings never delay a refresh" was unpinned.

Since then 40f4ec94c3 (the 120 s comment hold) moved the comment time into the origin-local
kanban_queue_commented table; the carried commented_at_ms on events is now read only when that row is absent
(_comment_state's fallback: a card queued by pre-hold code). The M6 site is now two sites, and both are pinned.

New test (test_kanban_queue_reason_sighting.py): comment at t0, reservation handed to worker-3 at +2 min and back
at +4 min (two uncommented events), then a different volatile picture at t0 + REFRESH_MS. It asserts both chain
events carry t0 and that the refresh is commented, with the comment table kept and with it absent.

Proof (hermes-core-wt test, worker-1):
- GREEN at main b22e3019a3: 7 queue-reason/queue files, 109 passed, 0 failed (includes the #2359 flaps and
  #2424 sighting tests, and the hold replay).
- RED, M6-fallback (_comment_state: "commented_at_ms": _ms_of(previous)): [absent] fails, 4 pass.
- RED, M6-stamp (_record: COMMENTED_KEY: _ms_of(previous)): [kept] and [absent] both fail, 3 pass.
- scripts/check --base origin/main: 20 checks ok.

Card: t_01a1d66a2d798bdd
---
 .../test_kanban_queue_reason_sighting.py      | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_queue_reason_sighting.py b/tests/hermes_cli/test_kanban_queue_reason_sighting.py
index 1f3340d215..e525ae8165 100644
--- a/tests/hermes_cli/test_kanban_queue_reason_sighting.py
+++ b/tests/hermes_cli/test_kanban_queue_reason_sighting.py
@@ -11,6 +11,8 @@ import itertools
 import json
 import sqlite3
 
+import pytest
+
 from hermes_cli import kanban_pickup_stall as kps
 from hermes_cli import kanban_queue_reason as qr
 from hermes_cli import kanban_worker_node as wn
@@ -64,6 +66,29 @@ def test_twenty_minutes_of_flaps_still_post_at_most_three_comments(conn, clock):
     assert comments >= 2  # sightings do not hold back the REFRESH_MS comment: its clock runs from the last comment
 
 
+@pytest.mark.parametrize("comment_table", ["kept", "absent (events written before the hold)"])
+def test_a_chain_of_uncommented_events_keeps_the_refresh_clock_at_the_last_comment(conn, clock, comment_table):
+    """Two uncommented events in a row (reservation flips) each carry the comment's time, not the previous event's,
+    so a different volatile picture ``REFRESH_MS`` after the comment is still commented. Without the comment table
+    (a card queued by pre-hold code) the carried ``commented_at_ms`` on the last event is the only record of it."""
+    tid = fixtures.acknowledged(conn)
+    commented_ms = int(clock[0] * 1000)
+    qr.record_reply(conn, tid, "hub", flaps.assigned(commented_ms, flaps.flap(0)))
+    assert flaps.counts(conn, tid) == (1, 1)
+    for minutes, machine in ((2, "worker-3"), (4, WORKER)):  # the Board hands the reservation over and back
+        clock[0] = flaps.T0 + 60 * minutes
+        assert qr.record_reply(conn, tid, "hub", flaps.assigned(int(clock[0] * 1000), flaps.flap(0), machine=machine))
+    assert flaps.counts(conn, tid) == (1, 3)
+    chain = [json.loads(r[0]) for r in conn.execute(
+        "SELECT payload FROM task_events WHERE task_id=? AND kind=? ORDER BY id", (tid, qr.EVENT)).fetchall()[1:]]
+    assert [e[qr.COMMENTED_KEY] for e in chain] == [commented_ms, commented_ms]
+    if comment_table != "kept":
+        conn.execute(f"DROP TABLE {qr.COMMENT_TABLE}")
+    clock[0] = flaps.T0 + qr.REFRESH_MS / 1000  # 6 min after the last event, 10 min after the comment
+    assert qr.record_reply(conn, tid, "hub", flaps.assigned(int(clock[0] * 1000), flaps.flap(1), machine=WORKER))
+    assert flaps.counts(conn, tid) == (2, 4)  # the refresh comment, not only a sighting
+
+
 def test_the_reserved_worker_raises_no_alarm_at_any_tick(conn, clock, gws):
     """The origin's events, synced into worker-2's replica while the Board briefly pins the card there."""
     _, ticks, rows = _simulate(conn, clock, 11 * 60)
