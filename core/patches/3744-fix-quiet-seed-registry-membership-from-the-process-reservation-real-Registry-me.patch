@@ -154,6 +154,15 @@ def submit_tracked(executor, function, /, *args, registry=None, home=None,
     return _submit_owned(executor, function, args, kwargs, owner, kind)
 
 
+def _refused_before_enqueue(executor):
+    """True when a stdlib ThreadPoolExecutor is shut down or broken (its submit refuses pre-enqueue)."""
+    if not isinstance(executor, ThreadPoolExecutor):
+        return False
+    from concurrent.futures import thread as _thread
+    return bool(getattr(executor, "_shutdown", False) or getattr(executor, "_broken", False)
+                or getattr(_thread, "_shutdown", False))
+
+
 def _submit_owned(executor, function, args, kwargs, owner, kind):
     reservation = _Reservation(owner, kind, copy_context())
     try:
@@ -165,7 +174,13 @@ def _submit_owned(executor, function, args, kwargs, owner, kind):
         else:
             future = executor.submit(reservation.run, function, args, kwargs)
     except BaseException:
-        owner.registry.mark_unknown("submit-outcome-uncertain")
+        if _refused_before_enqueue(executor):
+            # A stdlib pool refuses a shut-down/broken submit under its lock BEFORE enqueuing.
+            # Even if it had raced an enqueue, never_started makes the wrapper a no-op, so
+            # releasing here can never undercount physical work.
+            reservation.never_started()
+        else:
+            owner.registry.mark_unknown("submit-outcome-uncertain")
         raise
     # done + pending proves this wrapper never began (cancelled or broken pool).
     # A running wrapper owns its release even if an async waiter was canceled.
diff --git a/hermes_cli/web_routers/audio.py b/hermes_cli/web_routers/audio.py
index 0407cee39a..d48412fc53 100644
--- a/hermes_cli/web_routers/audio.py
+++ b/hermes_cli/web_routers/audio.py
@@ -76,13 +76,28 @@ async def _run_reserved(source: str, fn, *, copy_context: bool = True):
     from tools import code_kernel_scope
 
     handle = code_kernel_scope.reserve("audio", source)
+    custody = threading.Lock()
+    state = ["pending"]  # pending -> running (worker owns release) | abandoned (never ran)
 
     def _held():
+        with custody:
+            if state[0] != "pending":
+                return None  # the awaiting request was cancelled while queued: already released
+            state[0] = "running"
         try:
             return fn()
         finally:
             code_kernel_scope.finish(handle)
 
+    def _abandoned(fut):
+        # A cancelled waiter cancels a still-queued job: it will never run _held, so release here.
+        # A job that already started keeps custody until its own finally.
+        if fut.cancelled():
+            with custody:
+                if state[0] == "pending":
+                    state[0] = "abandoned"
+                    code_kernel_scope.finish(handle)
+
     target = _held
     if copy_context:  # what asyncio.to_thread does: the request context reaches the worker
         target = functools.partial(contextvars.copy_context().run, _held)
@@ -91,6 +106,7 @@ async def _run_reserved(source: str, fn, *, copy_context: bool = True):
     except BaseException:
         code_kernel_scope.finish(handle)
         raise
+    future.add_done_callback(_abandoned)
     return await future
 
 
