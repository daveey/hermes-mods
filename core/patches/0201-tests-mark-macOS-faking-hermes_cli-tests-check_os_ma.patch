From bdb1a9606239eda000b59bcc32e05376a0076d5c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:08:44 +0000
Subject: [PATCH] tests: mark macOS-faking hermes_cli tests
 (check_os_marker_fakes) (#22)

* tests: mark macOS-faking hermes_cli tests with platforms("macos") (check_os_marker_fakes) (t_0259fe53)

* ci: re-run CI to measure hub queue time (t_0259fe53)
---
diff --git a/tests/hermes_cli/test_agent_scope_env.py b/tests/hermes_cli/test_agent_scope_env.py
index 6e65995d977f4345768a88172df2edc07d415d69..91d00f1f6830209f4b1dbdc3ff8f977d8fd3b10d 100644
--- a/tests/hermes_cli/test_agent_scope_env.py
+++ b/tests/hermes_cli/test_agent_scope_env.py
@@ -67,6 +67,7 @@ def test_strip_agent_scope_env_is_noop_without_worker_marker():
     assert env == before
 
 
+@pytest.mark.platforms("macos")
 def test_relaunch_with_poisoned_environ_passes_clean_env(monkeypatch, tmp_path):
     from hermes_cli import main_desktop as md
     for k, v in {**POISON, **TUNABLES}.items():
diff --git a/tests/hermes_cli/test_kanban_park_invariants.py b/tests/hermes_cli/test_kanban_park_invariants.py
index 997ede7a2e0cb40f973727bbc038332039f81f82..55c51ff88a5627f9960ceb10d09f1a969e2b48c4 100644
--- a/tests/hermes_cli/test_kanban_park_invariants.py
+++ b/tests/hermes_cli/test_kanban_park_invariants.py
@@ -356,6 +356,7 @@ def test_main_scrubs_for_top_level_surfaces(monkeypatch, argv, scrubbed):
     assert ("HERMES_DELEGATED_CHILD_CONTEXT" not in os.environ) is scrubbed
 
 
+@pytest.mark.platforms("macos")
 def test_desktop_relaunch_after_update_gets_scrubbed_env(monkeypatch, tmp_path):
     """``hermes update`` run from a worker reopens Desktop with ``open``; the app must not
     inherit the worker's kanban/delegation env (Hermes.app pid 59331, 2026-10-21)."""
diff --git a/tests/hermes_cli/test_leaked_worker_env.py b/tests/hermes_cli/test_leaked_worker_env.py
index 91f8ebaecf4eb8dd5c083cbf4f34cd6285984b76..0564017a8821fb81c17fcb9e1de1e1d4c7131208 100644
--- a/tests/hermes_cli/test_leaked_worker_env.py
+++ b/tests/hermes_cli/test_leaked_worker_env.py
@@ -55,6 +55,7 @@ def test_agent_scope_covers_gateway_session_context():
     assert [k for k in _VAR_MAP if not is_agent_scope_env_key(k)] == []
 
 
+@pytest.mark.platforms("macos")
 def test_desktop_relaunch_after_update_drops_session_identity(monkeypatch, tmp_path):
     """Launch path 1: ``hermes update``'s post-rebuild reopen (``_relaunch_stopped_desktops``)."""
     from hermes_cli import main_desktop as md
