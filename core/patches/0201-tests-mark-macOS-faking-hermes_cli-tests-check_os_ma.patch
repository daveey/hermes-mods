Subject: [PATCH] tests: mark macOS-faking hermes_cli tests
 (check_os_marker_fakes) (#22)

* tests: mark macOS-faking hermes_cli tests with platforms("macos") (check_os_marker_fakes) (t_0259fe53)

* ci: re-run CI to measure hub queue time (t_0259fe53)
---
 tests/hermes_cli/test_agent_scope_env.py        |  1 +
 tests/hermes_cli/test_kanban_park_invariants.py |  1 +
 tests/hermes_cli/test_leaked_worker_env.py      |  1 +
 tests/hermes_cli/test_source_build.py           | 10 +++++-----
 4 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_agent_scope_env.py b/tests/hermes_cli/test_agent_scope_env.py
index 6e65995d97..91d00f1f68 100644
--- a/tests/hermes_cli/test_agent_scope_env.py
+++ b/tests/hermes_cli/test_agent_scope_env.py
@@ -67,6 +67,7 @@ def test_strip_agent_scope_env_is_noop_without_worker_marker():
     assert env == before
 
 
+@pytest.mark.platforms("macos")
 def test_relaunch_with_poisoned_environ_passes_clean_env(monkeypatch, tmp_path):
     from hermes_cli import main_desktop as md
     for k, v in {**POISON, **TUNABLES}.items():
diff --git a/tests/hermes_cli/test_kanban_park_invariants.py b/tests/hermes_cli/test_kanban_park_invariants.py
index 997ede7a2e..55c51ff88a 100644
--- a/tests/hermes_cli/test_kanban_park_invariants.py
+++ b/tests/hermes_cli/test_kanban_park_invariants.py
@@ -356,6 +356,7 @@ def test_main_scrubs_for_top_level_surfaces(monkeypatch, argv, scrubbed):
     assert ("HERMES_DELEGATED_CHILD_CONTEXT" not in os.environ) is scrubbed
 
 
+@pytest.mark.platforms("macos")
 def test_desktop_relaunch_after_update_gets_scrubbed_env(monkeypatch, tmp_path):
     """``hermes update`` run from a worker reopens Desktop with ``open``; the app must not
     inherit the worker's kanban/delegation env (Hermes.app pid 59331, 2026-10-21)."""
diff --git a/tests/hermes_cli/test_leaked_worker_env.py b/tests/hermes_cli/test_leaked_worker_env.py
index 91f8ebaecf..0564017a88 100644
--- a/tests/hermes_cli/test_leaked_worker_env.py
+++ b/tests/hermes_cli/test_leaked_worker_env.py
@@ -55,6 +55,7 @@ def test_agent_scope_covers_gateway_session_context():
     assert [k for k in _VAR_MAP if not is_agent_scope_env_key(k)] == []
 
 
+@pytest.mark.platforms("macos")
 def test_desktop_relaunch_after_update_drops_session_identity(monkeypatch, tmp_path):
     """Launch path 1: ``hermes update``'s post-rebuild reopen (``_relaunch_stopped_desktops``)."""
     from hermes_cli import main_desktop as md
diff --git a/tests/hermes_cli/test_source_build.py b/tests/hermes_cli/test_source_build.py
index af20599fc9..f9d100b112 100644
--- a/tests/hermes_cli/test_source_build.py
+++ b/tests/hermes_cli/test_source_build.py
@@ -384,7 +384,7 @@ def test_module_cli_builds_the_requested_products(source_products, desktop, monk
     assert (root / "apps/desktop/release/linux-unpacked/hermes").exists() == desktop
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("macos")
 def test_packaged_desktop_is_reused_only_while_it_names_head(tmp_path, monkeypatch):
     """The update skips the desktop build only when the shipped app's baked commit is HEAD
     and its receipt is current; a moved HEAD or an unreadable stamp means build."""
@@ -462,7 +462,7 @@ def _prebuilt_fixture(tmp_path, monkeypatch, *, stamp_commit=None):
     return root, desktop_dir, built
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("macos")
 def test_update_swaps_in_a_prebuilt_desktop_app_that_names_head(tmp_path, monkeypatch, capsys):
     """HERMES_DESKTOP_PREBUILT_APP built from HEAD (hermes-sync's background stage) is swapped in
     through the stage-and-swap path instead of running npm."""
@@ -480,7 +480,7 @@ def test_update_swaps_in_a_prebuilt_desktop_app_that_names_head(tmp_path, monkey
     assert "prebuilt desktop app" in capsys.readouterr().out.lower()
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("macos")
 def test_update_builds_when_the_prebuilt_desktop_app_names_another_commit(tmp_path, monkeypatch, capsys):
     from hermes_cli.source_build import _build_desktop_product
 
@@ -492,7 +492,7 @@ def test_update_builds_when_the_prebuilt_desktop_app_names_another_commit(tmp_pa
     assert "not used" in capsys.readouterr().out
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("macos")
 def test_update_builds_when_the_prebuilt_desktop_app_fails_its_signature(tmp_path, monkeypatch):
     from hermes_cli import main_desktop
     from hermes_cli.source_build import _build_desktop_product
@@ -504,7 +504,7 @@ def test_update_builds_when_the_prebuilt_desktop_app_fails_its_signature(tmp_pat
     assert (desktop_dir / "release/mac-arm64/Hermes.app/Contents/MacOS/Hermes").read_text() == "previous app"
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("macos")
 def test_update_builds_without_a_prebuilt_desktop_app(tmp_path, monkeypatch):
     from hermes_cli.source_build import _build_desktop_product
 
