From 1a3fda57f0dec7aba240c65d7fb6f21d9d240d11 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:34:11 +0000
Subject: [PATCH] fix(desktop): settled decisions wait on agents, not human
 attention [daveey]

---
 apps/desktop/src/lib/session-outcome.ts       | 10 +++++++-
 .../src/store/session-dot-state.test.ts       | 24 +++++++++++++++++++
 apps/desktop/src/types/session-outcome.ts     |  2 ++
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/lib/session-outcome.ts b/apps/desktop/src/lib/session-outcome.ts
index 69c748b0c7..169d859ab9 100644
--- a/apps/desktop/src/lib/session-outcome.ts
+++ b/apps/desktop/src/lib/session-outcome.ts
@@ -17,7 +17,15 @@ export const outcomeStripe = (outcome: null | SessionOutcome | undefined): null
       return 'done'
 
     case 'decision':
-      return 'stuck'
+      // A recorded choice settles the human ask, not its delivery. Keep old/unknown
+      // item shapes red, but explicit settled-only lists are agent-side waits.
+      return outcome.items?.length &&
+        outcome.items.every(
+          item =>
+            Boolean(item.resolution) || ['resolved', 'superseded', 'cancelled', 'withdrawn'].includes(item.state ?? '')
+        )
+        ? 'waiting'
+        : 'stuck'
 
     case 'muted':
       return 'blocked'
diff --git a/apps/desktop/src/store/session-dot-state.test.ts b/apps/desktop/src/store/session-dot-state.test.ts
index f486b507e4..4c8de48535 100644
--- a/apps/desktop/src/store/session-dot-state.test.ts
+++ b/apps/desktop/src/store/session-dot-state.test.ts
@@ -1172,6 +1172,30 @@ describe('stuckReasons and the red report', () => {
     expect(stuckReasons({ ...row, review_wait: 'parked', outcome: { kind: 'done' } } as never, 'idle')).toEqual([])
   })
 
+  it('does not report outcome:decision for settled requests awaiting agent delivery', () => {
+    const settled = {
+      ...row,
+      outcome: { kind: 'decision', items: [{ id: 'question', question: 'Choose?', state: 'resolved' }] }
+    }
+    expect(stuckReasons(settled, 'idle')).toEqual([])
+    expect(sessionStatusStripe('idle', true, false, 0, false, null, 0, 0, 0, settled.outcome)).toBe('waiting')
+    const recorded = {
+      ...row,
+      outcome: {
+        kind: 'decision',
+        items: [{ id: 'question', question: 'Choose?', state: 'open', resolution: { operationId: 'pending' } }]
+      }
+    }
+    expect(stuckReasons(recorded, 'idle')).toEqual([])
+    expect(sessionStatusStripe('idle', true, false, 0, false, null, 0, 0, 0, recorded.outcome)).toBe('waiting')
+    const open = {
+      ...row,
+      outcome: { kind: 'decision', items: [{ id: 'question', question: 'Choose?', state: 'open' }] }
+    }
+    expect(stuckReasons(open, 'idle')).toEqual(['outcome:decision'])
+    expect(sessionStatusStripe('idle', true, false, 0, false, null, 0, 0, 0, open.outcome)).toBe('stuck')
+  })
+
   it('reports a red first sighting, each new red cause, and the way out; logs the reasons', () => {
     publishSessionState('rt-dead', { ...createClientSessionState('red-chat'), needsInput: true })
 
diff --git a/apps/desktop/src/types/session-outcome.ts b/apps/desktop/src/types/session-outcome.ts
index 463132b092..6e5275893d 100644
--- a/apps/desktop/src/types/session-outcome.ts
+++ b/apps/desktop/src/types/session-outcome.ts
@@ -14,6 +14,8 @@ export interface SessionOutcomeItem {
   choices?: { label: string; value: string }[]
   card_id?: string
   state?: string
+  /** A recorded choice is settled even while its delivery is unconfirmed. */
+  resolution?: { operationId?: string }
 }
 
 /** [daveey] One thing a `waiting` / `running` outcome waits on. */
-- 
2.43.0

