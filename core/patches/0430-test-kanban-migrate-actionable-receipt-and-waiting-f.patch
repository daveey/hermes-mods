 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_local_receipt_authority.py b/tests/hermes_cli/test_kanban_local_receipt_authority.py
index 9467638a71..fa2b420ad6 100644
--- a/tests/hermes_cli/test_kanban_local_receipt_authority.py
+++ b/tests/hermes_cli/test_kanban_local_receipt_authority.py
@@ -3,17 +3,20 @@ import pytest
 
 from hermes_cli import kanban_session_activity as activity
 from hermes_cli import kanban_origin_adapter as adapter, kanban_origin_ledger as ledger, profiles
-from tests.hermes_cli.test_kanban_session_activity import _make_board
+from tests.hermes_cli.test_kanban_session_activity import _add_human_requests, _make_board
 import hermes_constants
 
 
 @pytest.mark.parametrize('status', ['running', 'blocked', 'scheduled'])
-def test_local_open_association_dominates_stale_receipt(tmp_path, monkeypatch, status):
+@pytest.mark.parametrize('actionable', [False, True])
+def test_local_open_association_dominates_stale_receipt(tmp_path, monkeypatch, status, actionable):
     home = tmp_path
     (home / 'kanban').mkdir()
     (home / 'kanban/origin-ledger.db').touch()
     board = home / 'kanban.db'
     _make_board(board, [('t_one', status, 's_one')])
+    if actionable:
+        _add_human_requests(board, 't_one')
     monkeypatch.setattr(hermes_constants, 'get_hermes_home', lambda: home)
     monkeypatch.setattr(adapter, '_gateway', lambda _: 'origin')
     monkeypatch.setattr(profiles, 'get_active_profile_name', lambda: 'default')
@@ -29,8 +32,9 @@ def test_local_open_association_dominates_stale_receipt(tmp_path, monkeypatch, s
     cards = activity.session_tasks(['s_one'])
     assert len(cards) == 1
     assert cards[0]['status'] == status
-    assert activity.blocked_task_counts() == ({'s_one': 1} if status == 'blocked' else {})
-    assert activity.active_task_counts() == ({} if status == 'blocked' else {'s_one': 1})
+    human_blocked = status == 'blocked' and actionable
+    assert activity.blocked_task_counts() == ({'s_one': 1} if human_blocked else {})
+    assert activity.active_task_counts() == ({} if human_blocked else {'s_one': 1})
     # A different owner profile, board, unknown owner, or receipt-only origin
     # association is not covered by the local association above.
     for changed in ({'profile': 'other'}, {'board': 'other'}, {'profile': None},
diff --git a/tests/hermes_cli/test_kanban_remote_identity.py b/tests/hermes_cli/test_kanban_remote_identity.py
index 19bfe69348..9a54d3ab3f 100644
--- a/tests/hermes_cli/test_kanban_remote_identity.py
+++ b/tests/hermes_cli/test_kanban_remote_identity.py
@@ -5,6 +5,7 @@ import sqlite3
 import pytest
 
 from hermes_cli import kanban_session_activity as activity
+from tests.hermes_cli.test_kanban_session_activity import HUMAN_REQUEST
 
 
 def replica(tmp_path, records):
@@ -65,19 +66,22 @@ def test_descendants_stay_in_the_roots_owner_profile(tmp_path):
     assert all(r['status'] == 'running' for r in rows)
 
 
-def test_same_gateway_other_profile_is_not_hidden(tmp_path, monkeypatch):
+@pytest.mark.parametrize('actionable', [False, True])
+def test_same_gateway_other_profile_is_not_hidden(tmp_path, monkeypatch, actionable):
     from hermes_cli import profiles
     monkeypatch.setattr(profiles, 'get_active_profile_name', lambda: 'default')
     path = replica(tmp_path, [
         ('default/default/t_same', card('default', status='blocked', block_kind='needs_input')),
-        ('work/default/t_same', card('work', status='blocked', block_kind='needs_input')),
+        ('work/default/t_same', card('work', status='blocked', block_kind='needs_input',
+                                     human_request=HUMAN_REQUEST if actionable else None)),
         ('default/t_same', card(None, status='blocked', block_kind='needs_input')),
     ])
     with sqlite3.connect(path) as db:
         db.execute("UPDATE replica SET gw='origin'")
     rows = activity._read_remote_links(path, now=100)
     assert {r['key'] for r in rows} == {'origin/work/default/t_same', 'origin/default/t_same'}
-    assert activity._replica_bucket(next(r for r in rows if r['profile'] == 'work')) == 'blocked'
+    assert activity._replica_bucket(next(r for r in rows if r['profile'] == 'work')) == (
+        'blocked' if actionable else 'active')
     assert activity._replica_bucket(next(r for r in rows if r['profile'] is None)) == 'active'
 
 
