From 0e950c1640b5693b50b67c88d0b3fc01d039bb23 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 20:00:20 +0000
Subject: [PATCH] fix(kanban): retain same-gateway foreign-profile obligations
 [daveey]

---
 hermes_cli/kanban_session_activity.py           |  7 +++++--
 tests/hermes_cli/test_kanban_remote_identity.py | 16 ++++++++++++++++
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 07449b8ba6..485fbeeea3 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -276,8 +276,7 @@ def _read_remote_links(path: Path, now: float | None = None) -> list[dict[str, A
         me = _self_gateway(conn)
         if not me:
             return []
-        rows = conn.execute("SELECT gw, key, data, updated_at FROM replica WHERE coll = 'tasks' AND gw != ?",
-                            (me,)).fetchall()
+        rows = conn.execute("SELECT gw, key, data, updated_at FROM replica WHERE coll = 'tasks'").fetchall()
         last_ok, offline = _meta_float(conn, "last_ok"), _meta_float(conn, "offline_since")
     finally:
         conn.close()
@@ -315,6 +314,10 @@ def _read_remote_links(path: Path, now: float | None = None) -> list[dict[str, A
     origin_profile = get_active_profile_name()
     found: dict[tuple[str, str], dict[str, Any]] = {}
     for (gw, owner_profile, board, tid), t in tasks.items():
+        # Only this exact owner is represented by the local board inventory.
+        # Other profiles on this gateway, and unqualified legacy owners, are not.
+        if gw == me and owner_profile == origin_profile:
+            continue
         links = t.get("sessions") if isinstance(t.get("sessions"), list) else []
         sids = {str(link['session']) for link in links
                 if isinstance(link, dict) and link.get('session') and link.get('gw') == me
diff --git a/tests/hermes_cli/test_kanban_remote_identity.py b/tests/hermes_cli/test_kanban_remote_identity.py
index f8ff836b21..19bfe69348 100644
--- a/tests/hermes_cli/test_kanban_remote_identity.py
+++ b/tests/hermes_cli/test_kanban_remote_identity.py
@@ -65,6 +65,22 @@ def test_descendants_stay_in_the_roots_owner_profile(tmp_path):
     assert all(r['status'] == 'running' for r in rows)
 
 
+def test_same_gateway_other_profile_is_not_hidden(tmp_path, monkeypatch):
+    from hermes_cli import profiles
+    monkeypatch.setattr(profiles, 'get_active_profile_name', lambda: 'default')
+    path = replica(tmp_path, [
+        ('default/default/t_same', card('default', status='blocked', block_kind='needs_input')),
+        ('work/default/t_same', card('work', status='blocked', block_kind='needs_input')),
+        ('default/t_same', card(None, status='blocked', block_kind='needs_input')),
+    ])
+    with sqlite3.connect(path) as db:
+        db.execute("UPDATE replica SET gw='origin'")
+    rows = activity._read_remote_links(path, now=100)
+    assert {r['key'] for r in rows} == {'origin/work/default/t_same', 'origin/default/t_same'}
+    assert activity._replica_bucket(next(r for r in rows if r['profile'] == 'work')) == 'blocked'
+    assert activity._replica_bucket(next(r for r in rows if r['profile'] is None)) == 'active'
+
+
 @pytest.mark.parametrize('payload', ['not json', '[]', '{}', 'null'])
 def test_malformed_replica_row_cannot_be_a_successful_empty_projection(tmp_path, payload):
     path = replica(tmp_path, [])
