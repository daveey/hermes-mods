diff --git a/hermes_cli/kanban_worker_placement.py b/hermes_cli/kanban_worker_placement.py
index 24c68d49cee..6c7e34afb55 100644
--- a/hermes_cli/kanban_worker_placement.py
+++ b/hermes_cli/kanban_worker_placement.py
@@ -77,6 +77,35 @@ def creation_audit(args, cfg=None):
         return None
 
 
+def resolved_db_policy(fields):
+    """Validate the effective workspace after project inheritance, enrolling only unchecked producers."""
+    policy = fields["placement_policy"]
+    if policy is None and not fields["placement_checked"]:
+        policy = db_policy(fields)
+    validate_creation(policy, runs_on=fields["runs_on"], workspace_kind=fields["workspace_kind"],
+                      workspace_path=fields["workspace_path"], project=fields["project_id"],
+                      origin_intent=None, board=fields["board"])
+    return policy
+
+
+def db_policy(fields):
+    """Enroll direct producers at insertion; front doors may preserve an already checked decision."""
+    from hermes_cli import kanban_placement as placement
+    from hermes_cli.kanban_db_connect import _main_db_file
+    from hermes_cli.kanban_db_sync import board_slug_for_path
+
+    cfg = placement.config()
+    if not cfg.get("worker_pools"):
+        return None
+    args = {**fields, "project": fields.get("project_id")}
+    db_file = _main_db_file(fields["conn"])
+    args["board"] = fields.get("board") or (board_slug_for_path(db_file) if db_file else "default")
+    if args.get("initial_status") == "running":
+        args.pop("initial_status")
+    result = creation_decision(args, cfg, placement.reg.self_gateway(), "auto", None)
+    return (result or {}).get("placement_policy")
+
+
 def _cli_fields(args, body, workspace_kind, workspace_path, board):
     fields = {**vars(args), "body": body, "workspace_kind": workspace_kind,
               "workspace_path": workspace_path, "board": board}
diff --git a/hermes_cli/machine_cpu_metrics.py b/hermes_cli/machine_cpu_metrics.py
index a744e21f50c..d57c456eb52 100644
--- a/hermes_cli/machine_cpu_metrics.py
+++ b/hermes_cli/machine_cpu_metrics.py
@@ -1,7 +1,9 @@
 """Measured CPU busy for the hub admission gate (worker-first overflow, docs/worker-first-v1.md).
 
 Busy is computed from two aggregate ``/proc/stat`` snapshots taken about one second apart on the monotonic clock:
-``100 * (Δtotal - Δidle - Δiowait) / Δtotal`` where total sums user..steal. ``guest``/``guest_nice`` are already
+``100 * (Δtotal - Δidle - Δiowait - Δnice) / Δtotal`` where total sums user..steal. Positive-nice user time is
+excluded so low-priority batch work does not veto foreground admission; system/IRQ/steal remain busy.
+This is aggregate non-nice busy, not a per-process nice>=10 filter. ``guest``/``guest_nice`` are already
 included in user/nice and are never added again; ``steal`` counts as busy (time this host could not use). Any read
 error, malformed line, counter decrease (reboot/reset), non-positive total, or an elapsed window outside
 [1000, 2000] ms yields ``None`` (unknown), which every caller treats as "refuse", never as idle.
@@ -44,7 +46,7 @@ def parse_proc_stat(text: str) -> Optional[tuple[int, int]]:
         values = (user, nice, system, idle, iowait, irq, softirq, steal)
         if any(v < 0 for v in values):
             return None
-        return sum(values), idle + iowait
+        return sum(values), idle + iowait + nice
     return None
 
 
