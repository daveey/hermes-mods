From 1be102cf7e97703c1d9db7297817ca6236bd13ad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 02:08:20 +0000
Subject: [PATCH] [daveey] kanban_singleton: portable pid check, BOM-tolerant
 reads

---
 gateway/kanban_singleton.py | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/gateway/kanban_singleton.py b/gateway/kanban_singleton.py
index 92aff45f4c2..90ac7ec35f0 100644
--- a/gateway/kanban_singleton.py
+++ b/gateway/kanban_singleton.py
@@ -64,19 +64,15 @@ def _pid_alive(pid: int) -> bool:
     if not isinstance(pid, int) or pid <= 0:
         return False
     try:
-        os.kill(pid, 0)
-    except ProcessLookupError:
-        return False
-    except PermissionError:
-        return True
-    except OSError:
+        from gateway.status import _pid_exists
+        return bool(_pid_exists(pid))
+    except Exception:
         return False
-    return True
 
 
 def _read_json(path: Path) -> Optional[dict]:
     with contextlib.suppress(OSError, ValueError):
-        data = json.loads(Path(path).read_text(encoding="utf-8"))
+        data = json.loads(Path(path).read_text(encoding="utf-8-sig"))
         return data if isinstance(data, dict) else None
     return None
 
