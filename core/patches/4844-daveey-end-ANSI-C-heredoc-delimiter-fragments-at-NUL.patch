From 2d9d73462cf813a5f856037a3b66749e7a20397d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:50:01 +0000
Subject: [PATCH] [daveey] end ANSI-C heredoc delimiter fragments at NUL

Bash ends each ANSI-C quoted fragment at its first decoded NUL. Keeping the NUL and tail prevented heredoc termination and hid a later group-fed lifecycle script. Preserve later quoted and unquoted word parts.

Proof: Bash 5.2.21 harmless marker oracle, public scanner and parser across 15 shapes. RED at 02d09756: 28 failed, 17 passed; GREEN: 45 passed. Covers octal, hex, Unicode and control NUL, concatenation, escaped quote tails and harmless controls.
---
 .../cron/test_lifecycle_guard_heredoc_nul.py  | 65 +++++++++++++++++++
 tools/shell_heredoc_words.py                  |  4 +-
 2 files changed, 68 insertions(+), 1 deletion(-)
 create mode 100644 tests/cron/test_lifecycle_guard_heredoc_nul.py

diff --git a/tests/cron/test_lifecycle_guard_heredoc_nul.py b/tests/cron/test_lifecycle_guard_heredoc_nul.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1a6d037e4272fa8d26080ed781e53725a2eab9b
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_heredoc_nul.py
@@ -0,0 +1,65 @@
+"""ANSI-C NUL truncation is per quoted fragment, not per heredoc word (PR #3020)."""
+
+from __future__ import annotations
+
+import shlex
+import shutil
+import subprocess
+
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+from tools.shell_heredoc import _parse_heredoc_operator
+
+LIFECYCLE = " ".join(["hermes", "gateway", "re" + "start"])
+WORDS = [
+    (r"$'E\0junk'", "E"),
+    (r"$'E\00junk'", "E"),
+    (r"$'E\000junk'", "E"),
+    (r"$'E\x0junk'", "E"),
+    (r"$'E\x00junk'", "E"),
+    (r"$'E\u0000junk'", "E"),
+    (r"$'E\U00000000junk'", "E"),
+    (r"$'E\c@junk'", "E"),
+    (r"$'E\c`junk'", "E"),
+    (r"$'E\0junk'tail", "Etail"),
+    (r"$'E\0'$'F'", "EF"),
+    (r'''pre"Q"$'E\x00junk'"R"'S'tail''', "preQERStail"),
+    (r"$'\0junk'E", "E"),
+    (r"$'E\0ignored\'tail'F", "EF"),
+    (r"$'E\x45'", "EE"),
+]
+
+
+def _group(word, terminator, script, sink):
+    return (f"{{\ncat >/dev/null <<{word}\n}}\n{terminator}\n"
+            f"cat {shlex.quote(str(script))}\n}} | {sink}")
+
+
+@pytest.mark.parametrize(("word", "terminator"), WORDS)
+def test_nul_fragment_parser_preserves_later_fragments(word, terminator):
+    opener = f"<<{word}"
+    assert _parse_heredoc_operator(opener, 0) == (len(opener), terminator, False, True)
+
+
+@pytest.mark.parametrize(("word", "terminator"), WORDS)
+def test_nul_fragment_group_feed_is_scanned(tmp_path, word, terminator):
+    script = tmp_path / "f.py"
+    script.write_text(f"import os\nos.system({LIFECYCLE!r})\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(_group(word, terminator, script, "python3")) == (True, None)
+    # The same suspicious file is only printed, not executed, without an interpreter sink.
+    assert scan_gateway_lifecycle(_group(word, terminator, script, "cat")) == (False, None)
+
+
+@pytest.mark.skipif(shutil.which("bash") is None, reason="needs bash")
+@pytest.mark.parametrize(("word", "terminator"), WORDS)
+def test_nul_fragment_real_bash_and_harmless_control(tmp_path, word, terminator):
+    # This is the only executed fixture: no lifecycle action ever reaches a subprocess.
+    script = tmp_path / "marker.py"
+    script.write_text("print('MARKER_EXECUTED')\n", encoding="utf-8")
+    command = _group(word, terminator, script, "python3")
+    result = subprocess.run(["bash", "--noprofile", "--norc", "-c", command],
+                            capture_output=True, text=True, encoding="utf-8", timeout=20,
+                            check=False)
+    assert (result.returncode, result.stdout, result.stderr) == (0, "MARKER_EXECUTED\n", "")
+    assert scan_gateway_lifecycle(command) == (False, None)
diff --git a/tools/shell_heredoc_words.py b/tools/shell_heredoc_words.py
index 3c8e396cfe28ea821b3ee564278d91907681b8aa..3d073a54e20d8dbf316c09094509444d7b539eac 100644
--- a/tools/shell_heredoc_words.py
+++ b/tools/shell_heredoc_words.py
@@ -48,7 +48,9 @@ def _decode_ansi_c(text: str) -> str:
             return chr(code & 0xFF if match["octal"] else code)
         except (ValueError, OverflowError):
             return match.group()
-    return _ANSI_C_ESCAPE_RE.sub(replace, text)
+    # Bash truncates this ANSI-C fragment at NUL, not the concatenated shell word.
+    # The caller still consumes its entire quoted span and reads subsequent fragments.
+    return _ANSI_C_ESCAPE_RE.sub(replace, text).split("\0", 1)[0]
 
 
 def _quoted_end(command: str, index: int, quote: str, escapes: bool | None = None) -> int | None:
