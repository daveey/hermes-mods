From cbd2cd579ffc9a3d18a140247628b35de76e9e96 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:03:10 -0700
Subject: [PATCH 235/248] fix(auth): carry model entitlement through every pool
 retry branch [daveey]

---
 agent/credential_pool.py                         | 14 +++++++-------
 .../test_codex_subscription_routing.py           | 16 ++++++++++++++++
 2 files changed, 23 insertions(+), 7 deletions(-)

diff --git a/agent/credential_pool.py b/agent/credential_pool.py
index fb5e3bfa28..e4e872a362 100644
--- a/agent/credential_pool.py
+++ b/agent/credential_pool.py
@@ -2323,7 +2323,7 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
             entry = self._find(lambda e: e.runtime_api_key == api_key_hint)
         return entry
 
-    def _rotate_unmatched(self) -> Optional[PooledCredential]:
+    def _rotate_unmatched(self, *, model: Optional[str] = None) -> Optional[PooledCredential]:
         """Rotate without marking anything when the failed identity matches no entry.
 
         Falling through to current()/_select_unlocked() would bench an
@@ -2335,7 +2335,7 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
         available entries, then surface the error; no cooldown is written.
         """
         self._unmatched_rotation_streak += 1
-        available_count = len(self._available_entries()[0])
+        available_count = len(self._available_entries(model=model)[0])
         if self._unmatched_rotation_streak > max(available_count, 1):
             logger.warning(
                 "credential pool: failed credential identity matched no "
@@ -2352,8 +2352,8 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
             self.provider,
         )
         self._current_id = None
-        next_entry, _pending = self._select_unlocked(refresh=False)
-        if next_entry is not None and len(self._available_entries()[0]) == 1:
+        next_entry, _pending = self._select_unlocked(refresh=False, model=model)
+        if next_entry is not None and len(self._available_entries(model=model)[0]) == 1:
             # A single-entry pool cannot rotate: returning its only entry would
             # report a recovery without changing the credential, and the
             # caller retries the same 401 indefinitely.
@@ -2376,11 +2376,11 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
             identity_supplied = bool(credential_id or api_key_hint)
             entry = self._identify_failed_entry(credential_id, api_key_hint)
             if entry is None and identity_supplied:
-                return self._rotate_unmatched()
+                return self._rotate_unmatched(model=model)
             # A real entry was identified — any prior unmatched streak is stale.
             self._unmatched_rotation_streak = 0
             if entry is None:
-                entry = self._current_unlocked() or self._select_unlocked(refresh=False)[0]
+                entry = self._current_unlocked() or self._select_unlocked(refresh=False, model=model)[0]
             if entry is None:
                 return None
             _label = entry.label or entry.id[:8]
@@ -2422,7 +2422,7 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
             else:
                 logger.info("credential pool: marking %s exhausted (status=%s), rotating", _label, status_code)
             self._current_id = None
-            next_entry, _pending = self._select_unlocked(refresh=False)
+            next_entry, _pending = self._select_unlocked(refresh=False, model=model)
             if next_entry is not None and next_entry.id == entry.id:
                 # No-recovery guard (#97315): selection handed back the very entry that was
                 # just marked (the auth-store sync adopted fresher tokens, or a quota probe
diff --git a/tests/hermes_cli/test_codex_subscription_routing.py b/tests/hermes_cli/test_codex_subscription_routing.py
index 22d1146608..992dd6e7ea 100644
--- a/tests/hermes_cli/test_codex_subscription_routing.py
+++ b/tests/hermes_cli/test_codex_subscription_routing.py
@@ -62,6 +62,22 @@ def test_pool_selection_for_astra_skips_free_entries(pool_home):
     assert pool.select(model="gpt-5.5").label == "free"  # ungated models still use the head entry
 
 
+@pytest.mark.parametrize("status", [401, 402, 429, 500])
+def test_astra_retry_never_rotates_to_free(pool_home, status):
+    pool = load_pool("openai-codex")
+    entry = pool.select(model=ASTRA)
+    assert entry.access_token == PRO
+    rotated = pool.mark_exhausted_and_rotate(status_code=status, credential_id=entry.id, model=ASTRA)
+    assert rotated is None or rotated.access_token == PRO
+    assert pool.reclaim("free1", model=ASTRA) is None
+
+
+def test_astra_unknown_failed_identity_never_rotates_to_free(pool_home):
+    pool = load_pool("openai-codex")
+    rotated = pool.mark_exhausted_and_rotate(status_code=401, api_key_hint="unknown-key", model=ASTRA)
+    assert rotated is None or rotated.access_token == PRO
+
+
 def test_codex_catalog_unions_all_pool_entries_when_current_is_free(pool_home):
     def fake_fetch(token, base_url=None):
         return ["gpt-5.5", ASTRA] if token == PRO else ["gpt-5.5", "luna"]
