From 310742356a30c401da3e7619dbf98099e0e39d07 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 04:05:08 +0000
Subject: [PATCH] test(kanban): containment receipt identity cases pass
 certified_stop [daveey]

Review of 70961d85: proof/origin cases of
test_receipt_cache_still_refuses_certified_changes_with_head were refused by
canonical_event before remember()'s identity comparison, so a mutant that dropped
containment_v1 from _certified survived all 33 tests.

Fix: proof uses a second valid uuid7 request; origin keeps origin_gateway aligned
with containment_v1.gateway; payload is an equivalent JSON re-dump that still
parses. All four cases now assert match='identity changed'.

Proof: row-only _certified mutant fails [proof] (DID NOT RAISE); restored source
gives 33 passed on replica+remote.
---
 .../test_kanban_containment_replica.py           | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_containment_replica.py b/tests/hermes_cli/test_kanban_containment_replica.py
index 4b2111f58e..325537a3b7 100644
--- a/tests/hermes_cli/test_kanban_containment_replica.py
+++ b/tests/hermes_cli/test_kanban_containment_replica.py
@@ -175,10 +175,18 @@ def test_receipt_cache_ignores_volatile_evidence_head(synced_conn):
     assert len(stored) == 1 and json.loads(stored[0][0])["head"] == 100
 
 
+def _foreign_origin(evidence):
+    # origin_gateway must stay aligned with containment_v1.gateway so certified_stop
+    # still passes; identity comparison is what must refuse.
+    evidence["row"].update(origin_gateway="foreign")
+    evidence["containment_v1"].update(gateway="foreign")
+
+
 @pytest.mark.parametrize("mutate", [
-    lambda e: e["row"].update(payload=e["row"]["payload"] + " "),
-    lambda e: e["row"].update(origin_gateway="foreign"),
-    lambda e: e["containment_v1"].update(request="changed"),
+    lambda e: e["row"].update(payload=json.dumps(json.loads(e["row"]["payload"]))),
+    _foreign_origin,
+    # request="changed" is refused by canonical_event (_uid) before identity compare.
+    lambda e: e["containment_v1"].update(request=sync.uuid7()),
     lambda e: e["row"].update(created_at=12345),
 ], ids=["payload", "origin", "proof", "row"])
 def test_receipt_cache_still_refuses_certified_changes_with_head(synced_conn, mutate):
@@ -190,7 +198,7 @@ def test_receipt_cache_still_refuses_certified_changes_with_head(synced_conn, mu
     altered = copy.deepcopy(proof)
     altered["head"] = 200
     mutate(altered)
-    with pytest.raises(ContainmentRefused):
+    with pytest.raises(ContainmentRefused, match="identity changed"):
         replica.remember(conn, altered, board="fixture", task=target, uid=stop["event_uid"])
 
 
