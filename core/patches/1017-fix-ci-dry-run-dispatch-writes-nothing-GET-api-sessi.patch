From b8a7f53c95447942403d5c5c94b62bb94c1c2f84 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 21:43:29 +0000
Subject: [PATCH] fix(ci): dry-run dispatch writes nothing; GET /api/sessions
 draft sweep opens writable only with drafts to archive [daveey]

bc67ee012ff stamped kanban.db on dry-run ticks (skip _record_dispatch_pass when dry_run);
851e72eed44 made every session-list poll open state.db writable and stamp last_draft_archive
(probe read-only, stamp only after archiving); the gateway-lock test fake lacked the new method.
Supersedes #226.
---
diff --git a/hermes_cli/web_server_sessions.py b/hermes_cli/web_server_sessions.py
index e6baa7321438f5bd0c943f7b8ef6f221907ef6c8..e6ba60f1cd5f6004bfda969edd5d8356f3471f14 100644
--- a/hermes_cli/web_server_sessions.py
+++ b/hermes_cli/web_server_sessions.py
@@ -486,6 +486,15 @@ def _maybe_auto_archive_for_profile(profile: Optional[str]) -> None:
         # of its own and a bare lock-file probe would report stopped.
         if _check_gateway_running(profile_home):
             return
+        if not cfg.get("auto_archive", False):
+            # Draft sweep only: opening the store writable bumps the WAL data_version even when
+            # nothing is archived, which a GET /api/sessions poll must not do. Ask read-only first.
+            probe = _open_session_db_for_profile(profile, read_only=True)
+            try:
+                if not probe.empty_draft_ids():
+                    return
+            finally:
+                probe.close()
         db = _open_session_db_for_profile(profile, read_only=False)
         try:
             db.maybe_auto_archive(
diff --git a/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py b/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py
index 95a0f22a7510c700ca136b758247e1b6558bfb61..0905d08a431fab6699d64d45646d70da67fcc647 100644
--- a/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py
+++ b/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py
@@ -35,6 +35,9 @@ class _FakeDB:
     def __init__(self, archived):
         self._archived = archived
 
+    def maybe_archive_empty_drafts(self):
+        return 0
+
     def maybe_auto_archive(self, **kwargs):
         self._archived.append(kwargs)
 
diff --git a/tests/hermes_state/test_empty_draft_archive.py b/tests/hermes_state/test_empty_draft_archive.py
index 91a64de13f4bbffd02d38b8bb3fdb9d36e9a7527..86d9327ef10ce622e4ad1a5d275bfaf66d2ab012 100644
--- a/tests/hermes_state/test_empty_draft_archive.py
+++ b/tests/hermes_state/test_empty_draft_archive.py
@@ -59,3 +59,14 @@ def test_gateway_maintenance_tick_archives_drafts_without_auto_archive(monkeypat
     run._housekeeping_state_db_maintenance()
 
     assert _archived(db, "old")
+
+
+def test_empty_sweep_writes_nothing_and_ids_are_listed_read_only(db):
+    """A sweep that finds no draft stamps no state_meta row (GET /api/sessions polls reach it), and
+    ``empty_draft_ids`` lets a read-only handle ask before the store is opened writable."""
+    _draft(db, "young", 2)
+    assert db.empty_draft_ids() == []
+    assert db.maybe_archive_empty_drafts() == 0
+    assert db.get_meta("last_draft_archive") is None
+    _draft(db, "old", 30)
+    assert db.empty_draft_ids() == ["old"]
