From 946c0fdb295b3a43e3c4b77bcebc5c080a6c8059 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:04:52 +0000
Subject: [PATCH] fix(state): tolerate sidecar unlinked between lstat and chmod
 in _secure_state_db_files (flaky zeroed-db quarantine race)

---
 hermes_state.py                               |  6 ++++-
 .../test_zeroed_db_quarantine_race.py         | 22 +++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/hermes_state.py b/hermes_state.py
index 19ec5fb0363..4bfd8c07e9b 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -300,7 +300,11 @@ def _secure_state_db_files(db_path: Path, *, create_main: bool = False) -> None:
             continue
         if not stat.S_ISREG(st.st_mode):
             continue
-        os.chmod(path, 0o600)
+        try:
+            os.chmod(path, 0o600)
+        except FileNotFoundError:
+            # A sibling's last close() unlinked -wal/-shm between the lstat and the chmod.
+            continue
 
 
 # Openings of the background-review harness prompts (agent/background_review.py).
diff --git a/tests/hermes_state/test_zeroed_db_quarantine_race.py b/tests/hermes_state/test_zeroed_db_quarantine_race.py
index fc442f946e6..e6e34bbb92c 100644
--- a/tests/hermes_state/test_zeroed_db_quarantine_race.py
+++ b/tests/hermes_state/test_zeroed_db_quarantine_race.py
@@ -71,3 +71,25 @@ def test_preflight_cannot_observe_db_mid_quarantine(tmp_path, monkeypatch):
     assert errors == [None, None], f"concurrent open raised: {errors}"
     baks = list(tmp_path.glob("state.db.zeroed-*.bak"))
     assert len(baks) == 1 and baks[0].read_bytes() == bytes(4096)
+
+
+def test_secure_files_tolerates_sidecar_unlinked_between_lstat_and_chmod(tmp_path, monkeypatch):
+    """A sibling's last ``close()`` unlinks -wal/-shm; the 0600 tightening must not raise ENOENT.
+
+    This was the cause of the flaky ``[None, FileNotFoundError]`` above: worker 0's ``close()``
+    raced worker 1's ``_secure_state_db_files`` (lstat succeeded, chmod hit ENOENT).
+    """
+    db = tmp_path / "state.db"
+    db.write_bytes(b"x")
+    wal = tmp_path / "state.db-wal"
+    wal.write_bytes(b"x")
+    real_chmod = os.chmod
+
+    def vanishing_chmod(path, mode, *args, **kwargs):
+        if Path(path) == wal:
+            wal.unlink()  # the sibling's close lands exactly here
+        return real_chmod(path, mode, *args, **kwargs)
+
+    monkeypatch.setattr(hs.os, "chmod", vanishing_chmod)
+    hs._secure_state_db_files(db)  # must not raise
+    assert not wal.exists()
-- 
2.55.0

