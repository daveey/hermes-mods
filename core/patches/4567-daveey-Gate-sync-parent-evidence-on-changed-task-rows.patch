+        held = next(iter(scope._MEMO.values()))
+        assert held[2].by_task == {task: frozenset({"parked"})}
+        monkeypatch.setattr(scope, "_full", real)
+        assert scope.evidence_scope(board) == {"parked"}
+        assert next(iter(scope._MEMO.values()))[2].by_task == {}
