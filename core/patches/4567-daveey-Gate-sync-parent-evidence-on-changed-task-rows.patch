+    real = scope._full
+    def racing(conn):
+        result = real(conn)
+        helpers._write(writer, "UPDATE task_events SET payload = '{}' WHERE id = ?", (event,))
+        return result
+    monkeypatch.setattr(scope, "_full", racing)
+    try:
