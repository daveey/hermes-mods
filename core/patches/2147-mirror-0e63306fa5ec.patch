From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 23:49:28 +0000
Subject: [PATCH] fix(desktop): observe one-second main-loop stalls [daveey]

---
 .../main-process-lag-watchdog.test.ts         | 39 +++++++++++++++++++
 apps/desktop/electron/main.ts                 |  2 +-
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/electron/main-process-lag-watchdog.test.ts b/apps/desktop/electron/main-process-lag-watchdog.test.ts
index f4019bc57ec..e47a1924781 100644
--- a/apps/desktop/electron/main-process-lag-watchdog.test.ts
+++ b/apps/desktop/electron/main-process-lag-watchdog.test.ts
@@ -1,3 +1,5 @@
+import fs from 'node:fs'
+
 import { describe, expect, it } from 'vitest'
 
 import { createMainProcessLagWatchdog } from './main-process-lag-watchdog'
@@ -37,6 +39,43 @@ function harness({ now = 0, cadenceMs = 1_000, thresholdMs = 2_000 } = {}) {
   }
 }
 
+// Importing main.ts would boot Electron. Read its actual wiring rather than
+// duplicating the production settings in the harness and missing threshold drift.
+const mainSource = fs.readFileSync(new URL('./main.ts', import.meta.url), 'utf8')
+const wiring = mainSource.match(/createMainProcessLagWatchdog\(\{\s*cadenceMs: ([\d_]+),\s*thresholdMs: ([\d_]+),/)
+
+function productionHarness() {
+  expect(wiring).not.toBeNull()
+
+  return harness({
+    cadenceMs: Number(wiring![1].replaceAll('_', '')),
+    thresholdMs: Number(wiring![2].replaceAll('_', ''))
+  })
+}
+
+describe('main-process watchdog production threshold', () => {
+  it.each([1_000, 1_001, 1_999, 2_000])('records %ims of delay, including the one-second blind spot', lag => {
+    const subject = productionHarness()
+    const cadence = Number(wiring![1].replaceAll('_', ''))
+
+    subject.watchdog.start()
+    subject.tick(cadence + lag)
+    expect(subject.logs).toHaveLength(1)
+    expect(subject.logs[0]).toContain(`lagged ${lag}ms`)
+    subject.tick(2 * cadence + lag)
+    expect(subject.logs).toHaveLength(1)
+  })
+
+  it('keeps sub-second jitter quiet', () => {
+    const subject = productionHarness()
+    const cadence = Number(wiring![1].replaceAll('_', ''))
+
+    subject.watchdog.start()
+    subject.tick(cadence + 999)
+    expect(subject.logs).toEqual([])
+  })
+})
+
 describe('createMainProcessLagWatchdog', () => {
   it('does not log while ticks arrive on their expected cadence', () => {
     const subject = harness()
diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index 762e721f904..b7a66b51276 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -2201,7 +2201,7 @@ function rememberLog(chunk) {
 // Windows AppHang report can be correlated without changing tray semantics.
 const mainProcessLagWatchdog = createMainProcessLagWatchdog({
   cadenceMs: 1_000,
-  thresholdMs: 2_000,
+  thresholdMs: 1_000,
   now: Date.now,
   log: rememberLog,
   setInterval,
