Subject: [PATCH] test(kanban): extract isolated profile admission diagnostics
 within file cap [daveey]

---
 tests/hermes_cli/kanban_guard_helpers.py | 16 ++++++++++++++++
 tests/hermes_cli/test_kanban_db.py       | 19 ++-----------------
 2 files changed, 18 insertions(+), 17 deletions(-)

diff --git a/tests/hermes_cli/kanban_guard_helpers.py b/tests/hermes_cli/kanban_guard_helpers.py
index 00cc9f8a07..885878aa97 100644
--- a/tests/hermes_cli/kanban_guard_helpers.py
+++ b/tests/hermes_cli/kanban_guard_helpers.py
@@ -23,6 +23,22 @@ def worker_comment(conn, task_id, author, body):
         return _add_comment(conn, task_id, author, body)
 
 
+def configure_eligible_profile(conn, task_id, home, assignee):
+    """Prove absent-profile refusal before enabling this isolated test's real registry."""
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    diagnostic = dispatch.dispatch_once(conn, dry_run=True)
+    assert diagnostic.skipped_ineligible == [(task_id, "model_unroutable:config_unavailable")]
+    assert conn.execute("SELECT count(*) FROM task_runs WHERE task_id=?", (task_id,)).fetchone()[0] == 0
+    assert _assignee_config(assignee) is None
+    profile = home / "profiles" / assignee
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config(assignee)
+    assert config is not None and config["model_routing"]["enabled"] is True
+
+
 _add_comment = kb.add_comment
 
 
diff --git a/tests/hermes_cli/test_kanban_db.py b/tests/hermes_cli/test_kanban_db.py
index 5332a4ef9b..80a4ec1c9e 100644
--- a/tests/hermes_cli/test_kanban_db.py
+++ b/tests/hermes_cli/test_kanban_db.py
@@ -527,17 +527,8 @@ def test_infrastructure_spawn_refusal_never_charges_the_card(
 
     with kbc.connect() as conn:
         tid = kb.create_task(conn, title="bus is down", assignee="a")
-        # Admission must reach the real infrastructure boundary, not stop at an absent profile registry.
-        diagnostic = kbd.dispatch_once(conn, dry_run=True)
-        assert diagnostic.skipped_ineligible == [(tid, "model_unroutable:config_unavailable")]
-        assert conn.execute("SELECT count(*) FROM task_runs WHERE task_id=?", (tid,)).fetchone()[0] == 0
-        from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
-        from hermes_cli.kanban_model_assignment import _assignee_config
-        assert _assignee_config("a") is None
-        profile = kanban_home / "profiles" / "a"
-        profile.mkdir(parents=True)
-        (profile / "config.yaml").write_text(_managed_yaml())
-        assert _assignee_config("a")["model_routing"]["enabled"] is True
+        from tests.hermes_cli.kanban_guard_helpers import configure_eligible_profile
+        configure_eligible_profile(conn, tid, kanban_home, "a")
         for _ in range(3):
             res = kbd.dispatch_once(conn, spawn_fn=spawn_via_real_boundary, failure_limit=2)
             assert res.auto_blocked == []
@@ -567,12 +558,6 @@ def test_infrastructure_spawn_refusal_never_charges_the_card(
         ).fetchone()[0] == 1
 
 
