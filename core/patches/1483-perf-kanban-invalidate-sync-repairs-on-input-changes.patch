diff --git a/hermes_cli/kanban_sync_repair_revision.py b/hermes_cli/kanban_sync_repair_revision.py
new file mode 100644
index 0000000000..d9f5f740cb
--- /dev/null
+++ b/hermes_cli/kanban_sync_repair_revision.py
@@ -0,0 +1,49 @@
+"""Transactional invalidation for the sync client's repair scans, not dispatcher bookkeeping."""
+
+from __future__ import annotations
+
+import sqlite3
+
+# These are the live inputs of partition links, remote parents, divergence, missing
+# children and placeholder retirement. Keep independent of the capture triggers:
+# repairing writes made while capture is absent is the reason these scans exist.
+TABLES = (
+    "tasks", "task_runs", "task_links", "task_chat_links",
+    "kanban_sync_outbox", "kanban_sync_tombstones", "kanban_sync_remote_parents",
+)
+REVISION_TABLE = "kanban_repair_revision"
+
+
+def ensure_revision(conn: sqlite3.Connection) -> None:
+    """Install/repair the counter and its triggers atomically on an existing synced board.
+
+    No write transaction on the normal path. Triggers use a separate prefix so
+    capture disable/reinstall cannot create an invisible repair-input change.
+    Schema changes also enter the reader's key, including a removed trigger.
+    """
+    expected = {
+        f"kanban_repair_{table}_{op.lower()}":
+        f"CREATE TRIGGER kanban_repair_{table}_{op.lower()} AFTER {op} ON {table} "
+        f"BEGIN UPDATE {REVISION_TABLE} SET revision = revision + 1 WHERE id = 1; END"
+        for table in TABLES for op in ("INSERT", "UPDATE", "DELETE")
+    }
+    found = dict(conn.execute(
+        "SELECT name, sql FROM sqlite_master WHERE type = 'trigger' AND name GLOB 'kanban_repair_*'"))
+    has_table = conn.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
+                             (REVISION_TABLE,)).fetchone()
+    if all(found.get(name) == sql for name, sql in expected.items()) and has_table and conn.execute(
+        f"SELECT 1 FROM {REVISION_TABLE} WHERE id = 1"
+    ).fetchone():
+        return
+    from hermes_cli.kanban_db_connect import write_txn
+    with write_txn(conn):
+        conn.execute(f"CREATE TABLE IF NOT EXISTS {REVISION_TABLE} "
+                     "(id INTEGER PRIMARY KEY CHECK (id = 1), revision INTEGER NOT NULL)")
+        conn.execute(f"INSERT OR IGNORE INTO {REVISION_TABLE} VALUES (1, 0)")
+        # A capture gap or replaced definition must invalidate even if no data
+        # write was observed while the trigger was absent.
+        conn.execute(f"UPDATE {REVISION_TABLE} SET revision = revision + 1 WHERE id = 1")
+        for name, sql in expected.items():
+            if found.get(name) != sql:
+                conn.execute(f"DROP TRIGGER IF EXISTS {name}")
+                conn.execute(sql)
diff --git a/tests/hermes_cli/test_kanban_sync_idle_round.py b/tests/hermes_cli/test_kanban_sync_idle_round.py
index 5ee0115ddb..83ba1ad496 100644
--- a/tests/hermes_cli/test_kanban_sync_idle_round.py
+++ b/tests/hermes_cli/test_kanban_sync_idle_round.py
@@ -141,6 +141,68 @@ def test_a_capture_gap_after_idle_rounds_is_still_healed(live, svc, kanban_home,
     assert svc.board(BOARD)["rows"]["tasks"][parent]["title"] == "gap edit"
 
 
+@pytest.mark.parametrize("mode", ["shadow", "primary"])
+def test_dispatch_clock_commits_do_not_repeat_unchanged_repairs(live, svc, kanban_home, monkeypatch, mode):
+    _settle(live, svc, kanban_home, mode)
+    with kbc.write_txn(live):
+        live.execute("CREATE TABLE kanban_dispatch_stamp (id INTEGER PRIMARY KEY, at INTEGER)")
+    for _ in range(3):
+        _round(kanban_home, svc)
+    calls = _spy(monkeypatch, REPAIRS)
+    for stamp in range(4):
+        with kbc.write_txn(live):
+            live.execute("INSERT OR REPLACE INTO kanban_dispatch_stamp VALUES (1, ?)", (stamp,))
+        _round(kanban_home, svc)
+    assert not any(calls.values()), f"dispatch bookkeeping repeated repair scans: {calls}"
+
+
+@pytest.mark.parametrize("mode", ["shadow", "primary"])
+def test_repair_revision_rolls_back_and_tracks_other_connection(live, svc, kanban_home, monkeypatch, mode):
+    parent, _ = _settle(live, svc, kanban_home, mode)
+    for _ in range(3):
+        _round(kanban_home, svc)
+    calls = _spy(monkeypatch, REPAIRS)
+    writer = sqlite3.connect(kanban_home / "kanban.db", isolation_level=None)
+    try:
+        writer.execute("BEGIN IMMEDIATE")
+        writer.execute("UPDATE tasks SET title = 'rolled back' WHERE id = ?", (parent,))
+        writer.rollback()
+        _round(kanban_home, svc)
+        assert not any(calls.values())
+        writer.execute("UPDATE tasks SET title = 'committed' WHERE id = ?", (parent,))
+        _round(kanban_home, svc)
+        assert all(n == 1 for n in calls.values()), calls
+    finally:
+        writer.close()
+
+
+@pytest.mark.parametrize("mode", ["shadow", "primary"])
+def test_write_during_repair_is_not_cached_as_already_repaired(live, svc, kanban_home, monkeypatch, mode):
+    parent, _ = _settle(live, svc, kanban_home, mode)
+    real = ksc.retire_lost_placeholder_links
+    wrote = False
+
+    def concurrent_write(*args):
+        nonlocal wrote
+        result = real(*args)
+        if not wrote:
+            wrote = True
+            with kbc.write_txn(live):
+                # Suppress capture without DDL: schema_version cannot mask a lost revision.
+                live.execute("UPDATE kanban_sync_state SET applying = 1")
+                live.execute("UPDATE tasks SET title = 'during repair' WHERE id = ?", (parent,))
+                live.execute("UPDATE kanban_sync_state SET applying = 0")
+        return result
+
+    monkeypatch.setattr(ksc, "retire_lost_placeholder_links", concurrent_write)
+    ksc._REPAIRED.clear()
+    _round(kanban_home, svc)
+    assert wrote
+    _round(kanban_home, svc)
+    _round(kanban_home, svc)
+    assert svc.board(BOARD)["rows"]["tasks"][parent]["title"] == "during repair"
+
+
