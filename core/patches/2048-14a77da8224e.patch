--- /dev/null
+++ b/tests/hermes_cli/test_kanban_scratch_custody.py
@@ -0,0 +1,896 @@
+"""Moved scratch: real SQLite eviction/GC with an injected authoritative transport.
+
+Session fixtures model only the read-side columns; no live home or Board calls.
+"""
+import json
+import sqlite3
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_scratch_archive as archive
+from hermes_cli import kanban_scratch_custody as custody
+from hermes_cli import kanban_sync_client as client
+from hermes_cli import kanban_worker_node as worker
+from hermes_cli import kanban_worktree_gc as gc
+from tests.hermes_cli import test_kanban_scratch_gc_archive as helpers
+
+remote = helpers.remote
+OLD = int(time.time()) - 10 * 86400
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    for name in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_WORKSPACES_ROOT"):
+        monkeypatch.delenv(name, raising=False)
+    (home / "config.yaml").write_text("kanban:\n  sync:\n    enabled: true\n")
+    conn = kbc.connect(home / "kanban.db")
+    client.ensure_identity(conn, "default", "worker")
+    sync.set_mode(conn, "primary")
+    state = sqlite3.connect(home / "state.db")
+    state.executescript(
+        "CREATE TABLE sessions (id TEXT PRIMARY KEY, source TEXT, cwd TEXT, ended_at INTEGER, parent_session_id TEXT);"
+        "CREATE TABLE session_admissions (request_id TEXT, target_session_id TEXT, status TEXT);"
+        "CREATE TABLE session_turn_leases (conversation_id TEXT, expires_at REAL);")
+    owner = {"uid": "", "status": "done", "completed_at": OLD, "lease_holder": None, "lease_expires": None}
+    e = SimpleNamespace(conn=conn, state=state, home=home, owner=owner, evidence_state="live", calls=0,
+                        evidence_extra={})
+
+    class Hub:
+        def row_evidence(self, board, table, uid):
+            assert not conn.in_transaction
+            assert (board, table) == ("default", "tasks")
+            e.calls += 1
+            return {"table": table, "uid": uid, "head": 1, "state": e.evidence_state, "row": dict(owner),
+                    **e.evidence_extra}
+
+    monkeypatch.setattr(client, "load_identity", lambda: None)
+    monkeypatch.setattr(client, "Hub", lambda identity: Hub())
+    # Keep host process inventory out of synthetic-record tests.
+    from hermes_cli import kanban_workspace_jobs
+    monkeypatch.setattr(kanban_workspace_jobs, "defer_owned_job_cleanup", lambda *_: False)
+    yield e
+    state.close()
+    conn.close()
+
+
+def task(env, *, kind="scratch", path_mode="managed", ended=OLD):
+    tid = kb.create_task(env.conn, title="foreign scratch")
+    path = kb.workspaces_root() / tid
+    path.mkdir(parents=True)
+    (path / "notes").write_text("keep me")
+    stored = {"managed": str(path), "missing": None, "root": str(path.parent),
+              "outside": str(env.home / "source")}[path_mode]
+    with kb.write_txn(env.conn):
+        env.conn.execute("UPDATE kanban_sync_state SET applying=1")
+        env.conn.execute("UPDATE tasks SET created_on='other', status='done', workspace_kind=?, "
+                         "workspace_path=?, completed_at=? WHERE id=?", (kind, stored, OLD, tid))
+        run = env.conn.execute("INSERT INTO task_runs(task_id,status,started_at,ended_at) VALUES (?,'done',?,?)",
+                               (tid, OLD - 1, ended)).lastrowid
+        env.conn.execute("DELETE FROM kanban_sync_outbox")  # fixture: prior work already drained
+        env.conn.execute("UPDATE kanban_sync_state SET applying=0")
+    env.owner["uid"] = tid
+    return tid, path, run
+
+
+def evicted(env, **kwargs):
+    tid, path, run = task(env, **kwargs)
+    assert worker.evict(env.conn) == [tid]
+    assert kb.get_task(env.conn, tid) is None
+    return tid, path, run
+
+
+def session(env, tid, path, run, *, sid="session", request=None, ended: int | None = OLD, source="kanban"):
+    env.state.execute("INSERT INTO sessions VALUES (?,?,?,?,NULL)", (sid, source, str(path), ended))
+    request = request if request is not None else "kanban:" + json.dumps(["default", tid, run])
+    env.state.execute("INSERT INTO session_admissions VALUES (?,?,'terminal')", (request, sid))
+    env.state.commit()
+
+
+def legacy(env, **session_kw):
+    tid, path, run = evicted(env)
+    with kb.write_txn(env.conn):
+        env.conn.execute("DELETE FROM kanban_scratch_custody")  # pre-fix eviction fixture
+    session(env, tid, path, run, **session_kw)
+    return tid, path, run
+
+
+def test_refused_receipt_does_not_starve_later_workspace(env, monkeypatch, caplog):
+    first, first_path, _ = evicted(env)
