+    fired = []
+
+    def boundary(conn, sql):
+        if sql == "COMMIT" and _trash(path).exists() and not fired:
+            fired.append(1)
+            raise sqlite3.OperationalError("disk I/O error")
+        return real_boundary(conn, sql)
+
