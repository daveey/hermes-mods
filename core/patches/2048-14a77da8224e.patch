+@pytest.mark.parametrize("race", ["pickup_null_path", "receipt", "inode", "mtime", "legacy_session_deleted", "legacy_ambiguous"])
+def test_archive_to_rename_fence(env, remote, monkeypatch, race):
+    tid, path, run = legacy(env) if race.startswith("legacy_") else evicted(env)
+    helpers._run("clone", "-q", str(remote), str(path / "repo"))
+    real = archive.archive_workspace
+    raced = []
+
+    def racing(*args, **kwargs):
+        result = real(*args, **kwargs)
+
+        def pickup():
+            # Real foreign import, with no local workspace assigned yet.
+            sync.apply_remote_changes(env.conn, [sync.RemoteChange(
+                1, "tasks", tid, "upsert", {"title": "picked up", "status": "ready", "created_on": "other", "created_at": OLD,
+                                          "workspace_kind": "scratch", "workspace_path": None}, 1, "", "")],
+                new_cursor=1, observers=False)
+            assert kb.get_task(env.conn, tid) is not None
+
+        def change_receipt():
+            with kb.write_txn(env.conn):
+                env.conn.execute("UPDATE kanban_scratch_custody SET evidence=json_set(evidence, '$.changed', 1) WHERE task_id=?", (tid,))
+
+        def replace_tree():
+            path.rename(path.with_name(path.name + "-old"))
+            path.mkdir()
+
+        def delete_session():
+            env.state.execute("DELETE FROM sessions")
+            env.state.commit()
+        actions = {"pickup_null_path": pickup, "receipt": change_receipt, "inode": replace_tree,
+                   "mtime": lambda: (path / "new-work").write_text("new"),
+                   "legacy_session_deleted": delete_session,
+                   "legacy_ambiguous": lambda: session(env, tid, path, run, sid="duplicate")}
+        actions[race]()
+        raced.append(race)
+        return result
+
+    monkeypatch.setattr(archive, "archive_workspace", racing)
+    assert gc.gc_task_scratch(env.conn, older_than_days=7) == 0
+    assert raced == [race]
+    assert path.exists()
