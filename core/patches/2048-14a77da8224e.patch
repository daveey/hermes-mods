+def test_commit_failure_never_clobbers_reoccupied_path(env, monkeypatch, caplog):
+    _, path, _ = evicted(env)
+    real = kbc._execute_boundary_with_retry
+    fresh = []
+
+    def boundary(conn, sql):
+        if sql == "COMMIT" and _trash(path).exists() and not fresh:
+            path.mkdir()  # empty: a plain rename would silently replace it
+            fresh.append(path.stat().st_ino)
+            raise sqlite3.OperationalError("disk I/O error")
+        return real(conn, sql)
+
+    monkeypatch.setattr(kbc, "_execute_boundary_with_retry", boundary)
+    assert gc.gc_task_scratch(env.conn, older_than_days=7) == 0
+    assert path.stat().st_ino == fresh[0] and list(path.iterdir()) == []
+    assert (_trash(path) / "notes").read_text() == "keep me"
+    assert "restored=False reason=path_reoccupied" in caplog.text and str(_trash(path)) in caplog.text
+
