+@pytest.mark.parametrize("stage", ["commit", "post_commit"])
+def test_commit_failure_after_rename_restores_tree_and_stops(env, monkeypatch, caplog, stage):
+    first, first_path, _ = evicted(env)
+    second, second_path, _ = evicted(env)
+    fired, asked = [], []
+
+    def terminal(_hub, _board, tid):
+        asked.append(tid)
+        return dict(env.owner, uid=tid)
+
+    monkeypatch.setattr(custody, "_terminal", terminal)
+
+    def fail_once(sql=None):
+        if not fired and _trash(first_path).exists() and sql in (None, "COMMIT"):
+            fired.append(stage)
+            raise sqlite3.OperationalError("disk I/O error")
+
+    if stage == "commit":
+        real = kbc._execute_boundary_with_retry
+
+        def boundary(conn, sql):
+            fail_once(sql)
+            return real(conn, sql)
+        monkeypatch.setattr(kbc, "_execute_boundary_with_retry", boundary)
+    else:
+        real = kbc._check_file_length_invariant
+
+        def invariant(conn):
+            real(conn)
+            fail_once()
+        monkeypatch.setattr(kbc, "_check_file_length_invariant", invariant)
+    assert gc.gc_task_scratch(env.conn, older_than_days=7) == 0
+    assert fired == [stage]
+    assert (first_path / "notes").read_text() == "keep me" and not _trash(first_path).exists()
+    # A rolled-back COMMIT keeps the receipt; a landed one is reported absent, never guessed.
+    assert (_receipt(env, first) is not None) is (stage == "commit")
+    receipt = "present" if stage == "commit" else "absent"
+    assert f"receipt={receipt} restored=True" in caplog.text
+    assert asked == [first] and second_path.exists() and _receipt(env, second) is not None
+
