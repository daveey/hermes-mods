From aaf7be5791c812ff0088592972dd63a9462d8ac6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 01:33:01 +0000
Subject: [PATCH] fix(kanban): preserve pending successful courier adoption
 [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/kanban_origin_owner.py            | 2 ++
 tests/hermes_cli/test_kanban_origin_owner.py | 8 +++++++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_origin_owner.py b/hermes_cli/kanban_origin_owner.py
index 40acd1b769f..d5fc84c82d6 100644
--- a/hermes_cli/kanban_origin_owner.py
+++ b/hermes_cli/kanban_origin_owner.py
@@ -93,7 +93,9 @@ def _dispatch_result(raw_result):
     except ValueError:
         result = None
     if (isinstance(result, dict) and result.get('created') is False
+            and result.get('adopted') is not True
             and isinstance(result.get('code'), str) and result['code'].strip()):
+        # Successful adoption creates no card but still awaits origin binding.
         # Definitive no-write refusals cannot be repaired by replaying this envelope.
         return {**result, 'status': 'rejected', 'handoff_complete': False}
     if not isinstance(result, dict) or result.get('handoff_complete') is not False:
diff --git a/tests/hermes_cli/test_kanban_origin_owner.py b/tests/hermes_cli/test_kanban_origin_owner.py
index 3f9431ced24..c2549bbad4d 100644
--- a/tests/hermes_cli/test_kanban_origin_owner.py
+++ b/tests/hermes_cli/test_kanban_origin_owner.py
@@ -208,8 +208,14 @@ def test_owner_entry_adopts_existing_task_and_replays(world, monkeypatch, capsys
     result = invoke(request, monkeypatch, capsys)
     assert result.get('adopted') is True, result
     assert result['created'] is False
+    assert result.get('status', 'pending') == 'pending'
+    assert result['code'] == 'origin_bind_pending'
     assert result['handoff_complete'] is False
-    assert invoke(request, monkeypatch, capsys)['origin_creation'] == result['origin_creation']
+    replay = invoke(request, monkeypatch, capsys)
+    assert replay.get('status', 'pending') == 'pending'
+    assert replay['code'] == 'origin_bind_pending'
+    assert replay['origin_creation'] == result['origin_creation']
+    assert replay['origin_creation']['binding']['origin'] == world['args']['origin']
     with kbc.connect_closing() as conn:
         assert conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == 1
         assert dict(conn.execute('SELECT * FROM tasks WHERE id=?', (tid,)).fetchone()) == before
-- 
