From 7a1b7bde01b8d194967d85dc8c389ee832c9d1ed Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:01:57 +0000
Subject: [PATCH] [daveey] kanban source: pin prove_clone's fetch-URL compare
 for a global fetch-only rewrite

prove_clone refuses origin_rewritten when `effective != raw or push_effective != raw
or pushurl or rewrites`, but no test pinned the `effective != raw` term for a GLOBAL
rule: `remote get-url --push` falls back to insteadOf, so the existing global
[insteadOf] case is caught by the push compare alone. Mutant M4d (drop the fetch
compare) passed all 39 tests in tests/hermes_cli/test_kanban_source_resolver.py.

The surviving shape is a real fail-open: a global
`url.<fork>.insteadOf <origin>` plus `url.<origin>.pushInsteadOf <origin>` gives
fetch=<fork>, push=origin and no local url.* rule.

New test test_global_fetch_only_rewrite_of_origin_refused sets that pair with a
real, reachable bare fork and asserts ProofFailed origin_rewritten (host scope).
Tests only; no behaviour change.

RED (fetch compare removed): 39 passed, 1 failed - DID NOT RAISE (the clone proved
while fetching from the fork).
GREEN (main): 40 passed.

Card: t_01a1d5d32a8db578 (follow-up of t_01a1d5aa7959f38b, PR #2352).
---
 tests/hermes_cli/test_kanban_source_resolver.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_source_resolver.py b/tests/hermes_cli/test_kanban_source_resolver.py
index a925d4009e..98ac1bdb8e 100644
--- a/tests/hermes_cli/test_kanban_source_resolver.py
+++ b/tests/hermes_cli/test_kanban_source_resolver.py
@@ -274,6 +274,22 @@ def test_global_rewrite_of_origin_refused(world, key):
     assert (err.code, err.scope) == ("origin_rewritten", "host")
 
 
+def test_global_fetch_only_rewrite_of_origin_refused(world):
+    """A global insteadOf to a fork plus a pushInsteadOf back to origin moves only the FETCH URL: push still
+    equals origin and the clone has no local url.* rule, so only the fetch-URL compare refuses it. The fork is a
+    real, reachable repository: without that compare the clone would prove while fetching from it."""
+    conn, cfg = use_home(world, "worker-2")
+    clone = world.homes["worker-2"].clone
+    fork = str(world.tmp / "fork.git")
+    git(world.tmp, "clone", "-q", "--bare", str(world.origin), fork)
+    git(world.tmp, "config", "--global", f"url.{fork}.insteadOf", str(world.origin))
+    git(world.tmp, "config", "--global", f"url.{world.origin}.pushInsteadOf", str(world.origin))
+    assert git(clone, "ls-remote", "--get-url", "origin") == fork
+    assert git(clone, "remote", "get-url", "--push", "origin") == str(world.origin)
+    err = refusal(lambda: resolve(world, conn, cfg, snap(world)))
+    assert (err.code, err.scope) == ("origin_rewritten", "host")
+
+
 def test_github_repo_uses_dispatcher_gh_argv(monkeypatch):
     """The id lookup runs under the home's gh_command_prefix (the hub's gh has no login or GH_TOKEN)."""
     from hermes_cli import kanban_gh_argv
