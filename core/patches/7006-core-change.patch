From 540891a78b1a8108c986cdb89dacd4f72f50395d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 17:29:46 +0000
Subject: [PATCH 7006] Cooperative home custody: dormant live-home transfer substrate

Public mirror of source commit 540891a78b1a8108c986cdb89dacd4f72f50395d.

---
diff --git a/hermes_cli/kanban_sync_attachments.py b/hermes_cli/kanban_sync_attachments.py
index a30ad50f2acc0f85d089717b8ef73dff9a7a463b..995fa487255cc662c5e6f734edb9fda56b4c37ba 100644
--- a/hermes_cli/kanban_sync_attachments.py
+++ b/hermes_cli/kanban_sync_attachments.py
@@ -84,6 +84,13 @@
             temporary.unlink(missing_ok=True)
 
 
+def _stale_row_ok(conn, uid):
+    # A storage echo/deletion is an ordinary successful no-op, but a UID that
+    # moved to a frozen recipient must remain deferred for that recipient.
+    current = conn.execute("SELECT task_id FROM task_attachments WHERE uid=?", (uid,)).fetchone()
+    return current is None or not frozen(conn, current["task_id"])
+
+
 def _record_local(conn, row, path, key, *, data=None):
     # stored_path is local-only. Suppress echo of the service's verified receipt.
     # A deleted/rebound row must not be resurrected after network I/O.
@@ -101,7 +108,7 @@
         # A concurrent pull may already have applied the storage receipt. Changed
         # or deleted rows need no stale local write; they are not a custody refusal.
         if current is None:
-            return True
+            return _stale_row_ok(conn, row["uid"])
         if current["stored_path"] == str(path) and current["blob_key"] == key:
             return True
     with write_txn(conn):
@@ -112,7 +119,7 @@
                                (row["uid"], row["id"], row["task_id"], row["size"], row["filename"],
                                 row["created_at"], row["blob_key"])).fetchone()
         if current is None:
-            return True
+            return _stale_row_ok(conn, row["uid"])
         if data is not None:
             # Byte publication and local metadata share the custody reservation.
             # No network is performed under this writer lock.
diff --git a/tests/hermes_cli/test_home_shared_consumer_io.py b/tests/hermes_cli/test_home_shared_consumer_io.py
index cadfded609f5251ca96ec9dd53392b62572e492c..ddda39ef5536efbc8662dd41242edc9451bb69be 100644
--- a/tests/hermes_cli/test_home_shared_consumer_io.py
+++ b/tests/hermes_cli/test_home_shared_consumer_io.py
@@ -49,7 +49,9 @@
                     if change != 'deleted':
                         support.freeze(other, 't_new' if change == 'rebound' else 't_A', 'pending')
                 return data
-        assert attachments.transfer_pending(c, Hub(), 'default', limit=2) == 1
+        # A vanished unfrozen row is a successful no-op (the upload/storage-echo
+        # contract); a UID rebound onto a frozen recipient remains deferred.
+        assert attachments.transfer_pending(c, Hub(), 'default', limit=2) == (2 if change == 'deleted' else 1)
     assert calls == ['attachment_t_A', 'attachment_t_B']
     assert c.execute("SELECT stored_path FROM task_attachments WHERE task_id='t_B'").fetchone()[0]
     assert c.execute("SELECT 1 FROM kanban_attachment_retry WHERE uid='attachment_t_A'").fetchone() is None
