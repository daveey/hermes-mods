Subject: [PATCH 6491] Desktop kanban model-requirement and recovery transport test harnesses

Public mirror of source commit bd3789d3677fc506e590bac524e55ad0d3eb700c.

---
diff --git a/apps/desktop/src/plugins/kanban/model-override-producers.test.tsx b/apps/desktop/src/plugins/kanban/model-override-producers.test.tsx
new file mode 100644
index 00000000000..74e6ced46c2
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/model-override-producers.test.tsx
@@ -0,0 +1,182 @@
+/** The two Desktop producers that send a Kanban model requirement, asserted at the REST request they emit. */
+import type { PluginRestOptions } from '@hermes/plugin-sdk'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// Test harness supplies the host's locale registration, as plugin loading does.
+// eslint-disable-next-line no-restricted-imports
+import { registerPluginLocales } from '@/i18n/plugin-i18n'
+
+import { bindApi } from './api'
+import { KanbanBoardPage } from './board'
+import { TaskDrawer } from './drawer'
+import { en, KANBAN_LOCALES } from './i18n'
+
+vi.mock('@/hermes', () => ({ setApiRequestProfile: vi.fn() }))
+
+const PIN = { model_override: 'gpt-6-luna', provider_override: 'openai-codex' }
+
+const pinnedDetail = {
+  task: { id: 't_pinned', title: 'Pinned task', body: 'Body', status: 'todo', ...PIN },
+  comments: [],
+  events: [],
+  links: { parents: [], children: [] },
+  runs: [],
+  attachments: []
+}
+
+let client: QueryClient
+let disposeApi: () => void
+let disposeLocales: () => void
+
+const rest = vi.fn(async (path: string, options?: PluginRestOptions): Promise<unknown> => {
+  const url = new URL(path, 'http://example.com')
+
+  if (url.pathname === '/boards') {
+    return { current: 'default', boards: [] }
+  }
+
+  if (url.pathname === '/board') {
+    return { columns: [], tenants: [], assignees: [], latest_event_id: 1 }
+  }
+
+  if (url.pathname === '/profiles') {
+    return { profiles: [] }
+  }
+
+  if (url.pathname === '/orchestration') {
+    return { default_assignee: '' }
+  }
+
+  if (url.pathname === '/tasks' && options?.method === 'POST') {
+    return { task: { id: 't_new', title: 'New', status: 'triage' } }
+  }
+
+  if (url.pathname === '/tasks/t_pinned/log') {
+    return { exists: false, content: '', size_bytes: 0, truncated: false }
+  }
+
+  if (url.pathname === '/tasks/t_pinned') {
+    return options?.method ? { ok: true } : pinnedDetail
+  }
+
+  if (options?.method) {
+    return { ok: true }
+  }
+
+  throw new Error(`Unexpected REST request: ${path}`)
+})
+
+/** Every request that carried a body, as [pathname, method, body]. */
+const writes = (pathname: string, method: string) =>
+  rest.mock.calls
+    .filter(
+      ([path, options]) => new URL(path, 'http://example.com').pathname === pathname && options?.method === method
+    )
+    .map(([, options]) => options?.body as Record<string, unknown>)
+
+const sentPin = () =>
+  rest.mock.calls.some(([, options]) => /gpt-6-luna|openai-codex/.test(JSON.stringify(options?.body ?? null)))
+
+beforeEach(() => {
+  client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  disposeLocales = registerPluginLocales('kanban', KANBAN_LOCALES)
+  disposeApi = bindApi(
+    async <T,>(path: string, options?: PluginRestOptions) => (await rest(path, options)) as T,
+    { get: (_key, fallback) => fallback, set: vi.fn(), remove: vi.fn() },
+    () => vi.fn()
+  )
+})
+
+afterEach(() => {
+  cleanup()
+  client.clear()
+  disposeApi()
+  disposeLocales()
+  vi.clearAllMocks()
+})
+
+function openDrawer() {
+  render(
+    <QueryClientProvider client={client}>
+      <TaskDrawer columns={['todo', 'ready', 'done']} id="t_pinned" onClose={vi.fn()} onOpen={vi.fn()} />
+    </QueryClientProvider>
+  )
+}
+
+describe('task drawer model requirement', () => {
+  it('PATCHes a class with the auto provider and never resubmits the stored concrete pin', async () => {
+    openDrawer()
+    await screen.findByRole('heading', { name: 'Pinned task' })
+    const selector = screen.getByRole('combobox', { name: en.modelInherit }) as HTMLSelectElement
+
+    // The stored pin is not offered or shown.
+    expect(selector.value).toBe('')
+    fireEvent.change(selector, { target: { value: 'class:deep' } })
+
+    await waitFor(() => expect(writes('/tasks/t_pinned', 'PATCH')).toHaveLength(1))
+    expect(writes('/tasks/t_pinned', 'PATCH')[0]).toEqual({
+      model_override: 'class:deep',
+      provider_override: 'auto',
+      clear_reasoning_effort: true
+    })
+    expect(sentPin()).toBe(false)
+  })
+
+  it('clears the stored pin when only the effort changes', async () => {
+    openDrawer()
+    await screen.findByRole('heading', { name: 'Pinned task' })
+
+    const effort = screen
+      .getAllByRole('combobox')
+      .find(node =>
+        Array.from(node.querySelectorAll('option')).some(option => option.value === 'ultra')
+      ) as HTMLSelectElement
+
+    fireEvent.change(effort, { target: { value: 'high' } })
+
+    await waitFor(() => expect(writes('/tasks/t_pinned', 'PATCH')).toHaveLength(1))
+    expect(writes('/tasks/t_pinned', 'PATCH')[0]).toEqual({ clear_model_override: true, reasoning_effort: 'high' })
+    expect(sentPin()).toBe(false)
+  })
+})
+
+describe('new task form model requirement', () => {
+  async function openForm() {
+    render(
+      <QueryClientProvider client={client}>
+        <KanbanBoardPage />
+      </QueryClientProvider>
+    )
+    fireEvent.click((await screen.findAllByRole('button', { name: en.newTask }))[0])
+    fireEvent.change(await screen.findByPlaceholderText(en.titlePlaceholderTriage), {
+      target: { value: 'Routed card' }
+    })
+  }
+
+  it('POSTs the chosen class with the auto provider', async () => {
+    await openForm()
+    fireEvent.change(screen.getByRole('combobox', { name: en.modelInherit }), { target: { value: 'class:fast' } })
+    fireEvent.click(screen.getByRole('button', { name: en.createTask }))
+
+    await waitFor(() => expect(writes('/tasks', 'POST')).toHaveLength(1))
+    expect(writes('/tasks', 'POST')[0]).toMatchObject({
+      title: 'Routed card',
+      model_override: 'class:fast',
+      provider_override: 'auto'
+    })
+  })
+
+  it('POSTs no model or provider key when the profile default is kept', async () => {
+    await openForm()
+    fireEvent.click(screen.getByRole('button', { name: en.createTask }))
+
+    await waitFor(() => expect(writes('/tasks', 'POST')).toHaveLength(1))
+    const body = writes('/tasks', 'POST')[0]
+
+    expect(body).toMatchObject({ title: 'Routed card' })
+    expect(body).not.toHaveProperty('model_override')
+    expect(body).not.toHaveProperty('provider_override')
+  })
+})
