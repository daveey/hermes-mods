+"""Native Hermes/Slack binding, independent of a deployment's RPC transport.
+
+Inject trusted host-side callables (never model arguments):
+  rpc(method, params) -> unwrapped native result
+  owner_tool(name, arguments, live_session_id) -> native tool result
+  sessions(query) -> normalized exact persisted session rows (with messages)
+  cards(card_id) -> native Task fields plus trusted board and parents readback
+  projects(query) -> native Project.to_dict plus verified profile and repo
+  card_keys(query) -> all matching task IDs, including archived (never truncated)
+  slack(method, payload) -> native Slack Web API response for policy.team_id
+  evidence(workflow_row) -> freshly collected evidence facts; see verify_evidence
+
+The deployment binds these to its supervised native gateway/owner conversation,
+projects store and repository CI reader. This module never edits native databases
+or fabricates records. Unknown/missing native state fails closed.
+"""
+import json
+import re
+import uuid
+
+from .errors import NativeCreateRefused
+
+
+class InboundChanged(RuntimeError):
+    """Positive thread invalidation, not a transport outage."""
+
+
+_AUTOLINK = re.compile(r'<(https?://[^<>|\s]+)>')
+_DOMAINLINK = re.compile(r'<https?://([^<>|\s]+)\|\1>')
+_MAILTO = re.compile(r'<mailto:([^<>|\s]+)\|\1>')
+
+
+def slack_text(text):
+    """Undo only Slack's own auto-linking (<https://x> -> https://x, <http://a.b|a.b> -> a.b, <mailto:a@b|a@b> -> a@b).
+
+    A labeled link or a mention never compares equal to the text that was posted. Keep in step with
+    planning.slack_text and native_attestations.slack_text (agreement is tested)."""
+    if not isinstance(text, str):
+        return None
+    return _MAILTO.sub(r'\1', _DOMAINLINK.sub(r'\1', _AUTOLINK.sub(r'\1', text)))
+
+
+def delivery_marker(idempotency_key):
+    """Intent-unique marker: one per (workflow, generation, delivery kind). Slack need not echo
+    client_msg_id, so this visible line is what lets an uncertain send be found again."""
+    return 'Delivery receipt: ' + str(uuid.uuid5(uuid.NAMESPACE_URL, idempotency_key))
+
+
+def delivery_text(text, idempotency_key, version=2):
+    """Render new bodies as literal Slack text; v1 is recovery-only legacy markup."""
+    if type(version) is not int or version not in (1, 2):
+        raise ValueError('Unknown delivery version')
+    if version == 2:
+        text = text.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
+    return text + '\n\n' + delivery_marker(idempotency_key)
+
+
+# Slack's real markup only: user/channel ids, the special mentions and subteam/date commands, links. A
+# lookalike such as '<!--x-->' is plain text that Slack entity-escapes.
+_MARKUP = re.compile(r'<(?:[@#][UWCG][A-Z0-9]+|!(?:here|channel|everyone)|!(?:subteam|date)\^[^<>]*'
+                     r'|(?:https?://|mailto:)[^<>\s|]*)(?:\|[^<>]*)?>')
+
+
+def _escaped(segment, style):
+    if style == 'all':
+        segment = segment.replace('&', '&amp;')
+    elif style == 'smart':      # & escaped unless it already starts an entity
+        segment = re.sub(r'&(?!(?:lt|gt|amp);)', '&amp;', segment)
+    return segment.replace('<', '&lt;').replace('>', '&gt;')
+
+
+def _forms(posted):
+    """Every readback form Slack may return for POSTED text: verbatim, or with the text between live
+    markup tokens (<@U..>, <!..>, <#..>, <http..>, <mailto:..>) entity-escaped in one of three styles
+    (< and > only; also &; & unless already an entity). Live markup itself is never escaped, so an
+    escaped literal can never stand in for a mention/link or the reverse."""
+    forms = {posted}
+    parts = []
+    last = 0
+    for token in _MARKUP.finditer(posted):
+        parts.append((posted[last:token.start()], False))
+        parts.append((token.group(0), True))
+        last = token.end()
+    parts.append((posted[last:], False))
+    for style in ('ltgt', 'all', 'smart'):
+        forms.add(''.join(text if live else _escaped(text, style) for text, live in parts))
+        # Forward-escape ampersands INSIDE existing link tokens, never delimiters.
+        # This cannot turn an escaped literal into active markup.
+        forms.add(''.join(
+            ('<' + _escaped(text[1:-1], style) + '>'
+             if text.startswith(('<http://', '<https://', '<mailto:')) else text)
+            if live else _escaped(text, style) for text, live in parts))
+    return forms
+
+
+def same_text(received, expected):
+    """Normalized equality of a Slack readback against the text we posted: Slack's autolinking
+    (slack_text) and its entity escaping of non-markup < > & (LIVE82: a 2427-char plan came back as
+    2433). Keep in step with planning._same_text (agreement is tested)."""
+    got, want = slack_text(received), slack_text(expected)
+    if got is None or want is None:
+        return False
+    return got in {slack_text(form) for form in _forms(expected)}
+
