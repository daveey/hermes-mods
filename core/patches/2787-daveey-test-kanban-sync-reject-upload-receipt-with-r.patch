From 4c7e68905faf16941efd2f5ba279a5de692e69b0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:21:18 +0000
Subject: [PATCH] [daveey] test(kanban-sync): reject upload receipt with right
 sha256/size but foreign blob_key

Mutant M2 (dropping the blob_key check in _transfer) survived every
attachment test: no case had a correct sha256 and size but a wrong
blob_key. Add that receipt to test_unverified_upload_receipt_keeps_local_custody.
---
 tests/hermes_cli/test_kanban_sync_attachments.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_sync_attachments.py b/tests/hermes_cli/test_kanban_sync_attachments.py
index 400c28d461..790155d754 100644
--- a/tests/hermes_cli/test_kanban_sync_attachments.py
+++ b/tests/hermes_cli/test_kanban_sync_attachments.py
@@ -186,7 +186,9 @@ def test_duplicate_names_and_foreign_shadow_are_readable(stores):
 
 
 @pytest.mark.parametrize("bad_receipt", [None, {}, {"blob_key": "sha256:" + "0" * 64},
-                                        {"blob_key": "key", "sha256": "wrong", "size": 5}])
+                                        {"blob_key": "key", "sha256": "wrong", "size": 5},
+                                        {"blob_key": "sha256:" + "0" * 64,
+                                         "sha256": hashlib.sha256(b"proof").hexdigest(), "size": 5}])
 def test_unverified_upload_receipt_keeps_local_custody(stores, monkeypatch, bad_receipt):
     _, worker, _, conn, _, tid, round_at = stores
     aid = kb.store_attachment_bytes(conn, tid, "receipt", b"proof")
