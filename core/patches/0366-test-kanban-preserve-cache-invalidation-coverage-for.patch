---
 tests/hermes_cli/test_kanban_session_activity.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_session_activity.py b/tests/hermes_cli/test_kanban_session_activity.py
index feb9adc95d..85dac4b24d 100644
--- a/tests/hermes_cli/test_kanban_session_activity.py
+++ b/tests/hermes_cli/test_kanban_session_activity.py
@@ -85,6 +85,8 @@ def test_archive_invalidates_cached_counts_and_waiting_ids(kanban_root, journal_
     """An archive from another process must be visible before the poll TTL expires."""
     path = kanban_root / "kanban.db"
     _make_board(path, [("t1", status, "s1")])
+    if status == "blocked":
+        _add_human_requests(path, "t1")
     conn = sqlite3.connect(path)
     try:
         conn.execute(f"PRAGMA journal_mode={journal_mode}")
