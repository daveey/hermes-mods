Subject: [PATCH] fix(tests): close kept-alive metrics client and join HTTP
 fixtures [daveey]

---
 tests/agent/test_aux_progress_streaming.py            | 11 +++++++----
 tests/agent/test_bedrock_no_sdk_retry.py              |  6 ++++--
 tests/agent/test_model_metadata_http.py               |  6 +++---
 tests/hermes_cli/test_kanban_sync_metrics_budget.py   |  9 ++++++---
 tests/hermes_cli/test_kanban_sync_metrics_teardown.py |  2 +-
 5 files changed, 21 insertions(+), 13 deletions(-)

diff --git a/tests/agent/test_aux_progress_streaming.py b/tests/agent/test_aux_progress_streaming.py
index 5d3957f5f5b..61261418c54 100644
--- a/tests/agent/test_aux_progress_streaming.py
+++ b/tests/agent/test_aux_progress_streaming.py
@@ -315,9 +315,10 @@ class TestAggregateChatStream:
                     pass
 
         server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _Handler)
-        server.daemon_threads = True
-        threading.Thread(target=server.serve_forever, daemon=True).start()
-        return server
+        server.daemon_threads = False
+        serve_thread = threading.Thread(target=server.serve_forever)
+        serve_thread.start()
+        return server, serve_thread
 
     @pytest.fixture
     def sse(self, monkeypatch):
@@ -326,7 +327,7 @@ class TestAggregateChatStream:
         import openai
 
         gates = {name: threading.Event() for name in ("release", "a", "b", "b_started", "usage")}
-        server = self._sse_server(gates)
+        server, serve_thread = self._sse_server(gates)
         monkeypatch.setattr("agent.auxiliary_client._AUX_STREAM_NO_PROGRESS_TIMEOUT_SECONDS", 3.0)
         monkeypatch.setattr("agent.auxiliary_client._get_task_no_progress_timeout",
                             lambda task: 0.4 if task == "compression" else None)
@@ -350,7 +351,9 @@ class TestAggregateChatStream:
             for gate in gates.values():
                 gate.set()
             server.shutdown()
+            serve_thread.join()
             client.close()
+            server.server_close()
 
     @pytest.mark.parametrize("via_relay_seam", [False, True], ids=["primary", "recovery_rung"])
     def test_silent_stream_fails_fast_through_the_real_transport(self, sse, via_relay_seam):
diff --git a/tests/agent/test_bedrock_no_sdk_retry.py b/tests/agent/test_bedrock_no_sdk_retry.py
index 72c042e6059..e60ef8c25ea 100644
--- a/tests/agent/test_bedrock_no_sdk_retry.py
+++ b/tests/agent/test_bedrock_no_sdk_retry.py
@@ -66,8 +66,9 @@ def fake_bedrock(monkeypatch):
             pass
 
     server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
-    server.daemon_threads = True
-    threading.Thread(target=server.serve_forever, daemon=True).start()
+    server.daemon_threads = False
+    serve_thread = threading.Thread(target=server.serve_forever)
+    serve_thread.start()
     monkeypatch.setenv("AWS_ENDPOINT_URL_BEDROCK_RUNTIME", f"http://127.0.0.1:{server.server_port}")
     monkeypatch.setenv("AWS_ACCESS_KEY_ID", "AKIA-FAKE")
     monkeypatch.setenv("AWS_SECRET_ACCESS_KEY", "fake-secret")
@@ -81,6 +82,7 @@ def fake_bedrock(monkeypatch):
     finally:
         release.set()
         server.shutdown()
+        serve_thread.join()
         server.server_close()
         bedrock_adapter.reset_client_cache()
 
diff --git a/tests/agent/test_model_metadata_http.py b/tests/agent/test_model_metadata_http.py
index fc7ef69073d..e4ae8162464 100644
--- a/tests/agent/test_model_metadata_http.py
+++ b/tests/agent/test_model_metadata_http.py
@@ -15,8 +15,8 @@ def servers():
 
     def start(handler):
         server = ThreadingHTTPServer(("127.0.0.1", 0), handler)
-        server.daemon_threads = True
-        thread = Thread(target=server.serve_forever, daemon=True)
+        server.daemon_threads = False
+        thread = Thread(target=server.serve_forever)
         thread.start()
         active.append((server, thread))
         return f"http://127.0.0.1:{server.server_port}"
@@ -24,8 +24,8 @@ def servers():
     yield start
     for server, thread in reversed(active):
         server.shutdown()
+        thread.join()
         server.server_close()
-        thread.join(timeout=5)
 
 
 def test_redirect_credentials_and_proxy_routing_are_preserved(servers, monkeypatch):
diff --git a/tests/hermes_cli/test_kanban_sync_metrics_budget.py b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
index 8c6b1005822..7b74e58fcce 100644
--- a/tests/hermes_cli/test_kanban_sync_metrics_budget.py
+++ b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
@@ -95,9 +95,12 @@ def test_cpu_report_has_hard_total_budget(server, monkeypatch):
 def test_cpu_report_succeeds_inside_budget_and_plain_report_keeps_normal_path(server, monkeypatch):
     monkeypatch.setattr(ksc.urllib.request, "getproxies", dict)
     h = hub(server.url)
-    assert h.report_metrics({"cpus": 4, **CPU}) == {"ok": True}
-    assert h.report_metrics({"cpus": 4}) == {"ok": True}
-    assert len(server.requests) == 2
+    try:
+        assert h.report_metrics({"cpus": 4, **CPU}) == {"ok": True}
+        assert h.report_metrics({"cpus": 4}) == {"ok": True}
+        assert len(server.requests) == 2
+    finally:
+        h.close()
 
 
 def test_cpu_report_budget_is_two_seconds():
diff --git a/tests/hermes_cli/test_kanban_sync_metrics_teardown.py b/tests/hermes_cli/test_kanban_sync_metrics_teardown.py
index 2bb6415e02f..d81ab7c27dc 100644
