diff --git a/tests/hermes_cli/test_kanban_replay_compat_custody.py b/tests/hermes_cli/test_kanban_replay_compat_custody.py
new file mode 100644
index 0000000000000000000000000000000000000000..f251c02f32de8796880b579776a52877bba2dc05
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_replay_compat_custody.py
@@ -0,0 +1,111 @@
+"""Schema repair cannot turn uncertain issued transport into a fresh intent."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_replay_journal as journal
+from hermes_cli import kanban_sync_compat as compat
+from tests.hermes_cli import test_kanban_replay_lifecycle_custody as helpers
+
+live = helpers.live
+
+
+def refusal(row, field):
+    return dict(client_op_id=row['op_id'], status='rejected', reason='forbidden_field',
+                detail=f"not writable on tasks: {field}")
+
+
+@pytest.mark.parametrize('field', ['title', 'workspace_kind'])
+def test_schema_retry_keeps_issued_source_and_omission_custody(live, field):
+    helpers.issued(live, {'title': 'frozen containment intent', 'workspace_kind': 'scratch'})
+    row = dict(live.execute('SELECT * FROM kanban_sync_outbox').fetchone())
+    wire = json.loads(journal.pending_wire(live))
+    frozen = journal.pending_wire(live)
+    with kbc.write_txn(live):
+        with pytest.raises(ValueError, match='issued schema repair requires final verdict'):
+            compat.enqueue_retry(live, row, wire, refusal(row, field))
+        assert [dict(r) for r in live.execute('SELECT * FROM kanban_sync_outbox')] == [row]
+        assert not live.execute('SELECT 1 FROM kanban_sync_omissions').fetchone()
+        assert journal.pending_wire(live) == frozen
+
+
+@pytest.mark.parametrize('field', ['title', 'workspace_kind'])
+@pytest.mark.parametrize('bound', [True, False])
+def test_unissued_schema_repair_still_progresses(live, field, bound):
+    from hermes_cli import kanban_db as kb
+    tid = kb.create_task(live, title='unissued', assignee='worker')
+    with kbc.write_txn(live):
+        live.execute("DELETE FROM kanban_sync_outbox WHERE table_name!='tasks'")
+        live.execute('UPDATE kanban_sync_outbox SET fields=?',
+                     (json.dumps({'title': 'unissued', 'workspace_kind': 'scratch'}),))
+        if not bound:
+            live.execute('UPDATE kanban_sync_state SET journal_id=NULL')
+            live.execute('DROP TABLE kanban_replay_sender1')
+        row = dict(live.execute('SELECT * FROM kanban_sync_outbox WHERE row_uid=?', (tid,)).fetchone())
+        wire = dict(fields=json.loads(row['fields']), hlc=row['hlc'])
+        result = compat.enqueue_retry(live, row, wire, refusal(row, field))
+        assert result == (True if field == 'title' else compat.VIRTUAL_DROPPED)
+        replacement, = [dict(r) for r in live.execute('SELECT * FROM kanban_sync_outbox')
+                         if r['op_id'] != row['op_id']]
+        assert json.loads(replacement['fields']) == {k: v for k, v in wire['fields'].items() if k != field}
+
+
+@pytest.mark.parametrize('damage', ['anchor', 'wire', 'transaction'])
+def test_schema_repair_validates_custody_before_any_writes(live, damage):
+    helpers.issued(live, {'title': 'frozen containment intent'})
+    row = dict(live.execute('SELECT * FROM kanban_sync_outbox').fetchone())
+    wire = json.loads(journal.pending_wire(live))
+    with kbc.write_txn(live):
+        if damage == 'anchor':
+            live.execute("UPDATE kanban_sync_state SET journal_id='wrong'")
+        elif damage == 'wire':
+            live.execute("UPDATE kanban_replay_sender1 SET wire=X'7b7d'")
+    if damage == 'transaction':
+        with pytest.raises(ValueError, match='caller transaction required'):
+            compat.enqueue_retry(live, row, wire, refusal(row, 'title'))
+    else:
+        with kbc.write_txn(live):
+            with pytest.raises(ValueError):
+                compat.enqueue_retry(live, row, wire, refusal(row, 'title'))
+    assert [dict(r) for r in live.execute('SELECT * FROM kanban_sync_outbox')] == [row]
+    assert not live.execute('SELECT 1 FROM kanban_sync_omissions').fetchone()
+
+
+def test_other_unissued_operation_can_repair_while_one_is_issued(live):
+    tid, _ = helpers.issued(live, {'title': 'frozen containment intent'})
+    held = dict(live.execute('SELECT * FROM kanban_sync_outbox').fetchone())
+    frozen = journal.pending_wire(live)
+    with kbc.write_txn(live):
+        live.execute('INSERT INTO kanban_sync_outbox(op_id,table_name,row_uid,op,fields,hlc,created_at) '
+                     "VALUES ('later','tasks',?,'upsert',?, '1:0:macbook',1)",
+                     (tid, json.dumps({'title': 'later annotation'})))
+        row = dict(live.execute("SELECT * FROM kanban_sync_outbox WHERE op_id='later'").fetchone())
+        assert compat.enqueue_retry(live, row, dict(fields=json.loads(row['fields']), hlc=row['hlc']),
+                                    refusal(row, 'title')) is True
+        assert dict(live.execute('SELECT * FROM kanban_sync_outbox WHERE op_id=?', (held['op_id'],)).fetchone()) == held
+        assert journal.pending_wire(live) == frozen
+
+
+def test_recorded_rejection_releases_schema_repair_after_reopen(live):
+    from hermes_cli import kanban_sync_client as client
+    from tests.hermes_cli import test_kanban_replay_sender as sender
+    _tid, receiver = helpers.issued(live, {'title': 'frozen containment intent'})
+    row = dict(live.execute('SELECT * FROM kanban_sync_outbox').fetchone())
+    wire = json.loads(journal.pending_wire(live))
+    # Controlled serving-slot final rejection, not a local current-row inference.
+    receiver.slot['last_verdict'] = json.dumps(refusal(row, 'title'))
+    reopened = sender.reopen(live)
+    try:
+        receiver.lose_reply = False
+        settled = client.push(reopened, receiver, 'default', 'macbook', primary=False, max_batches=1)
+        assert settled.rejected == 1 and len(receiver.sent) == 1
+        assert journal.pending_wire(reopened) is None
+        assert receiver.slot['a'] == '1'
+        with kbc.write_txn(reopened):
+            saved = dict(reopened.execute('SELECT * FROM kanban_sync_outbox WHERE op_id=?', (row['op_id'],)).fetchone())
+            assert saved['state'] == 'rejected'
+            assert compat.enqueue_retry(reopened, saved, wire, refusal(saved, 'title')) is True
+            assert reopened.execute('SELECT COUNT(*) FROM kanban_sync_outbox').fetchone()[0] == 2
+    finally:
+        reopened.close()
