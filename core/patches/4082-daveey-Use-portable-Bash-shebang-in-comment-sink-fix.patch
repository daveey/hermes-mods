From 8dca071fb5d38e4f152b669a9c412e61e047d4cb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:54:42 +0000
Subject: [PATCH] [daveey] Use portable Bash shebang in comment sink fixture

---
 tests/cron/test_lifecycle_guard_comment_sink.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_comment_sink.py b/tests/cron/test_lifecycle_guard_comment_sink.py
index bd8120aaec..1ccbcde679 100644
--- a/tests/cron/test_lifecycle_guard_comment_sink.py
+++ b/tests/cron/test_lifecycle_guard_comment_sink.py
@@ -29,7 +29,7 @@ def test_wrapper_does_not_execute_oversized_data_assignment(tmp_path):
     data.write_text("padding\n" * 160000, encoding="utf-8")
     wrapper = tmp_path / "wrapper.sh"
     wrapper.write_text(
-        '#!/bin/bash\nx=1\n# transport; `auth` (git helper)\n'
+        '#!/usr/bin/env bash\nx=1\n# transport; `auth` (git helper)\n'
         f'log="{data}"\n', encoding="utf-8",
     )
     assert scan_gateway_lifecycle(f"bash {wrapper}", cwd=str(tmp_path)) == (False, None)
