From 63c2f0cc5e99281772b1ac8cc5a30089161cfcd7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 09:42:32 +0000
Subject: [PATCH] fix(cron): retain integer context from alias declarations
 [daveey]

Alias assignment prefixes hide declare/typeset from the declaration regex. Inspect dequoted alias values so later arithmetic subscript assignments are walked. Preserve non-integer alias controls. Real Bash marker RED: two misses; GREEN: 24 focused tests. Full cron: 11143 passed, 9 skipped, one independently reproduced baseline heredoc failure. scripts/check: 20 checks pass.
---
 cron/lifecycle_guard_arith_words.py                  | 8 ++++++++
 tests/cron/test_lifecycle_guard_arith_int_context.py | 4 ++++
 2 files changed, 12 insertions(+)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index e7290124ee706ddfc38236b30c3b8ab5e1224332..a1a93cab2712b1276696c5b707cf47ce3e2e7f3e 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -169,6 +169,14 @@ def may_set_integer_attributes(command: str) -> bool:
         if index is None:
             continue
         name = guard._executable_name(words[index])
+        # Alias values are dequoted assignment words: the '=' before declare
+        # prevents the ordinary declaration regex from matching its command name.
+        # Inspect only alias definitions, not arbitrary data assignments.
+        if name == "alias" and any(
+            _INTEGER_DECLARATION_RE.search(word.partition("=")[2])
+            for word in words[index + 1:] if "=" in word
+        ):
+            return True
         # Do not evaluate expansions or source files to discover attributes. Either
         # can introduce an integer declaration; allow the later subscript walk now,
         # before referenced files are traversed. Unknown commands may be declare.
diff --git a/tests/cron/test_lifecycle_guard_arith_int_context.py b/tests/cron/test_lifecycle_guard_arith_int_context.py
index 728418146afa79b893e7780d2b4d9e8fcdafdd52..b0e3c0b28f167f2d086ae67c683fb9840f7bf33d 100644
--- a/tests/cron/test_lifecycle_guard_arith_int_context.py
+++ b/tests/cron/test_lifecycle_guard_arith_int_context.py
@@ -9,6 +9,8 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 
 SHAPES = [
+    "shopt -s expand_aliases\nalias d='declare -i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='typeset -i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     r'let "a[\`SCRIPT\`]=1"',
     r"declare -i x; eval 'x=a[\$\(SCRIPT\)]'",
     r"declare -i x; eval 'x=a[\`SCRIPT\`]'",
@@ -26,6 +28,8 @@ SHAPES = [
     r". ./decl.sh; eval 'x=a[\$\(SCRIPT\)]'",
 ]
 CONTROLS = [
+    "shopt -s expand_aliases\nalias d='declare'\nd x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='declare +i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     r"eval 'x=a[\$\(SCRIPT\)]'",
     r"declare x; eval 'x=a[\$\(SCRIPT\)]'",
     r"declare +i x; eval 'x=a[\$\(SCRIPT\)]'",
-- 
