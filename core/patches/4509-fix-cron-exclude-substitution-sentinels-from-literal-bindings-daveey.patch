From 928f2d72b80c4b6f468218481a77c36dbdf59111 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 12:53:46 +0000
Subject: [PATCH] fix(cron): exclude substitution sentinels from literal
 bindings [daveey]

---
 cron/lifecycle_guard_variables.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_variables.py b/cron/lifecycle_guard_variables.py
index 7397f67546f84dae368c864c725ecd7d98a0969e..77aa22640d02adbdca6a542ca51c3851007f4900 100644
--- a/cron/lifecycle_guard_variables.py
+++ b/cron/lifecycle_guard_variables.py
@@ -58,7 +58,7 @@ class VariableCandidates:
                 if match:
                     # Dynamic values are not literal bindings: substitutions are
                     # traversed by the ordinary walk, never reinterpreted here.
-                    if not any(char in match[2] for char in '$`'):
+                    if not any(char in match[2] for char in '$`\x00'):
                         self.values.setdefault(match[1], set()).add(match[2])
                 elif not word.startswith('-'):
                     break
-- 
