From da34cee8c4f4a701390698287c9d0ae5bdba63ae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:35:12 +0000
Subject: [PATCH] [daveey] kanban: _wake's held-card skip names every producer;
 pin probe recovery after the hold lifts

Review 5891312321 on #2187 (nits 1 and 3).

1. The skip_wake branch comment in _wake talked only about the probe
   rerunning. It now says the probe-row delete and episode reset apply to
   every _wake producer that reaches a held card (shared-blocker clear,
   supervisor-request wake, CI progress, dead ancestry, a lost probe, a
   probe result).
2. New test: once the held-card skip dropped the probe, a reopen reaching
   the log while the local row still reads scheduled under the same park
   lifts the hold and restore_missing_checks recovers the card: it
   re-registers the probe (no RESTORED_EVENT after the park) or wakes the
   card through _lost_wake (one already follows the park). Both paths
   passed on first run, so there was no bug to fix.

Tests: test_kanban_stale_wake_terminal.py + test_kanban_wake_check.py,
56 passed.
---
 hermes_cli/kanban_wake_check.py               |  6 ++--
 .../test_kanban_stale_wake_terminal.py        | 29 +++++++++++++++++++
 2 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index 288b2aea5f..915675fc55 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -947,8 +947,10 @@ def _wake(conn: sqlite3.Connection, task_id: str, kind: str, payload: dict) -> O
 
     from hermes_cli.kanban_terminal_guard import skip_wake
     if skip_wake(conn, task_id, kind):  # a stale scheduled copy of a done card: no wake [daveey]
-        # Nor another probe: the held card's probe would rerun every ``check_every`` (holding a probe slot) until
-        # the feed heals the row to done. ``restore_missing_checks`` skips a held card, so it stays gone.
+        # Every producer reaching a held card here (shared-blocker clear, supervisor-request wake, CI progress, dead
+        # ancestry, a lost probe, a probe result) also drops its probe and wake episode: kept, it would rerun every
+        # ``check_every`` (holding a slot) until the feed heals the row to done. ``restore_missing_checks`` skips a
+        # held card, so it stays gone, and re-registers it (or wakes the card) if a reopen lifts the hold.
         conn.execute("DELETE FROM task_wake_checks WHERE task_id = ?", (task_id,))
         episode.reset(conn, task_id)
         return None
diff --git a/tests/hermes_cli/test_kanban_stale_wake_terminal.py b/tests/hermes_cli/test_kanban_stale_wake_terminal.py
index be85bed9ea..c878dceffd 100644
--- a/tests/hermes_cli/test_kanban_stale_wake_terminal.py
+++ b/tests/hermes_cli/test_kanban_stale_wake_terminal.py
@@ -339,6 +339,35 @@ def test_an_ignored_wake_also_drops_the_cards_wake_episode(board):
         assert board.execute(f"SELECT COUNT(*) FROM {table} WHERE task_id = ?", (tid,)).fetchone()[0] == 0
 
 
+@pytest.mark.parametrize("restored_before", [False, True])
+def test_a_probe_dropped_for_a_held_card_comes_back_when_the_hold_lifts(board, restored_before):
+    """Review of #2187 (nit 3): the held-card skip deletes the probe row and the restore lint skips a held card, so
+    a reopen reaching the log while the local row still reads ``scheduled`` under the same park must not leave the
+    card unwatched until its clock. With no ``RESTORED_EVENT`` after the park the lint re-registers the probe; with
+    one already there (the probe was lost and restored once before) it wakes the card instead."""
+    tid = _parked(board, wake_check="true")
+    if restored_before:
+        with kb.write_txn(board):
+            board.execute("DELETE FROM task_wake_checks WHERE task_id = ?", (tid,))
+        assert kwc.restore_missing_checks(board)["restored"] == [tid]
+    _stale_scheduled_copy_of_a_done_card(board, tid)
+    kwc.run_due_wake_checks(board, now=int(time.time()) + 10 ** 6, wait=True)
+    assert board.execute("SELECT COUNT(*) FROM task_wake_checks WHERE task_id = ?", (tid,)).fetchone()[0] == 0
+    assert kwc.restore_missing_checks(board) == {"restored": [], "woken": []}  # still held: stays gone
+    with kb.write_txn(board):
+        kb._append_event(board, tid, "reopened", {"reason": "the Board reopened it"})
+    assert ktg.terminal_hold(board, tid) is None and _status(board, tid) == "scheduled"
+    out = kwc.restore_missing_checks(board)
+    if restored_before:
+        assert out == {"restored": [], "woken": [tid]}
+        assert _status(board, tid) == "ready"
+        assert kwc.LOST_EVENT in _kinds(board, tid)
+    else:
+        assert out == {"restored": [tid], "woken": []}
+        assert board.execute("SELECT cmd FROM task_wake_checks WHERE task_id = ?", (tid,)).fetchone()[0] == "true"
+        assert _status(board, tid) == "scheduled"
+
+
 def test_an_implied_wake_on_a_stale_copy_of_a_completed_card_does_nothing(board):
     """A ``scheduled`` row with no park event (``_enforce_wake_invariant``'s implied wake)."""
     tid = kb.create_task(board, title="t", assignee="worker")
