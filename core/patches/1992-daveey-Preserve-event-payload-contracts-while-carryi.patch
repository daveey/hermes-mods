Date: Thu, 5 Nov 2026 03:32:03 +0000
Subject: [PATCH] [daveey] Preserve event payload contracts while carrying
 episode evidence

---
 hermes_cli/kanban_db_events.py                |   7 +-
 hermes_cli/kanban_wake_episode.py             |  39 ++++++-
 .../test_kanban_wake_episode_metadata.py      | 100 ++++++++++++++++++
 3 files changed, 141 insertions(+), 5 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_wake_episode_metadata.py

diff --git a/hermes_cli/kanban_db_events.py b/hermes_cli/kanban_db_events.py
index 4b1cdb4ea6a..8acf496ec3e 100644
--- a/hermes_cli/kanban_db_events.py
+++ b/hermes_cli/kanban_db_events.py
@@ -11,7 +11,12 @@ def append_event(conn: sqlite3.Connection, task_id: str, kind: str, payload: dic
     from hermes_cli.kanban_recovery_history import stamp
     from hermes_cli import kanban_wake_episode as episode
 
-    payload = episode.snapshot_event(conn, task_id, kind, payload)
+    payload, evidence = episode.snapshot_event(conn, task_id, kind, payload)
+    if evidence is not None:  # precedes the primary event, which stays the latest
+        cur = conn.execute("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, ?, ?, ?)", (
+            task_id, run_id, episode.EVIDENCE_EVENT, json.dumps(evidence), int(time.time())))
+        assert cur.lastrowid is not None
+        episode.consumed(conn, task_id, cur.lastrowid)
     stamped = stamp(conn, task_id, kind, payload, run_id)
     cur = conn.execute("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, ?, ?, ?)", (
         task_id, run_id, kind, json.dumps(stamped, ensure_ascii=False) if stamped else None, int(time.time())))
diff --git a/hermes_cli/kanban_wake_episode.py b/hermes_cli/kanban_wake_episode.py
index 0a61984847f..a5503ff72b9 100644
--- a/hermes_cli/kanban_wake_episode.py
+++ b/hermes_cli/kanban_wake_episode.py
@@ -39,12 +39,23 @@ def ensure_schema(conn: sqlite3.Connection) -> None:
         task_id TEXT PRIMARY KEY, event_id INTEGER NOT NULL)""")
     conn.execute("""CREATE TRIGGER IF NOT EXISTS task_wake_episode_seen_delete AFTER DELETE ON tasks
         BEGIN DELETE FROM task_wake_episode_seen WHERE task_id = OLD.id; END""")
+    # One reset is carried per corridor exit; re-entering the corridor re-arms it.
+    conn.execute("CREATE TABLE IF NOT EXISTS task_wake_episode_exit (task_id TEXT PRIMARY KEY)")
+    conn.execute("""CREATE TRIGGER IF NOT EXISTS task_wake_episode_exit_rearm
+        AFTER UPDATE OF status ON tasks
+        WHEN NEW.status IN ('scheduled', 'todo', 'ready', 'running', 'review')
+        BEGIN DELETE FROM task_wake_episode_exit WHERE task_id = NEW.id; END""")
+    conn.execute("""CREATE TRIGGER IF NOT EXISTS task_wake_episode_exit_delete AFTER DELETE ON tasks
+        BEGIN DELETE FROM task_wake_episode_exit WHERE task_id = OLD.id; END""")
 
 
 _SNAPSHOT = "_wake_episode_v1"
 _CARRY_EVENTS = frozenset({"scheduled", "continued", "continuation_woken", "wake_episode_started",
                            "wake_episode_reset", "condition_met"})
 _CORRIDOR = frozenset({"scheduled", "todo", "ready", "running", "review"})
+# Status-transition kinds whose own payload carries the corridor-exit reset.
+_EXIT_EVENTS = frozenset({"blocked", "gave_up", "timed_out", "completed", "archived"})
+EVIDENCE_EVENT = "wake_episode_evidence"
 
 
 def consumed(conn: sqlite3.Connection, task_id: str, event_id: int) -> None:
@@ -106,15 +117,35 @@ def _valid_snapshot(data: object) -> bool:
                  (type(data["last_stale_at"]) is int and data["last_stale_at"] >= data["first_at"])))
 
 
-def snapshot_event(conn: sqlite3.Connection, task_id: str, kind: str, payload: dict | None) -> dict | None:
-    """Carry lifecycle evidence; steady exit-1 checks do not append events."""
+def snapshot_event(conn: sqlite3.Connection, task_id: str, kind: str,
+                   payload: dict | None) -> tuple[dict | None, dict | None]:
+    """Return ``(payload, evidence)``; steady exit-1 checks do not append events.
+
+    Lifecycle events carry the snapshot in their own payload. Unrelated events and
+    probe-less parks keep their payload untouched: their evidence (a corridor-exit
+    reset or a cleared probe, still needed by peers whose episode this home never
+    observed) is returned separately for a ``wake_episode_evidence`` event.
+    """
     status = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
     outside = status is not None and status[0] not in _CORRIDOR
     if not outside and kind not in _CARRY_EVENTS and not kind.startswith("wake_"):
-        return payload
+        return payload, None
+    if outside and conn.execute("SELECT 1 FROM task_wake_episode_exit WHERE task_id = ?", (task_id,)).fetchone() \
+            and not conn.execute("SELECT 1 FROM task_wake_episodes WHERE task_id = ?", (task_id,)).fetchone():
+        return payload, None  # this exit's reset was already carried
+    snapshot = _snapshot(conn, task_id, kind, payload, outside)
+    separate = (kind in {"scheduled", "continued"} and not (payload or {}).get("wake_check")) or (
+        outside and kind not in _CARRY_EVENTS and kind not in _EXIT_EVENTS and not kind.startswith("wake_"))
+    if separate:
+        return payload, snapshot
+    return {**(payload or {}), **snapshot}, None
+
+
+def _snapshot(conn: sqlite3.Connection, task_id: str, kind: str, payload: dict | None, outside: bool) -> dict:
     reconcile(conn, task_id)
     if outside:
         reset(conn, task_id)
+        conn.execute("INSERT OR IGNORE INTO task_wake_episode_exit VALUES (?)", (task_id,))
     elif kind in {"scheduled", "continued"}:
         cmd = (payload or {}).get("wake_check")
         _change_probe(conn, task_id, cmd)
@@ -125,7 +156,7 @@ def snapshot_event(conn: sqlite3.Connection, task_id: str, kind: str, payload: d
         data = {"park_cmd": (payload or {}).get("wake_check")}
     # A null snapshot only resets a peer when it carries an unseen reset barrier;
     # an unobserved episode on the home is otherwise unknown, not evidence of success.
-    return {**(payload or {}), _SNAPSHOT: data, barriers.KEY: barriers.current(conn, task_id)}
+    return {_SNAPSHOT: data, barriers.KEY: barriers.current(conn, task_id)}
 
 
 def reset(conn: sqlite3.Connection, task_id: str) -> None:
diff --git a/tests/hermes_cli/test_kanban_wake_episode_metadata.py b/tests/hermes_cli/test_kanban_wake_episode_metadata.py
new file mode 100644
index 00000000000..ba7bb74e5ad
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_wake_episode_metadata.py
@@ -0,0 +1,100 @@
+"""Unrelated events keep their payloads; their reset evidence travels separately."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_wake_check as wc
+from hermes_cli import kanban_wake_episode as episode
+from tests.hermes_cli import test_kanban_wake_episode as base
+from tests.hermes_cli import test_kanban_wake_episode_carry as carry
+
+kanban_home = base.kanban_home
+parked = base.parked
+
+
+def _rows(conn, tid):
+    return [(r[0], json.loads(r[1]) if r[1] else None)
+            for r in conn.execute("SELECT kind, payload FROM task_events WHERE task_id = ? ORDER BY id", (tid,))]
+
+
+def test_unrelated_outside_event_is_clean_and_reset_still_reaches_unobserved_episode(parked):
+    conn, tid, clock = parked
+    home = carry.replica(conn)  # never observes the episode started below
+    try:
+        base.result(parked, 0)
+        assert wc.get_state(conn, tid)["episode_first_at"] == clock[0]
+        home.execute("UPDATE tasks SET status = 'done' WHERE id = ?", (tid,))  # direct/synced writer: no event
+        before = len(_rows(home, tid))
+        kb._append_event(home, tid, "workspace_archived", {"path": "/p"})
+        kb._append_event(home, tid, "commented", {"n": 2})
+        added = _rows(home, tid)[before:]
+        assert [k for k, _ in added] == [episode.EVIDENCE_EVENT, "workspace_archived", "commented"]
+        assert added[1][1] == {"path": "/p"} and added[2][1] == {"n": 2}
+        assert added[0][1]["_wake_episode_v1"] is None and added[0][1]["_wake_episode_barriers"]
+        carry.import_events(home, conn, tid)
+        episode.reconcile(conn, tid)
+        assert wc.get_state(conn, tid)["episode_first_at"] is None
+    finally:
+        home.close()
+
+
+def test_exit_rearms_after_reentering_corridor(parked):
+    conn, tid, _ = parked
+    for _ in range(2):
+        conn.execute("UPDATE tasks SET status = 'done' WHERE id = ?", (tid,))
+        kb._append_event(conn, tid, "commented")
+        conn.execute("UPDATE tasks SET status = 'ready' WHERE id = ?", (tid,))
+    assert [k for k, _ in _rows(conn, tid)].count(episode.EVIDENCE_EVENT) == 2
+
+
+@pytest.mark.parametrize("kind", ["blocked", "completed", "condition_met", "wake_check_stale"])
+def test_outside_lifecycle_evidence_remains_inline(parked, kind):
+    conn, tid, _ = parked
+    conn.execute("UPDATE tasks SET status = 'done' WHERE id = ?", (tid,))
+    before = len(_rows(conn, tid))
+    kb._append_event(conn, tid, kind, {"reason": "test"})
+    added = _rows(conn, tid)[before:]
+    assert len(added) == 1
+    assert added[0][0] == kind
+    assert added[0][1]["reason"] == "test"
+    assert added[0][1]["_wake_episode_v1"] is None
+    assert added[0][1]["_wake_episode_barriers"]
+
+
+def test_readopted_episode_outside_corridor_gets_fresh_reset(parked):
+    conn, tid, clock = parked
+    conn.execute("UPDATE tasks SET status = 'done' WHERE id = ?", (tid,))
+    kb._append_event(conn, tid, "commented")
+    first_barrier = episode.barriers.current(conn, tid)
+    # A delayed peer observation can be adopted after the exit was recorded.
+    snapshot = {"_wake_episode_v1": {"cmd": "false", "first_at": clock[0],
+                                   "checks": 1, "last_stale_at": None},
+                "_wake_episode_barriers": first_barrier}
+    episode._apply_snapshot(conn, tid, json.dumps(snapshot))
+    assert conn.execute("SELECT 1 FROM task_wake_episodes WHERE task_id = ?", (tid,)).fetchone()
+    before = len(_rows(conn, tid))
+    kb._append_event(conn, tid, "commented", {"n": 2})
+    assert not conn.execute("SELECT 1 FROM task_wake_episodes WHERE task_id = ?", (tid,)).fetchone()
+    added = _rows(conn, tid)[before:]
+    assert [k for k, _ in added] == [episode.EVIDENCE_EVENT, "commented"]
+    assert added[0][1]["_wake_episode_barriers"] != first_barrier
+
+
+def test_probe_less_park_keeps_payload_and_clears_peer_probe(parked):
+    conn, tid, _ = parked
+    home = carry.replica(conn)
+    try:
+        base.result(parked, 0)
+        home.execute("UPDATE tasks SET status = 'ready' WHERE id = ?", (tid,))
+        assert kb.claim_task(home, tid, claimer="worker") is not None
+        assert kb.schedule_task(home, tid, reason="SCHEDULED_UNTIL=2026-09-13T00:00:00Z soak", clock_only=True)
+        rows = _rows(home, tid)
+        scheduled = [p for k, p in rows if k == "scheduled"][-1]
+        assert "_wake_episode_v1" not in scheduled
+        assert rows[-2][0] == episode.EVIDENCE_EVENT and rows[-2][1]["_wake_episode_v1"] == {"park_cmd": None}
+        carry.import_events(home, conn, tid)
+        episode.reconcile(conn, tid)
+        assert wc.get_state(conn, tid)["episode_first_at"] is None
+    finally:
+        home.close()
