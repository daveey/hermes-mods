diff --git a/tests/hermes_cli/test_kanban_needs_you_contract.py b/tests/hermes_cli/test_kanban_needs_you_contract.py
new file mode 100644
index 0000000000..3c2c124851
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_needs_you_contract.py
@@ -0,0 +1,42 @@
+"""One attention contract for lane reasons and card presentation."""
+import json
+
+import pytest
+
+from hermes_cli.kanban_lanes_flow import classify_reason, classify_step
+
+
+HR = {'action': 'Choose a route', 'why_human': 'Only you know', 'interaction': 'reply',
+      'scope': 'This card', 'evidence': 'A choice is needed'}
+
+
+@pytest.mark.parametrize(('card', 'expected'), [
+    ({'status': 'blocked', 'block_kind': 'needs_input', 'human_request': HR}, True),
+    ({'status': 'triage', 'block_kind': 'capability', 'human_request': json.dumps(HR)}, True),
+    ({'status': 'blocked', 'block_kind': 'needs_input'}, False),
+    ({'status': 'scheduled', 'block_kind': 'capability'}, False),
+    ({'status': 'running', 'human_request': HR}, False),
+    ({'status': 'done', 'wait': {'wait_state': 'human'}}, False),
+    ({'status': 'blocked', 'human_request': {'action': 'incomplete'}}, False),
+    ({'status': 'blocked', 'stale': True, 'human_request': HR}, False),
+    ({'status': 'scheduled', 'wait': {'wait_state': 'human', 'owner_step': 'Connect device'}}, True),
+    ({'status': 'scheduled', 'events': [{'kind': 'scheduled', 'payload': {
+        'wake_check': 'python3 /example/probe_phone_available.py'}}]}, True),
+    ({'status': 'scheduled', 'events': [{'kind': 'scheduled', 'payload': {
+        'wake_check': 'python3 /example/passive_turn_capture.py'}}]}, False),
+])
+def test_needs_you_contract(card, expected):
+    from hermes_cli.kanban_open_asks import needs_you
+
+    assert needs_you(card) is expected
+    assert (classify_reason(card, classify_step(card)) == 'you') is expected
+
+
+def test_blocked_to_scheduled_drops_stale_kind():
+    from hermes_cli.kanban_open_asks import needs_you
+
+    card = {'status': 'blocked', 'block_kind': 'capability', 'human_request': HR}
+    assert needs_you(card)
+    card.update(status='scheduled', human_request=None)
+    assert not needs_you(card)
+    assert classify_reason(card, 'waiting') == 'time'
diff --git a/website/docs/developer-guide/plugins/kanban-validation.md b/website/docs/developer-guide/plugins/kanban-validation.md
index 3aa691ca76..077abdeb47 100644
--- a/website/docs/developer-guide/plugins/kanban-validation.md
+++ b/website/docs/developer-guide/plugins/kanban-validation.md
@@ -43,3 +43,16 @@ request-error response; these helpers introduce no new wire protocol.
 Publication is intentionally name-scoped. `effective_selector`, `routing_view`
 and whole-module imports remain private, and the boundary-lint baseline is not
 relaxed by this API extension.
+
+## Read-only attention predicate
+
+`hermes_cli.kanban_open_asks:needs_you(card)` returns a boolean for the current
+card snapshot. Pass a dictionary with `status`, `block_kind`, `human_request`
+(decoded object or stored JSON), and optional projected `wait`, `wakes`, `stale`
+and ordered `events`. It rejects terminal/running/stale cards and incomplete
+human requests; a historical `block_kind` is never enough. Current projected
+human waits and bounded legacy scheduled device-access probes also count as
+attention. The result is presentation only: it does not create consent, revive
+a retired canonical request, authorize execution or mutate a card. Lanes and
+session-pane card rendering use this same predicate. Other module names remain
+private.
