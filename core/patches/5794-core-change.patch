From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 15:23:48 +0000
Subject: [PATCH] Close capture-site inventory gaps found in review

Resolve interpolated table names, gate unresolved dynamic-table statements
(kanban_db_recover salvage/backup-fill copy custody rows and are recovery-ambiguous),
scan scripts/, pin statement counts per site, cache the scan. Certifies nothing.
---
 hermes_cli/kanban_sync_capture_sites.py       |  43 +++++-
 .../test_kanban_sync_capture_sites.py         | 143 +++++++++++++++---
 2 files changed, 162 insertions(+), 24 deletions(-)

diff --git a/hermes_cli/kanban_sync_capture_sites.py b/hermes_cli/kanban_sync_capture_sites.py
index f1398fed6c..4638eadc69 100644
--- a/hermes_cli/kanban_sync_capture_sites.py
+++ b/hermes_cli/kanban_sync_capture_sites.py
@@ -32,9 +32,12 @@ REMOVAL = "removal"
 # Installs the immutability / taint guards themselves.
 GUARD_INSTALL = "guard_install"
 
+# Dynamic-table statement audited as unable to name either custody table (fixed table tuple / other store).
+NOT_CUSTODY = "not_custody"
+
 DISPOSITIONS = frozenset({
     ORIGINAL_CANDIDATE, RECOVERY_AMBIGUOUS, SYNTHETIC_UNKNOWN, IDENTITY_ROTATION,
-    WIRE_FREEZE, STATE_ONLY, REMOVAL, GUARD_INSTALL,
+    WIRE_FREEZE, STATE_ONLY, REMOVAL, GUARD_INSTALL, NOT_CUSTODY,
 })
 
 _O = "kanban_sync_outbox"
@@ -87,7 +90,45 @@ SITES: dict[tuple[str, str, str, str], str] = {
     ("kanban_sync_envelope.py", "prune_parents", "DELETE", _P): REMOVAL,
     ("kanban_sync_envelope.py", "retire_parent", "DELETE", _P): REMOVAL,
     ("kanban_sync_rejections.py", "resolve_rejections", "DELETE", _O): REMOVAL,
+    # -- a fixture generator, not a production writer (scripts/ is scanned so it cannot be forgotten)
+    ("gen_source_receipt_fixture.py", "_running", "DELETE", _O): REMOVAL,
     # -- the guards themselves -------------------------------------------------------------------------
     ("kanban_sync_capture_storage.py", "install", "UPDATE", _O): GUARD_INSTALL,
     ("kanban_sync_capture_storage.py", "install", "UPDATE", _P): GUARD_INSTALL,
 }
+
+# Sites whose key legitimately covers several statements; any other key is exactly one statement, so a new
+# statement inside an already-listed function fails the gate until it is audited here.
+SITE_COUNTS: dict[tuple[str, str, str, str], int] = {
+    ("kanban_actionability_transport.py", "record_result", "UPDATE", _O): 2,
+    ("kanban_retain_transport.py", "record_result", "UPDATE", _O): 2,
+    ("kanban_sync_client.py", "push", "UPDATE", _O): 3,
+    ("kanban_sync_divergence.py", "repair_divergence", "INSERT", _O): 2,
+}
+
+# Statements whose table is a parameter or loop variable, so they could reach a custody table without naming it.
+# (file, function, verb, "<dynamic-table>") -> (disposition, can_reach_custody_tables)
+_D = "<dynamic-table>"
+DYNAMIC_SITES: dict[tuple[str, str, str, str], tuple[str, bool]] = {
+    # Rebuild/salvage copies every table row, provenance columns included, into the replacement Board file:
+    # whatever it copies must be treated ambiguous by the capture slice, never carried as 'original'.
+    ("kanban_db_recover.py", "_salvage_table", "INSERT", _D): (RECOVERY_AMBIGUOUS, True),
+    ("kanban_db_recover.py", "_fill_from_backup", "INSERT", _D): (RECOVERY_AMBIGUOUS, True),
+    # Fixed tuples of synced domain tables / own bookkeeping tables; neither custody table is in any of them.
+    ("flaky_intake.py", "_initialize", "UPDATE", _D): (NOT_CUSTODY, False),
+    ("kanban_candidate_receipts.py", "persist", "DELETE", _D): (NOT_CUSTODY, False),
+    ("kanban_containment_connections.py", "bootstrap", "UPDATE", _D): (NOT_CUSTODY, False),
+    ("kanban_db.py", "_delete_task_relations", "DELETE", _D): (NOT_CUSTODY, False),
+    ("kanban_db_connect.py", "_rebuild_drifted_tables", "INSERT", _D): (NOT_CUSTODY, False),
+    ("kanban_db_sync.py", "_delete_row", "DELETE", _D): (NOT_CUSTODY, False),
+    ("kanban_db_sync.py", "_insert_trigger", "UPDATE", _D): (NOT_CUSTODY, False),
+    ("kanban_db_sync.py", "_upsert_row", "INSERT", _D): (NOT_CUSTODY, False),
+    ("kanban_db_sync.py", "_upsert_row", "UPDATE", _D): (NOT_CUSTODY, False),
+    ("kanban_db_sync.py", "install_or_remove", "UPDATE", _D): (NOT_CUSTODY, False),
+    ("kanban_db_sync.py", "repair_ms_timestamps", "UPDATE", _D): (NOT_CUSTODY, False),
+    ("kanban_llm_pacing_history.py", "record", "DELETE", _D): (NOT_CUSTODY, False),
+    ("kanban_scratch_custody_discovery.py", "discover", "INSERT", _D): (NOT_CUSTODY, False),
+    ("kanban_sync_quarantine.py", "adopt", "INSERT", _D): (NOT_CUSTODY, False),
+    ("kanban_sync_quarantine.py", "restore", "INSERT", _D): (NOT_CUSTODY, False),
+    ("kanban_worker_node.py", "_evict_one", "DELETE", _D): (NOT_CUSTODY, False),
+}
diff --git a/tests/hermes_cli/test_kanban_sync_capture_sites.py b/tests/hermes_cli/test_kanban_sync_capture_sites.py
index 79e93da4ad..da3be1b430 100644
--- a/tests/hermes_cli/test_kanban_sync_capture_sites.py
+++ b/tests/hermes_cli/test_kanban_sync_capture_sites.py
@@ -1,22 +1,37 @@
 """Gate: every pending-custody mutation site is audited (POST-COLLECTION-DESIGN section 8). [daveey]
 
-Static scan only: a new, moved or re-verbed INSERT/UPDATE/DELETE/REPLACE against the outbox or parent-
-envelope table must be classified in ``kanban_sync_capture_sites.SITES`` before it can land. Nothing here
-certifies a capture or activates replay fencing.
+Static scan only: a new, moved, re-verbed or additional INSERT/UPDATE/DELETE/REPLACE against the outbox or
+parent-envelope table must be classified in ``kanban_sync_capture_sites`` before it can land. Statements whose
+table name is interpolated are resolved through module-level string constants; an interpolation that cannot be
+resolved (a parameter such as ``table``) is a ``<dynamic-table>`` site and must be audited explicitly, because it
+can reach the custody tables without naming them. Dynamic statements are only scanned in
+``kanban*`` modules, ``scripts/`` or that name a custody table (the custody tables live only in the Board
+database, which only those modules open).
+Nothing here certifies a capture or activates replay fencing.
+
+Convention: like the other static guards that read source, this is a deliberate source-reading gate (it is the
+only way to prove an inventory is complete); it is cached so the tree is parsed once.
 """
 from __future__ import annotations
 
 import ast
+import functools
 import pathlib
 import re
 
 from hermes_cli import kanban_sync_capture_sites as inv
 
 REPO = pathlib.Path(__file__).resolve().parents[2]
-SCAN_DIRS = ("hermes_cli", "gateway", "plugins", "tools", "agent", "cron", "acp_adapter")
-PAT = re.compile(
-    r"\b(INSERT(?:\s+OR\s+\w+)?\s+INTO|REPLACE\s+INTO|UPDATE(?:\s+OR\s+\w+)?|DELETE\s+FROM)\s+"
-    r"(kanban_sync_outbox|kanban_sync_parent_envelopes)\b", re.IGNORECASE)
+SCAN_DIRS = ("hermes_cli", "gateway", "plugins", "tools", "agent", "cron", "acp_adapter", "scripts")
+CUSTODY = ("kanban_sync_outbox", "kanban_sync_parent_envelopes")
+VERB = r"(INSERT(?:\s+OR\s+\w+)?\s+INTO|REPLACE\s+INTO|UPDATE(?:\s+OR\s+\w+)?|DELETE\s+FROM)\s+"
+PAT = re.compile(r"\b" + VERB + r"(kanban_sync_outbox|kanban_sync_parent_envelopes)\b", re.IGNORECASE)
+# Any verb whose table is an unresolved interpolation / concatenation / placeholder (SQL is upper case here;
+# UPDATE must be followed by SET so log text such as "update {x}: ..." is not mistaken for SQL).
+DYN = re.compile(
+    r"\b(INSERT(?:\s+OR\s+\w+)?\s+INTO|REPLACE\s+INTO|DELETE\s+FROM)\s+(?:\{\?\}|%s)"
+    r"|\b(UPDATE(?:\s+OR\s+\w+)?)\s+(?:\{\?\}|%s)\s+SET\b")
+DYNAMIC = "<dynamic-table>"
 
 
 def _files():
@@ -27,25 +42,91 @@ def _files():
     yield from sorted(REPO.glob("*.py"))
 
 
-def _scan() -> dict[tuple[str, str, str, str], list[str]]:
-    found: dict[tuple[str, str, str, str], list[str]] = {}
+def _production():
     for path in _files():
         rel = path.relative_to(REPO)
-        if rel.parts[0] == "tests" or "__pycache__" in rel.parts:
-            continue
-        tree = ast.parse(path.read_text())
+        if rel.parts[0] != "tests" and "__pycache__" not in rel.parts:
+            yield path, rel
+
+
+def _constants(tree) -> dict[str, str]:
+    out = {}
+    for node in tree.body:
+        if isinstance(node, (ast.Assign, ast.AnnAssign)) and isinstance(node.value, ast.Constant) \
+                and isinstance(node.value.value, str):
+            for target in (node.targets if isinstance(node, ast.Assign) else [node.target]):
+                if isinstance(target, ast.Name):
+                    out[target.id] = node.value.value
+        elif isinstance(node, ast.Assign) and isinstance(node.value, ast.Tuple):  # A, B = "a", "b"
+            for target in node.targets:
+                if isinstance(target, ast.Tuple) and len(target.elts) == len(node.value.elts):
+                    for name, value in zip(target.elts, node.value.elts):
+                        if isinstance(name, ast.Name) and isinstance(value, ast.Constant) and isinstance(value.value, str):
+                            out[name.id] = value.value
+    return out
+
+
+@functools.cache
+def _scan() -> dict[tuple[str, str, str, str], list[str]]:
+    parsed = {}
+    for path, _ in _production():
+        text = path.read_text()
+        tree = ast.parse(text)
+        in_scope = path.name.startswith("kanban") or "scripts" in path.parts or any(t in text for t in CUSTODY)
+        parsed[path] = (tree, _constants(tree), in_scope)
+    global_consts: dict[str, set[str]] = {}
+    for _, consts, _ in parsed.values():
+        for name, value in consts.items():
+            global_consts.setdefault(name, set()).add(value)
+
+    def resolve(expr, local):
+        name = expr.id if isinstance(expr, ast.Name) else expr.attr if isinstance(expr, ast.Attribute) else None
+        if name is None:
+            return None
+        if name in local:
+            return local[name]
+        values = global_consts.get(name, set())
+        return next(iter(values)) if len(values) == 1 else None
+
+    found: dict[tuple[str, str, str, str], list[str]] = {}
+    for path, (tree, local, mentions_kanban) in parsed.items():
+
+        def record(owner, text, dynamic_ok):
+            text = " ".join(text.split())
+            for m in PAT.finditer(text):
+                verb = m.group(1).split()[0].upper()
+                verb = "INSERT" if verb == "REPLACE" else verb
+                found.setdefault((path.name, owner, verb, m.group(2).lower()), []).append(text[m.start():])
+            if dynamic_ok:
+                for m in DYN.finditer(text):
+                    verb = (m.group(1) or m.group(2)).split()[0].upper()
+                    verb = "INSERT" if verb == "REPLACE" else verb
+                    found.setdefault((path.name, owner, verb, DYNAMIC), []).append(text[m.start():])
 
         def visit(node, owner):
             for child in ast.iter_child_nodes(node):
                 if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)) and owner == "<module>":
                     visit(child, child.name)
                     continue
+                if isinstance(child, ast.JoinedStr):
+                    parts = []
+                    for value in child.values:
+                        if isinstance(value, ast.Constant):
+                            parts.append(str(value.value))
+                        else:
+                            resolved = resolve(value.value, local) if isinstance(value, ast.FormattedValue) else None
+                            parts.append(resolved if resolved is not None else "{?}")
+                    record(owner, "".join(parts), mentions_kanban)
+                    for value in child.values:
+                        if isinstance(value, ast.FormattedValue):
+                            visit(value, owner)
+                    continue
                 if isinstance(child, ast.Constant) and isinstance(child.value, str):
-                    text = " ".join(child.value.split())
-                    for m in PAT.finditer(text):
-                        verb = m.group(1).split()[0].upper()
-                        verb = "INSERT" if verb == "REPLACE" else verb
-                        found.setdefault((path.name, owner, verb, m.group(2).lower()), []).append(text[m.start():])
+                    record(owner, child.value, False)
+                elif isinstance(child, ast.BinOp) and isinstance(child.op, ast.Add) \
+                        and isinstance(child.left, ast.Constant) and isinstance(child.left.value, str):
+                    resolved = resolve(child.right, local)
+                    record(owner, child.left.value + (resolved if resolved is not None else "{?}"), mentions_kanban)
                 visit(child, owner)
 
         visit(tree, "<module>")
@@ -53,18 +134,35 @@ def _scan() -> dict[tuple[str, str, str, str], list[str]]:
 
 
 def test_inventory_is_complete_in_both_directions():
-    found = set(_scan())
+    found = {k for k in _scan() if k[3] != DYNAMIC}
     declared = set(inv.SITES)
     assert found - declared == set(), f"unaudited pending-custody mutation sites: {sorted(found - declared)}"
     assert declared - found == set(), f"stale inventory entries without a source site: {sorted(declared - found)}"
 
 
+def test_statement_counts_are_pinned_per_site():
+    """A new statement inside an already-listed function changes its count and must be re-audited."""
+    counts = {key: len(stmts) for key, stmts in _scan().items() if key[3] != DYNAMIC}
+    declared = {key: inv.SITE_COUNTS.get(key, 1) for key in inv.SITES}
+    assert counts == declared, {k: (counts.get(k), declared.get(k)) for k in set(counts) | set(declared)
+                                if counts.get(k) != declared.get(k)}
+
+
+def test_dynamic_table_statements_are_audited_and_recovery_copies_are_never_original():
+    dynamic = {k for k in _scan() if k[3] == DYNAMIC}
+    assert dynamic == set(inv.DYNAMIC_SITES), sorted(dynamic ^ set(inv.DYNAMIC_SITES))
+    for key, (disposition, reaches_custody) in inv.DYNAMIC_SITES.items():
+        assert disposition in inv.DISPOSITIONS, key
+        if reaches_custody:  # can write a custody table: a copy must never carry or mint 'original'
+            assert disposition == inv.RECOVERY_AMBIGUOUS, key
+
+
 def test_every_disposition_is_known():
     assert set(inv.SITES.values()) <= inv.DISPOSITIONS
 
 
 def test_no_two_modules_share_a_filename_so_site_keys_are_unambiguous():
-    names = [p.name for p in _files() if p.relative_to(REPO).parts[0] != "tests"]
+    names = [p.name for p, _ in _production()]
     dup = {n for n in names if names.count(n) > 1}
     scanned = {k[0] for k in _scan()}
     assert not (dup & scanned), f"ambiguous module names carrying sites: {sorted(dup & scanned)}"
@@ -87,7 +185,7 @@ def test_in_place_identity_mutation_is_classified_as_rotation():
     identity = re.compile(
         r"(?:^|,)\s*(op_id|created_at|fields|wire|wire_json|hlc|task_id|table_name|row_uid|op|base_version)\s*=", re.IGNORECASE)
     for key, statements in _scan().items():
-        if key[2] != "UPDATE" or key[1] == "install":  # the guard installer only taints
+        if key[2] != "UPDATE" or key[1] == "install" or key[3] == DYNAMIC:  # the guard installer only taints
             continue
         for text in statements:
             assigned = setter.search(text)
@@ -99,9 +197,8 @@ def test_in_place_identity_mutation_is_classified_as_rotation():
