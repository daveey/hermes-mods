From 92be0cd9f9274e894872a09fd2e9e399e4ad0244 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:04:42 +0000
Subject: [PATCH] [daveey] separate substitution quote frames before stripping
 comments

Move flat comment stripping and line continuation joining to the per-frame tokenizer. The prior ordering erased a quoted hash and its following executed command inside nested double-quoted substitutions.

Proof: reviewer real-Bash probes reproduce red on 86f3cd64; 46 importer files pass 3081 tests after fix. Full 30852-case shape corpus has zero violations and zero false refusals. Additional nested-case clean false positive is pre-existing and strictly xfailed under owner t_b7ab5fa6d6edc46d; original reviewer clean controls pass.
---
 cron/lifecycle_guard_tokens.py                |  4 +-
 ...t_lifecycle_guard_substitution_comments.py | 45 +++++++++++++++++++
 2 files changed, 48 insertions(+), 1 deletion(-)
 create mode 100644 tests/cron/test_lifecycle_guard_substitution_comments.py

diff --git a/cron/lifecycle_guard_tokens.py b/cron/lifecycle_guard_tokens.py
index a2f56415fd5d34e5873420208c5423e9e355c799..e7b4424cd22ec4d427a281ab0e7a11be7982d13e 100644
--- a/cron/lifecycle_guard_tokens.py
+++ b/cron/lifecycle_guard_tokens.py
@@ -28,7 +28,8 @@ def _iter_command_token_lists(command: str, *, _nesting: int = 0) -> Iterator[li
     of its own (``python3 -<f.py``), as in the shell."""
     if _nesting >= MAX_SUBSTITUTION_DEPTH:
         raise SubstitutionNestingLimit('substitution nesting limit reached')
-    command = strip_shell_comments(command).replace("\\\n", "")
+    # Separate nested quote frames before any flat comment/quote preprocessing.
+    # A quoted hash inside $(...) is data even inside an outer double quote.
     outer, bodies = separate_substitutions(command)
     for body in bodies:
         yield from _iter_command_token_lists(body, _nesting=_nesting + 1)
@@ -43,6 +44,7 @@ def _iter_command_token_lists(command: str, *, _nesting: int = 0) -> Iterator[li
 
 def _iter_plain_token_lists(command: str) -> Iterator[list[str]]:
     """Tokenize without evaluating or separating any expansion."""
+    command = strip_shell_comments(command).replace("\\\n", "")
     normalized = normalize_ansi_c_quotes(command)
     # Normalization helps shlex with Bash quoting, but must not erase evidence
     # recovered by the original physical-line fallback (the line splitter has
diff --git a/tests/cron/test_lifecycle_guard_substitution_comments.py b/tests/cron/test_lifecycle_guard_substitution_comments.py
new file mode 100644
index 0000000000000000000000000000000000000000..c10118167098091bac6d83495dd2e82f17b02b7a
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_substitution_comments.py
@@ -0,0 +1,45 @@
+"""Substitution quote frames must survive flat comment preprocessing."""
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+from cron.lifecycle_guard_tokens import _iter_command_token_lists
+from tests.cron.test_lifecycle_guard_fd_redirections import _bash_runs, _tree
+
+
+@pytest.mark.parametrize('body', [
+    'echo " # "; SCRIPT',
+    'printf " # "; SCRIPT',
+    'case x in x) echo " # ";; esac; SCRIPT',
+    'echo " # " >/dev/null; SCRIPT',
+])
+@pytest.mark.parametrize('wrapper', ['echo "$(BODY)"', 'echo "$(echo "$(BODY)")"'])
+@pytest.mark.parametrize('script', ['bash ./r.sh', 'bash 2>$(echo /dev/null) < ./r.sh'])
+@pytest.mark.parametrize('dangerous', [True, False])
+def test_nested_quote_comment_boundary(tmp_path, body, wrapper, script, dangerous, request):
+    # Existing quoted-output walker false positive, independent of tokenization.
+    if (not dangerous and body.startswith('case ') and wrapper.count('$(') == 2
+            and '2>' in script):
+        request.node.add_marker(pytest.mark.xfail(
+            strict=True, reason='t_b7ab5fa6d6edc46d: stderr output scanned as a script'))
+    _tree(tmp_path)
+    if not dangerous:
+        script = script.replace('bash', 'python3').replace('./r.sh', './clean.py')
+    command = wrapper.replace('BODY', body.replace('SCRIPT', script))
+    assert _bash_runs(tmp_path, command) is dangerous
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path))[0] is dangerous
+
+
+def test_separation_precedes_flat_comment_stripping():
+    command = 'echo "$(echo " # "; bash ./r.sh)"'
+    assert any('./r.sh' in words for words in _iter_command_token_lists(command))
+
+
+@pytest.mark.parametrize('command', [
+    '# $(bash ./r.sh)\npython3 ./clean.py',
+    'echo "$(echo ok # bash ./r.sh\n)"',
+    "echo '$(echo \" # \"; bash ./r.sh)'",
+])
+def test_inert_comment_and_single_quote_controls(tmp_path, command):
+    _tree(tmp_path)
+    assert not _bash_runs(tmp_path, command)
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
