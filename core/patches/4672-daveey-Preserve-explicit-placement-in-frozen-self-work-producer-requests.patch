From 99c4288981e3d6dda045e56a1ae5c41a31148aad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 00:48:34 +0000
Subject: [PATCH] [daveey] Preserve explicit placement in frozen self-work
 producer requests

Why: state sweep callers require worker placement and terminal/file capabilities. The v1 allowlist rejected them, and dropping them would silently change policy. Permit only these optional string-list fields, validate at prepare and advance with existing create semantics, and advertise additive placement capability without changing v1 replay or receiver authority.

Proof: focused RED 6 failed/30 passed; final canonical producer, receiver and CI receipt suites 100 passed. Seven exact-anchor mutants killed (prepare/validate calls, list/member shape, both existing validators, capability advertisement). Composed authenticated receiver reads back preserved create placement and unchanged owner placement after append; unsynced intake including explicit empty labels stays pending. No state activation or guard changes.
---
 docs/ci-flaky-intake.md                       | 42 +++++++-
 hermes_cli/kanban_selfwork_producer.py        | 25 ++++-
 .../test_kanban_selfwork_producer.py          | 99 ++++++++++++++++++-
 3 files changed, 156 insertions(+), 10 deletions(-)

diff --git a/docs/ci-flaky-intake.md b/docs/ci-flaky-intake.md
index 8b98c2d299d7c6eb552da9921ff57622c973ec8b..a8226bbe4674014014c407c8b74c96026786e662 100644
--- a/docs/ci-flaky-intake.md
+++ b/docs/ci-flaky-intake.md
@@ -18,10 +18,11 @@ Reusable state-adapter contract:
 1. Inspect `hermes kanban --help` for `selfwork-producer` before any submission.
    Absence (including pre-self-work runtimes) permits the old undeclared path only
    for work not already frozen. `hermes kanban selfwork-producer --operation capabilities`
-   returns `{"self_work_producer":1}`. A well-formed unsupported version likewise
+   returns `{"self_work_producer":1,"self_work_producer_placement":1}`. A well-formed unsupported version likewise
    permits the old path before submission; errors/malformed capability replies do not.
 2. `hermes kanban selfwork-producer --operation prepare --request-file -` accepts
-   JSON with exactly `title`, `body`, `assignee`, `idempotency_key`, and `self_work`.
+   JSON with required `title`, `body`, `assignee`, `idempotency_key`, and `self_work`,
+   plus optional `runs_on` and `requires` string lists. No other create fields are allowed.
    It performs no submission and returns `{version:1,sender,home,body,request_id}`.
    `home` is `{gateway,profile,board}`; `body.create` freezes those input fields,
    home board and tenant. Persist this entire snapshot atomically before step 3.
@@ -36,6 +37,43 @@ Reusable state-adapter contract:
    omit request_id. Exit 0 alone is not delivery. Never downgrade any attempted
    declared submission, regenerate it after midnight, or retry via local creation.
 
+Placement-aware adapters must require both integer capability values to be `1`
+(not booleans); the older `{"self_work_producer":1}` does not advertise placement.
+Only before preparation or any declared attempt may an adapter choose its legacy
+route for a well-formed unsupported capability reply. Once prepared, retain the
+snapshot and retry only `advance` on a compatible runtime; never strip placement,
+regenerate a request, or fall back after errors. Minimal v1 snapshots remain valid,
+and consumers not needing placement may continue checking just the base capability.
+
+The optional lists use existing create label/capability validation, including empty
+lists; null, scalar strings and non-string members are rejected. Preparation and
+snapshot validation do not normalize, sort, deduplicate or insert omitted fields.
+The trusted receiver still applies normal create normalization and placement gates:
+explicit labels (even `runs_on: []`) need a synced intake board and eligible
+capabilities, not merely a producer capability advertisement. That advertisement
+is local-runtime support, not a health check of the remote intake. Receiver create
+refusals may surface only as `self_work_dispatch_pending`; persistent pending needs
+operator diagnosis of the intake's sync/placement gates, never a legacy fallback.
+Do not re-prepare an existing key with changed placement: courier/intake replay
+binds the original payload. Normalize legacy comma-separated or JSON-list CLI
+syntax into a list before preparation, not inside a saved snapshot. Label whitespace
+is validated using create normalization but retained in the snapshot itself.
+Same-area append preserves the existing owner's
+placement and requirements; requested placement applies only to a newly created task.
+
+State adapters must also account for these existing consumer differences:
+
+- `created_by` is not caller authority: the authenticated gateway supplies it. Put
+  producer attribution in the body rather than forwarding a legacy `--created-by`.
+- The owner is the full gateway/profile/board/task tuple, not necessarily a local
+  default-board task. Local `show` or SQLite lookups are not cross-home readback.
+- Appends can return an owner with another idempotency key. A successful append
+  already includes the submitted body; do not send a second legacy comment.
+- Freeze each evidence batch and key before transport, and mark only that batch
+  consumed after a completed receipt. Pending is not success even with exit zero.
+- CLI `--runs-on` strings must be converted to the equivalent string list before
+  preparation. Keep caller-selected labels and `requires` intact.
+
 Completion requires a matching frozen envelope, terminal courier `done` state and
 an authoritative `self_work_accepted` owner receipt (`ok`, `handoff_complete` true,
 `ownership_pending` false, exact request ID and create/append consistency). Append
diff --git a/hermes_cli/kanban_selfwork_producer.py b/hermes_cli/kanban_selfwork_producer.py
index 18aecf3d4b7606ca1c9099df0afc767cc113d4cc..df66266e8253070b38c556472503a35f777c530f 100644
--- a/hermes_cli/kanban_selfwork_producer.py
+++ b/hermes_cli/kanban_selfwork_producer.py
@@ -15,7 +15,9 @@ from pathlib import Path
 
 from hermes_cli.kanban_selfwork import SelfWorkError, contract
 
-CAPABILITY = {'self_work_producer': 1}
+CAPABILITY = {'self_work_producer': 1, 'self_work_producer_placement': 1}
+_CREATE_FIELDS = {'title', 'body', 'idempotency_key', 'assignee', 'self_work'}
+_PLACEMENT_FIELDS = {'runs_on', 'requires'}
 _NAME = re.compile(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}\Z')
 
 
@@ -23,18 +25,34 @@ def _digest(value):
     return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
 
 
+def _validate_placement(create):
+    from hermes_cli.kanban_capabilities import _required_capabilities
+    from hermes_cli.kanban_worker_node import normalize_runs_on
+
+    for field in _PLACEMENT_FIELDS & create.keys():
+        value = create[field]
+        if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
+            raise SelfWorkError(f'producer {field} must be a string list')
+        # Validate with create semantics, but freeze the original bytes/order.
+        if field == 'runs_on':
+            normalize_runs_on(value)
+        else:
+            _required_capabilities(value, 'scratch')
+
+
 def prepare(create):
     """Freeze a declared, non-chat producer request without any external write."""
     from hermes_cli.kanban_selfwork_owner import _runtime
 
     if os.environ.get('HERMES_KANBAN_TASK') or os.environ.get('HERMES_KANBAN_WORKER_TASK'):
         raise SelfWorkError('headless producer cannot replace worker origin forwarding')
-    if not isinstance(create, dict) or set(create) - {'title', 'body', 'idempotency_key', 'assignee', 'self_work'}:
+    if not isinstance(create, dict) or set(create) - (_CREATE_FIELDS | _PLACEMENT_FIELDS):
         raise SelfWorkError('invalid producer create fields')
     if contract(create.get('self_work')) is None or not all(
         isinstance(create.get(k), str) and create[k].strip() for k in ('title', 'body', 'idempotency_key', 'assignee')
     ):
         raise SelfWorkError('producer requires declaration and nonempty create fields')
+    _validate_placement(create)
     config, sender, _, _ = _runtime()
     home = config.get('kanban', {}).get('self_work', {}).get('home')
     if (not isinstance(home, dict) or set(home) != {'gateway', 'profile', 'board'}
@@ -56,12 +74,13 @@ def validate(frozen):
             or not isinstance(body, dict) or set(body) != {'create'} or not isinstance(body['create'], dict)):
         raise SelfWorkError('invalid producer snapshot route')
     create = body['create']
-    if (set(create) != {'title', 'body', 'idempotency_key', 'assignee', 'self_work', 'board', 'tenant'}
+    if (set(create) - _PLACEMENT_FIELDS != _CREATE_FIELDS | {'board', 'tenant'}
             or create['board'] != home['board'] or contract(create['self_work']) is None
             or not all(isinstance(create[k], str) and create[k].strip()
                        for k in ('title', 'body', 'idempotency_key', 'assignee'))
             or frozen['request_id'] != 'sw-' + _digest({'sender': sender, 'home': home, 'key': create['idempotency_key']})):
         raise SelfWorkError('invalid producer snapshot payload')
+    _validate_placement(create)
 
 
 def receipt(frozen, row):
