             'self_work': {'version': 1, 'repository': 'hermes-core', 'area': 'ci', 'kind': 'ci-flake'}}
 
 
-def test_composed_cli_owner_create_append_and_replay(request_envelope, tmp_path, monkeypatch, capsys):
