From de73f0ccc17108eb3ff32df9f957ced2683e865c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:30:08 +0000
Subject: [PATCH] [daveey] perf(kanban): shorter completion_receipt
 TEXT_PATTERN; document its schema cost

PR #2031 review nit: the pattern repeats on 15 completion_receipt fields of
KANBAN_COMPLETE_SCHEMA, paid on every worker request. The nonblank class now
folds control, tab, newline and space into one \x00-\x20 range (same set; the
BMP-wide equivalence test still passes). Pattern 132 -> 115 chars; schema
json.dumps 11208 -> 10878 bytes. $defs/$ref is not used: Gemini's legacy
`parameters` translator drops $ref (field loses its type) and Google rejects
reference indirection. The note sits next to TEXT_PATTERN; a test caps its length.
---
 hermes_completion_receipt.py                       | 8 ++++++--
 tests/tools/test_kanban_complete_receipt_schema.py | 3 +++
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/hermes_completion_receipt.py b/hermes_completion_receipt.py
index bd65c5c95c..33f95a962a 100644
--- a/hermes_completion_receipt.py
+++ b/hermes_completion_receipt.py
@@ -28,9 +28,13 @@ OPERATOR_DELIVERY_TEXT_MAX = 128
 # Every _text field: no C0 control but tab/newline, and not all str.isspace() (what strip() removes). One regex both
 # _text and the advertised JSON-schema `pattern` (tools/kanban_tools_schemas.py) read, so they cannot drift; anchors,
 # character classes and \x/\u escapes only, valid in Python re, ECMA-262 and llama.cpp's grammar converter.
+# Cost: the schema repeats it on 15 fields (~2.3 KB of KANBAN_COMPLETE_SCHEMA, sent on every worker request), so
+# keep it short: the nonblank class folds _CONTROL, tab, newline and space into one \x00-\x20 range. A shared
+# `$defs` + `$ref` would send it once, but Gemini's legacy `parameters` translator drops `$ref` (the field loses
+# its type) and Google rejects reference indirection, so every field carries the pattern inline.
 _CONTROL = "\\x00-\\x08\\x0b-\\x1f"
-_BLANK = "\\t\\n\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000"  # isspace() minus _CONTROL
-TEXT_PATTERN = f"^[^{_CONTROL}]*[^{_CONTROL}{_BLANK}][^{_CONTROL}]*$"
+_SPACE = "\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000"  # isspace() above \x20
+TEXT_PATTERN = f"^[^{_CONTROL}]*[^\\x00-\\x20{_SPACE}][^{_CONTROL}]*$"
 _TEXT = re.compile(TEXT_PATTERN)
 _CONTROL_CHAR = re.compile(f"[{_CONTROL}]")
 _QUALIFIED_OWNER = re.compile(r"@(task|session):[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+/[^\s/@]+\Z")
diff --git a/tests/tools/test_kanban_complete_receipt_schema.py b/tests/tools/test_kanban_complete_receipt_schema.py
index dc69181677..e5e0e68cbb 100644
--- a/tests/tools/test_kanban_complete_receipt_schema.py
+++ b/tests/tools/test_kanban_complete_receipt_schema.py
@@ -169,6 +169,9 @@ def test_text_pattern_is_exactly_the_writers_text_rule():
     # for every BMP character, alone and padded, so the advertised pattern is the writer's real rule.
     import re
 
+    # PR #2031 review nit: the schema repeats the pattern on 15 fields of every worker request (the cost note at
+    # TEXT_PATTERN); the nonblank class folds control, tab, newline and space into one range. Don't regrow it.
+    assert len(hcr.TEXT_PATTERN) <= 115, len(hcr.TEXT_PATTERN)
     rule = re.compile(hcr.TEXT_PATTERN)
     for code in range(0x10000):
         c = chr(code)
-- 
