From a40c42f452f9ded6b8b40214e1f29e23f8d17007 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:02:28 +0000
Subject: [PATCH] [daveey] kanban task change: a rowid table, not WITHOUT ROWID
 (CI: remote-lease every-table snapshots)

Generic every-table readers (the remote-lease tests' SELECT * ... ORDER BY rowid
snapshot, recovery scans) expect a rowid on every board table; the WITHOUT ROWID
kanban_task_change table broke 52 remote-lease tests on PR #2660 CI.
RED: the new rowid test and 6 remote-lease assignee tests fail on ed14e4d22b; GREEN 135/135 across
task_change, schema_owner, activity_revision and the three remote-lease files.
---
 hermes_cli/kanban_activity_revision.py      | 4 +++-
 tests/hermes_cli/test_kanban_task_change.py | 9 +++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_activity_revision.py b/hermes_cli/kanban_activity_revision.py
index 6aec0ca285..e63d7cc596 100644
--- a/hermes_cli/kanban_activity_revision.py
+++ b/hermes_cli/kanban_activity_revision.py
@@ -82,8 +82,10 @@ _EPOCH_RE = re.compile(r"/\* kanban-activity-epoch:(\d+) \*/")
 # The task(s) a row belongs to. Every other watched table names it in ``task_id``.
 TASK_KEYS: dict[str, tuple[str, ...]] = {"tasks": ("id",), "task_links": ("parent_id", "child_id")}
 CHANGE_INDEX = f"idx_{CHANGE_TABLE}_rev"
+# A rowid table, not WITHOUT ROWID: generic every-table readers (``SELECT * ... ORDER BY rowid`` snapshots, recovery
+# scans) expect a rowid on every board table, and the cost difference on a one-row-per-task table is noise.
 _CHANGE_DDL = (f"CREATE TABLE IF NOT EXISTS {CHANGE_TABLE} (task_id TEXT PRIMARY KEY NOT NULL, "
-               "rev INTEGER NOT NULL) WITHOUT ROWID",
+               "rev INTEGER NOT NULL)",
                f"CREATE INDEX IF NOT EXISTS {CHANGE_INDEX} ON {CHANGE_TABLE}(rev)")
 
 
diff --git a/tests/hermes_cli/test_kanban_task_change.py b/tests/hermes_cli/test_kanban_task_change.py
index c6ff657ad0..97def09b48 100644
--- a/tests/hermes_cli/test_kanban_task_change.py
+++ b/tests/hermes_cli/test_kanban_task_change.py
@@ -360,6 +360,15 @@ def test_a_missing_change_table_reads_full_and_init_repairs_it(board):
     assert first is FULL and fresh is not None
 
 
+def test_the_change_table_has_a_rowid_like_every_board_table(board, shadow):
+    """Generic every-table readers (``SELECT * FROM t ORDER BY rowid`` snapshots in the remote-lease tests, recovery
+    scans) must keep working on boards and shadows once the change table exists."""
+    tid = kb.create_task(board, title="a", assignee="w")
+    for conn in (board, shadow):
+        rows = conn.execute(f"SELECT rowid, task_id FROM {rev.CHANGE_TABLE} ORDER BY rowid").fetchall()
+        assert conn is shadow or tid in [r[1] for r in rows]
+
+
 def test_ensure_revision_repairs_a_dropped_change_index(board):
     with kbc.write_txn(board):
         board.execute(f"DROP INDEX {rev.CHANGE_INDEX}")
