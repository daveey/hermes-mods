From dbaa39c2fd303ad94a2531a7188ad4285d10c9ce Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:54:28 +0000
Subject: [PATCH] [daveey] update-pause: doc nits from #1953 review 5887837308
 (t_01a1d3e8eca6917d)

- conversation_loop: the pause_before_turn early return skips everything after the
  turn body (stamping, settle_held_final, _close_durable_failed_turn), not only stamping.
- test comment: the is-False assert rules out 0/falsy values; the == check already rejects None.
- update_pause docstring: 'after MAX_PAUSES windows', not 'after three windows'.

Comments/docstrings only.
---
 agent/conversation_loop.py                           | 2 +-
 tests/tui_gateway/test_update_pause_first_request.py | 2 +-
 tui_gateway/update_pause.py                          | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/agent/conversation_loop.py b/agent/conversation_loop.py
index 0426687f2b..0f9d9b25c4 100644
--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -1845,7 +1845,7 @@ def run_conversation(
     # Per-provider-response context accounting starts empty every turn (agent/context_usage.py).
     begin_turn_context_usage(agent)
     if (paused := pause_before_turn(agent, conversation_history)) is not None:  # [daveey] t_01a1d31bf400d56c
-        return paused  # never started: skips the boundary/user_intervened/context_usage stamping, transcript unchanged
+        return paused  # never started: skips everything after the turn body (stamps, settle, failed-turn close)
     # Images attached natively to this user turn stay visible to vision_analyze for the turn, so
     # it does not embed the same pixels a second time into the same request (#76411).
     with native_turn_images(user_message):
diff --git a/tests/tui_gateway/test_update_pause_first_request.py b/tests/tui_gateway/test_update_pause_first_request.py
index 62593fb101..61d967acd3 100644
--- a/tests/tui_gateway/test_update_pause_first_request.py
+++ b/tests/tui_gateway/test_update_pause_first_request.py
@@ -57,6 +57,6 @@ def test_a_continuation_turn_may_yield_before_its_first_request(home):
 @pytest.mark.parametrize("kind", [None, "kanban_notice", "process_complete"])
 def test_any_other_turn_waits_for_a_real_step_boundary(home, kind):
     seen, agent = _submit(home, display_kind=kind)
-    assert seen[0][0] is False  # set to a literal False, not left unset (None)
+    assert seen[0][0] is False  # a literal False, not 0 or another falsy value (== below rejects None)
     assert seen == [(False, True)]
     assert agent.update_pause_first_request is False
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index 929a9f4b3c..2b0047c048 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -11,7 +11,7 @@ crash-resume attempt is used. After ``MAX_PAUSES`` checkpoints, a failed window
 the turn while its drainer holds ``cache/core-update/drain.lock``: it stays idle for the next window.
 The threshold bounds no-progress continuations, never the checkpoint needed to let the update apply.
 A continuation's pre-turn and pre-first-request pauses (t_01a1d31bf400d56c) make no progress yet count toward
-``MAX_PAUSES`` like any other: after three windows released without an apply the turn parks between windows
+``MAX_PAUSES`` like any other: after ``MAX_PAUSES`` windows released without an apply the turn parks between windows
 (``drain_retry_pending``, at most ``PARK_MAX_S``) without having taken a step. That is the intended bound: a
 window that cannot apply should not keep re-running the same request.
 
