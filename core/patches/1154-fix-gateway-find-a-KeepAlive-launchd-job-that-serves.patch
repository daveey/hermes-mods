 hermes_cli/gateway_runtime_service.py         |  62 +++++++
 hermes_cli/gateway_runtime_start.py           |  16 ++
 .../test_gateway_runtime_custom_launchd.py    | 164 ++++++++++++++++++
 .../hermes_cli/test_gateway_start_refused.py  |  39 +++++
 5 files changed, 317 insertions(+)
 create mode 100644 tests/hermes_cli/test_gateway_runtime_custom_launchd.py

diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index 8409b3a35b7..c9b5a2b4b57 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -27,6 +27,41 @@ def _start_deferred_state_db_integrity_check(evidence: dict) -> None:
 # Log-record parity with the origin module.
 logger = logging.getLogger("gateway.run")
 
+
+def _hand_home_back_to_supervisor(existing_pid: int) -> None:
+    """[daveey] A supervised start refused by a MANUAL owner of this home asks that owner to drain.
+
+    gateway-e2cd786685: during a KeepAlive job's restart gap a client spawned an unmanaged gateway for
+    the job's home (it has no idle exit), and every supervised restart after that was refused by it,
+    forever. This start still refuses (exit 1, the supervisor's normal retry); it only writes the
+    owner's planned-stop marker, which the owner's own watcher turns into a graceful drain, so the
+    supervisor's next restart finds the home free. Only when this process runs for an external
+    supervisor (``--external-supervisor``) and the owner itself answers ``identify`` with this pid and
+    ``launch_supervisor == "manual"``: a supervised owner (an old copy still draining, gateway-cc28b19bca),
+    a Desktop-managed one, or one that does not answer is never asked to stop.
+    """
+    import sys
+    if "--external-supervisor" not in sys.argv[1:]:
+        return
+    try:
+        from gateway.control_socket import identify_gateway, launch_supervisor
+        from gateway.run import get_hermes_home
+        identity = identify_gateway(get_hermes_home()) or {}
+        if identity.get("pid") != existing_pid or launch_supervisor(identity) != "manual":
+            return
+        from gateway.status import write_planned_stop_marker
+        if not write_planned_stop_marker(existing_pid):
+            return
+    except Exception:  # health: allow BLE001 -- the handback is best-effort; the refusal stands either way
+        logger.debug("Supervisor handback for PID %d failed", existing_pid, exc_info=True)
+        return
+    logger.warning("Asked the unsupervised gateway (PID %d) holding this home to drain so its "
+                   "supervisor can take over; the supervisor's next restart starts here.", existing_pid)
+    from gateway.run_exit_reason import last_start_refusal
+    refusal = last_start_refusal()
+    if refusal is not None:
+        refusal["handback"] = "planned_stop_requested"
+
 async def _start_gateway_replace_existing_instance(existing_pid: int, replace: bool) -> bool:
     """Handle a live gateway PID under this HERMES_HOME: replace it (``--replace``) or refuse.
     Returns False when startup must abort (refused, permission denied, target still alive)."""
@@ -47,6 +82,7 @@ async def _start_gateway_replace_existing_instance(existing_pid: int, replace: b
             f"   Or stop it first:    hermes gateway stop\n")
         from gateway.run_exit_reason import note_start_refused
         note_start_refused("already_running", owner_pid=existing_pid)
+        _hand_home_back_to_supervisor(existing_pid)
         return False
 
     # Never signal a process not provably ours (a poisoned PID record → cross-profile restart loop).
diff --git a/hermes_cli/gateway_runtime_service.py b/hermes_cli/gateway_runtime_service.py
index 794b054271f..59e69475317 100644
--- a/hermes_cli/gateway_runtime_service.py
+++ b/hermes_cli/gateway_runtime_service.py
@@ -215,6 +215,68 @@ def _launchd(home: Path, deadline: float) -> ExistingService | None:
         _verify_binding(verify_launchd_plist, definition, label, home)
         # Load ONLY the existing file, never bootout/rewrite or kickstart -k.
         return ExistingService("launchd", ("launchctl", "bootstrap", domains[0], str(plist)))
+    return _custom_launchd_job(home.resolve(), account_home / "Library/LaunchAgents", domains[0], deadline)
+
+
+# Trailing ``gateway run`` flags a supervised job may carry; anything else is not a plain gateway run.
+_CUSTOM_JOB_RUN_FLAGS = frozenset({"--quiet", "--external-supervisor", "--replace"})
+
+
+def _custom_job_runs_gateway_for(argv: list, home: Path) -> bool:
+    """``argv`` ends in ``<hermes | -m hermes_cli.main> [--profile X] gateway run [flags]``, optionally behind
+    a launcher wrapper; any ``--home`` the wrapper names must be this home too."""
+    if not argv or not all(isinstance(arg, str) for arg in argv):
+        return False
+    for index, arg in enumerate(argv):
+        if arg == "--home" and index + 1 < len(argv):
+            if Path(argv[index + 1]).expanduser().resolve() != home:
+                return False
+    starts = [i for i in range(len(argv) - 1) if argv[i] == "gateway" and argv[i + 1] == "run"]
+    if len(starts) != 1 or not set(argv[starts[0] + 2:]) <= _CUSTOM_JOB_RUN_FLAGS:
+        return False
+    before = argv[:starts[0]]
+    if len(before) >= 2 and before[-2] in {"--profile", "-p"}:
+        before = before[:-2]
+    entry = before[-1] if before else ""
+    return entry == "hermes_cli.main" or Path(entry).name in {"hermes", "hermes.exe"}
+
+
+def _custom_launchd_job(home: Path, agents: Path, domain: str, deadline: float) -> ExistingService | None:
+    """[daveey] A KeepAlive LaunchAgent that serves THIS home under a label Hermes did not install.
+
+    Hosts that supervise a gateway themselves (the mini: ``com.example.myapp.hermes`` pins
+    ``HERMES_HOME`` and runs ``gateway run --external-supervisor`` under a launcher) have no
+    ``ai.hermes.gateway*`` job, so this probe used to answer "no service" and the client spawned an
+    unmanaged gateway inside the job's restart gap. That spawn has no idle exit, so it held the home and
+    every KeepAlive restart was refused forever (self-heal defect gateway-e2cd786685). Matched exactly:
+    the plist's ``HERMES_HOME`` resolves to this home (a profile under it is another home), KeepAlive is
+    on, the job is not Disabled, it runs ``gateway run``, and it is loaded in the gui domain. The result
+    is a plain ``kickstart`` (start it if stopped), never ``-k``, ``bootstrap`` or a plist rewrite."""
+    from hermes_cli.gateway_runtime_service_identity import read_definition
+    try:
+        plists = sorted(agents.glob("*.plist"))
+    except OSError:
+        return None
+    for plist in plists:
+        try:
+            definition = plistlib.loads(read_definition(plist))
+        except (OSError, ValueError, ExpatError, plistlib.InvalidFileException):
+            continue  # an unreadable agent cannot be shown to serve this home
+        if not isinstance(definition, dict) or definition.get("Disabled") or not definition.get("KeepAlive"):
+            continue
+        label, env = definition.get("Label"), definition.get("EnvironmentVariables")
+        configured = env.get("HERMES_HOME") if isinstance(env, dict) else None
+        if not isinstance(label, str) or not label or not isinstance(configured, str) or not configured:
+            continue
+        if not Path(configured).is_absolute() or Path(configured).expanduser().resolve() != home:
+            continue
+        if not _custom_job_runs_gateway_for(definition.get("ProgramArguments") or [], home):
+            continue
+        result = _run(["launchctl", "print", f"{domain}/{label}"], deadline)
+        if result.returncode != 0:
+            continue  # installed but not loaded: launchd is not supervising it now
+        return ExistingService("launchd", ("launchctl", "kickstart", f"{domain}/{label}"),
+                               "state = running" in result.stdout)
     return None
 
 
