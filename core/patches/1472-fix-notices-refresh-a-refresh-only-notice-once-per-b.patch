From 5cc5c31b2c6f66ee2774dbaecde1580997b3e26e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:05:04 -0700
Subject: [PATCH] fix(notices): refresh a refresh-only notice once per backend,
 not every sweeper pass [daveey]

The unloaded sweeper's notice guarantee runs every 30 s in every Desktop backend. A notice about a card
blocked on a human (or a chat whose close-out budget is spent) only refreshes the chat's outcome and is
deliberately left unstamped, so it stays a candidate and was re-derived on every pass forever. On developer-laptop
a read-only replay found 35 such chats costing ~1.3 CPU-s of derive_outcome per pass per backend, with
stored outcomes unchanged for 2.4-55 h; native sampling put kanban-unloaded-sweeper at ~3.4-3.7% of a core
in each of three backends with no turn work.

Each backend now records (store, session, notice row, branch) after a successful refresh and skips the
repeat ("skipped:refreshed"). The memo is pruned to the current candidates after each complete pass; a
failed refresh retries; a new notice row, a supersede, a freed budget, or a card move (card_change_pass)
still act as before. No TTL: every input change has its own refresh trigger.

Why it wasn't caught: tests ran guarantee_pass once per scenario; none asserted the steady state of a
second pass for refresh-only branches. Five new tests cover repeat passes (human, budget), new rows,
failed-refresh retry and supersede-after-refresh. Card example-investigation.
---
 tests/tui_gateway/test_notice_guarantee.py | 96 ++++++++++++++++++++++
 tui_gateway/notice_guarantee.py            | 49 +++++++++--
 2 files changed, 136 insertions(+), 9 deletions(-)

diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
index 1de7d4ca1b..7a86ae1d3e 100644
--- a/tests/tui_gateway/test_notice_guarantee.py
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -27,6 +27,7 @@ HUMAN = {"action": "Reply ship or hold here. Unblock = deploy; archive = drop it
 def db(tmp_path):
     so._reset_hooks_for_tests()
     ksa._reset_cache_for_tests()
+    getattr(ng, "_reset_refreshed_for_tests", lambda: None)()  # per-backend refresh memo
     handle = SessionDB(tmp_path / "state.db")
     handle.create_session(CHAT, "desktop")
     handle.append_message(CHAT, "user", "run the deploy card")
@@ -223,3 +224,98 @@ def test_a_blocked_notice_whose_card_is_still_blocked_by_an_agent_still_gets_a_c
     out, calls = _run(db)
 
     assert calls == [(CHAT, row)] and [o["result"] for o in out] == ["dispatched"]
+
+
+# Repeat passes (residual idle CPU, example-investigation): every backend runs this pass every 30 s. A notice that
+# only refreshes (blocked on a human, or a spent budget) stays a candidate, so before this fix each pass re-derived
+# the same chats' outcomes forever: 35 such chats on developer-laptop cost ~1.3 CPU-s per pass per backend with no state
+# change. A notice row's refresh is now done once per backend; a card move (card_change_pass) or a new message
+# (new candidate row) still refreshes, and a refresh that failed retries on the next pass. [daveey]
+
+def _count_refreshes(monkeypatch):
+    calls = []
+    real = so.refresh_outcomes_quietly
+
+    def counting(sids, trigger, *, db=None):
+        calls.append((list(sids), trigger))
+        return real(sids, trigger, db=db)
+    monkeypatch.setattr(so, "refresh_outcomes_quietly", counting)
+    return calls
+
+
+def test_a_human_notice_is_refreshed_once_not_on_every_pass(db, monkeypatch):
+    tid = _decision_card()
+    _notice(db, f"⏸ Kanban {tid} blocked: needs approval — prod deploy", task_id=tid)
+    ksa._reset_cache_for_tests()
+    refreshes = _count_refreshes(monkeypatch)
+
+    first, _ = _run(db)
+    second, calls = _run(db)
+    third, _ = _run(db)
+
+    assert [o["result"] for o in first] == ["refreshed:human"]
+    assert [o["result"] for o in second] == [o["result"] for o in third] == ["skipped:refreshed"]
+    assert calls == [] and len(refreshes) == 1
+    assert so.get_outcome(CHAT, db=db)["kind"] == "decision"
+
+
+def test_a_spent_budget_notice_is_refreshed_once_not_on_every_pass(db, monkeypatch):
+    for n in range(ng.WAKES_PER_HOUR):
+        _notice(db, f"earlier close-out {n}", closeout={"state": "started", "at": time.time() - 600})
+    _notice(db, "✔ Kanban t_aaa done — deploy card")
+    refreshes = _count_refreshes(monkeypatch)
+
+    first, _ = _run(db)
+    second, calls = _run(db)
+
+    assert [o["result"] for o in first] == ["refreshed:budget"]
+    assert [o["result"] for o in second] == ["skipped:refreshed"] and calls == [] and len(refreshes) == 1
+
+
+def test_a_new_human_notice_row_refreshes_again(db, monkeypatch):
+    tid = _decision_card()
+    _notice(db, f"⏸ Kanban {tid} blocked: needs approval — prod deploy", task_id=tid)
+    ksa._reset_cache_for_tests()
+    refreshes = _count_refreshes(monkeypatch)
+    _run(db)
+
+    _notice(db, f"⏸ Kanban {tid} blocked: still needs approval — prod deploy", task_id=tid)
+    out, _ = _run(db)
+
+    assert [o["result"] for o in out] == ["refreshed:human"] and len(refreshes) == 2
+
+
+def test_a_failed_refresh_retries_on_the_next_pass(db, monkeypatch):
+    tid = _decision_card()
+    _notice(db, f"⏸ Kanban {tid} blocked: needs approval — prod deploy", task_id=tid)
+    ksa._reset_cache_for_tests()
+    real = so.refresh_outcome
+    state = {"fail": True}
+
+    def flaky(sid, trigger, *, db=None):
+        if state["fail"]:
+            raise RuntimeError("database is locked")
+        return real(sid, trigger, db=db)
+    monkeypatch.setattr(so, "refresh_outcome", flaky)
+
+    _run(db)
+    state["fail"] = False
+    out, _ = _run(db)
+
+    assert [o["result"] for o in out] == ["refreshed:human"]
+    assert so.get_outcome(CHAT, db=db)["kind"] == "decision"
+
+
+def test_a_human_notice_whose_card_is_answered_after_its_refresh_is_still_superseded(db):
+    tid = _decision_card()
+    row = _notice(db, f"⏸ [default] @default Kanban {tid} blocked: Decision needed — prod deploy", task_id=tid,
+                  board="default")
+    ksa._reset_cache_for_tests()
+    assert [o["result"] for o in _run(db)[0]] == ["refreshed:human"]
+    with contextlib.closing(kbc.connect()) as conn:
+        assert kb.unblock_task(conn, tid)
+    ksa._reset_cache_for_tests()
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["superseded"] and _closeout(db, row) == "superseded"
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index 98631cfbd3..b08bbd4fd6 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -23,6 +23,11 @@ A notice about a card on another gateway (``gateway`` in its metadata, or only `
 by the ``blocked_on_human`` flag its writer stored, never by a local board lookup: its ``board`` is the owner's.
 A candidate whose handling raises is stamped ``closeout.state = "error"`` once and left for the auditor, instead
 of being retried (and logged) on every pass.
+
+A notice that only refreshes (blocked on a human, spent budget) is not stamped, so it stays a candidate; each
+backend refreshes it once per notice row (``_refreshed``) instead of re-deriving the same outcome every 30 s pass.
+A card move still refreshes through ``notice_fanout.card_change_pass``, a newer message makes a new candidate row,
+and a refresh that failed is retried. [daveey]
 """
 
 from __future__ import annotations
@@ -47,6 +52,13 @@ CLOSEOUT_TEXT = (
     "summary for the user, the decision you need from them, or what you are still waiting on.")
 CLOSEOUT_DISPLAY = "Close-out turn for the Kanban notice above"
 _wake_slots = threading.BoundedSemaphore(MAX_PARALLEL_WAKES)
+# (store path, session id, notice row id, branch) this backend already refreshed. Pruned to the current
+# candidates after every pass, so it holds at most one pass's candidates.
+_refreshed: set[tuple[str, str, int, str]] = set()
+
+
+def _reset_refreshed_for_tests() -> None:
+    _refreshed.clear()
 
 _CANDIDATES_SQL = """
 SELECT s.id AS sid, m.id AS msg_id, m.timestamp, m.content, m.display_metadata
@@ -195,9 +207,10 @@ def _spawn(job: Callable[[], Any]) -> None:
     spawn_context_thread(job, name="notice-closeout").start()
 
 
-def _refresh(db: Any, sid: str) -> None:
-    from hermes_state_outcome import refresh_outcomes_quietly
-    refresh_outcomes_quietly([sid], "notice", db=db)
+def _refresh(db: Any, sid: str) -> bool:
+    """Refresh one chat's outcome; True when it refreshed (``refresh_outcomes_quietly`` logs and swallows a failure)."""
+    import hermes_state_outcome as _outcome
+    return _outcome.refresh_outcomes_quietly([sid], "notice", db=db) > 0
 
 
 def _closeout_job(session_db, wake, sid: str, msg_id: int) -> str:
@@ -219,10 +232,26 @@ def _closeout_job(session_db, wake, sid: str, msg_id: int) -> str:
         _wake_slots.release()
 
 
-def _handle(db, cand: dict, now: float, *, holders, session_db, wake, spawn) -> str:
+def _refresh_key(db: Any, cand: dict, branch: str) -> tuple[str, str, int, str]:
+    return (str(getattr(db, "db_path", id(db))), cand["sid"], cand["msg_id"], branch)
+
+
+def _refresh_once(db: Any, cand: dict, branch: str, seen: set) -> str:
+    """Refresh the chat's outcome for this notice row once per backend; later passes skip it."""
+    key = _refresh_key(db, cand, branch)
+    seen.add(key)
+    if key in _refreshed:
+        return "skipped:refreshed"
+    if _refresh(db, cand["sid"]):
+        _refreshed.add(key)
+    return f"refreshed:{branch}"
+
+
+def _handle(db, cand: dict, now: float, *, holders, session_db, wake, spawn, seen: Optional[set] = None) -> str:
     from hermes_state_outcome import _live_turn
     from tui_gateway.kanban_unloaded import _other_holder
     sid = cand["sid"]
+    seen = set() if seen is None else seen
     if _other_holder(holders, {sid}):
         return "skipped:held"
     if _live_turn(db, sid):
@@ -230,11 +259,9 @@ def _handle(db, cand: dict, now: float, *, holders, session_db, wake, spawn) ->
     if superseded(cand):
         return _supersede(db, cand, now)
     if blocked_on_human(cand):
-        _refresh(db, sid)
-        return "refreshed:human"
+        return _refresh_once(db, cand, "human", seen)
     if started_last_hour(db, sid, now) >= WAKES_PER_HOUR:
-        _refresh(db, sid)
-        return "refreshed:budget"
+        return _refresh_once(db, cand, "budget", seen)
     if not _wake_slots.acquire(blocking=False):
         return "skipped:slots"
     try:
@@ -297,15 +324,19 @@ def guarantee_pass(*, now: Optional[float] = None, stores: Callable[[], Iterator
     holders = holders or ku.registry_holders
     session_db = session_db or ku.find_session_db
     out: list[dict] = []
+    seen: set = set()
     try:
         for db in stores():
             for cand in candidates(db, now):
                 try:
-                    result = _handle(db, cand, now, holders=holders, session_db=session_db, wake=wake, spawn=spawn)
+                    result = _handle(db, cand, now, holders=holders, session_db=session_db, wake=wake, spawn=spawn,
+                                     seen=seen)
                 except Exception:
                     logger.warning("notice guarantee failed for %s", cand["sid"], exc_info=True)
                     result = _give_up(db, cand)
                 out.append({"session_id": cand["sid"], "msg_id": cand["msg_id"], "result": result})
     except Exception:
         logger.warning("notice guarantee pass failed", exc_info=True)
+        return out  # an incomplete pass keeps every memo entry
+    _refreshed.intersection_update(seen)
     return out
-- 
