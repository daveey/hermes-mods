From 74792bc5a3763e5790fbcd3ec64e762d2db39459 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:51:51 +0000
Subject: [PATCH] [daveey] managed worker: document recovery scope; pass
 recover stub into _execute

Follow-up to PR #2054 review (t_01a1d45bb1c34412), nits 1 and 3 (card t_01a1d4643509ab6a):

1. agent/managed_worker.py: the comment at recover_from_checkpoint(session_keys=...) now says a
   managed worker no longer adopts keyless orphans or orphans of other worker routes; they wait
   for a later run of the same route or a gateway/Desktop backend restart, whose keeper adopts them.
2. tests: _execute (test_managed_worker_route_key) takes an optional `recover` stub, so
   _worker_recovery_kwargs passes its capturing stub in instead of swapping monkeypatch.setattr.

Tests: test_managed_worker_checkpoint_scope, _route_key, _pool_rotation, authority_turn_error_surface
33 passed 0 failed; scripts/check --base origin/main 19 checks ok.
---
 agent/managed_worker.py                              |  5 ++++-
 .../gateway/test_managed_worker_checkpoint_scope.py  | 12 +-----------
 tests/gateway/test_managed_worker_route_key.py       |  5 +++--
 3 files changed, 8 insertions(+), 14 deletions(-)

diff --git a/agent/managed_worker.py b/agent/managed_worker.py
index 37ea9887b7..3019320722 100644
--- a/agent/managed_worker.py
+++ b/agent/managed_worker.py
@@ -353,7 +353,10 @@ def execute(frame, channel):
     # Background processes a previous admission of this session started outlive that worker
     # (F24); adopt them so process_manage in this turn can poll and kill them. Only this session's:
     # another chat's orphan (a Desktop job whose backend just rolled over) would finish in this
-    # per-turn process, whose completion queue nobody reads, and its notice was lost. [daveey]
+    # per-turn process, whose completion queue nobody reads, and its notice was lost. So a managed
+    # worker no longer adopts keyless orphans or orphans of other worker routes either: they wait
+    # for a later run of the same route, or for a gateway/Desktop backend restart, whose keeper
+    # adopts them. [daveey]
     from tools.process_registry import process_registry
     process_registry.recover_from_checkpoint(session_keys=(frame['route'], scope['session_id']))
     # Store construction binds the delegation ledger before tool discovery.
diff --git a/tests/gateway/test_managed_worker_checkpoint_scope.py b/tests/gateway/test_managed_worker_checkpoint_scope.py
index 264d2ba67e..0e424d4ff9 100644
--- a/tests/gateway/test_managed_worker_checkpoint_scope.py
+++ b/tests/gateway/test_managed_worker_checkpoint_scope.py
@@ -59,17 +59,7 @@ def _worker_recovery_kwargs(tmp_path, monkeypatch) -> dict:
     """Run the real managed-worker ``execute`` and capture exactly how it asks for recovery."""
     calls = []
     frame, _ = assignment(tmp_path, monkeypatch)
-    real_setattr = monkeypatch.setattr
-
-    def setattr_spy(target, *args, **kwargs):
-        if target == 'tools.process_registry.process_registry.recover_from_checkpoint':
-            args = (lambda *a, **k: calls.append((a, k)),)
-        return real_setattr(target, *args, **kwargs)
-    monkeypatch.setattr = setattr_spy
-    try:
-        _execute(frame, monkeypatch)
-    finally:
-        monkeypatch.setattr = real_setattr
+    _execute(frame, monkeypatch, recover=lambda *a, **k: calls.append((a, k)))
     assert len(calls) == 1, calls
     args, kwargs = calls[0]
     assert not args, args
diff --git a/tests/gateway/test_managed_worker_route_key.py b/tests/gateway/test_managed_worker_route_key.py
index ed3dc22ccb..f4405204cd 100644
--- a/tests/gateway/test_managed_worker_route_key.py
+++ b/tests/gateway/test_managed_worker_route_key.py
@@ -28,7 +28,7 @@ def _minimax_frame(tmp_path, monkeypatch, api_key=None):
     return {**frame, 'policy': policy, 'api_key': api_key}
 
 
-def _execute(frame, monkeypatch, base=object, built=None, result=None, sent=None):
+def _execute(frame, monkeypatch, base=object, built=None, result=None, sent=None, recover=None):
     from agent import managed_worker as worker
     built = {} if built is None else built
 
@@ -61,7 +61,8 @@ def _execute(frame, monkeypatch, base=object, built=None, result=None, sent=None
     monkeypatch.setattr(worker, 'WorkerControls', Controls)
     monkeypatch.setattr('agent.runtime_session_store.WorkerRPC', lambda home: lambda *a, **k: {'owner_epoch': 1})
     monkeypatch.setattr('agent.runtime_session_store.RuntimeSessionStore', Store)
-    monkeypatch.setattr('tools.process_registry.process_registry.recover_from_checkpoint', lambda **_k: None)
+    monkeypatch.setattr('tools.process_registry.process_registry.recover_from_checkpoint',
+                        recover or (lambda **_k: None))
     monkeypatch.setattr('run_agent.AIAgent', Agent)
     monkeypatch.setattr('agent.title_generator.wait_for_title_upgrades', lambda: None)
     sent = [] if sent is None else sent
-- 
2.51.0

