diff --git a/hermes_cli/kanban_origin_owner.py b/hermes_cli/kanban_origin_owner.py
index fab53c500ad..40acd1b769f 100644
--- a/hermes_cli/kanban_origin_owner.py
+++ b/hermes_cli/kanban_origin_owner.py
@@ -92,6 +92,10 @@ def _dispatch_result(raw_result):
         result = json.loads(raw_result) if isinstance(raw_result, str) else None
     except ValueError:
         result = None
+    if (isinstance(result, dict) and result.get('created') is False
+            and isinstance(result.get('code'), str) and result['code'].strip()):
+        # Definitive no-write refusals cannot be repaired by replaying this envelope.
+        return {**result, 'status': 'rejected', 'handoff_complete': False}
     if not isinstance(result, dict) or result.get('handoff_complete') is not False:
         # Dispatch catches exceptions itself. An untyped error may follow a
         # committed write: keep the exact request retryable, never infer absence.
diff --git a/tests/hermes_cli/test_kanban_courier_refusals.py b/tests/hermes_cli/test_kanban_courier_refusals.py
new file mode 100644
index 00000000000..2b10b4c31ba
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_courier_refusals.py
@@ -0,0 +1,30 @@
+"""Immutable courier refusals settle; empty auto lease labels are not a hub pin."""
+import json
+
+import pytest
+
+from hermes_cli.kanban_origin_owner import _dispatch_result
+
+
+@pytest.mark.parametrize('code', ['placement_unavailable', 'create_overlap', 'requires_declaration_missing'])
+@pytest.mark.parametrize('handoff', [{}, {'handoff_complete': False}])
+def test_typed_no_create_is_terminal(code, handoff):
+    raw = {'error': 'No card was created', 'created': False, 'code': code, **handoff}
+    result = _dispatch_result(json.dumps(raw))
+    assert result['status'] == 'rejected'
+    assert result['code'] == code
+    assert result['created'] is False
+    assert result['handoff_complete'] is False
+
+
+@pytest.mark.parametrize('raw', [
+    'not JSON', 'null', '[]', json.dumps({'error': 'exception after unknown write'}),
+    json.dumps({'code': 'placement_unavailable'}),
+    json.dumps({'created': False}), json.dumps({'created': False, 'code': ''}),
+    json.dumps({'created': False, 'code': 17}),
+    json.dumps({'created': 0, 'code': 'placement_unavailable'}),
+    json.dumps({'created': True, 'code': 'placement_unavailable'}),
+])
+def test_unknown_write_stays_retryable(raw):
+    assert _dispatch_result(raw) == {
+        'status': 'pending', 'code': 'origin_dispatch_pending', 'handoff_complete': False}
