From 313b7e87bbd5a4a8b807b75e80a9f58590b689b5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 02:55:04 +0000
Subject: [PATCH] fix(desktop): isolate pre-plugin session list dependencies
 [daveey]

Keep core and navigation predicates independent from plugin contributions so list-dependent plugin registration cannot feed back into its SDK snapshot. Preserve core -> plugin -> navigation matching order. Add bounded real-sidebar regression plus session and core-status update controls. Proof: old head executes registration 9 times; fixed head once, then exactly once per core input update. 114 focused tests, renderer tsc, eslint and full scripts/check pass.
---
 .../sidebar/chat-sidebar.integration.test.tsx | 52 ++++++++++++++++++
 .../app/chat/sidebar/use-session-filters.ts   | 53 ++++++++++---------
 2 files changed, 79 insertions(+), 26 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx b/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx
index 92885c0601..19346b7159 100644
--- a/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx
@@ -1,5 +1,7 @@
+import { useStore } from '@nanostores/react'
 // @vitest-environment jsdom
 import { act, cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react'
+import { useEffect } from 'react'
 import { MemoryRouter } from 'react-router'
 import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
 
@@ -143,6 +145,56 @@ describe('ChatSidebar navigation activity', () => {
     noteActiveTreeGroup(null)
   })
 
+  it('keeps list-dependent plugin registration stable while reflecting core input changes', () => {
+    resetSidebarView()
+    renderSidebar('/', 'chat')
+    let registrations = 0
+
+    function Consumer() {
+      // This is the SDK useSidebarSessions hook's store subscription.
+      const sessions = useStore($sidebarSessionsPrePlugin)
+
+      useEffect(() => {
+        registrations++
+
+        // Bound the reproduction instead of crashing React with an infinite loop.
+        if (registrations >= 8) {
+          return
+        }
+
+        return registry.register({
+          area: SESSION_FILTER_AREA,
+          id: 'list-consumer',
+          data: { match: (s: { id: string }) => sessions.some(row => row.id === s.id) }
+        })
+      }, [sessions])
+
+      return null
+    }
+
+    const consumer = render(<Consumer />)
+
+    try {
+      expect(registrations).toBe(1)
+      expect($sidebarSessionsPrePlugin.get().map(row => row.id)).toEqual(['tile-one', 'tile-two'])
+
+      act(() => $sessions.set([sessionRows[0]]))
+      expect(registrations).toBe(2)
+      expect($sidebarSessionsPrePlugin.get().map(row => row.id)).toEqual(['tile-one'])
+
+      act(() => $sidebarStatusFilter.set(['draft']))
+      expect(registrations).toBe(3)
+      expect($sidebarSessionsPrePlugin.get()).toEqual([])
+
+      act(() => $sidebarStatusFilter.set([]))
+      expect(registrations).toBe(4)
+      expect($sidebarSessionsPrePlugin.get().map(row => row.id)).toEqual(['tile-one'])
+    } finally {
+      consumer.unmount()
+      act(() => resetSidebarView())
+    }
+  })
+
   it('keeps navigation and session activity coherent with the focused pane', () => {
     renderSidebar('/kanban', 'extension')
     expectOnlyCurrent('Kanban')
diff --git a/apps/desktop/src/app/chat/sidebar/use-session-filters.ts b/apps/desktop/src/app/chat/sidebar/use-session-filters.ts
index 0223340403..cef3a22aa3 100644
