From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:09:23 +0000
Subject: [PATCH] test(kanban): unmask correction bounds and blank fields
 [daveey]

---
 tests/hermes_cli/test_kanban_diagnostic_correction.py |  1 +
 .../test_kanban_diagnostic_correction_cli.py          | 11 +++++++++++
 2 files changed, 12 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_diagnostic_correction.py b/tests/hermes_cli/test_kanban_diagnostic_correction.py
index 77d7f6756d..be8f9df785 100644
--- a/tests/hermes_cli/test_kanban_diagnostic_correction.py
+++ b/tests/hermes_cli/test_kanban_diagnostic_correction.py
@@ -94,6 +94,7 @@ def test_worker_refused_before_reading_board(kanban_home, monkeypatch, worker_ke
 
 @pytest.mark.parametrize(("field", "value"), [
     ("reason", "x" * 2001), ("request_id", "x" * 129),
+    ("reason", "   "), ("request_id", "\t"),
     ("reason", None), ("request_id", []), ("expected_body", "x" * 100001),
     ("expected_comment", "x" * 50001), ("comment_uid", "x" * 202),
 ])
diff --git a/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py b/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py
index 40bdff5182..a112a4e4f3 100644
--- a/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py
+++ b/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py
@@ -55,6 +55,17 @@ def test_cli_bad_file_bytes(correction_case, tmp_path, capsys, raw):
     assert list(conn.iterdump()) == before
 
 
+def test_cli_oversize_valid_json_is_rejected(correction_case, tmp_path, capsys):
+    conn, tid, request = correction_case
+    raw = json.dumps(request).encode("utf-8")
+    path = tmp_path / "padded-valid.json"
+    path.write_bytes(raw + b" " * (200001 - len(raw)))
+    before = list(conn.iterdump())
+    assert fixtures._main(["correct-diagnostics", tid, "--request-file", str(path)]) == 2
+    assert "exceeds 200000 bytes" in capsys.readouterr().err
+    assert list(conn.iterdump()) == before
+
+
 def test_cli_and_db_delegation_fences(correction_case, kanban_home, monkeypatch, capsys):
     from hermes_cli.kanban_diagnostic_correction import correct_diagnostics
 
