---
 hermes_cli/kanban_priority_prepare.py         |  2 +-
 .../test_kanban_priority_boundary_cases.py    | 56 +++++++++++++++++++
 .../test_kanban_priority_manifest.py          | 56 +++++++++++++++++++
 3 files changed, 113 insertions(+), 1 deletion(-)
