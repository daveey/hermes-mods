@@ -0,0 +1,157 @@
+"""An awaited review that approved the PR's current head resumes its parked owner. [daveey]
+
+A PR owner that parks with ``kanban_schedule``/``kanban_continue`` waiting on a review card
+(its wake-check ``hermes kanban wait-check task <id>``, or ``awaiting`` kind ``card``) is
+not linked to that card as a parent, so :func:`kanban_dependency_review.resumes_review`
+never sees it. When the review approved, the owner woke and the ``active_pr`` guard held it:
+the PR is open only because the owner's next run is the one that merges it (2026-11-13
+t_01a1d30035fa4777: review t_01a1d3093ee49e78 approved PR #1862 at its head; held 30+ min).
+
+One continuation is permitted only when all of these hold:
+
+* the card's latest run that executed (no later claim) is the assignee's orderly
+  ``scheduled``/``continued`` park, and that park names the awaited card(s);
+* each awaited card is done with a claimed completion that ended at or after the park;
+* none requested changes; together they approve every holding PR by name
+  (``pr``/``reviewed_pr``) at a full ``reviewed_sha`` equal to that PR's current GitHub head.
+
+A request-changes verdict, an approval of another head or PR, an unknown head (gh failure),
+or a crash/reclaim after the park keeps the hold. It never authorizes a merge.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import re
+import sqlite3
+import subprocess
+import time
+from typing import Iterable, Optional
+
+logger = logging.getLogger(__name__)
+
+_WAIT_CHECK = re.compile(r"\s*hermes\s+kanban\s+wait-check\s+task\s+(t_[0-9A-Za-z_]+)(?:\s|$)")
+_TASK_ID = re.compile(r"t_[0-9A-Za-z_]+\Z")
+_PARKED = {"scheduled": "scheduled", "continued": "continued"}  # run outcome -> park event kind
+
+# url -> (head or None, monotonic expiry)
+_heads: dict[str, tuple[Optional[str], float]] = {}
+
+
+def _gh_pr_head(url: str) -> Optional[str]:
+    from hermes_cli.kanban_db_dispatch_pr_state import GH_TIMEOUT_SECONDS, _gh_argv
+
+    gh = _gh_argv() or ["gh"]
+    try:
+        proc = subprocess.run([*gh, "pr", "view", url, "--json", "state,headRefOid"], stdin=subprocess.DEVNULL,
+                              capture_output=True, text=True, encoding="utf-8", errors="replace",
+                              timeout=GH_TIMEOUT_SECONDS, check=False)
+    except (OSError, subprocess.SubprocessError):
+        logger.debug("kanban: gh pr view %s (head) failed", url, exc_info=True)
+        return None
+    if proc.returncode != 0:
+        return None
+    try:
+        data = json.loads(proc.stdout or "{}")
+    except ValueError:
+        return None
+    if not isinstance(data, dict):
+        return None
+    oid = data.get("headRefOid")
+    if data.get("state") != "OPEN" or not isinstance(oid, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", oid):
+        return None
+    return oid.lower()
+
+
+def pr_head(url: str) -> Optional[str]:
+    """Full head sha of an OPEN PR, cached like :func:`pr_state`; None when unknown."""
+    from hermes_cli.kanban_db_dispatch_pr_state import ERROR_TTL_SECONDS, OPEN_TTL_SECONDS
+    from hermes_cli.kanban_db_dispatch_pr_policy import norm_pr
+
+    key = norm_pr(url)
+    now = time.monotonic()
+    hit = _heads.get(key)
+    if hit is not None and now < hit[1]:
+        return hit[0]
+    head = _gh_pr_head(url)
+    _heads[key] = (head, now + (OPEN_TTL_SECONDS if head else ERROR_TTL_SECONDS))
+    return head
+
+
+def clear_cache() -> None:
+    _heads.clear()
+
+
+def awaited_cards(payload: dict) -> list[str]:
+    """Card ids a park waits on: ``awaiting`` kind ``card`` or a ``wait-check task`` probe."""
+    found: list[str] = []
+    awaiting = payload.get("awaiting")
+    if isinstance(awaiting, dict) and awaiting.get("kind") == "card":
+        ref = awaiting.get("ref")
+        if isinstance(ref, str) and _TASK_ID.match(ref):
+            found.append(ref)
+    episode = payload.get("_wake_episode_v1")
+    for cmd in (payload.get("wake_check"), episode.get("park_cmd") if isinstance(episode, dict) else None):
+        match = _WAIT_CHECK.match(cmd) if isinstance(cmd, str) else None
+        if match:
+            found.append(match[1])
+    return list(dict.fromkeys(found))
+
+
+def _park(conn: sqlite3.Connection, task_id: str):
+    """(run, park payload, parked_at) of the latest run's orderly timed park, or None."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_core_update_requeue import latest_run_skipping_requeues
+
+    run = latest_run_skipping_requeues(conn, task_id)
+    task = kb.get_task(conn, task_id)
+    if (run is None or task is None or run["profile"] != task.assignee
+            or run["outcome"] not in _PARKED or run["ended_at"] is None):
+        return None
+    event = conn.execute(
+        "SELECT payload, created_at FROM task_events WHERE task_id = ? AND run_id = ? AND kind = ? "
+        "ORDER BY id DESC LIMIT 1", (task_id, run["id"], _PARKED[run["outcome"]])).fetchone()
+    parked_at = kb._to_epoch(event["created_at"]) if event is not None else None
+    if parked_at is None:
+        return None
+    return run, kb._json_dict(event["payload"]), parked_at
+
+
+def _approved_at_head(conn, card: str, parked_at: int, run_id: int, urls: set[str]) -> Optional[set[str]]:
+    """PRs ``card`` approved at their current head; None when it is unfinished or requested changes."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_dependency_review as review
+
+    row = review._completed_review_run(conn, card, parked_at, run_id)
+    if row is None:
+        return None  # an awaited card still open (or finished before the park) keeps the hold
+    data = kb._json_dict(row["metadata"])
+    if review._requests_changes(row, data):
+        return None
+    verdict = data.get("verdict")
+    sha = data.get("reviewed_sha")
+    if (not isinstance(verdict, str) or verdict.strip().lower() not in review._APPROVALS
+            or not isinstance(sha, str)):
+        return set()
+    named = review._named_prs(data, urls) or set()  # must name the PR: no checkpoint binds scope
+    return {u for u in named if pr_head(u) == sha.lower()}  # pr_head is a full 40-hex sha or None
+
+
+def resumes_awaited_review(conn: sqlite3.Connection, task_id: str, pr_urls: Iterable[str]) -> bool:
+    """One continuation of a timed park whose awaited review approved every holding PR at head."""
+    from hermes_cli.kanban_db_dispatch_pr_policy import norm_pr
+
+    urls = {norm_pr(u) for u in pr_urls}
+    parked = _park(conn, task_id) if urls else None
+    if parked is None:
+        return False
+    run, payload, parked_at = parked
+    covered: set[str] = set()
+    for card in awaited_cards(payload):
+        if card == task_id:
+            continue
+        approved = _approved_at_head(conn, card, parked_at, run["id"], urls)
+        if approved is None:
+            return False  # an open awaited card or a change request is never outvoted by a sibling
+        covered |= approved
+    return urls.issubset(covered)
