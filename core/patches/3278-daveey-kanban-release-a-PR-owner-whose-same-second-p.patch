+        _park(conn, tid, kind)
+        _comment(conn, tid, run_id, f"Also opened {OTHER}", monkeypatch)
+        _wake(conn, tid)
+        assert prs.active_pr_reason(conn, tid, clock[0] + 700) == "active_pr"
