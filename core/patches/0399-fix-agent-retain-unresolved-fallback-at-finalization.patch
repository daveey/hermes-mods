+
+
+def test_hook_worker_inherits_context_without_leaking_changes():
+    scope = ContextVar("test_profile_scope", default="wrong-profile")
+    token = scope.set("target-profile")
+    try:
+        def callback():
+            observed = scope.get()
+            scope.set("worker-only")
