+    base._ready_in(conn, 'myapp', 'waiting')
+    _dispatch(conn, max_spawn=0)
+    row = _sample(conn)
+    assert (row['running'], row['cap'], row['rejected']) == (1, None, 0)
+    assert samples.ticks(conn, lanes.policy(), now=row['ts'] + 30, window_s=60, count=1)['myapp'][0]['state'] == 'partial'
+
