From a71807ae546c10ad08ecddfc77cfaeaf440a6bf3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 05:40:15 +0000
Subject: [PATCH] fix(loop-accounting): name direct gateway pool submissions
 [daveey]

The registry-enabled run_in_pool path bypasses BaseEventLoop.run_in_executor and therefore the residual executor hook. Use the existing function-named Scope at the physical function boundary; keep the flag, nested-pass subtraction and reservation custody unchanged.

Proof: real pool test RED (enabled function scope absent; disabled control passes), GREEN 29 focused tests plus 12 consumer files; scripts/check --base origin/main passed. This fixes attribution coverage, not a claim that any function owns the measured gateway-default residual.
---
 hermes_cli/local_work_threads.py              |  6 ++++
 .../test_loop_accounting_residual.py          | 35 +++++++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/hermes_cli/local_work_threads.py b/hermes_cli/local_work_threads.py
index 765e469506feece985210f60f398bd2c1e514866..d247261574c9d302a9f60002c30b0b83d6f3d387 100644
--- a/hermes_cli/local_work_threads.py
+++ b/hermes_cli/local_work_threads.py
@@ -336,6 +336,12 @@ async def run_in_pool(executor, ctx, func, *args, source="gateway:run_in_executo
         return await loop.run_in_executor(executor, ctx.run, func, *args)
     if executor is None:  # ``run_in_executor(None, ...)`` semantics: the loop's (scope-aware) default
         executor = _scoped_loops[loop]
+    # This path submits directly, bypassing BaseEventLoop.run_in_executor's
+    # accounting hook. Keep the submitted function named on its physical thread;
+    # Scope subtracts any route/pass CPU the function already accounts itself.
+    from hermes_cli import loop_accounting
+    if loop_accounting.scopes_enabled():
+        func = loop_accounting.scoped_call("thread", func, args)
     future = submit_tracked(executor, ctx.run, func, *args, registry=registry,
                             home=current_home(), source=source, kind="gateway_pool")
     return await asyncio.wrap_future(future, loop=loop)
diff --git a/tests/hermes_cli/test_loop_accounting_residual.py b/tests/hermes_cli/test_loop_accounting_residual.py
index fff6597d12503c9812b44cf785a95a1867087940..94ac703d54157891e0c9cdb218b4d5ff93da9418 100644
--- a/tests/hermes_cli/test_loop_accounting_residual.py
+++ b/tests/hermes_cli/test_loop_accounting_residual.py
@@ -168,6 +168,41 @@ def test_executor_scope_names_a_context_run_submission_by_its_function():
     assert not any(k.endswith("Context.run") for k in la.counters())
 
 
+@pytest.mark.parametrize("enabled", [True, False])
+def test_gateway_direct_pool_submission_is_named(monkeypatch, tmp_path, enabled):
+    from contextvars import copy_context
+    from hermes_cli import local_work_threads as threads
+    from hermes_cli.local_work import Registry
+
+    registry = Registry(homes=[str(tmp_path)])
+    monkeypatch.setattr(threads, "installed_registry", lambda: registry)
+    monkeypatch.setattr(threads, "current_home", lambda: str(tmp_path))
+    monkeypatch.setitem(la._state, "scopes", enabled)
+    if enabled:
+        la.instrument_executors()
+
+    def direct_job():
+        _burn(0.03)
+        with la.pass_("direct.inner"):
+            _burn(0.03)
+        return 42
+
+    async def main():
+        assert await threads.run_in_pool(None, copy_context(), direct_job) == 42
+
+    asyncio.run(main())
+    names = {k: v for k, v in la.counters().items() if k.endswith("direct_job")}
+    if enabled:
+        assert len(names) == 1, la.counters()
+        st = next(iter(names.values()))
+        assert st["runs"] == 1
+        assert 0.025 <= st["cpu_s"] < 0.05
+        assert 0.055 <= la.snapshot()["process"]["accounted_cpu_s"] < 0.09
+    else:
+        assert not names
+    assert registry.snapshot().active == 0
+
+
 def test_executor_scope_does_not_double_count_an_accounted_route():
     la.instrument_executors()
 
