+        restore_route("pinned", {"model_routing": {
+            "selected_model": "pinned", "selected_provider": provider, "requested_class": "deep", "exact_pin": True}})
+
+
+def test_restored_pin_is_not_managed_authorization(routing_home, tmp_path):
