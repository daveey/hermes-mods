diff --git a/hermes_constants.py b/hermes_constants.py
index 0d556559d5..dd1df0a123 100644
--- a/hermes_constants.py
+++ b/hermes_constants.py
@@ -893,6 +893,45 @@ def apply_secure_dir_policy(path, *, home: str | Path | None = None) -> None:
     _chown_to_hermes_uid(path)
 
 
+# [daveey] Spotlight indexes the whole home folder, and a home-rooted TMPDIR turned every pytest
+# tmp dir, uv build and review worktree into indexing work (340K items, about a core of mds_stores
+# + mdworker_shared around the clock). macOS skips any directory whose name ends in ``.noindex``,
+# so on darwin the real dir lives at ``<name>.noindex`` and ``<name>`` is a relative symlink to
+# it: every existing path (TMPDIR, docs, prompts, running processes) keeps working unchanged.
+# ``HERMES_SPOTLIGHT_INDEX_CACHE=1`` keeps the plain directory.
+SPOTLIGHT_NOINDEX_SUFFIX = ".noindex"
+SPOTLIGHT_INDEX_CACHE_ENV = "HERMES_SPOTLIGHT_INDEX_CACHE"
+
+
+def ensure_spotlight_noindex_dir(path: Path, *, platform: str | None = None) -> Path:
+    """On macOS make *path* a symlink to a sibling ``<name>.noindex`` directory; return *path*.
+
+    A missing *path* gets both created. An existing real directory is renamed (one atomic
+    ``rename``: open files and cwds inside it keep working) and the symlink is laid down right
+    after it. A dangling link gets its target recreated. When both a real *path* and its
+    ``.noindex`` sibling exist, nothing is merged or moved. Never raises; a no-op elsewhere."""
+    if (platform or sys.platform) != "darwin" or os.environ.get(SPOTLIGHT_INDEX_CACHE_ENV, "").strip() in (
+            "1", "true", "yes"):
+        return path
+    target = path.with_name(path.name + SPOTLIGHT_NOINDEX_SUFFIX)
+    try:
+        if path.is_symlink():
+            if os.readlink(path) in (target.name, str(target)):
+                target.mkdir(parents=True, exist_ok=True)
+            return path
+        if path.exists():
+            if not path.is_dir() or target.exists() or target.is_symlink():
+                return path
+            os.rename(path, target)
+        else:
+            target.mkdir(parents=True, exist_ok=True)
+        with contextlib.suppress(FileExistsError):  # a racing caller laid the same link down
+            os.symlink(target.name, path)
+    except OSError:
+        pass
+    return path
+
+
 def get_scratch_dir(home: str | Path | None = None, *, prune: bool = True) -> Path:
     """``<home>/cache/scratch`` (created, owner-only); *home* defaults to the active Hermes home.
 
@@ -906,6 +945,7 @@ def get_scratch_dir(home: str | Path | None = None, *, prune: bool = True) -> Pa
     """
     base = Path(home) if home is not None else get_hermes_home()
     scratch = base / "cache" / "scratch"
+    ensure_spotlight_noindex_dir(scratch)
     try:
         scratch.mkdir(parents=True, exist_ok=True)
         if sys.platform != "win32":
diff --git a/pm/packages.py b/pm/packages.py
index 81902c6f57..056c448900 100644
--- a/pm/packages.py
+++ b/pm/packages.py
@@ -336,11 +336,13 @@ def uv_cache_dir() -> Path:
     from it is near-free (probed: 0.4s vs 1.2s cold) — the blow-away-
     on-update contract depends on it. uv's default cache location is
     per-user/platform-opinionated and never used by pm."""
-    from hermes_constants import get_default_hermes_root
+    from hermes_constants import ensure_spotlight_noindex_dir, get_default_hermes_root
 
     from pm.paths import repo_root, store_root
 
     machine_cache = get_default_hermes_root() / "cache" / "uv"
+    # [daveey] a symlink to cache/uv.noindex on macOS, so uv's churn stays out of Spotlight
+    ensure_spotlight_noindex_dir(machine_cache)
     marker = machine_cache / ".seeded"
     # The marker names the lock whose payload was merged. An update ships a new payload cache for
     # a new lock; a bare "done" marker skipped it forever, so plugin rebuilds fetched the new pins
diff --git a/tests/hermes_cli/test_doctor_cache_hogs.py b/tests/hermes_cli/test_doctor_cache_hogs.py
index 4555e1ea43..29da96a5e5 100644
--- a/tests/hermes_cli/test_doctor_cache_hogs.py
+++ b/tests/hermes_cli/test_doctor_cache_hogs.py
@@ -14,3 +14,15 @@ def test_unpruned_cache_hogs_skips_pruned_dirs_and_small_entries(tmp_path):
     assert {name for name, _ in hogs} == {"campaign-x", "web"}
     assert not unpruned_cache_hogs(tmp_path, min_bytes=1 << 20)
     assert all(size >= 2048 for _, size in hogs)
+
+
+def test_unpruned_cache_hogs_skips_the_noindex_scratch_dir_and_symlinks(tmp_path):
+    """[daveey] cache/scratch.noindex is the reaped scratch dir on macOS (cache/scratch links to it)."""
+    import os
+
+    cache = tmp_path / "cache"
+    (cache / "scratch.noindex").mkdir(parents=True)
+    os.symlink("scratch.noindex", cache / "scratch")
+    with open(cache / "scratch.noindex" / "blob", "wb") as fh:
+        fh.write(b"x" * 2048)
+    assert unpruned_cache_hogs(tmp_path, min_bytes=1024) == []
diff --git a/tests/pm/test_uv_cache.py b/tests/pm/test_uv_cache.py
index 2a60c06b4d..73c060ac5e 100644
--- a/tests/pm/test_uv_cache.py
+++ b/tests/pm/test_uv_cache.py
@@ -66,3 +66,24 @@ def test_bundle_uses_shipped_environment_until_an_extension_is_committed(monkeyp
 
     assert pkgs.Venv().venv_dir() == shipped
     assert not home.exists(), "selecting shipped dependencies must not copy or mutate them"
+
+
+def test_uv_cache_dir_lives_in_a_spotlight_noindex_dir_on_macos(monkeypatch, tmp_path):
+    """[daveey] cache/uv is a symlink to cache/uv.noindex on macOS; an existing cache moves intact."""
+    import sys
+
+    home = tmp_path / "home"
+    (home / "cache" / "uv" / "wheels-v5").mkdir(parents=True)
+    (home / "cache" / "uv" / "wheels-v5" / "a.whl").write_text("w", encoding="utf-8")
+    import hermes_constants
+
+    monkeypatch.setattr(sys, "platform", "darwin")
+    monkeypatch.delenv("HERMES_SPOTLIGHT_INDEX_CACHE", raising=False)
+    monkeypatch.setattr(hermes_constants, "get_default_hermes_root", lambda: home)
+    import pm.paths as paths_mod
+
+    monkeypatch.setattr(paths_mod, "store_root", lambda: tmp_path / "nowhere" / "tools")
+    machine = pkgs.uv_cache_dir()
+    assert machine == home / "cache" / "uv" and machine.is_symlink()
+    assert (home / "cache" / "uv.noindex" / "wheels-v5" / "a.whl").read_text(encoding="utf-8") == "w"
+    assert (machine / ".seeded").is_file()
diff --git a/tests/test_scratch_dir.py b/tests/test_scratch_dir.py
index d4596a75d0..2472b026c6 100644
--- a/tests/test_scratch_dir.py
+++ b/tests/test_scratch_dir.py
@@ -387,3 +387,61 @@ def test_prune_releases_git_worktree_registration_of_idle_entry(tmp_path):
     listing = subprocess.run(["git", "worktree", "list", "--porcelain"], cwd=repo, capture_output=True,
                              text=True, stdin=subprocess.DEVNULL, check=True).stdout
     assert str(tree) not in listing and not tree.exists()
+
+
+@pytest.mark.platforms("posix")  # symlinks
+class TestSpotlightNoindexScratch:
+    """[daveey] On macOS the scratch dir's real home is ``cache/scratch.noindex`` (Spotlight skips
+    ``*.noindex``) and ``cache/scratch`` is a symlink to it, so TMPDIR churn is never indexed while
+    every ``cache/scratch`` path keeps working."""
+
+    def test_fresh_home_gets_noindex_dir_and_symlink(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(sys, "platform", "darwin")
+        monkeypatch.delenv("HERMES_SPOTLIGHT_INDEX_CACHE", raising=False)
+        scratch = get_scratch_dir(tmp_path, prune=False)
+        assert scratch == tmp_path / "cache" / "scratch"
+        assert scratch.is_symlink() and os.readlink(scratch) == "scratch.noindex"
+        assert (tmp_path / "cache" / "scratch.noindex").is_dir()
+        (scratch / "f").write_text("x", encoding="utf-8")
+        assert (tmp_path / "cache" / "scratch.noindex" / "f").read_text(encoding="utf-8") == "x"
+
+    def test_existing_real_dir_is_moved_keeping_its_contents_and_open_files(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(sys, "platform", "darwin")
+        monkeypatch.delenv("HERMES_SPOTLIGHT_INDEX_CACHE", raising=False)
+        old = tmp_path / "cache" / "scratch"
+        (old / "lane").mkdir(parents=True)
+        fh = open(old / "lane" / "log", "w", encoding="utf-8")
+        scratch = get_scratch_dir(tmp_path, prune=False)
+        fh.write("still writing")
+        fh.close()
+        assert scratch.is_symlink()
+        assert (tmp_path / "cache" / "scratch.noindex" / "lane" / "log").read_text(encoding="utf-8") == "still writing"
+        assert (scratch / "lane" / "log").is_file()
+        # idempotent; the reaper still sees entries through the link
+        assert get_scratch_dir(tmp_path, prune=False).is_symlink()
+        idle = scratch / "idle"
+        idle.mkdir()
+        ancient = time.time() - 30 * 3600
+        os.utime(idle, (ancient, ancient))
+        assert prune_scratch_dir(scratch) == 1 and not idle.exists() and scratch.is_symlink()
+
+    def test_dangling_link_is_repaired_and_conflicts_are_left_alone(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(sys, "platform", "darwin")
+        monkeypatch.delenv("HERMES_SPOTLIGHT_INDEX_CACHE", raising=False)
+        cache = tmp_path / "cache"
+        cache.mkdir()
+        os.symlink("scratch.noindex", cache / "scratch")
+        assert get_scratch_dir(tmp_path, prune=False).is_dir()
+        assert (cache / "scratch.noindex").is_dir()
+        # a real dir next to an existing .noindex sibling: never merged or moved
+        other = tmp_path / "o"
+        (other / "cache" / "scratch").mkdir(parents=True)
+        (other / "cache" / "scratch.noindex").mkdir()
+        assert not get_scratch_dir(other, prune=False).is_symlink()
+
+    def test_other_platforms_and_opt_out_keep_a_plain_dir(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(sys, "platform", "linux")
+        assert not get_scratch_dir(tmp_path / "a", prune=False).is_symlink()
+        monkeypatch.setattr(sys, "platform", "darwin")
+        monkeypatch.setenv("HERMES_SPOTLIGHT_INDEX_CACHE", "1")
+        assert not get_scratch_dir(tmp_path / "b", prune=False).is_symlink()
