 hermes_constants.py                        | 40 +++++++++++++++
 pm/packages.py                             |  4 +-
 tests/hermes_cli/test_doctor_cache_hogs.py | 12 +++++
 tests/pm/test_uv_cache.py                  | 21 ++++++++
 tests/test_scratch_dir.py                  | 58 ++++++++++++++++++++++
 6 files changed, 135 insertions(+), 2 deletions(-)

