From 5e5a48cd3ae6a455e1ef75584eec63ca56074ad4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:24:23 +0000
Subject: [PATCH] [daveey] Make watcher restore invalidation fixtures explicit

---
 tests/tui_gateway/test_watch_store_gate.py | 25 ++++++++++++++--------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/tests/tui_gateway/test_watch_store_gate.py b/tests/tui_gateway/test_watch_store_gate.py
index c2153985d2..25751b4771 100644
--- a/tests/tui_gateway/test_watch_store_gate.py
+++ b/tests/tui_gateway/test_watch_store_gate.py
@@ -201,7 +201,8 @@ def test_released_store_can_be_kept_after_an_owner_reopens(tmp_path):
         db.close()
 
 
-def test_in_place_restore_reopens_sqlite_page_cache(tmp_path):
+@pytest.mark.parametrize("release_before_restore", [False, True])
+def test_in_place_restore_reopens_sqlite_page_cache(tmp_path, release_before_restore):
     path, other = tmp_path / "a.db", tmp_path / "b.db"
     for p, value in ((path, 1), (other, 99)):
         conn = sqlite3.connect(p)
@@ -213,16 +214,22 @@ def test_in_place_restore_reopens_sqlite_page_cache(tmp_path):
     try:
         with watch_store.observed(path) as (before, conn):
             assert conn.execute("SELECT v FROM t").fetchone()[0] == 1
-        original = path.stat()
+        before_stat = path.stat()
+        if release_before_restore:
+            # Canonical restores release tracked readers before copying. Even a
+            # same-size, same-mtime image must then discard the old page cache.
+            from hermes_state_registry import close_all_under
+            close_all_under(tmp_path)
         shutil.copyfile(other, path)
-        # Equal-size SQLite files can have equal header counters, and copyfile can
-        # finish within the same filesystem mtime tick. Exercise the changed-mtime
-        # restore contract explicitly instead of depending on wall-clock progress.
-        os.utime(path, ns=(original.st_atime_ns, original.st_mtime_ns + 2_000_000_000))
+        # Without release, the documented recovery signal is changed main-file
+        # metadata. A fast copy can share a filesystem clock tick: establish that
+        # precondition explicitly rather than depending on scheduler timing.
+        mtime = before_stat.st_mtime_ns + (0 if release_before_restore else 2_000_000_000)
+        os.utime(path, ns=(before_stat.st_atime_ns, mtime))
         restored = path.stat()
-        assert restored.st_ino == original.st_ino
-        assert restored.st_size == original.st_size
-        assert restored.st_mtime_ns != original.st_mtime_ns
+        assert (restored.st_mtime_ns == before_stat.st_mtime_ns) == release_before_restore
+        assert restored.st_ino == before_stat.st_ino
+        assert restored.st_size == before_stat.st_size
         with watch_store.observed(path) as (after, conn):
             assert after != before
             assert conn.execute("SELECT v FROM t").fetchone()[0] == 99
-- 
