From 08de4da36f7019657583612211e8c89ad4eb44e0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:59:15 -0700
Subject: [PATCH 586/588] test(desktop): narrow connect() union before reading
 alwaysOn (fix red main typecheck) [daveey]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/electron/remote-lifecycle-always-on.test.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/electron/remote-lifecycle-always-on.test.ts b/apps/desktop/electron/remote-lifecycle-always-on.test.ts
index 7fedcad2fd..82f5372e62 100644
--- a/apps/desktop/electron/remote-lifecycle-always-on.test.ts
+++ b/apps/desktop/electron/remote-lifecycle-always-on.test.ts
@@ -86,7 +86,7 @@ test('connect() reuses the always-on dashboard: no spawn, no lockfile, nothing k
   const d = deps(ssh)
   const result: any = await connect(d)
 
-  assert.equal(result.alwaysOn, true)
+  assert.equal('alwaysOn' in result && result.alwaysOn, true)
   assert.equal(result.reused, true)
   assert.equal(result.pid, 4242)
   assert.equal(result.remotePort, 9147)
@@ -110,7 +110,7 @@ test('after a core update, connect() waits for the supervisor restart and reuses
 
   const result: any = await connect(d)
 
-  assert.equal(result.alwaysOn, true)
+  assert.equal('alwaysOn' in result && result.alwaysOn, true)
   assert.equal(result.pid, 5151)
   assert.ok(!ssh.calls.some(c => SPAWNS.test(c)), 'a restart window must not become a spawn')
   assert.deepEqual(d.cancelled, [9147], 'the stale probe forward is closed')
-- 
