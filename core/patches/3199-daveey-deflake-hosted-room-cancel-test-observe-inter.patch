From fc4e67e6ecf7d7eeaed9f0a39205cda06563df9e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:34:33 +0000
Subject: [PATCH] [daveey] deflake hosted-room cancel test: observe interrupt
 on receipt

test_cancellation_is_persisted_before_interrupt_and_fences_late_result
failed once on CI with observed_status == ['cancelled'].

FakeSessionRPC.interrupt flipped the session inactive under its lock and
only then ran on_interrupt, which reads the task status. If the
interrupting thread is starved in that window, the room thread's
_wait_for_terminal probe sees an inactive session, treats the Stop as
acknowledged and commits `cancelled` before the observer reads.

Run on_interrupt under the fake's lock before the flip, so it observes
the status the runtime persisted when the interrupt was received.
Reproduced deterministically by sleeping 0.6 s in on_interrupt (5/5 fail
before, 5/5 pass after).
---
 tests/tui_gateway/test_hosted_room_driver_runtime.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_hosted_room_driver_runtime.py b/tests/tui_gateway/test_hosted_room_driver_runtime.py
index d0d7691476..df425f22e2 100644
--- a/tests/tui_gateway/test_hosted_room_driver_runtime.py
+++ b/tests/tui_gateway/test_hosted_room_driver_runtime.py
@@ -254,10 +254,12 @@ class FakeSessionRPC:
             if not current["active"] or current["task_id"] != expected_task_id:
                 self.calls.append(("interrupt_skipped", params))
                 return {"interrupted": False}
+            # Observe on receipt, before the session reads inactive: once it does, the
+            # room thread's next probe may acknowledge the Stop and commit `cancelled`.
+            if self.on_interrupt is not None:
+                self.on_interrupt()
             current["active"] = False
         self.calls.append(("interrupt", params))
-        if self.on_interrupt is not None:
-            self.on_interrupt()
         return {"interrupted": True}
 
 
