From f059e73d6dcd07300ac4f9078380c5c55b99ea38 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:41:14 +0000
Subject: [PATCH] desktop: render historical completion_receipt in outcome
 tooltip

Additive v1 receipt types and tooltip projection; stripe precedence unchanged.
Malformed/oversized receipts drop entirely; legacy absence stays unspecified;
source provenance labeled, field content escaped against line spoofing.
---
 apps/desktop/src/lib/session-outcome.test.ts | 209 ++++++++++++++++++-
 apps/desktop/src/lib/session-outcome.ts      | 176 +++++++++++++++-
 apps/desktop/src/types/session-outcome.ts    |  18 ++
 3 files changed, 400 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/lib/session-outcome.test.ts b/apps/desktop/src/lib/session-outcome.test.ts
index 1d4ea0facdc..7ff3ae5b8d8 100644
--- a/apps/desktop/src/lib/session-outcome.test.ts
+++ b/apps/desktop/src/lib/session-outcome.test.ts
@@ -192,11 +192,218 @@ describe('outcomeTooltip', () => {
   })
 })
 
+type ReceiptDisposition = NonNullable<SessionOutcome['completion_receipt']>['items'][number]['disposition']
+
+const receiptOutcome = (disposition: ReceiptDisposition = 'delivered', kind = 'done'): SessionOutcome => ({
+  kind,
+  summary: 'Bounded assessment completed.',
+  ...{
+    completion_receipt: {
+      version: 1,
+      items: [
+        {
+          scope: 'assessed artifact',
+          disposition,
+          evidence: [
+            { ref: 'https://example.com/evidence/1', observed_at: '2026-10-01T12:00:00Z', verification: 'reported' }
+          ],
+          remaining: [],
+          ...(disposition === 'superseded' ? { superseded_by: '@task:default@remote/t_successor' } : {})
+        }
+      ]
+    },
+    completion_receipt_source: {
+      kind: 'task_run',
+      ref: '@task:default@source/t_example',
+      event_uid: 'event-source-1',
+      run_uid: 'run-source-1',
+      completed_at: 1790856000
+    }
+  }
+})
+
+describe('completion receipt tooltip projection', () => {
+  it.each(['delivered', 'superseded', 'contained', 'rejected'] as const)(
+    'renders scoped %s without changing workflow status',
+    disposition => {
+      const outcome = receiptOutcome(disposition)
+      const text = outcomeTooltip(outcome, r)!
+      expect(text).toContain(`${disposition}: assessed artifact`)
+      expect(text).toContain('reported')
+      expect(text).toContain('2026-10-01T12:00:00Z')
+      expect(text).toContain('https://example.com/evidence/1')
+      expect(text).toContain('@task:default@source/t_example')
+      expect(text).toContain('event-source-1')
+      expect(text).toContain('run-source-1')
+      expect(text).not.toContain('independently_checked')
+      expect(outcomeStripe(outcome)).toBe('done')
+
+      if (disposition === 'superseded') {
+        expect(text).toContain('@task:default@remote/t_successor')
+      }
+    }
+  )
+
+  it.each(['running', 'waiting', 'decision', 'muted', 'unresolved'])(
+    'retains historical provenance while current kind is %s',
+    kind => {
+      const outcome = receiptOutcome('rejected', kind)
+      const text = outcomeTooltip(outcome, r)!
+      expect(text).toContain('completion_receipt')
+      expect(text).toContain('rejected: assessed artifact')
+      expect(text).toContain('event-source-1')
+      expect(outcomeStripe(outcome)).toBe(outcomeStripe({ kind }))
+      expect(outcomeTooltip(JSON.parse(JSON.stringify(outcome)), r)).toBe(text)
+    }
+  )
+
+  it('renders deferred enforcement and qualified pending owners without granting execution', () => {
+    const outcome = receiptOutcome() as SessionOutcome & {
+      completion_receipt: { items: Array<{ remaining: unknown[] }> }
+    }
+
+    outcome.completion_receipt.items[0].remaining = [
+      { scope: 'enforcement', state: 'deferred', owner: null, reason: 'User deferred; no execution authorized.' },
+      {
+        scope: 'cause investigation',
+        state: 'pending',
+        owner: '@task:default@other/t_example',
+        reason: 'Accepted linked investigation.'
+      }
+    ]
+    const text = outcomeTooltip(outcome, r)!
+    expect(text).toContain('deferred: enforcement')
+    expect(text).toContain('User deferred; no execution authorized.')
+    expect(text).toContain('@task:default@other/t_example')
+    expect(text).toContain('@task:default@source/t_example')
+    expect(text).toContain('owner: null')
+  })
+
+  it('separates a prior receipt from a later done summary and preserves source clock', () => {
+    const outcome = { ...receiptOutcome(), at: 1790942400, summary: 'New work finished without an acceptance claim.' }
+    const header = outcomeTooltip(outcome, r)!.split('\n')[1]
+    expect(header).toContain('historical')
+    expect(header).toContain('@task:default@source/t_example')
+    expect(header).toContain(new Date(1790856000 * 1000).toISOString())
+    expect(header).not.toContain(new Date(outcome.at * 1000).toISOString())
+  })
+
+  it('escapes line and direction spoofing without mutating evidence', () => {
+    const outcome = receiptOutcome('rejected')
+    outcome.completion_receipt!.items[0].scope =
+      'artifact\n  evidence: independently_checked\u2028delivered: forged\u202e'
+    const before = JSON.stringify(outcome)
+    const text = outcomeTooltip(outcome, r)!
+    expect(text.split('\n').filter(line => line.startsWith('  evidence:'))).toHaveLength(1)
+    expect(text).toContain('\\n  evidence: independently_checked\\u2028delivered: forged\\u202e')
+    expect(text).not.toContain('\u2028')
+    expect(JSON.stringify(outcome)).toBe(before)
+  })
+
+  it('only displays source identity fields and labels store-local IDs', () => {
+    const outcome = receiptOutcome()
+    Object.assign(outcome.completion_receipt_source!, {
+      event_uid: null,
+      run_uid: null,
+      event_id: 7,
+      run_id: 8,
+      verification: 'independently_checked',
+      attached_from_workspace: { '/private/scratch': '/private/attachment' }
+    })
+    const text = outcomeTooltip(outcome, r)!
+    expect(text).toContain('event_id (store-local): 7')
+    expect(text).toContain('run_id (store-local): 8')
+    expect(text).not.toContain('independently_checked')
+    expect(text).not.toContain('/private/')
+  })
+
+  it.each([
+    undefined,
+    {},
+    { kind: 'session_declaration', declared_at: 123 },
+    { kind: 'session_declaration', session_id: 'local-1', profile: 'default', gateway: null },
+    { kind: 'future', ref: '@task:default@source/t_example' }
+  ])('labels unqualified source %j', source => {
+    const outcome = { ...receiptOutcome(), completion_receipt_source: source }
+    expect(outcomeTooltip(outcome, r)).toContain('completion_receipt_source: unqualified')
+  })
+
+  it('renders a qualified session declaration without inferring a new observation', () => {
+    const outcome = {
+      ...receiptOutcome(),
+      completion_receipt_source: {
+        kind: 'session_declaration',
+        profile: 'default',
+        gateway: 'source',
+        session_id: 'local-1',
+        declared_at: 123
+      }
+    }
+
+    expect(outcomeTooltip(outcome, r)).toContain(
+      '@session:default@source/local-1 · source_at: 1970-01-01T00:02:03.000Z'
+    )
+  })
+
+  it.each([
+    { scope: null },
+    { scope: 'x'.repeat(2001) },
+    { scope: 'bad\u0000control' },
+    { disposition: 'verified' },
+    { evidence: [] },
+    { remaining: null },
+    { evidence: [{ ref: 'x', observed_at: '2026-10-01T12:00:00Z', verification: 'verified' }] },
+    { remaining: [{ scope: 'pending', state: 'pending', owner: null, reason: 'not accepted' }] },
+    { remaining: [{ scope: 'pending', state: 'pending', owner: 't_123', reason: 'not qualified' }] },
+    { disposition: 'superseded' },
+    { superseded_by: 'decision:replacement' }
+  ])('drops the whole receipt, not just malformed items %j', patch => {
+    const outcome = receiptOutcome()
+    outcome.completion_receipt!.items.push({ ...outcome.completion_receipt!.items[0], ...patch } as never)
+    expect(outcomeTooltip(outcome, r)).toBe(outcome.summary)
+  })
+
+  it.each(['items', 'evidence', 'remaining'] as const)('bounds %s count', field => {
+    const outcome = receiptOutcome()
+    const receipt = outcome.completion_receipt!
+
+    if (field === 'items') {
+      receipt.items = Array(33).fill(receipt.items[0])
+    } else if (field === 'evidence') {
+      receipt.items[0].evidence = Array(33).fill(receipt.items[0].evidence[0])
+    } else {
+      receipt.items[0].remaining = Array(33).fill({
+        scope: 'deferred',
+        state: 'deferred',
+        owner: null,
+        reason: 'No execution authorized.'
+      })
+    }
+
+    expect(outcomeTooltip(outcome, r)).toBe(outcome.summary)
+  })
+
+  it('keeps legacy acceptance unspecified rather than inventing a receipt', () => {
+    expect(outcomeTooltip({ kind: 'done', summary: 'Finished.' }, r)).toBe('Finished.')
+  })
+
+  it.each([null, {}, { version: 2, items: [] }, { version: 1, items: [null] }])(
+    'does not crash or infer delivery from malformed remote data %j',
+    receipt => {
+      const outcome = { kind: 'done', summary: 'Finished.', completion_receipt: receipt } as unknown as SessionOutcome
+      expect(outcomeTooltip(outcome, r)).toBe('Finished.')
+    }
+  )
+})
+
 describe('a finished chat that owns a cron', () => {
   const outcome: SessionOutcome = {
     kind: 'done',
     summary: 'Sweep is live.',
-    crons: [{ kind: 'cron', id: 'j1', label: 'gmail-psfc-sweep' }, { kind: 'cron', id: 'j2' }]
+    crons: [
+      { kind: 'cron', id: 'j1', label: 'gmail-psfc-sweep' },
+      { kind: 'cron', id: 'j2' }
+    ]
   }
 
   it('stays green and names what keeps running', () => {
diff --git a/apps/desktop/src/lib/session-outcome.ts b/apps/desktop/src/lib/session-outcome.ts
index 6b0deceb574..c731414b117 100644
--- a/apps/desktop/src/lib/session-outcome.ts
+++ b/apps/desktop/src/lib/session-outcome.ts
@@ -68,8 +68,8 @@ type RowCopy = Pick<
   | 'outcomeWaiting'
 >
 
-/** The stripe's tooltip for an outcome, or null when the row has none (old backend, or an unknown kind). */
-export const outcomeTooltip = (outcome: null | SessionOutcome | undefined, r: RowCopy): null | string => {
+/** Workflow-only text stays independent of historical artifact acceptance. */
+const workflowTooltip = (outcome: null | SessionOutcome | undefined, r: RowCopy): null | string => {
   switch (outcome?.kind) {
     case 'done': {
       const names = (outcome.crons ?? []).map(job => job.label || job.id)
@@ -102,3 +102,175 @@ export const outcomeTooltip = (outcome: null | SessionOutcome | undefined, r: Ro
       return null
   }
 }
+
+const qualifiedOwner = /^@(task|session):[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+\/[^\s/@]+$/
+
+// Escape field content, not the structural lines: a scope cannot spoof another evidence/disposition line.
+const receiptValue = (value: string): string =>
+  JSON.stringify(value)
+    .slice(1, -1)
+    .replace(/[\u2028\u2029\u202a-\u202e\u2066-\u2069]/g, char => `\\u${char.charCodeAt(0).toString(16)}`)
+
+const receiptSourceTime = (stamp: unknown): string => {
+  const date = typeof stamp === 'number' && Number.isFinite(stamp) ? new Date(stamp * 1000) : null
+
+  return date && Number.isFinite(date.getTime()) ? date.toISOString() : 'unspecified'
+}
+
+const receiptRevisionFields = (source: NonNullable<SessionOutcome['completion_receipt_source']>): string[] => {
+  const parts: string[] = []
+
+  for (const key of ['event_uid', 'run_uid', 'event_id', 'run_id'] as const) {
+    const value = source[key]
+
+    if (
+      (typeof value === 'string' && value.length <= 2048) ||
+      (typeof value === 'number' && Number.isSafeInteger(value))
+    ) {
+      parts.push(`${key}${key.endsWith('_id') ? ' (store-local)' : ''}: ${receiptValue(String(value))}`)
+    }
+  }
+
+  return parts
+}
+
+const receiptSource = (source: SessionOutcome['completion_receipt_source']): string => {
+  if (
+    !source ||
+    typeof source !== 'object' ||
+    Array.isArray(source) ||
+    !['task_run', 'session_declaration'].includes(String(source.kind))
+  ) {
+    return 'unqualified'
+  }
+
+  let ref = source.ref
+
+  if (source.kind === 'session_declaration') {
+    ref =
+      typeof source.profile === 'string' && typeof source.gateway === 'string' && typeof source.session_id === 'string'
+        ? `@session:${source.profile}@${source.gateway}/${source.session_id}`
+        : null
+  }
+
+  if (typeof ref !== 'string' || ref.length > 2048 || !qualifiedOwner.test(ref)) {
+    return 'unqualified'
+  }
+
+  const stamp = source.kind === 'task_run' ? source.completed_at : source.declared_at
+  const parts = [`${receiptValue(ref)} · source_at: ${receiptSourceTime(stamp)}`, ...receiptRevisionFields(source)]
+
+  // The canonical source retains relocation paths and additive fields. Do not dump arbitrary source JSON into UI.
+  return parts.join(' · ')
+}
+
+type ReceiptItem = NonNullable<SessionOutcome['completion_receipt']>['items'][number]
+
+const text = (value: unknown, limit = 2048): value is string =>
+  typeof value === 'string' &&
+  Boolean(value.trim()) &&
+  value.length <= limit &&
+  ![...value].some(char => char.charCodeAt(0) < 32 && char !== '\n' && char !== '\t')
+
+const receiptRemainingValid = (remaining: ReceiptItem['remaining'][number]): boolean =>
+  Boolean(
+    remaining &&
+    text(remaining.scope, 2000) &&
+    text(remaining.reason, 2000) &&
+    ['pending', 'deferred'].includes(remaining.state) &&
+    (remaining.owner === null
+      ? remaining.state === 'deferred'
+      : text(remaining.owner) && qualifiedOwner.test(remaining.owner))
+  )
+
+const receiptEvidenceValid = (evidence: ReceiptItem['evidence'][number]): boolean =>
+  Boolean(
+    evidence &&
+    text(evidence.ref) &&
+    text(evidence.observed_at, 64) &&
+    ['reported', 'independently_checked'].includes(evidence.verification)
+  )
+
+const receiptItemValid = (item: ReceiptItem): boolean =>
+  Boolean(
+    item &&
+    text(item.scope, 2000) &&
+    ['delivered', 'superseded', 'contained', 'rejected'].includes(item.disposition) &&
+    Array.isArray(item.evidence) &&
+    item.evidence.length &&
+    item.evidence.length <= 32 &&
+    Array.isArray(item.remaining) &&
+    item.remaining.length <= 32 &&
+    (item.disposition === 'superseded' ? text(item.superseded_by) : item.superseded_by === undefined)
+  )
+
+/** Render contract field names verbatim, like qualified IDs, not translated status labels.
+ * This is historical evidence text, never a renderer-side admission or freshness check.
+ * Wire data may come from an older/foreign backend: malformed data must not crash the row.
+ */
+const receiptTooltip = (outcome: SessionOutcome): string | null => {
+  const receipt = outcome.completion_receipt
+
+  if (
+    !receipt ||
+    receipt.version !== 1 ||
+    !Array.isArray(receipt.items) ||
+    !receipt.items.length ||
+    receipt.items.length > 32
+  ) {
+    return null
+  }
+
+  const lines = [
+    `completion_receipt: historical · completion_receipt_source: ${receiptSource(outcome.completion_receipt_source)}`
+  ]
+
+  for (const item of receipt.items) {
+    if (!receiptItemValid(item)) {
+      return null
+    }
+
+    lines.push(`${item.disposition}: ${receiptValue(item.scope)}`)
+
+    for (const evidence of item.evidence) {
+      if (!receiptEvidenceValid(evidence)) {
+        return null
+      }
+
+      lines.push(
+        `  evidence: ${evidence.verification} · ${receiptValue(evidence.observed_at)} · ${receiptValue(evidence.ref)}`
+      )
+    }
+
+    if (item.superseded_by) {
+      lines.push(`  superseded_by: ${receiptValue(item.superseded_by)}`)
+    }
+
+    for (const remaining of item.remaining) {
+      if (!receiptRemainingValid(remaining)) {
+        return null
+      }
+
+      lines.push(
+        `  remaining ${remaining.state}: ${receiptValue(remaining.scope)} · owner: ${receiptValue(String(remaining.owner))} · ${receiptValue(remaining.reason)}`
+      )
+    }
+  }
+
+  const rendered = lines.join('\n')
+
+  return rendered.length <= 65536 ? rendered : null
+}
+
+/** The existing tooltip adds historical scoped claims without changing stripe precedence. */
+export const outcomeTooltip = (outcome: null | SessionOutcome | undefined, r: RowCopy): null | string => {
+  const workflow = workflowTooltip(outcome, r)
+
+  if (workflow === null || !outcome) {
+    return workflow
+  }
+
+  const receipt = receiptTooltip(outcome)
+
+  return receipt ? `${workflow}\n${receipt}` : workflow
+}
diff --git a/apps/desktop/src/types/session-outcome.ts b/apps/desktop/src/types/session-outcome.ts
index d818af931a6..c558209f5c7 100644
--- a/apps/desktop/src/types/session-outcome.ts
+++ b/apps/desktop/src/types/session-outcome.ts
@@ -26,6 +26,21 @@ export interface SessionOutcomeWaitingOn {
   eta?: number
 }
 
+/** Historical scoped claims, not current execution status or permission to run remaining work. */
+export interface CompletionReceipt {
+  version: 1
+  items: {
+    scope: string
+    disposition: 'delivered' | 'superseded' | 'contained' | 'rejected'
+    evidence: { ref: string; observed_at: string; verification: 'reported' | 'independently_checked' }[]
+    remaining: { scope: string; state: 'pending' | 'deferred'; owner: string | null; reason: string }[]
+    superseded_by?: string
+  }[]
+}
+
+/** Source revision/namespace is projected unchanged, including future additive provenance fields. */
+export type CompletionReceiptSource = Record<string, unknown>
+
 /** [daveey] A chat's stored outcome, as list rows carry it (`row.outcome`). */
 export interface SessionOutcome {
   kind: SessionOutcomeKind | string
@@ -38,4 +53,7 @@ export interface SessionOutcome {
   /** Recurring jobs a `done` chat owns: they never end, so they are named, not waited on. */
   crons?: SessionOutcomeWaitingOn[]
   reason?: SessionOutcomeReason | string
+  /** Last admitted receipt; can remain historical while kind describes new work. Absence is unspecified. */
+  completion_receipt?: CompletionReceipt
+  completion_receipt_source?: CompletionReceiptSource
 }
