+def read_rows(conn, sql, params, width):
+    """``conn.execute(sql, params).fetchall()`` as tuples in ONE statement and one handed-out row. [daveey]
+
+    For a reader whose ``width`` result columns are known: no prepare-only probe for their names, the columns are
+    renamed by position (a wrong ``width`` fails at prepare). Same transport as ``read_page``: SQLite types, row
+    order and binary64 values are preserved."""
+    cols = [f"_pack_c{i}" for i in range(width)]
+    packed = conn.execute(
+        f"WITH _packed_rows({','.join(cols)}) AS MATERIALIZED ({sql}) "
+        f"SELECT json_group_array(json_array({','.join(_cell(c) for c in cols)})) FROM _packed_rows",
+        params).fetchone()
+    return [tuple(_value(kind, value) for kind, value in row) for row in json.loads(packed[0])]
+
+
+def _cell(column):
+    # JSON numbers round doubles to 15 digits. Transport REAL as SQLite's
+    # round-trip decimal text and BLOB as hex, distinguished by storage type.
+    return (f"json_array(typeof({column}), CASE typeof({column}) "
+            f"WHEN 'real' THEN printf('%!.26g', {column}) "
+            f"WHEN 'blob' THEN hex({column}) ELSE {column} END)")
+
+
 def _value(kind, value):
     if kind == 'real':
         return float(value)
diff --git a/tests/hermes_cli/test_browse_probe_memo.py b/tests/hermes_cli/test_browse_probe_memo.py
new file mode 100644
index 00000000000..97f2b6526fb
--- /dev/null
+++ b/tests/hermes_cli/test_browse_probe_memo.py
@@ -0,0 +1,120 @@
+"""A read-only browse open probes the declared schema once per store schema, not once per open. [daveey]
+
+``/api/profiles/sessions`` opens a fresh read-only ``SessionDB`` for every profile whose ``state.db`` moved, and each
+open ran the ~25-statement declared-schema probe (#140315): most of ``_read_profile_db``'s statements, each a GIL
+release in the Desktop backend. The probe's answer is a function of the store's schema, which SQLite's
+``schema_version`` cookie (bumped by every DDL, from any process) and the file identity pin, so an unchanged store
+is not re-probed. These tests pin that drift, a replaced file and a new build's probe are still probed.
+"""
+from __future__ import annotations
+
+import os
+import sqlite3
+from contextlib import closing
+
+import pytest
+
+from hermes_cli import web_server_sessions as wss
+from hermes_state import SessionDB
+
+
+class _Probes(tuple):
+    """The probe statements, counting how often an open runs them."""
+
+    runs = 0
+
+    def __iter__(self):
+        type(self).runs += 1
+        return super().__iter__()
+
+
+@pytest.fixture
+def probes(monkeypatch):
+    real = wss._session_db_read_probe_statements()
+    _Probes.runs = 0
+    counted = _Probes(real)
+    monkeypatch.setattr(wss, "_session_db_read_probe_statements", lambda: counted)
+    getattr(wss, "_PROBED_STORES", set()).clear()
+    yield _Probes
+    getattr(wss, "_PROBED_STORES", set()).clear()
+
+
+def _store(path):
+    """A settled store in an unowned profile home (the shape ``test_browse_schema_drift`` browses)."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    (path.parent / "config.yaml").write_text("{}\n", encoding="utf-8")
+    with SessionDB(db_path=path) as db:
+        db.create_session("kept", source="cli")
+    return path
+
+
+def _browse(path):
+    db = wss._open_session_db_at_path(path, read_only=True)
+    try:
+        return [s["id"] for s in db.list_sessions_rich(limit=5)]
+    finally:
+        db.close()
+
+
+def test_an_unchanged_store_is_probed_once(tmp_path, probes):
+    path = _store(tmp_path / "profiles" / "scribe" / "state.db")
+    for _ in range(3):
+        assert _browse(path) == ["kept"]
+    assert probes.runs == 1
+
+
+def test_a_write_that_is_not_ddl_keeps_the_probe(tmp_path, probes):
+    path = _store(tmp_path / "profiles" / "scribe" / "state.db")
+    _browse(path)
+    with SessionDB(db_path=path) as db:
+        db.create_session("more", source="cli")
+    assert sorted(_browse(path)) == ["kept", "more"]
+    assert probes.runs == 1
+
+
+def test_ddl_after_a_passed_probe_is_probed_and_drift_is_still_caught(tmp_path, probes):
+    path = _store(tmp_path / "profiles" / "scribe" / "state.db")
+    _browse(path)
+    with closing(sqlite3.connect(path)) as conn:
+        conn.execute("DROP TRIGGER IF EXISTS sessions_runtime_ledger_delete_guard")
+        conn.execute("DROP TRIGGER IF EXISTS session_change_on_sessions_update")
+        conn.execute("ALTER TABLE sessions DROP COLUMN runtime_generation")
+        conn.commit()
+    assert _browse(path) == ["kept"]  # the probe found the drift and the unowned store was caught up (#140315)
+    with closing(sqlite3.connect(path)) as conn:
+        assert "runtime_generation" in {r[1] for r in conn.execute("PRAGMA table_info(sessions)")}
+    assert probes.runs >= 2
+
+
+def test_a_replaced_store_is_probed_again(tmp_path, probes):
+    path = _store(tmp_path / "profiles" / "scribe" / "state.db")
+    _browse(path)
+    other = _store(tmp_path / "profiles" / "other" / "state.db")
+    os.replace(other, path)
+    for suffix in ("-wal", "-shm"):
+        if os.path.exists(f"{path}{suffix}"):
+            os.remove(f"{path}{suffix}")
+    assert _browse(path) == ["kept"]
+    assert probes.runs == 2
+
+
+def test_a_different_probe_set_is_run(tmp_path, probes, monkeypatch):
+    path = _store(tmp_path / "profiles" / "scribe" / "state.db")
+    _browse(path)
+    changed = _Probes(tuple.__add__(wss._session_db_read_probe_statements(), ("SELECT 1",)))  # not counted
+    monkeypatch.setattr(wss, "_session_db_read_probe_statements", lambda: changed)
+    _browse(path)
+    assert probes.runs == 2
+
+
+def test_a_failed_probe_is_not_remembered(tmp_path, probes, monkeypatch):
+    from fastapi import HTTPException
+
+    path = _store(tmp_path / "profiles" / "scribe" / "state.db")
+    broken = _Probes(("SELECT missing_column FROM sessions LIMIT 0",))
+    monkeypatch.setattr(wss, "_session_db_read_probe_statements", lambda: broken)
+    monkeypatch.setattr("hermes_state_reconcile.is_declarative_drift_error", lambda exc: False)
+    for _ in range(2):
+        with pytest.raises(HTTPException):
+            _browse(path)
+    assert probes.runs == 2 and not getattr(wss, "_PROBED_STORES", set())
diff --git a/tests/hermes_cli/test_kanban_external_read_rows.py b/tests/hermes_cli/test_kanban_external_read_rows.py
new file mode 100644
index 00000000000..1c2aba98b9e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_external_read_rows.py
@@ -0,0 +1,275 @@
+"""The session list's board read answers as before while handing Python O(1) SQLite rows per board. [daveey]
+
+``/api/profiles/sessions`` stamps external-wait cards from every board whose change signal moved
+(``kanban_external_activity.stamp_boards`` -> ``read_session_external``). On the hub's busy board that is most
+requests, and the read handed Python ~445 rows for ~140 parked cards: the parked rows and newest park events
+(``_local_wait_rows``), the scheduled statuses (``kanban_external_watch._card_states``), the titles, and a
+``PRAGMA table_info(tasks)`` (one row per column) in ``kanban_contained_wait.read``. Each row step releases the GIL;
+in the Desktop backend (~48k context switches/s) each re-acquire can wait out the 5 ms switch interval, which made
+this route's p95 ~3 s. Each test pins the old answer (a reference copy of the old per-row reader where the query
+changed) and the reduced work (rows handed out do not grow with the number of parked cards).
+"""
+from __future__ import annotations
+
+import json
+import sqlite3
+import time
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_external_activity as kea
+from hermes_cli import kanban_wait_info as kwi
+from hermes_cli.kanban_session_wait_rows import _describe_waits, _local_wait_rows
+from tests.hermes_cli import test_kanban_external_watch as helpers
+
+kanban_home, gh, clock = helpers.kanban_home, helpers.gh, helpers.clock
+park, tick = helpers.park, helpers.tick
+
+
+@pytest.fixture(autouse=True)
+def _fresh():
+    kea.reset_for_tests()
+    yield
+    kea.reset_for_tests()
+
+
+class _Cursor:
+    def __init__(self, cur, owner):
+        self._cur, self._owner = cur, owner
+
+    def __iter__(self):
+        for row in self._cur:
+            self._owner.rows += 1
+            yield row
+
+    def fetchall(self):
+        rows = self._cur.fetchall()
+        self._owner.rows += len(rows)
+        return rows
+
+    def fetchone(self):
+        row = self._cur.fetchone()
+        self._owner.rows += row is not None
+        return row
+
+    def __getattr__(self, name):
+        return getattr(self._cur, name)
+
+
+class Counting:
+    """Connection proxy counting statements and the result rows handed to Python."""
+
+    def __init__(self, conn):
+        self.conn, self.statements, self.rows = conn, 0, 0
+
+    def execute(self, sql, params=()):
+        self.statements += 1
+        return _Cursor(self.conn.execute(sql, params), self)
+
+    def __getattr__(self, name):
+        return getattr(self.conn, name)
+
+
+def _old_local_wait_rows(conn, task_ids):
+    """``_local_wait_rows`` before: one row per parked card, newest park event grouped over ``idx_events_task``."""
+    from hermes_cli.kanban_table_columns import table_columns
+
+    ids = [str(t) for t in dict.fromkeys(task_ids)]
+    cols = table_columns(conn, "tasks")
+    pick = ", ".join(f"t.{c}" if c in cols else f"NULL AS {c}" for c in ("id", "status", "block_kind", "human_request",
+                                                                          "awaiting"))
+    parked = {}
+    for tid, status, kind, request, awaiting in conn.execute(
+            f"SELECT {pick} FROM tasks t WHERE t.id IN (SELECT value FROM json_each(?)) "
+            "AND t.status IN ('scheduled', 'blocked', 'triage')", (json.dumps(ids),)):
+        parked[str(tid)] = (status, kind, request, awaiting)
+    if not parked:
+        return {}, {}
+    events = {}
+    kph = ",".join("?" for _ in kwi.PARK_EVENT_KINDS)
+    for tid, kind, payload, at in conn.execute(
+            "SELECT e.task_id, e.kind, e.payload, e.created_at FROM task_events e WHERE e.id IN ("
+            "SELECT MAX(id) FROM task_events WHERE task_id IN (SELECT value FROM json_each(?)) "
+            f"AND kind IN ({kph}) GROUP BY task_id)", (json.dumps(list(parked)), *kwi.PARK_EVENT_KINDS)):
+        events[str(tid)] = (kind, payload, at)
+    return parked, events
+
+
+def _board(n: int) -> sqlite3.Connection:
+    """``n`` cards in every status, each with a mixed event history: several park kinds (the newest is not always
+    the last event), non-park noise, REAL / integer / NULL ``created_at``, NULL and BLOB payloads, a card with no
+    park event at all, and an id the board does not have."""
+    conn = sqlite3.connect(":memory:")
+    conn.executescript(
