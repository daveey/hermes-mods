From 09080c07b8ec5ed0c0b80a10f73221c32fcbe15a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 09:46:24 +0000
Subject: [PATCH] [daveey] pin the passwd account home in the PM runtime bundle
 tests

test_pm_builder_ignores_ambient_uv_configuration[cwd,global] failed on CI run
43580526464 (Python tests 5/8, PR #2974 head 36a4cedf4f) with
"TEST BUG: file I/O against the REAL hermes home: /home/runner/.hermes/cache/uv".

Five whys:
1. uv_cache_path() called os.access() on <account>/.hermes/cache/uv, which the
   home I/O guard refuses.
2. pm.environments.account_home_root() returned the runner's real ~/.hermes.
3. It resolves the account home from the password database
   (hermes_constants._account_home), not Path.home, which is all the test
   moved; and the real ~/.hermes was on tmp_path's filesystem.
4. CI's HERMES_PM_ACCOUNT_SEED=0 does not reach the test: run_tests.sh starts
   pytest under `env -i`, so account seeding is on inside the suite.
5. Whether the runner account has a ~/.hermes is outside the test (runner and
   shard dependent), so the test passed or failed by environment. tests/pm's
   conftest already pins _account_home; tests/scripts has no such fixture.

Fix: one _isolate_home() helper for both tests in the file that pins
hermes_constants._account_home to the fake home alongside Path.home,
HERMES_HOME and HERMES_RUNTIME_DIR, and the uv test asserts
account_home_root() is None before staging. Production code is unchanged and
the guard stays strict.

RED: on a worker whose real ~/.hermes shares a device with tmp_path, origin/main
fails both params with the same guard error (/home/ubuntu/.hermes/cache/uv).
GREEN: 3 passed, 1 skipped (windows-only). Mutant (drop the _account_home pin)
fails both params again.
---
 tests/scripts/test_pm_runtime_bundle.py | 24 +++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/tests/scripts/test_pm_runtime_bundle.py b/tests/scripts/test_pm_runtime_bundle.py
index fdd0c397bf..f4233b8f3d 100644
--- a/tests/scripts/test_pm_runtime_bundle.py
+++ b/tests/scripts/test_pm_runtime_bundle.py
@@ -9,12 +9,26 @@ import sys
 import pytest
 
 
-def _exercise_relocated_pm_runtime(tmp_path, monkeypatch):
-    from scripts.bundles import native
+def _isolate_home(tmp_path, monkeypatch):
+    """Move every home PM reads under *tmp_path*, the passwd account's included.
+
+    ``pm.environments.account_home_root`` asks the password database, not ``Path.home``, for the
+    account's ``~/.hermes`` and borrows its uv cache when that home is on tmp_path's filesystem
+    (run_tests.sh's ``env -i`` drops CI's ``HERMES_PM_ACCOUNT_SEED=0``). Whether a runner has that
+    home is outside the test, so pin the account home too: no real home is probed or borrowed.
+    """
+    import hermes_constants
 
+    monkeypatch.setattr(hermes_constants, "_account_home", lambda: tmp_path / "home")
     monkeypatch.setattr(Path, "home", lambda: tmp_path / "home")
     monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
     monkeypatch.setenv("HERMES_RUNTIME_DIR", str(tmp_path / "tools"))
+
+
+def _exercise_relocated_pm_runtime(tmp_path, monkeypatch):
+    from scripts.bundles import native
+
+    _isolate_home(tmp_path, monkeypatch)
     uv = shutil.which("uv")
     assert uv, "the packaging test requires uv"
     root = tmp_path / "build"
@@ -95,10 +109,10 @@ def test_resident_pm_bypasses_windows_redirector_after_move(tmp_path, monkeypatc
 @pytest.mark.parametrize("poison", ["cwd", "global"])
 def test_pm_builder_ignores_ambient_uv_configuration(tmp_path, monkeypatch, poison):
     from pm import stage_manager_runtime
+    from pm.environments import account_home_root
 
-    monkeypatch.setattr(Path, "home", lambda: tmp_path / "home")
-    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
-    monkeypatch.setenv("HERMES_RUNTIME_DIR", str(tmp_path / "tools"))
+    _isolate_home(tmp_path, monkeypatch)
+    assert account_home_root() is None
     monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path / "config"))
     monkeypatch.setenv("APPDATA", str(tmp_path / "config"))
     monkeypatch.chdir(tmp_path)
