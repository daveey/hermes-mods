From 400efdbee178738be01d30ef2e515230592f094e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:28:15 +0000
Subject: [PATCH] [daveey] bound pool evidence after shared blocker wakes

Proof: real wake regression fails before and 39 backlog cases pass after; status-filter mutant fails. Composed preserved-event replay yields 7/1/13/5/0 claims, retaining four vetoes. scripts/check all 20 pass against branch base 4ae71d347129. Shared ready-clock implementation is unchanged.
---
 hermes_cli/kanban_label_backlog.py             | 10 ++++++++++
 .../test_kanban_label_backlog_wait.py          | 18 ++++++++++++++----
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_label_backlog.py b/hermes_cli/kanban_label_backlog.py
index 4f1d77ef93..de4ed109c3 100644
--- a/hermes_cli/kanban_label_backlog.py
+++ b/hermes_cli/kanban_label_backlog.py
@@ -71,6 +71,16 @@ def read(conn: sqlite3.Connection, task_id: str, labels: Iterable[str], *,
         from hermes_cli.kanban_parent_unclaimed import ready_since
         created = conn.execute("SELECT created_at FROM tasks WHERE id = ?", (task_id,)).fetchone()[0]
         since = max(now - WINDOW_SECONDS, ready_since(conn, task_id, created))
+        # Shared-blocker retirement on an already-ready card has no status; only _wake's
+        # explicit ready transition starts a new claim-evidence window. Keep this local
+        # to the capability guard, without changing the shared notice-age clock.
+        from hermes_cli import kanban_db as kb
+        for event in conn.execute(
+            "SELECT created_at, payload FROM task_events WHERE task_id=? AND kind='shared_blocker_cleared'",
+            (task_id,),
+        ):
+            if kb._json_dict(event[1]).get("status") == "ready":
+                since = max(since, event[0])
         before = set(ordered[:ordered.index(task_id)])
         ahead = sum(row[0] in before and _labels(row[1]) == wanted for row in conn.execute(
             "SELECT id, runs_on FROM tasks WHERE status = 'ready' AND claim_lock IS NULL"))
diff --git a/tests/hermes_cli/test_kanban_label_backlog_wait.py b/tests/hermes_cli/test_kanban_label_backlog_wait.py
index 3a28354361..71d8f9d5a9 100644
--- a/tests/hermes_cli/test_kanban_label_backlog_wait.py
+++ b/tests/hermes_cli/test_kanban_label_backlog_wait.py
@@ -227,16 +227,26 @@ def test_update_hold_takes_precedence_over_recent_pool_claims(hub):
     assert "Not a placement problem" not in text
 
 
-def test_claims_before_current_ready_episode_do_not_veto_capability_drop(hub):
+@pytest.mark.parametrize("transition", ["continued", "shared_blocker_wake", "clear_already_ready"])
+def test_claims_before_current_ready_episode_do_not_veto_capability_drop(hub, transition):
     from hermes_cli import kanban_label_backlog as klb
     tid = _seed(hub.conn, claims=1)
     now = int(time.time())
     with kb.write_txn(hub.conn):
         hub.conn.execute("UPDATE task_events SET created_at=? WHERE kind='claimed'", (now - 60,))
-        kb._append_event(hub.conn, tid, "continued", {"status": "ready"})
+        if transition == "shared_blocker_wake":
+            from hermes_cli import kanban_wake_check as kwc
+            hub.conn.execute("UPDATE tasks SET status='scheduled' WHERE id=?", (tid,))
+            assert kwc._wake(hub.conn, tid, "shared_blocker_cleared", {"blocker_id": "quota"})
+        elif transition == "clear_already_ready":
+            kb._append_event(hub.conn, tid, "shared_blocker_cleared", {"blocker_id": "quota"})
+        else:
+            kb._append_event(hub.conn, tid, "continued", {"status": "ready"})
     result = klb.read(hub.conn, tid, LABELS, machines={"worker-3"}, now=now)
-    assert result["known"] and result["claimed_recent"] == 0
-    assert klb.move_refusal(hub.conn, tid, "ready", LABELS, ["pool:worker"], machines=POOL, now=now) is None
+    expected = 1 if transition == "clear_already_ready" else 0
+    assert result["known"] and result["claimed_recent"] == expected
+    refusal = klb.move_refusal(hub.conn, tid, "ready", LABELS, ["pool:worker"], machines=POOL, now=now)
+    assert bool(refusal) == bool(expected)
     with kb.write_txn(hub.conn):
         hub.conn.execute("UPDATE task_events SET created_at=? WHERE kind='claimed'", (now,))
     assert klb.move_refusal(hub.conn, tid, "ready", LABELS, ["pool:worker"], machines=POOL, now=now)
-- 
