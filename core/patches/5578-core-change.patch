diff --git a/tests/hermes_cli/test_plugin_validate_private_imports.py b/tests/hermes_cli/test_plugin_validate_private_imports.py
index aa21570566..d072438e36 100644
--- a/tests/hermes_cli/test_plugin_validate_private_imports.py
+++ b/tests/hermes_cli/test_plugin_validate_private_imports.py
@@ -101,6 +101,24 @@ def test_platform_plugin_seams_are_public_and_exist(tmp_path):
     assert _private_warnings(validate_plugin_dir(plugin)) == []
 
 
+def test_kanban_pure_validation_exports_are_name_scoped(tmp_path):
+    """Publish validation, not routing or a whole-module exemption."""
+    from hermes_cli import kanban_model_neutral as neutral
+
+    names = ("validate_selector", "validate_text", "validate_review")
+    assert all(callable(getattr(neutral, name)) for name in names)
+    imports = "".join(f"from hermes_cli.kanban_model_neutral import {name}\n" for name in names)
+    assert _private_warnings(validate_plugin_dir(_plugin(tmp_path / "validation", {"view.py": imports}))) == []
+    private = _plugin(tmp_path / "routing", {"view.py": (
+        "from hermes_cli.kanban_model_neutral import effective_selector, routing_view\n"
+        "import hermes_cli.kanban_model_neutral\n"
+    )})
+    [warning] = _private_warnings(validate_plugin_dir(private))
+    for name in ("effective_selector", "routing_view"):
+        assert f"hermes_cli.kanban_model_neutral.{name}" in warning
+    assert "view.py:2 hermes_cli.kanban_model_neutral" in warning
+
+
 _SKILL_CATALOG_SEAMS = (
     ("tools.skills_tool", "find_all_skills"), ("tools.skills_tool", "sort_skills"),
     ("tools.skills_tool", "skill_search_dirs"), ("tools.skills_tool", "locate_skill"),
diff --git a/tests/plugins/test_kanban_model_neutral_entries.py b/tests/plugins/test_kanban_model_neutral_entries.py
index eb4fc31752..bfb3d96d6c 100644
--- a/tests/plugins/test_kanban_model_neutral_entries.py
+++ b/tests/plugins/test_kanban_model_neutral_entries.py
@@ -34,6 +34,39 @@ def test_rest_patch_refuses_before_other_fields(client,conn,payload):
     assert 'model-neutral' in response.text
     assert tuple(conn.execute('SELECT * FROM tasks WHERE id=?',(tid,)).fetchone())==before
 
+@pytest.mark.parametrize('payload', [
+    {'model_override': 'gpt-6.1-sol', 'provider_override': 'openai-codex'},
+    {'body': 'require_model: true'},
+    {'status': 'review', 'metadata': {'review_model': 'gpt-6.1-sol', 'review_provider': 'openai-codex'}},
+])
+def test_invalid_mixed_patch_preserves_all_fields_and_history(client, conn, payload):
+    tid = kb.create_task(conn, title='original', body='original body', assignee='default')
+    before = tuple(conn.execute('SELECT * FROM tasks WHERE id=?', (tid,)).fetchone())
+    events = [tuple(row) for row in conn.execute('SELECT * FROM task_events WHERE task_id=?', (tid,))]
+    response = client.patch('/api/plugins/kanban/tasks/' + tid, json={
+        'assignee': '', 'status': 'triage', 'priority': 1, 'body': 'replacement', **payload,
+    })
+    assert response.status_code == 400, response.text
+    assert 'model-neutral' in response.text
+    assert tuple(conn.execute('SELECT * FROM tasks WHERE id=?', (tid,)).fetchone()) == before
+    assert [tuple(row) for row in conn.execute('SELECT * FROM task_events WHERE task_id=?', (tid,))] == events
+
+
+@pytest.mark.parametrize('selector', [{}, {'model_override': 'class:deep', 'provider_override': 'auto'}])
+def test_valid_neutral_mixed_patch_succeeds(client, conn, selector):
+    tid = kb.create_task(conn, title='original', assignee='default')
+    response = client.patch('/api/plugins/kanban/tasks/' + tid, json={
+        'assignee': '', 'status': 'triage', 'priority': 1, 'body': 'Use tools and an eligible reviewer.', **selector,
+    })
+    assert response.status_code == 200, response.text
+    stored = kb.get_task(conn, tid)
+    assert stored is not None
+    assert stored.assignee is None and stored.status == 'triage' and stored.priority == 1
+    assert stored.body == 'Use tools and an eligible reviewer.'
+    assert stored.model_override == selector.get('model_override')
+    assert stored.provider_override == selector.get('provider_override')
+
+
 @pytest.mark.parametrize('payload',[
     {'model':'gpt-6.1-sol','provider':'openai-codex'},
     {'pin_mandatory':True},
