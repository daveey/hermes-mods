+    "plugins/kanban/dashboard/board_counts.py hermes_cli.kanban_task_change": 1,
     "plugins/kanban/dashboard/board_diagnostics.py hermes_cli.kanban_diagnostics": 1,
+    "plugins/kanban/dashboard/board_incremental.py hermes_cli.kanban_activity_revision.BOOKKEEPING_COLUMNS": 1,
