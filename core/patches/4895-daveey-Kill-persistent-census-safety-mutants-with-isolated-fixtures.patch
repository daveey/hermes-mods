From 1d3119776143992bc2e4f53f5951855b97534b97 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:19:00 +0000
Subject: [PATCH] [daveey] Kill persistent census safety mutants with isolated
 fixtures

Proof: 70 targeted tests pass. Removing the empty-census hold fails populated-zero fixture; moving stamp after census fails slow-census fixture. Add exact count/age boundaries and early-clock timestamp types. Clarify that occupied scope counts include active cards.
---
 hermes_cli/machine_persistent_jobs.py         |  3 +-
 .../test_machine_persistent_jobs.py           | 29 ++++++++++++++-----
 2 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/machine_persistent_jobs.py b/hermes_cli/machine_persistent_jobs.py
index 25246dafaabef6452b0d4bdc898373214adc5d5a..4e7154f91cf4b5043d7203a4e52fe4a4e85689b5 100644
--- a/hermes_cli/machine_persistent_jobs.py
+++ b/hermes_cli/machine_persistent_jobs.py
@@ -1,6 +1,7 @@
 """Conservative persistent-work observations, independent of CPU admission.
 
-A populated worker scope is positive evidence of occupied work (a lower bound).
+A populated worker scope is positive evidence of occupied work (a lower bound),
+including ordinary active cards as well as detached or parked jobs.
 An empty pool is NOT a complete census: unscoped jobs, app.slice descendants and
 in-process baseline work are not accounted for. Until that census is available,
 this producer deliberately never emits zero. Missing means UNKNOWN, not idle.
diff --git a/tests/hermes_cli/test_machine_persistent_jobs.py b/tests/hermes_cli/test_machine_persistent_jobs.py
index 010ee10ee85c70b391cc8037a5caf223e3321a60..35f398d8fbabd369ff1b64eaa7a931b0bb92a855 100644
--- a/tests/hermes_cli/test_machine_persistent_jobs.py
+++ b/tests/hermes_cli/test_machine_persistent_jobs.py
@@ -25,11 +25,13 @@ def test_policy_off_still_observes_populated_detached_scope(tmp_path, monkeypatc
 @pytest.mark.parametrize('events', ['populated 0\n', 'populated bad\n', 'frozen 0\n', None])
 def test_empty_or_unreadable_pool_never_proves_unscoped_work_absent(tmp_path, monkeypatch, events):
     from hermes_cli import machine_persistent_jobs as jobs, worker_compute_capacity as capacity
-    scope = tmp_path / 'parked.scope'
+    pool = tmp_path / 'pool'
+    pool.mkdir()
+    scope = pool / 'parked.scope'
     scope.mkdir()
     if events is not None:
         (scope / 'cgroup.events').write_text(events)
-    monkeypatch.setattr(capacity, 'pool_path', lambda: tmp_path)
+    monkeypatch.setattr(capacity, 'pool_path', lambda: pool)
     assert jobs.collect() == {}
 
 
@@ -43,10 +45,11 @@ def test_sender_drops_invalid_or_old_observation_without_restamping(monkeypatch,
     assert seen == [{'active_card_runs': 0}]
 
 
-def test_sender_keeps_fresh_observation_stamp(monkeypatch):
+@pytest.mark.parametrize('count,stamp', [(0, 9000), (100000, 8000)])
+def test_sender_keeps_fresh_observation_stamp(monkeypatch, count, stamp):
     from hermes_cli import machine_persistent_jobs as jobs
     monkeypatch.setattr(jobs.time, 'time', lambda: 10)
-    sample = {'persistent_jobs': 0, 'persistent_jobs_at_ms': 9000}
+    sample = {'persistent_jobs': count, 'persistent_jobs_at_ms': stamp}
     seen = []
     drain.send_compatible(seen.append, sample)
     assert seen == [sample]
@@ -81,13 +84,25 @@ def test_bad_count_drops_whole_pair(monkeypatch, count):
     assert jobs.fresh({'persistent_jobs': count, 'persistent_jobs_at_ms': 1000}) == {}
 
 
+@pytest.mark.parametrize('stamp', [True, 0, -1, 1.0])
+def test_stamp_type_and_positive_bound_at_early_clock(monkeypatch, stamp):
+    from hermes_cli import machine_persistent_jobs as jobs
+    monkeypatch.setattr(jobs.time, 'time', lambda: 1)
+    assert jobs.fresh({'persistent_jobs': 1, 'persistent_jobs_at_ms': stamp}) == {}
+
+
 @pytest.mark.platforms('linux')
 def test_slow_census_drops_observation(tmp_path, monkeypatch):
     from hermes_cli import machine_persistent_jobs as jobs, worker_compute_capacity as capacity
     monkeypatch.setattr(capacity, 'pool_path', lambda: tmp_path)
-    monkeypatch.setattr(capacity, 'occupied_owners', lambda *args: {('board', 'job')})
-    times = iter([1, 3.001])
-    monkeypatch.setattr(jobs.time, 'time', lambda: next(times))
+    clock = [1.0]
+
+    def slow_census(*args):
+        clock[0] += 2.001
+        return {('board', 'job')}
+
+    monkeypatch.setattr(capacity, 'occupied_owners', slow_census)
+    monkeypatch.setattr(jobs.time, 'time', lambda: clock[0])
     assert jobs.collect() == {}
 
 
