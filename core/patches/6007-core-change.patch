From e298d1c0a17e2d16e10d146791acc65c88e6d27d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 20:42:38 +0000
Subject: [PATCH 6007] Kanban dispatcher: bounded storage waits and typed verdicts

Public mirror of source commit e298d1c0a17e2d16e10d146791acc65c88e6d27d.

---
diff --git a/hermes_cli/kanban_dispatch_verdict.py b/hermes_cli/kanban_dispatch_verdict.py
index 7a7286459cd..60ce6f85bdd 100644
--- a/hermes_cli/kanban_dispatch_verdict.py
+++ b/hermes_cli/kanban_dispatch_verdict.py
@@ -6,10 +6,11 @@
 
 
 def claim_refused(result, task_id, deferral) -> None:
-    """Classify an unacquired claim without duplicating a claim-quiet refusal."""
+    """Classify an unacquired claim without duplicating a claim-quiet or capsule refusal."""
     if deferral is not None:
         result.claim_deferred.append((task_id, deferral))
-    elif not any(tid == task_id for tid, _ in result.quiet_deferred):
+    elif not any(tid == task_id for tid, _ in result.quiet_deferred) and not any(
+            tid == task_id for tid, _ in result.capsule_refused):  # record_claim_refusal already reported it
         result.claim_deferred.append((task_id, 'claim_not_acquired'))
 
 
diff --git a/tests/hermes_cli/test_kanban_capsule_claim_race.py b/tests/hermes_cli/test_kanban_capsule_claim_race.py
index d489f113175..6b0a41d3849 100644
--- a/tests/hermes_cli/test_kanban_capsule_claim_race.py
+++ b/tests/hermes_cli/test_kanban_capsule_claim_race.py
@@ -87,6 +87,16 @@
     _assert_refused_without_effects(env, tid, result, code, "ready", escape)
 
 
+@pytest.mark.parametrize("case", ["workspace", "assignee", "project", "closed"])
+def test_claim_time_capsule_refusal_is_not_also_reported_as_board_deferral(env, monkeypatch, case):
+    handle, tid = _admitted(env)
+    mutate, code, _escape = _mutations(env, handle, tid)[case]
+    _mutate_before_claim(monkeypatch, mutate)
+    result = kbd.dispatch_once(env.conn, spawn_fn=env.spawn, dispatcher_id=OWNER)
+    assert result.capsule_refused == [(tid, code)]
+    assert [d for d in result.claim_deferred if d[0] == tid] == []  # no 'claim_not_acquired' shadow
+
+
 @pytest.mark.parametrize("case", ["workspace", "assignee", "closed"])
 def test_review_row_mutated_between_admission_and_claim_is_refused(env, monkeypatch, case):
     monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: True)
