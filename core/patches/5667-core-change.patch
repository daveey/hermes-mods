From e3eca4e6126e9206c2417926e4dd034b22f3f6d1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 21:56:41 +0000
Subject: [PATCH] [daveey] Add fenced owner transaction for recorded card
 answers

Prepare a library-only exact-ask transition for remote Desktop answers. Require independently verified source operation evidence, fence the current generation inside the core transition, and retain event-backed idempotency receipts. No public tool or courier route is exposed yet.

Proof: canonical test_kanban_card_answer.py passes; code-health gate passes. Courier source proof, relayed-comment provenance, remote mirror and live Desktop verification remain in the owning P3b card.
---
 hermes_cli/kanban_card_answer.py            | 132 +++++++++++++++
 tests/hermes_cli/test_kanban_card_answer.py | 175 ++++++++++++++++++++
 2 files changed, 307 insertions(+)
 create mode 100644 hermes_cli/kanban_card_answer.py
 create mode 100644 tests/hermes_cli/test_kanban_card_answer.py

diff --git a/hermes_cli/kanban_card_answer.py b/hermes_cli/kanban_card_answer.py
new file mode 100644
index 0000000000..4e30c7fcb0
--- /dev/null
+++ b/hermes_cli/kanban_card_answer.py
@@ -0,0 +1,132 @@
+"""Exact-ask owner transition for a verified remote Desktop decision. [daveey]
+
+The courier authenticates the sender and reads the operation from its source
+store. An envelope is routing input, never proof that the user answered. This
+module deliberately has no tool or generic CLI entry point.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Callable
+
+from hermes_cli import kanban_db as kb
+
+FIELD = "card_answer"
+LIFECYCLE = ("created", "blocked", "block_loop_detected", "unblocked", "archived", "completed")
+
+
+class AnswerRefused(ValueError):
+    """A stale, conflicting or unverified answer must leave the card untouched."""
+
+
+def encoded(value) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+
+
+def digest(value) -> str:
+    return hashlib.sha256(encoded(value).encode()).hexdigest()
+
+
+def snapshot(conn, task: str) -> dict | None:
+    """Portable frozen ask; local integer event ids must never cross gateways.
+
+    Synced events have UUID identities. Unsynced fixtures retain local ids, but
+    cannot be delivered remotely without the adapter's independent owner check.
+    """
+    row = conn.execute("SELECT * FROM tasks WHERE id=?", (task,)).fetchone()
+    if row is None or row["status"] not in ("blocked", "triage"):
+        return None
+    try:
+        ask = json.loads(row["human_request"] or "null")
+    except (ValueError, TypeError):
+        return None
+    if not isinstance(ask, dict) or not ask.get("action"):
+        return None
+    marks = ",".join("?" for _ in LIFECYCLE)
+    events = conn.execute(
+        f"SELECT * FROM task_events WHERE task_id=? AND kind IN ({marks}) ORDER BY id",
+        (task, *LIFECYCLE),
+    ).fetchall()
+    # Include the complete lifecycle identity set, not importer-local ordering.
+    # A repeated identical block therefore has a distinct generation on replicas.
+    identities = sorted(str(e["uid"]) if "uid" in e.keys() and e["uid"] else f"local:{e['id']}"
+                        for e in events)
+    return {"task": task, "status": row["status"], "ask": ask,
+            "generation": digest({"lifecycle": identities, "ask": ask, "status": row["status"]})}
+
+
+def _receipt(conn, task, operation_id, fingerprint):
+    for row in conn.execute(
+        "SELECT payload FROM task_events WHERE task_id=? AND kind IN ('unblocked','archived') ORDER BY id DESC",
+        (task,),
+    ):
+        payload = json.loads(row[0] or "{}")
+        receipt = payload.get(FIELD) if isinstance(payload, dict) else None
+        if not isinstance(receipt, dict) or receipt.get("operationId") != operation_id:
+            continue
+        if receipt.get("fingerprint") != fingerprint:
+            raise AnswerRefused("operation_conflict")
+        return receipt
+    return None
+
+
+def apply(conn, request: dict, *, owner_gateway: str, owner_profile: str, board: str,
+          verify_source: Callable[[dict], dict]) -> dict:
+    """Apply only after independent source-operation and owner verification.
+
+    ``verify_source`` is a trusted adapter callback, NOT an envelope field. It
+    reads an immutable recorded Desktop operation from the authenticated sending
+    gateway and returns its exact target/decision fields. Network evidence is
+    acquired before taking the board lock; the exact ask is rechecked under it.
+    The transition API owns its transaction and post-commit archive cleanup.
+    """
+    fields = {"ownerGateway", "ownerProfile", "board", "task", "generation", "choice", "operationId"}
+    if not isinstance(request, dict) or set(request) != fields:
+        raise AnswerRefused("invalid_answer")
+    if any(not isinstance(request[k], str) or not request[k] for k in fields):
+        raise AnswerRefused("invalid_answer")
+    if (request["ownerGateway"] != owner_gateway or request["ownerProfile"] != owner_profile
+            or request["board"] != board or len(request["operationId"]) > 200
+            or len(request["choice"]) > 2000 or len(request["generation"]) != 64):
+        raise AnswerRefused("invalid_answer")
+    fingerprint = digest(request)
+    old = _receipt(conn, request["task"], request["operationId"], fingerprint)
+    if old:
+        return old
+    # Replays of committed decisions do not depend on a now-offline origin.
+    # Fresh applications never accept caller-supplied proof or a bare boolean.
+    proof = verify_source(dict(request))
+    if not isinstance(proof, dict) or proof.get("answer") != request or proof.get("recorded") is not True:
+        raise AnswerRefused("unverified_user_decision")
+    origin = proof.get("gateway")
+    if not isinstance(origin, str) or not origin:
+        raise AnswerRefused("unverified_user_decision")
+    current = snapshot(conn, request["task"])
+    if current is None or current["generation"] != request["generation"]:
+        raise AnswerRefused("stale_ask")
+    options = current["ask"].get("choices") or [
+        {"label": "Unblock", "value": "unblock"}, {"label": "Archive", "value": "archive"},
+    ]
+    choices = [ch for ch in options if isinstance(ch, dict) and ch.get("value") == request["choice"]]
+    if len(choices) != 1:
+        raise AnswerRefused("unknown_choice")
+    archive = not current["ask"].get("choices") and request["choice"] == "archive"
+    receipt = {**request, "originGateway": origin, "fingerprint": fingerprint,
+               "destination": "kanban_ask", "executionStarted": False,
+               "decisionProvenance": "recorded_desktop_operation"}
+    note = "Choice recorded in Desktop (remote): " + encoded(choices[0]) + "\nOperation: " + request["operationId"]
+
+    def fence(c):
+        if _receipt(c, request["task"], request["operationId"], fingerprint):
+            return "already_recorded"
+        fresh = snapshot(c, request["task"])
+        return None if fresh == current else "stale_ask"
+
+    transition = kb.archive_task if archive else kb.unblock_task
+    transition(conn, request["task"], precondition=fence, comment=("user-steps", note),
+               event_extra={FIELD: receipt})
+    recorded = _receipt(conn, request["task"], request["operationId"], fingerprint)
+    if not recorded:
+        raise AnswerRefused("ask_changed_or_held")
+    return recorded
diff --git a/tests/hermes_cli/test_kanban_card_answer.py b/tests/hermes_cli/test_kanban_card_answer.py
new file mode 100644
index 0000000000..0245efa382
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_card_answer.py
@@ -0,0 +1,175 @@
+"""Owner-side exact ask transitions, with a real disposable core board. [daveey]"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_card_answer as ca
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli import test_kanban_awaiting as helpers
+
+kanban_home = helpers.kanban_home
+
+
+def setup_answer(conn, *, choices=True):
+    tid = helpers._human_blocked(conn)
+    if choices:
+        with kb.write_txn(conn):
+            hr = json.loads(conn.execute("SELECT human_request FROM tasks WHERE id=?", (tid,)).fetchone()[0])
+            hr["choices"] = [{"label": "Apply plan A", "value": "plan-a"}, {"label": "Apply plan B", "value": "plan-b"}]
+            conn.execute("UPDATE tasks SET human_request=? WHERE id=?", (json.dumps(hr), tid))
+    return {"ownerGateway": "owner", "ownerProfile": "default", "board": "default", "task": tid,
+            "generation": ca.snapshot(conn, tid)["generation"],
+            "choice": "plan-a" if choices else "unblock", "operationId": "desktop-operation-one"}
+
+
+def verified(request):
+    return {"gateway": "origin", "recorded": True, "answer": request}
+
+
+def apply(conn, request, verify=verified):
+    return ca.apply(conn, request, owner_gateway="owner", owner_profile="default", board="default",
+                    verify_source=verify)
+
+
+def comments(conn, tid):
+    return [tuple(r) for r in conn.execute("SELECT author,body FROM task_comments WHERE task_id=?", (tid,))]
+
+
+def test_atomic_answer_and_resume_with_readback(kanban_home):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        before = comments(conn, req["task"])
+        receipt = apply(conn, req)
+        task = kb.get_task(conn, req["task"])
+        assert task.status == "ready" and task.human_request is None
+        assert comments(conn, req["task"])[len(before):] == [(
+            "user-steps", 'Choice recorded in Desktop (remote): {"label":"Apply plan A","value":"plan-a"}\nOperation: desktop-operation-one')]
+        event = [e for e in kb.list_events(conn, req["task"]) if e.kind == "unblocked"][-1]
+        assert event.payload[ca.FIELD] == receipt
+        assert receipt["operationId"] == req["operationId"] and receipt["choice"] == "plan-a"
+
+
+def test_exact_replay_after_commit_without_origin(kanban_home):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        first = apply(conn, req)
+        before = (comments(conn, req["task"]), len(kb.list_events(conn, req["task"])))
+        def offline(_):
+            pytest.fail("committed operation must not require origin online")
+        assert apply(conn, req, offline) == first
+        assert before == (comments(conn, req["task"]), len(kb.list_events(conn, req["task"])))
+        with pytest.raises(ca.AnswerRefused, match="operation_conflict"):
+            apply(conn, dict(req, choice="plan-b"))
+
+
+@pytest.mark.parametrize("change", ["ask", "cycle"])
+def test_stale_generation_never_comments_or_clears_hold(kanban_home, change):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        with kb.write_txn(conn):
+            if change == "ask":
+                conn.execute("UPDATE tasks SET human_request=json_set(human_request,'$.action','A new ask') WHERE id=?", (req["task"],))
+            else:
+                kb._append_event(conn, req["task"], "blocked", {"reason": "same ask, new block"})
+        before = (comments(conn, req["task"]), len(kb.list_events(conn, req["task"])))
+        with pytest.raises(ca.AnswerRefused, match="stale_ask"):
+            apply(conn, req)
+        assert kb.get_task(conn, req["task"]).status == "blocked"
+        assert kb.get_task(conn, req["task"]).human_request
+        assert before == (comments(conn, req["task"]), len(kb.list_events(conn, req["task"])))
+
+
+@pytest.mark.parametrize("proof", [None, True, {}, {"recorded": False}, {"recorded": True, "answer": {}}])
+def test_bare_gateway_or_caller_claim_does_not_clear_human_hold(kanban_home, proof):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        before = comments(conn, req["task"])
+        with pytest.raises(ca.AnswerRefused, match="unverified_user_decision"):
+            apply(conn, req, lambda _: proof)
+        assert kb.get_task(conn, req["task"]).status == "blocked"
+        assert kb.get_task(conn, req["task"]).human_request
+        assert comments(conn, req["task"]) == before
+
+
+def test_fence_rechecks_after_source_read(kanban_home):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        def source(request):
+            with kb.write_txn(conn):
+                conn.execute("UPDATE tasks SET human_request=json_set(human_request,'$.action','new question') WHERE id=?", (req["task"],))
+            return verified(request)
+        with pytest.raises(ca.AnswerRefused, match="stale_ask"):
+            apply(conn, req, source)
+        assert not any("Choice recorded" in body for _, body in comments(conn, req["task"]))
+
+
+def test_transition_refusal_rolls_back_choice_comment(kanban_home, monkeypatch):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        before = comments(conn, req["task"])
+        monkeypatch.setattr(kb, "_landing_status_after_parents", lambda *_: (_ for _ in ()).throw(RuntimeError("commit failed")))
+        with pytest.raises(RuntimeError, match="commit failed"):
+            apply(conn, req)
+        assert comments(conn, req["task"]) == before
+        assert kb.get_task(conn, req["task"]).status == "blocked"
+        assert not any(e.kind == "unblocked" for e in kb.list_events(conn, req["task"]))
+
+
+def test_archive_default_choice_uses_archive_transition(kanban_home):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn, choices=False)
+        req["choice"] = "archive"
+        receipt = apply(conn, req)
+        assert kb.get_task(conn, req["task"]).status == "archived"
+        assert apply(conn, req) == receipt
+
+
+def test_under_lock_fence_rechecks_after_preflight(kanban_home, monkeypatch):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        original = kb.unblock_task
+        def raced(c, task, **kwargs):
+            with kb.write_txn(c):
+                c.execute("UPDATE tasks SET human_request=json_set(human_request,'$.action','new under-lock ask') WHERE id=?", (task,))
+            return original(c, task, **kwargs)
+        monkeypatch.setattr(kb, "unblock_task", raced)
+        with pytest.raises(ca.AnswerRefused, match="ask_changed_or_held"):
+            apply(conn, req)
+        assert kb.get_task(conn, req["task"]).status == "blocked"
+        assert not any("Choice recorded" in body for _, body in comments(conn, req["task"]))
+
+
+def test_terminal_hold_is_not_cleared_by_exact_answer(kanban_home):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        with kb.write_txn(conn):
+            kb._append_event(conn, req["task"], "completed", {"summary": "terminal history precedes stale blocked row"})
+        req["generation"] = ca.snapshot(conn, req["task"])["generation"]
+        before = comments(conn, req["task"])
+        with pytest.raises(ca.AnswerRefused, match="ask_changed_or_held"):
+            apply(conn, req)
+        assert comments(conn, req["task"]) == before
+        assert kb.get_task(conn, req["task"]).human_request
+        assert not any(e.kind == "unblocked" for e in kb.list_events(conn, req["task"]))
+
+
+@pytest.mark.parametrize("field", ["ownerGateway", "ownerProfile", "board"])
+def test_wrong_namespace_is_refused_before_source_read(kanban_home, field):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        def not_called(_):
+            pytest.fail("wrong owner namespace must not request authority")
+        with pytest.raises(ca.AnswerRefused, match="invalid_answer"):
+            apply(conn, dict(req, **{field: "other"}), not_called)
+        assert kb.get_task(conn, req["task"]).status == "blocked"
+
+
+def test_unknown_choice_refused(kanban_home):
+    with kbc.connect_closing() as conn:
+        req = setup_answer(conn)
+        with pytest.raises(ca.AnswerRefused, match="unknown_choice"):
+            apply(conn, dict(req, choice="invented"))
+        assert kb.get_task(conn, req["task"]).status == "blocked"
