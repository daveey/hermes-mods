From d27ca49277fc882dc48f60d7e4cb36e4631c53a2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:46:45 +0000
Subject: [PATCH] [daveey] kanban_worker_shell: pin plain-card worker-shell
 completion; document descends_from_live_pid's int() coercion

PR #1830 review nits (t_01a1d2bf365f2c6e):

- tests/tools/test_kanban_review_contract.py: a plain, non-review card's proven worker shell completes its own
  live-claimed run with force=False (run_for's card-agnostic proof). Precondition asserted: the spawn pid is a
  live fingerprinted claim, so without the run id complete_task would raise LiveClaimError. RED: a review-only
  run_for refuses it ("a live worker is running it"); GREEN at main.
- top_level_env.descends_from_live_pid: keep the int() coercion and document it. Pids come from board rows and
  JSON event payloads whose type depends on the writer; the proof is the live-ancestor check on that exact pid,
  so a decimal string vouches for nothing extra, while rejecting it would refuse a real worker shell (or call it
  a leaked env) over serialization alone. tests/hermes_cli/test_leaked_worker_env.py pins str/int acceptance
  (also via _descends_from_live_agent) and False, never TypeError, for None/""/"abc"/"12.5"/0/1/"1"/True/object().
---
 hermes_cli/top_level_env.py                | 11 +++++++++--
 tests/hermes_cli/test_leaked_worker_env.py | 17 +++++++++++++++++
 tests/tools/test_kanban_review_contract.py | 22 ++++++++++++++++++++--
 3 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/top_level_env.py b/hermes_cli/top_level_env.py
index 39a358e86c..072353e0be 100644
--- a/hermes_cli/top_level_env.py
+++ b/hermes_cli/top_level_env.py
@@ -274,8 +274,15 @@ def _is_ancestor(pid: int, start: Optional[int] = None) -> bool:
 
 
 def descends_from_live_pid(pid) -> bool:
-    """Whether this process descends from ``pid`` while it is alive. pid 0/1 (and a non-integer) never
-    count: every process descends from init, so it vouches for nothing. [daveey]"""
+    """Whether this process descends from ``pid`` while it is alive. pid 0/1 never count: every process
+    descends from init, so it vouches for nothing. [daveey]
+
+    ``pid`` is coerced with ``int()``: a decimal string (``"4242"``) is accepted as that pid, and ``None``,
+    ``""`` or anything ``int()`` refuses is ``False`` rather than a ``TypeError``. This is deliberate: callers
+    pass pids read from board rows and JSON event payloads (``worker_bound``, ``tasks.worker_pid``), whose
+    type depends on the writer, and the proof is the live-ancestor check on that exact pid, so accepting
+    its string spelling vouches for nothing extra. Rejecting it would refuse a real worker's shell (or call
+    it a leaked env) over serialization alone."""
     try:
         pid = int(pid or 0)
     except (TypeError, ValueError):
diff --git a/tests/hermes_cli/test_leaked_worker_env.py b/tests/hermes_cli/test_leaked_worker_env.py
index 067d148b49..8775df1612 100644
--- a/tests/hermes_cli/test_leaked_worker_env.py
+++ b/tests/hermes_cli/test_leaked_worker_env.py
@@ -440,3 +440,20 @@ def test_finished_worker_shell_cli_refusal_points_at_kanban_comment(monkeypatch,
     assert "cannot mutate Kanban tasks via the CLI" in text
     assert f"{tid} is done" in text and "kanban_comment" in text
     assert "leaked worker env" not in text and "Cmd-Q" not in text
+
+
+# descends_from_live_pid coerces with int(): pids come from board rows and JSON event payloads whose type depends
+# on the writer, so a decimal string names the same pid (the live-ancestor check is the proof), and an unparseable
+# value is False, never a TypeError.
+
+@pytest.mark.parametrize("spell", [int, str], ids=["int", "str"])
+def test_descends_from_live_pid_accepts_a_pid_or_its_decimal_string(spell):
+    assert tle.descends_from_live_pid(spell(os.getpid())) is True
+    assert tle.descends_from_live_pid(spell(os.getppid())) is True
+    assert tle._descends_from_live_agent({}, spell(os.getppid())) is True
+
+
+@pytest.mark.parametrize("pid", [None, "", "abc", "12.5", 0, 1, "1", True, object()],
+                         ids=["none", "empty", "word", "decimal", "zero", "init", "init_str", "bool", "object"])
+def test_descends_from_live_pid_refuses_init_and_non_numbers_without_raising(pid):
+    assert tle.descends_from_live_pid(pid) is False
diff --git a/tests/tools/test_kanban_review_contract.py b/tests/tools/test_kanban_review_contract.py
index b93424c215..b130b2a01f 100644
--- a/tests/tools/test_kanban_review_contract.py
+++ b/tests/tools/test_kanban_review_contract.py
@@ -433,13 +433,13 @@ WORKER_SESSION = "local-reviewer-session"
 
 
 def _worker_shell_card(kb, monkeypatch, body, *, bound_pid=None, session=WORKER_SESSION, env_session=WORKER_SESSION,
-                       bound=True, spawn=None):
+                       bound=True, spawn=None, title="Independent exact-head review PR1349"):
     """``spawn=(pid, fingerprint)`` records the claim's spawned worker (``tasks.worker_pid``); ``bound=False`` leaves
     the run without a ``worker_bound`` event, so only that spawn pid can prove the shell."""
     import os
     from hermes_cli import kanban_db_connect as kbc
     with kbc.connect() as conn:
-        tid = kb.create_task(conn, title="Independent exact-head review PR1349", body=body, assignee="test-worker")
+        tid = kb.create_task(conn, title=title, body=body, assignee="test-worker")
         kb.claim_task(conn, tid)
         run_id = kb._current_run_id(conn, tid)
         with kb.write_txn(conn):
@@ -474,6 +474,24 @@ def test_cli_from_the_cards_worker_shell_completes_its_own_run(board, monkeypatc
     assert _runs(board, tid) == 1  # no synthesized run
 
 
+# The proof is card-agnostic (run_for's docstring): a plain, non-review card's proven worker shell also gets its run
+# id, so its no---force CLI completion is fenced to that run and closes it instead of hitting the live-claim refusal
+# (the recorded spawn pid is alive with its fingerprint, so without that run id complete_task raises LiveClaimError).
+
+def test_cli_worker_shell_completes_a_plain_card_without_force(board, monkeypatch):
+    import os
+    from hermes_cli import kanban_db_connect as kbc
+    tid, run_id = _worker_shell_card(board, monkeypatch, "Fix the sidebar scroll. Done when its tests pass.",
+                                     title="Fix the sidebar scroll", spawn=(os.getppid(), _fingerprint(os.getppid())))
+    with kbc.connect() as conn:  # precondition: without the run id this completion would be refused
+        assert board._claim_is_live(conn.execute("SELECT * FROM tasks WHERE id = ?", (tid,)).fetchone())
+    assert _cli_complete(tid, {"changed_files": ["a.py"]}, force=False) == 0
+    assert _status(board, tid) == "done"
+    row = _closing_run(board, tid)
+    assert (row["id"], row["outcome"], row["status"]) == (run_id, "completed", "done")
+    assert _runs(board, tid) == 1
+
+
 def _foreign_pid():
     import subprocess
     import sys
