diff --git a/hermes_cli/kanban_actionability_observation.py b/hermes_cli/kanban_actionability_observation.py
new file mode 100644
index 00000000000..8906b07901c
--- /dev/null
+++ b/hermes_cli/kanban_actionability_observation.py
@@ -0,0 +1,116 @@
+"""Authenticated source discovery for explicit administrative recovery. [daveey]
+
+Fail closed on private stop/renewal provenance: execution inventory deliberately
+cannot attest that authority. Canonical ingress still repeats every premise CAS.
+No replica IDs, local clock, source-subset selection or new release permission.
+"""
+from __future__ import annotations
+
+from urllib.parse import quote
+
+from hermes_cli.kanban_actionability import NONTERMINAL
+
+KINDS = {'todo': ('created', 'linked'), 'ready': ('created', 'promoted_manual', 'unblocked', 'reclaimed'),
+         'review': ('review_requested', 'created'), 'blocked': ('blocked',),
+         'scheduled': ('scheduled', 'continued'),
+         'triage': ('failure_finalized', 'spend_budget_decision_ready', 'created'), 'running': ('claimed',)}
+PRIVATE = {'spend_budget_triaged', 'decision_hold_restricted', 'scope_renewed'}
+
+
+def _invalid():
+    return ValueError('complete canonical actionability source unavailable or changed')
+
+
+def _integer(value, minimum=0):
+    return type(value) is int and minimum <= value <= 9007199254740991
+
+
+def _inventory(hub, board, task_id):
+    data = hub._call('GET', f'/v2/boards/{quote(board, safe="")}/tasks/'
+                     f'{quote(task_id, safe="")}/execution-evidence')
+    if (not isinstance(data, dict) or type(data.get('version')) is not int or data['version'] != 1
+            or data.get('board') != board or data.get('task_id') != task_id
+            or not _integer(data.get('head')) or data.get('events_complete') is not True
+            or data.get('runs_complete') is not True or not isinstance(data.get('runs'), list)
+            or not isinstance(data.get('events'), list)):
+        raise _invalid()
+    task = data.get('task')
+    if (not isinstance(task, dict) or task.get('id') != task_id or task.get('uid') != task_id
+            or task.get('deleted_at') is not None
+            or not {'status', 'assignee', 'current_run_uid', 'containment_episode', 'created_on'} <= task.keys()):
+        raise _invalid()
+    uids, orders = set(), set()
+    for event in data['events']:
+        if (not isinstance(event, dict) or not isinstance(event.get('uid'), str) or not event['uid']
+                or event['uid'] in uids or event.get('task_id') != task_id
+                or not _integer(event.get('ord'), 1) or event['ord'] in orders
+                or not _integer(event.get('version'), 1) or not _integer(event.get('created_at'))
+                or event.get('deleted_at') is not None or not isinstance(event.get('kind'), str)
+                or event['kind'] in PRIVATE):
+            raise _invalid()
+        uids.add(event['uid'])
+        orders.add(event['ord'])
+    return data
+
+
+def _links(hub, board, head):
+    """Complete stable-head snapshot, bounded independently of server pagination."""
+    after, links = '', []
+    for _ in range(16):
+        page = hub.snapshot_page(board, 'task_links', after=after, limit=1000)
+        if (not isinstance(page, dict) or page.get('table') != 'task_links' or page.get('head') != head
+                or not isinstance(page.get('rows'), list) or type(page.get('more')) is not bool):
+            raise _invalid()
+        cursor = after
+        for link in page['rows']:
+            if (not isinstance(link, dict) or not isinstance(link.get('uid'), str) or link['uid'] <= cursor
+                    or not isinstance(link.get('child_id'), str) or not isinstance(link.get('parent_id'), str)
+                    or link.get('deleted_at') is not None):
+                raise _invalid()
+            cursor = link['uid']
+            links.append(link)
+        if page.get('next') != cursor or page['more'] and cursor == after:
+            raise _invalid()
+        if not page['more']:
+            return links
+        after = cursor
+    raise _invalid()
+
+
+def observe(hub, board, task_id):
+    """Bounded canonical observation; unavailable authority remains unavailable.
+
+    Every inventory/page shares one head. Busy boards may require a later explicit
+    preview; this does not restart, poll or weaken the complete-snapshot contract.
+    """
+    data = _inventory(hub, board, task_id)
+    task, head = data['task'], data['head']
+    if task['created_on'] != hub.ident.gateway or task['status'] not in NONTERMINAL:
+        raise _invalid()
+    episode = task['containment_episode']
+    allowed = KINDS[task['status']]
+    candidates = [e for e in data['events'] if e['uid'] == episode] if episode else [
+        e for e in data['events'] if e['kind'] in allowed]
+    if not candidates:
+        raise _invalid()  # no invented legacy first-observed clock
+    event = max(candidates, key=lambda e: (e['created_at'], e['ord'], e['uid']))
+    links = _links(hub, board, head)
+    parent_ids = sorted(l['parent_id'] for l in links if l['child_id'] == task_id)
+    if len(parent_ids) > 128 or len(set(parent_ids)) != len(parent_ids):
+        raise _invalid()
+    dependencies, owner_task_refs = [], []
+    for pid in parent_ids:
+        parent = _inventory(hub, board, pid)
+        if parent['head'] != head:
+            raise _invalid()
+        p = parent['task']
+        if pid != task_id and p['status'] in NONTERMINAL:
+            owner_task_refs.append(pid)
+        status = 'triage' if p['status'] in ('done', 'archived') and p['containment_episode'] else p['status']
+        dependencies.append({'id': pid, 'status': status})
+    return {'home_gateway': task['created_on'], 'first_observed': event['created_at'],
+            'owner_task_refs': owner_task_refs,
+            'facts': {'status': task['status'], 'assignee': task['assignee'],
+                      'current_run_uid': task['current_run_uid'], 'root_episode': episode,
+                      'source_uids': [{'uid': event['uid'], 'version': event['version']}],
+                      'dependencies': dependencies}}
diff --git a/hermes_cli/kanban_actionability_receipt.py b/hermes_cli/kanban_actionability_receipt.py
new file mode 100644
index 00000000000..eacaeffc1ce
--- /dev/null
+++ b/hermes_cli/kanban_actionability_receipt.py
@@ -0,0 +1,60 @@
+"""Read-only confirmed escalation custody; notice emission is not delivery. [daveey]"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_actionability_transport as transport
+
+
+def escalation(reader, task, root):
+    """No ACK-only receipt, damaged linkage or unrelated destination clears overdue."""
+    wire = transport.envelope(task['id'], root['payload'], 'escalation')
+    rows = reader.rows('SELECT * FROM kanban_actionability_commands WHERE op_id=?', (wire['client_op_id'],))
+    if len(rows) != 1:
+        return None
+    owned = rows[0]
+    try:
+        if (owned['delivery_state'] != 'confirmed' or owned['phase'] != 'escalation'
+                or owned['task_id'] != task['id'] or owned['contract_key'] != wire['payload']['contract_key']
+                or owned['request_json'] != transport.canonical(wire)
+                or owned['request_sha256'] != transport.digest(owned['request_json'])):
+            return None
+        receipt = json.loads(owned['canonical_receipt_json'])
+        if (not isinstance(receipt, dict) or receipt.get('contract') != wire['payload']
+                or receipt.get('request_uid') != wire['client_op_id']
+                or receipt.get('request_sha256') != owned['request_sha256']
+                or receipt.get('contract_event_uid') != wire['contract_uid']
+                or receipt.get('notice_event_uid') != wire['notice_uid']
+                or receipt.get('home_gateway') != task['created_on']):
+            return None
+        dest = receipt.get('destination')
+        if not isinstance(dest, dict) or set(dest) != {'task_id', 'kind'}:
+            return None
+        owner = wire['payload']['owner']
+        if dest['kind'] == 'task':
+            if owner['kind'] != 'task' or owner['refs'] != [dest['task_id']]:
+                return None
+        elif dest['kind'] not in ('chat', 'unavailable') or dest['task_id'] != task['id']:
+            return None
+        if dest['kind'] == 'chat' and owner['kind'] == 'task':
+            return None
+        outcome = 'route_unavailable' if dest['kind'] == 'unavailable' else 'recorded'
+        expected = {'root_task': task['id'], 'root_episode': wire['payload']['facts']['root_episode'],
+                    'contract_key': wire['payload']['contract_key'], 'contract_event_uid': wire['contract_uid'],
+                    'notice_event_uid': wire['notice_uid'], 'deadline_at': wire['payload']['deadline_at'],
+                    'kind': 'administrative_only'}
+        if receipt.get('outcome') != outcome or receipt.get('envelope') != expected:
+            return None
+        for uid, tid, kind, payload in (
+                (wire['receipt_uid'], task['id'], 'actionability_escalation_recorded', receipt),
+                (wire['notice_uid'], dest['task_id'], 'decision_requested', None)):
+            events = reader.rows('SELECT * FROM task_events WHERE uid=? AND task_id=? AND kind=?', (uid, tid, kind))
+            if (len(events) != 1 or events[0].get('deleted_at') is not None
+                    or events[0]['origin_gateway'] != task['created_on']):
+                return None
+            data = json.loads(events[0]['payload'])
+            if not isinstance(data, dict) or (data != payload if payload is not None else data.get('actionability') != expected):
+                return None
+        return {'state': outcome, 'receipt_uid': wire['receipt_uid']}
+    except (KeyError, TypeError, ValueError):
+        return None
diff --git a/hermes_cli/kanban_actionability_recovery.py b/hermes_cli/kanban_actionability_recovery.py
new file mode 100644
index 00000000000..d162beafd34
--- /dev/null
+++ b/hermes_cli/kanban_actionability_recovery.py
@@ -0,0 +1,148 @@
+"""Explicit frozen administrative obligations; no execution/retry authority. [daveey]"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_actionability_observation as observation
+from hermes_cli import kanban_actionability_transport as transport
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli.kanban_db_connect import write_txn
+
+ACTIONS = {'execute_current_scope', 'review_current_scope', 'satisfy_dependency', 'restore_capability',
+           'decide_scope', 'resolve_release_authority', 'supply_recorded_human_step',
+           'wait_for_named_producer', 'repair_lifecycle_contract'}
+
+
+def _schema(conn):
+    conn.execute('CREATE TABLE IF NOT EXISTS kanban_actionability_previews ('
+                 'op_id TEXT PRIMARY KEY, board TEXT NOT NULL, home_gateway TEXT NOT NULL, '
+                 'request_json TEXT NOT NULL, request_sha256 TEXT NOT NULL, state TEXT NOT NULL)')
+
+
+def _home(conn, hub, board):
+    if conn.in_transaction or sync.board_mode(conn) != 'primary':
+        raise ValueError('recovery requires primary home connection outside writer transaction')
+    state = sync.sync_state(conn) or {}
+    if not isinstance(board, str) or not board or state.get('board_id') != board:
+        raise ValueError('recovery board mismatch with local custody')
+    if state.get('gateway_id') != hub.ident.gateway:
+        raise ValueError('recovery authenticated home differs from local custody')
+
+
+def _text(value, maximum):
+    # JS string length counts UTF-16 code units; reject lone surrogates too.
+    if (not isinstance(value, str) or not value.strip('\ufeff \t\r\n\v\f\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000')
+            or len(value.encode('utf-16-le')) // 2 > maximum):
+        raise ValueError('invalid recovery text or UTF-16 length')
+
+
+def _owner(source, owner):
+    if (not isinstance(owner, dict) or set(owner) != {'kind', 'refs'}
+            or not isinstance(owner['refs'], list) or len(owner['refs']) != 1):
+        raise ValueError('supported accountable recovery owner required')
+    _text(owner['refs'][0], 512)
+    facts = source['facts']
+    if owner['kind'] == 'assignee':
+        valid = owner['refs'] == [facts['assignee']]
+    else:
+        valid = owner['kind'] == 'task' and owner['refs'][0] in source['owner_task_refs']
+    if not valid:
+        raise ValueError('owner unavailable: require exact assignee or canonically linked open parent')
+
+
+def _payload(source, *, owner, action, instruction, prerequisite, trigger, evidence, deadline_at, now):
+    _owner(source, owner)
+    facts = source['facts']
+    if action not in ACTIONS:
+        raise ValueError('unsupported recovery action')
+    for text in (instruction, prerequisite, trigger):
+        _text(text, 1000)
+    if not isinstance(evidence, list) or len(evidence) > 8:
+        raise ValueError('invalid recovery evidence')
+    for text in evidence:
+        _text(text, 512)
+    if (type(deadline_at) is not int or not source['first_observed'] < deadline_at <= now + 14 * 86400
+            or source['first_observed'] > now):
+        raise ValueError('explicit fixed deadline must follow source clock and be within canonical 14-day bound')
+    return {'version': 1, 'facts': facts, 'owner': owner, 'action': action, 'instruction': instruction,
+            'blocker': {'prerequisite': prerequisite, 'trigger': trigger, 'evidence': evidence},
+            'first_observed': source['first_observed'], 'deadline_at': deadline_at, 'legacy': False}
+
+
+def preview(conn, hub, board, task_id, **obligation):
+    """Freeze explicit operator facts without outbox issuance. Never invent a deadline."""
+    _home(conn, hub, board)
+    cap = transport.capability(hub, board)
+    source = observation.observe(hub, board, task_id)
+    payload = _payload(source, **obligation, now=int(cap['hlc'][:13]) // 1000)
+    wire = transport.envelope(task_id, payload)
+    raw = transport.canonical(wire)
+    sha = transport.digest(raw)
+    with write_txn(conn):
+        _schema(conn)
+        old = conn.execute('SELECT * FROM kanban_actionability_previews WHERE op_id=?',
+                           (wire['client_op_id'],)).fetchone()
+        if old:
+            if old['request_json'] != raw or old['board'] != board or old['home_gateway'] != hub.ident.gateway:
+                raise ValueError('recovery preview already frozen with different bytes')
+            if old['state'] != 'previewed':
+                raise ValueError('recovery preview already reserved or stale; use original digest to replay')
+        else:
+            conn.execute('INSERT INTO kanban_actionability_previews VALUES (?,?,?,?,?,?)',
+                         (wire['client_op_id'], board, hub.ident.gateway, raw, sha, 'previewed'))
+    return {'op_id': wire['client_op_id'], 'request_sha256': sha, 'request': wire,
+            'state': 'previewed', 'execution_authority': False, 'issued': False}
+
+
+def _frozen(conn, hub, board, op_id, sha):
+    _home(conn, hub, board)
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE name='kanban_actionability_previews'").fetchone():
+        raise ValueError('recovery preview unavailable')
+    row = conn.execute('SELECT * FROM kanban_actionability_previews WHERE op_id=?', (op_id,)).fetchone()
+    if (not row or row['board'] != board or row['home_gateway'] != hub.ident.gateway
+            or row['request_sha256'] != sha or transport.digest(row['request_json']) != sha):
+        raise ValueError('recovery frozen digest or home mismatch')
+    wire = json.loads(row['request_json'])
+    if transport.envelope(wire['task'], wire['payload']) != wire or wire['client_op_id'] != op_id:
+        raise ValueError('recovery frozen identity mismatch')
+    return dict(row), wire
+
+
+def apply(conn, hub, board, op_id, sha):
+    """Digest confirmation: preflight only before issuance; uncertain sends replay exactly."""
+    row, wire = _frozen(conn, hub, board, op_id, sha)
+    if row['state'] == 'previewed':
+        source = observation.observe(hub, board, wire['task'])
+        p = wire['payload']
+        if (source['home_gateway'] != row['home_gateway'] or source['facts'] != p['facts']
+                or source['first_observed'] != p['first_observed']):
+            with write_txn(conn):
+                conn.execute("UPDATE kanban_actionability_previews SET state='stale' WHERE op_id=? AND state='previewed'",
+                             (op_id,))
+            raise ValueError('recovery source changed; frozen preview is stale, no request issued')
+        _owner(source, p['owner'])
+        transport.capability(hub, board)
+        with write_txn(conn):
+            current = conn.execute('SELECT * FROM kanban_actionability_previews WHERE op_id=?', (op_id,)).fetchone()
+            if dict(current) != row:
+                raise ValueError('recovery preview changed during preflight')
+            transport.reserve(conn, wire['task'], p)
+            conn.execute("UPDATE kanban_actionability_previews SET state='reserved' WHERE op_id=?", (op_id,))
+    elif row['state'] != 'reserved':
+        raise ValueError('recovery preview stale; no request issued')
+    return transport.confirm(conn, hub, board, op_id)
+
+
+def escalate(conn, hub, board, op_id, sha):
+    """Explicit overdue reconsideration, only after independently confirmed root custody."""
+    row, wire = _frozen(conn, hub, board, op_id, sha)
+    root = transport.command(conn, op_id)
+    if (row['state'] != 'reserved' or not root or root['delivery_state'] != 'confirmed'
+            or root['request_json'] != row['request_json'] or root['request_sha256'] != sha):
+        raise ValueError('recovery root custody must be confirmed before escalation')
+    cap = transport.capability(hub, board)
+    escalation = transport.envelope(wire['task'], wire['payload'], 'escalation')
+    transport.escalation_ready(hub, board, escalation, cap)
+    with write_txn(conn):
+        owned = transport.reserve(conn, wire['task'], wire['payload'], phase='escalation')
+    return transport.confirm(conn, hub, board, owned['op_id'])
