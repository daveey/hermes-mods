From 76ff5aa9fa5ea188dcd3126cffd6cd4fe07c3a47 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:02:05 +0000
Subject: [PATCH] fix(tests): pm launch tests ignore a supervisor's child
 marker [daveey]

---
 tests/pm/test_source_update_launch.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/pm/test_source_update_launch.py b/tests/pm/test_source_update_launch.py
index c14d57b248..e5c0994253 100644
--- a/tests/pm/test_source_update_launch.py
+++ b/tests/pm/test_source_update_launch.py
@@ -38,6 +38,10 @@ def source_launch(tmp_path, monkeypatch, isolated_python):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
     monkeypatch.setenv("HERMES_RUNTIME_DIR", str(tmp_path / "store"))
     monkeypatch.delenv("HERMES_DISABLE_LAZY_INSTALLS", raising=False)
+    # A launcher-marked child leaves the completion tail to `hermes update`; these
+    # tests launch as a user's shell does, even when pytest runs under a supervisor.
+    for marker in ("HERMES_SUPERVISED_CHILD", "HERMES_S6_SUPERVISED_CHILD"):
+        monkeypatch.delenv(marker, raising=False)
     monkeypatch.setattr(paths, "lockfile_path", lambda: tmp_path / "tool-lock.json")
 
     uv = shutil.which("uv")
-- 
