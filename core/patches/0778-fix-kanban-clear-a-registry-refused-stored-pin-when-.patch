From 60466c10114f1fc5906714e704dd05633ca8c9ee Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:03:28 +0000
Subject: [PATCH] fix(kanban): clear a registry-refused stored pin when no
 supervisor can take the assignment block [daveey]

A card pinned before enforce_subscription_only (or before the create-time registry
check) sat in ready forever: route_model_mismatch's assignment block raised
AssignmentRoutingError(no_capable_supervisor) with no kanban.orchestrator_profile,
the fallback only logged, and the model_pin_not_in_routing_registry hold is
cap-exempt. Treat the stored pin as history (like resume's stale_managed_pin):
clear it with a model_override_cleared event and a comment, and dispatch on the
profile default in the same tick. Family mismatches, dry runs and successful
supervisor blocks are unchanged; never picks another model or a paid provider.
---
 hermes_cli/kanban_model_assignment.py         |  60 ++++++++-
 .../test_kanban_refused_pin_clear.py          | 117 ++++++++++++++++++
 2 files changed, 174 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_refused_pin_clear.py

diff --git a/hermes_cli/kanban_model_assignment.py b/hermes_cli/kanban_model_assignment.py
index e44bbb9e2e1..c92a8063588 100644
--- a/hermes_cli/kanban_model_assignment.py
+++ b/hermes_cli/kanban_model_assignment.py
@@ -62,7 +62,7 @@ def _check_managed_pin(model, provider, config):
         raise ModelPinNotInRegistryError(model, provider, exc.allowed) from exc
 
 
-def validate_model_assignment(assignee, model, provider):
+def validate_model_assignment(assignee, model, provider, *, check_registry=True):
     """Validate pinned models only; unknown/custom providers and models remain supported.
 
     This is configuration validation, not an entitlement or credential probe. Never
@@ -74,7 +74,8 @@ def validate_model_assignment(assignee, model, provider):
         return
     model = model.strip()
     config = _assignee_config(assignee)
-    _check_managed_pin(model, (provider or '').strip() or None, config)
+    if check_registry:
+        _check_managed_pin(model, (provider or '').strip() or None, config)
     if not provider and assignee:
         if config is None:
             # Non-profile lanes are supported; their executor owns provider selection.
@@ -93,6 +94,15 @@ def validate_model_assignment(assignee, model, provider):
         raise ModelProviderMismatchError(model, provider)
 
 
+def _family_mismatch(assignee, model, provider):
+    """True when the pin fails the vendor/provider family check alone (registry check skipped)."""
+    try:
+        validate_model_assignment(assignee, model, provider, check_registry=False)
+    except ModelProviderMismatchError:
+        return True
+    return False
+
+
 def validate_task_pin(conn, task_id, model, provider):
     """``set_model_override``: validate against the card's assignee, then bind a provider-less pin."""
     from hermes_cli.kanban_db import _reject_spaced_pin
@@ -117,8 +127,45 @@ def dispatch_guard(conn, task_id, *, lane, dry_run=False):
             or check_respawn_guard(conn, task_id, lane=lane))
 
 
+REFUSED_PIN_COMMENT_AUTHOR = 'kanban-dispatcher'
+
+
+def clear_refused_pin(conn, task_id, model, provider, allowed, *, author=REFUSED_PIN_COMMENT_AUTHOR):
+    """[daveey] Drop a stored pin the routing registry refuses; the card runs on the profile default.
+
+    A stored pin is history, not a request (the kanban sibling of resume's ``stale_managed_pin``).
+    Compare-and-swap on the exact pin so a concurrent ``set-model`` wins. Never substitutes another
+    concrete model or a paid provider: clearing is the only repair. Returns True when it cleared.
+    """
+    from hermes_cli import kanban_db as kb
+
+    allowed = list(allowed or [])
+    reason = ModelPinNotInRegistryError.code
+    with kb.write_txn(conn):
+        cur = conn.execute(
+            "UPDATE tasks SET model_override = NULL, provider_override = NULL "
+            "WHERE id = ? AND model_override IS ? AND provider_override IS ? AND status != 'archived'",
+            (task_id, model, provider))
+        if cur.rowcount != 1:
+            return False
+        kb._append_event(conn, task_id, 'model_override_cleared',
+                         {'model': model, 'provider': provider, 'reason': reason, 'allowed': allowed})
+        on = f' on {provider}' if provider else ''
+        kb.add_comment(conn, task_id, author,
+                       f'Model pin {model}{on} was cleared: this host\'s model routing registry refuses it '
+                       f'({reason}; registered: {", ".join(allowed) or "none"}), so its worker could not start. '
+                       'The card now runs on the profile default. Pin a registered model with '
+                       '`hermes kanban set-model` if it needs a specific one.')
+    kb.notify_task_updated(conn, task_id, ('model_override', 'provider_override'))
+    return True
+
+
 def route_model_mismatch(conn, task, *, dry_run=False):
-    """Return a typed guard reason when dispatch needs durable supervisor repair."""
+    """Return a typed guard reason when dispatch needs durable supervisor repair.
+
+    [daveey] When the registry refuses the pin and no supervisor can take the assignment block,
+    clear the pin and return None so this same tick dispatches the card on the profile default
+    (previously it sat ``ready`` behind a cap-exempt hold indefinitely)."""
     from hermes_cli import kanban_db as kb
 
     try:
@@ -130,6 +177,13 @@ def route_model_mismatch(conn, task, *, dry_run=False):
                 kb.block_task(conn, task.id, reason=str(exc), kind='assignment',
                               expected_run_id=task.current_run_id)
             except AssignmentRoutingError as routing_error:
+                if (isinstance(exc, ModelPinNotInRegistryError)
+                        and not _family_mismatch(task.assignee, task.model_override, task.provider_override)
+                        and clear_refused_pin(conn, task.id, task.model_override, task.provider_override,
+                                              exc.allowed)):
+                    kb._log.warning('kanban: cleared refused model pin %s/%s on %s (no supervisor: %s)',
+                                    task.model_override, task.provider_override, task.id, routing_error)
+                    return None
                 # One invalid card must not starve the rest of the board. The
                 # dispatcher records this guard hold; leave recovery agent-owned.
                 kb._log.warning('kanban: model assignment repair for %s: %s', task.id, routing_error)
diff --git a/tests/hermes_cli/test_kanban_refused_pin_clear.py b/tests/hermes_cli/test_kanban_refused_pin_clear.py
new file mode 100644
index 00000000000..195ae58e0ca
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_refused_pin_clear.py
@@ -0,0 +1,117 @@
+"""A stored pin the routing registry refuses must not strand a card when no supervisor exists. [daveey]
+
+A card pinned to a retired model before the create-time registry check existed
+stays ``ready`` when the assignment block has no supervisor: the hold is
+cap-exempt. A stored pin is history, not a request. Like ``stale_managed_pin``
+on resume, the dispatcher drops what the policy refuses and runs the card on
+the profile default. Family mismatches, dry runs and a successful supervisor
+block are unchanged. Clearing never picks another model or a paid provider.
+The same tick then dispatches on the profile default.
+"""
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    """Enforced assignee home and NO ``kanban.orchestrator_profile`` anywhere."""
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    (home / 'config.yaml').write_text('model:\n  default: claude-opus-5-5\n  provider: anthropic\n')
+    profile = home / 'profiles' / 'worker'
+    profile.mkdir(parents=True)
+    (profile / 'config.yaml').write_text(
+        'model:\n  default: claude-sonnet-5-5\n  provider: anthropic\n'
+        'platform_toolsets:\n  cli: [terminal, file, kanban]\nterminal:\n  backend: local\n'
+        + _managed_yaml(True))
+    kb.init_db()
+    from hermes_cli.kanban_db_connect import connect_closing
+    with connect_closing() as conn:
+        yield conn
+
+
+def _seed(conn, model, provider):
+    tid = kb.create_task(conn, title='Legacy pin', assignee='worker')
+    # create/set-model refuse these pins, exactly as the stranded card's pin predates that check.
+    conn.execute('UPDATE tasks SET model_override=?, provider_override=? WHERE id=?', (model, provider, tid))
+    conn.commit()
+    return tid
+
+
+def _events(conn, tid, kind):
+    return [kb.json.loads(r[0]) if r[0] else None for r in conn.execute(
+        'SELECT payload FROM task_events WHERE task_id=? AND kind=? ORDER BY id', (tid, kind))]
+
+
+def test_refused_pin_with_no_supervisor_is_cleared_and_dispatched_same_tick(board):
+    from hermes_cli.kanban_db_dispatch import dispatch_once
+    conn = board
+    tid = _seed(conn, 'claude-sonnet-4-6', 'anthropic')
+    spawned = []
+    dispatch_once(conn, spawn_fn=lambda task, ws, **kw: spawned.append(task) or 4242, max_spawn=1)
+
+    task = kb.get_task(conn, tid)
+    assert (task.model_override, task.provider_override) == (None, None)
+    assert task.block_kind is None
+    cleared = _events(conn, tid, 'model_override_cleared')
+    assert len(cleared) == 1
+    assert cleared[0]['model'] == 'claude-sonnet-4-6'
+    assert cleared[0]['provider'] == 'anthropic'
+    assert cleared[0]['reason'] == 'model_pin_not_in_routing_registry'
+    assert 'claude-sonnet-5-5' in cleared[0]['allowed']
+    bodies = [c.body for c in kb.list_comments(conn, tid)]
+    assert any('claude-sonnet-4-6' in b and 'routing registry' in b and 'profile default' in b for b in bodies)
+    assert [t.id for t in spawned] == [tid]
+    assert spawned[0].model_override is None and spawned[0].provider_override is None
+    assert not _events(conn, tid, 'respawn_guarded')
+
+
+def test_family_mismatch_with_no_supervisor_keeps_existing_path(board):
+    from hermes_cli.kanban_db_dispatch import dispatch_once
+    conn = board
+    tid = _seed(conn, 'gpt-6-astra', 'anthropic')
+    spawned = []
+    result = dispatch_once(conn, spawn_fn=lambda task, ws, **kw: spawned.append(task), max_spawn=1)
+    assert spawned == []
+    task = kb.get_task(conn, tid)
+    assert task.status == 'ready'
+    assert (task.model_override, task.provider_override) == ('gpt-6-astra', 'anthropic')
+    assert not _events(conn, tid, 'model_override_cleared')
+    assert [code for t, code in result.respawn_guarded if t == tid] in (
+        ['model_provider_mismatch'], ['model_pin_not_in_routing_registry'])
+
+
+def test_family_mismatch_pin_that_registry_also_refuses_is_not_cleared(board):
+    """``gpt-6-astra`` on anthropic is refused by both checks; the registry one runs first. It
+    must still keep the family-mismatch path (never silently drop a pin whose family is wrong)."""
+    from hermes_cli.kanban_model_assignment import route_model_mismatch
+    conn = board
+    tid = _seed(conn, 'gpt-6-astra', 'anthropic')
+    route_model_mismatch(conn, kb.get_task(conn, tid))
+    assert kb.get_task(conn, tid).model_override == 'gpt-6-astra'
+
+
+def test_dry_run_tick_changes_nothing(board):
+    from hermes_cli.kanban_db_dispatch import dispatch_once
+    conn = board
+    tid = _seed(conn, 'claude-sonnet-4-6', 'anthropic')
+    before = list(conn.iterdump())
+    result = dispatch_once(conn, dry_run=True)
+    assert (tid, 'model_pin_not_in_routing_registry') in result.respawn_guarded
+    assert list(conn.iterdump()) == before
+
+
+def test_registered_pin_is_untouched(board):
+    from hermes_cli.kanban_db_dispatch import dispatch_once
+    conn = board
+    tid = _seed(conn, 'claude-sonnet-5-5', 'anthropic')
+    spawned = []
+    dispatch_once(conn, spawn_fn=lambda task, ws, **kw: spawned.append(task) or 4242, max_spawn=1)
+    assert spawned[0].model_override == 'claude-sonnet-5-5'
+    assert not _events(conn, tid, 'model_override_cleared')
-- 
