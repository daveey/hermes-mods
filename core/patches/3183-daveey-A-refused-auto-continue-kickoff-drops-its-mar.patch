 @pytest.mark.parametrize("flag", ["_closing", "_finalized"])
@@ -224,3 +227,79 @@ def test_watcher_whose_continuation_is_refused_hands_off_to_a_rearmed_watcher(en
     assert env.ran == [(up.pause_note("fix the flaky test"), 1)]
     assert rearmed == ["session-key"]
     assert any("continuation of session-key never started" in r.getMessage() for r in caplog.records)
+
+
+_KICKOFF_KEYS = ("_auto_continue_attempt", "_auto_continue_prompt", "_auto_continue_pauses",
+                 "_auto_continue_killed_jobs", "_marker_until_tool")
+
+
+@pytest.mark.parametrize("result", ["refused", "raises"])
+def test_kickoff_that_never_started_leaves_no_marker_inputs(env, monkeypatch, result):
+    """The kickoff sets the marker inputs a started turn reads back (_record_turn_marker pops them). A submit that
+    was refused, or a dispatch that raised, must drop them: the next turn to record (a user's) would otherwise
+    write its crash marker with the paused prompt, its attempt count and the at-most-once flag."""
+    record_turn_start(env.home, "session-key", "the paused prompt", attempts=1, until_tool=True)
+    mark_turn_paused(env.home, "session-key", up.PAUSE_REASON, killed_jobs=[{"id": "job-1"}])
+    session = _session()
+    seen = {}
+
+    def submit(rid, sid, s, text, **kw):
+        seen.update({k: s.get(k) for k in _KICKOFF_KEYS})
+        if result == "raises":
+            raise RuntimeError("boom")
+        return False
+
+    monkeypatch.setattr(server, "_run_prompt_submit", submit)
+    server._maybe_schedule_auto_continue("sid", session, "session-key")
+
+    assert seen["_auto_continue_prompt"] == "the paused prompt" and seen["_marker_until_tool"] is True  # were set
+    assert [k for k in _KICKOFF_KEYS if k in session] == []
+
+
+def test_persistently_refused_paused_continuation_stops_rearming_at_the_cap(env, caplog):
+    """Each re-arm starts a fresh watcher with a fresh budget, so a refusal that never clears would loop every
+    ~10-15 s until the marker aged out. The re-arms are capped per pause; past the cap the refusal backs off like
+    any other and the next resume, boot sweep or refused-turn timer retries."""
+    import logging
+    caplog.set_level(logging.WARNING)
+    record_turn_start(env.home, "session-key", "the prompt")
+    mark_turn_paused(env.home, "session-key", up.PAUSE_REASON)
+    session = _session()
+
+    for _ in range(server.REFUSED_REARM_MAX + 3):
+        session.pop("_auto_continue_retry_after", None)  # the backoff elapses before the next poll
+        server._maybe_schedule_auto_continue("sid", session, "session-key")
+
+    assert len(env.watchers) == server.REFUSED_REARM_MAX
+    assert session["_auto_continue_retry_after"] > time.monotonic() + 20.0  # the 30 s backoff past the cap
+    assert not session.get("_auto_continue_scheduled")
+    last = [r.getMessage() for r in caplog.records if "never started" in r.getMessage()][-1]
+    assert f"re-arm cap {server.REFUSED_REARM_MAX} reached" in last and "not rescheduled here" in last
+    assert read_turn_marker(env.home, "session-key") is not None
+
+    # A later pause of the turn is a new pause: its continuation gets its own re-arms.
+    mark_turn_paused(env.home, "session-key", up.PAUSE_REASON)
+    session.pop("_auto_continue_retry_after", None)
+    server._maybe_schedule_auto_continue("sid", session, "session-key")
+    assert len(env.watchers) == server.REFUSED_REARM_MAX + 1
+
+
+def test_paused_continuation_refused_for_ownership_does_not_rearm(env, monkeypatch, caplog):
+    """An ownership refusal at _admit_prompt_turn (the chat moved to another gateway) does not lift when a hold
+    does: no watcher waits it out, so the refusal backs off instead of re-arming."""
+    import logging
+    caplog.set_level(logging.WARNING)
+    record_turn_start(env.home, "session-key", "the prompt")
+    mark_turn_paused(env.home, "session-key", up.PAUSE_REASON)
+    session = _session()
+
+    def submit(rid, sid, s, text, **kw):
+        s["_turn_owner_refusal"] = "SESSION_MOVED"  # what _admit_prompt_turn records on its ownership fence
+        return False
+
+    monkeypatch.setattr(server, "_run_prompt_submit", submit)
+    server._maybe_schedule_auto_continue("sid", session, "session-key")
+
+    assert env.watchers == []
+    assert session["_auto_continue_retry_after"] > time.monotonic() + 20.0
+    assert any("owner refusal SESSION_MOVED" in r.getMessage() for r in caplog.records)
diff --git a/tests/tui_gateway/test_update_pause_refused_kickoff_admission.py b/tests/tui_gateway/test_update_pause_refused_kickoff_admission.py
new file mode 100644
index 0000000000..5145bfbc16
--- /dev/null
+++ b/tests/tui_gateway/test_update_pause_refused_kickoff_admission.py
@@ -0,0 +1,112 @@
+"""[daveey] A paused continuation refused by the REAL update admission (no stubbed submit).
+
+The hub incident (defect gateway-833d39a686) end to end through ``_run_prompt_submit``: the kickoff waits for its
+agent build, the drain re-takes the update hold meanwhile, so ``prepare_work`` cannot reserve (returns None) and
+the submit's ``stage``/``settle`` give the claim back. The kickoff then logs the refusal, re-arms the pause watcher
+and leaves no marker inputs behind: a user turn that starts before the re-armed continuation records its own
+marker, not the paused prompt's attempt count or at-most-once flag.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+import types
+
+import pytest
+
+from hermes_cli import admission_fence as af, backend_retirement
+from tui_gateway import server
+from tui_gateway import update_pause as up
+from tui_gateway.turn_marker import mark_turn_paused, read_turn_marker, record_turn_start
+
+pytestmark = pytest.mark.platforms("posix")
+
+CFG = {"desktop": {"auto_continue": {"enabled": True, "resume_on_startup": True, "freshness_minutes": 240,
+                                     "max_attempts": 2}}}
+
+
+class _InlineThread:
+    def __init__(self, target=None, daemon=None, args=(), kwargs=None, name=None):
+        self._target, self._args, self._kwargs = target, args, kwargs or {}
+
+    def start(self):
+        if self._target is not None:
+            self._target(*self._args, **self._kwargs)
+
+    def is_alive(self):
+        return False
+
+    def join(self, timeout=None):
+        return None
+
+
+@pytest.fixture()
+def env(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(backend_retirement, "retirement", backend_retirement.RetirementFence())
+    monkeypatch.setattr(server, "_hermes_home", tmp_path)
+    monkeypatch.setattr(server, "_load_cfg", lambda: CFG)
+    monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
+    monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda sid, session: None)
+    monkeypatch.setattr(server, "_session_cwd", lambda session: str(tmp_path))
+    monkeypatch.setattr(server, "_register_session_cwd", lambda session: None)
+    monkeypatch.setattr(server, "_tts_stream_begin", lambda: None)
+    monkeypatch.setattr(server, "_sync_session_key_after_compress", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_get_usage", lambda agent: {})
+    monkeypatch.setattr(server, "_start_agent_build", lambda sid, session: None)
+
+    def build_wait(session, rid, timeout=30.0):
+        af.set_hold(tmp_path)  # the drain re-takes the hold while the kickoff waits for its agent build
+
+    monkeypatch.setattr(server, "_wait_agent", build_wait)
+    watchers: list = []
+    monkeypatch.setattr(up, "start_in_place_watcher", lambda sid, session, key: watchers.append(key))
+    yield types.SimpleNamespace(home=tmp_path, watchers=watchers)
+    af.clear_hold(tmp_path)
+
+
+def _session(home, seen):
+    def run_conversation(message, **kw):
+        seen.append(read_turn_marker(home, "session-key"))  # the marker the running turn recorded
+        return {"final_response": "done"}
+
+    agent = types.SimpleNamespace(session_id="session-key", clear_interrupt=lambda: None,
+                                  run_conversation=run_conversation)
+    return {"agent": agent, "session_key": "session-key", "history": [], "history_lock": threading.RLock(),
+            "history_version": 0, "running": False, "attached_images": [], "image_counter": 0, "cols": 80,
+            "slash_worker": None, "show_reasoning": False, "tool_progress_mode": "all", "inflight_turn": None,
+            "profile_home": str(home)}
+
+
+def test_continuation_refused_by_the_real_admission_hold_releases_and_rearms(env, caplog):
+    record_turn_start(env.home, "session-key", "fix the flaky test", attempts=1, until_tool=True)
+    mark_turn_paused(env.home, "session-key", up.PAUSE_REASON)
+    seen: list = []
+    session = _session(env.home, seen)
+    caplog.set_level(logging.INFO)
+
+    assert server._maybe_schedule_auto_continue("sid", session, "session-key") is not None
+
+    msgs = [r.getMessage() for r in caplog.records]
+    assert any(m.startswith("tui prompt refused") and "cause=admission" in m for m in msgs)
+    assert any("continuation of session-key never started" in m for m in msgs)
+    assert not seen  # the continuation never ran
+    assert env.watchers == ["session-key"]
+    # stage/settle gave the claim back: no admission token, no running flag, no reservation left behind.
+    assert "_turn_admission" not in session and not session.get("running")
+    assert not session.get("_auto_continue_scheduled")
+    assert af.state(env.home)["reservations"] == 0
+    assert read_turn_marker(env.home, "session-key")["reason"] == up.PAUSE_REASON  # still the turn's record
+
+    # The hold lifts and the user types before the re-armed continuation: their turn's marker is their own.
+    af.clear_hold(env.home)
+    assert server._run_prompt_submit("rid", "sid", session, "a new question") is True
+    assert len(seen) == 1
+    marker = seen[0]
+    assert marker["prompt"] == "a new question"
+    assert marker["attempts"] == 0, "the user turn inherited the continuation's attempt count"
+    assert not marker.get("until_tool"), "the user turn inherited the continuation's at-most-once flag"
+    assert not marker.get("pauses")
