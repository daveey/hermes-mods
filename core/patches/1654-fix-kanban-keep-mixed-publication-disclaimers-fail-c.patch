From 09f71291194c77b0b1b4f0dbcc072685f3afe33f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 06:19:10 +0000
Subject: [PATCH] fix(kanban): keep mixed-publication disclaimers fail closed
 [daveey]

---
 hermes_cli/kanban_db_dispatch_pr_policy.py             |  7 ++++++-
 .../test_kanban_active_pr_foreign_contract.py          | 10 ++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_dispatch_pr_policy.py b/hermes_cli/kanban_db_dispatch_pr_policy.py
index 6e6bd8bb81a..ea649a2eac4 100644
--- a/hermes_cli/kanban_db_dispatch_pr_policy.py
+++ b/hermes_cli/kanban_db_dispatch_pr_policy.py
@@ -29,7 +29,12 @@ def norm_pr(url: str) -> str:
 
 
 def _says_pull_does_not_block(body: str) -> bool:
-    return bool(_NONBLOCKING_RE.search(body))
+    from hermes_cli import kanban_db_dispatch as dispatch
+
+    # A disclaimer in a mixed-URL comment may refer to a different pull from the
+    # publication. Ambiguous prose must not release the duplicate-work guard.
+    urls = {norm_pr(url) for url in dispatch._RESPAWN_GUARD_PR_URL_RE.findall(body)}
+    return len(urls) == 1 and bool(_NONBLOCKING_RE.search(body))
 
 
 def _own_contract_key(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
diff --git a/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py b/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py
index f8bc794512f..db0d555ccf8 100644
--- a/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py
+++ b/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py
@@ -129,6 +129,16 @@ def test_foreign_url_does_not_drop_an_own_url_in_the_same_comment():
         assert _guard(conn, tid) == "active_pr"
 
 
+@pytest.mark.parametrize("disclaimed,live_contract", [(OTHER, False), (FOREIGN, True)])
+def test_mixed_comment_disclaimer_does_not_drop_published_pull(disclaimed, live_contract):
+    with kbc.connect() as conn:
+        if live_contract:
+            kb.create_task(conn, title="other owner", assignee="b", completion_contract=disclaimed)
+        tid = _claimed(conn, "new publication with informational reference")
+        worker_comment(conn, tid, "a", f"Opened {OWN}. {disclaimed} does not block this card.")
+        assert _guard(conn, tid) == "active_pr"
+
+
 def test_nonblocking_comment_does_not_exempt_a_real_open_comment():
     with kbc.connect() as conn:
         tid = _claimed(conn, "opened then disclaimed")
-- 
