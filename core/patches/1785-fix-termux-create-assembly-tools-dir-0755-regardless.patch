From d0b54a133d8a328d203171de4ec0f795b5920386 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 02:07:50 +0000
Subject: [PATCH] fix(termux): create assembly tools dir 0755 regardless of
 host umask [daveey]

On umask-0002 hosts (Ubuntu user-private groups; the ephemeral CI runners)
prepare_assembly's mkdir left .environments-*/tools group-writable, breaking the
no-group/world-writable output contract. The test now runs the harness under
umask 0002 so it pins this (red on the old script).
---
 scripts/termux/assembly_permissions.sh            | 3 ++-
 tests/scripts/test_termux_assembly_permissions.py | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/scripts/termux/assembly_permissions.sh b/scripts/termux/assembly_permissions.sh
index acb906dbbd0..08ffd5a9e8e 100644
--- a/scripts/termux/assembly_permissions.sh
+++ b/scripts/termux/assembly_permissions.sh
@@ -5,7 +5,8 @@ prepare_assembly() {
     ASSEMBLY="$(mktemp -d "$PAYLOAD_ABS/.environments-XXXXXX")"
     # Docker would create the parent of the nested tool mounts as root:root.
     # Pre-create it and hand off the private scratch tree to Termux's system uid.
-    mkdir "$ASSEMBLY/tools"
+    # Explicit mode: a umask-0002 host (user-private groups) would make it group-writable.
+    mkdir -m 0755 "$ASSEMBLY/tools"
     docker run --rm --user 0:0 --network none --entrypoint chown \
         -v "$ASSEMBLY:/assembly" "$IMAGE" 1000:1000 /assembly /assembly/tools
 }
diff --git a/tests/scripts/test_termux_assembly_permissions.py b/tests/scripts/test_termux_assembly_permissions.py
index 8d7e351cdfb..3050ebf81ae 100644
--- a/tests/scripts/test_termux_assembly_permissions.py
+++ b/tests/scripts/test_termux_assembly_permissions.py
@@ -96,6 +96,8 @@ def test_assembly_publishes_facts_as_termux_uid_and_returns_host_owned_output(pa
     result = subprocess.run(
         ["bash", "-c", r'''
 set -euo pipefail
+# Ubuntu's default user-private-group umask (CI runners use it): output must not inherit it.
+umask 0002
 IMAGE="$1"; PAYLOAD_ABS="$2"; REPO="$3"
 source "$REPO/scripts/termux/assembly_permissions.sh"
 prepare_assembly
-- 
2.55.0

