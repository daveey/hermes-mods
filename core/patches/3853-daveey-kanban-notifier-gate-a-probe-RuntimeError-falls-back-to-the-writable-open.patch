From 68a650e33a3f312dcea70d944dc21cdc049bdeef Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:50:32 +0000
Subject: [PATCH] [daveey] kanban notifier gate: a probe RuntimeError falls
 back to the writable open

Review 5897762084 nit 1: narrowing _probe_board's except to (sqlite3.Error, OSError, ValueError)
let RuntimeError (Path.resolve on a symlink loop, Python < 3.13) escape and stop the collect tick
for every later board. Before the gate a bare `except Exception` sent it to the writable open.
Add RuntimeError back. RED: test_probe_failure_falls_back_to_the_writable_open[exc0] fails at
5853f6d4b4; GREEN with this change (11 notifier test files pass).
---
 gateway/kanban_watchers_notifier.py              |  3 ++-
 tests/gateway/test_kanban_notifier_board_gate.py | 15 +++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/gateway/kanban_watchers_notifier.py b/gateway/kanban_watchers_notifier.py
index 060686adfc..08f6367ad1 100644
--- a/gateway/kanban_watchers_notifier.py
+++ b/gateway/kanban_watchers_notifier.py
@@ -321,7 +321,8 @@ class _Collector:
         try:
             count, inflight, key = _kbn().notify_gate_probe(
                 board=slug, notifier_profiles=self.notifier_profiles, include_unowned=self.include_unowned)
-        except (sqlite3.Error, OSError, ValueError) as exc:  # unreadable DB / bad slug: the writable open decides
+        # unreadable DB / bad slug / Path.resolve symlink loop (RuntimeError before 3.13): the writable open decides
+        except (sqlite3.Error, OSError, ValueError, RuntimeError) as exc:
             logger.debug("kanban notifier: read-only subscription probe failed "
                          "for board %s (%s); falling back to writable open", slug, exc)
             return True, 0, None
diff --git a/tests/gateway/test_kanban_notifier_board_gate.py b/tests/gateway/test_kanban_notifier_board_gate.py
index b51cfd486f..c3eda55024 100644
--- a/tests/gateway/test_kanban_notifier_board_gate.py
+++ b/tests/gateway/test_kanban_notifier_board_gate.py
@@ -92,6 +92,21 @@ def test_bookkeeping_only_write_moves_the_key(board, opens, routed):
     assert not _tick(runner)[0]
 
 
+@pytest.mark.parametrize('exc', [RuntimeError('symlink loop'), OSError('gone')])
+def test_probe_failure_falls_back_to_the_writable_open(board, opens, routed, monkeypatch, exc):
+    """A probe error (Path.resolve raises RuntimeError on a symlink loop before 3.13) must not abort the tick:
+    the board runs its full pass, as before the gate."""
+    task = kb.create_task(board, title='probe', assignee='default')
+    notify.add_notify_sub(board, task_id=task, platform='telegram', chat_id='chat')
+    _event(board, task, 'completed')
+
+    def boom(**_kw):
+        raise exc
+    monkeypatch.setattr(notify, 'notify_gate_probe', boom)
+    skipped, deliveries = _tick(_runner('telegram'))
+    assert not skipped and [ev.kind for ev in deliveries[0]['events']] == ['completed']
+
+
 @pytest.mark.parametrize('why', ['holder_died', 'claim_went_stale'])
 def test_orphaned_claim_on_idle_board_is_redelivered_within_one_tick(board, opens, routed, monkeypatch, why):
     task = kb.create_task(board, title='held', assignee='default')
