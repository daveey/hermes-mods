From ecec822d4b5ef62ed0b4d452cdd56f53cfa4e46d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 16:13:51 +0000
Subject: [PATCH] fix(gateway): treat parser RecursionError as unknown control
 verb [daveey]

safe_verb parses the request only for latency metadata. A RecursionError
from json.loads on deeply nested input escaped it, so the connection was
closed without reaching the handler. Catch it alongside ValueError and
UnicodeError; the test injects RecursionError into the metadata parser
and asserts the real handler still replies.
---
 gateway/control_diagnostics.py                |  2 +-
 .../test_control_diagnostics_lifecycle.py     | 30 +++++++++++++++++++
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/gateway/control_diagnostics.py b/gateway/control_diagnostics.py
index 9d5525a8ce6..b9cc6e9d9d6 100644
--- a/gateway/control_diagnostics.py
+++ b/gateway/control_diagnostics.py
@@ -17,7 +17,7 @@ def safe_verb(raw, allowed):
         request = json.loads(raw)
         verb = request.get("verb") if isinstance(request, dict) else None
         return verb if isinstance(verb, str) and verb in allowed else "unknown"
-    except (ValueError, UnicodeError):
+    except (ValueError, UnicodeError, RecursionError):
         return "unknown"
 
 
diff --git a/tests/gateway/test_control_diagnostics_lifecycle.py b/tests/gateway/test_control_diagnostics_lifecycle.py
index eb23eced87f..bdce2fbce04 100644
--- a/tests/gateway/test_control_diagnostics_lifecycle.py
+++ b/tests/gateway/test_control_diagnostics_lifecycle.py
@@ -176,3 +176,33 @@ def test_pending_connection_task_is_strongly_referenced(tmp_path):
         assert server._diagnostics.in_flight == 0
 
     asyncio.run(run())
+
+
+@pytest.mark.platforms("posix")
+def test_verb_metadata_recursion_error_still_replies(tmp_path, monkeypatch, caplog):
+    # Python 3.12's json raises RecursionError on deeply nested input (3.14 raises a decode
+    # error), so inject it into the metadata parser only; the real handler parses normally.
+    from gateway import control_diagnostics
+
+    def nested_too_deep(raw):
+        raise RecursionError("maximum recursion depth exceeded")
+
+    monkeypatch.setattr(control_diagnostics, "json", types.SimpleNamespace(loads=nested_too_deep))
+
+    def status():
+        threading.Event().wait(0.6)  # health: allow HX013 -- slow handler forces the latency record
+        return {"alive": True}
+
+    async def run():
+        server = GatewayControlServer(tmp_path, verb_handlers={"status": status})
+        assert await server.start()
+        try:
+            return await _exchange(server)
+        finally:
+            await server.stop()
+
+    with caplog.at_level(logging.WARNING):
+        reply = asyncio.run(run())
+    assert reply["ok"] and reply["result"] == {"alive": True}
+    records = [r for r in caplog.records if "Control request latency" in r.getMessage()]
+    assert [r.verb for r in records] == ["unknown"]
-- 
