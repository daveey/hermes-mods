--- a/hermes_cli/fact_content_owner.py
+++ b/hermes_cli/fact_content_owner.py
@@ -24,6 +24,11 @@
     Board and project-tree owners bound kanban.db and state.db only for
     SourceState, but published every row into the shared process store.
     Publications exceeded the fact budget, repeatedly rebuilding both sources.
+
+    A clock-only source is also paced (:data:`CLOCK_ONLY_INTERVAL`): its feed pass opened a guarded connection,
+    ran change reads and re-projected dependent views on every write. Repeated
+    work across boards kept the shared fact-change-feed busy in the dashboard
+    backend. The views it invalidates are paced the same way.
     """
     source: object
     path: object
@@ -31,6 +36,9 @@
     clock_only: bool = False
 
 
+CLOCK_ONLY_INTERVAL = 5.0  # seconds between feed passes of a clock-only source; board inputs pace at 5 s too
+
+
 def _ids_only(conn, ids):
     """Clock-only hydration: the cursor alone is published, so rows carry nothing but their id.
     Same input contract as the scalar row hydrators (capture transaction, <= 500 string ids)."""
@@ -76,6 +84,8 @@
                 raise ValueError('clock-only binding takes no hydrate')
             hydrate = _ids_only if binding.clock_only else rows if binding.hydrate is None else binding.hydrate
             adapter = adapter_type(source, binding.path, hydrate)
+            if binding.clock_only:
+                adapter.min_interval = CLOCK_ONLY_INTERVAL
             publisher = SourcePublisher(engines[source.scope], source, kind, clock_only=binding.clock_only)
             self._publishers[adapter] = publisher
             self._by_source[source] = publisher
