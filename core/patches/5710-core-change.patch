From 689a09f43999a9502d68edaf02f82dc376db820f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 08:46:11 +0000
Subject: [PATCH] [daveey] Honor opened board DB pin in origin comment route

---
 hermes_cli/kanban_origin_comment.py           |  4 +--
 .../test_kanban_origin_comment_db_pin.py      | 29 +++++++++++++++++++
 2 files changed, 31 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_origin_comment_db_pin.py

diff --git a/hermes_cli/kanban_origin_comment.py b/hermes_cli/kanban_origin_comment.py
index 50ec8a15f1..470fb967aa 100644
--- a/hermes_cli/kanban_origin_comment.py
+++ b/hermes_cli/kanban_origin_comment.py
@@ -99,8 +99,8 @@ def forward(conn, task_id: str, args: dict, body: str) -> dict | None:
     if not session or not ledger.exists():
         return None
     replica = Path(os.environ.get('HERMES_HUB_STATE') or Path.home() / '.local/state/hermes-hub') / 'hub.db'
-    from hermes_cli.kanban_db import get_current_board
-    route = bound_owner(ledger, task_id=task_id, board=args.get('board') or get_current_board(),
+    from hermes_cli.kanban_placement_forward import opened_board
+    route = bound_owner(ledger, task_id=task_id, board=args.get('board') or opened_board(conn),
                         gateway=_gateway(replica), profile=get_active_profile_name(),
                         session=_resolve_session(home / 'state.db', session),
                         resolve_session=lambda sid: _resolve_session(home / 'state.db', sid))
diff --git a/tests/hermes_cli/test_kanban_origin_comment_db_pin.py b/tests/hermes_cli/test_kanban_origin_comment_db_pin.py
new file mode 100644
index 0000000000..3e632bfb9b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_origin_comment_db_pin.py
@@ -0,0 +1,29 @@
+import shutil
+from tests.hermes_cli import test_kanban_origin_comment as f
+from tests.hermes_cli import test_kanban_decision_ask as helpers
+world = f.world
+kanban_home = f.kanban_home
+courier = f.courier
+
+def test_omitted_board_honors_db_pin(kanban_home, world, courier, monkeypatch):
+    from gateway.session_context import scoped_current_session_id
+    from hermes_constants import get_hermes_home
+    from hermes_cli import kanban_origin_adapter as adapter
+    from hermes_cli.kanban_db_boards import create_board
+    f.publish(world[1], world[2])
+    f.accept(world)
+    home = get_hermes_home()
+    (home / 'kanban').mkdir(exist_ok=True)
+    shutil.copyfile(world[0], home / 'kanban/origin-ledger.db')
+    helpers._session('s_old')
+    monkeypatch.setattr(adapter, '_gateway', lambda _: 'origin')
+    monkeypatch.delenv('HERMES_KANBAN_TASK', raising=False)
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    create_board('build')
+    monkeypatch.setenv('HERMES_KANBAN_BOARD', 'default')
+    monkeypatch.setenv('HERMES_KANBAN_DB', str(home / 'kanban/boards/build/kanban.db'))
+    with scoped_current_session_id('s_old'):
+        explicit = helpers._tool('comment', {'task_id': 't_one', 'body': 'B', 'board': 'build'})
+        omitted = helpers._tool('comment', {'task_id': 't_one', 'body': 'B'})
+    assert explicit.get('status') == 'comment_pending', explicit
+    assert omitted.get('status') == 'comment_pending', omitted
-- 
