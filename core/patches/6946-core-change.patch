From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 21:21:23 +0000
Subject: [PATCH 6946] Profile resource custody and retirement before deletion

Public mirror of source commit f3a48170c74abfcdbeddd1fdce0298b63a9ed339.

---
diff --git a/hermes_state_readpool.py b/hermes_state_readpool.py
index 68570d0c458b7301825accfb2ec274f4098df683..a5d03b0dbd6c8bef4a776d77ebd3065b9784ac5f 100644
--- a/hermes_state_readpool.py
+++ b/hermes_state_readpool.py
@@ -226,8 +226,11 @@
         )
 
     def _acquire_path_permit(self, requester: "SessionDB") -> bool:
+        # Checkout's queue miss and this permit attempt are not atomic: a reader
+        # may return to the requester's own pool between them. Reclaim it too;
+        # excluding the requester falsely degrades while an idle permit exists.
         return self.permits.acquire(blocking=False) or (
-            self.reclaim_idle(exclude=requester) and self.permits.acquire(blocking=False)
+            self.reclaim_idle() and self.permits.acquire(blocking=False)
         )
 
     def reclaim_idle(self, exclude: "Optional[SessionDB]" = None) -> bool:
diff --git a/tests/hermes_state/test_read_pool_return_race.py b/tests/hermes_state/test_read_pool_return_race.py
new file mode 100644
index 0000000000000000000000000000000000000000..0bad30013c7d2164b623670c52fd1ed3bffe8632
--- /dev/null
+++ b/tests/hermes_state/test_read_pool_return_race.py
@@ -0,0 +1,38 @@
+"""A return between queue miss and permit acquisition must remain usable."""
+import logging
+
+from hermes_state import SessionDB
+import hermes_state_readpool as pool
+
+
+def test_own_reader_return_after_checkout_miss_is_not_capacity_denial(tmp_path, monkeypatch, caplog):
+    db = SessionDB(tmp_path / 'state.db')
+    held = []
+    borrowed = None
+    try:
+        held = [db._get_read_conn() for _ in range(pool._READ_POOL_MAX)]
+        assert all(conn is not None for conn in held)
+        original = db._get_read_conn
+
+        def return_before_admission():
+            # Exact race ordering: checkout saw an empty queue; an existing
+            # reader returns before the following permit attempt. No sleeps.
+            returned = held.pop()
+            assert returned is not None
+            db._read_pool.put_nowait(returned)
+            return original()
+
+        monkeypatch.setattr(db, '_get_read_conn', return_before_admission)
+        pool._pool_exhaustion_warned_at.clear()
+        with caplog.at_level(logging.WARNING, logger='hermes_state'):
+            borrowed = db._checkout_read_conn()
+        assert borrowed is not None, 'an idle reader returned before admission, yet checkout degraded'
+        assert borrowed.execute('SELECT 42').fetchone()[0] == 42
+        assert not [r for r in caplog.records if 'read pool at capacity' in r.getMessage()]
+    finally:
+        if borrowed is not None:
+            db._close_read_conn(borrowed)
+        for conn in held:
+            if conn is not None:
+                db._close_read_conn(conn)
+        db.close()
