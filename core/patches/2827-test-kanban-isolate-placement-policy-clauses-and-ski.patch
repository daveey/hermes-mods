From 773510967869e749f12de89553e420014f69fc17 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:05:08 +0000
Subject: [PATCH] test(kanban): isolate placement policy clauses and skill
 carriage [daveey]

---
 tests/hermes_cli/test_kanban_edit_requires.py | 17 ++++++-
 .../test_kanban_recovery_guard_isolation.py   | 47 +++++++++++++++++++
 2 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_edit_requires.py b/tests/hermes_cli/test_kanban_edit_requires.py
index 92e6e4513d..0a1c14b818 100644
--- a/tests/hermes_cli/test_kanban_edit_requires.py
+++ b/tests/hermes_cli/test_kanban_edit_requires.py
@@ -85,7 +85,11 @@ def test_requires_edit_force_is_not_an_escape(kanban_home):
 def test_requires_edit_retains_skill_requirements(kanban_home, monkeypatch):
     from hermes_cli import kanban_capabilities as capabilities
     tid = helpers._new(requires=["host_repo"])
-    monkeypatch.setattr(capabilities, "skill_requirements", lambda skills, profile: ["host_repo"])
+    with kbc.connect() as conn:
+        conn.execute("UPDATE tasks SET skills=? WHERE id=?", (json.dumps(["repo-skill"]), tid))
+        conn.commit()
+    monkeypatch.setattr(capabilities, "skill_requirements",
+                        lambda skills, profile: ["host_repo"] if "repo-skill" in skills else [])
     assert helpers._main(["edit", tid, "--requires", "terminal"]) == 0
     with kbc.connect() as conn:
         assert kb.get_task(conn, tid).requires == ["terminal", "host_repo"]
@@ -102,3 +106,14 @@ def test_requires_edit_rejects_ready_card_with_custodian(kanban_home, field):
         conn.commit()
     assert helpers._main(["edit", tid, "--requires", "terminal"]) == 2
     assert helpers._edited_events(tid) == []
+
+
+def test_requires_edit_accepts_legacy_null_requirements(kanban_home):
+    tid = helpers._new(requires=["host_repo"])
+    with kbc.connect() as conn:
+        conn.execute("UPDATE tasks SET requires=NULL WHERE id=?", (tid,))
+        conn.commit()
+    assert helpers._main(["edit", tid, "--requires", "terminal"]) == 0
+    with kbc.connect() as conn:
+        assert kb.get_task(conn, tid).requires == ["terminal"]
+
diff --git a/tests/hermes_cli/test_kanban_recovery_guard_isolation.py b/tests/hermes_cli/test_kanban_recovery_guard_isolation.py
index ae10887193..b5b9d06fe8 100644
--- a/tests/hermes_cli/test_kanban_recovery_guard_isolation.py
+++ b/tests/hermes_cli/test_kanban_recovery_guard_isolation.py
@@ -80,3 +80,50 @@ def test_current_requirement_shape_rejected_independently(setup, value):
     row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
     row['requires'] = json.dumps(value)
     assert not recovery.current_portable(db, row, {})
+
+
+@pytest.mark.parametrize("policy", [None, wp.POLICY])
+def test_stale_policy_without_pending_move_can_recover(setup, monkeypatch, policy):
+    db, _ = setup
+    tid = fixtures.make(db, runs_on='["machine:worker-1"]')
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    row["placement_policy"] = policy
+    monkeypatch.setattr(node, "registry", lambda **kw: {"machines": {"worker-1": {"hold": True}}})
+    monkeypatch.setattr(wp, "requested_move", lambda *a: None if policy else ["machine:worker-2"])
+    assert recovery.recovery_mode(db, row, {}) == "stale_pin"
+
+
+def test_prior_policy_without_move_event_does_not_reenroll(setup):
+    db, hub = setup
+    tid = fixtures.make(db)
+    db.execute("UPDATE task_events SET payload=? WHERE task_id=? AND kind='created'",
+               (json.dumps({"placement_policy": wp.POLICY}), tid))
+    db.commit()
+    assert wp.reevaluate(db, hub, "default", "hub") == 0
+    assert not hub.calls
+
+
+@pytest.mark.parametrize("source", ["current", "created"])
+def test_project_constraint_survives_reconstruction(setup, source):
+    db, _ = setup
+    tid = fixtures.make(db)
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    if source == "current":
+        row["project_id"] = "project-custody"
+    else:
+        db.execute("UPDATE task_events SET payload=? WHERE task_id=? AND kind='created'",
+                   (json.dumps({"project_id": "project-custody"}), tid))
+        db.commit()
+    assert not recovery.current_portable(db, row, {})
+
+
+@pytest.mark.parametrize("key", ["requires", "skills"])
+def test_bad_member_rejected_before_downstream_classifier(setup, monkeypatch, key):
+    from hermes_cli import kanban_placement as placement
+    db, _ = setup
+    tid = fixtures.make(db)
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    row[key] = "[1]"
+    monkeypatch.setattr(placement, "portable_reason", lambda *a: None)
+    assert not recovery.current_portable(db, row, {})
+
-- 
