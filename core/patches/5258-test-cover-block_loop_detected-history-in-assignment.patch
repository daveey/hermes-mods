Subject: [PATCH] test: cover block_loop_detected history in assignment repair
 completion

---
 tests/hermes_cli/test_kanban_assignment_routing.py | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_assignment_routing.py b/tests/hermes_cli/test_kanban_assignment_routing.py
index bb1211d0c1..e0b93ba505 100644
--- a/tests/hermes_cli/test_kanban_assignment_routing.py
+++ b/tests/hermes_cli/test_kanban_assignment_routing.py
@@ -313,6 +313,20 @@ def test_reasonless_assignment_block_repair_still_completes(board, payload_kind)
     assert kb.get_task(conn, tid).status == 'ready'
 
 
+def test_loop_detected_assignment_route_repair_still_completes(board):
+    conn, _ = board
+    tid = task_with_drift(board)
+    conn.execute("UPDATE tasks SET block_kind='assignment', block_recurrences=1 WHERE id=?", (tid,))
+    conn.commit()
+    assert kb.block_task(conn, tid, kind='assignment', reason='Wrong worker')
+    kinds = [r[0] for r in conn.execute("SELECT kind FROM task_events WHERE task_id=? AND kind IN ('blocked','block_loop_detected')", (tid,))]
+    assert kinds == ['block_loop_detected']
+    repair_id = payload(conn, tid)['supervisor_task_id']
+    assert kb.complete_task(conn, repair_id, result='Verified')
+    kb.recompute_ready(conn)
+    assert kb.get_task(conn, tid).status == 'ready'
+
+
 def test_repair_completion_rechecks_policy_drift(board):
     from hermes_cli.kanban_capabilities import CapabilityMismatchError
     conn, home = board
