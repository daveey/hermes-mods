From 43f7c0bbbfae249f57b429b0a0a27cee6f0726f0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:54:18 +0000
Subject: [PATCH] feat(kanban): accept PR #N / PR N / PRN mentions as
 trailer-verified candidates [daveey]

---
 hermes_cli/kanban_spend_pr_owner.py              | 13 ++++++++++++-
 tests/hermes_cli/test_kanban_spend_pr_trailer.py |  8 ++++++--
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_spend_pr_owner.py b/hermes_cli/kanban_spend_pr_owner.py
index b7b50c0e31..8a7b0bdeab 100644
--- a/hermes_cli/kanban_spend_pr_owner.py
+++ b/hermes_cli/kanban_spend_pr_owner.py
@@ -14,6 +14,9 @@ import sqlite3
 _CORE_PR = re.compile(r"https://github\.com/example-org/hermes/pull/[1-9][0-9]*")
 _CORE_PR_IN_TEXT = re.compile(r"https://github\.com/example-org/hermes/pull/[1-9][0-9]*(?![0-9A-Za-z_/])")
 EVENT = "spend_budget_spared"
+_CORE_REPO = "https://github.com/example-org/hermes"
+# `PR #N`, `PR N`, `PRN`, `pr#N`: discovery only, resolved to this repo and verified by the PR body trailer.
+_PR_NUMBER = re.compile(r"(?<![A-Za-z0-9_])PR[ \t]*#?[ \t]*([1-9][0-9]*)(?![0-9A-Za-z_/])", re.IGNORECASE)
 
 
 def published_prs(conn: sqlite3.Connection, task_id: str) -> set[str]:
@@ -49,6 +52,7 @@ def comment_candidates(conn: sqlite3.Connection, task_id: str) -> set[str]:
         for line in (body or "").splitlines():
             if not line.lstrip().startswith(">"):
                 urls.update(_CORE_PR_IN_TEXT.findall(line))
+                urls.update(f"{_CORE_REPO}/pull/{n}" for n in _PR_NUMBER.findall(line))
     return urls
 
 
@@ -57,13 +61,20 @@ def recognised_prs(conn: sqlite3.Connection, task_id: str) -> set[str]:
     return published_prs(conn, task_id) | comment_candidates(conn, task_id)
 
 
+_MAX_READS = 8  # newest candidates verified per card; a long comment history stays bounded
+
+
+def _number(url: str) -> int:
+    return int(url.rsplit("/", 1)[1])
+
+
 def open_core_pr(conn: sqlite3.Connection, task_id: str) -> str | None:
     from hermes_cli.kanban_db_dispatch_pr_state import pr_card_owners, pr_details
 
     for url in sorted(published_prs(conn, task_id)):
         if pr_details(url) == ("OPEN", "main"):
             return url
-    for url in sorted(comment_candidates(conn, task_id)):
+    for url in sorted(comment_candidates(conn, task_id), key=_number, reverse=True)[:_MAX_READS]:
         if pr_details(url) == ("OPEN", "main") and pr_card_owners(url) == (task_id,):
             return url
     return None
diff --git a/tests/hermes_cli/test_kanban_spend_pr_trailer.py b/tests/hermes_cli/test_kanban_spend_pr_trailer.py
index 7dc069eed9..8dc964300a 100644
--- a/tests/hermes_cli/test_kanban_spend_pr_trailer.py
+++ b/tests/hermes_cli/test_kanban_spend_pr_trailer.py
@@ -27,9 +27,13 @@ def _stamped(conn, tid, body, *, writer="owner"):
 
 
 @pytest.mark.parametrize("wording", [
-    "Item 7 PR 1 of 2 (producer) published: example-org/hermes PR #3717 ({pr}).",
-    "PR 1 is up at {pr}; waiting on CI.",
+    "Item 7 part 1 of 2 (producer) published: example-org/hermes PR #3598 ({pr}).",
+    "Part 1 is up at {pr}; waiting on CI.",
     "Shipped {pr} (head abc123).",
+    "Canonical publication advanced work: PR3598 OPEN at exact head.",
+    "Published PR #3598; CI pending.",
+    "PR 3598 is up.",
+    "published pr#3598 and waiting",
 ])
 def test_trailer_names_this_card_spares_any_owned_wording(kanban_home, github, wording):
     with kbc.connect_closing() as conn:
