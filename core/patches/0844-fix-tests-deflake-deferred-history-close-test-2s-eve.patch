From 131f0a3467d19415917027c3d5451a4b8d8bdcc9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:19:21 +0000
Subject: [PATCH] fix(tests): deflake deferred-history close test; 2s event
 waits missed on a throttled runner

---
 tests/tui_gateway/test_tui_gateway_server.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index 29a74cf266..1c8eb0304e 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -3797,7 +3797,7 @@ def test_session_resume_deferred_history_close_cancels_build(monkeypatch):
 
         def get_resume_conversations(self, _target):
             history_started.set()
-            assert release_history.wait(timeout=2.0)
+            assert release_history.wait(timeout=60.0)
             loaded = [{"role": "user", "content": "late"}]
             return loaded, loaded
 
@@ -3821,7 +3821,7 @@ def test_session_resume_deferred_history_close_cancels_build(monkeypatch):
         )
         sid = response["result"]["session_id"]
         session = server._sessions[sid]
-        assert history_started.wait(timeout=1.0)
+        assert history_started.wait(timeout=30.0)
 
         assert server._close_session_by_id(sid, end_reason="tui_close") is True
         assert session["resume_history_ready"].is_set()
-- 
2.55.0

