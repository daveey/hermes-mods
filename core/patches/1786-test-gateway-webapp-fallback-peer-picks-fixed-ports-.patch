From 5dfeba6e3faf69e575f5875f06d771332ff5e4b3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 02:38:16 +0000
Subject: [PATCH] test(gateway): webapp fallback peer picks fixed ports below
 the ephemeral range [daveey]

test_a_browser_credential_that_is_not_text_is_replaced_and_served flaked on CI
(run 41547505172) with state 'unavailable': free_port() took a port from bind(0),
closed it, and the peer bound it ~5 s later after its imports. With 16 parallel
workers, other processes' bind(0)/connect() could take that ephemeral port in
between, and the Webapp reported 'could not listen ... (Address already in use)'.

Reproduced with a port-pressure process holding 8000 ephemeral sockets: 3/35
runs failed with exactly that reason; with ports chosen below the OS ephemeral
range (Linux ip_local_port_range, 49152 on macOS/Windows): 0/25. The serving
assertion now prints the status so a future failure names its reason.

Kanban: t_01a19ebcaa080a65
---
 .../gateway/fixtures/webapp_fallback_peer.py  | 34 +++++++++++++++++--
 .../gateway/test_webapp_listener_fallback.py  |  2 +-
 2 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/tests/gateway/fixtures/webapp_fallback_peer.py b/tests/gateway/fixtures/webapp_fallback_peer.py
index 0f1c14356fb..cf7efdd4ef8 100644
--- a/tests/gateway/fixtures/webapp_fallback_peer.py
+++ b/tests/gateway/fixtures/webapp_fallback_peer.py
@@ -30,6 +30,7 @@ import errno
 import json
 import os
 from pathlib import Path
+import random
 import socket
 import subprocess
 import sys
@@ -39,10 +40,37 @@ SEEDED_TOKEN = "seeded-browser-credential-from-an-earlier-0"  # 43 URL-safe char
 INDEX = "<!doctype html><html><body>WEBAPP_BUNDLE</body></html>"
 
 
+def _ephemeral_floor() -> int:
+    """The lowest port the OS hands out for ``bind(0)`` and outgoing connections (Linux reads its
+    configured range; macOS and Windows start at 49152)."""
+    try:
+        return int(Path("/proc/sys/net/ipv4/ip_local_port_range").read_text().split()[0])
+    except (OSError, ValueError, IndexError):
+        return 49152
+
+
 def free_port() -> int:
-    with socket.socket() as probe:
-        probe.bind(("127.0.0.1", 0))
-        return probe.getsockname()[1]
+    """A free loopback port for the Webapp's fixed ``webapp.port``, chosen below the OS's ephemeral range.
+
+    The peer binds it seconds later, after its imports. A port from ``bind(0)`` sits in the ephemeral
+    range, where any other process (the parallel test workers' servers and clients) may get it in the
+    meantime, and the Webapp then reports ``could not listen ... (Address already in use)``. Ports
+    below that range are only ever taken by a program that asks for one by number."""
+    floor = min(_ephemeral_floor(), 32768)
+    if floor <= 20000:  # an unusual ephemeral range leaves no room below it: take one from the OS
+        with socket.socket() as probe:
+            probe.bind(("127.0.0.1", 0))
+            return probe.getsockname()[1]
+    rng = random.SystemRandom()
+    for _ in range(200):
+        port = rng.randrange(20000, floor)
+        with socket.socket() as probe:
+            try:
+                probe.bind(("127.0.0.1", port))
+            except OSError:
+                continue
+            return port
+    raise AssertionError(f"no free loopback port in 20000-{floor - 1}")
 
 
 def run(tmp_path, spec) -> dict:
diff --git a/tests/gateway/test_webapp_listener_fallback.py b/tests/gateway/test_webapp_listener_fallback.py
index 5981f887c86..edcbac6996f 100644
--- a/tests/gateway/test_webapp_listener_fallback.py
+++ b/tests/gateway/test_webapp_listener_fallback.py
@@ -85,7 +85,7 @@ def test_a_browser_credential_that_is_not_text_is_replaced_and_served(tmp_path):
     credential: like a malformed one it is replaced, and the Webapp is served with the new one."""
     report = _run(tmp_path, {"webapp": {"enabled": True, "port": _free_port()}, "credential": "not-utf8"})
     assert report["start_error"] is None, report.get("start_traceback")
-    assert report["status"]["state"] == "serving"
+    assert report["status"]["state"] == "serving", report["status"]
     assert report["state"]["session_token_is_browser_credential"] is True
 
 
