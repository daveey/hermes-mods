From 7e81f4a436b908631b8b91485a2f38bb066a84f1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 01:41:42 -0800
Subject: [PATCH] Count the cached_ro fallback inside the close guard

Review nit on #3941: an exception between the private open and its try could
leak the connection.

Co-Authored-By: Contributor <contributor@example.com>
---
 hermes_cli/kanban_session_activity.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index bb66337ca8..df81cd78ce 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -487,9 +487,9 @@ def _private_ro(path: Path, budget: float) -> Iterator[sqlite3.Connection]:
     as the cache, SQLite busy timeout = ``budget`` (the caller passes what is left of its own, capped at the shared
     reader's ``_RO_BUSY_TIMEOUT_S``), always closed afterwards. Counted in ``ro_stats`` once it is open."""
     conn = _open_ro(path, timeout=max(0.0, budget))
-    with _RO_CACHE_LOCK:
-        ro_stats["private_fallbacks"] += 1
     try:
+        with _RO_CACHE_LOCK:
+            ro_stats["private_fallbacks"] += 1
         yield conn
     finally:
         _close_quietly(conn)
-- 
