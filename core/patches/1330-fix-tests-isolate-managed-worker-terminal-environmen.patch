From 081d1905636ab51a76e5947bb37554d7c0ee8637 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 20:56:16 +0000
Subject: [PATCH] fix(tests): isolate managed worker terminal environment
 [daveey]

---
 tests/gateway/test_managed_worker_profile_env.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tests/gateway/test_managed_worker_profile_env.py b/tests/gateway/test_managed_worker_profile_env.py
index 1de2269c661..801e8105aca 100644
--- a/tests/gateway/test_managed_worker_profile_env.py
+++ b/tests/gateway/test_managed_worker_profile_env.py
@@ -10,6 +10,11 @@ def test_secondary_worker_env_drops_launch_terminal_policy_and_env_settings(tmp_
     env a standalone ``hermes -p X`` gateway would build — X's HERMES_HOME and X's ``.env`` over a
     base without the launch profile's ``TERMINAL_*`` policy or launch-only ``.env`` settings."""
     from gateway.session_managed_worker import _worker_env
+    # Own the terminal inputs: worker shells can carry derived flags (e.g. image pinning)
+    # that are not launch-profile config or dotenv residue.
+    for key in list(os.environ):
+        if key.upper().startswith('TERMINAL_'):
+            monkeypatch.delenv(key)
     root = tmp_path / '.hermes'
     beta = root / 'profiles' / 'beta'
     beta.mkdir(parents=True)
-- 
