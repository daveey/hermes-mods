From 4289fd969eff43be45b8a2ae41b071d62243fadd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 01:31:42 +0000
Subject: [PATCH 6295] Fail-closed startup readiness and natural controller rollover

Public mirror of source commit 4289fd969eff43be45b8a2ae41b071d62243fadd.

---
diff --git a/hermes_cli/always_on_deployment.py b/hermes_cli/always_on_deployment.py
index 0f70acb6b6b..d84eec09a8d 100644
--- a/hermes_cli/always_on_deployment.py
+++ b/hermes_cli/always_on_deployment.py
@@ -15,10 +15,10 @@
 
 def refresh_standalone_controller() -> None:
     entry = Path.home() / '.local/share/hermes-always-on/always_on_dashboard.py'
-    if not entry.exists():
-        return
     if entry.is_symlink():
         raise OSError(f'refusing symlink controller entrypoint: {entry}')
+    if not entry.exists():
+        return
     previous = entry.read_text(encoding='utf-8-sig')
     if _MARKER not in previous and 'def _interim_main()' not in previous:
         raise OSError(f'unrecognized standalone controller: {entry}')
diff --git a/tests/hermes_cli/test_always_on_deployment.py b/tests/hermes_cli/test_always_on_deployment.py
index 5ea1e0f00fa..19ec21393c3 100644
--- a/tests/hermes_cli/test_always_on_deployment.py
+++ b/tests/hermes_cli/test_always_on_deployment.py
@@ -61,6 +61,20 @@
     assert entry.read_text() == original
 
 
+def test_dangling_symlink_entrypoint_is_preserved_without_restart(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path))
+    entry = tmp_path / '.local/share/hermes-always-on/always_on_dashboard.py'
+    entry.parent.mkdir(parents=True)
+    target = tmp_path / 'missing-controller.py'
+    entry.symlink_to(target)
+    calls = []
+    assert not ro.request_roll(run=lambda argv, **kw: calls.append(argv) or subprocess.CompletedProcess(argv, 0))
+    assert not calls
+    assert entry.is_symlink()
+    assert entry.readlink() == target
+    assert not target.exists()
+
+
 def test_loader_uses_current_checkout_not_adjacent_stale_roller(tmp_path, monkeypatch):
     monkeypatch.setenv('HOME', str(tmp_path))
     core = tmp_path / 'installed core'
