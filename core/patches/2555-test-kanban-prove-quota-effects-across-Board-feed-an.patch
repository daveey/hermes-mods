From 44c9c20dd61dba0a6d90ecb41a59c2e83960bf31 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:22:02 +0000
Subject: [PATCH] test(kanban): prove quota effects across Board feed and wall
 retry [daveey]

---
 .../test_kanban_real_board_neutral.py         | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_real_board_neutral.py b/tests/hermes_cli/test_kanban_real_board_neutral.py
index 05780cf319..c69114066b 100644
--- a/tests/hermes_cli/test_kanban_real_board_neutral.py
+++ b/tests/hermes_cli/test_kanban_real_board_neutral.py
@@ -1,6 +1,13 @@
 """Neutral owner losses through real Board release/feed and the actual reaper."""
+import json
+from types import SimpleNamespace
+
 import pytest
 
+from hermes_state import SessionDB
+from hermes_cli import kanban_db_notify as kbn, kanban_quota_release as quota_release
+from tui_gateway import server as notices
+
 from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as dispatch
 from hermes_cli import kanban_db_sync as sync, kanban_sync_client as client
 from hermes_cli import kanban_owner_recovery as recovery
@@ -29,6 +36,24 @@ def test_neutral_release_with_split_feed_and_reopened_store(tmp_path, monkeypatc
     sync.set_mode(conn, "primary")
     previous = sync.set_lease_client(client.HubLeaseClient(hub))
     hooks = []
+    db = SessionDB(home / 'state.db')
+    db.create_session('neutral-chat', source='desktop')
+    session = {'session_key': 'neutral-chat', 'profile_home': str(home),
+               'agent': SimpleNamespace(session_db=db)}
+    wall_path = home / 'fixture-walls.json'
+    persist_wall = quota_release.persist_wall
+    monkeypatch.setattr(kb, '_resolve_rate_limit_cooldown_seconds', lambda: 3600)
+    def failed_wall(*args, **kwargs):
+        raise OSError('fixture wall unavailable')
+    monkeypatch.setattr(quota_release, 'persist_wall', failed_wall)
+    def poll():
+        claims = []
+        texts = notices._collect_kanban_notifications(session, claims)
+        session['_kanban_claims'] = claims
+        if texts:
+            verdict, _, _ = notices._kb_persist_batch(session, texts, True)
+            assert verdict in {'written', 'delivered'}
+            notices._kb_ack_durable(session, {id(t) for t in texts})
     monkeypatch.setattr(kb, "_kanban_observer_consumed", lambda *a: True)
     def observe(name, *args, **kwargs):
         if name == "on_kanban_worker_exited":
@@ -38,6 +63,10 @@ def test_neutral_release_with_split_feed_and_reopened_store(tmp_path, monkeypatc
         tid = kb.create_task(conn, title="neutral Board fixture", assignee="worker", runs_on=[])
         with kbc.write_txn(conn):
             conn.execute("UPDATE tasks SET status='review', consecutive_failures=1, max_retries=2 WHERE id=?", (tid,))
+            if reason == 'rate_limited':
+                for stamp in (1, 2):
+                    conn.execute("INSERT INTO task_runs(task_id,started_at,ended_at,outcome,status) "
+                                 "VALUES (?,?,?,'rate_limited','review')", (tid, stamp, stamp))
         client.push(conn, hub, "default", "failure-fixture", primary=True)
         client.pull(conn, hub, "default", observers=True)
         assert kb.claim_review_task(conn, tid, ttl_seconds=900, claimer=kb._host_prefix() + "fixture")
@@ -47,6 +76,11 @@ def test_neutral_release_with_split_feed_and_reopened_store(tmp_path, monkeypatc
         client.pull(conn, hub, "default", observers=True)
         rid = conn.execute("SELECT current_run_id FROM tasks WHERE id=?", (tid,)).fetchone()[0]
         uid = sync.run_uid(conn, rid)
+        if reason == 'rate_limited':
+            with kbc.write_txn(conn):
+                kb._append_event(conn, tid, 'run_route', {'provider': 'fixture', 'model': 'fixture'}, run_id=rid)
+            client.push(conn, hub, 'default', 'failure-fixture', primary=True)
+        kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id='neutral-chat')
         monkeypatch.setattr(dispatch, "_worker_alive", lambda *a: False)
         monkeypatch.setattr(recovery, "owner_reclaim_blocked", lambda *a, **kw: False)
         monkeypatch.setattr(recovery, "managed_run_exit_code", lambda *a: 1)
@@ -70,12 +104,47 @@ def test_neutral_release_with_split_feed_and_reopened_store(tmp_path, monkeypatc
         def apply_then_reap(*args, **kwargs):
             result = real_apply(*args, **kwargs)
             dispatch.detect_crashed_workers(conn)
+            poll()
             return result
         monkeypatch.setattr(sync, "apply_remote_changes", apply_then_reap)
         client.pull(conn, hub, "default", observers=True)
         dispatch.detect_crashed_workers(conn)
         row = conn.execute("SELECT status,consecutive_failures FROM tasks WHERE id=?", (tid,)).fetchone()
         assert tuple(row) == (("triage", 2) if alarm_first else ("review", 1))
+        if reason == 'rate_limited':
+            expected = int(not alarm_first)
+            for kind in ('quota_episode', 'quota_episode_notice'):
+                assert conn.execute('SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind=?',
+                                    (tid, kind)).fetchone()[0] == expected
+            assert conn.execute("SELECT COUNT(*) FROM task_comments WHERE task_id=? AND body LIKE 'Quota wall:%'",
+                                (tid,)).fetchone()[0] == expected
+            assert not wall_path.exists()
+            if not alarm_first:
+                assert not hooks
+                assert quota_release.pending_task(conn, tid)
+                state = json.loads(conn.execute('SELECT state FROM kanban_quota_effects').fetchone()[0])
+                assert state['count'] == 3
+                assert state['provider'] == 'fixture'
+                assert dispatch.check_respawn_guard(conn, tid, lane='review') == 'rate_limit_cooldown'
+                conn.close()
+                conn = kbc.connect(path)
+                monkeypatch.setattr(quota_release, 'persist_wall',
+                                    lambda p, until: persist_wall(p, until, path=wall_path))
+                dispatch.detect_crashed_workers(conn)
+                assert json.loads(wall_path.read_text()) == {'fixture': state['until']}
+                assert not quota_release.pending_task(conn, tid)
+            poll()
+            messages = db.get_messages('neutral-chat')
+            quota_messages = [m for m in messages if 'quota wall:' in m['content']]
+            assert len(quota_messages) == expected, messages
+            if quota_messages:
+                assert '3 consecutive requeues' in quota_messages[0]['content']
+            db.close()
+            db = SessionDB(home / 'state.db')
+            session['agent'] = SimpleNamespace(session_db=db)
+            dispatch.detect_crashed_workers(conn)
+            poll()
+            assert db.get_messages('neutral-chat') == messages
         assert len(hooks) == (0 if alarm_first else 1)
         if hooks:
             assert hooks[0]["outcome"] == outcome
@@ -86,3 +155,4 @@ def test_neutral_release_with_split_feed_and_reopened_store(tmp_path, monkeypatc
     finally:
         sync.set_lease_client(previous)
         conn.close()
+        db.close()
-- 
