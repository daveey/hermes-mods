From fbd4ed1385a4de33b69801eaa7944c2b0a2e9883 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:26:46 +0000
Subject: [PATCH] [daveey] kanban metadata files: a whole-value path names only
 itself (no phantom skip); test outside, whole-value and unmanaged cases

Follow-up to #738. `_candidates` added a whole-value path (one that may hold
spaces) and then also tokenized the same string, so `<ws>/replay report.md`
yielded `<ws>/replay` too, which was logged and recorded under
`attached_from_workspace_skipped` as a phantom skip. A string whose whole value
is an existing file under the workspace now names only that file; any other
string is tokenized as before (`"<ws>/a.md <ws>/b.md"` still copies both).

New tests in tests/hermes_cli/test_kanban_metadata_files.py: symlink and
`ws/../` paths that resolve outside are skipped, not copied; a spaced whole-value
path is copied once with no skip entry; a two-path value copies both; dir and
worktree workspaces (placed under the managed root so only the kind gate keeps
them out) and a scratch workspace outside managed storage are neither copied nor
rewritten.

Proof (scripts/run_tests.sh tests/hermes_cli/test_kanban_metadata_files.py):
- 41ca81cd93cc kanban_metadata_files.py: 1 failed (..._records_no_phantom_skip)
- mutant 738-K4-outside-allowed: 1 failed (..._resolve_outside_are_not_copied)
- mutant 738-K10-no-whole-value: 2 failed (spaced copy + no phantom skip)
- mutant 738-K13-unmanaged-too: 1 failed (..._outside_managed_storage_is_not_copied)
- _scratch_workspace kind gate dropped: 2 failed (dir, worktree)
- this tree: 12 passed, 0 failed
---
 hermes_cli/kanban_metadata_files.py           |  9 +-
 .../hermes_cli/test_kanban_metadata_files.py  | 98 +++++++++++++++++++
 2 files changed, 106 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_metadata_files.py b/hermes_cli/kanban_metadata_files.py
index 4b497171f50..a1692ee660a 100644
--- a/hermes_cli/kanban_metadata_files.py
+++ b/hermes_cli/kanban_metadata_files.py
@@ -68,7 +68,13 @@ def _rewrite(value: Any, mapping: dict[str, str], top: bool = True) -> Any:
 
 
 def _candidates(metadata: dict, prefixes: list[str]) -> list[str]:
-    """Workspace paths named by metadata strings, in first-seen order."""
+    """Workspace paths named by metadata strings, in first-seen order.
+
+    A string whose whole value is one existing file under the workspace names
+    only that file: it may contain spaces, and tokenizing it as well would
+    yield its leading fragment (``<ws>/replay`` from ``<ws>/replay report.md``)
+    as a phantom path that is then recorded as skipped. [daveey]
+    """
     pattern = re.compile(
         "(?:" + "|".join(re.escape(p) for p in prefixes) + r")[/\\][^\s`\"'<>]+"
     )
@@ -78,6 +84,7 @@ def _candidates(metadata: dict, prefixes: list[str]) -> list[str]:
         # A value that is exactly one path may contain spaces the regex stops at.
         if any(whole.startswith(p + "/") for p in prefixes) and Path(whole).is_file():
             seen.setdefault(whole)
+            continue
         for match in pattern.finditer(text):
             seen.setdefault(match.group(0).rstrip(_TRAILING_PUNCT))
     return list(seen)
diff --git a/tests/hermes_cli/test_kanban_metadata_files.py b/tests/hermes_cli/test_kanban_metadata_files.py
index ca8f1c4105a..a4eb6238a9c 100644
--- a/tests/hermes_cli/test_kanban_metadata_files.py
+++ b/tests/hermes_cli/test_kanban_metadata_files.py
@@ -4,6 +4,7 @@ if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.s
 
 import json
 import logging
+import os
 from pathlib import Path
 
 import pytest
@@ -119,3 +120,100 @@ def test_file_both_declared_and_named_is_copied_once(kanban_home):
     assert [a.filename for a in attachments] == ["chart.png"]
     assert run.metadata["chart"] == run.metadata["artifacts"][0]
     assert Path(run.metadata["chart"]).read_bytes() == b"png"
+
+
+def test_workspace_paths_that_resolve_outside_are_not_copied(kanban_home, tmp_path):
+    secret = tmp_path / "secret.txt"
+    secret.write_text("private")
+    with kbc.connect_closing() as conn:
+        t, ws, run_id = _scratch_card(conn)
+        link = ws / "link.txt"
+        link.symlink_to(secret)
+        dotted = f"{ws}/{os.path.relpath(secret, ws)}"
+        meta = {"link": str(link), "dotted": dotted}
+        assert kb.complete_task(conn, t, summary="done", metadata=meta, expected_run_id=run_id)
+        run = kb.latest_run(conn, t)
+        assert kb.list_attachments(conn, t) == []
+    assert run.metadata["link"] == str(link)
+    assert run.metadata["dotted"] == dotted
+    skipped = run.metadata[kmf.SKIPPED_KEY]
+    assert "outside" in skipped[str(link)] and "outside" in skipped[dotted], skipped
+    assert not kb.task_attachments_dir(t).exists()
+
+
+def _spaced(conn):
+    t, ws, run_id = _scratch_card(conn)
+    report = ws / "replay report v2.md"
+    report.write_text("rows\n")
+    assert kb.complete_task(conn, t, summary="done", metadata={"report": str(report)}, expected_run_id=run_id)
+    return t, kb.latest_run(conn, t)
+
+
+def test_a_whole_value_path_with_spaces_is_copied(kanban_home):
+    with kbc.connect_closing() as conn:
+        t, run = _spaced(conn)
+        attachments = kb.list_attachments(conn, t)
+    kept = Path(run.metadata["report"])
+    assert kept.parent == kb.task_attachments_dir(t)
+    assert kept.read_text() == "rows\n"
+    assert [a.filename for a in attachments] == ["replay report v2.md"], "copied once"
+
+
+def test_a_whole_value_path_with_spaces_records_no_phantom_skip(kanban_home):
+    with kbc.connect_closing() as conn:
+        _t, run = _spaced(conn)
+    assert kmf.SKIPPED_KEY not in run.metadata, run.metadata.get(kmf.SKIPPED_KEY)
+
+
+def test_a_value_naming_two_paths_copies_both(kanban_home):
+    with kbc.connect_closing() as conn:
+        t, ws, run_id = _scratch_card(conn)
+        (ws / "a.md").write_text("a\n")
+        (ws / "b.md").write_text("b\n")
+        meta = {"files": f"{ws}/a.md {ws}/b.md"}
+        assert kb.complete_task(conn, t, summary="done", metadata=meta, expected_run_id=run_id)
+        run = kb.latest_run(conn, t)
+        attachments = kb.list_attachments(conn, t)
+    assert kmf.SKIPPED_KEY not in run.metadata, run.metadata.get(kmf.SKIPPED_KEY)
+    assert sorted(a.filename for a in attachments) == ["a.md", "b.md"]
+    a, b = (Path(p) for p in run.metadata["files"].split(" "))
+    assert (a.read_text(), b.read_text()) == ("a\n", "b\n")
+    assert a.parent == b.parent == kb.task_attachments_dir(t)
+
+
+def _assert_named_file_left_alone(conn, t, ws, run_id):
+    report = ws / "REPORT.md"
+    report.write_text("rows\n")
+    meta = {"report": str(report), "notes": f"see {report}."}
+    assert kb.complete_task(conn, t, summary="done", metadata=meta, expected_run_id=run_id)
+    run = kb.latest_run(conn, t)
+    assert kb.list_attachments(conn, t) == []
+    assert run.metadata == meta, "neither copied nor rewritten"
+    assert not kb.task_attachments_dir(t).exists()
+    assert report.read_text() == "rows\n"
+
+
+@pytest.mark.parametrize("kind", ["dir", "worktree"])
+def test_dir_and_worktree_workspace_files_are_not_copied(kanban_home, kind):
+    # Under the managed workspaces root, so only the workspace kind keeps them out.
+    ws = kanban_home / "kanban" / "workspaces" / f"shared-{kind}"
+    ws.mkdir(parents=True)
+    with kbc.connect_closing() as conn:
+        t = kb.create_task(conn, title="replay", assignee="default")
+        # Set the kind directly: creating one would also check host capabilities.
+        conn.execute(
+            "UPDATE tasks SET workspace_kind = ?, workspace_path = ? WHERE id = ?", (kind, str(ws), t),
+        )
+        conn.commit()
+        assert kb.claim_task(conn, t)
+        _assert_named_file_left_alone(conn, t, ws, kb.get_task(conn, t).current_run_id)
+
+
+def test_scratch_workspace_outside_managed_storage_is_not_copied(kanban_home, tmp_path):
+    ws = tmp_path / "checkout"
+    ws.mkdir()
+    with kbc.connect_closing() as conn:
+        t = kb.create_task(conn, title="replay", assignee="default")
+        kbw.set_workspace_path(conn, t, ws)
+        assert kb.claim_task(conn, t)
+        _assert_named_file_left_alone(conn, t, ws, kb.get_task(conn, t).current_run_id)
