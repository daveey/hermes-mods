diff --git a/tests/hermes_cli/test_empty_toolset_launches.py b/tests/hermes_cli/test_empty_toolset_launches.py
new file mode 100644
index 00000000000..f52215a8fa5
--- /dev/null
+++ b/tests/hermes_cli/test_empty_toolset_launches.py
@@ -0,0 +1,72 @@
+"""An explicitly empty toolset pick is not an absent profile override."""
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_policy import build_policy
+from hermes_cli import main, main_tui_launch, oneshot
+from hermes_cli.gateway_chat import _requested_policy
+
+
+@pytest.mark.parametrize('value', ['', ' , ', [], ['']])
+def test_legacy_oneshot_preserves_empty_pick(monkeypatch, value):
+    captured = {}
+
+    def run(prompt, **kwargs):
+        captured.update(kwargs)
+        return 'no tools', {'completed': True}
+
+    monkeypatch.setattr(oneshot, '_run_agent', run)
+    monkeypatch.setattr(oneshot, '_silence_console_log_handlers', lambda: None)
+    assert oneshot.run_oneshot('list tools', toolsets=value) == 0
+    assert captured['toolsets'] == []
+    assert captured['use_config_toolsets'] is False
+
+
+@pytest.mark.parametrize('explicit', [False, True])
+def test_current_z_frozen_policy(tmp_path, explicit):
+    args = main._light_chat_parser().parse_args(['-z', 'list tools'] + (['-t', ''] if explicit else []))
+    params = {'source': 'cli', 'cwd': str(tmp_path), 'model': 'test', **_requested_policy(args)}
+    policy = build_policy(params, {'platform_toolsets': {'cli': ['web']}}, profile_terminal=False)
+    assert policy.toolsets == (() if explicit else ('web',))
+
+
+@pytest.mark.parametrize('explicit', [False, True])
+def test_tui_launch_to_frozen_policy(monkeypatch, tmp_path, explicit):
+    monkeypatch.setenv('HERMES_PYTHON', sys.executable)
+    monkeypatch.delenv('HERMES_TUI_TOOLSETS', raising=False)
+    monkeypatch.setattr(main_tui_launch, '_make_tui_argv', lambda *a: (['node', 'unused'], Path('.')))
+    captured = {}
+
+    def capture(argv, cwd=None, env=None):
+        assert env is not None
+        captured.update(env)
+        return 1
+
+    monkeypatch.setattr(main.subprocess, 'call', capture)
+    with pytest.raises(SystemExit):
+        main._launch_tui(toolsets='' if explicit else None)
+    assert ('HERMES_TUI_TOOLSETS' in captured) is explicit
+    # canonicalGateway.test.ts exercises the env-to-wire translation in the JS suite.
+    # Python CI deliberately does not install npm dependencies.
+    params = {'source': 'tui', 'cwd': str(tmp_path), 'model': 'test'}
+    if explicit:
+        assert captured['HERMES_TUI_TOOLSETS'] == ''
+        params['toolsets'] = []
+    policy = build_policy(params, {'platform_toolsets': {'cli': ['web']}}, profile_terminal=False)
+    # An unpinned TUI also receives its built-in project surface toolset.
+    assert policy.toolsets == (() if explicit else ('project', 'web'))
+
+
+@pytest.mark.parametrize(('selection', 'label'), [(None, 'all'), ([], 'none'), (['web'], 'web')])
+def test_config_toolset_label(capsys, selection, label):
+    from datetime import datetime
+    from cli import HermesCLI
+    stand_in = SimpleNamespace(api_key=None, agent=None, model='test', base_url='https://example.invalid',
+                               enabled_toolsets=selection, max_turns=1, verbose=False, session_start=datetime.now())
+    HermesCLI.show_config(stand_in)
+    output = capsys.readouterr().out
+    line = next(line for line in output.splitlines() if 'Toolsets' in line)
+    assert label in line
diff --git a/ui-tui/src/__tests__/canonicalGateway.test.ts b/ui-tui/src/__tests__/canonicalGateway.test.ts
index 4d96332802f..fe2cf145014 100644
--- a/ui-tui/src/__tests__/canonicalGateway.test.ts
+++ b/ui-tui/src/__tests__/canonicalGateway.test.ts
@@ -2,6 +2,17 @@ import { expect, it } from 'vitest'
 
 import { canonicalRequest, canonicalResult, localCreationOptions, sharedControlParams } from '../canonicalGateway.js'
 
+it('preserves an empty toolset pick and leaves an absent pick to the profile', () => {
+  expect(localCreationOptions({} as NodeJS.ProcessEnv)).not.toHaveProperty('toolsets')
+  const contract = { sources: ['tui'], parameters: ['request_id', 'source', 'toolsets'] }
+  for (const value of ['', ' , ']) {
+    const options = localCreationOptions({ HERMES_TUI_TOOLSETS: value } as NodeJS.ProcessEnv)
+    expect(options.toolsets).toEqual([])
+    expect(canonicalRequest('session.create', { request_id: 'empty', ...options }, contract).params.toolsets).toEqual([])
+  }
+  expect(localCreationOptions({ HERMES_TUI_TOOLSETS: 'web, terminal, ' } as NodeJS.ProcessEnv).toolsets).toEqual(['web', 'terminal'])
+})
+
 it.each(['HERMES_SAFE_MODE', 'HERMES_IGNORE_USER_CONFIG'])('carries %s on the launching session policy', flag => {
   const field = flag === 'HERMES_SAFE_MODE' ? 'safe_mode' : 'ignore_user_config'
   const options = localCreationOptions({ [flag]: '1' } as NodeJS.ProcessEnv)
diff --git a/ui-tui/src/canonicalGateway.ts b/ui-tui/src/canonicalGateway.ts
index 100eceb31ed..4078de773f7 100644
--- a/ui-tui/src/canonicalGateway.ts
+++ b/ui-tui/src/canonicalGateway.ts
@@ -108,7 +108,9 @@ export function localCreationOptions(env = process.env): Record<string, unknown>
 
   const options: Record<string, unknown> = Object.fromEntries(Object.entries(fields).filter(([, value]) => value))
 
-  if (env.HERMES_TUI_TOOLSETS) { options.toolsets = env.HERMES_TUI_TOOLSETS.split(',') }
+  if (env.HERMES_TUI_TOOLSETS !== undefined) {
+    options.toolsets = env.HERMES_TUI_TOOLSETS.split(',').map(name => name.trim()).filter(Boolean)
+  }
 
   // `hermes --tui -s a,b`: the owner renders these into the session's frozen prompt.
   const skills = [...new Set((env.HERMES_TUI_SKILLS ?? '').split(/[,\n]/).map(name => name.trim()).filter(Boolean))]
