             e.get('kind') == 'unblocked' and order_key(e) > order_key(event) for e in events)
 
-    candidates = [e for e in events if e.get('uid') == episode] if episode else [
-        e for e in events if e['kind'] in KINDS.get(status, ()) or assignment(e)]
