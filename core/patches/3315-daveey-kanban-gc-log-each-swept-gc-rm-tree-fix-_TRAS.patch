From 2b66b860176e19f760a3b03612a01895f49da4e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:11:45 +0000
Subject: [PATCH] [daveey] kanban gc: log each swept gc-rm tree; fix
 _TRASH_INFIX order comment

PR #2022 review nit (review 5888479724, t_01a1d41d70abb3e4). gc_task_scratch
renames the workspace to .<name>.gc-rm-<uuid> before _log_scratch_removal, so
a log failure rolls back the txn but leaves the tree detached with no removal
record; the next _sweep_detached_trash then deleted it silently.

- Correct the comment above _TRASH_INFIX to state the real order.
- _sweep_detached_trash now logs a warning for every tree it deletes, so a
  tree swept without a removal record still leaves a trace.

Test: test_each_swept_tree_is_logged (RED before, GREEN after).
---
 hermes_cli/kanban_worktree_gc.py                      |  6 +++++-
 .../hermes_cli/test_kanban_scratch_gc_trash_sweep.py  | 11 +++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_worktree_gc.py b/hermes_cli/kanban_worktree_gc.py
index 6dae8b40c8..1d514f849d 100644
--- a/hermes_cli/kanban_worktree_gc.py
+++ b/hermes_cli/kanban_worktree_gc.py
@@ -124,7 +124,9 @@ def gc_task_scratch(conn: sqlite3.Connection, *, older_than_days: int | None = N
 
 
 # A tree detached for removal: ``.<workspace name>.gc-rm-<uuid4 hex>``, a sibling of the workspace.
-# Only this GC creates the name, after the owner check passed and the removal was logged.
+# Only this GC creates the name, after the owner check passed; the rename runs before the removal
+# is logged, so a log failure rolls the txn back but leaves the tree detached with no removal
+# record. _sweep_detached_trash therefore logs every tree it deletes.
 _TRASH_INFIX = ".gc-rm-"
 _TRASH_NAME = re.compile(r"\..+\.gc-rm-[0-9a-f]{32}")
 
@@ -157,6 +159,8 @@ def _sweep_detached_trash(root: Path, rows) -> None:
             shutil.rmtree(trash, ignore_errors=True)
             if os.path.lexists(trash):
                 log.warning("Scratch GC left detached tree %s; retried next run", trash)
+            else:
+                log.warning("Scratch GC swept detached tree %s left by an earlier run", trash)
 
 
 def _scratch_owner_unchanged(conn: sqlite3.Connection, row: sqlite3.Row, path: Path) -> bool:
diff --git a/tests/hermes_cli/test_kanban_scratch_gc_trash_sweep.py b/tests/hermes_cli/test_kanban_scratch_gc_trash_sweep.py
index db6ac47b7d..4570d9818f 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_trash_sweep.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_trash_sweep.py
@@ -42,6 +42,17 @@ def test_stale_detached_tree_is_swept_and_not_reported(board, caplog):
     assert "owner_unverified" not in caplog.text
 
 
+def test_each_swept_tree_is_logged(board, caplog):
+    # The rename runs before the removal is logged, so a failed log leaves trash with no removal
+    # record: the sweep itself must leave a trace for every tree it deletes (PR #2022 review nit).
+    trees = [_stale_trash("t_a"), _stale_trash("t_b")]
+    with caplog.at_level(logging.WARNING, logger=gc.log.name):
+        _run_gc()
+    for trash in trees:
+        assert not trash.exists()
+        assert f"swept detached tree {trash}" in caplog.text
+
+
 def test_sweep_leaves_lookalike_names_alone(board, caplog):
     root = kb.workspaces_root()
     root.mkdir(parents=True, exist_ok=True)
-- 
