diff --git a/gateway/run_deferred_workers.py b/gateway/run_deferred_workers.py
new file mode 100644
index 00000000000..d86cbd6421e
--- /dev/null
+++ b/gateway/run_deferred_workers.py
@@ -0,0 +1,12 @@
+"""Release-side publication for executor work that outlives its turn [daveey]."""
+from contextlib import suppress
+
+
+def discard_deferred_worker(runner, workers, done_future):
+    workers.pop(done_future, None)
+    # No later waiter remains; consume failures so asyncio does not warn (#98973).
+    if not done_future.cancelled():
+        with suppress(Exception):
+            done_future.exception()
+    # The originating turn published while this worker was live. Recount AFTER release.
+    runner._persist_active_agents()
diff --git a/gateway/run_runtime_heartbeat.py b/gateway/run_runtime_heartbeat.py
new file mode 100644
index 00000000000..7d0ef3bd2bb
--- /dev/null
+++ b/gateway/run_runtime_heartbeat.py
@@ -0,0 +1,29 @@
+"""Thread heartbeat plus a coalesced, owner-loop busy-count refresh [daveey]."""
+import threading
+
+
+def runtime_heartbeat(runner, loop):
+    """Keep thread liveness independent of the loop; never sample authority state here.
+
+    A wedged loop retains at most one callback. Once it runs, the next tick may
+    enqueue another; closing a loop must not suppress the thread-side stamp.
+    """
+    pending = threading.Event()
+
+    def refresh():
+        try:
+            runner._persist_active_agents()
+        finally:
+            pending.clear()
+
+    def tick():
+        from gateway.run import _write_runtime_status_quiet
+        _write_runtime_status_quiet()
+        if runner is None or loop is None or pending.is_set():
+            return
+        pending.set()
+        try:
+            loop.call_soon_threadsafe(refresh)
+        except RuntimeError:  # loop closed during shutdown; retry only on a later tick
+            pending.clear()
+    return tick
