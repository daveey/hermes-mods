From 559d6ee3a0c97766c67992fa94605be529756ad3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:40:57 +0000
Subject: [PATCH] [daveey] kanban sync replica alarm: read the replica stamp
 through the lock guard

---
 hermes_cli/kanban_sync_replica_age.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_replica_age.py b/hermes_cli/kanban_sync_replica_age.py
index 5974ab37f2..71e5f32fe7 100644
--- a/hermes_cli/kanban_sync_replica_age.py
+++ b/hermes_cli/kanban_sync_replica_age.py
@@ -95,8 +95,9 @@ def _stamp(slug: str) -> Optional[float]:
     path = ksc.shadow_path(slug)
     if not path.exists():
         return None
+    from hermes_cli import kanban_lockguard
     try:
-        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1.0)
+        conn = kanban_lockguard.connect(Path(path).resolve().as_uri() + "?mode=ro", uri=True, timeout=1.0)
         try:
             row = conn.execute("SELECT pulled_at FROM kanban_sync_state LIMIT 1").fetchone()
         finally:
