From 8a2f55037185d51912b3bbd08c5b1ec06ab1b7de Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:04:59 +0000
Subject: [PATCH] [daveey] kanban: route kanban_schema_owner to the upgrade
 lane; pin utf-8 on the alert's git probe; mark the in-memory reference schema
 connect

---
 hermes_cli/kanban_schema_owner.py      | 2 +-
 hermes_cli/kanban_sync_schema_alert.py | 2 +-
 scripts/ci/classify_changes.py         | 1 +
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_schema_owner.py b/hermes_cli/kanban_schema_owner.py
index 2c0181e3e2..2a3d8931be 100644
--- a/hermes_cli/kanban_schema_owner.py
+++ b/hermes_cli/kanban_schema_owner.py
@@ -136,7 +136,7 @@ def _reference_schema() -> dict[str, frozenset[str]]:
             from hermes_cli import kanban_db as kb
             from hermes_cli import kanban_db_connect as kbc
             from hermes_cli.kanban_wake_episode import ensure_schema
-            mem = sqlite3.connect(":memory:", isolation_level=None)
+            mem = sqlite3.connect(":memory:", isolation_level=None)  # noqa: kanban-lockguard (in-memory reference schema, not a board)
             try:
                 mem.row_factory = sqlite3.Row
                 mem.executescript(kb.SCHEMA_SQL)
diff --git a/hermes_cli/kanban_sync_schema_alert.py b/hermes_cli/kanban_sync_schema_alert.py
index 626bf4678b..e8ac1fae19 100644
--- a/hermes_cli/kanban_sync_schema_alert.py
+++ b/hermes_cli/kanban_sync_schema_alert.py
@@ -91,7 +91,7 @@ def cores(home: Optional[Path] = None) -> dict[str, Optional[str]]:
         if git:
             try:
                 out = subprocess.run([git, "-C", str(installed), "rev-parse", "origin/main"], capture_output=True,
-                                     text=True, timeout=10, check=False)
+                                     text=True, encoding="utf-8", errors="replace", timeout=10, check=False)
                 origin_main = out.stdout.strip() if out.returncode == 0 else None
             except (OSError, subprocess.SubprocessError):
                 origin_main = None
diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 5164cb95d1..20d9c347f9 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -436,6 +436,7 @@ _UPDATE_DEPENDENCIES = (
     "agent/deadline.py",  # bounded probes' process-tree timeout cleanup
     "hermes_cli/kanban_db.py",  # update_upstream_conflict files the conflict card
     "hermes_cli/kanban_db_connect.py",
+    "hermes_cli/kanban_schema_owner.py",  # post_update reports a board schema only the installed core may migrate
     "hermes_cli/kanban_capability_routing.py",  # update_pause_siblings names this host's Board gateway
     "hermes_cli/kanban_foreign_card.py",  # update_pause_siblings reads sibling alarms in the Board replica
     # migrate_all_homes' second-hop provider/profile decisions, run on every update. Its
-- 
2.51.0

