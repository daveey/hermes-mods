From c9f58789d328ce28e779ddbc90f3231ca024fa17 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:10:18 +0000
Subject: [PATCH] fix(kanban): preserve fan-in acceptance and qualify wake
 guidance [daveey]

---
 hermes_cli/kanban_awaiting_board.py             |  4 +++-
 hermes_cli/kanban_wake_check.py                 |  9 ++++++---
 .../test_kanban_awaiting_cross_board.py         | 17 +++++++++++++++++
 3 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_awaiting_board.py b/hermes_cli/kanban_awaiting_board.py
index 0fdd72e8dce..6bc7270f229 100644
--- a/hermes_cli/kanban_awaiting_board.py
+++ b/hermes_cli/kanban_awaiting_board.py
@@ -57,7 +57,9 @@ def cross_board_cycle(conn, task_id, awaiting):
         if key in seen:
             return None
         if len(seen) >= 32:
-            return "producer dependency graph exceeds the bounded cycle check"
+            # Preserve the existing bounded, best-effort local cycle check:
+            # a large acyclic fan-in is not evidence of a cycle.
+            return None
         seen.add(key)
         row = owner.execute("SELECT status FROM tasks WHERE id=?", (ref,)).fetchone()
         if not row:
diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index 186c7def4b2..653d75f41be 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -761,11 +761,14 @@ def finished_producer(conn: sqlite3.Connection, task_id: str, cmd: str) -> Optio
 
 def producer_note(hit: dict) -> str:
     ref, gw = hit["ref"], hit.get("gateway")
-    where = gw or "this board"
+    board = hit.get("board")
+    where = gw or board or "this board"
+    scope = f" --gateway {gw}" if gw else ""
+    scope += f" --board {board}" if board else ""
     return (f"Woken: producer card {ref} on {where} is {hit['producer_status']} (completed {hit['completed_at']}), but this park's "
             f"wake_check still exits 1, so it can't see that card (`hermes kanban show` reads only this host's "
-            f"board). Read {ref}'s result and act on it. To wait on a card on another gateway, use "
-            f"`hermes kanban wait-check task {ref} --gateway {gw or '<gw>'}`, or omit wake_check: a card wait gets "
+            f"board). Read {ref}'s result and act on it. To wait on the producer's board, use "
+            f"`hermes kanban wait-check task {ref}{scope}`, or omit wake_check: a card wait gets "
             "that probe automatically. If that card is already blocked, in review or in triage, add "
             "`--from <that status>`. Those statuses count as met, so without it the probe passes at once.")
 
diff --git a/tests/hermes_cli/test_kanban_awaiting_cross_board.py b/tests/hermes_cli/test_kanban_awaiting_cross_board.py
index fc8bc6f199d..c43de25788b 100644
--- a/tests/hermes_cli/test_kanban_awaiting_cross_board.py
+++ b/tests/hermes_cli/test_kanban_awaiting_cross_board.py
@@ -93,6 +93,23 @@ def test_cross_board_cycle_cannot_close_through_local_edge(boards):
             kb.schedule_task(left, a, awaiting={"kind": "card", "ref": b})
 
 
+def test_large_local_fan_in_preserves_bounded_check_behavior(boards):
+    with kbc.connect_closing(db_path=boards[0]) as conn:
+        parents = [kb.create_task(conn, title=f"Parent {i}", assignee="worker") for i in range(40)]
+        producer = kb.create_task(conn, title="Fan-in", assignee="worker", parents=parents)
+        waiter = kb.create_task(conn, title="Waiter", assignee="worker")
+        assert kb.schedule_task(conn, waiter, awaiting={"kind": "card", "ref": producer})
+
+
+def test_producer_note_names_board():
+    from hermes_cli.kanban_wake_check import producer_note
+    note = producer_note({"ref": "t_12345678", "board": "runners", "gateway": None,
+                          "producer_status": "archived", "completed_at": "now"})
+    assert "on runners" in note
+    assert "--board runners" in note
+    assert "--gateway <gw>" not in note
+
+
 def test_same_board_qualifier_keeps_descendant_guard(boards):
     with kbc.connect_closing(db_path=boards[0]) as conn:
         parent = kb.create_task(conn, title="Parent", assignee="worker")
-- 
2.55.0

