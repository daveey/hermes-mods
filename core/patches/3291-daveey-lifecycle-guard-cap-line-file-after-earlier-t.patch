From 9bfb7acc2c0f5a3e44b6c78843ddc9e2a2733bf3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:43:29 +0000
Subject: [PATCH] [daveey] lifecycle guard: cap-line file after earlier text
 reports what was left

Review nit on PR #2005 (t_01a1d40d434b713a): _overrun chose the whole-cap
wording on charged > cap, so a referenced script with exactly cap lines,
read after earlier text spent part of the budget, said "has 10 lines, over
the 10-line scan cap". Name the whole cap only when the own count exceeds it
or nothing was spent; otherwise name what was left. Message only; verdicts
unchanged.

Also count the test fixture's lines in-process instead of shelling out to
wc -l.
---
 cron/lifecycle_guard.py                        |  4 +++-
 .../test_lifecycle_guard_budget_refusal.py     | 18 ++++++++++++++++--
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index 02b1edaa75..23656d601c 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -595,7 +595,9 @@ def _overrun(
     *amount* alone does not exceed what was left."""
     charged = amount if charged is None else charged
     counted = f" ({charged} counted)" if amount <= remaining else ""
-    if charged > cap:
+    # Name the whole cap only when nothing was spent yet or *amount* alone exceeds it; a charged
+    # count over the cap is not enough (a cap-line file after earlier text is over what is left).
+    if amount > cap or remaining >= cap:
         return f"{verb} {amount} {unit}s{counted}, over the {cap}-{unit} scan cap"
     return f"{verb} {amount} {unit}s{counted}, over the {remaining} {unit}s left of the {cap}-{unit} scan cap"
 
diff --git a/tests/cron/test_lifecycle_guard_budget_refusal.py b/tests/cron/test_lifecycle_guard_budget_refusal.py
index 07986af489..3cc544e14e 100644
--- a/tests/cron/test_lifecycle_guard_budget_refusal.py
+++ b/tests/cron/test_lifecycle_guard_budget_refusal.py
@@ -10,7 +10,6 @@ from __future__ import annotations
 
 import json
 import shlex
-import subprocess
 from pathlib import Path
 from types import SimpleNamespace
 
@@ -27,7 +26,8 @@ def _executable(path: Path, text: str) -> Path:
 
 
 def _wc_l(path: Path) -> int:
-    return int(subprocess.run(["wc", "-l", str(path)], capture_output=True, text=True, check=True).stdout.split()[0])
+    """What `wc -l` prints: the file's newline count."""
+    return path.read_bytes().count(b"\n")
 
 
 def test_line_cap_refusal_names_script_and_cap(tmp_path):
@@ -78,6 +78,20 @@ def test_line_cap_refusal_names_remaining_budget(monkeypatch, tmp_path):
     assert "has 9 lines, over the 7 lines left of the 10-line scan cap" in refusal
 
 
+def test_cap_line_file_after_earlier_text_is_over_what_is_left(monkeypatch, tmp_path):
+    """A file of exactly cap lines charges cap+1, but its own count is not over the cap: after
+    earlier text spent part of the budget the message names what was left, not the whole cap."""
+    monkeypatch.setattr(lifecycle_guard, "_MAX_LIFECYCLE_SCAN_LINES", 10)
+    script = _executable(tmp_path / "s.sh", "echo ok\n" * 10)
+
+    unsafe, refusal = scan_gateway_lifecycle(f"true\ntrue\n{shlex.quote(str(script))}")
+
+    assert unsafe is True
+    assert refusal is not None
+    assert _wc_l(script) == 10
+    assert "has 10 lines, over the 7 lines left of the 10-line scan cap" in refusal
+
+
 def test_long_line_refusal_names_script_and_cap(monkeypatch, tmp_path):
     monkeypatch.setattr(lifecycle_guard, "_MAX_LIFECYCLE_SCAN_LINE_BYTES", 512)
     script = _executable(tmp_path / "long.sh", "echo " + "x" * 600 + "\n")
-- 
