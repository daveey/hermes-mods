From 5854cc274c68cf7c4c1bf03fe947d61a16929007 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:09:09 +0000
Subject: [PATCH] [daveey] Move the pinned-machine create note into
 kanban_tools_placement; say a drain claims no new cards

Keeps tools/kanban_tools.py at its FILE_LINES cap and _handle_create at CC 22 (code-health ratchet).
---
 hermes_cli/kanban_queue_position.py | 2 +-
 tools/kanban_tools.py               | 7 ++-----
 tools/kanban_tools_placement.py     | 9 +++++++++
 3 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_queue_position.py b/hermes_cli/kanban_queue_position.py
index c4016bea1a..1c90cee58c 100644
--- a/hermes_cli/kanban_queue_position.py
+++ b/hermes_cli/kanban_queue_position.py
@@ -190,7 +190,7 @@ def headline(place: dict[str, Any]) -> str:
         until = place.get("drain_until_ms")
         bound = (f"announced bound {_stamp_ms(until)}, not guaranteed" if until else "end time unknown")
         return (f"waiting for {machines} (runs_on {runs_on}), which is DRAINING for a core update (Board registry "
-                f"metrics; {bound}): its dispatcher imports and claims no cards until the drain ends")
+                f"metrics; {bound}): its dispatcher claims no new cards until the drain ends")
     words = f"waiting for {machines} (runs_on {runs_on}); this machine cannot lease it"
     if place.get("draining"):
         words += f" ({', '.join(place['draining'])} draining for a core update)"
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index ed24f26b46..af94e06853 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -25,7 +25,7 @@ from hermes_cli.kanban_capabilities import check_tool_create, declaration_requir
 from hermes_cli import kanban_contract_cli as _contract_cli, kanban_overlap, kanban_reason_comment as krc
 from tools.kanban_tools_placement import (_local_placement, _machine_placement, _marker_placement_fields, _persisted_session_id,
                                           _create_session_id, _placement_origin, _placement_refused, _runs_where,
-                                          _effective_board_args, _origin_enrollment, _pin_drain_note)
+                                          _effective_board_args, _origin_enrollment, _pinned_note)
 from tools.kanban_tools_db_hint import generic_tool_error
 from tools.kanban_tools_park_args import (_blocker_id_arg, _clear_blocker_arg, _blocker_scope_args, _park_guard,
                                           _wake_check_args, _wake_check_echo)
@@ -1730,10 +1730,7 @@ def _handle_create(args: dict, **kw) -> str:
             extra["runs_on"] = runs_on
             if pinned_machine:
                 extra["placement"] = _machine_placement(pinned_machine, runs_on)
-                extra["note"] = (f"Created here as {new_tid}; it runs on {pinned_machine} via the board lease "
-                                 f"(runs_on={runs_on}). The pin was honoured: do not re-create it.")
-                if drain := _pin_drain_note(conn, new_tid):  # the target can't claim it yet (t_01a1cca8ed755919)
-                    extra["note"] += " " + drain
+                extra["note"] = _pinned_note(conn, new_tid, pinned_machine, runs_on)  # + drain wait [daveey]
         # Every result says where the card runs (a caller that can't tell re-creates it or never learns it is stranded)
         extra.update(runs_where=_runs_where(runs_on, pinned_machine, marker_placement),  # + contract advisory [daveey]
                      **_contract_cli.create_warning_fields(kb.get_task(conn, new_tid)))
diff --git a/tools/kanban_tools_placement.py b/tools/kanban_tools_placement.py
index 6de7a61e31..892660efd2 100644
--- a/tools/kanban_tools_placement.py
+++ b/tools/kanban_tools_placement.py
@@ -168,6 +168,15 @@ def _pin_drain_note(conn, task_id: str):
         return None
 
 
+def _pinned_note(conn, task_id: str, machine: str, runs_on: list[str]) -> str:
+    """The kanban_create note for a card pinned to another machine's lease, naming a drain that holds it. [daveey]"""
+    note = (f"Created here as {task_id}; it runs on {machine} via the board lease "
+            f"(runs_on={runs_on}). The pin was honoured: do not re-create it.")
+    if drain := _pin_drain_note(conn, task_id):  # the target can't claim it yet (t_01a1cca8ed755919)
+        note += " " + drain
+    return note
+
+
 def _runs_where(runs_on, pinned_machine, marker_placement) -> str:
     """Where a card created on this board runs, for the kanban_create result. Never raises."""
     if marker_placement and marker_placement.get("placement_policy"):
-- 
