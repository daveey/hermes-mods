From 37dfb15fdfc9cde4763972075e56cb74014a57f5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 01:03:10 +0000
Subject: [PATCH 6289] Explicit Carbon routing and model-neutral obligations

Public mirror of source commit 37dfb15fdfc9cde4763972075e56cb74014a57f5.

---
diff --git a/tests/agent/test_carbon_routing.py b/tests/agent/test_carbon_routing.py
index 81070f9c019..d47b34bcaf1 100644
--- a/tests/agent/test_carbon_routing.py
+++ b/tests/agent/test_carbon_routing.py
@@ -44,8 +44,11 @@
     excluded = [(r["provider"], r["model"]) for r in policy["routes"][level] if r != paid]
     with pytest.raises(ModelRoutingError, match="eligible"):
         resolve_model_route("class:" + level, excluded=excluded, **args)
+    # An explicit pin may select carbon, but never an ordinary-only registration.
+    del policy["routes"]["carbon"]
+    policy["enforce_subscription_only"] = True
     with pytest.raises(ModelRoutingError):
-        resolve_model_route("gemini-4-carbon", "gemini", config=carbon_config())
+        resolve_model_route("gemini-4-carbon", "gemini", **args)
 
 
 @pytest.mark.parametrize("key", ["eligible", "funding_verified"])
diff --git a/tests/hermes_cli/test_carbon_picker.py b/tests/hermes_cli/test_carbon_picker.py
index 79218d74aa8..901e0f68abe 100644
--- a/tests/hermes_cli/test_carbon_picker.py
+++ b/tests/hermes_cli/test_carbon_picker.py
@@ -78,6 +78,21 @@
         pin_policy(MODEL, "gemini", cfg)
 
 
+def test_concrete_carbon_pin_resolves_and_verifies(tmp_path):
+    from agent.model_routing import resolve_model_route
+    from agent.model_routing_managed import verify_selected_route
+
+    cfg = carbon_config()
+    pin = resolve_model_route(MODEL, "gemini", config=cfg)
+    assert (pin["provider"], pin["model"]) == ("gemini", MODEL)
+    level, restricted = pin_policy(pin["model"], pin["provider"], cfg)
+    result = resolve_model_route("class:" + level, config=restricted,
+                                 state_path=tmp_path / "routes.db", session_id="picker-pin")
+    assert (result["provider"], result["model"]) == ("gemini", MODEL)
+    assert result["metadata"]["requested_class"] == "carbon"
+    verify_selected_route(result["model"], result["provider"], result["metadata"], cfg)
+
+
 def test_picker_keeps_carbon_on_its_provider_only():
     rows = [{"slug": slug, "models": [MODEL], "featured_models": [MODEL], "total_models": 1}
             for slug in ("gemini", "anthropic", "openai-codex", "openai")]
