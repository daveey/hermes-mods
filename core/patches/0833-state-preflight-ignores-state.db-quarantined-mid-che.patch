From 3a0ba542f30b301e5c8b9d40cbad36f4ff613d78 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:12:51 +0000
Subject: [PATCH] state: preflight ignores state.db quarantined mid-check
 (deflake concurrent quarantine test)

---
 hermes_state_repair.py                     |  4 ++++
 tests/hermes_state/test_zeroed_state_db.py | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/hermes_state_repair.py b/hermes_state_repair.py
index c4f09f68f5..5e5c14a07e 100644
--- a/hermes_state_repair.py
+++ b/hermes_state_repair.py
@@ -556,6 +556,10 @@ def preflight_db_writability(db_path: Path, *, db_label: str = "state.db") -> No
     for p, is_dir in [(db_path.parent, True), *((p, False) for p in (db_path, *sidecars) if p.is_file())]:
         if (is_dir and not p.is_dir()) or os.access(p, os.R_OK | os.W_OK):
             continue
+        if not p.exists():
+            # Vanished between the is_file() listing and access(): a concurrent opener quarantined
+            # (renamed) it. access() on a missing path is False, which is not a permission problem.
+            continue
         x = "x" if is_dir else ""
         in_scope = False
         with contextlib.suppress(OSError, ValueError):
diff --git a/tests/hermes_state/test_zeroed_state_db.py b/tests/hermes_state/test_zeroed_state_db.py
index 510a1ee4b3..b5494350b8 100644
--- a/tests/hermes_state/test_zeroed_state_db.py
+++ b/tests/hermes_state/test_zeroed_state_db.py
@@ -336,3 +336,21 @@ def test_live_connection_0_byte_not_quarantined_in_process(tmp_path, monkeypatch
         conn.commit()
     finally:
         conn.close()
+
+
+def test_preflight_ignores_file_quarantined_mid_check(tmp_path, monkeypatch):
+    """A concurrent opener renaming state.db away between the preflight's is_file() listing and its
+    access() probe must not read as "not writable" (flaky concurrent-quarantine failure)."""
+    import hermes_state_repair as hsr
+
+    db = tmp_path / "state.db"
+    db.write_bytes(bytes(4096))
+    real_access = hsr.os.access
+
+    def access_after_rename(path, mode):
+        if str(path) == str(db) and db.exists():
+            db.rename(tmp_path / "state.db.zeroed-x.bak")
+        return real_access(path, mode)
+
+    monkeypatch.setattr(hsr.os, "access", access_after_rename)
+    hsr.preflight_db_writability(db)  # must not raise
-- 
2.55.0

