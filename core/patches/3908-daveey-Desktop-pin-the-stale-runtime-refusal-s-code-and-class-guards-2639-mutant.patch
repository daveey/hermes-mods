From afe73775c0f0a6fc837d5c7b0758d3b4d050ba24 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:18:03 +0000
Subject: [PATCH] [daveey] Desktop: pin the stale-runtime refusal's code and
 class guards (#2639 mutants)

Post-merge mutation check of #2639 found two clauses in isStaleRuntimeRefusal that
no test pinned:

- K5 (drop `error.code !== 4001`): a JsonRpcGatewayError with another code reading
  "session not found" would count as a definite refusal and be resent.
- K6 (drop the `instanceof JsonRpcGatewayError` check): equivalent as written,
  because isDefiniteSubmitRefusal only called it inside its own instanceof block.

isDefiniteSubmitRefusal now calls the self-guarded isStaleRuntimeRefusal first, so
that class check is the only guard and a test can reach it. Behaviour is unchanged:
the function still returns true for the same inputs.

Two cases are added to the identityless duplicate-turn table in
submit-backend-roll.test.tsx: a -32000 gateway error, and a plain Error that carries
code 4001 with exactly "session not found". In both, the identityless send stays
unconfirmed: one send, no automatic resend.

Mutants (vitest --pool=forks --maxWorkers=1, submit-backend-roll.test.tsx, base f4694c980f7):
baseline 10/10; K1 killed (3 failed), K5 killed (1 failed), K6 killed (1 failed).
The new tests also pass against main's submit.ts (10/10).

Card: t_01a1d6ee904c6235
---
 .../use-prompt-actions/submit-backend-roll.test.tsx  | 12 +++++++++++-
 .../app/session/hooks/use-prompt-actions/submit.ts   |  7 ++++++-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/submit-backend-roll.test.tsx b/apps/desktop/src/app/session/hooks/use-prompt-actions/submit-backend-roll.test.tsx
index 6ff11b46f6..f6b8bb7279 100644
--- a/apps/desktop/src/app/session/hooks/use-prompt-actions/submit-backend-roll.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/submit-backend-roll.test.tsx
@@ -198,7 +198,17 @@ describe('duplicate-turn protection for an identityless send is unchanged', () =
       'a 4001 whose prose only mentions it',
       () => new JsonRpcGatewayError('tool failed: session not found in cache', { code: 4001 })
     ],
-    ['a timeout', () => new Error('request timed out after 1800s: prompt.submit')]
+    ['a timeout', () => new Error('request timed out after 1800s: prompt.submit')],
+    // Only 4001 is the stale-runtime frame: another gateway code with the same bare message is not.
+    [
+      'a non-4001 gateway error reading exactly "session not found"',
+      () => new JsonRpcGatewayError('session not found', { code: -32000 })
+    ],
+    // A transport or wrapper error that copied the code is not a gateway answer.
+    [
+      'a plain Error carrying code 4001 and exactly "session not found"',
+      () => Object.assign(new Error('session not found'), { code: 4001 })
+    ]
   ])('%s keeps the identityless send unconfirmed: no automatic resend', async (_label, staleError) => {
     const backend = rolledBackend('refused', staleError)
     const handle = await render(backend.requestGateway)
diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/submit.ts b/apps/desktop/src/app/session/hooks/use-prompt-actions/submit.ts
index 119fa6754a..a71866f09d 100644
--- a/apps/desktop/src/app/session/hooks/use-prompt-actions/submit.ts
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/submit.ts
@@ -246,8 +246,13 @@ function isStaleRuntimeRefusal(error: unknown): boolean {
  *  refusal. Resending it cannot run a second copy.
  *  Timeouts, disconnects and malformed ACKs are not answers and never match. */
 function isDefiniteSubmitRefusal(error: unknown): boolean {
+  // Self-guarded: only a JsonRpcGatewayError can be the stale-runtime frame.
+  if (isStaleRuntimeRefusal(error)) {
+    return true
+  }
+
   if (error instanceof JsonRpcGatewayError) {
-    if (error.code === 4009 || isStaleRuntimeRefusal(error)) {
+    if (error.code === 4009) {
       return true
     }
 
