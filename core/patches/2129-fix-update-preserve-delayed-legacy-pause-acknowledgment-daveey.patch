From c05bdeaf9aa02d86100135f370a5b89f9706300e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:10:02 +0000
Subject: [PATCH] fix(update): preserve delayed legacy pause acknowledgment
 [daveey]

---
 gateway/cron_pause.py                   |  4 +++-
 tests/gateway/test_update_idle_pause.py | 15 +++++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/gateway/cron_pause.py b/gateway/cron_pause.py
index b8ace6daa0c..5e140df2baf 100644
--- a/gateway/cron_pause.py
+++ b/gateway/cron_pause.py
@@ -35,7 +35,9 @@ def pause_for_update(runner, loop, *, idle_only: bool = False) -> dict:
     loop.call_soon_threadsafe(request)
     done.wait(timeout=5.0)
     accepted = bool(accepted_box and accepted_box[0])
-    return {"pausing": accepted, "already_stopping": bool(accepted_box) and not accepted,
+    # Legacy callers expect an outstanding callback to mean stopping, not a
+    # refusal followed by a delayed drain. Idle-only callbacks expire instead.
+    return {"pausing": accepted, "already_stopping": not accepted and (not idle_only or bool(accepted_box)),
             "busy": bool(refused),
             "pid": os.getpid(), "drain_timeout": drain}
 
diff --git a/tests/gateway/test_update_idle_pause.py b/tests/gateway/test_update_idle_pause.py
index 6151fafc5e1..25818a79a65 100644
--- a/tests/gateway/test_update_idle_pause.py
+++ b/tests/gateway/test_update_idle_pause.py
@@ -104,6 +104,21 @@ def test_active_count_is_checked_in_scheduled_callback(pause_state, monkeypatch)
     runner.request_restart.assert_not_called()
 
 
+def test_legacy_delayed_callback_retains_stopping_ack(pause_state, monkeypatch):
+    runner, preserve = pause_state
+    queued = []
+    event = Mock()
+    event.wait.return_value = False
+    monkeypatch.setattr(cron_pause, "threading", SimpleNamespace(Event=lambda: event))
+    result = cron_pause.pause_for_update(runner, SimpleNamespace(call_soon_threadsafe=queued.append))
+    assert result["already_stopping"] is True
+    assert result["pausing"] is False
+    runner.request_restart.assert_not_called()
+    queued.pop()()
+    runner.request_restart.assert_called_once_with(detached=False, via_service=True)
+    preserve.assert_called_once_with(runner.config)
+
+
 def test_legacy_pause_still_requests_restart_with_active_work(pause_state):
     runner, preserve = pause_state
     runner._active_work_count.return_value = 3
-- 
2.55.0

