From 5d91524c4b61ec9a65592584fadbd8ddfd1ebee6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:29:47 +0000
Subject: [PATCH] [daveey] fix(gateway): a held pick ending onto a class
 default never rerolls the next turn

commit_selection remembered the selection with the frozen pick of the policy BEFORE the release, while
the receipt then held the released policy. The next turn's expected policy is the released one, so the
unchanged selection looked new, minted another intent and replaced the class allocation (provider move
with no profile edit). Remember the pick the receipt now holds.

- tests: in-process and managed hold ending onto class:deep; following turns keep the allocation,
  allocator counters, fences, and record no intent (RED 2 failed -> GREEN).
---
 gateway/session_profile_selection.py        |  5 +-
 tests/gateway/test_bot_chat_follow_entry.py | 58 +++++++++++++++++++++
 2 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/gateway/session_profile_selection.py b/gateway/session_profile_selection.py
index de9d82a7233..a51f967de40 100644
--- a/gateway/session_profile_selection.py
+++ b/gateway/session_profile_selection.py
@@ -108,7 +108,10 @@ def commit_selection(authority, ref, policy, config, model, generation, *, ended
             saved['policy'] = released
             conn.execute('UPDATE state_meta SET value=? WHERE key=?',
                          (_json(saved), POLICY_PREFIX + ref.session_id))
-        selection = json.loads(json.dumps([model, provider, _frozen_pick(expected)]))
+        # Remember the pick the receipt now holds: after an end that is the RELEASED policy, which the
+        # next turn's *expected* is, so an unchanged selection there is not mistaken for a new one.
+        current = released if released is not None else expected
+        selection = json.loads(json.dumps([model, provider, _frozen_pick(current)]))
         key = PREFIX + ref.session_id
         old = _memo(conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone())
         if old is not None and old['selection'] == selection:
diff --git a/tests/gateway/test_bot_chat_follow_entry.py b/tests/gateway/test_bot_chat_follow_entry.py
index d988f6ca7f8..410dd4b1306 100644
--- a/tests/gateway/test_bot_chat_follow_entry.py
+++ b/tests/gateway/test_bot_chat_follow_entry.py
@@ -447,6 +447,64 @@ async def test_managed_unchanged_class_selection_never_rerolls(home, monkeypatch
         store.close_all_db_handles()
 
 
+@pytest.mark.asyncio
+async def test_hold_ending_onto_a_class_default_never_rerolls_after(home, monkeypatch):
+    """A held pick ends on an edit to a class default: the ending turn follows the class once, and the
+    turns after it (no further edit) keep that allocation, its provider and the allocator untouched."""
+    from agent.model_routing_switch_intent import PREFIX as INTENT
+    store, db, authority, owner, ref, built = _bot_chat_owner(home, monkeypatch)
+    try:
+        db.patch_session_model_config(ref.session_id, {
+            'composer_override_profile': {'model': ASTRA, 'provider': 'openai-codex'}})
+        _profile_pick(home, ASTRA, 'openai-codex')
+        await _open(authority, ref)
+        assert (await _turn(authority, owner, ref, built, 'held'))[:2] == (OPUS, 'anthropic'), built
+        _class_default(home)
+        ended = await _turn(authority, owner, ref, built, 'ended')
+        assert ended[0] != 'raised', ended
+        assert 'selection_profile' not in _receipt_model(db, ref)
+        physical = authority.physical_target(ref)
+        ledger = _routing_ledger(home, physical)
+        assert not ledger[0].get('exact_pin', False), ledger
+        for rid in ('c2', 'c3'):
+            assert (await _turn(authority, owner, ref, built, rid))[:2] == ended[:2], built
+            assert _routing_ledger(home, physical) == ledger
+            assert db.get_meta(INTENT + physical) is None
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_managed_hold_ending_onto_a_class_default_never_rerolls_after(home, monkeypatch):
+    from agent.model_routing_switch_intent import PREFIX as INTENT
+    from tests.gateway.test_model_switch_worker_composed import _noop
+    store, db, authority, owner, ref = _owner(home, monkeypatch, _noop)
+    authority.runner._peek_session_state = lambda key: None
+    authority.runner.session_authority = authority
+    try:
+        db.set_session_title(ref.session_id, 'Bot Chat')
+        db.patch_session_model_config(ref.session_id, {
+            'composer_override_profile': {'model': ASTRA, 'provider': 'openai-codex'}})
+        _profile_pick(home, ASTRA, 'openai-codex')
+        await _open(authority, ref)
+        held, _ = _managed_turn(authority, db, ref, monkeypatch, 'held')
+        assert (held.model, held.provider) == (OPUS, 'anthropic')
+        _class_default(home)
+        ended, scope = _managed_turn(authority, db, ref, monkeypatch, 'ended')
+        assert 'selection_profile' not in _receipt_model(db, ref)
+        ledger = _routing_ledger(home, scope['session_id'])
+        assert not ledger[0].get('exact_pin', False), ledger
+        for rid in ('c2', 'c3'):
+            after, scope = _managed_turn(authority, db, ref, monkeypatch, rid)
+            assert (after.model, after.provider) == (ended.model, ended.provider)
+            assert _routing_ledger(home, scope['session_id']) == ledger
+            assert db.get_meta(INTENT + scope['session_id']) is None
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
 # ---- owner stale controls -------------------------------------------------------------------------
 
 
