From 7cb7ccb798e4b2712c08a17f98f4105b86022d07 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 22 Oct 2026 11:41:01 -0700
Subject: [PATCH] ci: run CI review comment on self-hosted hermes-hub runner

Hosted Actions jobs are refused for billing (support ticket 4874098);
every PR's review-comment poller failed before starting.
---
 .github/workflows/ci-review-comment.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/ci-review-comment.yml b/.github/workflows/ci-review-comment.yml
index c456ab520b..2d821b0e42 100644
--- a/.github/workflows/ci-review-comment.yml
+++ b/.github/workflows/ci-review-comment.yml
@@ -46,7 +46,7 @@ jobs:
     if: >-
       github.event.workflow_run.event == 'pull_request' &&
       github.event.workflow_run.head_repository.full_name == github.repository
-    runs-on: ubuntu-latest
+    runs-on: [self-hosted, hermes-hub]
     timeout-minutes: 60
     steps:
       - name: Checkout trusted default branch
-- 
2.55.0

