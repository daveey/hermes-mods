+    const plan = errorRecoveryPlan({ code: 'SESSION_NOT_OWNED', layer: 'gateway', retryable: false })
+    expect(plan.takeOver).toBe(true)
+    expect(plan.startNewSession).toBe(true)
+    expect(plan.retry).toBe(false)
