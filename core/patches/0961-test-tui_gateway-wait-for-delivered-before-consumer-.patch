From fc3b35c0dc557b8739d890318a198a4835e4d298 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 07:10:30 -0700
Subject: [PATCH] test(tui_gateway): wait for delivered() before
 consumer-health receipt assertions (#201)

* test(tui_gateway): wait for delivered() before receipt assertions in consumer-health fixture

submit() sets the submitted event before the poller consumes its return value,
so negative receipt assertions could race ahead of health.delivered(). The
fixture now observes delivered() and complete() waits for it; the exception
test opts out because a raising submit never reaches delivered().
Deadlines stay at main's 60s (9bff6b3d93).

* test(kanban): goal-mode CLI gate test uses a real task-id shape

1184aefb32 made kanban complete reject ids that are not t_<hex>; the fixture still passed 't1', so
test_non_goal_mode_task_skips_gate got rc 2 on main. The id check is correct; the fixture was stale.
---
 .../test_process_consumer_health.py           | 21 +++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_process_consumer_health.py b/tests/tui_gateway/test_process_consumer_health.py
index 9f5d6312815..c95f2e0af4e 100644
--- a/tests/tui_gateway/test_process_consumer_health.py
+++ b/tests/tui_gateway/test_process_consumer_health.py
@@ -42,12 +42,27 @@ def consumer(tmp_path, monkeypatch):
         state["submitted"].set()
         return state["accept"]
     monkeypatch.setattr(server, "_run_prompt_submit", submit)
+    delivered = threading.Event()
+    real_delivered = health.delivered
+
+    def observe_delivery(*args, **kwargs):
+        try:
+            return real_delivered(*args, **kwargs)
+        finally:
+            delivered.set()
+
+    monkeypatch.setattr(health, "delivered", observe_delivery)
     stop = server._start_notification_poller("ui", session)
-    def complete():
+    def complete(*, wait_for_delivery=True):
+        delivered.clear()
         with scoped_current_session_id("origin"):
             p = registry.spawn_local(f"exec {sys.executable} -c 'pass'", session_key="origin")
         assert p._completion_event.wait(60)
         assert state["submitted"].wait(60)
+        # submit() wakes before its return value is consumed. A negative
+        # receipt assertion must not race ahead of health.delivered().
+        if wait_for_delivery:
+            assert delivered.wait(60), "poller never processed the admission result"
     try:
         yield health, registry, session, state, stop, complete
     finally:
@@ -142,7 +157,9 @@ def test_dispatch_exception_revokes_previous_success(consumer, tmp_path, monkeyp
         raise RuntimeError("fixture admission unavailable")
     monkeypatch.setattr(server, "_run_prompt_submit", fail)
     consumer[3]["submitted"].clear()
-    consumer[-1]()
+    # Submission raises before delivered() is called. begin_delivery() must
+    # already have revoked the old receipt when the failing submit is entered.
+    consumer[-1](wait_for_delivery=False)
     wait_until(lambda: not available(consumer, tmp_path), timeout=60)
     assert not available(consumer, tmp_path)
 
