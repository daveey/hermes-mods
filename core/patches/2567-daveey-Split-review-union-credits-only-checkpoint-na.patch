From 7866b4f772ed9e9873b491843fe62cf856240369 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:55:55 +0000
Subject: [PATCH] [daveey] Split-review union credits only checkpoint-named
 awaited parents

Review of PR1291 (t_01a1ced556210471): merged with main's 4c8f9213 (replica-only
review parents), the union rule let a historical parent whose replica history is
unverified (late_run) count its pre-park approval of PR9 toward a holding PR10, so
test_unverified_replica_history_keeps_hold[*-late_run] resumed on the first call.

A parent may now split coverage with its siblings only when the checkpoint's own
`awaited` list names it. A parent that is awaited only because its history could
not be proven finished before the park (legacy checkpoint without `awaited`,
reopened, or replica-unverified) must approve every holding PR on its own, the
pre-split rule. Every awaited parent must still approve some checkpointed PR, and
together they must cover every holding PR.

Tests: live shape (holding {core} only, sibling approves plugin only) resumes; a
legacy checkpoint with split approvals keeps the hold. Mutant that drops the
per-parent rule for unnamed parents fails 3 tests (legacy split + both late_run).
Kanban: t_01a1ceca5ef47102
---
 hermes_cli/kanban_dependency_review.py        | 20 +++++++++-----
 .../test_kanban_dependency_review_split.py    | 26 +++++++++++++++++++
 2 files changed, 40 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index 510e0eecba..a941c605f9 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -376,9 +376,17 @@ def resumes_review(conn, task_id, pr_urls, *, discharged=()):
     reviewed = set().union(*(_reviewed_prs(conn, p, parked_at, row["id"], captured_set) for p in parents))
     if urls.issubset(reviewed):
         return True
-    # Without repair evidence, every awaited parent must approve a checkpointed PR and together
-    # they must approve every holding PR. One approval does not cover a sibling that never
-    # reviewed, and a named unrelated PR approves nothing. A split review (one card per PR of
-    # a multi-repo change, each naming its own reviewed_pr) is covered by the union.
-    approvals = [_approval_prs(conn, p, parked_at, row["id"], captured_set) for p in parents]
-    return all(approvals) and urls.issubset(set().union(*approvals))
+    # Without repair evidence, every awaited parent must approve a checkpointed PR. One approval
+    # does not cover a sibling that never reviewed, and a named unrelated PR approves nothing.
+    # A split review (one card per PR of a multi-repo change, each naming its own reviewed_pr)
+    # is covered by the union, but only among parents the checkpoint itself named as awaited.
+    # A parent that is here only because its history could not be proven finished before the
+    # park (legacy checkpoint, reopened or replica-unverified) must approve every holding PR on
+    # its own: its pre-park approval of another PR is not evidence for this one.
+    approvals = {p: _approval_prs(conn, p, parked_at, row["id"], captured_set) for p in parents}
+    if not all(approvals.values()):
+        return False
+    named = evidence.get("awaited") if isinstance(evidence.get("awaited"), list) else ()
+    if not all(urls.issubset(a) for p, a in approvals.items() if p not in named):
+        return False
+    return urls.issubset(set().union(*approvals.values()))
diff --git a/tests/hermes_cli/test_kanban_dependency_review_split.py b/tests/hermes_cli/test_kanban_dependency_review_split.py
index 72897a33fa..183f942d08 100644
--- a/tests/hermes_cli/test_kanban_dependency_review_split.py
+++ b/tests/hermes_cli/test_kanban_dependency_review_split.py
@@ -4,12 +4,14 @@ Production shape (t_01a1ceba11be1290): a core PR and a plugin PR, one review car
 each approving only its own ``reviewed_pr``. The all-parents-approve-every-PR rule held
 that owner forever, although every awaited parent approved and every PR was approved.
 """
+import json
 import time
 
 import pytest
 
 from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli.kanban_dependency_review import resumes_review
 from tests.hermes_cli import test_kanban_dependency_review as helpers
 from tests.hermes_cli.kanban_guard_helpers import worker_comment
 
@@ -81,3 +83,27 @@ def test_split_approvals_must_cover_every_pr_and_every_parent(board, prs, verdic
                                 metadata=metadata)
     kb.recompute_ready(board)
     assert dispatch.check_respawn_guard(board, task) == "active_pr"
+
+
+def test_live_shape_holding_core_only_sibling_approves_plugin_only(board):
+    # Live hold: only the core PR is holding; the plugin review approved only PR60.
+    task, reviews = parked_two_prs(board)
+    finish(board, reviews, (CORE, MODS))
+    assert resumes_review(board, task, [CORE]) is True
+    assert resumes_review(board, task, [MODS]) is True
+
+
+def test_legacy_checkpoint_without_awaited_needs_each_parent_to_cover_every_pr(board):
+    # Without an explicit awaited list the checkpoint never named which parents split the
+    # review, so each parent must cover every holding PR (the pre-split rule).
+    task, reviews = parked_two_prs(board)
+    row = board.execute("SELECT id, payload FROM task_events WHERE task_id = ? "
+                        "AND kind = 'dependency_wait'", (task,)).fetchone()
+    payload = json.loads(row["payload"])
+    payload["review_checkpoint"].pop("awaited", None)
+    with kb.write_txn(board):
+        board.execute("UPDATE task_events SET payload = ? WHERE id = ?",
+                      (json.dumps(payload), row["id"]))
+    finish(board, reviews, (CORE, MODS))
+    assert resumes_review(board, task, [CORE]) is False
+    assert dispatch.check_respawn_guard(board, task) == "active_pr"
