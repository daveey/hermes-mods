From b20ff9d14a56d4b7b90e5c3c79fd12f389363241 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 23:49:09 -0800
Subject: [PATCH] fix(tui): reword the Stop notice for an unstamped running
 turn

Round-4 review nit of #3908: the unstamped holder can be the user's own forwarded
prompt, caught before its user row is written, so the notice no longer says the turn
was not started by Hermes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/tui_gateway/test_background_turn_queue.py | 1 +
 tui_gateway/methods_session_interrupt.py        | 5 +++--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_background_turn_queue.py b/tests/tui_gateway/test_background_turn_queue.py
index 3132fdcf0a..dd9e21ed68 100644
--- a/tests/tui_gateway/test_background_turn_queue.py
+++ b/tests/tui_gateway/test_background_turn_queue.py
@@ -331,6 +331,7 @@ def test_a_typed_holder_is_never_asked_to_end(idle_chat):
     assert _run_workers(state) == ["typed_turn"]
     assert state["requests"] == [] and state["calls"] == []
     assert state["events"][0][2]["message"] == server.BACKGROUND_STOP_TYPED_MESSAGE
+    assert "wasn't started automatically, so Stop left it running" in server.BACKGROUND_STOP_TYPED_MESSAGE
 
 
 def test_an_unstamped_turn_on_an_older_gateway_is_taken_over_as_before(idle_chat):
diff --git a/tui_gateway/methods_session_interrupt.py b/tui_gateway/methods_session_interrupt.py
index a7a9278961..84741612eb 100644
--- a/tui_gateway/methods_session_interrupt.py
+++ b/tui_gateway/methods_session_interrupt.py
@@ -82,8 +82,9 @@ _HELD_QUEUE_KEEPING_ORIGINS = frozenset({None, "stop_button", "esc", "tile", "ti
 _BACKGROUND_STOP_ORIGINS = frozenset({"stop_button", "esc", "tile", "tile:esc", "slash", "transcript"})
 
 
-BACKGROUND_STOP_TYPED_MESSAGE = ("The turn running in this chat in another window was not started by Hermes, so "
-                                 "Stop here does not end it. Stop it in that window.")
+# Also the user's own forwarded prompt, caught before its user row is written: so no "not started by Hermes".
+BACKGROUND_STOP_TYPED_MESSAGE = ("The turn running in this chat wasn't started automatically, so Stop left it "
+                                 "running. Stop it from the window that started it, or wait for it to finish.")
 BACKGROUND_STOP_QUEUED_MESSAGE = ("The background turn in this chat could not be stopped from here (the gateway "
                                   "running it is older). Your message runs when that turn ends.")
 
-- 
