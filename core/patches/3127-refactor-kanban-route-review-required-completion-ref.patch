From 168e4e7854722198a89172d27173b61646618c63 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:36:45 +0000
Subject: [PATCH] refactor(kanban): route review-required completion refusals
 through receipt_refusal [daveey]

Rebasing onto main put hermes_cli/kanban.py at 2003 lines, over its 2000-line health cap.
The ReviewRequiredError branch in _cmd_complete now goes through the existing
ValueError handler. receipt_refusal returns the error's own message unchanged,
so the CLI output is identical and kanban.py is back to 1999 lines.
---
 hermes_cli/kanban.py              | 6 +-----
 hermes_cli/kanban_cli_metadata.py | 5 ++++-
 2 files changed, 5 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index ec42318916..165b626b5f 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -1220,7 +1220,6 @@ def _goal_gate_error(conn, tid: str, evidence: str, handoff: str, blocked_hint:
 
 def _cmd_complete(args: argparse.Namespace) -> int:
     """Mark one or more tasks done. Supports a single id or a list."""
-    from hermes_cli.kanban_review_required import ReviewRequiredError
     ids, rc = _require_ids(args)
     if rc:
         return rc
@@ -1262,9 +1261,6 @@ def _cmd_complete(args: argparse.Namespace) -> int:
             except _review_contract.IndependenceRefused as outside:  # --force does not override it [daveey]
                 fail_msg[tid] = f"cannot complete {tid}: {outside}"
                 return False
-            except ReviewRequiredError as review_err:
-                fail_msg[tid] = str(review_err)
-                return False
             except kb.LiveClaimError:
                 fail_msg[tid] = (f"cannot complete {tid}: a live worker is running it. Wait for the "
                                  f"worker, `hermes kanban reclaim {tid}` to release it, or re-run with "
@@ -1274,7 +1270,7 @@ def _cmd_complete(args: argparse.Namespace) -> int:
                 fail_msg[tid] = (f"cannot complete {tid}: {empty_err}. Pass --result/--summary "
                                  f"describing what was done (an empty completion is not evidence).")
                 return False
-            except (kb.ArtifactPreservationError, ValueError) as receipt_err:
+            except (kb.ArtifactPreservationError, ValueError) as receipt_err:  # incl. ReviewRequiredError
                 fail_msg[tid] = receipt_refusal(tid, receipt_err)  # nothing written; re-raises other errors
                 return False
             if not done:
diff --git a/hermes_cli/kanban_cli_metadata.py b/hermes_cli/kanban_cli_metadata.py
index f3251609bb..95cada6245 100644
--- a/hermes_cli/kanban_cli_metadata.py
+++ b/hermes_cli/kanban_cli_metadata.py
@@ -34,10 +34,13 @@ def parse_metadata_flag(raw: Optional[str]) -> tuple[Optional[dict], int]:
 def receipt_refusal(tid: str, exc: Exception) -> str:
     """The CLI line for a receipt admission/preservation refusal (nothing was written).
 
-    Re-raises any other ``ValueError`` so unrelated failures keep their old behavior.
+    A review-required refusal keeps its own message. Re-raises any other ``ValueError`` so unrelated failures keep their old behavior.
     """
     from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_review_required import ReviewRequiredError
 
+    if isinstance(exc, ReviewRequiredError):
+        return str(exc)  # already names the task and the review lane
     if isinstance(exc, kb.ArtifactPreservationError) or str(exc).startswith("completion_receipt"):
         return f"cannot complete {tid}: {exc}"
     raise exc
-- 
