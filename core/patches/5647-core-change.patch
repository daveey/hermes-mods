From 08d559f9ebbdec7f67c922ea72220b493d4313fc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:49:09 +0000
Subject: [PATCH] fix(kanban): distinguish operational refusals from provider
 refusals [daveey]

Address exact-head review: generic refused-to text is not a provider content refusal. Preserve infrastructure accounting exemption. Add ordinary crash retry controls and a long-preamble message-boundary regression; the boundary-deletion mutant fails that test. No routing changes.
---
 hermes_cli/kanban_failure_accounting.py       |  4 +--
 hermes_cli/kanban_failure_summary.py          |  2 +-
 .../test_kanban_provider_refusal.py           | 30 ++++++++++++++++++-
 3 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_failure_accounting.py b/hermes_cli/kanban_failure_accounting.py
index 4a1a2bef44..485f640c36 100644
--- a/hermes_cli/kanban_failure_accounting.py
+++ b/hermes_cli/kanban_failure_accounting.py
@@ -40,9 +40,9 @@ def _record_task_failure(
     import json
 
     evidence = {"error": error, **(event_payload_extra or {}), **(diagnostic or {})}
-    refusal = summary.classify_failure(outcome, evidence) == "provider_refusal"
+    refusal = not infrastructure and summary.classify_failure(outcome, evidence) == "provider_refusal"
     if refusal:
-        force_trip, infrastructure, block_kind = True, False, "capability"
+        force_trip, block_kind = True, "capability"
     _kb = dispatch._kb
     if failure_limit is None:
         failure_limit = dispatch.DEFAULT_FAILURE_LIMIT
diff --git a/hermes_cli/kanban_failure_summary.py b/hermes_cli/kanban_failure_summary.py
index 8a5a7064d7..5a333b0d2a 100644
--- a/hermes_cli/kanban_failure_summary.py
+++ b/hermes_cli/kanban_failure_summary.py
@@ -15,7 +15,7 @@ _CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
 # Provider/model refusals. Deliberately specific: a bare "refused" also matches "connection refused".
 _REFUSAL_RE = re.compile(
     r"model declined|safety refusal|declined (?:to|the) (?:assist|help|comply|answer|request)"
-    r"|refus(?:ed|al) (?:to|by the model)|(?:model|assistant) refus|stop_reason\W+refusal"
+    r"|refusal by the model|(?:model|assistant) refus|stop_reason\W+refusal"
     r"|cannot (?:assist|help) with (?:that|this)|can'?t (?:assist|help) with (?:that|this)"
     r"|violates? (?:our )?(?:usage|safety) polic"
     r"|This content was flagged for possible cybersecurity risk",
diff --git a/tests/hermes_cli/test_kanban_provider_refusal.py b/tests/hermes_cli/test_kanban_provider_refusal.py
index 30e42a4672..20dd36c15e 100644
--- a/tests/hermes_cli/test_kanban_provider_refusal.py
+++ b/tests/hermes_cli/test_kanban_provider_refusal.py
@@ -95,8 +95,36 @@ def test_refusals_do_not_create_a_systemic_crash_fix_card(live, monkeypatch):
     assert all(kb.get_task(live, tid).status == "triage" for tid in tids)
 
 
-def test_nonrefusal_keeps_retry_budget(live, monkeypatch):
+def test_notice_quotes_provider_message_after_long_preamble():
+    message = "This content was flagged for possible cybersecurity risk. " + "detail " * 40
+    text = summary.describe_failure("crashed", "fixture", {
+        "worker_output": "launcher context " * 30 + "Provider said: " + message,
+        "provider": "openai-codex", "model": "gpt-6.1-sol", "run_number": 203994,
+    })
+    assert f"run 203994: '{message[:200]}'. Not a worker crash" in text
+    assert "launcher context" not in text
+
+
+@pytest.mark.parametrize("error", ["sqlite refused to open file", OUTPUT])
+def test_infrastructure_failure_stays_uncharged(live, monkeypatch, error):
+    tid, rid = _local_crash(live, monkeypatch)
+    assert dispatch._record_task_failure(
+        live, tid, error, outcome="reclaimed", infrastructure=True, run_id=rid,
+    ) is False
+    assert kb.get_task(live, tid).consecutive_failures == 0
+    assert kb.get_task(live, tid).status != "triage"
+
+
+@pytest.mark.parametrize("output", [
+    "plain nonzero exit",
+    "hermes-core-wt ship refused to land PR #3993: missing review",
+    "ssh: the remote host refused to connect; retry later",
+    "sqlite refused to open file",
+])
+def test_nonrefusal_keeps_retry_budget(live, monkeypatch, output):
     tid, _ = _local_crash(live, monkeypatch)
+    monkeypatch.setattr(dispatch, "_classify_dead_worker", lambda *a, **kw:
+                        dispatch._DeadWorker("nonzero_exit", 1, "exit", "crashed", {"worker_output": output}))
     with kb.write_txn(live):
         live.execute("UPDATE tasks SET max_retries=2 WHERE id=?", (tid,))
     assert dispatch.detect_crashed_workers(live) == [tid]
-- 
2.43.0

