diff --git a/tests/tui_gateway/test_update_queue_recovery.py b/tests/tui_gateway/test_update_queue_recovery.py
index 04cae02bd6..5c4c924ac7 100644
--- a/tests/tui_gateway/test_update_queue_recovery.py
