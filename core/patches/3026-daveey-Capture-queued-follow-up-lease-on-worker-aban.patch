From aa4d13d2b38006f532ced81f13eedc510753cce7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 22:16:44 +0000
Subject: [PATCH] [daveey] Capture queued follow-up lease on worker abandonment

Gate abandonment capture on this executor future rather than a predecessor receipt in the shared handler scope. Preserve completed worker evidence without rereading reused agents. Proof: four follow-up rows RED before fix; 21 custody tests and 1510 affected tests pass, one skip; three mutation checks killed.
---
 gateway/run_turn_wait.py                      | 10 ++++---
 gateway/turn_outcome.py                       |  7 -----
 .../hermes_state/test_outcome_run_custody.py  | 26 ++++++++++++++++---
 3 files changed, 28 insertions(+), 15 deletions(-)

diff --git a/gateway/run_turn_wait.py b/gateway/run_turn_wait.py
index 7adf01d644..f4d449c1fd 100644
--- a/gateway/run_turn_wait.py
+++ b/gateway/run_turn_wait.py
@@ -8,7 +8,7 @@ import threading
 async def await_turn_worker(runner, worker, turn_ctx, interrupt_detected, interrupt_monitor):
     """Poll the executor, preserving this run's evidence even on timeout/cancellation."""
     from gateway.run import _abandon_timed_out_gateway_turn
-    from gateway.turn_outcome import capture_pending_run_outcome
+    from gateway.turn_outcome import capture_run_outcome
 
     agent_holder = turn_ctx.agent_holder
     warning_fired = False
@@ -36,6 +36,8 @@ async def await_turn_worker(runner, worker, turn_ctx, interrupt_detected, interr
             await runner._run_agent_backup_interrupt_check(turn_ctx, interrupt_detected, interrupt_monitor)
         return runner._run_agent_timeout_result(worker, turn_ctx)
     finally:
-        # The worker can still be inside run_conversation. Do not consult the
-        # replacement session turn slot or overwrite an already finished receipt.
-        capture_pending_run_outcome(agent_holder[0])
+        # A queued follow-up shares the handler scope, so an existing receipt may
+        # belong to its predecessor. Only this worker's completion proves that
+        # its frozen receipt is ready and the cached agent must not be reread.
+        if not worker.executor_task.done():
+            capture_run_outcome(agent_holder[0])
diff --git a/gateway/turn_outcome.py b/gateway/turn_outcome.py
index 62624b9a2a..e96e1c77a0 100644
--- a/gateway/turn_outcome.py
+++ b/gateway/turn_outcome.py
@@ -30,13 +30,6 @@ def capture_run_outcome(agent) -> None:
         owned["session_id"] = str(getattr(agent, "session_id", "") or owned["session_id"] or "")
 
 
-def capture_pending_run_outcome(agent) -> None:
-    """Fill missing evidence on handler abandonment, retaining a finished worker's receipt."""
-    owned = run_outcome.get()
-    if owned is not None and "lease_holder" not in owned:
-        capture_run_outcome(agent)
-
-
