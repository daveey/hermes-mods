@@ -128,7 +128,8 @@ async def test_displaced_handler_uses_worker_receipt_not_successor_slot(db, monk
 @pytest.mark.asyncio
 @pytest.mark.parametrize("cancelled", [False, True])
 @pytest.mark.parametrize("newer", [False, True])
