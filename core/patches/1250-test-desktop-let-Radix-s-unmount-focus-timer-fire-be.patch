From 71425f675f9a1bbca361fa65b46d3ef5d7183624 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 06:18:47 -0700
Subject: [PATCH] test(desktop): let Radix's unmount focus timer fire before
 each file's jsdom closes

FocusScope restores focus in a setTimeout(0) scheduled at unmount. When a
file's last test unmounts a menu, that timer can fire after vitest has torn
down the file's jsdom: "Failed to execute 'dispatchEvent' on 'EventTarget':
parameter 1 is not of type 'Event'", an unhandled error that fails the run
with every test green (profile-rail-fleet, run 41058102554, 4-core runner).
A shared afterAll now waits one macrotask.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/vitest.setup.ts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/apps/desktop/vitest.setup.ts b/apps/desktop/vitest.setup.ts
index ad231c0070e..c335a9aa625 100644
--- a/apps/desktop/vitest.setup.ts
+++ b/apps/desktop/vitest.setup.ts
@@ -1,4 +1,5 @@
 import { configure } from '@testing-library/react'
+import { afterAll } from 'vitest'
 
 import { InertResizeObserver } from './src/test/jsdom'
 
@@ -84,3 +85,10 @@ if ('Element' in globalThis) {
 // as the 15s testTimeout above it while still finishing below it, so a
 // genuinely hung await still surfaces as this assertion, not a test timeout.
 configure({ asyncUtilTimeout: 12_000 })
+
+// Radix FocusScope restores focus in a setTimeout(0) scheduled at unmount. When a
+// file's last test unmounts a menu or dialog, that timer can outlive the file's
+// jsdom and throw "parameter 1 is not of type 'Event'" as an unhandled error,
+// failing the whole run (profile-rail-fleet, run 41058102554 on a 4-core runner).
+// Let it fire while this file's window still exists.
+afterAll(() => new Promise<void>(resolve => setTimeout(resolve, 0)))
