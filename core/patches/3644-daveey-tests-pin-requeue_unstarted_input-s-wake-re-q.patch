From d8727a4b282bcb7ad43163f9ef3e306aec8fef68 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:18:55 +0000
Subject: [PATCH] [daveey] tests: pin requeue_unstarted_input's wake re-queue +
 steer hand-back as one write

Mutant survivor of core #2282 (d495dccb3f), found by post-merge check
t_01a1d548889ce91e: moving the `_requeue_transfer` loop out of `write(conn)`
into a second `db._execute_write` left all 17 tests green, because
test_an_undelivered_steer_transfer_goes_back_with_the_wake_in_the_same_write
only checks the end state. Committed apart, a lost second write (crash, epoch
fence, refusal) re-queues the wake but leaves the steered prompt terminal
`steering` on a dead generation: a lost user steer (review 5890674054 point 2).

New test: `_requeue_transfer` raises for the steer; the wake must still be
`started` at its generation and the steer still `steering` (whole write
rolled back).

Proof (hermes-core-wt test, the three suites the card names):
- main + test: 18 passed, 0 failed
- separate-write mutant (card t_01a1d576521fde36 diff): 1 failed, only the
  new test: AssertionError ('queued', None) == ('started', 1)

Test-only change. Card: t_01a1d576521fde36
---
 .../test_requeue_unstarted_input.py             | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tests/hermes_state/test_requeue_unstarted_input.py b/tests/hermes_state/test_requeue_unstarted_input.py
index 282b95a8bc..adbc42d6d2 100644
--- a/tests/hermes_state/test_requeue_unstarted_input.py
+++ b/tests/hermes_state/test_requeue_unstarted_input.py
@@ -100,6 +100,23 @@ def test_an_undelivered_steer_transfer_goes_back_with_the_wake_in_the_same_write
     assert again['admission_id'] == row['admission_id']
 
 
+def test_a_failed_steer_hand_back_rolls_the_wake_requeue_back_too(claimed, monkeypatch):
+    """[daveey] t_01a1d576521fde36: the wake re-queue and the transfer hand-back are one transaction. A hand-back
+    that fails rolls the whole write back: committed apart, a lost second write (a crash, an epoch fence, a refusal)
+    would leave the wake queued and its steer terminal ``steering`` on the dead generation, a lost user steer."""
+    db, epoch, row = claimed
+    steer = _steered(db, epoch, row)
+
+    def lost(conn, **kwargs):
+        raise RuntimeError('hand-back lost')
+    monkeypatch.setattr(rt, '_requeue_transfer', lost)
+    with pytest.raises(RuntimeError, match='hand-back lost'):
+        _requeue(db, epoch, row, transfers={steer: False})
+    wake = rt.get_session_admission(db, admission_id=row['admission_id'])
+    assert (wake['status'], wake['generation']) == ('started', row['generation'])
+    assert rt.get_session_admission(db, admission_id=steer)['outcome'] == rt.STEERING
+
+
 def test_a_steer_transfer_the_turn_took_refuses_the_requeue(claimed):
     db, epoch, row = claimed
     steer = _steered(db, epoch, row)
