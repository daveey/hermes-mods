+    # ``hermes_home_key`` memoizes each home's realpath: this runs on the event loop for every
+    # scoped request (plugin routes, ``?profile=``), and a per-request realpath stalled it under
+    # FS pressure.
+    scoped = (None if profile_dir is None or hermes_home_key(profile_dir) == hermes_home_key(process_home)
+              else profile_dir)
     if scoped is not None:
         activate_multi_profile_hosting()
         hydrate_profile_secret_sources(scoped)  # first call may block on the source's fetch
diff --git a/tests/gateway/test_control_socket_peer_realpath_cache.py b/tests/gateway/test_control_socket_peer_realpath_cache.py
new file mode 100644
index 0000000000..ac1b59e140
--- /dev/null
+++ b/tests/gateway/test_control_socket_peer_realpath_cache.py
@@ -0,0 +1,68 @@
+"""The control socket's per-connection peer check must not realpath the home on the event loop
+for every connection (t_01a1d3ac14d0b207): under FS pressure each one stalled session-ticket
+bootstraps for seconds."""
+import os
+import socket
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.platforms("linux")  # SO_PEERCRED
+
+
+class _Writer:
+    def __init__(self, sock):
+        self._sock = sock
+
+    def get_extra_info(self, _key):
+        return self._sock
+
+
+def _slow(real):
+    def wrapper(*args, **kwargs):
+        threading.Event().wait(0.2)  # health: allow HX013 -- a slow realpath IS the behaviour under test
+        return real(*args, **kwargs)
+    return wrapper
+
+
+def test_repeat_peer_check_reuses_the_home_realpath(tmp_path, monkeypatch):
+    """Test B: after a warm call, a repeat peer check costs no realpath."""
+    from gateway.control_socket import GatewayControlServer
+    home = tmp_path / "home"
+    home.mkdir(mode=0o700)
+    ours, _theirs = socket.socketpair(socket.AF_UNIX)
+    server = GatewayControlServer(home)
+    assert server._posix_peer_subject(_Writer(ours)) == f"uid:{os.getuid()}"
+    # Path.resolve only: the test harness's home-IO guard itself calls os.path.realpath per syscall.
+    monkeypatch.setattr(Path, "resolve", _slow(Path.resolve))
+    started = time.monotonic()
+    assert server._posix_peer_subject(_Writer(ours)) == f"uid:{os.getuid()}"
+    assert time.monotonic() - started < 0.05
+
+
+def test_home_swapped_for_a_symlink_is_refused_at_once(tmp_path):
+    """The home itself is still lstat'ed per connection: the cached verdict never admits a home
+    that became a symlink."""
+    from gateway.control_socket import GatewayControlServer
+    home = tmp_path / "home"
+    home.mkdir(mode=0o700)
+    ours, _theirs = socket.socketpair(socket.AF_UNIX)
+    server = GatewayControlServer(home)
+    assert server._posix_peer_subject(_Writer(ours)) == f"uid:{os.getuid()}"
+    home.rename(tmp_path / "moved")
+    home.symlink_to(tmp_path / "moved")
+    assert server._posix_peer_subject(_Writer(ours)) is None
+
+
+def test_symlinked_ancestor_refusal_is_not_cached(tmp_path, monkeypatch):
+    from gateway.control_socket import GatewayControlServer
+    home = tmp_path / "home"
+    home.mkdir(mode=0o700)
+    ours, _theirs = socket.socketpair(socket.AF_UNIX)
+    server = GatewayControlServer(home)
+    verdicts = iter([False, True])
+    monkeypatch.setattr(Path, "absolute", lambda self: self if next(verdicts) else self / "x")
+    assert server._posix_peer_subject(_Writer(ours)) is None
+    assert server._posix_peer_subject(_Writer(ours)) == f"uid:{os.getuid()}"
diff --git a/tests/hermes_cli/test_kanban_scratch_gc_lock_scope.py b/tests/hermes_cli/test_kanban_scratch_gc_lock_scope.py
new file mode 100644
index 0000000000..941e894f39
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_scratch_gc_lock_scope.py
@@ -0,0 +1,95 @@
+"""Scratch GC must not hold the board's write lock across tree walks and rmtree
+(t_01a1d3ac14d0b207): a ``kanban gc`` on a loaded Mac held BEGIN IMMEDIATE for 11 minutes while
+it removed 29 workspaces. Each removal re-checks its owner in a short txn instead."""
+import shutil
+import sqlite3
+import threading
+import time
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_worktree_gc as gc
+from tests.hermes_cli import test_kanban_scratch_gc_archive as helpers
+
+board = helpers.board
+
+
+def _db_path():
+    with kbc.connect_closing() as conn:
+        return conn.execute("PRAGMA database_list").fetchone()["file"]
+
+
+def _run_gc():
+    with kbc.connect_closing() as conn:
+        return gc.gc_task_scratch(conn, older_than_days=7)
+
+
+def test_board_writable_while_scratch_gc_removes_trees(board, monkeypatch):
+    """Test C: another connection's BEGIN IMMEDIATE succeeds while a slow rmtree runs."""
+    paths = [helpers._task()[1] for _ in range(3)]
+    db, real_rmtree = _db_path(), shutil.rmtree
+    waits = []
+
+    def slow_rmtree(path, *args, **kwargs):
+        other = sqlite3.connect(db, timeout=0.5, isolation_level=None)
+        started = time.monotonic()
+        try:
+            other.execute("BEGIN IMMEDIATE")
+            other.execute("ROLLBACK")
+            waits.append(time.monotonic() - started)
+        except sqlite3.OperationalError as exc:
+            waits.append(exc)
+        finally:
+            other.close()
+        threading.Event().wait(1.0)  # health: allow HX013 -- a slow rmtree IS the behaviour under test
+        return real_rmtree(path, *args, **kwargs)
+
+    monkeypatch.setattr(shutil, "rmtree", slow_rmtree)
+    assert _run_gc() == 3
+    assert len(waits) == 3
+    assert all(isinstance(w, float) and w < 0.5 for w in waits), waits
+    assert not any(p.exists() for p in paths)
+    root = kb.workspaces_root()
+    assert not [p for p in root.iterdir() if ".gc-rm-" in p.name]
+
+
+def test_card_resumed_mid_gc_keeps_its_workspace(board, monkeypatch):
+    """Test C: the per-removal ownership re-check skips a card resumed after selection."""
+    tasks = [helpers._task() for _ in range(3)]
+    db, real_rmtree = _db_path(), shutil.rmtree
+    resumed: list[str] = []
+
+    def rmtree_then_resume_the_rest(path, *args, **kwargs):
+        if not resumed:
+            other = sqlite3.connect(db, timeout=0.5, isolation_level=None)
+            try:
+                for tid, tpath in tasks:
+                    if tpath.exists():
+                        other.execute("UPDATE tasks SET status='running' WHERE id=?", (tid,))
+                        resumed.append(tid)
+            finally:
+                other.close()
+        return real_rmtree(path, *args, **kwargs)
+
+    monkeypatch.setattr(shutil, "rmtree", rmtree_then_resume_the_rest)
+    assert _run_gc() == 1
+    assert len(resumed) == 2
+    for tid, path in tasks:
+        assert path.exists() == (tid in resumed)
+
+
+def test_owner_repointed_mid_gc_keeps_the_tree(board, monkeypatch):
+    tid, path = helpers._task()
+    db = _db_path()
+
+    def repoint_then_walk(p):
+        other = sqlite3.connect(db, timeout=0.5, isolation_level=None)
+        try:
+            other.execute("UPDATE tasks SET workspace_path='/elsewhere' WHERE id=?", (tid,))
+        finally:
+            other.close()
+        return True
+
+    monkeypatch.setattr(gc.ws, "_scratch_tree_removable", repoint_then_walk)
+    assert _run_gc() == 0
+    assert path.exists()
diff --git a/tests/hermes_cli/test_loop_fs_request_paths.py b/tests/hermes_cli/test_loop_fs_request_paths.py
new file mode 100644
index 0000000000..0241954507
--- /dev/null
+++ b/tests/hermes_cli/test_loop_fs_request_paths.py
@@ -0,0 +1,127 @@
+"""Per-request filesystem calls that ran on the gateway event loop (t_01a1d3ac14d0b207).
+
+Under FS/CPU pressure (a ``kanban gc`` rmtree sweep on a loaded Mac) each stat or realpath on the
+loop stalled every Desktop request queued behind it for seconds. Each test makes the call slow
+after a warm-up and pins that the repeat request path no longer pays for it.
+"""
+import asyncio
+import os
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+SLOW = 0.2
+
+
+def _slow(real, calls=None, under=None):
+    """``real`` made slow (and its calls' on-main-thread flags recorded); with ``under``, only for
+    paths below that dir (config loads stat the test home, which is not what is measured)."""
+    def wrapper(*args, **kwargs):
+        if under is not None and not str(args[0]).startswith(str(under)):
+            return real(*args, **kwargs)
+        if calls is not None:
+            calls.append(threading.current_thread() is threading.main_thread())
+        threading.Event().wait(SLOW)  # health: allow HX013 -- a slow filesystem call IS the behaviour under test
+        return real(*args, **kwargs)
+    return wrapper
+
+
+def _plugins_root(cache):
+    return Path(cache[0]["_dir"]).parent
+
+
+@pytest.fixture
+def plugin_cache(tmp_path, monkeypatch):
+    from hermes_cli import web_server
+    dirs = []
+    for i in range(5):
+        d = tmp_path / "plugins" / f"p{i}"
+        d.mkdir(parents=True)
+        dirs.append(d)
+    cache = [{"name": d.name, "_dir": str(d), "source": "bundled"} for d in dirs]
+    monkeypatch.setattr(web_server, "_dashboard_plugins_cache", cache)
+    monkeypatch.setattr(web_server, "_discover_dashboard_plugins",
+                        lambda: [p for p in cache if Path(p["_dir"]).is_dir()])
+    return cache
+
+
+def test_plugin_gate_does_not_stat_plugin_dirs_per_request(plugin_cache, monkeypatch):
+    """Test A: within the stale-check window the gate reads the cached list only."""
+    from hermes_cli import web_server
+    from hermes_cli.web_server_dashboard import _plugin_api_request_refused
+    assert web_server._get_dashboard_plugins() is plugin_cache  # warm: proves the dirs present
+    calls = []
+    monkeypatch.setattr(Path, "is_dir", _slow(Path.is_dir, calls, _plugins_root(plugin_cache)))
+
+    async def twenty():
+        return [await _plugin_api_request_refused("p0") for _ in range(20)]
+
+    started = time.monotonic()
+    assert asyncio.run(twenty()) == [False] * 20
+    assert time.monotonic() - started < 0.5
+    assert calls == []
+
+
+def test_due_plugin_dir_sweep_runs_off_the_event_loop_and_notices_removal(plugin_cache, monkeypatch):
+    from hermes_cli import web_server
+    from hermes_cli.web_server_dashboard import _plugin_api_request_refused
+    monkeypatch.setattr(web_server, "DASHBOARD_PLUGINS_STALE_CHECK_SECS", 0.0)
+    Path(plugin_cache[0]["_dir"]).rmdir()
+    calls = []
+    monkeypatch.setattr(Path, "is_dir", _slow(Path.is_dir, calls, _plugins_root(plugin_cache)))
+    # Gone from disk: rescanned, so it is now unknown (user plugin by default: refused).
+    assert asyncio.run(_plugin_api_request_refused("p0")) is True
+    assert calls and not any(calls), "the dir sweep must run on a worker thread, not the loop"
+
+
+def test_stale_check_window_bounds_the_sweep(plugin_cache, monkeypatch):
+    from hermes_cli import web_server
+    clock = [1000.0]
+    monkeypatch.setattr(web_server.time, "monotonic", lambda: clock[0])
+    web_server._get_dashboard_plugins()
+    Path(plugin_cache[1]["_dir"]).rmdir()
+    assert any(p["name"] == "p1" for p in web_server._get_dashboard_plugins())  # within the window
+    clock[0] += web_server.DASHBOARD_PLUGINS_STALE_CHECK_SECS
+    assert not any(p["name"] == "p1" for p in web_server._get_dashboard_plugins())
+    # A list assigned directly is unproven until swept, whatever the clock says.
+    fresh = [{"name": "x", "_dir": str(Path(plugin_cache[0]["_dir"]).parent / "gone"), "source": "user"}]
+    monkeypatch.setattr(web_server, "_dashboard_plugins_cache", fresh)
+    assert web_server._fresh_dashboard_plugins() is None
+
+
+def test_current_profile_scope_does_not_realpath_per_request(monkeypatch):
+    """Test B: ``_config_profile_scope`` for the dashboard's own profile reuses resolved homes."""
+    from hermes_cli.web_server_profiles import _config_profile_scope
+    with _config_profile_scope(None):
+        pass
+    # Path.resolve only: the test harness's home-IO guard itself calls os.path.realpath per syscall.
+    monkeypatch.setattr(Path, "resolve", _slow(Path.resolve))
+    started = time.monotonic()
+    with _config_profile_scope(None):
+        pass
+    assert time.monotonic() - started < 0.05
+
+
+def test_secret_source_values_reuse_the_resolved_home(tmp_path, monkeypatch):
+    from hermes_cli import env_loader
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setitem(env_loader._SECRET_SOURCE_VALUES_BY_HOME, str(home.resolve()), {"K": "v"})
+    assert env_loader.get_secret_source_values(home) == {"K": "v"}
+    monkeypatch.setattr(Path, "resolve", _slow(Path.resolve))
+    started = time.monotonic()
+    assert env_loader.get_secret_source_values(home) == {"K": "v"}
+    assert time.monotonic() - started < 0.05
+
+
+def test_missing_home_key_is_not_memoized(tmp_path):
+    from hermes_cli import env_loader
+    home = tmp_path / "later"
+    assert env_loader._home_key(home) == str(home.resolve())
+    assert str(home) not in env_loader._HOME_KEYS
+    real = tmp_path / "real"
+    real.mkdir()
+    home.symlink_to(real)
+    assert env_loader._home_key(home) == str(real.resolve())
