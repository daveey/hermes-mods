diff --git a/.github/workflows/origin-transport.yml b/.github/workflows/origin-transport.yml
index 403ef4f08be..2786802b12c 100644
--- a/.github/workflows/origin-transport.yml
+++ b/.github/workflows/origin-transport.yml
@@ -18,10 +18,23 @@
   push:
     branches: [main]
   workflow_dispatch:
+    inputs:
+      hub_ref:
+        description: hermes-hub commit or branch whose client/hermes_hub.py to test (default the pin)
+        type: string
+        default: f9554a2aea9748512fec16a27a86a09041021271
+  # Weekly on main: also fails when hermes-hub's client moved past the pin (see the last step).
+  schedule:
+    - cron: '17 9 * * 1'
 
 permissions:
   contents: read
 
+env:
+  # hermes-hub main undated representative observation (client 1.9.x), the client its core-observation job proves.
+  # Keep the workflow_dispatch default above equal to it.
+  HERMES_HUB_PIN: f9554a2aea9748512fec16a27a86a09041021271
+
 concurrency:
   # Every main push keeps its own run, so a red one names its own commit.
   group: origin-transport-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
@@ -38,6 +51,9 @@
     steps:
       - name: Checkout code
         uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
+        with:
+          # The job holds an environment secret: leave no token in the checkout's git config.
+          persist-credentials: false
 
       - name: Require the hermes-hub read key
         # Without it the checkout below would fail on an opaque auth error, or a later edit
@@ -54,8 +70,7 @@
         uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1
         with:
           repository: daveey/hermes-hub
-          # hermes-hub main undated representative observation (client 1.9.x), the client its core-observation job proves.
-          ref: f9554a2aea9748512fec16a27a86a09041021271
+          ref: ${{ inputs.hub_ref || env.HERMES_HUB_PIN }}
           path: .composed-hub
           fetch-depth: 1
           # Repository-scoped read-only deploy key, never a user/account token.
@@ -70,8 +85,9 @@
           prune-python-cache: true
 
       - name: Run tests/origin_transport/ with the courier client
-        # Direct pytest, not scripts/run_tests.sh: the canonical runner starts each file from
-        # `env -i`, which would drop the canary env below (hermes-hub client-cli.yml sets the same).
+        # Direct pytest on setup-pm's test interpreter (HERMES_PYTHON): scripts/run_tests.sh starts
+        # each file from `env -i`, which would drop the canary env below (hermes-hub client-cli.yml
+        # sets the same), and scripts/run-in-hermes-env would set the environment up all over again.
         env:
           COURIER: ${{ github.workspace }}/.composed-hub/client/hermes_hub.py
           HERMES_KANBAN_DB: /tmp/not-the-owner-board.db
@@ -81,9 +97,31 @@
           HERMES_SESSION_ID: worker-session-must-not-be-the-origin
         shell: bash
         run: |
-          scripts/run-in-hermes-env python -m pytest -q -p no:cacheprovider tests/origin_transport/ \
+          "$HERMES_PYTHON" -m pytest -q -p no:cacheprovider tests/origin_transport/ \
             --courier-client="$COURIER" -rA --junitxml="$RUNNER_TEMP/origin-transport.xml"
 
       - name: Fail on any skip or an empty run
         if: ${{ !cancelled() }}
         run: python3 scripts/ci/check_origin_transport_junit.py "$RUNNER_TEMP/origin-transport.xml"
+
+      - name: Checkout hermes-hub main (weekly pin check)
+        if: github.event_name == 'schedule'
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1
+        with:
+          repository: daveey/hermes-hub
+          ref: main
+          path: .hub-main
+          fetch-depth: 0
+          ssh-key: ${{ secrets.HERMES_HUB_READ_KEY }}
+          persist-credentials: false
+
+      - name: Fail when the hermes-hub client moved past the pin
+        if: github.event_name == 'schedule'
+        shell: bash
+        run: |
+          newest=$(git -C .hub-main log -1 --format=%H -- client/hermes_hub.py)
+          if ! git -C .hub-main merge-base --is-ancestor "$newest" "$HERMES_HUB_PIN"; then
+            echo "::error::hermes-hub client/hermes_hub.py changed after the pin $HERMES_HUB_PIN (newest change $newest on main): bump HERMES_HUB_PIN and the workflow_dispatch default in .github/workflows/origin-transport.yml"
+            exit 1
+          fi
+          echo "pin $HERMES_HUB_PIN carries the newest client change $newest"
diff --git a/tests/ci/test_origin_transport_ci.py b/tests/ci/test_origin_transport_ci.py
