         return "local marker", hit
     full = without_carried_inputs(f"{title}\n{body}", c.raw)
     if refusal := coordination.check(full, c.raw, skills=args.get("skills"), requires=reqs):
diff --git a/hermes_cli/kanban_worker_placement.py b/hermes_cli/kanban_worker_placement.py
index 2fa25d5197..587471cf71 100644
--- a/hermes_cli/kanban_worker_placement.py
+++ b/hermes_cli/kanban_worker_placement.py
@@ -53,6 +53,45 @@ def _notice_from_stored(conn, task_id, gateway, pool):
 
 QUEUED_WHY = ("portable: queued for any machine labelled {label} (kanban.placement.worker_queue); the first one "
               "with a free slot claims it through the Board lease")
+UNMET_WHY = " (local marker {hit} not met on {gateway})"
+TAILNET_LABEL = "capability:tailnet-exec"
+# Labels a built-in local-marker group adds on a pool worker (kanban_placement.LOCAL_MARKER_GROUPS).
+UNMET_GROUP_LABELS = {"mac": (TAILNET_LABEL,), "desktop": (TAILNET_LABEL,)}
+_MAC_NOTE = ("{hit}: no Board machine this card can lease runs macOS (the Macs take no Board leases); it joins the "
+             "pool with capability:tailnet-exec, so a run that needs the Mac reaches it with tailnet_exec/ssh, and a "
+             "GUI-only step (a TCC or Keychain prompt, a signing UI) is a human_request.")
+UNMET_GROUP_NOTES = {
+    "mac": _MAC_NOTE, "desktop": _MAC_NOTE,
+    "browser": ("{hit}: pool workers have a headless browser without sign-in; work that needs the hub's signed-in "
+                "Chrome must be created with runs_on=['machine:hub'] and hub_reason (admission-judged)."),
+    "sso": "{hit}: credentials come from token-broker; an SSO login only David can do is a human_request.",
+    "context": "{hit}: a context skill every pool worker carries.",
+}
+
+
+def _hit_name(why):
+    return why.removeprefix("mentions ")
+
+
+def unmet_markers(args, cfg, gateway):
+    """``{labels, note, hit}`` when this gateway cannot meet any of the card's local markers better than the pool and
+    nothing else keeps the card here; else None (t_01a1d2662553185d). [daveey]"""
+    from hermes_cli import kanban_placement as placement
+    from hermes_cli.kanban_placement_diagnostics import portability
+
+    groups = placement.builtin_marker_groups(args, cfg)
+    if not groups or not placement.markers_unmeetable_here(gateway, cfg):
+        return None
+    if portability(args, cfg, local_markers=False)[0]:
+        return None
+    labels, notes = set(), []
+    for group, why in groups.items():
+        labels.update(UNMET_GROUP_LABELS.get(group, ()))
+        note = UNMET_GROUP_NOTES[group].format(hit=_hit_name(why))
+        if note not in notes and not (group == "desktop" and "mac" in groups):
+            notes.append(note)
+    first = next(iter(groups.values()))
+    return {"labels": labels, "note": " ".join(notes), "hit": _hit_name(first)}
 
 
 def queue_decision(args, cfg, gateway, pin, machine_ok=None):
@@ -61,7 +100,8 @@ def queue_decision(args, cfg, gateway, pin, machine_ok=None):
     One queue instead of a machine pin: no worker is chosen at creation, so a held or full worker never strands the
     card while another has free slots. None (legacy routing applies) for a pin, an explicit ``runs_on``,
     non-portable work, or when no active, unheld machine carries the label. Courier and origin-bound creates queue
-    too: chat ownership pins storage, not execution (t_01a1d0571c2f07d6). [daveey]
+    too: chat ownership pins storage, not execution (t_01a1d0571c2f07d6). On a pool worker a built-in local-marker
+    hit queues too, with its group's labels and a ``note`` (:func:`unmet_markers`). [daveey]
     """
     from hermes_cli import kanban_placement as placement
     from hermes_cli import kanban_placement_coordination as coordination
@@ -69,12 +109,22 @@ def queue_decision(args, cfg, gateway, pin, machine_ok=None):
     label = placement._Cfg(cfg).queue_label(gateway)
     if not label or pin not in ("", "auto") or args.get("runs_on") is not None:
         return None
-    if placement.portable_reason(args, cfg):
+    unmet = None
+    reason = placement.portable_reason(args, cfg)
+    if reason == "local marker":
+        unmet = unmet_markers(args, cfg, gateway)
+        if unmet is None:
+            return None
+    elif reason:
         return None
     extra = coordination.required_labels(args, cfg)
     if extra is None or not (machine_ok or placement._machine_picks_up)(label):
         return None
-    return {"where": "local", "runs_on": [label, *sorted(extra - {label})], "why": QUEUED_WHY.format(label=label)}
+    if unmet is None:
+        return {"where": "local", "runs_on": [label, *sorted(extra - {label})], "why": QUEUED_WHY.format(label=label)}
+    extra = extra | unmet["labels"]
+    return {"where": "local", "runs_on": [label, *sorted(extra - {label})], "note": unmet["note"],
+            "why": QUEUED_WHY.format(label=label) + UNMET_WHY.format(hit=unmet["hit"], gateway=gateway)}
 
 
 def creation_decision(args, cfg, gateway, pin, origin_intent, machine_ok=None, queue=True):
diff --git a/tests/hermes_cli/test_kanban_pool_queue.py b/tests/hermes_cli/test_kanban_pool_queue.py
index 53611cfd94..8c3d4b5cff 100644
--- a/tests/hermes_cli/test_kanban_pool_queue.py
+++ b/tests/hermes_cli/test_kanban_pool_queue.py
@@ -684,3 +684,162 @@ def test_a_callers_runs_on_beats_a_queued_landing(monkeypatch):
     assert ktp._landing_placement(None, {}, object(), None, None, ["machine:worker-2"], title="t") == (
         queued, ["machine:worker-2"])
     assert ktp._landing_placement(None, {}, object(), None, None, None, title="t") == (queued, [POOL])
+
+
+# --- local markers a pool worker cannot meet (t_01a1d2662553185d) ----------------------------------------------
+# 11-13: on a pool worker a built-in local-marker hit (Keychain, Chrome, a Desktop chat, a ship review's CI line
+# naming the macOS check) kept the card as a local row only its creating worker could claim (workers pick up only
+# runs_on cards). No Board machine a card can lease runs macOS, so the creator was never better than the pool.
+# Observed: t_01a1d2434cf3676c, and t_01a1d2662553185d itself (its spec names Chrome).
+
+TAILNET = "capability:tailnet-exec"
+SHIP_TITLE = "Independent exact-head review PR #1789 @370a13d80c (core-wt ship review required)"
+SHIP_BODY = (
+    "Independent exact-head review of https://github.com/example-org/hermes/pull/1789 at "
+    "**370a13d80c0000000000000000000000000000ab**.\n"
+    "CI at filing: green: All required checks pass (v2): success; macOS state required (v1): success.\n"
+    "Required CI passed before filing.\n\n"
+    "An independent exact-head review was explicitly requested before landing.\n"
+    "The ship gate lands only a head approved at its exact sha. This card was filed by ship; the landing session "
+    "must not be the one reviewing.\n\n"
+    "Finish with kanban_complete metadata exactly:\n"
+    '  {"verdict": "approve" | "request_changes", "reviewed_sha": "370a13d80c0000000000000000000000000000ab", '
+    '"reviewed_pr": "https://github.com/example-org/hermes/pull/1789"}\n')
+
+
+def _pool_machines():
+    w1 = {**W1, "labels": ["linux", POOL, TAILNET]}
+    w2 = {**W2, "labels": ["linux", POOL, TAILNET]}
+    return {m["name"]: m for m in (MACHINES[HUB], w1, w2, MACHINES["macbook"])}
+
+
+def _on(monkeypatch, gateway, cfg, machines):
+    from hermes_cli import kanban_skill_check
+    monkeypatch.setattr("hermes_cli.kanban_capability_registry.self_gateway", lambda: gateway)
+    monkeypatch.setattr(kp, "config", lambda: cfg)
+    monkeypatch.setattr(kanban_skill_check, "check_task_skills", lambda *a, **k: None)  # no skills dir here
+    wn.set_registry_fetch(lambda: {"me": gateway, "machines": list(machines.values())})
+
+
+@pytest.fixture
+def on_w2(w2, monkeypatch):
+    _on(monkeypatch, "worker-2", {"worker_queue": {"worker-2": POOL}}, _pool_machines())
+    return w2
+
+
+def _create(**card):
+    from tools import kanban_tools as kt
+    out = json.loads(kt._handle_create({"assignee": "default", "requires": [], **card}))
+    assert out.get("ok"), out
+    return out
+
+
+def test_a_keychain_card_from_a_pool_worker_joins_the_pool_with_the_mac_reach_label(on_w2):
+    out = _create(title="rotate the CI token in the Keychain")
+    # The Board stores labels normalized (sorted): the label set is the contract; the reply keeps the queue first.
+    assert _runs_on(on_w2.conn, out["task_id"]) == sorted([POOL, TAILNET]), out
+    assert out["placement"]["runs_on"] == [POOL, TAILNET], out
+    assert "tailnet_exec" in out["note"] and out["placement"]["note"] == out["note"], out
+    assert "remedy" not in out, out
+    why = out["placement"]["why"]
+    assert why.startswith("portable: queued for any machine labelled pool:worker"), why
+    assert why.endswith("(local marker 'keychain' not met on worker-2)"), why
+    # Any pool worker may claim it, not only the creator.
+    card = dict(on_w2.conn.execute("SELECT * FROM tasks WHERE id = ?", (out["task_id"],)).fetchone())
+    assert wn.eligible(card, "worker-1", _pool_machines()) is None
+    # The audit stays truthful: the card did hit a local marker.
+    assert _created(on_w2.conn, out["task_id"])["portable_reason"] == "local marker"
+
+
+def test_a_chrome_card_from_a_pool_worker_joins_the_pool_and_names_the_hub_route(on_w2):
+    out = _create(title="read the dashboard in Chrome")
+    assert _runs_on(on_w2.conn, out["task_id"]) == [POOL], out
+    assert "machine:hub" in out["note"] and "hub_reason" in out["note"], out
+
+
