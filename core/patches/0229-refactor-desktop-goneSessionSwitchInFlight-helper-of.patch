Subject: [PATCH 227/248] refactor(desktop): goneSessionSwitchInFlight helper
 offsets the 4132 read-only branch (code-health ratchet; batch fix-up for #36)
 [daveey]

---
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/gone-session-switch.test.ts b/apps/desktop/src/app/session/hooks/use-session-actions/gone-session-switch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..060dc02abbe2b25653685ec4cebf1b878e450392
--- /dev/null
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/gone-session-switch.test.ts
@@ -0,0 +1,38 @@
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { $gatewaySwitching } from '@/store/gateway-switch'
+import { $activeGatewayProfile, $gatewaySwapTarget } from '@/store/profile'
+
+import { goneSessionSwitchInFlight } from './gone-session-switch'
+
+describe('goneSessionSwitchInFlight', () => {
+  const initial = {
+    profile: $activeGatewayProfile.get(),
+    swap: $gatewaySwapTarget.get(),
+    switching: $gatewaySwitching.get()
+  }
+
+  afterEach(() => {
+    $activeGatewayProfile.set(initial.profile)
+    $gatewaySwapTarget.set(initial.swap)
+    $gatewaySwitching.set(initial.switching)
+  })
+
+  it('is false for an unknown or matching owner with no switch in flight', () => {
+    $gatewaySwitching.set(false)
+    $gatewaySwapTarget.set(null)
+    $activeGatewayProfile.set('default')
+    expect(goneSessionSwitchInFlight(undefined)).toBe(false)
+    expect(goneSessionSwitchInFlight('  ')).toBe(false)
+    expect(goneSessionSwitchInFlight('default')).toBe(false)
+  })
+
+  it('is true for a known foreign owner or a switch in flight', () => {
+    $gatewaySwitching.set(false)
+    $gatewaySwapTarget.set(null)
+    $activeGatewayProfile.set('default')
+    expect(goneSessionSwitchInFlight('work')).toBe(true)
+    $gatewaySwitching.set(true)
+    expect(goneSessionSwitchInFlight('default')).toBe(true)
+  })
+})
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/gone-session-switch.ts b/apps/desktop/src/app/session/hooks/use-session-actions/gone-session-switch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..433616ee65ea0384a70fcc395b6ce2fc0f3f2d3f
--- /dev/null
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/gone-session-switch.ts
@@ -0,0 +1,18 @@
+import { $gatewaySwitching } from '@/store/gateway-switch'
+import { $activeGatewayProfile, $gatewaySwapTarget, normalizeProfileKey } from '@/store/profile'
+
+/**
+ * `switchInFlight` for {@link goneSessionVerdict}: a 404 on resume is only
+ * trustworthy from the backend that owns the session. A profile swap or
+ * connection switch in flight (or just targeted) means "retry once things
+ * settle". So does a KNOWN owner that is not the active gateway: the 404 came
+ * from the wrong backend. An UNKNOWN owner must not count — it would block the
+ * draft fallback for genuinely dead ids on secondary profiles.
+ */
+export function goneSessionSwitchInFlight(sessionProfile: null | string | undefined): boolean {
+  return (
+    $gatewaySwitching.get() ||
+    Boolean($gatewaySwapTarget.get()) ||
+    Boolean(sessionProfile?.trim() && normalizeProfileKey(sessionProfile) !== normalizeProfileKey($activeGatewayProfile.get()))
+  )
+}
