+def test_overlapping_poll_fixture_waits_for_its_last_response(monkeypatch):
+    """A successful pool-responsiveness test must not leave polls for the next test.
+
+    Hold the last poll until its response is requested. The original fixture returned
+    after only owner/poll-1, letting this queued handler start a new default probe
+    against the next test's patches (or real credentials between patch scopes).
+    """
+    last = f"poll-{server._rpc_pool_workers - 1}"
+    admission = threading.Event()
+    answered = threading.Event()
+    transports = []
+    base = _RecordingTransport
+    handler = server._methods["setup.runtime_check"]
+
+    class HeldTransport(base):
+        def __init__(self):
+            super().__init__()
+            transports.append(self)
+
+        def wait_for(self, request_id, timeout=2.0):
+            if request_id == last:
+                admission.set()
+            return super().wait_for(request_id, timeout)
+
+        def write(self, response):
+            if response.get("id") == last:
+                answered.set()
+            return super().write(response)
+
+    def held_handler(rid, params):
+        if rid == last:
+            assert admission.wait(timeout=10)
+        return handler(rid, params)
+
+    monkeypatch.setitem(server._methods, "setup.runtime_check", held_handler)
+    monkeypatch.setitem(globals(), "_RecordingTransport", HeldTransport)
+    try:
+        test_overlapping_runtime_checks_share_one_probe_and_keep_pool_responsive(monkeypatch)
+        assert answered.is_set(), "successful fixture returned with an outstanding readiness poll"
+    finally:
+        admission.set()
+        if transports:
+            transports[0].wait_for(last, timeout=3)
+
+
 def test_blocked_provider_does_not_serialize_a_healthy_provider_check(monkeypatch):
