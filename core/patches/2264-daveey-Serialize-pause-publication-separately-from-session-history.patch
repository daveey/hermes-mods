From a369afadb002231495e6553fcf83a67b614485a9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:06:36 +0000
Subject: [PATCH] [daveey] Serialize pause publication separately from session
 history

---
 .../test_update_pause_user_stop.py            | 22 ++++++++++++++++++-
 tui_gateway/prompt_turn.py                    |  2 +-
 tui_gateway/update_pause.py                   |  8 ++++++-
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_update_pause_user_stop.py b/tests/tui_gateway/test_update_pause_user_stop.py
index 599785e9a39..3133302f12a 100644
--- a/tests/tui_gateway/test_update_pause_user_stop.py
+++ b/tests/tui_gateway/test_update_pause_user_stop.py
@@ -124,7 +124,7 @@ def _turn(env, monkeypatch, path):
     monkeypatch.setattr("model_tools.handle_function_call", _tool)
     agent.client.chat.completions.create.side_effect = [mt._response(mt._call("job", "call_1")), mt._response(),
                                                         mt._response()]
-    session = {"agent": agent, "session_key": KEY, "history": [], "history_lock": threading.RLock(),
+    session = {"agent": agent, "session_key": KEY, "history": [], "history_lock": threading.Lock(),
                "history_version": 0, "running": True, "attached_images": [], "image_counter": 0, "cols": 80,
                "slash_worker": None, "show_reasoning": False, "tool_progress_mode": "all", "inflight_turn": None,
                "profile_home": str(env.home)}
@@ -269,6 +269,26 @@ def test_a_stop_of_the_running_turn_drops_its_pause(home):
     assert read_turn_marker(home, KEY) is None
 
 
+def test_stop_cannot_revoke_pause_in_the_middle_of_publication(home):
+    session = _paused_session(home, running=True, history_lock=threading.Lock())
+    entered, finished = threading.Event(), threading.Event()
+
+    def stop():
+        entered.set()
+        up.user_stop_wins(session)
+        finished.set()
+
+    with up.publication_lock(session):
+        thread = threading.Thread(target=stop, daemon=True)
+        thread.start()
+        assert entered.wait(2)
+        assert not finished.wait(0.1)
+        assert up.pause_stands(session, KEY, {"paused_for_update": up.PAUSE_REASON})
+    thread.join(2)
+    assert finished.is_set()
+    assert not session.get("_update_pause_marker_key")
+
+
 def test_a_stop_never_drops_another_turns_pause(home):
     """The paused turn ended and a synthesized turn (no marker of its own) runs over its marker: stopping
     that turn must not drop the paused request."""
diff --git a/tui_gateway/prompt_turn.py b/tui_gateway/prompt_turn.py
index 74fada67f24..4df556f4533 100644
--- a/tui_gateway/prompt_turn.py
+++ b/tui_gateway/prompt_turn.py
@@ -1442,7 +1442,7 @@ def _run_admitted_prompt(
                 note_task_done(session, st.result, st.agent, display_kind)
             # Payload construction may yield to Stop. Decide and publish under the same lock
             # that drops the pause, rather than carrying a pre-construction pause snapshot.
-            with session["history_lock"]:
+            with update_pause.publication_lock(session):
                 paused_for_update = update_pause.pause_stands(session, st.marker_key, st.result)
                 if paused_for_update:
                     update_pause.announce_pause(sid, payload)
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index 629d493d901..1fa0de6c095 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -296,13 +296,19 @@ def _drop_pause(session: dict) -> None:
     session.pop("_update_pause_drainer_lock", None)
 
 
+def publication_lock(session: dict):
+    """Serialize pause publication with Stop without nesting the non-reentrant history lock."""
+    with session["history_lock"]:
+        return session.setdefault("_update_pause_publication_lock", threading.Lock())
+
+
 def user_stop_wins(session: dict) -> bool:
     """[daveey] t_01a1c895eb0596b2: a user Stop of the RUNNING turn drops the pause its hook already paid, so
     the marker (stamped ``core_update_pause``) retires like any stopped turn's and neither the next backend nor
     the in-place watcher continues what the user stopped. Call after the interrupt reached the agent and before
     the Stop retires the marker. Only that turn's own pause: a pause whose turn already ended, or an earlier
     turn's under a synthesized turn, is kept. True when a pause was dropped."""
-    with session["history_lock"]:
+    with publication_lock(session), session["history_lock"]:
         key = session.get("_update_pause_marker_key")
         if not key or not session.get("running") or key != session.get("_active_turn_marker_key"):
             return False
