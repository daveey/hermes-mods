+                       "AND idempotency_key >= ? AND idempotency_key < ? "
+                       "AND status NOT IN ('done', 'archived') "
+                       "ORDER BY created_at, id LIMIT 1", (DETECTOR, key, key + "\U0010ffff")).fetchone()
+    return row["id"] if row is not None else None
 
 
