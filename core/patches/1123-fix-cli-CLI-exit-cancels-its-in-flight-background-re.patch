diff --git a/hermes_cli/cli_shutdown.py b/hermes_cli/cli_shutdown.py
index 74d45bc5bfc..02816b6977f 100644
--- a/hermes_cli/cli_shutdown.py
+++ b/hermes_cli/cli_shutdown.py
@@ -124,6 +124,23 @@ def _shutdown_agent_memory_provider(agent) -> None:
