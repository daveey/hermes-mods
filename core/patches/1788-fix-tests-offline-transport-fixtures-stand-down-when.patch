From 6f251c65a8ea914a9d26133b75806e429afb7381 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 01:44:13 +0000
Subject: [PATCH] fix(tests): offline transport fixtures stand down when
 httpx/requests are absent

The bootstrap-installer lane runs test_fresh_source_install.py in a
pytest-only interpreter; the autouse metadata fixture's 'import httpx'
(b4bb0d87b09) errored setup for all three tests, turning main red at
c34694e325. With no client library there is no in-process client to fence.
---
 tests/_fixtures/offline_catalogs.py           | 16 +++++++--
 ...est_offline_fixtures_without_transports.py | 33 +++++++++++++++++++
 2 files changed, 46 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_offline_fixtures_without_transports.py

diff --git a/tests/_fixtures/offline_catalogs.py b/tests/_fixtures/offline_catalogs.py
index 569ce49454d..86be15b7d7e 100644
--- a/tests/_fixtures/offline_catalogs.py
+++ b/tests/_fixtures/offline_catalogs.py
@@ -3,12 +3,22 @@
 Provider transport tests can replace requests.get themselves; real loopback HTTP
 fixtures are deliberately left intact. This is not a general HTTP/network fence.
 """
+from importlib.util import find_spec
 from ipaddress import ip_address
 from urllib.parse import urlsplit
 
 import pytest
 
 
+def _transport_absent(name):
+    """No client library in this interpreter means no in-process client to fence.
+
+    Isolated acceptance lanes (bootstrap installer) run with only pytest
+    installed and exercise Hermes in subprocesses.
+    """
+    return find_spec(name) is None
+
+
 def _is_loopback(host):
     if host.lower().rstrip(".") == "localhost":
         return True
@@ -21,7 +31,7 @@ def _is_loopback(host):
 @pytest.fixture(autouse=True)
 def _offline_video_catalog(request, monkeypatch):
     """Unrelated agent tests use the provider's bundled video catalog fallback."""
-    if request.node.get_closest_marker("live"):
+    if request.node.get_closest_marker("live") or _transport_absent("requests"):
         return
     import requests
 
@@ -40,7 +50,7 @@ def _offline_video_catalog(request, monkeypatch):
 @pytest.fixture(autouse=True)
 def _offline_registry_transport(request, monkeypatch):
     """Keep registry fetch/cache logic real, with an offline transport default."""
-    if request.node.get_closest_marker("live"):
+    if request.node.get_closest_marker("live") or _transport_absent("requests"):
         return
     import requests
     from agent import models_dev
@@ -63,7 +73,7 @@ def _offline_metadata_transport(request, monkeypatch):
     Explicit client/transport fakes installed by tests win. The production
     request construction, response handling, caches and fallbacks still run.
     """
-    if request.node.get_closest_marker("live"):
+    if request.node.get_closest_marker("live") or _transport_absent("httpx"):
         return
     import httpx
     from agent import model_metadata_http
diff --git a/tests/test_offline_fixtures_without_transports.py b/tests/test_offline_fixtures_without_transports.py
new file mode 100644
index 00000000000..5f865ed0eba
--- /dev/null
+++ b/tests/test_offline_fixtures_without_transports.py
@@ -0,0 +1,33 @@
+"""Autouse offline-transport fixtures load in a pytest-only interpreter.
+
+The bootstrap-installer lane runs tests/scripts/test_fresh_source_install.py
+with only pytest installed and drives Hermes in subprocesses, so the
+in-process httpx/requests fences must stand down instead of erroring setup.
+"""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
+import subprocess
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+_HIDE_TRANSPORTS = (
+    "import sys\n"
+    "sys.modules['httpx'] = None\n"
+    "sys.modules['requests'] = None\n"
+    "import pytest\n"
+    "sys.exit(pytest.main(['-q', '-p', 'no:cacheprovider', sys.argv[1]]))\n"
+)
+
+
+def test_probe_runs_under_every_autouse_fixture():
+    """Collected by the child run below; trivially green in the normal suite."""
+
+
+def test_autouse_fixtures_skip_absent_transport_libraries():
+    node = f"{Path(__file__).relative_to(REPO).as_posix()}::test_probe_runs_under_every_autouse_fixture"
+    result = subprocess.run(
+        [sys.executable, "-c", _HIDE_TRANSPORTS, node],
+        cwd=REPO, capture_output=True, text=True, timeout=120, check=False,
+    )
+    assert result.returncode == 0, result.stdout[-4000:] + result.stderr[-2000:]
+    assert "1 passed" in result.stdout
