---
 apps/desktop/src/app/contrib/wiring.tsx       | 4 +++-
 apps/desktop/src/lib/keybinds/actions.test.ts | 6 +++---
 apps/desktop/src/lib/keybinds/actions.ts      | 3 ++-
 3 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/app/contrib/wiring.tsx b/apps/desktop/src/app/contrib/wiring.tsx
index 35ba636524..bd740c65b8 100644
--- a/apps/desktop/src/app/contrib/wiring.tsx
+++ b/apps/desktop/src/app/contrib/wiring.tsx
@@ -86,6 +86,7 @@ import {
   setBusy,
   setMessages
 } from '@/store/session'
+import { $focusedStoredSessionId } from '@/store/session-focus'
 import { reportPendingUpdateRun } from '@/store/shared-metrics'
 import { $archivedSessions } from '@/store/sidebar-archive'
 import { $titlebarAppActionsSide, titlebarAppActionsClusterCounts } from '@/store/titlebar-app-actions'
@@ -1017,7 +1018,8 @@ export function ContribWiring({ children }: { children: ReactNode }) {
 
   // Archive the selected session (rebindable `session.archive` hotkey).
   const archiveSelectedSession = useCallback(() => {
-    const sessionId = $selectedStoredSessionId.get()
+    // The clicked row, else the chat that's open.
+    const sessionId = $selectedStoredSessionId.get() || $focusedStoredSessionId.get()
 
     if (!sessionId) {
       return
diff --git a/apps/desktop/src/lib/keybinds/actions.test.ts b/apps/desktop/src/lib/keybinds/actions.test.ts
index 00ffe1902f..c293071a34 100644
--- a/apps/desktop/src/lib/keybinds/actions.test.ts
+++ b/apps/desktop/src/lib/keybinds/actions.test.ts
@@ -28,11 +28,11 @@ describe('KEYBIND_ACTIONS', () => {
     expect(missing).toEqual([])
   })
 
-  it('keeps session archive registered and unbound by default', () => {
+  it('keeps session archive registered and bound to ⌘⇧A by default', () => {
     const action = keybindAction('session.archive')
 
-    expect(action).toMatchObject({ category: 'session', defaults: [] })
-    expect(defaultBindings()['session.archive']).toEqual([])
+    expect(action).toMatchObject({ category: 'session', defaults: ['mod+shift+a'] })
+    expect(defaultBindings()['session.archive']).toEqual(['mod+shift+a'])
     expect(en.keybinds.actions['session.archive']).toBe('Archive current session')
     expect(KEYBIND_ACTIONS.filter(candidate => candidate.id === 'session.archive')).toHaveLength(1)
   })
diff --git a/apps/desktop/src/lib/keybinds/actions.ts b/apps/desktop/src/lib/keybinds/actions.ts
index 45bd90e544..bff94bf110 100644
--- a/apps/desktop/src/lib/keybinds/actions.ts
+++ b/apps/desktop/src/lib/keybinds/actions.ts
@@ -134,7 +134,8 @@ export const KEYBIND_ACTIONS: readonly KeybindActionMeta[] = [
   // irreversible-feeling, mouse-only action doesn't silently claim a chord for
   // every user — surfaced in the panel for opt-in binding (the issue suggests
   // ⌘⇧⌫ / Ctrl+Shift+⌫).
-  { id: 'session.archive', category: 'session', defaults: [] },
+  // Fork default: ⌘⇧A — "a" for archive (upstream ships it unbound).
+  { id: 'session.archive', category: 'session', defaults: ['mod+shift+a'] },
   // ⌘⇧P — "p" for project: re-home the selected session into another project
   // through a typeahead palette page (same move as the row menu's submenu).
   { id: 'session.moveToProject', category: 'session', defaults: ['mod+shift+p'] },
