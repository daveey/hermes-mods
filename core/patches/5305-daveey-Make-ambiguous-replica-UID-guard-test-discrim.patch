From 4d8cb1b94e250236a9b01837343c4b99103df4b1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 21:20:40 +0000
Subject: [PATCH] [daveey] Make ambiguous replica UID guard test discriminating

Assert the resolver falls back for a duplicate UID before checking the end-to-end hold, which otherwise masks a first-hit mutant. Mutant len(hits)>=1: 1 failed, 9 passed. Restored guard and active_pr/replica-ID suites: 133 passed. Clarify that unstripped event lengths are legacy-only. Hermes-Card: t_eeeeee000000002c
---
 hermes_cli/kanban_db_dispatch_pr_state.py              | 2 +-
 hermes_cli/kanban_release_comments.py                  | 6 +++---
 tests/hermes_cli/test_kanban_pr_replica_comment_uid.py | 7 +++++++
 3 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch_pr_state.py b/hermes_cli/kanban_db_dispatch_pr_state.py
index b51d3cc6fa..828123efe8 100644
--- a/hermes_cli/kanban_db_dispatch_pr_state.py
+++ b/hermes_cli/kanban_db_dispatch_pr_state.py
@@ -281,7 +281,7 @@ def _row_matches(row: tuple[str, Optional[int], int], at: int, author: str, leng
     r_author, r_at, r_len = row
     if r_at is None or r_author != author or not 0 <= at - r_at <= COMMENT_EVENT_SKEW_SECONDS:
         return False
-    # The row body is stripped and the payload ``len`` is not: stripping only shortens.
+    # Legacy payloads counted unstripped bodies; new payloads match the stored stripped length.
     return r_len == length if exact else r_len <= length
 
 
diff --git a/hermes_cli/kanban_release_comments.py b/hermes_cli/kanban_release_comments.py
index 93f5fceb55..2613de1d5a 100644
--- a/hermes_cli/kanban_release_comments.py
+++ b/hermes_cli/kanban_release_comments.py
@@ -156,9 +156,9 @@ def _resolve(rows, event, payload, *, local_writer=False):
     Legacy synced events have no portable reference. Require acknowledgement of
     every plausible same-time/author row rather than guess among collisions.
     The timestamp tolerance covers the writer crossing a second between inserts;
-    body length alone cannot disambiguate (add_comment stores stripped text and
-    records the unstripped length); ``_own_write`` uses it only alongside the
-    event's own integer, author and write clocks.
+    body length alone cannot disambiguate (legacy add_comment events recorded
+    unstripped lengths; new events match the stored stripped text); ``_own_write``
+    uses it only alongside the event's own integer, author and write clocks.
     """
     if payload.get("comment_uid"):
         return [r for r in rows if "uid" in r.keys() and r["uid"] == payload["comment_uid"]]
diff --git a/tests/hermes_cli/test_kanban_pr_replica_comment_uid.py b/tests/hermes_cli/test_kanban_pr_replica_comment_uid.py
index c328fdf655..5a0930055d 100644
--- a/tests/hermes_cli/test_kanban_pr_replica_comment_uid.py
+++ b/tests/hermes_cli/test_kanban_pr_replica_comment_uid.py
@@ -103,6 +103,13 @@ def test_duplicate_uid_falls_back_and_fails_closed(monkeypatch):
         _replicate_with_uid(conn, tid, cid, "01a1f9cd-c774-709c-b90d-720d0241b4b4", len_delta=1)
         conn.execute("UPDATE task_comments SET uid = '01a1f9cd-c774-709c-b90d-720d0241b4b4' WHERE task_id = ?",
                      (tid,))
+        rows = prs._comment_rows(conn, tid)
+        # A hold alone can be supplied by duplicate-event protection even if the resolver
+        # incorrectly picks the first UID hit. Assert the ambiguity fallback itself.
+        event = {"comment_uid": "01a1f9cd-c774-709c-b90d-720d0241b4b4",
+                 "comment_id": cid, "author": "kanban-dispatcher",
+                 "len": len(f"Woken: the job finished: succeeded ({URL}). ")}
+        assert prs._event_row_id(rows, now + 8, event) is None
         assert prs.active_pr_reason(conn, tid, now + 700) == "active_pr"
 
 
