From a77d9b6c755adbe5e6638640507e90fdd4433ce8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:50:04 +0000
Subject: [PATCH] [daveey] kanban sync replica alarm: any change of the replica
 stamp counts as an advance

`_check_board` reset the awake-time timer only when the replica's
`pulled_at` grew (`stamp > seen.stamp`). `pulled_at` is wall time
(`time.time()` in `mark_pulled`), so after the wall clock steps back
(an NTP correction or a manual fix), healthy rounds write stamps below
the remembered one. The timer never reset, a false stale-replica card
was filed after 20 awake minutes, and it came back until wall time
passed the old stamp.

Fix: any change of the stamp is a pull that reached the feed head
(`stamp != seen.stamp`). A missing or unreadable replica (None) still
counts as not advanced.

Five whys: the false card comes from a timer that does not reset ->
because the stamp read as "not advanced" -> because the comparison
assumed wall time only grows -> because the stamp is wall time, while
the timer is monotonic -> the advance test needs only "a new pull
happened", which any change in the stamp already shows.

Proof:
- RED on main: new test_a_wall_clock_step_backwards_is_still_an_advance
  (stamp at T, wall clock stepped back 30 min, healthy rounds stamp
  T-29m ... T-9m for 21 awake minutes) files one false card.
- GREEN: test_kanban_sync_replica_age.py 18 passed; tests/hermes_cli/
  test_kanban_sync_*.py + test_kanban_replica_freshness.py all pass
  (test_kanban_sync_rejections.py hit the 300 s per-file timeout under
  load in the batch, then passed 617/617 alone); scripts/check
  --base origin/main ok.

Follow-up from the review of #2345 (review 5894343824), card
t_01a1d5b349f8f9f1.
---
 hermes_cli/kanban_sync_replica_age.py            |  4 +++-
 tests/hermes_cli/test_kanban_sync_replica_age.py | 16 ++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_replica_age.py b/hermes_cli/kanban_sync_replica_age.py
index 71e5f32fe7..fc1c8525a6 100644
--- a/hermes_cli/kanban_sync_replica_age.py
+++ b/hermes_cli/kanban_sync_replica_age.py
@@ -138,7 +138,9 @@ def _check_board(slug: str, path: Path, now: float, wall: Callable[[], float], f
     stamp = _stamp(slug)
     with _LOCK:
         seen = _SEEN.get(slug)
-        if seen is None or (stamp is not None and (seen.stamp is None or stamp > seen.stamp)):
+        # Any change counts: ``pulled_at`` is wall time, and a wall clock stepped back (NTP, a manual fix) writes
+        # stamps below the remembered one on healthy rounds.
+        if seen is None or (stamp is not None and (seen.stamp is None or stamp != seen.stamp)):
             if seen is not None and seen.open:
                 log.info("kanban sync: %s replica reached the feed head again at %s after %.0f awake min; "
                          "incident over", slug, _pt(stamp), (now - seen.since) / 60)
diff --git a/tests/hermes_cli/test_kanban_sync_replica_age.py b/tests/hermes_cli/test_kanban_sync_replica_age.py
index b1f06e6fc3..b666fbd949 100644
--- a/tests/hermes_cli/test_kanban_sync_replica_age.py
+++ b/tests/hermes_cli/test_kanban_sync_replica_age.py
@@ -175,6 +175,22 @@ def test_sleep_never_counts(live, kanban_home):
     assert host.cards == []
 
 
+def test_a_wall_clock_step_backwards_is_still_an_advance(live, kanban_home):
+    """The wall clock steps back 30 min (an NTP or manual fix): healthy rounds stamp T-29m, T-28m, ..., each one
+    below the remembered T for all 21 awake minutes.
+
+    ``pulled_at`` is wall time, so any change of the stamp is a pull that reached the feed head."""
+    host = Host(kanban_home, _pt("2026-11-12 18:00:00"))
+    stamp_at = host.wall
+    _stamp(stamp_at)
+    host.check()
+    host.wall -= 30 * MIN
+    host.run(21 * MIN, each=lambda: host.round(head=True))
+    last = replica_age._stamp(BOARD)
+    assert last is not None and last < stamp_at  # every stamp the rounds wrote stayed behind T
+    assert host.cards == []
+
+
 def test_the_stamp_advancing_ends_the_incident_then_the_next_comments_or_opens_a_new_card(live, kanban_home, caplog):
     host = Host(kanban_home, _pt("2026-11-12 18:00:00"), file_fn=replica_age.report)
     _stamp(host.wall)
