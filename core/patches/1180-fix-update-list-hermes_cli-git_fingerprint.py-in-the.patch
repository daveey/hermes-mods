From 5f5d503cc9939c190dcfcb39608d72bc1512cf86 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:42:07 +0000
Subject: [PATCH] fix(update): list hermes_cli/git_fingerprint.py in the
 update-critical inventory [daveey]

84030f99ffc made hermes_bootstrap import hermes_cli.git_fingerprint before
main, so a target that broke only that module passed preflight and the
post-pull syntax guard. test_the_critical_inventory_covers_every_module_the_entry_paths_import_first
failed on main push CI 41022235753 shard 2 (retry too).
---
 hermes_cli/update_cmd.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/update_cmd.py b/hermes_cli/update_cmd.py
index 38df40e0edd..090e3ab924e 100644
--- a/hermes_cli/update_cmd.py
+++ b/hermes_cli/update_cmd.py
@@ -206,7 +206,8 @@ def _map_ssl_cert_file_for_git(git_cmd) -> None:
 _UPDATE_CRITICAL_FILES = (
     "hermes_bootstrap.py", "hermes_cli/_parser.py", "hermes_cli/_launchers.py",
     "hermes_cli/_early_recovery.py", "hermes_cli/update_lock.py", "hermes_cli/update_custody.py",
-    "hermes_cli/update_handoff.py", "hermes_cli/venv_sync.py", "pm/__init__.py", "pm/environments.py",
+    "hermes_cli/update_handoff.py", "hermes_cli/venv_sync.py", "hermes_cli/git_fingerprint.py",
+    "pm/__init__.py", "pm/environments.py",
     "hermes_cli/main.py", "hermes_cli/config.py", "hermes_cli/__init__.py",
     "hermes_cli/web_server.py", "cli.py", "run_agent.py", "model_tools.py", "toolsets.py",
     "hermes_constants.py")
