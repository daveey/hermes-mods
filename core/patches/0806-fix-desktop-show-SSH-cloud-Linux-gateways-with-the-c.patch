From 31079f050a46f53f540d158e1af66ab19e8eecb7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:42:50 -0700
Subject: [PATCH] fix(desktop): show SSH cloud/Linux gateways with the cloud
 glyph, not a desktop [daveey]

hermes-hub is an ssh connection at a bare IP labeled 'hub (EC2)'; the name
heuristic only knew mini/laptop, so it fell through to Monitor and read as the
MacBook. Remote connections with a cloud-ish name, a /home or /root hermes
path, or a stock cloud login (ubuntu/ec2-user/root/admin) now map to cloud.
---
 .../chat/sidebar/gateway-device-icon.test.ts  | 29 +++++++++++++++
 .../app/chat/sidebar/gateway-device-icon.tsx  | 35 ++++++++++++++++++-
 2 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/chat/sidebar/gateway-device-icon.test.ts b/apps/desktop/src/app/chat/sidebar/gateway-device-icon.test.ts
index 0b3662c813..0875b19cae 100644
--- a/apps/desktop/src/app/chat/sidebar/gateway-device-icon.test.ts
+++ b/apps/desktop/src/app/chat/sidebar/gateway-device-icon.test.ts
@@ -20,4 +20,33 @@ describe('gatewayDevice', () => {
     expect(gatewayDevice({ host: 'davids-mac-mini-1', id: 'm', kind: 'ssh', label: 'home' }, null)).toBe('mini')
     expect(gatewayDevice({ id: 'box', kind: 'ssh', label: 'workstation' }, null)).toBe('desktop')
   })
+
+  it('shows remote cloud/server gateways as cloud, not a desktop', () => {
+    // The hub: an EC2 box reached over SSH at a bare tailnet IP.
+    expect(
+      gatewayDevice(
+        {
+          host: '192.0.2.10',
+          id: 'hermes-hub',
+          kind: 'ssh',
+          label: 'hub (EC2)',
+          remoteHermesPath: '/home/ubuntu/.local/bin/hermes',
+          user: 'ubuntu'
+        },
+        null
+      )
+    ).toBe('cloud')
+    expect(gatewayDevice({ host: '10.0.0.5', id: 'g', kind: 'ssh', label: 'gpu', user: 'ubuntu' }, null)).toBe('cloud')
+    expect(
+      gatewayDevice({ host: '10.0.0.6', id: 'v', kind: 'ssh', label: 'box', remoteHermesPath: '/root/.local/bin/hermes' }, null)
+    ).toBe('cloud')
+    expect(gatewayDevice({ id: 'r', kind: 'remote', label: 'aws-worker' }, null)).toBe('cloud')
+    // A Mac reached over SSH stays a Mac.
+    expect(
+      gatewayDevice(
+        { host: 'davids-mac-mini-1', id: 'mac-mini', kind: 'ssh', label: 'mac-mini', user: 'daveey', remoteHermesPath: '/Users/me/code/hermes-agent/.venv/bin/hermes' },
+        null
+      )
+    ).toBe('mini')
+  })
 })
diff --git a/apps/desktop/src/app/chat/sidebar/gateway-device-icon.tsx b/apps/desktop/src/app/chat/sidebar/gateway-device-icon.tsx
index 2f660238a2..c1092c3d9a 100644
--- a/apps/desktop/src/app/chat/sidebar/gateway-device-icon.tsx
+++ b/apps/desktop/src/app/chat/sidebar/gateway-device-icon.tsx
@@ -15,9 +15,38 @@ export type GatewayDevice = 'cloud' | 'desktop' | 'laptop' | 'mini'
 
 const LAPTOP_RE = /macbook|laptop|\bmbp\b|book/i
 const MINI_RE = /mac-?mini|\bmini\b|-mini|mini-/i
+// Remote servers: a cloud-ish name, or a Linux box (home under /home or
+// /root, or a stock cloud login) — a bare IP otherwise reads as a desktop.
+const CLOUD_RE = /\bec2\b|\baws\b|cloud|\bgcp\b|azure|\bvps\b|droplet|server|\bhub\b/i
+const CLOUD_USERS = new Set(['admin', 'ec2-user', 'root', 'ubuntu'])
+
+function looksLikeServer(
+  connection: Pick<DesktopRegistryConnection, 'kind' | 'label'> & {
+    host?: string
+    id?: string
+    remoteHermesPath?: string
+    user?: string
+  }
+): boolean {
+  if (connection.kind === 'local') {
+    return false
+  }
+
+  const name = [connection.label, connection.host, connection.id].filter(Boolean).join(' ')
+
+  return (
+    CLOUD_RE.test(name) ||
+    /^\/(home|root)\//.test(connection.remoteHermesPath ?? '') ||
+    CLOUD_USERS.has(connection.user ?? '')
+  )
+}
 
 export function gatewayDevice(
-  connection: Pick<DesktopRegistryConnection, 'id' | 'kind' | 'label'> & { host?: string },
+  connection: Pick<DesktopRegistryConnection, 'id' | 'kind' | 'label'> & {
+    host?: string
+    remoteHermesPath?: string
+    user?: string
+  },
   localHostname: null | string
 ): GatewayDevice {
   if (connection.kind === 'cloud') {
@@ -37,6 +66,10 @@ export function gatewayDevice(
     return 'laptop'
   }
 
+  if (looksLikeServer(connection)) {
+    return 'cloud'
+  }
+
   return 'desktop'
 }
 
-- 
