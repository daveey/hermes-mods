From b6a55089299703678341ca0503429ae56df86a6f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:54:38 +0000
Subject: [PATCH] [daveey] placement recovery: pin the available_mode board
 hop; card_fields raises LookupError

PR #2096 review 5889709834 nits (t_01a1d48a188c4c8b):

1. test_promotion_reads_the_keep_reasons_on_the_reevaluated_board called
   available_mode only with board "default", the keyword default, so a
   mutant dropping board= from available_mode -> recovery_mode survived.
   It now also calls available_mode with board "other" and asserts None
   with the screen seeing "other".
2. card_fields' docstring said a missing column raises KeyError; a
   sqlite3.Row (claim/pickup screens) raises IndexError. The docstring now
   says LookupError (KeyError for dict rows, IndexError for sqlite3.Row),
   and hub_keep_reason's fail-closed except catches LookupError so either
   row type keeps the card on the hub. The claim, pickup and worker-first
   selfcheck callers pass SELECT * rows and have no except to widen.
   The fail-closed test now also raises IndexError.
---
 hermes_cli/kanban_hub_admission_pickup.py          | 3 ++-
 hermes_cli/kanban_placement_recovery.py            | 2 +-
 tests/hermes_cli/test_kanban_placement_recovery.py | 9 ++++++---
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_pickup.py b/hermes_cli/kanban_hub_admission_pickup.py
index 023ece9909..5c9535d6df 100644
--- a/hermes_cli/kanban_hub_admission_pickup.py
+++ b/hermes_cli/kanban_hub_admission_pickup.py
@@ -70,7 +70,8 @@ def _labels(raw: Any) -> Optional[list[str]]:
 def card_fields(card: Mapping[str, Any], board: str) -> dict:
     """The admission view of a ``tasks`` row, shared by the claim screen and placement-recovery promotion.
 
-    A non-list ``requires``/``skills`` reads as None; a missing column raises KeyError."""
+    A non-list ``requires``/``skills`` reads as None. A missing column raises LookupError: KeyError for a dict row
+    (placement recovery), IndexError for a sqlite3.Row (the claim and pickup screens)."""
     from hermes_cli.kanban_placement import without_placement_note
 
     def _list(raw):
diff --git a/hermes_cli/kanban_placement_recovery.py b/hermes_cli/kanban_placement_recovery.py
index a3e3339b8e..13d7d78b0b 100644
--- a/hermes_cli/kanban_placement_recovery.py
+++ b/hermes_cli/kanban_placement_recovery.py
@@ -174,5 +174,5 @@ def hub_keep_reason(conn, row, cfg, *, board="default"):
     from hermes_cli.kanban_hub_admission_pickup import card_fields
     try:
         return keep_reason(conn, row, card_fields(row, board), cfg)
-    except (KeyError, TypeError, ValueError):
+    except (LookupError, TypeError, ValueError):  # LookupError: KeyError (dict row) or IndexError (sqlite3.Row)
         return "card fields unreadable"
diff --git a/tests/hermes_cli/test_kanban_placement_recovery.py b/tests/hermes_cli/test_kanban_placement_recovery.py
index 3f0e0a777d..6b4852bb27 100644
--- a/tests/hermes_cli/test_kanban_placement_recovery.py
+++ b/tests/hermes_cli/test_kanban_placement_recovery.py
@@ -96,7 +96,8 @@ def test_unreadable_card_fields_keep_the_card_on_the_hub(setup, monkeypatch):
     assert recovery.promotion_mode(conn, row, cfg) == "promote"  # readable: promoted
     del row["title"]
     assert recovery.hub_keep_reason(conn, row, cfg) == "card fields unreadable"
-    for error in (KeyError("title"), TypeError("requires"), ValueError("requires")):
+    for error in (KeyError("title"), IndexError("No item with that key"), TypeError("requires"),
+                  ValueError("requires")):
         def unreadable(_card, _board, error=error):
             raise error
         monkeypatch.setattr(pickup, "card_fields", unreadable)
@@ -113,9 +114,11 @@ def test_promotion_reads_the_keep_reasons_on_the_reevaluated_board(setup, monkey
     real = pickup.card_fields
     monkeypatch.setattr(pickup, "card_fields", lambda card, board: seen.append(board) or real(card, board))
     assert recovery.available_mode(conn, row, placement.config(), object(), "default", "hub") == "promote"
-    # A non-default board is a structural keep reason, so the threaded board is what the screen judged.
+    # A non-default board is a structural keep reason, so the threaded board is what the screen judged. "other"
+    # differs from every keyword default, so the available_mode -> recovery_mode -> promotion_mode hops are pinned.
+    assert recovery.available_mode(conn, row, placement.config(), object(), "other", "hub") is None
     assert recovery.promotion_mode(conn, row, placement.config(), board="other") is None
-    assert seen == ["default", "other"]
+    assert seen == ["default", "other", "other"]
 
 
 def test_promotion_preserves_explicit_local_intent(setup):
-- 
2.51.0

