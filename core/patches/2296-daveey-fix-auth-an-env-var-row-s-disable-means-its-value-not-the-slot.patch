From b1227c1b926b9043c175d0a08f62d767b44ae2ce Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:06:35 +0000
Subject: [PATCH] [daveey] fix(auth): an env-var row's disable means its value,
 not the slot

_upsert_entry keeps an env:VAR row's id when the variable's value changes, so the id match
refused any later key there on the pool path while token_disabled allowed it. For env rows a
record whose fingerprint differs is skipped; the leftover env branch of _source_tokens is gone.

Proof: the same-id test is RED with the fix reverted, GREEN with it (58 in the feature files).
---
 agent/credential_pool_disabled.py                  | 9 +++++----
 tests/agent/test_credential_pool_disabled_paths.py | 2 +-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/agent/credential_pool_disabled.py b/agent/credential_pool_disabled.py
index 42b7123c0a3..d3208a95ca4 100644
--- a/agent/credential_pool_disabled.py
+++ b/agent/credential_pool_disabled.py
@@ -111,9 +111,6 @@ def _borrowed_source(entry: Any) -> str:
 
 def _source_tokens(provider: str, source: str) -> set[str]:
     """Tokens a borrowed source holds right now (refreshed outside Hermes, so not in any record)."""
-    if source.startswith("env:"):
-        value = os.environ.get(source[4:], "").strip()
-        return {value} if value else set()
     if source == "claude_code" and provider == "anthropic":
         try:
             from agent.anthropic_credentials import read_claude_code_credentials
@@ -195,9 +192,13 @@ def matches(entry: Any, keys: tuple) -> bool:
     acct = account_of(entry) or ""
     fp = fingerprint_of(entry) or ""
     src = _borrowed_source(entry)
+    # An env:VAR row keeps its id when the variable's value changes: there the record means that value.
+    env_row = str(getattr(entry, "source", "") or "").startswith("env:")
     for rid, rlabel, racct, rfp, rsrc in keys[2]:
         if racct and acct and racct != acct and not acct.startswith(racct + "/"):  # older records: workspace only
             continue
+        if env_row and rfp and fp and rfp != fp:
+            continue
         if ((rid and rid == entry_id) or (rlabel and rlabel == label) or (racct and racct == acct)
                 or (rfp and rfp == fp) or (rsrc and rsrc == src)):
             return True
@@ -313,7 +314,7 @@ def token_disabled(provider: str, *tokens: Optional[str]) -> bool:
     if any(matches(SimpleNamespace(id="", label="", access_token=t, extra={}), keys) for t in wanted):
         return True  # fingerprint or JWT account of a disabled record
     if any(wanted & _source_tokens(provider, rsrc) for *_, rsrc in keys[2] if rsrc):
-        return True  # the current token of a disabled borrowed source (Claude Code login, env var)
+        return True  # the current token of a disabled Claude Code login
     from agent.credential_pool import PooledCredential
     from hermes_cli import auth as auth_mod
     try:
diff --git a/tests/agent/test_credential_pool_disabled_paths.py b/tests/agent/test_credential_pool_disabled_paths.py
index ac884f8abc9..dbf96386d4e 100644
--- a/tests/agent/test_credential_pool_disabled_paths.py
+++ b/tests/agent/test_credential_pool_disabled_paths.py
@@ -470,5 +470,5 @@ def test_an_env_var_source_is_not_disabled_as_a_slot(monkeypatch):
     row = SimpleNamespace(id="e0", label="anthropic_token", source="env:ANTHROPIC_TOKEN", access_token="fixture-env-1")
     keys = cpd._keys_from_records([{"id": "e0", "label": "anthropic_token", "fp": cpd.fingerprint_of(row),
                                     "src": cpd._borrowed_source(row)}])
-    other = SimpleNamespace(id="e1", label="anthropic_token", source="env:ANTHROPIC_TOKEN", access_token="fixture-env-2")
+    other = SimpleNamespace(id="e0", label="anthropic_token", source="env:ANTHROPIC_TOKEN", access_token="fixture-env-2")
     assert cpd.matches(row, keys) and not cpd.matches(other, keys)
