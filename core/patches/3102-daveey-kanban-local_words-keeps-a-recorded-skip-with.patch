From 13375b757e0335eb1829168c1fd471f032a601d2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:48:00 +0000
Subject: [PATCH] [daveey] kanban: local_words keeps a recorded skip with the
 pool hint; unrecorded-skip advice defers to the re-place

PR #1829 review nits (t_01a1d2bee37e8d99, review 5885232570):
1. local_words without the admission census returned the pool re-place before rendering a recorded dispatcher
   skip, so the skip reason vanished; the census branch kept it. Both branches now frame the skip first and use
   pool_words as the advice.
2. ready_hint (and the chat-wait notices, via the pool_hint payload field) followed 'Re-place it ...' with the
   unrecorded-skip advice 'Read the live verdict ... before changing anything; priority changes are not the fix'.
   With a pool hint notice_advice now returns UNRECORDED_POOL_ADVICE (the fact + dispatcher warning only);
   ready_hint passes its pool sentence to _options as pool_hint.

Proof: 4 new tests RED on e5605842bd (3 fail, no-pool control passes), GREEN after; 28 importer/notice files
646 passed; 6 mutants over the new conditions all killed (M5 after adding the pool-hint-without-skip case).
---
 hermes_cli/kanban_dispatch_skip.py            |  8 ++-
 hermes_cli/kanban_parent_unclaimed.py         |  3 +-
 hermes_cli/kanban_queue_position.py           |  9 +--
 .../test_kanban_wait_notice_pool_hint.py      | 62 +++++++++++++++++++
 4 files changed, 76 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_dispatch_skip.py b/hermes_cli/kanban_dispatch_skip.py
index 8b9916e9d0..fba2adbd81 100644
--- a/hermes_cli/kanban_dispatch_skip.py
+++ b/hermes_cli/kanban_dispatch_skip.py
@@ -323,6 +323,10 @@ def advice(skip: dict[str, Any]) -> str:
 UNRECORDED_ADVICE = (f"{UNRECORDED}: slots are free, yet no tick recorded why it passed this card over. Read the live "
                      "verdict (`hermes kanban dispatch --dry-run --json`) before changing anything; priority changes "
                      "are not the fix. Do not run its work outside the dispatcher")
+# After a pool re-place hint ("Re-place it ..."), "read the verdict before changing anything" contradicts the named
+# fix, so a notice carrying ``pool_hint`` keeps only the fact and the dispatcher warning (PR #1829 review). [daveey]
+UNRECORDED_POOL_ADVICE = (f"{UNRECORDED}: slots are free, yet no tick recorded why it passed this card over. "
+                          "Do not run its work outside the dispatcher")
 
 
 def unrecorded(place: Optional[dict[str, Any]], ready_seconds: Optional[float]) -> bool:
@@ -348,4 +352,6 @@ def notice_advice(payload: dict[str, Any]) -> Optional[str]:
     skip = payload.get("dispatch_skip")
     if isinstance(skip, dict) and skip and not is_ordering(skip):
         return advice(skip)
-    return UNRECORDED_ADVICE if payload.get("skip_unrecorded") else None
+    if not payload.get("skip_unrecorded"):
+        return None
+    return UNRECORDED_POOL_ADVICE if str(payload.get("pool_hint") or "").strip() else UNRECORDED_ADVICE
diff --git a/hermes_cli/kanban_parent_unclaimed.py b/hermes_cli/kanban_parent_unclaimed.py
index 2902c0701c..11400a10c7 100644
--- a/hermes_cli/kanban_parent_unclaimed.py
+++ b/hermes_cli/kanban_parent_unclaimed.py
@@ -136,8 +136,9 @@ def ready_hint(conn, task, *, now: Optional[float] = None) -> Optional[str]:
         return f"Ready {_minutes(waited)} min, unclaimed; {kqp.describe(place)}. {checkpoint}".rstrip()
     from hermes_cli.kanban_dispatch_skip import notice_fields
     pool = _pool_sentence(place)
+    fields = {**notice_fields(place, waited), **({"pool_hint": pool} if pool else {})}  # _options defers to it
     return (f"Ready {_minutes(waited)} min, unclaimed; {_queue_words(place)}. " + (f"{pool}. " if pool else "")
-            + checkpoint + _options(task.id, lane_evidence(conn, task.id), notice_fields(place, waited)) + ".")
+            + checkpoint + _options(task.id, lane_evidence(conn, task.id), fields) + ".")
 
 
 _CANDIDATES = (
diff --git a/hermes_cli/kanban_queue_position.py b/hermes_cli/kanban_queue_position.py
index 477c6d709a..121b51147d 100644
--- a/hermes_cli/kanban_queue_position.py
+++ b/hermes_cli/kanban_queue_position.py
@@ -354,12 +354,13 @@ def local_words(place: dict[str, Any]) -> str:
         words += f", {place['running']}/{place['limit']} running"
     elif place.get("limit") is not None and "running" in place:
         words += f", running count unknown (cap {place['limit']})"
-    if place.get("pool_could_run"):
-        return words + ". " + pool_words(place)
+    # One shape with the census branch: a recorded skip is framed first, and a pool re-place is its advice. This
+    # branch used to return the pool hint before the skip, dropping the skip reason (PR #1829 review). [daveey]
+    pool_advice = pool_words(place) if place.get("pool_could_run") else None
     if not skip:
-        return words + ". " + _NOT_STUCK
