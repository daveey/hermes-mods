From 2d5bfe43a17d5b78233980cfa36e1873da26ff01 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 18:16:25 -0700
Subject: [PATCH] test: synchronize relay report updates with a controlled cap
 clock (#238)

---
 tests/tui_gateway/test_bot_relay_methods.py | 51 ++++++++++++++++++---
 1 file changed, 44 insertions(+), 7 deletions(-)

diff --git a/tests/tui_gateway/test_bot_relay_methods.py b/tests/tui_gateway/test_bot_relay_methods.py
index aa2920800b2..cf0cf84107e 100644
--- a/tests/tui_gateway/test_bot_relay_methods.py
+++ b/tests/tui_gateway/test_bot_relay_methods.py
@@ -593,26 +593,63 @@ def test_reported_turn_still_lingering_at_the_cap_is_booked_from_its_latest_repo
     nested notify_on_complete reply (bounded by oneshot_completion_wait_seconds, default == the
     cap) is booked at the cap from its report — the answer a follow-up turn last wrote there,
     exit code 0, never delivery_timeout — and is NOT killed, so its own handoff survives."""
+    from types import SimpleNamespace
+
+    from hermes_cli import quiet_single_query
+    from tests.waiting import wait_until
+
     env = _child_argv(monkeypatch, """
-        import os, time
+        import os, threading
+        from pathlib import Path
         from hermes_cli.quiet_single_query import TURN_REPORT_FILE_ENV, write_turn_report
+        from tests.waiting import wait_until
         path = os.environ.pop(TURN_REPORT_FILE_ENV)
         write_turn_report(path, exit_code=0, reply="asking the teammate")
-        time.sleep(0.5)
+        wait_until(lambda: Path(path + ".follow-up").exists(), timeout=60,
+                   what="parent observed the initial report")
         write_turn_report(path, exit_code=0, reply="teammate says: done")
-        time.sleep(30)
+        threading.Event().wait()
         """)
     procs, spy = _spy_popen()
     tmp = tmp_path / "dm.txt"
     tmp.write_text("hi", encoding="utf-8")
-    started = time.monotonic()
+    # Scheduler stalls must not consume the simulated turn budget. The clock advances
+    # independently of re-reading, so stale reads and booking before the cap still fail.
+    clock = SimpleNamespace(now=0.0)
+    observed = []
+
+    def monotonic():
+        if observed:
+            clock.now += 0.5
+        return clock.now
+
+    monkeypatch.setattr(quiet_single_query, "time", SimpleNamespace(monotonic=monotonic))
+    read_report = quiet_single_query.read_turn_report
+
+    def next_report(path, pid):
+        expected = "asking the teammate" if not observed else "teammate says: done"
+
+        def ready():
+            report = read_report(path, pid)
+            return report if report and report.get("reply") == expected else None
+
+        report = wait_until(ready, timeout=60, what=expected)
+        assert report is not None
+        observed.append(report["reply"])
+        if len(observed) == 1:
+            Path(path + ".follow-up").touch()
+        return report
+
+    monkeypatch.setattr(quiet_single_query, "read_turn_report", next_report)
     try:
         with mock.patch.object(subprocess, "Popen", side_effect=spy) as popen:
             result = methods_bot_relay._run_delivery("ops", str(tmp), env, timeout=2)
-        elapsed = time.monotonic() - started
         assert (result.returncode, result.stdout, result.stderr) == (0, "teammate says: done", "")
-        assert 2 <= elapsed < 8, elapsed
-        assert procs[0].poll() is None, "the lingering child must survive the booking"
+        assert observed[:2] == ["asking the teammate", "teammate says: done"]
+        assert all(reply == "teammate says: done" for reply in observed[2:])
+        assert clock.now >= 2.0, "booking must wait for the cap, not just a report"
+        with pytest.raises(subprocess.TimeoutExpired):
+            procs[0].wait(timeout=2)  # A killed child must be reaped, not race a single poll().
         assert not (tmp_path / "dm.txt.turn.json").exists(), "the report is the runner's to clean up"
         # Decoding stays pinned through the runner (#93590 sibling defect): without encoding= the
         # child's UTF-8 output is decoded with the locale codec — cp1252/GBK on Windows — mangling
-- 
