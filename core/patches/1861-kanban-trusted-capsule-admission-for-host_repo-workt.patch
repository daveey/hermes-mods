diff --git a/agent/observation_bind.py b/agent/observation_bind.py
new file mode 100644
index 00000000000..8636e4f8249
--- /dev/null
+++ b/agent/observation_bind.py
@@ -0,0 +1,238 @@
+"""Managed-worker side of the owner-brokered capsule observation channel. [daveey]
+
+The owner (``gateway.session_kanban_rendezvous.observing_spawn``) launches a capsule-required card's
+managed worker with ``--observation-fd <n>``: ``n`` is an inherited AF_UNIX socketpair end whose other end
+the owner handed to the trusted dispatcher host over SCM_RIGHTS. ``main`` installs it from argv before the
+hello frame (``install_from_argv``); nothing else (env, config, frames, model output) can install one.
+
+``observation_bind(frame)`` runs in ``execute`` right after ``bind_worker_context`` (HERMES_KANBAN_* set) and
+before checkpoint recovery, worker hooks, MCP discovery and AIAgent:
+
+- no channel: a no-op for an ordinary card, ``capsule_observation_missing`` for a capsule-required one;
+- channel: its peer must be this uid and an ancestor process (the owner created the pair); then exactly one
+  ``start`` JSON line must arrive within ``START_DEADLINE_S`` naming this attempt's task, run and claim
+  lock plus a workspace inside the card's workspace; then ``tools.capsule_workspace.bind_worker_workspace``
+  pins it, with liveness = the channel still open. Anything else raises: fail closed, never skipped.
+
+A ``bound`` line is written back on success. ``observation_revoke()`` tombstones the binding (execute's
+``finally``). ``channel()`` exposes the socket to an in-process observer after the bind.
+
+run22, trusted observer: right after the peer check and BEFORE ``start``, the owner's ``observer`` line
+names a root + digest (from the acceptor registration the owner verified) and the acceptor ``host_pid``;
+``agent.observation_load`` verifies and loads exactly those ``observer_*`` bytes (``capsule_observer_*``
+refusals). ``start`` must then come from ``host_pid`` (SCM_CREDENTIALS, ``capsule_observation_start_sender``).
+After the bind the observer is installed on a dup of the channel with the capsule the host Receiver
+expects, and the binding's liveness becomes its authenticated ``workspace_check`` round trip.
+``observation_finish(ok)`` seals (observer ``close``) or poisons once; ordinary cards never load any of it.
+"""
+from __future__ import annotations
+
+import json
+import os
+import socket
+import struct
+import threading
+from typing import Any
+
+FD_FLAG = '--observation-fd'
+START_DEADLINE_S = 30.0
+MAX_LINE = 64 * 1024
+MISSING = 'capsule_observation_missing'
+_LOCK = threading.Lock()
+_STATE: dict[str, Any] = {'fd': None, 'sock': None, 'binding': None, 'runtime': None, 'observer': None,
+                          'finished': False}
+
+
+def _reset_for_tests():
+    with _LOCK:
+        if _STATE['sock'] is not None:
+            _STATE['sock'].close()
+        _STATE.update(fd=None, sock=None, binding=None, runtime=None, observer=None, finished=False)
+
+
+def install_from_argv(argv) -> None:
+    """``[]`` (no channel) or exactly ``['--observation-fd', '<n>']``; anything else is refused."""
+    argv = list(argv)
+    if not argv:
+        return
+    if len(argv) != 2 or argv[0] != FD_FLAG or not argv[1].isdigit() or int(argv[1]) < 3:
+        raise ValueError('invalid_managed_worker_argv')
+    with _LOCK:
+        if _STATE['fd'] is not None:
+            raise ValueError('invalid_managed_worker_argv')
+        _STATE['fd'] = int(argv[1])
+
+
+def installed_fd():
+    return _STATE['fd']
+
+
+def channel():
+    """The bound observation socket (after ``observation_bind``), else None."""
+    return _STATE['sock']
+
+
+def _context(frame):
+    raw = (frame.get('policy') or {}).get('kanban_json')
+    if raw is None:
+        return None
+    context = json.loads(raw)
+    if not isinstance(context, dict):
+        raise RuntimeError(MISSING)
+    return context
+
+
+def _required(context) -> bool:
+    # The owner re-derives from the board; here a frozen value can only add a requirement (an older policy
+    # without the field was already re-derived and refused by the owner when it needed a capsule).
+    frozen = context.get('capsule')
+    return frozen is not None and frozen != {'required': False}
+
+
+def _peer_pid(sock) -> int:
+    return struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i')))[0]
+
+
+def _peer_is_owner(sock) -> bool:
+    pid, uid, _gid = struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i')))
+    if uid != os.getuid() or pid <= 1 or pid == os.getpid():  # windows-footgun: ok -- POSIX-only (unix socket peer credentials, owner-only modes)
+        return False
+    import psutil
+    try:
+        return pid in {p.pid for p in psutil.Process().parents()}
+    except psutil.Error:
+        return False
+
+
+def _read_start(sock, host_pid) -> dict:
+    sock.settimeout(START_DEADLINE_S)
+    buf = b''
+    cred = struct.calcsize('3i')
+    try:
+        while b'\n' not in buf:
+            chunk, ancillary, _flags, _ = sock.recvmsg(4096, socket.CMSG_SPACE(cred))
+            if not chunk:
+                raise RuntimeError('capsule_observation_start_missing')
+            senders = [struct.unpack('3i', v[:cred])[0] for level, kind, v in ancillary
+                       if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS]
+            if senders != [host_pid]:  # a unix stream read never merges writers: one sender per chunk
+                raise RuntimeError('capsule_observation_start_sender')
+            buf += chunk
+            if len(buf) > MAX_LINE:
+                raise RuntimeError('capsule_observation_start_malformed')
+    except TimeoutError as exc:
+        raise RuntimeError('capsule_observation_start_missing') from exc
+    except OSError as exc:
+        raise RuntimeError('capsule_observation_start_missing') from exc
+    finally:
+        sock.settimeout(None)
+    try:
+        start = json.loads(buf.split(b'\n', 1)[0])
+    except ValueError as exc:
+        raise RuntimeError('capsule_observation_start_malformed') from exc
+    if not isinstance(start, dict) or start.get('v') != 1 or start.get('op') != 'start':
+        raise RuntimeError('capsule_observation_start_malformed')
+    return start
+
+
+def _check_start(start, context) -> str:
+    for key in ('task_id', 'run_id', 'claim_lock'):
+        if key not in start:
+            raise RuntimeError('capsule_observation_start_malformed')
+    if (start['task_id'], start['run_id'], start['claim_lock']) != (
+            context.get('task_id'), context.get('run_id'), context.get('claim_lock')) or type(start['run_id']) is not int:
+        raise RuntimeError('capsule_observation_start_mismatch')
+    workspace, root = start.get('workspace'), context.get('workspace')
+    if not (isinstance(workspace, str) and isinstance(root, str) and os.path.isabs(workspace)):
+        raise RuntimeError('capsule_observation_workspace')
+    real, base = os.path.realpath(workspace), os.path.realpath(root)
+    if real != workspace or os.path.commonpath([real, base]) != base:
+        raise RuntimeError('capsule_observation_workspace')
+    return workspace
+
+
+def _alive(sock):
+    def is_live():
+        observer = _STATE['observer']
+        if observer is not None:  # after install: the authenticated host round trip, never a local flag
+            return observer.workspace_check() is True
+        try:
+            data = sock.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT)
+        except BlockingIOError:
+            return True
+        except OSError:
+            return False
+        return bool(data)
+    return is_live
+
+
+def observation_bind(frame):
+    """Bind the capsule from the owner-brokered channel, or refuse; None when there is nothing to bind."""
+    context = _context(frame)
+    fd = _STATE['fd']
+    if fd is None:
+        if context is not None and _required(context):
+            raise RuntimeError(MISSING)
+        return None
+    if context is None or (frame.get('policy') or {}).get('source') != 'kanban':
+        raise RuntimeError(MISSING)
+    sock = socket.socket(fileno=fd)
+    with _LOCK:
+        _STATE['fd'], _STATE['sock'] = -1, sock  # consumed: one bind per process
+    if sock.family != socket.AF_UNIX or not _peer_is_owner(sock):
+        raise RuntimeError('capsule_observation_peer')
+    sock.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+    from agent import observation_load
+    runtime, host_pid = observation_load.load_trusted(sock, _peer_pid(sock), context, frame['home'],
+                                                      START_DEADLINE_S)
+    _STATE['runtime'] = runtime
+    workspace = _check_start(_read_start(sock, host_pid), context)
+    from tools import capsule_workspace
+    home = os.path.realpath(frame['home'])
+    binding = capsule_workspace.bind_worker_workspace(context['task_id'], str(context['run_id']), home,
+                                                      workspace, _alive(sock))
+    _STATE['binding'] = binding
+    try:
+        _install_observer(runtime, sock, context, host_pid, home, workspace, binding)
+        sock.sendall(json.dumps({'v': 1, 'op': 'bound', 'task_id': context['task_id'],
+                                 'run_id': context['run_id'], 'pid': os.getpid()}).encode() + b'\n')
+    except BaseException:
+        binding.close()
+        raise
+    return binding
+
+
+def _install_observer(runtime, sock, context, host_pid, home, workspace, binding) -> None:
+    """``observer_runtime.install`` on a dup of the channel; capsule = the host Receiver's WORKSPACE_CHECK."""
+    fd = os.dup(sock.fileno())
+    try:
+        observer = runtime.install(fd, context['run_id'], host_pid)
+    except BaseException:
+        os.close(fd)
+        raise
+    observer.capsule = {'task_id': context['task_id'], 'run_id': str(context['run_id']), 'profile_home': home,
+                        'workspace': workspace}
+    observer.binding = binding
+    _STATE['observer'] = observer
+
+
+def observation_finish(ok):
+    """Seal (``ok``: observer ``close`` with counts) or poison (unsealed) once; None without an observer.
+
+    ``observer_runtime.finish_oneshot`` semantics: 0 when sealed, nonzero when poisoned or the seal
+    failed. Idempotent; ordinary cards (no observer loaded) always get None.
+    """
+    with _LOCK:
+        runtime = _STATE['runtime'] if _STATE['observer'] is not None and not _STATE['finished'] else None
+        if runtime is not None:
+            _STATE['finished'] = True
+    if runtime is None:
+        return None
+    return runtime.finish_oneshot(0 if ok is True else 1)
+
+
+def observation_revoke() -> None:
+    """Tombstone this process's binding (idempotent); the channel stays for the observer until exit."""
+    binding = _STATE['binding']
+    if binding is not None:
+        binding.close()
diff --git a/agent/observation_load.py b/agent/observation_load.py
new file mode 100644
index 00000000000..27ede1fc58e
--- /dev/null
+++ b/agent/observation_load.py
@@ -0,0 +1,253 @@
+"""Owner-pinned trusted observer load for a capsule-required managed worker. [daveey]
+
+Only ``agent.observation_bind`` imports this, and only once an owner-installed observation channel exists
+(ordinary cards never import it). The owner (``gateway.session_kanban_rendezvous``) wrote exactly one line
+into the channel before it brokered the peer end to the dispatcher host:
+``{"v":1,"op":"observer","root":<abs dir>,"digest":<sha256 hex>,"host_pid":<acceptor pid>}``, taken from
+the acceptor registration it verified. Here:
+
+1. the line's every byte must come from the owner (SCM_CREDENTIALS pid == the channel's creator pid, which
+   ``observation_bind`` already proved is an ancestor); malformed/missing -> ``capsule_observer_missing``;
+2. the root must be canonical, owner-uid and not group/world-writable (root dir and the three files), its
+   ancestors safe (``ancestors_problem``), and outside the card workspace and the profile's Kanban
+   workspace roots; the digest over the exact bytes read must equal the line's -> else
+   ``capsule_observer_untrusted``;
+3. the core hook sentinels must be present (``capsule_observer_hook_drift``);
+4. then those exact bytes are executed as ``observer_wire``, ``observer_runtime``, ``observer_codex``
+   (registered in ``sys.modules`` first, so their by-name imports resolve to the verified modules, never
+   sys.path / cwd). ``sys.path`` is never touched.
+
+Env, config and model output choose nothing here: the root and digest come only from the owner's line.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import importlib.util
+import json
+import os
+import re
+import socket
+import stat
+import struct
+import sys
+
+MISSING = 'capsule_observer_missing'
+UNTRUSTED = 'capsule_observer_untrusted'
+DRIFT = 'capsule_observer_hook_drift'
+LINE_KEYS = frozenset({'v', 'op', 'root', 'digest', 'host_pid'})
+OBSERVER_FILES = ('observer_codex.py', 'observer_runtime.py', 'observer_wire.py')
+LOAD_ORDER = ('observer_wire', 'observer_runtime', 'observer_codex')  # runtime and codex import wire by name
+MAX_LINE = 64 * 1024
+MAX_MODULE = 1024 * 1024
+_HEX64 = re.compile(r'[0-9a-f]{64}')
+_CRED = struct.calcsize('3i')
+# Same hook sentinels the trusted oneshot entry (integration observer_entry.cli) requires, plus the managed
+# worker's own seal. A core missing any of them could run observed traffic that never reaches the observer.
+SENTINELS = (
+    ('agent.chat_completion_helpers', '@_observe_sdk_request'),
+    ('agent.codex_runtime', 'return open_observed_codex_stream(agent, active_client,'),
+    ('agent.chat_completion_helpers', '@_unsupported_observed_summary'),
+    ('agent.client_lifecycle', 'and not observation_active()'),
+    ('agent.tool_executor', '@_observe_terminal_commit'),
+    ('agent.turn_api_call', 'if observation_active():'),
+    ('agent.session_persistence', 'observe_persisted(self, result)'),
+    ('agent.tool_executor', 'observe_terminal(agent, function_name'),
+    ('agent.managed_worker', 'observation_finish('),
+)
+
+
+def observer_digest(files) -> str:
+    """sha256 over the sorted ``(name, bytes)`` pairs; integration ``observer_acceptor.files_digest`` twin.
+
+    Each entry is ``name utf-8 + NUL + 8-byte big-endian length + bytes`` (pinned by a shared golden vector).
+    """
+    h = hashlib.sha256()
+    for name in sorted(files):
+        data = files[name]
+        h.update(name.encode('utf-8') + b'\x00' + len(data).to_bytes(8, 'big') + data)
+    return h.hexdigest()
+
+
+def ancestors_problem(entries):
+    """``entries`` = ``[(path, lstat), ...]`` from ``/`` down to the root's parent; None when safe.
+
+    Each must be a directory owned by root or this uid. A group/world-writable one is refused unless it is
+    root-owned and sticky (``/tmp``) or sits beneath an own directory nobody else may traverse (no g/o x).
+    """
+    me, shielded = os.getuid(), False  # windows-footgun: ok -- POSIX-only (unix socket peer credentials, owner-only modes)
+    for path, st in entries:
+        mode = stat.S_IMODE(st.st_mode)
+        if not stat.S_ISDIR(st.st_mode):
+            return f'{path}: not a directory'
+        if st.st_uid not in (0, me):
+            return f'{path}: foreign owner'
+        if mode & 0o022 and not shielded and not (st.st_uid == 0 and mode & stat.S_ISVTX):
+            return f'{path}: writable by others'
+        if st.st_uid == me and not mode & 0o011:
+            shielded = True
+    return None
+
+
+def _senders(ancillary):
+    return [struct.unpack('3i', data[:_CRED])[0] for level, kind, data in ancillary
+            if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS]
+
+
+def read_line(sock, owner_pid: int, deadline_s: float) -> bytes:
+    """One ``\\n``-terminated line, byte-wise (nothing after it is consumed), every byte sent by the owner."""
+    sock.settimeout(deadline_s)
+    buf = bytearray()
+    try:
+        while not buf.endswith(b'\n'):
+            data, ancillary, flags, _ = sock.recvmsg(1, socket.CMSG_SPACE(_CRED))
+            if not data or flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
+                raise RuntimeError(MISSING)
+            if _senders(ancillary) != [owner_pid]:
+                raise RuntimeError(UNTRUSTED)
+            buf += data
+            if len(buf) > MAX_LINE:
+                raise RuntimeError(MISSING)
+    except OSError as exc:  # timeout / reset: no owner line
+        raise RuntimeError(MISSING) from exc
+    finally:
+        sock.settimeout(None)
+    return bytes(buf)
+
+
+def parse_line(raw: bytes) -> dict:
+    try:
+        line = json.loads(raw)
+    except ValueError as exc:
+        raise RuntimeError(MISSING) from exc
+    if not (isinstance(line, dict) and set(line) == LINE_KEYS and type(line['v']) is int and line['v'] == 1
+            and line['op'] == 'observer' and isinstance(line['root'], str) and line['root']
+            and isinstance(line['digest'], str) and _HEX64.fullmatch(line['digest'])
+            and type(line['host_pid']) is int and line['host_pid'] > 1):
+        raise RuntimeError(MISSING)
+    return line
+
+
+def _inside(path: str, base: str) -> bool:
+    return os.path.commonpath([path, base]) == base
+
+
+def _forbidden_roots(context: dict, home: str):
+    real_home = os.path.realpath(home)
+    roots = [os.path.join(real_home, 'kanban', 'workspaces'), os.path.join(real_home, 'kanban', 'boards')]
+    workspace = context.get('workspace')
+    if isinstance(workspace, str) and os.path.isabs(workspace):
+        roots.append(os.path.realpath(workspace))
+    return roots
+
+
+def _check_location(root: str, context: dict, home: str) -> None:
+    if not os.path.isabs(root) or os.path.realpath(root) != root:
+        raise RuntimeError(UNTRUSTED)
+    if any(_inside(root, base) for base in _forbidden_roots(context, home)):
+        raise RuntimeError(UNTRUSTED)
+    entries, parts = [], root.split(os.sep)[1:-1]
+    for depth in range(len(parts) + 1):
+        path = os.sep + os.sep.join(parts[:depth])
+        try:
+            entries.append((path, os.lstat(path)))
+        except OSError as exc:
+            raise RuntimeError(UNTRUSTED) from exc
+    if ancestors_problem(entries) is not None:
+        raise RuntimeError(UNTRUSTED)
+
+
+def _owned_private(st) -> bool:
+    return st.st_uid == os.getuid() and not stat.S_IMODE(st.st_mode) & 0o022  # windows-footgun: ok -- POSIX-only (unix socket peer credentials, owner-only modes)
+
+
+def _read_file(dfd: int, name: str) -> bytes:
+    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
+    try:
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode) or not _owned_private(st) or st.st_size > MAX_MODULE:
+            raise RuntimeError(UNTRUSTED)
+        data = b''
+        while chunk := os.read(fd, MAX_MODULE + 1 - len(data)):
+            data += chunk
+            if len(data) > MAX_MODULE:
+                raise RuntimeError(UNTRUSTED)
+        return data
+    finally:
+        os.close(fd)
+
+
+def verified_files(root: str, digest: str, context: dict, home: str) -> dict:
+    """The three observer files' exact bytes, only if the root is trusted and their digest matches."""
+    _check_location(root, context, home)
+    try:
+        dfd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    except OSError as exc:
+        raise RuntimeError(UNTRUSTED) from exc
+    try:
+        if not _owned_private(os.fstat(dfd)):
+            raise RuntimeError(UNTRUSTED)
+        files = {name: _read_file(dfd, name) for name in OBSERVER_FILES}
+    except OSError as exc:
+        raise RuntimeError(UNTRUSTED) from exc
+    finally:
+        os.close(dfd)
+    if not hmac.compare_digest(observer_digest(files), digest):
+        raise RuntimeError(UNTRUSTED)
+    return files
+
+
+def _source(name: str) -> str:
+    module = sys.modules.get(name)
+    if module is not None:
+        import inspect
+        return inspect.getsource(module)
+    spec = importlib.util.find_spec(name)
+    if spec is None or not spec.origin:
+        raise OSError(name)
+    with open(spec.origin, encoding='utf-8') as stream:  # windows-footgun: ok -- POSIX-only capsule observer; source compared byte-exact
+        return stream.read()
+
+
+def check_hooks() -> None:
+    """Refuse a core whose observation hooks drifted (read from the loaded core, never executed here)."""
+    for name, sentinel in SENTINELS:
+        try:
+            present = sentinel in _source(name)
+        except (OSError, TypeError, ImportError) as exc:
+            raise RuntimeError(DRIFT) from exc
+        if not present:
+            raise RuntimeError(DRIFT)
+
+
+def load_modules(root: str, files: dict):
+    """Execute the verified bytes under their module names; returns the ``observer_runtime`` module."""
+    if any(name in sys.modules for name in LOAD_ORDER):
+        raise RuntimeError(UNTRUSTED)  # something else already claimed a trusted name
+    loaded = []
+    try:
+        for name in LOAD_ORDER:
+            path = os.path.join(root, name + '.py')
+            spec = importlib.util.spec_from_file_location(name, path)
+            if spec is None:
+                raise ImportError(name)
+            module = importlib.util.module_from_spec(spec)
+            sys.modules[name] = module
+            loaded.append(name)
+            exec(compile(files[name + '.py'], path, 'exec', dont_inherit=True), module.__dict__)
+    except Exception as exc:
+        for name in loaded:
+            sys.modules.pop(name, None)
+        raise RuntimeError(UNTRUSTED) from exc
+    runtime = sys.modules['observer_runtime']
+    if not all(callable(getattr(runtime, attr, None)) for attr in ('install', 'active', 'finish_oneshot')):
+        raise RuntimeError(UNTRUSTED)
+    return runtime
+
+
+def load_trusted(sock, owner_pid: int, context: dict, home: str, deadline_s: float):
+    """Read the owner's observer line, verify, load. Returns ``(observer_runtime module, host_pid)``."""
+    line = parse_line(read_line(sock, owner_pid, deadline_s))
+    files = verified_files(line['root'], line['digest'], context, home)
+    check_hooks()
+    return load_modules(line['root'], files), line['host_pid']
