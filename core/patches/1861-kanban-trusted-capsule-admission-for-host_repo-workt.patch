+        with pytest.raises(CapabilityMismatchError):
+            validate_assignment("builder", workspace_kind="worktree", host_repo_attestation=object())
+        with pytest.raises(CapabilityMismatchError):
+            kb.assign_task(env.conn, tid, "other")
