@@ -0,0 +1,167 @@
+"""Native owner derives the capsule requirement itself and fails closed without live transport. [daveey]
+
+The requirement comes from the claimed task row (workspace kind / requires) plus the assignee's
+actual resolved terminal backend, never from caller params, saved policy or config grants.
+"""
+import json
+from contextlib import closing
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+
+
+def _write_backend(home, backend):
+    (home / 'config.yaml').write_text(json.dumps({'terminal': {'backend': backend},
+                                                  'platform_toolsets': {'cli': ['terminal', 'file']}}), encoding='utf-8')
+
+
+def _board(tmp_path, monkeypatch, *, workspace_kind='dir', local=False):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect
+    from gateway.session_contract import Principal
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path))
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('HOME', str(tmp_path / 'home'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    monkeypatch.delenv('HERMES_DELEGATED_CHILD', raising=False)
+    monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env',
+                        lambda name: str(tmp_path) if name == 'default' else str(tmp_path / name))
+    # Creation-time gate is not under test: the row is created under a local policy, then the assignee's
+    # real config.yaml becomes the backend under test (as a capsule-admitted create would leave the row).
+    _write_backend(tmp_path, 'local')
+    workspace = tmp_path / 'workspace'
+    workspace.mkdir()
+    kb.create_board('owned')
+    kwargs = dict(workspace_kind=workspace_kind)
+    if workspace_kind == 'dir':
+        kwargs['workspace_path'] = str(workspace)
+    with closing(connect(board='owned')) as conn:
+        task_id = kb.create_task(conn, title='t', body='b', assignee='default', **kwargs)
+        kb.recompute_ready(conn)
+        task = kb.claim_task(conn, task_id)
+        assert task is not None
+        # Match dispatcher materialization before the owner reads the claimed row.
+        from hermes_cli import kanban_db_workspace as kbw
+        kbw.set_workspace_path(conn, task.id, str(kbw.resolve_workspace(task, board='owned')))
+    _write_backend(tmp_path, 'local' if local else 'docker')
+    actor = Principal('owner', str(tmp_path), frozenset({'session:create'}), 'transport')
+    connection = SimpleNamespace(authority=SimpleNamespace(profile_id=str(tmp_path)), actor=actor, native_owner=True)
+    params = dict(board='owned', task_id=task.id, run_id=task.current_run_id, claim_lock=task.claim_lock)
+    config = {'model': {'default': 'm', 'provider': 'custom'}, 'platform_toolsets': {'cli': ['terminal', 'file']}}
+    return connection, params, config
+
+
+def _policy(tmp_path, monkeypatch, **kw):
+    from gateway.session_kanban import build_kanban_policy
+    connection, params, config = _board(tmp_path, monkeypatch, **kw)
+    policy, _ = build_kanban_policy(connection, params, config)
+    return policy
+
+
+def test_remote_host_repo_requirement_is_derived_and_frozen(tmp_path, monkeypatch):
+    policy = _policy(tmp_path, monkeypatch, local=False)
+    context = json.loads(policy.kanban_json)
+    assert context['capsule'] == {'required': True, 'requires': 'host_repo', 'backend': 'remote'}
+
+
+@pytest.mark.parametrize('kw', [dict(local=True), dict(workspace_kind='scratch', local=False)])
+def test_local_or_scratch_remote_not_required(tmp_path, monkeypatch, kw):
+    from gateway.session_kanban_capsule import require_capsule_transport
+    policy = _policy(tmp_path, monkeypatch, **kw)
+    assert json.loads(policy.kanban_json)['capsule'] == {'required': False}
+    require_capsule_transport(policy)  # ordinary behaviour unchanged: no refusal
+
+
+def test_required_capsule_without_transport_fails_closed(tmp_path, monkeypatch):
+    from gateway.session_kanban_capsule import require_capsule_transport
+    from hermes_state_runtime import RuntimeStoreError
+    policy = _policy(tmp_path, monkeypatch, local=False)
+    with pytest.raises(RuntimeStoreError, match='capsule_observation_missing'):
+        require_capsule_transport(policy)
+
+
+@pytest.mark.parametrize('frozen', [None, {'required': False}, {'required': 'yes'}])
+def test_old_or_replayed_saved_policy_rederives(tmp_path, monkeypatch, frozen):
+    """A policy saved before the field existed, or a replay carrying a forged False, still refuses."""
+    from gateway.session_kanban_capsule import require_capsule_transport
+    from hermes_state_runtime import RuntimeStoreError
+    policy = _policy(tmp_path, monkeypatch, local=False)
+    context = json.loads(policy.kanban_json)
+    if frozen is None:
+        context.pop('capsule')
+    else:
+        context['capsule'] = frozen
+    stale = replace(policy, kanban_json=json.dumps(context))
+    with pytest.raises(RuntimeStoreError, match='capsule_observation_missing'):
+        require_capsule_transport(stale)
+
+
+def test_unreadable_backend_policy_fails_closed(tmp_path, monkeypatch):
+    from gateway.session_kanban_capsule import require_capsule_transport
+    from hermes_state_runtime import RuntimeStoreError
+    policy = _policy(tmp_path, monkeypatch, local=True)
+    (tmp_path / 'config.yaml').unlink()  # the assignee policy can no longer be read
+    with pytest.raises(RuntimeStoreError, match='capsule_observation_missing'):
+        require_capsule_transport(policy)
+
+
+def test_no_config_or_param_grant_accepted(tmp_path, monkeypatch):
+    """Caller params/config cannot flip the derived requirement (exact param set still enforced)."""
+    from gateway.session_kanban import build_kanban_policy
+    from hermes_state_runtime import RuntimeStoreError
+    connection, params, config = _board(tmp_path, monkeypatch, local=False)
+    with pytest.raises(RuntimeStoreError, match='invalid_params'):
+        build_kanban_policy(connection, params | {'capsule': {'required': False}}, config)
+    policy, _ = build_kanban_policy(connection, params, config | {'capsule': {'required': False}, 'kanban': {'capsule': False}})
+    assert json.loads(policy.kanban_json)['capsule']['required'] is True
+
+
+def test_launch_guard_refuses_before_worker_spawn(tmp_path, monkeypatch):
+    """Missing rendezvous at launch: placing_spawn refuses before the managed worker exists."""
+    from gateway.session_kanban_scope import placing_spawn
+    from hermes_state_runtime import RuntimeStoreError
+    policy = _policy(tmp_path, monkeypatch, local=False)
+    context = json.loads(policy.kanban_json)
+    context.pop('capsule')  # an admission queued by an older owner
+    spawned = []
+    run = placing_spawn(lambda *a, **k: spawned.append(a), replace(policy, kanban_json=json.dumps(context)))
+    with pytest.raises(RuntimeStoreError, match='capsule_observation_missing'):
+        run(['python', '-m', 'agent.managed_worker'])
+    assert spawned == []
+
+
+def test_launch_guard_ordinary_card_spawns(tmp_path, monkeypatch):
+    from gateway.session_kanban_scope import placing_spawn
+    policy = _policy(tmp_path, monkeypatch, local=True)
+    monkeypatch.setattr('gateway.session_kanban_scope.resolve_run_scope', lambda p: None)
+    spawned = []
+    run = placing_spawn(lambda *a, **k: spawned.append(a) or 'proc', policy)
+    assert run(['x']) == 'proc' and spawned == [(['x'],)]
+
+
+async def _run_task_refuses(tmp_path, monkeypatch):
+    import gateway.session_kanban as sk
+    connection, params, config = _board(tmp_path, monkeypatch, local=False)
+    created = []
+    monkeypatch.setattr('gateway.run._load_gateway_config', lambda: config)
+    monkeypatch.setattr('gateway.session_local.create_local_session', lambda *a, **k: created.append(a))
+    connection.authority.db = SimpleNamespace(db_path=str(tmp_path / 'owner.db'), get_session=lambda sid: None)
+    await sk.run_task(connection, params)
+    return created
+
+
+def test_admission_refuses_before_session_and_owner_admitted(tmp_path, monkeypatch):
+    import asyncio
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect
+    from hermes_state_runtime import RuntimeStoreError
+    created = []
+
+    async def go():
+        created.extend(await _run_task_refuses(tmp_path, monkeypatch))
+    with pytest.raises(RuntimeStoreError, match='capsule_observation_missing'):
+        asyncio.run(go())
+    assert created == []
+    with closing(connect(board='owned')) as conn:
+        assert not conn.execute("SELECT 1 FROM task_events WHERE kind='owner_admitted'").fetchall()
diff --git a/tests/gateway/test_session_kanban_rendezvous.py b/tests/gateway/test_session_kanban_rendezvous.py
new file mode 100644
index 00000000000..dddd50c2ca5
--- /dev/null
+++ b/tests/gateway/test_session_kanban_rendezvous.py
@@ -0,0 +1,777 @@
+"""Authenticated, run-bound, single-use owner rendezvous for capsule-required Kanban cards. [daveey]
+
+A real in-test acceptor (a unix-socket server thread) stands in for the trusted dispatcher host. The owner
+brokers one end of a socketpair to it over SCM_RIGHTS after spawning a real tiny python child that holds
+the other end. Every failure is fail-closed: no handshake, no child; a failure after the spawn kills it.
+"""
+import json
+import os
+import socket
+import subprocess
+import sys
+import threading
+from dataclasses import replace
+
+import pytest
+
+from tests.gateway.test_session_kanban_capsule_guard import _policy
+
+pytestmark = pytest.mark.platforms('linux')
+
+# The child reads the inherited fd named by the owner-only argv flag and echoes the start line it receives.
+# run22: the owner's observer line arrives first on that fd; the child prints start, then the observer line.
+CHILD = ("import socket,sys;a=sys.argv[1:];assert a[0]=='--observation-fd',a;"
+         "s=socket.socket(fileno=int(a[1]));f=s.makefile('rb');o=f.readline();"
+         "print(f.readline().decode().strip(),flush=True);print(o.decode().strip(),flush=True)")
+# Reads the first line with SO_PASSCRED and reports the SCM_CREDENTIALS sender of every byte of it.
+CHILD_CREDS = ("import json,socket,struct,sys;a=sys.argv[1:];s=socket.socket(fileno=int(a[1]));"
+               "s.setsockopt(socket.SOL_SOCKET,socket.SO_PASSCRED,1);buf=b'';pids=set()\n"
+               "while not buf.endswith(b'\\n'):\n"
+               " d,anc,fl,_=s.recvmsg(1,socket.CMSG_SPACE(12))\n"
+               " assert d\n"
+               " buf+=d;pids|={struct.unpack('3i',v)[0] for l,t,v in anc if t==socket.SCM_CREDENTIALS}\n"
+               "print(json.dumps({'line':json.loads(buf),'senders':sorted(pids)}),flush=True)")
+
+
+TEST_DISPATCH_OWNER = 'test-dispatcher'
+_UNSET = object()
+
+
+def board_dispatch_owner(db):
+    """The board's persisted dispatch owner; the test board gets one (like a provisioned board) if unset."""
+    from hermes_cli.kanban_dispatch_owner import get_dispatch_owner, set_dispatch_owner
+    return get_dispatch_owner(db) or set_dispatch_owner(db, TEST_DISPATCH_OWNER)
+
+
+_OBSERVER_ROOT = []
+
+
+def observer_fields():
+    """run22: the trusted observer root + digest the dispatcher host registers (a staged private dir)."""
+    import tempfile
+    from pathlib import Path
+    from tests.agent.test_managed_worker_observer_load import root_digest, stage_observer
+    if not _OBSERVER_ROOT:
+        _OBSERVER_ROOT.append(stage_observer(Path(tempfile.mkdtemp(prefix='observer-root-'))))
+    root = _OBSERVER_ROOT[0]
+    return {'observer_root': str(root), 'observer_digest': root_digest(root)}
+
+
+def registration_for(db, **override):
+    """Acceptor registration content (``D/acceptor.json``) for THIS process as the listener."""
+    from hermes_cli.kanban_db_dispatch import _process_fingerprint
+    from pathlib import Path
+    real = str(Path(db).resolve())
+    body = {'v': 1, 'db': real, 'dispatch_owner': board_dispatch_owner(real), 'pid': os.getpid(),
+            'start': _process_fingerprint(os.getpid()), **observer_fields()}
+    body.update(override)
+    return body
+
+
+def write_registration(folder, body, *, mode=0o600):
+    """Atomic tmp + rename inside the rendezvous dir (what the dispatcher acceptor does at startup)."""
+    data = body if isinstance(body, bytes) else json.dumps(body, sort_keys=True).encode()
+    tmp = folder / '.acceptor.json.tmp'
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    try:
+        os.write(fd, data)
+    finally:
+        os.close(fd)
+    os.chmod(tmp, mode)
+    os.replace(tmp, folder / 'acceptor.json')
+
+
+class Acceptor:
+    """Dispatcher-side stand-in: listens at the deterministic run socket and speaks the documented wire.
+
+    It registers itself in ``D/acceptor.json`` (bound to the board's dispatch owner and this process's
+    pid + start fingerprint) and echoes ``dispatch_owner`` in the hello reply, as the decided spec requires.
+    """
+
+    def __init__(self, context, *, echo=None, accept_fd=True, mode=0o700, register=True, registration=None,
+                 reply_owner=_UNSET):
+        from gateway.session_kanban_rendezvous import rendezvous_dir
+        self.context = context
+        self.dir = rendezvous_dir(context['db'])
+        self.dir.mkdir(mode=0o700, exist_ok=True)
+        os.chmod(self.dir, mode)
+        self.path = self.dir / f"{context['run_id']}.sock"
+        self.echo, self.accept_fd = echo or {}, accept_fd
+        self.hellos, self.payloads, self.fds = [], [], []
+        self.registration = registration_for(context['db']) if registration is None else registration
+        if register:
+            write_registration(self.dir, self.registration)
+        self.reply_owner = (self.registration.get('dispatch_owner') if isinstance(self.registration, dict)
+                            else None) if reply_owner is _UNSET else reply_owner
+        dfd = os.open(self.dir, os.O_RDONLY | os.O_DIRECTORY)
+        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            self.server.bind(f'/proc/self/fd/{dfd}/{self.path.name}')
+        finally:
+            os.close(dfd)
+        self.server.listen(8)
+        self.stop = threading.Event()
+        self.thread = threading.Thread(target=self._serve, daemon=True)
+        self.thread.start()
+
+    def identity(self):
+        from pathlib import Path
+        c = self.context
+        return {'db': str(Path(c['db']).resolve()), 'task_id': c['task_id'], 'run_id': c['run_id'],
+                'claim_lock': c['claim_lock']}
+
+    def _serve(self):
+        self.server.settimeout(0.2)
+        while not self.stop.is_set():
+            try:
+                conn, _ = self.server.accept()
+            except (TimeoutError, OSError):
+                continue
+            with conn:
+                try:
+                    self._one(conn)
+                except (OSError, ValueError):
+                    pass
+
+    def _one(self, conn):
+        conn.settimeout(5)
+        reader = conn.makefile('rb')
+        hello = json.loads(reader.readline())
+        self.hellos.append(hello)
+        reply = {'v': 1, 'ok': True, **self.identity(), **self.echo}
+        if self.reply_owner is not _UNSET and self.reply_owner is not None:
+            reply['dispatch_owner'] = self.reply_owner
+        conn.sendall(json.dumps(reply).encode() + b'\n')
+        if hello.get('op') != 'attach':
+            return
+        msg, fds, _flags, _addr = socket.recv_fds(conn, 65536, 1)
+        payload = json.loads(msg.split(b'\n', 1)[0])
+        self.payloads.append(payload)
+        if not self.accept_fd or len(fds) != 1:
+            conn.sendall(b'{"v":1,"ok":false,"reason":"refused"}\n')
+            for fd in fds:
+                os.close(fd)
+            return
+        channel = socket.socket(fileno=fds[0])
+        self.fds.append(channel)
+        channel.sendall(json.dumps({'v': 1, 'op': 'start', 'task_id': payload['task_id'], 'run_id': payload['run_id'],
+                                    'claim_lock': payload['claim_lock']}).encode() + b'\n')
+        conn.sendall(b'{"v":1,"ok":true,"received":true}\n')
+
+    def close(self):
+        self.stop.set()
+        self.thread.join(5)
+        self.server.close()
+        for channel in self.fds:
+            channel.close()
+
