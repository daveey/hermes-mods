From fb393b96b367b6a224abb547714e2f7df623403e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 05:06:58 +0000
Subject: [PATCH] fix(update): a git ancestry timeout on a loaded host keeps
 HEAD instead of failing the stable lookup

hermes update --check failed in the pm e2e shard (run 40785922193) with
'git merge-base --is-ancestor ... timed out after 10 seconds'. _head_containing's
contract is that an unknown relation keeps HEAD; a timeout is unknown. Also give local
git 60s like the neighbouring resolver.
---
 hermes_cli/source_releases.py                 | 22 ++++++++++++++-----
 .../test_stable_forward_only_shallow.py       | 18 +++++++++++++++
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/source_releases.py b/hermes_cli/source_releases.py
index d9927e102a..50ef95e88e 100644
--- a/hermes_cli/source_releases.py
+++ b/hermes_cli/source_releases.py
@@ -96,6 +96,9 @@ def resolve_source_target(channel: str, git_cmd=None, cwd=None, *, repository=No
     return target
 
 
+_LOCAL_GIT_TIMEOUT = 60
+
+
 def _head_containing(git_cmd, cwd, commit: str, repository: str) -> str | None:
     """HEAD's sha unless HEAD is PROVEN not to contain ``commit``, then None.
 
@@ -105,19 +108,26 @@ def _head_containing(git_cmd, cwd, commit: str, repository: str) -> str | None:
     from hermes_cli.source_check import _github_compare, source_git_env
 
     def run(*args):
+        # Local git on a loaded host (CI shards, cold caches) can take well over 10s.
         return subprocess.run(
             [*git_cmd, *args], cwd=cwd, capture_output=True, text=True, encoding="utf-8",
-            errors="replace", timeout=10, stdin=subprocess.DEVNULL, env=source_git_env(), check=False)
+            errors="replace", timeout=_LOCAL_GIT_TIMEOUT, stdin=subprocess.DEVNULL, env=source_git_env(),
+            check=False)
 
     head = run("rev-parse", "HEAD").stdout.strip()
     if not _SHA.fullmatch(head):
         return None
-    ancestry = run("merge-base", "--is-ancestor", commit, head).returncode
-    if ancestry == 0:
+    try:
+        ancestry = run("merge-base", "--is-ancestor", commit, head).returncode
+        if ancestry == 0:
+            return head
+        # A shallow boundary makes exit 1 a guess; full history makes it proof.
+        if ancestry == 1 and run("rev-parse", "--is-shallow-repository").stdout.strip() == "false":
+            return None
+    except subprocess.TimeoutExpired:
+        # An unanswered ancestry question is an unknown relation, which keeps HEAD
+        # (see the docstring); it must not fail the whole channel lookup.
         return head
-    # A shallow boundary makes exit 1 a guess; full history makes it proof.
-    if ancestry == 1 and run("rev-parse", "--is-shallow-repository").stdout.strip() == "false":
-        return None
     status = (_github_compare(commit, head, repository) or {}).get("status")
     return None if status in ("behind", "diverged") else head
 
diff --git a/tests/hermes_cli/test_stable_forward_only_shallow.py b/tests/hermes_cli/test_stable_forward_only_shallow.py
index e42a905ce6..a513ffbf8c 100644
--- a/tests/hermes_cli/test_stable_forward_only_shallow.py
+++ b/tests/hermes_cli/test_stable_forward_only_shallow.py
@@ -49,3 +49,21 @@ def test_full_history_behind_release_is_proof(history, tmp_path, monkeypatch):
     monkeypatch.setattr(source_check, "_github_compare", lambda *a, **k: pytest.fail("no network on proof"))
     assert source_releases._head_containing(["git"], clone, shas[2], "o/r") is None
     assert source_releases._head_containing(["git"], clone, shas[0], "o/r") == shas[0]
+
+
+def test_ancestry_check_timeout_is_an_unknown_relation_that_keeps_head(history, tmp_path, monkeypatch):
+    """A loaded host can outlast the git budget; that must not fail the channel lookup."""
+    origin, shas = history
+    clone = tmp_path / "full"
+    _git(tmp_path, "clone", "-q", str(origin), str(clone))
+    real_run = subprocess.run
+
+    def slow_merge_base(cmd, *args, **kwargs):
+        if "merge-base" in cmd:
+            raise subprocess.TimeoutExpired(cmd, kwargs.get("timeout"))
+        return real_run(cmd, *args, **kwargs)
+
+    monkeypatch.setattr(source_releases.subprocess, "run", slow_merge_base)
+    assert source_releases._head_containing(["git"], clone, shas[0], "o/r") == shas[2]
+    # The local git budget is generous enough for a loaded CI shard.
+    assert source_releases._LOCAL_GIT_TIMEOUT >= 60
-- 
