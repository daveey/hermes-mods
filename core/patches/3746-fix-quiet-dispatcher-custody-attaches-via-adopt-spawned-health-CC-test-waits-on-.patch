Subject: [PATCH] fix(quiet): dispatcher custody attaches via adopt_spawned
 (health CC); test waits on condition, not clock

---
 hermes_cli/kanban_db_dispatch.py               |  8 +-------
 hermes_cli/kanban_db_dispatch_custody.py       | 13 +++++++++++++
 tests/hermes_cli/test_local_work_threads.py    |  4 ++--
 .../test_quiet_kanban_spawn_custody.py         | 18 ++++++++++++++++++
 4 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 3f8d5d78f3..6f8aca87af 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -2767,13 +2767,7 @@ def _default_spawn(task: Task, workspace: str, *, board: Optional[str] = None, o
     # Intentionally NOT closing log_f: the child keeps writing after return;
     # the OS-level FD stays open in the child until it exits.
     _live_worker_procs[proc.pid] = proc
-    try:
-        birth = _process_fingerprint(proc.pid)
-    except Exception:  # health: allow BLE001 -- the child exists: custody must still attach; an unknown birth latches unknown
-        birth = None
-        if held is not None:
-            held.mark_unknown("kanban-worker-birth-unreadable")
-    _custody.adopt(proc, held, birth)
+    _custody.adopt_spawned(proc, held, _process_fingerprint)
     return proc.pid
 
 
diff --git a/hermes_cli/kanban_db_dispatch_custody.py b/hermes_cli/kanban_db_dispatch_custody.py
index 7738a6e0bf..67bed6aaae 100644
--- a/hermes_cli/kanban_db_dispatch_custody.py
+++ b/hermes_cli/kanban_db_dispatch_custody.py
@@ -38,6 +38,19 @@ def adopt(proc, held, birth: Optional[str]) -> None:
         held.mark_unknown("kanban-worker-custody-unattachable")
 
 
+def adopt_spawned(proc, held, fingerprint) -> None:
+    """Adopt right after Popen: the child exists, so custody must attach even when reading its birth
+    fingerprint raises (the token is kept and the registry latches unknown)."""
+    if held is None:
+        return
+    try:
+        birth = fingerprint(proc.pid)
+    except Exception:  # health: allow BLE001 -- the child exists: custody must still attach; an unknown birth latches unknown
+        birth = None
+        held.mark_unknown("kanban-worker-birth-unreadable")
+    adopt(proc, held, birth)
+
+
 def _take(pid: int, proc) -> list:
     with _lock:
         keys = [k for k, (p, _h) in _custody.items() if k[0] == int(pid) and p is proc]
