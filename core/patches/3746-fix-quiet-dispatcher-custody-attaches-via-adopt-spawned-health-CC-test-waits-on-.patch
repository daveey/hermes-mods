index d42551bee1..7188654609 100644
--- a/tests/hermes_cli/test_local_work_threads.py
+++ b/tests/hermes_cli/test_local_work_threads.py
@@ -193,6 +193,7 @@ def test_audio_cancelled_queued_job_releases_and_never_runs(tmp_path, monkeypatc
     still queued releases the reservation, and the job never runs (RED on 95089d00fb: token leaked)."""
     from hermes_cli import local_work
     from hermes_cli.web_routers import audio
+    from tests.waiting import async_wait_until
 
     registry, home = setup_owner(tmp_path)
     monkeypatch.setattr(local_work, "_registry", registry)
@@ -206,8 +207,7 @@ def test_audio_cancelled_queued_job_releases_and_never_runs(tmp_path, monkeypatc
         blocker = loop.run_in_executor(None, lambda: (entered.set(), release.wait(5)))
         assert entered.wait(5)
         task = asyncio.ensure_future(audio._run_reserved("test.audio", ran.set))
-        await asyncio.sleep(0.05)
-        assert registry.snapshot().active == 1
+        await async_wait_until(lambda: registry.snapshot().active == 1, timeout=5)
         task.cancel()
         with pytest.raises(asyncio.CancelledError):
             await task
diff --git a/tests/hermes_cli/test_quiet_kanban_spawn_custody.py b/tests/hermes_cli/test_quiet_kanban_spawn_custody.py
index 1b8f141b6a..498cc7fc40 100644
--- a/tests/hermes_cli/test_quiet_kanban_spawn_custody.py
+++ b/tests/hermes_cli/test_quiet_kanban_spawn_custody.py
@@ -124,6 +124,24 @@ def test_handle_dropped_without_verified_exit_keeps_token_and_latches_unknown(re
     assert "kanban-worker-exit-unverified" in snap.unknowns
 
 
+def test_unreadable_birth_after_popen_keeps_custody_and_latches_unknown(registry, monkeypatch, tmp_path):
+    """The child exists once Popen returns: a raising birth fingerprint must not orphan the token
+    (RED on 95089d00fb: the exception escaped before adopt, the token was never attached)."""
+    from hermes_cli import kanban_db_dispatch as kbd
+
+    def boom(pid):
+        raise OSError("proc unreadable")
+
+    monkeypatch.setattr(kbd, "_process_fingerprint", boom)
+    proc = FakeProc(51004)
+    assert _spawn(monkeypatch, tmp_path, proc) == 51004
+    snap = registry.snapshot()
+    assert snap.active == 1 and "kanban-worker-birth-unreadable" in snap.unknowns
+    proc.returncode = 0
+    assert kbd.reap_worker_zombies() == [51004]
+    assert registry.snapshot().active == 0  # the verified exit still releases the attached token
+
+
 def test_no_registry_is_inert(monkeypatch, tmp_path):
     from hermes_cli import kanban_db_dispatch as kbd
     monkeypatch.setattr(local_work, "_registry", None)
