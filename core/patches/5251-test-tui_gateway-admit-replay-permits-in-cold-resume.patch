From 691c80f1c38c7ee597a22f3cee36b3280731d681 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 13:23:55 +0000
Subject: [PATCH] test(tui_gateway): admit replay permits in cold-resume
 fixtures [daveey]

CI exposed two fake worker boundaries returning started without running the new worker-entry permit. Preserve real admission in each fake instead of weakening local replay custody. Both files reproduced red at 43d668ca82; corrected fixtures pass 15 tests with file retries disabled. Production admission behavior is unchanged.
---
 tests/tui_gateway/test_automation_replay_profiles.py   |  7 ++++++-
 .../tui_gateway/test_cold_resume_yields_paused_turn.py | 10 ++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_automation_replay_profiles.py b/tests/tui_gateway/test_automation_replay_profiles.py
index cf54f15e7b..33554ad0a7 100644
--- a/tests/tui_gateway/test_automation_replay_profiles.py
+++ b/tests/tui_gateway/test_automation_replay_profiles.py
@@ -69,7 +69,12 @@ def test_timer_replays_only_its_profile(homes, monkeypatch):
     schedule(alpha, "alpha work")
     schedule(beta, "beta work")
     calls = []
-    monkeypatch.setattr("tui_gateway.server._wake_session_turn", lambda key, text, **kw: calls.append((text, kw)) or "started")
+    def wake(key, text, **kw):
+        calls.append((text, kw))
+        assert kw["replay_delivery"].admit()
+        return "started"
+
+    monkeypatch.setattr("tui_gateway.server._wake_session_turn", wake)
     timers[0].callback()
     assert len(calls) == 1 and "alpha work" in calls[0][0] and "beta work" not in calls[0][0]
     assert calls[0][1]["profiles"] == ["alpha"]
diff --git a/tests/tui_gateway/test_cold_resume_yields_paused_turn.py b/tests/tui_gateway/test_cold_resume_yields_paused_turn.py
index fdc5411de2..b51d8e9912 100644
--- a/tests/tui_gateway/test_cold_resume_yields_paused_turn.py
+++ b/tests/tui_gateway/test_cold_resume_yields_paused_turn.py
@@ -209,6 +209,16 @@ def test_a_busy_replay_is_still_pending_when_the_yield_window_ends(recovery, hom
     monkeypatch.setattr(ar, "ENABLED", True)
     monkeypatch.setattr(ar, "_arm", lambda key, entry, delay, fire: timers.append((delay, fire, key)))
     verdicts = []
+    real_submit = server._run_prompt_submit
+
+    def submit(*a, **kw):
+        # The recovery fixture replaces the worker; retain its worker-entry permit.
+        permit = kw.get("replay_delivery")
+        if permit is not None:
+            assert permit.admit()
+        return real_submit(*a, **kw)
+
+    monkeypatch.setattr(server, "_run_prompt_submit", submit)
     real_wake = server._wake_session_turn
     monkeypatch.setattr(server, "_wake_session_turn",
                         lambda *a, **kw: (verdicts.append(real_wake(*a, **kw)), verdicts[-1])[1])
-- 
