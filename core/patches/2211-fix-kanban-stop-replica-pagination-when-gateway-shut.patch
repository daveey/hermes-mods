diff --git a/hermes_cli/kanban_sync_stop.py b/hermes_cli/kanban_sync_stop.py
new file mode 100644
index 0000000000..577a6cba4b
--- /dev/null
+++ b/hermes_cli/kanban_sync_stop.py
@@ -0,0 +1,40 @@
+"""Cooperative cancellation at sync transaction boundaries, scoped to one loop thread."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from typing import Callable
+
+_running: ContextVar[Callable[[], bool] | None] = ContextVar("kanban_sync_running", default=None)
+
+
+class SyncStopped(Exception):
+    """Normal gateway shutdown/yield, not a failed sync round."""
+
+
+@contextmanager
+def stop_scope(keep_running: Callable[[], bool]):
+    token = _running.set(keep_running)
+    try:
+        yield
+    finally:
+        _running.reset(token)
+
+
+def run_loop(loop, keep_running: Callable[[], bool], interval) -> None:
+    """Keep shutdown normal, crashes visible, and diagnostics cleanup unconditional."""
+    from hermes_cli import kanban_sync_runstate as runstate, kanban_sync_timing as timing
+    try:
+        with stop_scope(keep_running):
+            loop(keep_running, interval, runstate)
+    except SyncStopped:
+        runstate.record_down("stopped (gateway stopping, or the host sync lease went to another gateway)")
+    except BaseException as exc:
+        runstate.record_down(f"kanban sync loop crashed: {type(exc).__name__}: {exc}")
+        raise
+    finally:
+        timing.stop()
+
+
+def checkpoint() -> None:
+    running = _running.get()
+    if running is not None and not running():
+        raise SyncStopped()
diff --git a/tests/hermes_cli/test_kanban_sync_shutdown.py b/tests/hermes_cli/test_kanban_sync_shutdown.py
new file mode 100644
index 0000000000..9234a36598
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sync_shutdown.py
@@ -0,0 +1,68 @@
+"""A cancelled gateway watcher must not leave bootstrap in asyncio's executor."""
+import asyncio
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_sync_client as client
+
+
+@pytest.mark.parametrize("snapshot", [False, True])
+def test_gateway_stop_interrupts_active_replica_pages(monkeypatch, snapshot):
+    entered = threading.Event()
+    stopped = threading.Event()
+    pages = []
+    applied = []
+
+    class Hub:
+        def changes(self, board, cursor):
+            pages.append(cursor)
+            entered.set()
+            assert stopped.wait(5)
+            return {"changes": [], "next": cursor + 1, "more": len(pages) < 100}
+
+        def snapshot_page(self, board, table, after):
+            pages.append(after)
+            entered.set()
+            assert stopped.wait(5)
+            return {"rows": [], "head": 99, "next": str(len(pages)), "more": len(pages) < 100}
+
+    monkeypatch.setattr(client.sync, "sync_state", lambda conn: {"cursor": 0})
+    monkeypatch.setattr(client.sync, "apply_remote_changes", lambda *a, **k: applied.append(k["new_cursor"]))
+    monkeypatch.setattr(client, "pending_task_fields", lambda conn: {})
+    monkeypatch.setattr(client, "IMPORT_ORDER", ["tasks"])
+    conn = SimpleNamespace(execute=lambda *a: None)
+
+    def round_loop(keep_running, interval, runstate):
+        if snapshot:
+            client.resync(conn, Hub(), "default", observers=False)
+        else:
+            client.pull(conn, Hub(), "default", observers=False)
+
+    monkeypatch.setattr(client, "_run_forever", round_loop)
+
+    from gateway.kanban_watchers import GatewayKanbanWatchersMixin
+    from tests.waiting import async_wait_until
+    runner = GatewayKanbanWatchersMixin()
+    runner._running = True
+    lease = SimpleNamespace(try_acquire=lambda: True, should_yield=lambda: False, release=lambda: None)
+    monkeypatch.setattr(runner, "_kanban_singleton_lease", lambda *a: lease)
+    monkeypatch.setattr(client.sync, "sync_enabled", lambda: True)
+
+    async def gateway():
+        task = asyncio.create_task(runner._kanban_sync_watcher())
+        try:
+            await async_wait_until(entered.is_set, timeout=5)
+        finally:
+            runner._running = False
+            stopped.set()
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+
+    start = time.monotonic()
+    asyncio.run(gateway())  # includes the default executor's join, not just task cancellation
+    assert time.monotonic() - start < 5  # well inside hermes update's 30s wait
+    assert len(pages) == 1, "shutdown must stop bootstrap before requesting another page"
+    assert applied == [], "do not start applying a fetched page after shutdown"
