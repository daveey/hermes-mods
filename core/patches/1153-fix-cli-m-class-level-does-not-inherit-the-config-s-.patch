From 50d70df06d204d5e6abf88cf69ab94f5abc87662 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 06:50:08 +0000
Subject: [PATCH 1153/1157] fix(cli): -m class:<level> does not inherit the
 config's concrete provider [daveey]

`hermes chat -m class:standard` on a profile with model.provider: anthropic kept anthropic as
requested_provider under the class, and class routing refused it before sending ("Class selectors
require provider auto; use a concrete model to pin a provider"). The config provider belongs to the
config's concrete model; under a class only an explicit --provider counts, else auto.

Tests: tests/hermes_cli/test_cli_provider_resolution.py (RED before, 4 new pass).
---
 hermes_cli/cli_init_mixin.py                  |  5 +++++
 .../test_cli_provider_resolution.py           | 22 +++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/hermes_cli/cli_init_mixin.py b/hermes_cli/cli_init_mixin.py
index b650a23356a..f65680bff91 100644
--- a/hermes_cli/cli_init_mixin.py
+++ b/hermes_cli/cli_init_mixin.py
@@ -255,6 +255,11 @@ class CLIInitMixin:
             _moa_provider_override or provider or _startup_provider_override or _nested_provider
             or _cfg_provider or "auto"
         )
+        if not provider and is_class_selector(self.model):
+            # [daveey] A class routes by policy and requires provider auto (agent/model_routing). The
+            # config's provider belongs to the config's concrete model: inheriting it under `-m class:X`
+            # failed every run before sending ("Class selectors require provider auto").
+            self.requested_provider = "auto"
         # Only a provider the command line chose is gateway launch policy: the config default is the
         # gateway's to resolve, and a resume compares launch policy against the session's frozen route.
         self._explicit_provider = _moa_provider_override or provider or _startup_provider_override or None
diff --git a/tests/hermes_cli/test_cli_provider_resolution.py b/tests/hermes_cli/test_cli_provider_resolution.py
index 44e179f334b..05f1f24547a 100644
--- a/tests/hermes_cli/test_cli_provider_resolution.py
+++ b/tests/hermes_cli/test_cli_provider_resolution.py
@@ -153,6 +153,28 @@ def test_provider_flag_uses_named_custom_default_model(monkeypatch):
     assert shell.requested_provider == "gmk-lan"
 
 
+@pytest.mark.parametrize("flag_provider, expected", [(None, "auto"), ("auto", "auto"), ("anthropic", "anthropic")])
+def test_class_model_flag_does_not_inherit_the_config_provider(monkeypatch, flag_provider, expected):
+    """[daveey] `hermes chat -m class:standard` on a profile whose model.provider is concrete (anthropic) froze
+    that provider under the class, and every run failed before sending: "Class selectors require provider
+    auto". The config's provider belongs to the config's concrete model; a class routes by policy, so only
+    an explicit --provider counts (and an explicit concrete one is still refused downstream, by name)."""
+    cli = _import_cli()
+    monkeypatch.setitem(cli.CLI_CONFIG, "model", {"default": "claude-opus-5-5", "provider": "anthropic"})
+    monkeypatch.setenv("HERMES_INFERENCE_PROVIDER", "anthropic")
+    shell = cli.HermesCLI(model="class:standard", provider=flag_provider, compact=True, max_turns=1)
+    assert shell.model == "class:standard"
+    assert shell.requested_provider == expected
+
+
+def test_concrete_model_flag_keeps_the_config_provider(monkeypatch):
+    """Control: a concrete -m still runs on the profile's provider."""
+    cli = _import_cli()
+    monkeypatch.setitem(cli.CLI_CONFIG, "model", {"default": "claude-opus-5-5", "provider": "anthropic"})
+    shell = cli.HermesCLI(model="claude-sonnet-5-5", compact=True, max_turns=1)
+    assert shell.requested_provider == "anthropic"
+
+
 def test_explicit_model_wins_over_provider_default_model(monkeypatch):
     """`-m` still wins when `--provider` also names a custom default_model."""
     cli = _import_cli()
