From 806283b0b6b84e85425f54ec3a86ce38d5b0a023 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:46:17 +0000
Subject: [PATCH] [daveey] hub-read paths: an opening quote must close at the
 path; a standalone .. keeps every path

Review 5892779312: cat "~/.hermes/logs/a b/../../.env" cleared for a declared
hub:read card because whitespace after the path counted as the word end while the
quote was still open. Require the same quote right after the path. Also keep every
path when the text holds a standalone '..' segment (cd ~/.hermes/logs && cat ../.env).
---
 hermes_cli/kanban_placement_coordination.py    | 13 ++++++++++++-
 tests/hermes_cli/test_kanban_hub_read_roots.py |  8 ++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index e5bd91d21a..70de987c33 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -121,7 +121,11 @@ def _ends_word(text, start, end) -> bool:
     if q and start >= 2 and not text[start - 2].isspace():
         q = ""
     i = end
-    if q and text.startswith(q, i):
+    if q:
+        # An opening quote must close right here: whitespace inside the quoted word (``"~/.hermes/logs/a b/../.env"``)
+        # is part of the path, so a later close may hide a ``..`` (review 5892779312).
+        if not text.startswith(q, i):
+            return False
         i += 1
     if text.startswith(")", i):
         i += 1
@@ -167,7 +171,14 @@ def without_read_paths(text, cfg, *, target=None, requires=None):
     return _strip_read_paths(text, roots)
 
 
+# A standalone ``..`` path segment anywhere (``cd ~/.hermes/logs && cat ../.env``) can walk out of a root that
+# per-token stripping already cleared, so such text keeps every path (review 5892779312).
+_DOTDOT = re.compile(r"(?<![\w.~-])\.\.(?![\w.~-])")
+
+
 def _strip_read_paths(text, roots):
+    if _DOTDOT.search(text):
+        return text
     # Keep a separator so surrounding backtick runs cannot merge and hide later markers.
     return _STATE_PATH.sub(
         lambda m: " " if _ends_word(text, m.start(), m.end()) and _under_roots(m.group(1), roots) else m.group(0),
diff --git a/tests/hermes_cli/test_kanban_hub_read_roots.py b/tests/hermes_cli/test_kanban_hub_read_roots.py
index d90c8a34a6..03d06d62dd 100644
--- a/tests/hermes_cli/test_kanban_hub_read_roots.py
+++ b/tests/hermes_cli/test_kanban_hub_read_roots.py
@@ -123,6 +123,14 @@ def test_malformed_roots_clear_nothing(attested, roots):
     # glued to the path hides its ``..`` (both resolve to ~/.hermes/.env).
     "chmod -R 777 ~/.hermes/logs/`x`/../.env",
     "chmod -R 777 ~/.hermes/logs/`echo ..`/.env",
+    # An opening quote must close right after the path: whitespace inside the quoted word is part of it
+    # (review 5892779312).
+    'cat "~/.hermes/logs/a b/../../.env"',
+    "cat '~/.hermes/logs/a b/../../.env'",
+    'cat "/home/ubuntu/.hermes/logs/a b/../../.env"',
+    # A relative ``..`` after a cd into a root walks out of it (review 5892779312 nit).
+    "cd ~/.hermes/logs && cat ../.env",
+    "cd ~/.hermes/logs; chmod -R 777 ../state",
 ])
 def test_controls_still_pin(attested, body):
     cfg, _, _ = attested
-- 
