From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:12:05 +0000
Subject: [PATCH] [daveey] Pin placement nesting-bound plain-text fallback

Add a three-level local control and four-level portable boundary case for the documented bounded nesting scanner. Test-only coverage gap from #2735; production behavior is unchanged.

Proof: focused production 1 passed; exact _NEST_DEPTH 3 -> 4 mutant fails with AssertionError (0 skips); restored placement suites 336 passed. No timeout counted as a kill.
---
 .../test_kanban_placement_home_spellings.py           | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_placement_home_spellings.py b/tests/hermes_cli/test_kanban_placement_home_spellings.py
index 3c2400ffa8..bec3d5c4d7 100644
--- a/tests/hermes_cli/test_kanban_placement_home_spellings.py
+++ b/tests/hermes_cli/test_kanban_placement_home_spellings.py
@@ -179,6 +179,17 @@ def test_the_raw_pattern_reads_backtick_substitution(body):
     assert re.search(kp.HERMES_STATE_PATH, body, re.IGNORECASE)
 
 
+def test_beyond_depth_bound_preserves_plain_text_fallback():
+    """Beyond three balanced levels, chained cd resumes plain-text span termination (#2735)."""
+    within_bound = "Run pytest, then cd ~ && (echo x && cd repo && ((pwd))) && cat .hermes/.env"
+    beyond_bound = "Run pytest, then cd ~ && (echo x && cd repo && (((pwd)))) && cat .hermes/.env"
+
+    local = helpers._hub({"title": "Maintenance", "body": within_bound})
+    assert local["where"] == "local" and "runs_on" not in local, local
+    portable = helpers._hub({"title": "Maintenance", "body": beyond_bound})
+    assert portable.get("runs_on") == ["machine:worker-1"], portable
+
+
 @pytest.mark.parametrize("unit", [
     "(cd ~) x=$(cd a && (cd b) && `cd c`) step {i} padded out to a realistic length ",
     "cd ~ && (( ( ( x=` step {i} padded out to a realistic length\n",
