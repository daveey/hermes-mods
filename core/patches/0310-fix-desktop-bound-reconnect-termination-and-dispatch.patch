From ee532bdf523ef2ed40ddc701185188aac535dbd0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:22:49 +0000
Subject: [PATCH] fix(desktop): bound reconnect termination and dispatch fences
 [daveey]

---
diff --git a/apps/desktop/electron/registry-reconnect-service.test.ts b/apps/desktop/electron/registry-reconnect-service.test.ts
index 1dcdfa61be554401397c2947ca0e568257097b96..40aed6d9e48b7cc82432e4b765ec0ca45999dc8d 100644
--- a/apps/desktop/electron/registry-reconnect-service.test.ts
+++ b/apps/desktop/electron/registry-reconnect-service.test.ts
@@ -61,6 +61,10 @@ test('a second profile cannot borrow a pending reconnect claim', async () => {
   await vi.waitFor(() => expect(f.terminate).toHaveBeenCalledOnce())
   expect(await f.service.run(second)).toEqual({ ok: false })
   expect(() => f.gate.assertCanDial('hub')).toThrow()
+  expect(() => f.service.assertCanDispatch('hub', 'other')).not.toThrow()
+  expect(() => f.service.assertCanDispatch('hub', 'default')).toThrow()
+  expect(() => f.service.assertCanStop('conn:hub::other')).not.toThrow()
+  expect(() => f.service.assertCanStop('conn:hub::default')).toThrow()
   finish()
   await running
 })
@@ -85,10 +89,10 @@ test('busy backend releases the connection gate without tearing down its transpo
   expect(f.gate.owner('hub')).toBeNull()
 })
 
-test('unsupported termination platform is refused before retirement', async () => {
+test.each(['Darwin', 'Windows'])('unsupported termination platform %s is refused before retirement', async platform => {
   const f = fixture()
   const target = f.service.target('hub', 'default')!
-  f.state.remotePlatform = 'Darwin'
+  f.state.remotePlatform = platform
   expect(await f.service.run(target)).toEqual({ ok: false })
   expect(f.request).not.toHaveBeenCalled()
   expect(f.terminate).not.toHaveBeenCalled()
diff --git a/apps/desktop/electron/registry-reconnect-service.ts b/apps/desktop/electron/registry-reconnect-service.ts
index fc1abfd8e5c05526d64ee8c7c29a796d05ad03f6..6eaa7bcd5fbece1d66e51b050ab7bf8a4e4d1595 100644
--- a/apps/desktop/electron/registry-reconnect-service.ts
+++ b/apps/desktop/electron/registry-reconnect-service.ts
@@ -40,9 +40,10 @@ export function createRegistryReconnectService<D, E extends PoolEntry<D>, S exte
     const entry = deps.pool.get(key)
     const state = deps.states.get(key)
 
-    // POSIX owned termination deliberately refuses Darwin (no pidfd).
-    // Refuse here, before committing an irreversible backend admission fence.
-    if (!state || !['Linux', 'Windows'].includes(state.remotePlatform)) { return undefined }
+    // Only Linux has runtime-independent, identity-bound termination today.
+    // Windows uses the possibly deleted managed Python; Darwin lacks pidfd.
+    // Refuse before committing an irreversible backend admission fence.
+    if (!state || state.remotePlatform !== 'Linux') { return undefined }
 
     if (!deps.isSsh(connectionId) || !entry || !state || state.primaryRegistryScope ||
         state.registryConnectionId !== connectionId || !state.spawnNonce || deps.inFlight(key)) {
@@ -102,16 +103,18 @@ export function createRegistryReconnectService<D, E extends PoolEntry<D>, S exte
 
       return resident ? { connectionId, profile, generation: resident.generation } : null
     },
+    assertCanDispatch: (connectionId: string, profile: string, correlation = '') => {
+      // Our connection-wide claim protects configuration and new publication,
+      // not dispatch to already resident, unrelated profiles (including primary).
+      const held = correlations.get(connectionId)
+
+      if (held && deps.gate.owner(connectionId) === held && claimedProfiles.get(connectionId) !== profile) { return }
+      deps.gate.assertCanDial(connectionId, correlation)
+    },
     assertCanStop: (key: string) => {
-      const entry = deps.pool.get(key)
-      const resident = entry && residents.get(entry)
-
-      if (resident) {
-        // The key is opaque; retain the exact route instead of parsing ids.
-        for (const [connectionId] of correlations) {
-          if (resident.state.registryConnectionId === connectionId) {
-            throw new Error('Registry backend reconnect in progress')
-          }
+      for (const [connectionId, profile] of claimedProfiles) {
+        if (deps.key(connectionId, profile) === key) {
+          throw new Error('Registry backend reconnect in progress')
         }
       }
     },
-- 
