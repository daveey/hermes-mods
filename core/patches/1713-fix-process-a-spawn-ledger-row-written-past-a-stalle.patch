+        logger.warning("spawn ledger lock held by a stalled writer; rows are queued in %s until it lets go",
+                       _pending_dir(path))
+    logger.debug("spawn ledger lock stalled", exc_info=True)
+    return _queue_pending(path, entry)
 
 
