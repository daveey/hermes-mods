From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 07:31:33 +0000
Subject: [PATCH] [daveey] Guard candidate receipt reader board connection

---
 hermes_cli/kanban_candidate_receipts.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_candidate_receipts.py b/hermes_cli/kanban_candidate_receipts.py
index 657b9ce9e0..a6f8e89ef3 100644
--- a/hermes_cli/kanban_candidate_receipts.py
+++ b/hermes_cli/kanban_candidate_receipts.py
@@ -219,12 +219,13 @@ def main():
     import argparse
     import json
     from pathlib import Path
+    from hermes_cli.kanban_lockguard import connect
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument('--db', required=True)
     parser.add_argument('--task-id')
     parser.add_argument('--limit', type=int, default=1000)
     args = parser.parse_args()
-    conn = sqlite3.connect(Path(args.db).expanduser().resolve().as_uri() + '?mode=ro', uri=True)
+    conn = connect(Path(args.db).expanduser().resolve().as_uri() + '?mode=ro', uri=True)
     try:
         print(json.dumps(read(conn, task_id=args.task_id, limit=args.limit), sort_keys=True))
     finally:
