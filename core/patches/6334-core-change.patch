From 4e1cbbb8fcbd6ced89fc199c309086c4efffa7dd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 04:57:13 +0000
Subject: [PATCH 6334] Semantic annotation parts and fail-fresh caching

Public mirror of source commit 4e1cbbb8fcbd6ced89fc199c309086c4efffa7dd.

---
diff --git a/hermes_cli/kanban_annotation_done_inputs.py b/hermes_cli/kanban_annotation_done_inputs.py
index c476cb65ef3..32e5018807d 100644
--- a/hermes_cli/kanban_annotation_done_inputs.py
+++ b/hermes_cli/kanban_annotation_done_inputs.py
@@ -11,6 +11,7 @@
 
 from __future__ import annotations
 
+import json
 import logging
 import math
 from typing import Any
@@ -82,4 +83,10 @@
     """Comparable key when every check is explicitly declared and portable, else a fresh unequal object."""
     values, complete = inputs(dict(checks))
     # Code identity alone does not distinguish two closures from the same source: keep the fn objects too.
-    return (tuple(sorted(checks.items(), key=lambda kv: kv[0])), values) if complete else object()
+    # JSON spelling preserves bool/int/float (including signed zero) distinctions
+    # that Python container equality erases; sort object keys for stable snapshots.
+    try:
+        data = json.dumps(values, sort_keys=True, ensure_ascii=True, allow_nan=False) if complete else None
+    except (ValueError, TypeError, RecursionError, OverflowError):
+        return object()
+    return (tuple(sorted(checks.items(), key=lambda kv: kv[0])), data) if complete else object()
diff --git a/tests/hermes_cli/test_kanban_annotation_done_inputs.py b/tests/hermes_cli/test_kanban_annotation_done_inputs.py
index cae13fa0004..ad876d17021 100644
--- a/tests/hermes_cli/test_kanban_annotation_done_inputs.py
+++ b/tests/hermes_cli/test_kanban_annotation_done_inputs.py
@@ -127,6 +127,30 @@
         d()
 
 
+@pytest.mark.parametrize('before,after', [(True, 1), (False, 0), (1, 1.0), (0.0, -0.0)])
+def test_key_preserves_scalar_types(before, after):
+    box = [before]
+    d = ksa.register_done_check('c', _check, inputs=lambda: {'nested': [box[0]]})
+    try:
+        old = di.key(dict(ksa._done_checks))
+        box[0] = after
+        assert di.key(dict(ksa._done_checks)) != old
+    finally:
+        d()
+
+
+def test_serialization_failure_forces_fresh_key(monkeypatch):
+    d = ksa.register_done_check('c', _check, inputs=list)
+    try:
+        # Exercise the actual serialization failure class, not provider failure.
+        def fail(*args, **kwargs):
+            raise ValueError('cannot encode')
+        monkeypatch.setattr(di.json, 'dumps', fail)
+        assert di.key(dict(ksa._done_checks)) != di.key(dict(ksa._done_checks))
+    finally:
+        d()
+
+
 def test_closure_identity_distinguishes_same_code():
     def make():
         return lambda card: False
diff --git a/tests/hermes_cli/test_kanban_annotation_semantic_parts.py b/tests/hermes_cli/test_kanban_annotation_semantic_parts.py
index f7a42fb90dc..4b491473d77 100644
--- a/tests/hermes_cli/test_kanban_annotation_semantic_parts.py
+++ b/tests/hermes_cli/test_kanban_annotation_semantic_parts.py
@@ -77,6 +77,31 @@
         dispose()
 
 
+@pytest.mark.parametrize('before,after', [(True, 1), (False, 0), (1, 1.0)],
+                         ids=['bool-int-true', 'bool-int-false', 'int-float'])
+def test_done_inputs_scalar_types_refresh_real_holder(world, before, after):
+    box = [before]
+
+    def check(card):
+        world.checks += 1
+        return type(box[0]) is type(before)
+
+    dispose = ksa.register_done_check('fixture', check,
+        watch_paths=lambda: [world.declared], next_deadline=lambda: None,
+        inputs=lambda: {'nested': [box[0]]})
+    try:
+        helpers._refresh()
+        assert helpers._published()[10] == {'s1': 1}
+        reads = world.checks
+        box[0] = after
+        world.declared.write_text('changed type')
+        helpers._refresh()
+        assert world.checks > reads
+        assert helpers._published()[10] == {}
+    finally:
+        dispose()
+
+
 def test_missing_revision_forces_fresh_read(world):
     _install(world)
     helpers._refresh()
