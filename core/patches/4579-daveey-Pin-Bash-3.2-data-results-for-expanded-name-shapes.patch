From c0552f3ecd564b9c206ce54812585948e2295eb1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 20:36:43 +0000
Subject: [PATCH] [daveey] Pin Bash 3.2 data results for expanded-name shapes

Review t_e4eddda57f7d5ccb (PR #3253 @4fbec4a0d7) reproduced 13 failures
with a real GNU Bash 3.2.0 first on PATH: the new expanded printf -v,
test -v, [[ -v ]], declare -n, indirect ^/^^/,/,,/@Q and scalar or
declare -A unset shapes stop before evaluating their subscript on 3.2.
Record each one's exit status and diagnostic in BASH_DATA, keeping the
unconditional lifecycle-refusal and clean-twin scanner assertions.

Verified with real interpreters built from GNU tarballs: Bash 3.2.0,
5.2.21 (system) and 5.3.0 each pass all 108 focused tests.
---
 tests/cron/test_lifecycle_guard_name_indirection.py | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_name_indirection.py b/tests/cron/test_lifecycle_guard_name_indirection.py
index 04c18b7d445051ed2468691c7d0a8c8fe409b7fc..037cba55bf79b711da4c646e1879d91b9535bf67 100644
--- a/tests/cron/test_lifecycle_guard_name_indirection.py
+++ b/tests/cron/test_lifecycle_guard_name_indirection.py
@@ -69,7 +69,8 @@ SHAPES = [
 # Bash versions that stop a shape before evaluating its subscript, as (exit status, stderr
 # fragment). These remain scanner sinks: the guard must conservatively cover every Bash even when
 # the local shell treats a shape as data. Bash 3.2 (macOS /bin/bash) has no `test -v`/`[[ -v ]]`
-# and rejects subscripted `printf -v` names; Bash 5.3 no longer runs a substitution found in an
+# and rejects subscripted `printf -v` names, namerefs, associative arrays, case/@Q indirect
+# operators and subscripted `unset` of a scalar; Bash 5.3 no longer runs a substitution found in an
 # `unset` subscript.
 BASH_DATA = {
     "3.2": {
@@ -87,6 +88,16 @@ BASH_DATA = {
         "x='a[$(SCRIPT)]'; printf -v 'a[x]' 1": (2, "not a valid identifier"),
         "x='a[$(SCRIPT)]'; builtin test -v 'a[x]'": (2, "-v: unary operator expected"),
         "x='a[$(SCRIPT)]'; command printf -v 'a[x]' 1": (2, "not a valid identifier"),
+        r'x="a[\$(SCRIPT)]"; printf -v "$x" 1': (2, "not a valid identifier"),
+        r'x="a[\$(SCRIPT)]"; test -v "$x"': (2, "-v: unary operator expected"),
+        r'x="a[\$(SCRIPT)]"; [[ -v $x ]]': (2, "conditional binary operator expected"),
+        r'x="a[\$(SCRIPT)]"; declare -n r="$x"; echo $r': (0, "-n: invalid option"),
+        **{f"x='a[$(SCRIPT)]'; echo ${{!x{operator}}}": (1, "bad substitution")
+           for operator in ('^', '^^', ',', ',,', '@Q')},
+        **{f"x='a[$(SCRIPT)]'; a=1; {unset} \"$x\"": (1, "not an array variable")
+           for unset in ('unset', 'unset -v')},
+        **{f"x='a[$(SCRIPT)]'; declare -A a; {unset} \"$x\"": (0, "-A: invalid option")
+           for unset in ('unset', 'unset -v')},
     },
     "5.3": {
         r"declare -a a=([0]=1); unset a[\$\(SCRIPT\)]": (1, "arithmetic syntax error"),
-- 
