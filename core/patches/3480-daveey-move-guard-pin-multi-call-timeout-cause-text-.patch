From 761a2a023d69ad5aae422e05880bf264392a23ba Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:38:28 +0000
Subject: [PATCH] [daveey] move guard: pin multi-call timeout cause text; repin
 Limitations doc line (PR #2111 review nits)

Follow-up to PR #2111's review (5889959817), card t_01a1d49da268115f.

1. tree_state's found() read a check as timed out when the WHOLE check's
   elapsed time reached the timeout of ONE git call, so a slow tree with real
   unpushed commits whose 2-3 git calls each finished in time read
   "unchecked worktree ... (git timed out)" instead of "unpushed commits in".
   e9d537b75a (PR #2126) since replaced that comparison: a budgeted check now
   raises GitUnchecked on a git timeout (the hidden-index read included), so
   this commit's earlier `timeouts` list was dropped in the rebase and only its
   tests remain, ported to the `budget=` API. They pin the cause text:
   slow-but-successful multi-call check -> "unpushed commits in"; a git
   timeout in the unpushed check or the dirty check's hidden-index read ->
   "unchecked worktree ... (git timed out"; unbudgeted callers still fail
   safe toward True.
2. kanban_move module docstring Limitations: a worker-first repin to [] or
   [pool:worker] whose origin is an active, unheld registry machine carrying
   those labels skips the unpushed guard, as check() would.

Proof: tests/hermes_cli/test_kanban_move_guard_timeout_cause.py (4 tests)
passes on current main, together with test_kanban_move_guard_budget.py,
test_kanban_move_guard_review_nits.py and test_kanban_move_unpushed.py. On
the pre-#2126 base the first test was RED (read "unchecked").
---
 hermes_cli/kanban_move.py                     |  4 +-
 .../test_kanban_move_guard_timeout_cause.py   | 93 +++++++++++++++++++
 2 files changed, 96 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_move_guard_timeout_cause.py

diff --git a/hermes_cli/kanban_move.py b/hermes_cli/kanban_move.py
index 1cbc2f2690..81cedc63f4 100644
--- a/hermes_cli/kanban_move.py
+++ b/hermes_cli/kanban_move.py
@@ -34,7 +34,9 @@ Guards:
   (:func:`leaves_here`, matches from the registry). Limitations: only the host
   holding the trees can see them, so a move issued from another host is blind to them; and a move whose matches
   still include this host (``pool:worker`` issued on a pool worker, ``linux``) is not "leaving" and is not
-  guarded, though another matching host may claim the card (intentional: this host may still run it).
+  guarded, though another matching host may claim the card (intentional: this host may still run it). The same
+  holds for a worker-first repin to ``[]`` or ``[pool:worker]`` whose origin is an active, unheld registry machine
+  carrying those labels (:func:`_repin_leaves`): it skips the unpushed guard, as :func:`check` would.
 
 Every move is a ``moved`` event ``{from_machine, runs_on, previous_runs_on, reason, move_no, forced}``: the audit log.
 """
diff --git a/tests/hermes_cli/test_kanban_move_guard_timeout_cause.py b/tests/hermes_cli/test_kanban_move_guard_timeout_cause.py
new file mode 100644
index 0000000000..1f52fd767e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_move_guard_timeout_cause.py
@@ -0,0 +1,93 @@
+"""Move-guard cause text from PR #2111's review (5889959817, card t_01a1d49da268115f). [daveey]
+
+``tree_state`` read a check as timed out when the WHOLE check took at least the timeout of ONE git call. The
+unpushed check makes 2-3 git calls, so a slow tree whose calls each finished in time read ``unchecked (git timed
+out)`` instead of ``unpushed commits in``. Since e9d537b75a the checks report a git timeout explicitly (a budgeted
+check raises ``GitUnchecked``); these tests pin that cause text for the multi-call cases.
+"""
+from __future__ import annotations
+
+import subprocess
+
+import pytest
+
+from hermes_cli import kanban_move_pool as kmp
+from hermes_cli import worktree_ops
+from hermes_cli.git_budget import GitUnchecked, deadline_budget
+from tests.hermes_cli.test_kanban_move_unpushed import _commit, _worktree
+
+_UNPUSHED_CALLS = (["for-each-ref", "--format=%(refname)", "refs/remotes"], ["log"])
+
+
+def _is_unpushed_check_call(args) -> bool:
+    return list(args) == _UNPUSHED_CALLS[0] or args[0] == "log"
+
+
+def _fake_clock(monkeypatch):
+    now = [0.0]
+    monkeypatch.setattr(kmp, "_clock", lambda: now[0])
+    return now
+
+
+def test_a_slow_multi_call_check_that_never_times_out_keeps_its_unpushed_cause(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "slow-unpushed")
+    _commit(tree, "b.txt")
+    now, real = _fake_clock(monkeypatch), worktree_ops._git_out
+    seen: list[tuple[float, float]] = []
+
+    def slow(args, cwd, timeout=10, **kwargs):
+        if _is_unpushed_check_call(args):
+            step = timeout * 0.6  # each call ends well inside its own timeout; together they pass one timeout
+            seen.append((step, timeout))
+            now[0] += step
+        return real(args, cwd, timeout=timeout, **kwargs)
+
+    monkeypatch.setattr(worktree_ops, "_git_out", slow)
+    assert kmp.tree_state([str(tree)]) == f"unpushed commits in {tree}"
+    first = seen[:2]  # the unpushed check's own two calls (pushed_on_remote makes neither)
+    assert len(first) == 2 and sum(s for s, _ in first) >= first[0][1]  # the old whole-check comparison tripped
+
+
+def test_a_git_timeout_in_the_unpushed_check_reads_unchecked_however_fast(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "unpushed-timeout")
+    _commit(tree, "b.txt")
+    _fake_clock(monkeypatch)  # the clock never moves: only the explicit report says it timed out
+    real = worktree_ops._git_out
+
+    def timing_out(args, cwd, timeout=10, **kwargs):
+        if args[0] == "log":
+            raise subprocess.TimeoutExpired(["git", *args], timeout)
+        return real(args, cwd, timeout=timeout, **kwargs)
+
+    monkeypatch.setattr(worktree_ops, "_git_out", timing_out)
+    state = kmp.tree_state([str(tree)])
+    assert state is not None and state.startswith(f"unchecked worktree {tree} (git timed out"), state
+
+
+def test_a_git_timeout_in_the_dirty_checks_hidden_index_read_reads_unchecked(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "hidden-timeout")
+    _fake_clock(monkeypatch)
+    from hermes_cli import worktree_retention
+
+    def timing_out(_path, *args, **kwargs):
+        raise subprocess.TimeoutExpired(["git", "ls-files"], 60)
+
+    monkeypatch.setattr(worktree_retention, "hidden_index_edits", timing_out)
+    state = kmp.tree_state([str(tree)])
+    assert state is not None and state.startswith(f"unchecked worktree {tree} (git timed out"), state
+
+
+def test_the_checks_report_timeouts_only_to_a_budgeted_caller(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "report")
+
+    def timing_out(args, cwd, timeout=10, **kwargs):
+        raise subprocess.TimeoutExpired(["git", *args], timeout)
+
+    monkeypatch.setattr(worktree_ops, "_git_out", timing_out)
+    monkeypatch.setattr(worktree_ops, "_git", timing_out)
+    assert worktree_ops._worktree_has_unpushed_commits(str(tree)) is True  # fail safe, unchanged
+    assert worktree_ops._worktree_is_dirty(str(tree), str(tree)) is True
+    with pytest.raises(GitUnchecked, match="git timed out"):
+        worktree_ops._worktree_has_unpushed_commits(str(tree), budget=deadline_budget(60))
+    with pytest.raises(GitUnchecked, match="git timed out"):
+        worktree_ops._worktree_is_dirty(str(tree), str(tree), budget=deadline_budget(60))
