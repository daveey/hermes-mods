+
+
+def test_cross_gateway_owner_gets_the_comment_and_it_is_read_back(env, capsys):
+    key = "default/hermes/t_remote"
+    env.remote("macbook", key, "ready", f"Deflake {TEST}", f"Flaky test: `{TEST}`")
