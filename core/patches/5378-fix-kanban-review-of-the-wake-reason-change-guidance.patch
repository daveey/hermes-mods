+    from hermes_cli.kanban_goal_recovery import goal_block_kwargs
+    assert goal_block_kwargs('missing prerequisite') == {}
+    assert goal_block_kwargs(TIMED) == {'awaiting': goal_awaiting(TIMED), 'clock_only': True}
