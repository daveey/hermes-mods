From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:41:49 +0000
Subject: [PATCH] test(kanban): prove trial routing refusal and configured
 class allocation [daveey]

---
 tests/hermes_cli/test_welcome_trial.py | 43 +++++++++++++++++++++++---
 1 file changed, 38 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_welcome_trial.py b/tests/hermes_cli/test_welcome_trial.py
index b3c3ba5fee..8348f83787 100644
--- a/tests/hermes_cli/test_welcome_trial.py
+++ b/tests/hermes_cli/test_welcome_trial.py
@@ -308,7 +308,7 @@ def _cron_model() -> str:
     return _load_cron_job_config({"id": "j", "name": "j", "prompt": "x"}, "j", "j").model
 
 
-def _kanban_worker_model(monkeypatch, tmp_path) -> str:
+def _kanban_worker_policy(monkeypatch, tmp_path):
     from dataclasses import asdict
     from types import SimpleNamespace
     from contextlib import closing
@@ -340,7 +340,12 @@ def _kanban_worker_model(monkeypatch, tmp_path) -> str:
                                  actor=SessionActor("owner", home, frozenset({"session:create"}), "transport"))
     params = dict(board="trial", task_id=task.id, run_id=task.current_run_id, claim_lock=task.claim_lock)
     policy, _ = build_kanban_policy(connection, params, load_config())
-    return restore_policy(asdict(policy)).model
+    with closing(connect(board="trial")) as conn:
+        stored = kb.get_task(conn, task_id)
+        assert (stored.model_override, stored.provider_override) == (None, None)
+    frozen = restore_policy(asdict(policy))
+    assert (frozen.model, frozen.provider) == ('class:standard', 'auto')
+    return frozen
 
 
 @pytest.fixture
@@ -359,8 +364,15 @@ def test_a_claimed_trial_runs_a_default_cron_job_when_no_model_is_configured(unc
     assert _cron_model() == anon_auth.GUEST_MODEL
 
 
-def test_a_claimed_trial_runs_a_kanban_worker_when_no_model_is_configured(unconfigured_trial, monkeypatch, tmp_path):
-    assert _kanban_worker_model(monkeypatch, tmp_path) == anon_auth.GUEST_MODEL
+def test_a_trial_does_not_bypass_missing_kanban_class_registry(unconfigured_trial, monkeypatch, tmp_path):
+    import json
+    from agent.model_routing import ModelRoutingError
+    from agent.model_routing_runtime import resolve_class_runtime
+
+    policy = _kanban_worker_policy(monkeypatch, tmp_path)
+    with pytest.raises(ModelRoutingError, match='disabled|enabled'):
+        resolve_class_runtime(policy.model, policy.provider, config=json.loads(policy.config_json),
+                              session_id='unconfigured-trial-worker')
 
 
 def test_a_configured_model_beats_the_trial_for_cron_jobs_and_kanban_workers(portal, monkeypatch, tmp_path):
@@ -373,4 +385,25 @@ def test_a_configured_model_beats_the_trial_for_cron_jobs_and_kanban_workers(por
         "model:\n  provider: openrouter\n  default: anthropic/claude-sonnet-4\n", encoding="utf-8")
 
     assert _cron_model() == "anthropic/claude-sonnet-4"
-    assert _kanban_worker_model(monkeypatch, tmp_path) == "anthropic/claude-sonnet-4"
+    # Concrete interactive/cron defaults never become Kanban restrictions.
+    # Supply a real isolated class registry and dummy native OAuth pool, not an eligibility mock.
+    import json
+    from agent.model_routing_runtime import resolve_class_runtime
+    from hermes_cli.auth import _load_auth_store, _save_auth_store
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+
+    config_path = get_hermes_home() / 'config.yaml'
+    config_path.write_text(config_path.read_text() + _managed_yaml())
+    store = _load_auth_store()
+    store.setdefault('credential_pool', {})['anthropic'] = [{
+        'id': 'trial-test-subscription', 'label': 'disposable test OAuth', 'priority': 0,
+        'auth_type': 'oauth', 'source': 'manual', 'access_token': 'sk-ant-oat01-fixture-not-live'}]
+    _save_auth_store(store)
+    policy = _kanban_worker_policy(monkeypatch, tmp_path)
+    runtime = resolve_class_runtime(policy.model, policy.provider, config=json.loads(policy.config_json),
+                                    session_id='configured-trial-worker')
+    assert (runtime['provider'], runtime['model']) == ('anthropic', 'claude-sonnet-5-5')
+    assert runtime['model_routing']['requested_class'] == 'standard'
+    assert not runtime['model_routing'].get('exact_pin')
+    assert runtime['credential_pool'].current().id == 'trial-test-subscription'
+    assert _cron_model() == 'anthropic/claude-sonnet-4'
