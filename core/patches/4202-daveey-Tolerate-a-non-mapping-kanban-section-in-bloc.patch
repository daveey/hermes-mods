From c04ebc860ba13e24eb8d6579d4964a8636f65d0c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 09:22:54 +0000
Subject: [PATCH] [daveey] Tolerate a non-mapping kanban section in blocker
 input identity

CI (PR #2974, shard 7/8) failed test_non_mapping_kanban_section_skips_all_cards:
_key() read the live config's shared_blocker_aliases with
(cfg.get('kanban') or {}).get(...), which raises AttributeError when the
kanban section parses to a str/list/int. Before this PR the derivation only
read aliases inside normalize_blocker_id for rows carrying a blocker_id, so
a quiet board with broken config never hit it; the identity read now runs
for every validated input read.

_aliases() now returns {} for a non-mapping section (the dispatcher already
fails closed on that config via the dispatch allowlist).

RED: new test_non_mapping_kanban_section_does_not_crash_derivation and the 3
allowlist parametrizations fail without the fix; GREEN with it.
---
 hermes_cli/kanban_blocker_inputs.py                  | 5 ++++-
 tests/hermes_cli/test_kanban_blocker_input_config.py | 9 +++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_blocker_inputs.py b/hermes_cli/kanban_blocker_inputs.py
index 05500689de..60e8654397 100644
--- a/hermes_cli/kanban_blocker_inputs.py
+++ b/hermes_cli/kanban_blocker_inputs.py
@@ -78,7 +78,10 @@ def _drop_memos(scope):
 
 
 def _aliases(cfg):
-    return (cfg.get('kanban') or {}).get('shared_blocker_aliases', {})
+    # A non-mapping ``kanban`` section is a config error the dispatcher already
+    # fails closed on (dispatch allowlist); the identity read must not crash on it.
+    section = cfg.get('kanban') if isinstance(cfg, dict) else None
+    return section.get('shared_blocker_aliases', {}) if isinstance(section, dict) else {}
 
 
 def _key(conn, now):
diff --git a/tests/hermes_cli/test_kanban_blocker_input_config.py b/tests/hermes_cli/test_kanban_blocker_input_config.py
index 69c3801f47..15a02089ca 100644
--- a/tests/hermes_cli/test_kanban_blocker_input_config.py
+++ b/tests/hermes_cli/test_kanban_blocker_input_config.py
@@ -99,3 +99,12 @@ def test_unavailable_config_is_not_retained(kanban_home, monkeypatch):
         state['down'] = False
         assert blockers.normalize_blocker_id('old-wall') == 'new-wall'
     exercise()
+
+
+def test_non_mapping_kanban_section_does_not_crash_derivation(kanban_home, monkeypatch):
+    """A scalar/list ``kanban`` section is fail-closed config, not a crash in the identity read."""
+    for section in ('oops', [1, 2], 7):
+        _counting_config(monkeypatch, {'kanban': section})
+        with kbc.connect_closing() as conn:
+            assert blockers.blocker_states(conn) == {}
+        assert inputs._aliases({'kanban': section}) == {}
-- 
