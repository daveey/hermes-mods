+++ b/tools/process_registry_uptime.py
@@ -0,0 +1,12 @@
+"""Short uptime label for process listings (moved out of ``tools/process_registry.py``)."""
+
+
+def format_uptime_short(seconds: int) -> str:
+    s = max(0, int(seconds))
+    if s < 60:
+        return f"{s}s"
+    mins, secs = divmod(s, 60)
+    if mins < 60:
+        return f"{mins}m {secs}s"
+    hours, mins = divmod(mins, 60)
+    return f"{hours}h {mins}m"
