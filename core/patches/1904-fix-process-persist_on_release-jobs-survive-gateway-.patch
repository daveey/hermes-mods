diff --git a/tests/gateway/test_persist_job_survives_gateway_restart.py b/tests/gateway/test_persist_job_survives_gateway_restart.py
new file mode 100644
index 00000000000..5922dd15cba
--- /dev/null
+++ b/tests/gateway/test_persist_job_survives_gateway_restart.py
@@ -0,0 +1,176 @@
+"""A persist_on_release job a Kanban worker started outlives the worker and gateway restarts. [daveey]
+
+Hub incident (2026-11-03): paid GPU-rental watchdogs that Kanban workers started with
+``terminal(background=true, persist_on_release=true)`` died with the next gateway restart.
+The worker exited (or was requeued by a restart), the next gateway adopted the orphaned job
+from ``processes.json`` at startup, and that gateway's NEXT shutdown swept it with
+``kill_all(source="gateway_shutdown")``, which deliberately reaches persisted jobs.
+
+These tests drive the real path with real processes: a separate "worker" interpreter spawns
+the job through ``ProcessRegistry.spawn_local`` and exits; a fresh registry adopts it the way
+gateway startup does; then the gateway's own shutdown sweep runs.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import signal
+import subprocess
+import sys
+import textwrap
+import time
+from pathlib import Path
+
+import pytest
+
+from gateway.run_shutdown import GatewayShutdownMixin
+from tools.process_registry import ProcessRegistry, ProcessSession
+
+REPO = Path(__file__).resolve().parents[2]
+
+# Real signals to the jobs these tests spawn: the worker child exits, so its job is reparented to
+# init and the conftest guard would refuse (and the swallowing shutdown sweep hide) every kill.
+pytestmark = [pytest.mark.skipif(sys.platform == "win32", reason="POSIX process groups"),
+              pytest.mark.live_system_guard_bypass]
+
+
+@pytest.fixture(autouse=True)
+def _no_systemd_scopes(monkeypatch):
+    """Plain process groups here; the scope placement has its own test (no real units in CI)."""
+    monkeypatch.setattr("tools.process_registry._systemd_run_user_scope_available", lambda: False)
+
+
+def _alive(pid: int) -> bool:
+    try:
+        os.kill(pid, 0)
+    except OSError:
+        return False
+    try:  # a zombie is dead for our purposes
+        stat = Path(f"/proc/{pid}/stat").read_text()
+        return stat[stat.rindex(")") + 2] != "Z"
+    except (OSError, ValueError):
+        return True
+
+
+def _wait_dead(pid: int, timeout: float = 5.0) -> bool:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if not _alive(pid):
+            return True
+        time.sleep(0.05)
+    return not _alive(pid)
+
+
+@pytest.fixture()
+def checkpoint(tmp_path, monkeypatch):
+    path = tmp_path / "processes.json"
+    monkeypatch.setattr("tools.process_registry.CHECKPOINT_PATH", path)
+    return path
+
+
+@pytest.fixture()
+def reap():
+    pids: list[int] = []
+    yield pids.append
+    for pid in pids:
+        for sig in (signal.SIGTERM, signal.SIGKILL):
+            try:
+                os.killpg(pid, sig)
+            except OSError:
+                pass
+
+
+def _worker_spawns_persisted_job(checkpoint: Path, tmp_path: Path) -> dict:
+    """A separate interpreter (the Kanban worker) starts ``sleep`` persist_on_release, then exits."""
+    script = textwrap.dedent(f"""
+        import json, sys
+        sys.path.insert(0, {str(REPO)!r})
+        from unittest.mock import patch
+        from pathlib import Path
+        with patch("tools.process_registry.CHECKPOINT_PATH", Path({str(checkpoint)!r})), \
+                patch("tools.process_registry._systemd_run_user_scope_available", lambda: False):
+            from tools.process_registry import ProcessRegistry
+            reg = ProcessRegistry()
+            s = reg.spawn_local("sleep 120", cwd={str(tmp_path)!r}, task_id="t_card",
+                                owner_task_id="t_card", persist_on_release=True)
+            reg._write_checkpoint()
+            print(json.dumps({{"pid": s.pid, "id": s.id}}))
+        # exits without any cleanup sweep, like a worker the restart requeued
+    """)
+    env = {**os.environ, "HERMES_KANBAN_TASK": "t_card", "HERMES_HOME": str(tmp_path / "home")}
+    env.pop("_HERMES_GATEWAY", None)
+    out = subprocess.run([sys.executable, "-c", script], env=env, capture_output=True, text=True,
+                         timeout=60, check=True, stdin=subprocess.DEVNULL)
+    return json.loads(out.stdout.strip().splitlines()[-1])
+
+
+def _gateway_adopts(checkpoint: Path, job_id: str) -> ProcessRegistry:
+    gateway_registry = ProcessRegistry()
+    assert gateway_registry.recover_from_checkpoint(owner="gateway") == 1
+    assert gateway_registry._running[job_id].detached
+    assert gateway_registry._running[job_id].persist_on_release
+    return gateway_registry
+
+
+@pytest.mark.parametrize("restarting", [True, False], ids=["restart", "stop"])
+def test_worker_started_persisted_job_survives_gateway_shutdown_sweep(
+        checkpoint, tmp_path, reap, monkeypatch, restarting):
+    job = _worker_spawns_persisted_job(checkpoint, tmp_path)
+    reap(job["pid"])
+    assert _alive(job["pid"]), "the worker's persisted job outlived the worker"
+
+    gateway_registry = _gateway_adopts(checkpoint, job["id"])
+    monkeypatch.setattr("tools.process_registry.process_registry", gateway_registry)
+    monkeypatch.setattr("cron.scheduler.mark_running_jobs_interrupted", lambda *a, **k: [])
+
+    # The gateway's real shutdown sweep, both phases it runs (a plain stop uses the default).
+    kwargs = {"restarting": True} if restarting else {}
+    GatewayShutdownMixin._stop_kill_tool_subprocesses("post-interrupt", **kwargs)
+    GatewayShutdownMixin._stop_kill_tool_subprocesses("final-cleanup", **kwargs)
+
+    assert not _wait_dead(job["pid"], timeout=1.0), "gateway shutdown killed a worker's persisted job"
+    # Still in the checkpoint, so the next gateway adopts it again.
+    assert job["id"] in {e["session_id"] for e in json.loads(checkpoint.read_text())}
+
+
+def _own_job(registry: ProcessRegistry, tmp_path: Path, *, persist: bool) -> ProcessSession:
+    s = registry.spawn_local("sleep 120", cwd=str(tmp_path), task_id="gw", owner_task_id="gw",
+                             persist_on_release=persist)
+    assert s.pid
+    return s
+
+
+def test_restart_spares_gateway_own_persisted_job_but_kills_volatile(checkpoint, tmp_path, reap, monkeypatch):
+    registry = ProcessRegistry()
+    persisted, volatile = _own_job(registry, tmp_path, persist=True), _own_job(registry, tmp_path, persist=False)
+    reap(persisted.pid)
+    reap(volatile.pid)
+    monkeypatch.setattr("tools.process_registry.process_registry", registry)
+    monkeypatch.setattr("cron.scheduler.mark_running_jobs_interrupted", lambda *a, **k: [])
+
+    GatewayShutdownMixin._stop_kill_tool_subprocesses("post-interrupt", restarting=True)
+
+    assert _wait_dead(volatile.pid), "a restart still reaps ordinary background jobs"
+    assert not _wait_dead(persisted.pid, timeout=1.0), "a restart is not host exit: persisted job survives"
+
+
+def test_final_stop_still_kills_gateway_own_persisted_job(checkpoint, tmp_path, reap, monkeypatch):
+    """Upstream #41225/#46778 contract kept: a real stop reaps the jobs this gateway itself started."""
+    registry = ProcessRegistry()
+    persisted = _own_job(registry, tmp_path, persist=True)
+    reap(persisted.pid)
+    monkeypatch.setattr("tools.process_registry.process_registry", registry)
+    monkeypatch.setattr("cron.scheduler.mark_running_jobs_interrupted", lambda *a, **k: [])
+
+    GatewayShutdownMixin._stop_kill_tool_subprocesses("post-interrupt")
+
+    assert _wait_dead(persisted.pid)
+
+
+def test_explicit_kill_still_reaches_adopted_persisted_job(checkpoint, tmp_path, reap):
+    job = _worker_spawns_persisted_job(checkpoint, tmp_path)
+    reap(job["pid"])
+    gateway_registry = _gateway_adopts(checkpoint, job["id"])
+    gateway_registry.kill_process(job["id"], source="process_manage")
+    assert _wait_dead(job["pid"])
diff --git a/tests/gateway/test_shutdown_kill_restart_source.py b/tests/gateway/test_shutdown_kill_restart_source.py
new file mode 100644
index 00000000000..3f3f0d18972
--- /dev/null
+++ b/tests/gateway/test_shutdown_kill_restart_source.py
@@ -0,0 +1,64 @@
+"""Restart vs stop picks the gateway's kill source in both shutdown sweeps. [daveey]
+
+A restart passes ``gateway_restart`` (a lifecycle source that spares persist_on_release jobs, which
+the next gateway re-adopts); a stop keeps ``gateway_shutdown``. Drives the real
+``_stop_interrupt_remaining_work`` (post-interrupt) and ``_stop_kill_tool_subprocesses_off_loop``
+(final-cleanup) entry points.
+"""
+
+import time
+
+import pytest
+
+from gateway.run_shutdown import GatewayShutdownMixin
+from tests.gateway.restart_test_helpers import make_restart_runner
+
+
+def _runner(monkeypatch, sources, *, restarting):
+    runner, _adapter = make_restart_runner()
+    runner._restart_drain_timeout = 0.01
+    runner._restart_requested = restarting
+
+    def _fake_kill_all(task_id=None, **kwargs):
+        sources.append(kwargs.get("source"))
+        return 0
+
+    import tools.process_registry as _pr
+
+    monkeypatch.setattr(_pr.process_registry, "kill_all", _fake_kill_all)
+    monkeypatch.setattr("cron.scheduler.mark_running_jobs_interrupted", lambda *a, **k: [])
+    monkeypatch.setattr("tools.async_delegation.interrupt_all", lambda *a, **k: 0)
+    monkeypatch.setattr("tools.terminal_tool_lifecycle.cleanup_all_environments", lambda: None)
+    monkeypatch.setattr("tools.browser_session_lifecycle.cleanup_all_browsers", lambda *, process_shutdown=False: None)
+    return runner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("restarting", "source"), [(True, "gateway_restart"), (False, "gateway_shutdown")])
+async def test_post_interrupt_sweep_source_follows_restart(monkeypatch, restarting, source):
+    sources: list = []
+    runner = _runner(monkeypatch, sources, restarting=restarting)
+    ctx = GatewayShutdownMixin._StopContext(deferred_count=lambda: 0)
+    ctx.started_at = time.monotonic()
+
+    await runner._stop_interrupt_remaining_work(ctx)
+
+    assert sources == [source]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("restarting", "source"), [(True, "gateway_restart"), (False, "gateway_shutdown")])
+async def test_off_loop_sweep_forwards_restarting(monkeypatch, restarting, source):
+    sources: list = []
+    _runner(monkeypatch, sources, restarting=restarting)
+
+    await GatewayShutdownMixin._stop_kill_tool_subprocesses_off_loop("final-cleanup", restarting=restarting)
+
+    assert sources == [source]
+
+
+def test_restart_source_is_a_lifecycle_sweep():
+    from tools.process_registry import ProcessRegistry
+
+    assert "gateway_restart" in ProcessRegistry._LIFECYCLE_KILL_SOURCES
+    assert "gateway_shutdown" not in ProcessRegistry._LIFECYCLE_KILL_SOURCES
diff --git a/tests/tools/test_persist_job_own_scope.py b/tests/tools/test_persist_job_own_scope.py
new file mode 100644
index 00000000000..9d563a646f6
--- /dev/null
+++ b/tests/tools/test_persist_job_own_scope.py
@@ -0,0 +1,109 @@
+"""A Kanban worker's persist_on_release job gets its own scope, outside the run scope. [daveey]
+
+The run scope is OOMPolicy=stop / KillMode=control-group and is stopped when the run OOMs or after
+it ends, which killed a persisted paid-rental watchdog (hub, 2026-11-03 03:42Z).
+"""
+
+import os
+import subprocess
+import time
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+import tools.process_registry as pr
+from tools.process_registry import ProcessRegistry
+from tools.process_registry_persist_scope import KANBAN_SLICE, kanban_run_scope_cgroup
+
+RUN_SCOPE = "user.slice/user-1000.slice/user@1000.service/hermes.slice/hermes-kanban.slice/" \
+            "hermes-worker-kanban-t_abc-run-7.scope"
+
+
+def test_run_scope_cgroup_parses_only_kanban_run_scopes(tmp_path):
+    cg = tmp_path / "cgroup"
+    cg.write_text(f"0::/{RUN_SCOPE}\n")
+    assert kanban_run_scope_cgroup(str(cg)) == Path("/sys/fs/cgroup") / RUN_SCOPE
+    cg.write_text("0::/user.slice/user-1000.slice/user@1000.service/app.slice/hermes-gateway.service\n")
+    assert kanban_run_scope_cgroup(str(cg)) is None
+    assert kanban_run_scope_cgroup(str(tmp_path / "missing")) is None
+
+
+def _spawn(monkeypatch, tmp_path, *, persist, in_run_scope=True):
+    scope_dir = tmp_path / "run-scope"
+    scope_dir.mkdir(exist_ok=True)
+    (scope_dir / "memory.max").write_text("8589934592\n")
+    monkeypatch.setattr(pr, "_IS_LINUX", True)
+    monkeypatch.setattr(pr, "_is_supervised_gateway_process", lambda: False)
+    monkeypatch.setattr(pr, "_systemd_run_user_scope_available", lambda: True)
+    monkeypatch.setattr("tools.process_registry_persist_scope.kanban_run_scope_cgroup",
+                        lambda: scope_dir if in_run_scope else None)
+    monkeypatch.setattr("shutil.which", lambda name: f"/usr/bin/{name}")
+    captured = {}
+
+    def fake_popen(argv, **kwargs):
+        captured["argv"] = list(argv)
+        captured["env"] = kwargs.get("env")
+        proc = MagicMock(pid=4321, stdout=iter([]))
+        proc.poll.return_value = None
+        return proc
+
+    registry = ProcessRegistry()
+    with (patch("subprocess.Popen", side_effect=fake_popen), patch("threading.Thread", return_value=MagicMock()),
+          patch.object(registry, "_write_checkpoint")):
+        session = registry.spawn_local("sleep 60", cwd=str(tmp_path), persist_on_release=persist)
+    return session, captured["argv"]
+
+
+@pytest.mark.platforms("linux")
+def test_persisted_job_in_kanban_run_scope_gets_own_scope(monkeypatch, tmp_path):
+    session, argv = _spawn(monkeypatch, tmp_path, persist=True)
+    assert argv[0] == "/usr/bin/systemd-run" and "--scope" in argv and "--user" in argv
+    assert argv[argv.index("--unit") + 1] == f"hermes-worker-{session.id}"
+    assert f"--slice={KANBAN_SLICE}" in argv[:argv.index("--")]
+    assert "MemoryMax=8589934592" in argv[:argv.index("--")], "the run scope's own cap, not the 4 GiB gateway one"
+    assert session.systemd_unit == f"hermes-worker-{session.id}.scope"
+
+
+@pytest.mark.platforms("linux")
+def test_volatile_job_stays_in_run_scope(monkeypatch, tmp_path):
+    session, argv = _spawn(monkeypatch, tmp_path, persist=False)
+    assert argv[0] != "/usr/bin/systemd-run"
+    assert session.systemd_unit == ""
+
+
+@pytest.mark.platforms("linux")
+def test_persisted_job_outside_kanban_run_scope_is_unchanged(monkeypatch, tmp_path):
+    session, argv = _spawn(monkeypatch, tmp_path, persist=True, in_run_scope=False)
+    assert argv[0] != "/usr/bin/systemd-run"
+    assert session.systemd_unit == ""
+
+
+def _in_real_run_scope() -> bool:
+    return kanban_run_scope_cgroup() is not None and pr._systemd_run_user_scope_available()
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.skipif(not _in_real_run_scope(), reason="needs a real Kanban run scope and a user systemd bus")
+def test_real_persisted_job_lands_outside_run_scope(tmp_path, monkeypatch):
+    """On a Kanban worker host: the job's cgroup is its own scope, so stopping the run scope can't reach it."""
+    monkeypatch.setattr(pr, "_SYSTEMD_SCOPE_AVAILABLE", None)  # earlier tests may have cached a fake verdict
+    monkeypatch.setattr(pr, "_SYSTEMD_SCOPE_PROBED_AT", 0.0)
+    if not pr._systemd_run_user_scope_available():
+        pytest.skip("user systemd bus probe failed at run time")
+    registry = ProcessRegistry()
+    session = registry.spawn_local("sleep 30", cwd=str(tmp_path), persist_on_release=True)
+    try:
+        deadline = time.monotonic() + 10
+        cgroup = ""
+        while time.monotonic() < deadline:
+            cgroup = Path(f"/proc/{session.pid}/cgroup").read_text()
+            if session.systemd_unit in cgroup:
+                break
+            time.sleep(0.1)
+        assert session.systemd_unit and cgroup.rstrip().endswith("/" + session.systemd_unit), cgroup
+        assert f"/{KANBAN_SLICE}/" in cgroup
+        assert "hermes-worker-kanban-" not in cgroup
+    finally:
+        subprocess.run(["systemctl", "--user", "stop", session.systemd_unit], check=False, timeout=15,
+                       env=pr.systemd_user_bus_env() or os.environ)
