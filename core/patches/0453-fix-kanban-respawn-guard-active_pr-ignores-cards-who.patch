Date: Mon, 26 Oct 2026 21:46:04 -0700
Subject: [PATCH 448/453] fix(kanban): respawn guard active_pr ignores cards
 whose worker never ran

(cherry picked from commit f75d239f8b55caf446cdac0d2a33ec4fae1751ff)
---
 hermes_cli/kanban_db_dispatch_pr_state.py        | 16 ++++++++++++++++
 tests/hermes_cli/kanban_guard_helpers.py         |  9 +++++++++
 tests/hermes_cli/test_kanban_park_invariants.py  |  6 ++++++
 tests/hermes_cli/test_kanban_review_lifecycle.py |  6 ++++++
 .../test_kanban_review_lifecycle_complete.py     |  6 ++++++
 5 files changed, 43 insertions(+)
 create mode 100644 tests/hermes_cli/kanban_guard_helpers.py

diff --git a/hermes_cli/kanban_db_dispatch_pr_state.py b/hermes_cli/kanban_db_dispatch_pr_state.py
index fe5fbebf18..2312097610 100644
--- a/hermes_cli/kanban_db_dispatch_pr_state.py
+++ b/hermes_cli/kanban_db_dispatch_pr_state.py
@@ -148,6 +148,20 @@ def _immediate_checkpoint_after(
     )
 
 
+def _pr_comments_predate_first_run(conn: sqlite3.Connection, task_id: str, newest_pr_at: int) -> bool:
+    """True when the card never ran a worker, or every PR comment predates its first run.
+
+    A worker that never ran cannot have opened a duplicate PR: the PR named in a review
+    card's handoff is the one it exists to review/finish.
+    """
+    from hermes_cli import kanban_db as _kb
+
+    first_run = conn.execute(
+        "SELECT MIN(started_at) AS t FROM task_runs WHERE task_id = ?", (task_id,)
+    ).fetchone()["t"]
+    return first_run is None or newest_pr_at < _kb._to_epoch(first_run)
+
+
 def active_pr_reason(conn: sqlite3.Connection, task_id: str, now: int) -> Optional[str]:
     """Respawn-guard step 4: ``"active_pr"`` when a comment in the last 24 h names a PR, else None.
 
@@ -184,6 +198,8 @@ def active_pr_reason(conn: sqlite3.Connection, task_id: str, now: int) -> Option
             pr_urls.extend(urls)
     if not pr_times:
         return None
+    if _pr_comments_predate_first_run(conn, task_id, max(pr_times)):
+        return None
     if _immediate_checkpoint_after(conn, task_id, max(pr_times), latest_pr_comment_id):
         return None
     # Strictly after: a same-second handoff tie stays guarded (fail closed).
diff --git a/tests/hermes_cli/kanban_guard_helpers.py b/tests/hermes_cli/kanban_guard_helpers.py
new file mode 100644
index 0000000000..e1e952dbd4
--- /dev/null
+++ b/tests/hermes_cli/kanban_guard_helpers.py
@@ -0,0 +1,9 @@
+"""Fixture for guard tests that model a card whose worker already ran (and so may have opened a PR)."""
+import pytest
+
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+
+
+@pytest.fixture
+def worker_ran(monkeypatch):
+    monkeypatch.setattr(prs, "_pr_comments_predate_first_run", lambda *a, **k: False)
