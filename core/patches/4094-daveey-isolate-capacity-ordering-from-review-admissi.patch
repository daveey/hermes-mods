From 7be97a6a376c3980f415e4c11d3a10105fef2e1a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:12:52 +0000
Subject: [PATCH] [daveey] isolate capacity ordering from review admission
 budget

Why: review screening makes the fourth unjudged fixture row correctly wait behind the three-call admission budget, before the Board capacity refusal seam. Existing capacity tests assumed only ready rows consume admission. Pre-admit candidates through the real screen across two bounded passes; retain all lease ordering and lane-local capacity assertions. Proof: capacity-red-run1 rc1 (two failures); capacity-green-run1 rc0 for capacity and wake-race suites. No production budget change.
---
 tests/hermes_cli/test_kanban_capacity_order.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_capacity_order.py b/tests/hermes_cli/test_kanban_capacity_order.py
index 4e7931e725..a1abd7d137 100644
--- a/tests/hermes_cli/test_kanban_capacity_order.py
+++ b/tests/hermes_cli/test_kanban_capacity_order.py
@@ -82,6 +82,13 @@ def test_capacity_fence_is_lane_local_and_survives_review_resume(gws, monkeypatc
              for p in (900, 530, 100)]
     review = kb.create_task(hub.conn, title="reserved review", assignee="default")
     assert kb.request_review(hub.conn, review, summary="review")
+    # This exercises Board capacity, not the per-tick admission budget. Pre-admit
+    # the review row so all four candidates can reach the lease boundary.
+    from hermes_cli import kanban_hub_admission_claim as admission
+    counts = admission.screen(hub.conn)
+    assert counts.judged == 3
+    counts = admission.screen(hub.conn)
+    assert counts.judged == 1
     hub.round()
     acquire = client.HubLeaseClient.acquire
     refused = ready[0] if refused_lane == "ready" else review
