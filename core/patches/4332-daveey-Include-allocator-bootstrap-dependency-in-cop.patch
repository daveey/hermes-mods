 tests/hermes_cli/test_source_launcher_publication.py | 2 +-
 tests/hermes_cli/test_update_recovery_closure.py     | 1 +
 tests/pm/test_startup_recovery.py                    | 2 +-
 4 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_doctor_command_install.py b/tests/hermes_cli/test_doctor_command_install.py
index 48f6db0781..57546c1b4f 100644
--- a/tests/hermes_cli/test_doctor_command_install.py
+++ b/tests/hermes_cli/test_doctor_command_install.py
@@ -49,6 +49,7 @@ def _pm_source(project, home):
         "pm/environments.py", "pm/filesystem.py", "hermes_cli/runtime_state.py",
         "hermes_cli/_early_recovery.py", "hermes_cli/_parser.py",
         "hermes_cli/venv_sync.py", "hermes_cli/steward.py", "hermes_cli/stderr_timestamp.py",
+        "hermes_cli/launch_malloc.py",
     ):
         target = project / relative
         target.parent.mkdir(parents=True, exist_ok=True)
diff --git a/tests/hermes_cli/test_source_launcher_publication.py b/tests/hermes_cli/test_source_launcher_publication.py
index 28be706a2b..3a4aed5f13 100644
