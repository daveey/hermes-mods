+++ b/tests/hermes_cli/test_source_launcher_publication.py
@@ -20,7 +20,7 @@ BOOT_FILES = (
     "hermes_cli/_launch_template.py",
     "pm/environments.py", "pm/filesystem.py", "pm/paths.py", "hermes_cli/runtime_state.py",
     "hermes_cli/_early_recovery.py", "hermes_cli/_parser.py",
-    "hermes_cli/venv_sync.py", "hermes_cli/steward.py",
+    "hermes_cli/venv_sync.py", "hermes_cli/steward.py", "hermes_cli/launch_malloc.py",
     "hermes_cli/stderr_timestamp.py",
     "scripts/hermes-gateway",
 )
diff --git a/tests/hermes_cli/test_update_recovery_closure.py b/tests/hermes_cli/test_update_recovery_closure.py
index a46e3350f2..0a48cf2846 100644
--- a/tests/hermes_cli/test_update_recovery_closure.py
+++ b/tests/hermes_cli/test_update_recovery_closure.py
@@ -29,6 +29,7 @@ SOURCE = Path(__file__).resolve().parents[2]
 BOOT = ("hermes_bootstrap.py", "hermes_constants.py", "hermes_cli/__init__.py", "hermes_cli/_launchers.py",
         "hermes_cli/_early_recovery.py", "hermes_cli/_parser.py", "hermes_cli/runtime_state.py",
         "hermes_cli/venv_sync.py", "hermes_cli/steward.py", "hermes_cli/stderr_timestamp.py",
+        "hermes_cli/launch_malloc.py",
         "hermes_cli/update_lock.py", "hermes_cli/update_custody.py", "pm/environments.py",
         "pm/filesystem.py", "pm/paths.py")
 _HOLDER = ("import sys, time\nfrom pathlib import Path\nsys.path.insert(0, sys.argv[1])\n"
diff --git a/tests/pm/test_startup_recovery.py b/tests/pm/test_startup_recovery.py
index 6b937c06c4..07a3391105 100644
--- a/tests/pm/test_startup_recovery.py
+++ b/tests/pm/test_startup_recovery.py
@@ -54,7 +54,7 @@ def test_bootstrap_repairs_before_dependency_activation(tmp_path, monkeypatch, m
     # Include the real preimport protocol, including its ownership check. Do
     # not stub prepare_launch: the same files are also saved in PM's workspace.
     for name in ("__init__.py", "runtime_state.py", "_early_recovery.py",
-                 "_parser.py", "venv_sync.py", "steward.py"):
+                 "_parser.py", "venv_sync.py", "steward.py", "launch_malloc.py"):
         shutil.copy2(repo / "hermes_cli" / name, cli / name)
     wheels = tmp_path / "wheels"
     wheels.mkdir()
