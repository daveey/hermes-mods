From 4b080e370877e258b8c0bdb3a1b18b5f66087ab5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:31:55 +0000
Subject: [PATCH] ci: nightly e2e utf-8 reads [daveey]

---
 scripts/ci/nightly_e2e.py    | 2 +-
 tests/ci/test_nightly_e2e.py | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/ci/nightly_e2e.py b/scripts/ci/nightly_e2e.py
index 102bbd08245..60a0b90ee49 100644
--- a/scripts/ci/nightly_e2e.py
+++ b/scripts/ci/nightly_e2e.py
@@ -175,7 +175,7 @@ class NightlyBoard(CliBoard):
 
 def load_state(path: Path) -> dict[str, Any]:
     try:
-        state = json.loads(path.read_text(encoding="utf-8"))
+        state = json.loads(path.read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         state = {}
     state.setdefault("pending", [])  # dispatched runs not yet reported
diff --git a/tests/ci/test_nightly_e2e.py b/tests/ci/test_nightly_e2e.py
index 7deeee84512..3a273b523f9 100644
--- a/tests/ci/test_nightly_e2e.py
+++ b/tests/ci/test_nightly_e2e.py
@@ -293,7 +293,7 @@ def test_state_round_trip(tmp_path):
 
 
 def _wf(name):
-    return YAML(typ="safe").load((ROOT / ".github" / "workflows" / name).read_text())
+    return YAML(typ="safe").load((ROOT / ".github" / "workflows" / name).read_text(encoding="utf-8-sig"))
 
 
 def test_nightly_workflow_is_dispatch_only_and_calls_the_gates_e2e_job():
-- 
