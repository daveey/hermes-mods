From 751162b10f368a3db56e727af8fa8f1f9003aa90 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:34:34 +0000
Subject: [PATCH] [daveey] kanban awaiting: read session stores through
 connect_tracked

CI (test_kanban_lockguard) refuses a raw sqlite3.connect in hermes_cli/kanban*.py:
tui_chat_reachable opened state.db that way. It now uses the tracked read-only
open the transcript proof uses for the same store.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_awaiting.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_awaiting.py b/hermes_cli/kanban_awaiting.py
index 9117d8557df73bfffb63dedeccd3895a2270a4b9..335d81877c1b1cbc1d10fbb74a8dd7c9b3625aae 100644
--- a/hermes_cli/kanban_awaiting.py
+++ b/hermes_cli/kanban_awaiting.py
@@ -559,7 +559,9 @@ def tui_chat_reachable(chat_id: str) -> bool:
         _HEADLESS_SESSION, _INTERACTIVE_SOURCES, MACHINE_SESSION_SOURCES, session_creation_source)
     for path in _session_stores():
         try:
-            with contextlib.closing(sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=1)) as db:
+            from hermes_cli.sqlite_safe_read import connect_tracked  # state.db is byte-probed: tracked fd
+            with contextlib.closing(connect_tracked(path.as_uri() + "?mode=ro", tracking_path=path, uri=True,
+                                                    timeout=1)) as db:
                 db.row_factory = sqlite3.Row
                 row = db.execute("SELECT * FROM sessions WHERE id = ?", (chat_id,)).fetchone()
         except (sqlite3.Error, OSError, ValueError):
