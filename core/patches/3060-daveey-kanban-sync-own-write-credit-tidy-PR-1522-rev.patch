From 5ffa73a257b9b5375c38571b468e457fa4eba4f7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:08:30 +0000
Subject: [PATCH] [daveey] kanban sync own-write credit: tidy PR #1522 review
 nits

- Rename test_another_threads_write_during_the_round_still_repairs to
  test_another_connections_write_during_the_round_still_repairs: it races
  through another connection on the same thread (thread isolation is covered
  by the unit tests).
- kanban_sync_own_writes module docstring: take(conn), not take(path).
- kanban_sync_client.pull(): drop the revisions= parameter. Since #1522 the
  sync thread credits feed applies through kanban_sync_own_writes.credited(),
  and no caller in the tree passes revisions= any more.

No behavior change. (t_01a1d0f3fdcab89e)
---
 hermes_cli/kanban_sync_client.py                | 11 ++++-------
 hermes_cli/kanban_sync_own_writes.py            |  2 +-
 tests/hermes_cli/test_kanban_sync_own_writes.py |  2 +-
 3 files changed, 6 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 9c1580da8c..fb9ac83791 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -832,11 +832,10 @@ def _child_task(conn: sqlite3.Connection, table: str, uid: str) -> Optional[str]
 
 
 def pull(conn: sqlite3.Connection, hub: Hub, board: str, *, observers: bool,
-         partition: Optional[str] = None, revisions: Optional[list] = None) -> int:
+         partition: Optional[str] = None) -> int:
     """Apply every feed page after this file's cursor. Returns the number of changes read. On a board with an
     outbox (primary), fields with an unanswered local edit are not overwritten; ``partition`` (a gateway name)
-    keeps only that gateway's cards. ``revisions`` gets each apply's (before, after) repair revision, in order
-    (callers credit a live change made only by these applies). [daveey]"""
+    keeps only that gateway's cards. [daveey]"""
     from hermes_cli.kanban_sync_stop import checkpoint
     total = 0
     cursor = int((sync.sync_state(conn) or {}).get("cursor") or 0)
@@ -856,10 +855,8 @@ def pull(conn: sqlite3.Connection, hub: Hub, board: str, *, observers: bool,
             return total
         # [daveey] The pre-filter above can miss a local edit committed after it read the outbox (a claim in
         # flight): ``local_pending_wins`` checks again inside the apply transaction.
-        applied = sync.apply_remote_changes(conn, changes, new_cursor=nxt, board=board, observers=observers,
-                                            local_pending_wins=True)
-        if revisions is not None:
-            revisions.append((applied.revision_before, applied.revision_after))
+        sync.apply_remote_changes(conn, changes, new_cursor=nxt, board=board, observers=observers,
+                                  local_pending_wins=True)
         total += len(page.get("changes", []))
         cursor = nxt
         if not page.get("more"):
diff --git a/hermes_cli/kanban_sync_own_writes.py b/hermes_cli/kanban_sync_own_writes.py
index a8238815e1..cb5ddde676 100644
--- a/hermes_cli/kanban_sync_own_writes.py
+++ b/hermes_cli/kanban_sync_own_writes.py
@@ -10,7 +10,7 @@ deletes, ``sync_version``), the remote-parent mirror, and pool reservations with
 ``conn`` while the block runs. The recorder is a TEMP trigger: it fires only for statements run on the connection
 that created it, and its rows live in that connection's temp schema, so they commit and roll back with the write
 that made them (a rolled-back step is never credited). When the block ends outside a transaction its rows move to a
-per-file list, so a later round on another connection to the same file still sees them; ``take(path)`` returns
+per-file list, so a later round on another connection to the same file still sees them; ``take(conn)`` returns
 them in order and clears them, and ``kanban_sync_repair_window.decide`` chains them from the credited revision.
 Anything the recorder misses (another thread or process, a failed install, a block that ends mid-transaction)
 leaves a gap in that chain, which repairs at once.
diff --git a/tests/hermes_cli/test_kanban_sync_own_writes.py b/tests/hermes_cli/test_kanban_sync_own_writes.py
index c0432fb093..98dacf6a6b 100644
--- a/tests/hermes_cli/test_kanban_sync_own_writes.py
+++ b/tests/hermes_cli/test_kanban_sync_own_writes.py
@@ -108,7 +108,7 @@ def test_a_reservation_write_by_the_sync_thread_is_credited(live, svc, kanban_ho
     assert not any(calls.values()), calls
 
 
-def test_another_threads_write_during_the_round_still_repairs(live, svc, kanban_home, monkeypatch, clock):
+def test_another_connections_write_during_the_round_still_repairs(live, svc, kanban_home, monkeypatch, clock):
     """A dispatcher/heartbeat write on another connection while the sync thread is inside a credited block is
     not the sync thread's: a gap, so the next round repairs and finds it."""
     parent, child = credit._settle(live, svc, kanban_home)
-- 
