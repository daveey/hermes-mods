From 883d1475c78347094ab84864d433c7a98d857ac5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:19:42 -0800
Subject: [PATCH] [daveey] Kanban wake fold: label check for every wake kind,
 docs

---
 tests/gateway/test_kanban_wake_fold.py            | 9 +++++++++
 website/docs/developer-guide/gateway-internals.md | 8 ++++++++
 2 files changed, 17 insertions(+)

diff --git a/tests/gateway/test_kanban_wake_fold.py b/tests/gateway/test_kanban_wake_fold.py
index 406a46c238..4d871114f2 100644
--- a/tests/gateway/test_kanban_wake_fold.py
+++ b/tests/gateway/test_kanban_wake_fold.py
@@ -244,3 +244,12 @@ def test_card_metadata_rejects_malformed_cards():
         with pytest.raises(RuntimeStoreError):
             kanban_wake_fold.card_metadata({'kanban_cards': bad})
     assert 'kanban_cards' in session_automation._AUTOMATION_METADATA
+
+
+def test_every_wake_kind_has_a_status_label():
+    """``chat_wait_unclaimed`` joined the wake kinds with no label, so every such wake told the chat
+    "Task <id> gateway.kanban.wake.chat_wait_unclaimed." (state.db message 873383, 2026-11-11)."""
+    from agent.i18n import t
+    from gateway.kanban_watchers_notifier import _WAKE_KINDS
+    missing = [kind for kind in _WAKE_KINDS if t(f'gateway.kanban.wake.{kind}') == f'gateway.kanban.wake.{kind}']
+    assert not missing
diff --git a/website/docs/developer-guide/gateway-internals.md b/website/docs/developer-guide/gateway-internals.md
index 9a89278211..682cc7b914 100644
--- a/website/docs/developer-guide/gateway-internals.md
+++ b/website/docs/developer-guide/gateway-internals.md
@@ -912,6 +912,14 @@ every producer identity, a "N background process results" header), cancelling th
 the same transaction. Only the tail folds, so a prompt queued after a completion keeps its place
 between them; a waiting row claimed first leaves the new completion to queue alone.
 
+Kanban wakes (producer `kanban-wake`) fold the same way (`gateway/kanban_wake_fold.py`). Each wake
+carries its card (`kanban_cards`: task id, board, kinds, text), so a later wake rebuilds the batch
+from cards instead of concatenating text. Several events for one card collapse to the latest. A card
+whose premise no longer holds when the batch is built (an unclaimed wait that has since been claimed
+or completed, a block that has since been resolved) is relabelled with its live board status. Every
+card keeps its `[kanban] Task <id> <kind>.` line, which the follow-through and ask-gate plugins
+match. A wake never folds into a completion or a prompt, nor a completion into a wake.
+
 Cron execution has its own session. Eligible continuable deliveries may mirror or seed the
 reply-facing conversation: origin, origin-less home fallback, user-written bare-platform home,
 or opted-in explicit targets. `all` expansions do not gain home mirror eligibility. Mirrored
