From a8de05d42a585f3a82d9d5ee27610876f6cea4db Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:26:21 +0000
Subject: [PATCH] [daveey] fix(hub-admission): an abbreviation dot does not end
 a wrapped pin's span; document the whole-line deny

Review 5884663184 (PR #1802) nits: the wrapped-continuation scan stopped at the
first '.' + whitespace, so 'e.g.' on a pin line cut the span short and a judge
quote of the next line was admitted. Skip abbreviation dots (known words and
dotted tokens) when finding the sentence end. Document that the whole-line span
and the run-to-end-of-field for an unterminated pin are deliberate and fail safe.
---
 hermes_cli/kanban_hub_admission.py | 26 ++++++++++++++++++++++++--
 tests/test_kanban_hub_admission.py | 14 +++++++++++++-
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission.py b/hermes_cli/kanban_hub_admission.py
index 146dcc2839..4e76acc37c 100644
--- a/hermes_cli/kanban_hub_admission.py
+++ b/hermes_cli/kanban_hub_admission.py
@@ -66,16 +66,38 @@ def self_assertion(quote):
 
 _PIN = re.compile("|".join(r"\s+".join(map(re.escape, m.split())) for m in SELF_ASSERTIONS), re.IGNORECASE)
 _SENTENCE_END = re.compile(r"[.!?](?=\s|$)|\n[ \t]*\n")
+# A "." ending one of these words, or a dotted token ("e.g", "U.S"), abbreviates rather than ends the sentence:
+# stopping there let the wrapped rest of a pin escape its span (review 5884663184). [daveey]
+_ABBREVIATIONS = frozenset({"e.g", "i.e", "etc", "vs", "cf", "viz", "approx", "incl", "esp", "al", "no", "mr", "mrs",
+                            "ms", "dr", "st"})
+_LAST_WORD = re.compile(r"[\w.]*$")
+
+
+def _sentence_end(text, pos):
+    """The first sentence terminator (or blank line) at or after ``pos``, skipping abbreviation dots."""
+    for stop in _SENTENCE_END.finditer(text, pos):
+        if text[stop.start()] == ".":
+            last = _LAST_WORD.search(text, max(0, stop.start() - 32), stop.start())
+            word = last.group().lower() if last else ""
+            if word in _ABBREVIATIONS or "." in word:
+                continue
+        return stop
+    return None
 
 
 def _pin_spans(text):
     """``[start, end)`` of every pin line in ``text``: the marker's whole line, run on to the sentence's end
-    when the producer wrapped it (never past a blank line)."""
+    when the producer wrapped it (never past a blank line).
+
+    Deliberately coarse and fail-safe (review 5884663184): the span is the pin's WHOLE line, so other text on that
+    line after the pin sentence counts as pin text, and a pin with no terminator and no blank line runs to the end
+    of the field. A quote found only there is denied as self-assertion; evidence the card also states outside a
+    pin span is still judged on that text (``quotes_pin_sentence``)."""
     spans = []
     for match in _PIN.finditer(text):
         start = text.rfind("\n", 0, match.start()) + 1
         line_end = text.find("\n", match.end())
-        stop = _SENTENCE_END.search(text, match.end())
+        stop = _sentence_end(text, match.end())
         spans.append((start, max(len(text) if line_end < 0 else line_end, stop.end() if stop else len(text))))
     return spans
 
diff --git a/tests/test_kanban_hub_admission.py b/tests/test_kanban_hub_admission.py
index d419ae3f62..824b4a9f68 100644
--- a/tests/test_kanban_hub_admission.py
+++ b/tests/test_kanban_hub_admission.py
@@ -274,13 +274,17 @@ def test_other_evidence_on_a_card_with_a_pin_sentence_still_admits(judge):
 ESCAPE_TAIL = "it reads this gateway's own logs, state files and coach store, which a worker node does not have."
 WRAPPED_PIN = ("Pinned to the machine that filed it: the bsky cron output and its counters live\n"
                "only on this machine.\n## Do this\n1. Read the counters.")
+# An abbreviation dot on the pin line is not the sentence's end (review 5884663184).
+ABBREV_PIN = ("Pinned to the machine that filed it: its cron output (e.g. the bsky counters, i.e. the\n"
+              "daily totals) lives only on this machine.\n## Do this\n1. Read the counters.")
 
 
 @pytest.mark.parametrize("body, quote", [
     (ESCAPE_BODY, ESCAPE_TAIL),                       # rationale tail alone (review t_01a1d24d488edbd9)
     (ESCAPE_BODY, "which a worker node does not have"),
     (WRAPPED_PIN, "only on this machine."),            # the wrapped continuation of a pin sentence
-], ids=["tail", "tail-fragment", "wrapped"])
+    (ABBREV_PIN, "daily totals) lives only on this machine."),
+], ids=["tail", "tail-fragment", "wrapped", "wrapped-abbreviation"])
 def test_quote_from_inside_a_pin_line_is_not_admission_evidence(judge, body, quote):
     gate, _, reply, _ = judge
     reply.update(admit=True, need="hub_live_process", evidence=quote, why="Needs local state.")
@@ -314,3 +318,11 @@ def test_stored_owner_verdict_quoting_a_pin_sentence_is_a_final_deny_with_its_wh
     if quote == ESCAPE_TAIL:  # without a pin line around it the same text is ordinary evidence
         moved = stored_owner_verdict(entry, "Capability owner", f"Owner card.\n{quote}")
         assert moved is not None and moved["admit"] is True
+
+
+def test_pin_span_ends_at_the_real_sentence_end_after_an_abbreviation():
+    from hermes_cli.kanban_hub_admission import _pin_spans
+    body = ABBREV_PIN
+    (start, end), = _pin_spans(body)
+    assert body[start:end].endswith("lives only on this machine.")
+    assert "## Do this" not in body[start:end]
-- 
2.51.0

