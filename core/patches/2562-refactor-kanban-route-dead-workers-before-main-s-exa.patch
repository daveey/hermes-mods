From 6c7a7147e04d72ef4d77af165514aa8e8d1113da Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:07:50 +0000
Subject: [PATCH] refactor(kanban): route dead workers before main's exact-run
 closure [daveey]

Rebase onto main's close_dead_run: neutral/deferred routing moves to kanban_failure_release.route_dead_worker so the sweep stays within its complexity cap; drop the duplicate auto_blocked field.
---
 hermes_cli/kanban_db_dispatch.py     | 13 ++-----------
 hermes_cli/kanban_failure_release.py | 19 +++++++++++++++++++
 2 files changed, 21 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 4dccc51356..2c0145932d 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1308,7 +1308,6 @@ class _CrashSweep:
     # Worker-exit observer payloads, fired only after every reclaim/accounting
     # txn has committed.
     exited_hook_payloads: list[dict] = field(default_factory=list)
-    auto_blocked: list[str] = field(default_factory=list)
 
 
 def _reclaim_dead_workers(conn: sqlite3.Connection, board: Optional[str] = None,
@@ -1367,17 +1366,9 @@ def _reclaim_dead_workers(conn: sqlite3.Connection, board: Optional[str] = None,
             _owner_death.note(dead, conn, row["id"], row["current_run_id"])  # owner died under it [daveey]
             dead.run_id = row["current_run_id"]
             dead.event_payload["retry_status"] = _kb._retry_status_for_run(conn, row["id"])
-            from hermes_cli import kanban_neutral_release
-            if kanban_neutral_release.queue(conn, row, dead):
-                continue
-            from hermes_cli.kanban_failure_release import deferred_crash
-            if deferred_crash(conn, dead):
-                sweep.crashed.append(row["id"])
-                sweep.crash_details.append((row["id"], pid, row["claim_lock"], dead))
+            from hermes_cli.kanban_failure_release import route_dead_worker
+            if route_dead_worker(conn, row, dead, sweep, pid):
                 continue
-            if not (dead.rate_limited or dead.owner_restart
-                    or dead.owner_unavailable or (dead.host_reboot and not dead.reboot_culprit)):
-                dead.event_payload["failure_notice"] = "canonical"
             from hermes_cli.kanban_run_finalizer import close_dead_run
             closed = close_dead_run(conn, row, dead)
             if closed is None:
diff --git a/hermes_cli/kanban_failure_release.py b/hermes_cli/kanban_failure_release.py
index 69123c7379..c41ef88c02 100644
--- a/hermes_cli/kanban_failure_release.py
+++ b/hermes_cli/kanban_failure_release.py
@@ -24,6 +24,25 @@ def deferred_crash(conn: sqlite3.Connection, dead) -> bool:
     )
 
 
+def route_dead_worker(conn: sqlite3.Connection, row, dead, sweep, pid: int) -> bool:
+    """Route a classified dead worker before local closure; True when the Board owns it.
+
+    Neutral releases wait for the feed; charged primary crashes join the sweep's
+    accounting without a local mirror edit. Otherwise mark the canonical notice.
+    """
+    from hermes_cli import kanban_neutral_release
+    if kanban_neutral_release.queue(conn, row, dead):
+        return True
+    if deferred_crash(conn, dead):
+        sweep.crashed.append(row["id"])
+        sweep.crash_details.append((row["id"], pid, row["claim_lock"], dead))
+        return True
+    if not (dead.rate_limited or dead.owner_restart
+            or dead.owner_unavailable or (dead.host_reboot and not dead.reboot_culprit)):
+        dead.event_payload["failure_notice"] = "canonical"
+    return False
+
+
 def queued(conn: sqlite3.Connection, run_id: int | None) -> bool:
     """Skip repeated observations/side effects while the authoritative feed lags."""
     if sync.board_mode(conn) != "primary":
