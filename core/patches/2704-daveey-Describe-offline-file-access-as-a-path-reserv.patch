From af0271b32de273e4b8bdce2e1e43db22d203e553 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:24:58 +0000
Subject: [PATCH] [daveey] Describe offline file access as a path reservation
 in caller comments

Callers documented offline_file_access as holding the registry lock across raw
I/O. It now reserves only the target path; say so, and record that reservations
share the registry's resolved-path keying (hardlinks, ATTACH).
---
 agent/context_references.py               | 4 ++--
 hermes_cli/backup_restore.py              | 4 ++--
 hermes_cli/session_recovery.py            | 2 +-
 hermes_cli/sqlite_offline_reservations.py | 3 +++
 hermes_cli/web_routers/files.py           | 8 ++++----
 5 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/agent/context_references.py b/agent/context_references.py
index 732dbb786d..3281f2b1d5 100644
--- a/agent/context_references.py
+++ b/agent/context_references.py
@@ -324,7 +324,7 @@ def _expand_path_reference(ref: ContextReference, cwd: Path, *, allowed_root: Pa
     try:
         # Keep admission through every sniff, stat and text read (a connection can start
         # between a check and a later open otherwise), but release it before token
-        # counting/formatting: the registry lock blocks every tracked connect/close.
+        # counting/formatting: the reservation blocks every tracked connect to this path.
         with offline_file_access(path, what="preview context reference"):
             early, text = _read_file_reference(ref, path, max_inline_tokens)
     except LiveConnectionError:
@@ -707,7 +707,7 @@ def _file_metadata(path: Path) -> str:
     except OSError:
         return "unknown size"
     try:
-        # A directory preview inspects each entry separately; the registry lock
+        # A directory preview inspects each entry separately; the reservation
         # must cover both its binary sniff and optional line-count read.
         with offline_file_access(path, what="inspect folder entry"):
             # A listing line is a summary, not content: past the cap, byte size conveys
diff --git a/hermes_cli/backup_restore.py b/hermes_cli/backup_restore.py
index c0e262de41..bc60635e63 100644
--- a/hermes_cli/backup_restore.py
+++ b/hermes_cli/backup_restore.py
@@ -332,8 +332,8 @@ def _restore_db_pages(src: Path, dst: Path) -> bool:
             # on main: `/proc/self/fd` shows `state.db-wal (deleted)` right
             # after this fallback ran under a tracked connection).
             # ``offline_file_access`` fails CLOSED when any tracked
-            # connection to *dst* is live and holds the connection-lifecycle
-            # lock across the whole swap so no new connection can appear
+            # connection to *dst* is live and reserves the path across the
+            # whole swap so no new tracked connection to it can appear
             # mid-replace.
             with offline_file_access(dst, what="unlink+move restore of"):
                 tmp = dst.parent / f".{dst.name}.snap_restore"
diff --git a/hermes_cli/session_recovery.py b/hermes_cli/session_recovery.py
index f812c4153c..8c9e9c7b10 100644
--- a/hermes_cli/session_recovery.py
+++ b/hermes_cli/session_recovery.py
@@ -189,7 +189,7 @@ def _disk_space_preflight(source: Path, work_root: Path, output_parent: Optional
 def _copy_source_bundle(source: Path, snapshot_dir: Path) -> tuple[Path, list[str]]:
     """Copy the source DB bundle aside so SQLite never opens the original.
 
-    The whole copy runs inside ``offline_file_access`` (holds the connection-lifecycle lock). Recovery
+    The whole copy runs inside ``offline_file_access`` (reserves the path against new tracked connections). Recovery
     normally runs as its own CLI process against an offline file, so the refusal should never fire; the
     guard keeps this path consistent with ``hermes_state_repair._backup_db_file``.
 
diff --git a/hermes_cli/sqlite_offline_reservations.py b/hermes_cli/sqlite_offline_reservations.py
index d509c8e68c..58733657fc 100644
--- a/hermes_cli/sqlite_offline_reservations.py
+++ b/hermes_cli/sqlite_offline_reservations.py
@@ -3,6 +3,9 @@
 Completion uses an Event rather than reacquiring that mutex: a legacy caller may
 wait for a reservation while recursively owning the registry mutex. No SQLite
 handle can be opened between checking a reservation and registering its handle.
+
+Reservations, like the live-connection registry, are keyed by resolved path: a
+hardlink alias or an ATTACHed database is not recognised as the reserved file.
 """
 from __future__ import annotations
 
diff --git a/hermes_cli/web_routers/files.py b/hermes_cli/web_routers/files.py
index ee838e179d..8580dad114 100644
--- a/hermes_cli/web_routers/files.py
+++ b/hermes_cli/web_routers/files.py
@@ -220,10 +220,10 @@ def _refuse_live_database(target: Path) -> None:
     """Point-in-time 409 before streaming ``target`` while a SQLite connection to it is live.
 
     ``FileResponse`` opens and closes the file in-process, and that raw close cancels the
-    connection's POSIX locks. The registry lock can't be held across a streamed response
+    connection's POSIX locks. The reservation can't be held across a streamed response
     (never across an await/yield), so streamed routes only get this admission check. It
-    takes the global registry lock, which other threads hold across whole-file reads, so
-    call it via ``asyncio.to_thread``."""
+    can wait for another thread's whole-file read of the same path, so call it via
+    ``asyncio.to_thread``."""
     with _serve_offline(target):
         pass
 
@@ -425,7 +425,7 @@ def _read_base64_file(path: Path) -> str:
     """Read and encode a bounded file from a worker thread; 409 while a SQLite connection to it is live."""
     with _serve_offline(path):
         data = path.read_bytes()
-    # Encode after release: only the open/read/close needs the registry lock.
+    # Encode after release: only the open/read/close needs the reservation.
     return base64.b64encode(data).decode("ascii")
 
 
-- 
