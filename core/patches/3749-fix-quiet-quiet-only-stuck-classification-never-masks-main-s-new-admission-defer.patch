From dd75da236bca352235621ca64f3315c8c45385fd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:08:09 +0000
Subject: [PATCH] fix(quiet): quiet-only stuck classification never masks
 main's new admission_deferred hold

main added DispatchResult.admission_deferred (hub claim screen); all_quiet_deferred must treat it as an unrelated hold like the others. RED without the fix in test_stuck_diagnostics_recognize_quiet_narrowly.
---
 hermes_cli/kanban_db_dispatch_stuck.py        | 2 +-
 tests/hermes_cli/test_quiet_gates_dispatch.py | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_dispatch_stuck.py b/hermes_cli/kanban_db_dispatch_stuck.py
index 86ae71183c..58c9cf7f3d 100644
--- a/hermes_cli/kanban_db_dispatch_stuck.py
+++ b/hermes_cli/kanban_db_dispatch_stuck.py
@@ -173,7 +173,7 @@ def all_quiet_deferred(results: Iterable[Optional[Any]]) -> bool:
         return False
     other = ("spawned", "claim_deferred", "capsule_refused", "respawn_guarded", "skipped_ineligible", "owner_down",
              "skipped_per_profile_capped", "skipped_unassigned", "rate_limited", "no_progress_held",
-             "pinned_quota_held", "auto_blocked")
+             "pinned_quota_held", "auto_blocked", "admission_deferred")
     return not any(getattr(res, name, None) for res in ran for name in other) and not any(
         res.at_capacity or res.memory_pressure for res in ran)
 
diff --git a/tests/hermes_cli/test_quiet_gates_dispatch.py b/tests/hermes_cli/test_quiet_gates_dispatch.py
index de015fd2cf..d2cff6475a 100644
--- a/tests/hermes_cli/test_quiet_gates_dispatch.py
+++ b/tests/hermes_cli/test_quiet_gates_dispatch.py
@@ -146,6 +146,7 @@ def test_stuck_diagnostics_recognize_quiet_narrowly():
     for other in (kbd.DispatchResult(claim_deferred=[("t_b", "lease_held")]),
                   kbd.DispatchResult(capsule_refused=[("t_b", "capsule_unregistered")]),
                   kbd.DispatchResult(owner_down=[("t_b", "p", "failed")]),
+                  kbd.DispatchResult(admission_deferred=["t_b"]),
                   kbd.DispatchResult(at_capacity="max_in_progress=1/1"),
                   kbd.DispatchResult(memory_pressure="critical")):
         assert not kbd.all_quiet_deferred([quiet, other])
