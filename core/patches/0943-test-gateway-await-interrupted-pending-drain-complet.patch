From 28e3ab07c0d560bc26ef2950553c3df56cce162a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:04:37 -0700
Subject: [PATCH] test(gateway): await interrupted pending-drain completion
 (#195)

---
 .../test_duplicate_reply_suppression.py       | 21 ++++++++++---------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/tests/gateway/test_duplicate_reply_suppression.py b/tests/gateway/test_duplicate_reply_suppression.py
index a64401be6f..77383fa001 100644
--- a/tests/gateway/test_duplicate_reply_suppression.py
+++ b/tests/gateway/test_duplicate_reply_suppression.py
@@ -99,16 +99,17 @@ class TestBaseInterruptSuppression:
         event_b = _make_event(text="second question")
         adapter._pending_messages[session_key] = event_b
 
-        await adapter._process_message_background(event_a, session_key)
-
-        # The in-band pending-drain now hands off to a fresh task instead
-        # of recursing (#17758).  Wait for that task to finish before
-        # checking the sent list.
-        for _ in range(200):
-            if any(s["content"] == pending_response for s in adapter.sent):
-                break
-            await asyncio.sleep(0.01)
-        await adapter.cancel_background_tasks()
+        try:
+            await adapter._process_message_background(event_a, session_key)
+
+            # The pending drain owns a fresh task (#17758). Await its completion,
+            # not a short send-poll budget followed by premature cancellation.
+            # It may already have finished and released ownership by this point.
+            pending_task = adapter._session_tasks.get(session_key)
+            if pending_task is not None:
+                await asyncio.wait_for(asyncio.shield(pending_task), timeout=30.0)
+        finally:
+            await adapter.cancel_background_tasks()
 
         # The stale response should NOT have been sent.
         stale_sends = [s for s in adapter.sent if s["content"] == stale_response]
-- 
