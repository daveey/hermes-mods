+            assert loops.list_active_loops() == []  # the unchanged silent root listing
+        warned = [r for r in caplog.records if r.name == "hermes_cli.loops" and r.levelno >= logging.WARNING]
+        assert warned == []
+    finally:
+        root_db.close()
