+def _repark(conn, monkeypatch, tid, name, args):
+    _as_worker(monkeypatch, conn, tid)
+    out = _tool(name, args)
+    if out.get("status") == "scheduled":
+        assert kb.unblock_task(conn, tid)
+        with kb.write_txn(conn):
