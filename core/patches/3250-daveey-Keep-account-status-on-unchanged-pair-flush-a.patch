From 3bb2c1f3945e6283bd99ce11aed2472f516c618e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:09:19 +0000
Subject: [PATCH] [daveey] Keep account status on unchanged-pair flush;
 annotate quota detector DB; widen DNS deadline test slack

- adopt_persisted_row adopts only model-scoped state unless the token pair moved, so an
  ordinary flush cannot re-bench a live (re-authenticated) credential with a peer's verdict
  (fixes test_reauthentication_clears_the_persist_failure_quarantine and
  test_revoked_sibling_whose_replacement_was_pushed_meanwhile_recovers_in_the_turn).
- quota_contradictions.db is local evidence, never a board: supported lockguard annotation.
- DNS deadline proof measures from the call (production modules preloaded) with 6s stalls,
  keeping mutant/none bands apart on loaded runners.
---
 agent/credential_pool_model_state.py          | 16 +++++++++-------
 fixture/cache/plugin_hooks.json               |  2 +-
 hermes_cli/kanban_quota_detector.py           |  4 +++-
 .../test_kanban_quota_dns_deadline.py         | 19 +++++++++++--------
 4 files changed, 24 insertions(+), 17 deletions(-)

diff --git a/agent/credential_pool_model_state.py b/agent/credential_pool_model_state.py
index 91939e8e8d..2481093a3f 100644
--- a/agent/credential_pool_model_state.py
+++ b/agent/credential_pool_model_state.py
@@ -58,16 +58,18 @@ def resync_model_state(pool, entry):
 
 
 def adopt_persisted_row(entry, row, pair):
-    """Adopt merged resets/status as well as tokens without dehydrating reference rows."""
+    """Adopt a peer's newer token pair, else only the merged model-scoped state.
+
+    Account-wide status stays with the in-memory entry unless the pair moved: adopting a
+    merged status on an unchanged (or reference-only) row would re-bench a live credential
+    with a peer's or pre-relogin verdict on every ordinary flush."""
     from dataclasses import replace
     from agent.credential_pool import PooledCredential
-    from hermes_cli.auth_pool_merge import _POOL_STATUS_FIELDS
 
     if row is None:
         return entry
-    updates = {field: row.get(field) for field in (*MODEL_STATE_FIELDS, *_POOL_STATUS_FIELDS)}
-    changed = any(getattr(entry, field) != value for field, value in updates.items())
-    if any(pair):
-        return PooledCredential.from_dict(entry.provider, row) if changed or pair != (
-            entry.access_token, entry.refresh_token) else entry
+    if any(pair) and pair != (entry.access_token, entry.refresh_token):
+        return PooledCredential.from_dict(entry.provider, row)
+    updates = {field: row.get(field) or None for field in MODEL_STATE_FIELDS}
+    changed = any((getattr(entry, field) or None) != value for field, value in updates.items())
     return replace(entry, **updates) if changed else entry
diff --git a/fixture/cache/plugin_hooks.json b/fixture/cache/plugin_hooks.json
index 7082a48837..1c1a56c3e7 100644
--- a/fixture/cache/plugin_hooks.json
+++ b/fixture/cache/plugin_hooks.json
@@ -1 +1 @@
-{"version": 1, "fingerprint": "ad9548781c10c26a1b1a73f283000fb2f41e8b9e7de3b7d8f4142b136b10a809", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
+{"version": 1, "fingerprint": "e8b721429371650aa0e8f0aa0194109e861f19dcf00a2c8bc9e69cf2ea5448f5", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
diff --git a/hermes_cli/kanban_quota_detector.py b/hermes_cli/kanban_quota_detector.py
index c22a99c161..1838f3627e 100644
--- a/hermes_cli/kanban_quota_detector.py
+++ b/hermes_cli/kanban_quota_detector.py
@@ -50,7 +50,9 @@ class Detector:
         self.timeout = timeout
 
     def _connect(self):
-        conn = sqlite3.connect(self.path, timeout=self.timeout)
+        # quota_contradictions.db: local evidence/outbox, never a board; board writes
+        # go through the dispatcher owner's supported create_task/add_comment calls.
+        conn = sqlite3.connect(self.path, timeout=self.timeout)  # noqa: kanban-lockguard (not a board)
         conn.execute('CREATE TABLE IF NOT EXISTS observations (scope TEXT, at REAL, accounts TEXT)')
         if 'accounts' not in [r[1] for r in conn.execute('PRAGMA table_info(observations)')]:
             conn.execute('ALTER TABLE observations ADD COLUMN accounts TEXT')
diff --git a/tests/hermes_cli/test_kanban_quota_dns_deadline.py b/tests/hermes_cli/test_kanban_quota_dns_deadline.py
index 9e77d2aa0c..8c0904b0d5 100644
--- a/tests/hermes_cli/test_kanban_quota_dns_deadline.py
+++ b/tests/hermes_cli/test_kanban_quota_dns_deadline.py
@@ -16,37 +16,40 @@ def test_dns_deadline_in_fresh_interpreter_and_mutants(tmp_path, mutant):
     if mutant == 'executor_dns':
         source = source.replace('asyncio.get_running_loop().getaddrinfo = _getaddrinfo', 'pass')
     elif mutant == 'no_kill':
-        source = source.replace('process.kill()', 'process.wait(timeout=5)')
+        source = source.replace('process.kill()', 'process.wait(timeout=10)')
     script = tmp_path / 'probe.py'
     marker = tmp_path / 'resolver-pid'
-    dns_script = f"import os,time; open({str(marker)!r}, 'w').write(str(os.getpid())); time.sleep(3)"
+    started = tmp_path / 'call-started'  # excludes interpreter/import startup under load
+    dns_script = f"import os,time; open({str(marker)!r}, 'w').write(str(os.getpid())); time.sleep(6)"
     script.write_text(
         'import sys, socket, time, types\n'
         f'sys.path.insert(0, {str(Path(recovery.__file__).resolve().parents[1])!r})\n'
         'import httpx\n'
+        'import tools.environments.local  # loaded in production before any probe\n'
         'from types import SimpleNamespace\n'
         'module = types.ModuleType("isolated_recovery")\n'
         f'exec(compile({source!r}, "recovery.py", "exec"), module.__dict__)\n'
         'def stalled(*a, **kw):\n'
-        '    time.sleep(3)\n'
+        '    time.sleep(6)\n'
         '    raise socket.gaierror("controlled DNS failure")\n'
         'socket.getaddrinfo = stalled\n'
         'module._client = lambda timeout: httpx.AsyncClient(timeout=timeout, trust_env=False)\n'
         f'module._DNS_SCRIPT = {dns_script!r}\n'
+        f'open({str(started)!r}, "w").write(repr(time.time()))\n'
         'assert module.completion_succeeds("anthropic", "m", '
         'SimpleNamespace(runtime_api_key="synthetic"), time.monotonic()+0.5) is False\n',
         encoding='utf-8')
-    start = time.monotonic()
     result = subprocess.run([sys.executable, str(script)], capture_output=True,
-                            text=True, encoding='utf-8', timeout=6, check=False,
+                            text=True, encoding='utf-8', timeout=30, check=False,
                             env=build_subprocess_env())
-    elapsed = time.monotonic() - start
     assert result.returncode == 0, result.stderr
     assert not result.stderr
+    # From the call to process exit: the deadline bounds both the call and shutdown.
+    elapsed = time.time() - float(started.read_text())
     if mutant == 'none':
-        assert elapsed < 2.5
+        assert elapsed < 4.0  # deadline 0.5s; slack for spawn+exit on a loaded CI runner
     else:
-        assert elapsed > 2.8  # both mutants violate the same process-exit bound
+        assert elapsed > 5.5  # both mutants violate the same process-exit bound
     if marker.exists():
         assert not Path('/proc/' + marker.read_text()).exists(), 'resolver not reaped'
 
