From 560c849c28ae4fc9b268e2cad851180792fd5315 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:04:53 +0000
Subject: [PATCH] [daveey] kanban: document worktree_retention_hours and seed
 it as None in DEFAULT_CONFIG

Follow-up to PR #2196 review nits (card t_01a1d4e730fb4f56, review t_01a1d4e161be15b9).

1. Docs: the Worktree GC paragraph in website/docs/user-guide/features/kanban.md and the
   kanban_scratch_archive module docstring only named worktree_retention_days. They now
   describe kanban.worktree_retention_hours: an optional non-negative number of hours that,
   when set, takes precedence over worktree_retention_days (0 disables); unset/null keeps the
   days behaviour; an invalid value (bool/str/NaN/inf/negative) disables age-based GC with a
   warning and never falls back to days. Reverse = remove the key.
2. DEFAULT_CONFIG: seed "worktree_retention_hours": None under kanban, so
   `hermes config set kanban.worktree_retention_hours 3` no longer prints an unknown-key
   did-you-mean notice. retention_days() already treats None as unset, so GC semantics are
   unchanged. The two config lines are collapsed to inline comments to keep
   config_defaults.py within its FILE_LINES cap.

Tests:
- New test_seeded_default_is_unset_and_keeps_days_behaviour: DEFAULT_CONFIG holds None, the
  key validates as known, and with no user value retention_days() returns int 7.
  RED on main (KeyError/assert), GREEN here.
- tests/ci/test_docs_drift.py now covers the key: with the seed but without the docs it
  fails listing kanban.worktree_retention_hours; GREEN with the docs.
- tests/hermes_cli/test_config*.py + kanban scratch GC/retention tests: 581 passed.
- scripts/check --base origin/main: 19 checks ok.
---
 hermes_cli/config_defaults.py                      |  4 ++--
 hermes_cli/kanban_scratch_archive.py               |  8 +++++---
 tests/hermes_cli/test_kanban_gc_retention_hours.py | 13 +++++++++++++
 website/docs/user-guide/features/kanban.md         |  6 ++++++
 4 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/config_defaults.py b/hermes_cli/config_defaults.py
index 3262ef4a43..ddea332015 100644
--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -1893,8 +1893,8 @@ DEFAULT_CONFIG = {
         "recovery_card_assignee": "default",  # assignee of the card an automatic recovery files [daveey]
         # Opt-in per-profile broker argv before gh (empty = ordinary login); never include tokens.
         "pr_acceptance": {"gh_command_prefix": []},
-        # Terminal worktrees: archive before reaping; 0 disables age GC; worktree_retention_hours wins if set.
-        "worktree_retention_days": 7,
+        "worktree_retention_days": 7,  # terminal worktrees: archive before reaping; 0 disables age GC
+        "worktree_retention_hours": None,  # null = unset (days apply); hours >= 0 override days when set
         # Auto-subscribe the originating gateway/TUI session to completion + block events when
         # kanban_create is called from a session with a persistent delivery channel. Disable for
         # profiles that prefer explicit kanban_notify-subscribe calls per task.
diff --git a/hermes_cli/kanban_scratch_archive.py b/hermes_cli/kanban_scratch_archive.py
index 7d17657650..4a08704a4f 100644
--- a/hermes_cli/kanban_scratch_archive.py
+++ b/hermes_cli/kanban_scratch_archive.py
@@ -1,9 +1,11 @@
 """Archive-then-remove for aged terminal scratch workspaces holding git clones. [daveey]
 
 Completion cleanup and ``gc_task_scratch`` keep every scratch tree that holds
-Git metadata, so a worker's clone survives its card forever. Past
-``kanban.worktree_retention_days`` this module saves each standalone repo's
-unique work under ``<kanban home>/archive/scratch/<board>/<task>/<relpath>/``:
+Git metadata, so a worker's clone survives its card forever. Past the
+retention window (``kanban.worktree_retention_hours`` when set, else
+``kanban.worktree_retention_days``; see ``kanban_worktree_gc.retention_days``)
+this module saves each standalone repo's unique work under
+``<kanban home>/archive/scratch/<board>/<task>/<relpath>/``:
 
 * ``commits.bundle``: refs and HEAD not reachable from the repo's
   remote-tracking refs (omitted when there are none), verified before use;
diff --git a/tests/hermes_cli/test_kanban_gc_retention_hours.py b/tests/hermes_cli/test_kanban_gc_retention_hours.py
index f289c313a4..d5685a5b68 100644
--- a/tests/hermes_cli/test_kanban_gc_retention_hours.py
+++ b/tests/hermes_cli/test_kanban_gc_retention_hours.py
@@ -54,6 +54,19 @@ def test_unset_hours_keeps_days_type_exactly(board):
     assert value == 1 and type(value) is int
 
 
+def test_seeded_default_is_unset_and_keeps_days_behaviour(board):
+    """DEFAULT_CONFIG seeds hours as None (so `hermes config set` knows the key); with no user
+    value the merged config still yields the plain 7-day window."""
+    from hermes_cli.config import _validate_config_key
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    assert DEFAULT_CONFIG["kanban"]["worktree_retention_hours"] is None
+    assert _validate_config_key("kanban.worktree_retention_hours") == (True, None)
+    _config("kanban: {}\n")
+    value = gc.retention_days()
+    assert value == DEFAULT_CONFIG["kanban"]["worktree_retention_days"] == 7 and type(value) is int
+
+
 @pytest.mark.parametrize("raw", ["-1", "-0.5", "'3'", "true", "false", ".nan", ".inf", "[3]", "{h: 3}"])
 def test_invalid_hours_disables_and_warns(board, caplog, raw):
     # A valid days key must not mask a bad hours key: the operator asked for hours.
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index 13f01b6089..4e69f44be9 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -1375,6 +1375,12 @@ Worktree GC also covers done, failed, and cancelled tasks. After
 worktrees may be removed even with unpushed commits: their HEAD and history are
 first retained in the repository at `refs/hermes/kanban-archive/<task-id>/<commit>`.
 Zero disables this age-based archival; legacy clean, fully-pushed cleanup remains.
+For a sub-day window set `kanban.worktree_retention_hours` to a non-negative number
+of hours (fractions allowed, e.g. `3` or `1.5`); when set it takes precedence over
+`worktree_retention_days`, and `0` disables age-based archival. Unset or `null` (the
+default) keeps the days behaviour. An invalid value (a boolean, a string, NaN,
+infinity or a negative number) disables age-based archival and logs a warning; it
+never falls back to the days key. Remove the key to return to the days window.
 Dirty trees, locked trees, active tasks, active children and live shared workspaces
 are preserved. Custom branches remain; generated `wt/` branches are pruned only
 when their tip still matches the archived commit.
