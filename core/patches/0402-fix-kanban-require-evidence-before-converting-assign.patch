diff --git a/hermes_cli/kanban_assignment_routing.py b/hermes_cli/kanban_assignment_routing.py
index bbe56299ad..91634b09e7 100644
--- a/hermes_cli/kanban_assignment_routing.py
+++ b/hermes_cli/kanban_assignment_routing.py
@@ -35,10 +35,16 @@ class AssignmentRoutingError(ValueError):
     code = 'no_capable_supervisor'
 
 
-def classify(task, kind, reason):
-    """Require both a narrow worker-local reason and independent policy evidence."""
-    if kind == 'assignment' and _HUMAN_ACCESS.search(reason or ''):
-        return 'capability', 'human_access_request'
+def classify(task, kind, reason, *, human_request=None):
+    """Use explicit request evidence, never auth vocabulary, to stop assignment repair."""
+    # Routing grants no execution authorization. Prose may describe denied or
+    # hypothetical authentication routes; only validated actionability evidence
+    # makes this a human request rather than supervised operational recovery.
+    from hermes_cli.kanban_human_request import validate_human_request
+    if validate_human_request(human_request, kind=kind) is not None:
+        return ('capability', 'human_access_request') if kind == 'assignment' else (kind, None)
+    if kind == 'assignment':
+        return kind, None
     if (kind != 'capability' or _HUMAN_ACCESS.search(reason or '')
             or not _WORKER_MISMATCH.fullmatch((reason or '').strip())):
         return kind, None
diff --git a/hermes_cli/kanban_block_routing.py b/hermes_cli/kanban_block_routing.py
index 4a22ca9a1b..cf6a6dbec7 100644
--- a/hermes_cli/kanban_block_routing.py
+++ b/hermes_cli/kanban_block_routing.py
@@ -53,7 +53,7 @@ def has_sticky_block(conn: sqlite3.Connection, task_id: str) -> bool:
     return bool(trip) and bool(_json_dict(trip["payload"]).get("sticky"))
 
 
-def classify_stop(conn, task_id, kind, reason, blocker_id):
+def classify_stop(conn, task_id, kind, reason, blocker_id, *, human_request=None):
     """Compose continuation recovery with assignment routing without changing human asks."""
     from hermes_cli import kanban_assignment_routing
     from hermes_cli.kanban_continuation_recovery import is_exhausted_budget_block
@@ -61,8 +61,9 @@ def classify_stop(conn, task_id, kind, reason, blocker_id):
 
     if is_exhausted_budget_block(conn, task_id, kind, reason):
         return "transient", "continuation_exhausted", True
-    if kind in {"capability", "assignment"} and not blocker_id:
-        kind, rekind_reason = kanban_assignment_routing.classify(get_task(conn, task_id), kind, reason)
+    if kind in {"capability", "assignment"} and (human_request is not None or not blocker_id):
+        kind, rekind_reason = kanban_assignment_routing.classify(
+            get_task(conn, task_id), kind, reason, human_request=human_request)
         return kind, rekind_reason, False
     return kind, None, False
 
