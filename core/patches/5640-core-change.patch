From a6a47bdc4eb6666dbad36c016b0a4436a3146574 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:42:20 +0000
Subject: [PATCH] test(fairness): cover BLOB export TypeError gap [daveey]

---
 scripts/kanban_fairness.py                            |  3 +--
 tests/hermes_cli/test_kanban_fairness_clock_bounds.py | 11 +++++++++++
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/scripts/kanban_fairness.py b/scripts/kanban_fairness.py
index b4a22e5204..074ba591e5 100644
--- a/scripts/kanban_fairness.py
+++ b/scripts/kanban_fairness.py
@@ -26,7 +26,6 @@ from __future__ import annotations
 import argparse
 import hashlib
 import json
-import math
 import subprocess
 import sys
 
@@ -81,7 +80,7 @@ def _arm(args) -> int:
     clock_error_ns = None
     if args.writer_clocks:
         scaled = args.clock_error_s * 1_000_000_000
-        if not math.isfinite(scaled) or not 0 <= scaled < 2**63:
+        if not 0 <= scaled < 2**63:
             raise ValueError("clock-error-s must yield a nonnegative signed-64-bit nanosecond bound")
         clock_error_ns = int(scaled)
     if args.db:
diff --git a/tests/hermes_cli/test_kanban_fairness_clock_bounds.py b/tests/hermes_cli/test_kanban_fairness_clock_bounds.py
index 1338fba627..c3a1734b10 100644
--- a/tests/hermes_cli/test_kanban_fairness_clock_bounds.py
+++ b/tests/hermes_cli/test_kanban_fairness_clock_bounds.py
@@ -59,6 +59,17 @@ def test_deep_persisted_clock_reports_gap_without_advancing(conn, tmp_path, monk
     assert receipts["journal_seq"] == 0
 
 
+def test_blob_task_id_reports_type_error_gap_without_advancing(conn, tmp_path):
+    kb.create_task(conn, title="blob", assignee="a")
+    journal.arm(conn, "blob")
+    # SQLite TEXT affinity retains BLOB values; export must record the failure
+    # rather than escape or advance past evidence it could not serialize.
+    conn.execute(f"UPDATE {journal.JOURNAL} SET task_id=?", (b"\xff\x00",))
+    receipts = store.drain(conn, tmp_path)
+    assert {"code": "export_failed", "detail": "TypeError"} in receipts["gaps"]
+    assert receipts["journal_seq"] == 0
+
+
 def test_pre_upgrade_session_can_be_inspected_and_sealed(conn):
     journal.arm(conn, "old")
     conn.execute(f"ALTER TABLE {journal.SESSION} DROP COLUMN clock_error_ns")
-- 
