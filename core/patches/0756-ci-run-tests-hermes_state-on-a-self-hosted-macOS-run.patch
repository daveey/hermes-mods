From 0cca76224de18271d2655b399be38f0735933534 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:50:36 -0700
Subject: [PATCH] ci: run tests/hermes_state on a self-hosted macOS runner
 (non-blocking lane)

---
 .github/workflows/hermes-state-macos.yml | 62 ++++++++++++++++++++++++
 1 file changed, 62 insertions(+)
 create mode 100644 .github/workflows/hermes-state-macos.yml

diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
new file mode 100644
index 0000000000..dd56f6e4f9
--- /dev/null
+++ b/.github/workflows/hermes-state-macos.yml
@@ -0,0 +1,62 @@
+name: hermes_state (macOS)
+
+# Runs tests/hermes_state/ on a real macOS host. tests-os.yml only runs
+# ``-m platforms`` tests there, so unmarked tests never executed on macOS and a
+# darwin-only divergence (65 failures, fixed in a408ba1b05) stayed green for
+# weeks. This lane closes that gap.
+#
+# Runner: self-hosted on the Mac mini (labels self-hosted, macOS, hermes-state),
+# a dedicated launchd user agent (com.daveey.ci-runner-hermes-state) with its own
+# work dir, one job at a time. GitHub-hosted runners are not used (account
+# billing refusal), so this lane does not depend on billing.
+#
+# NON-BLOCKING: deliberately not called from ci.yaml and not in its aggregate
+# gate. After a week of green main runs, add it as a required check.
+#
+# HERMES_HOME points at a throwaway temp dir so the lane can never touch the
+# live ~/.hermes of anything else running on the mini.
+
+on:
+  push:
+    branches: [main, 'ci-probe/**']
+    paths:
+      - 'hermes_state*'
+      - 'hermes_state/**'
+      - 'tests/hermes_state/**'
+      - 'tests/conftest.py'
+      - 'scripts/run_tests*'
+      - 'scripts/_activation.sh'
+      - 'scripts/run-in-hermes-env'
+      - 'pyproject.toml'
+      - 'uv.lock'
+      - 'pm/**'
+      - '.github/workflows/hermes-state-macos.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: hermes-state-macos-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  hermes-state-macos:
+    name: tests/hermes_state (macOS, mini)
+    runs-on: [self-hosted, macOS, hermes-state]
+    timeout-minutes: 30
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+
+      - name: Run tests/hermes_state
+        shell: bash
+        run: |
+          set -euo pipefail
+          export HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/hermes-home.XXXXXX")"
+          trap 'rm -rf "$HERMES_HOME"' EXIT
+          scripts/run_tests.sh tests/hermes_state/ -j 4
+        env:
+          OPENROUTER_API_KEY: ''
+          OPENAI_API_KEY: ''
+          NOUS_API_KEY: ''
-- 
2.55.0

