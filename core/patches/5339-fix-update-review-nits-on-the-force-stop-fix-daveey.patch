From becc351317d6860bf0292993e56943ac0a812f58 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:38:11 -0800
Subject: [PATCH] fix(update): review nits on the --force stop fix [daveey]

Tests stand in only launchctl (other subprocess.run calls pass through), and _stop_job's PID wait
checks birth time so a recycled PID is not mistaken for the gateway.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/update_cmd_posix_pause.py       | 2 +-
 tests/hermes_cli/test_update_force_stop.py | 9 ++++++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/update_cmd_posix_pause.py b/hermes_cli/update_cmd_posix_pause.py
index 1f660c1260..5a24d60513 100644
--- a/hermes_cli/update_cmd_posix_pause.py
+++ b/hermes_cli/update_cmd_posix_pause.py
@@ -506,7 +506,7 @@ def _stop_job(job: dict, *, drained: bool = False) -> None:
     result = subprocess.run(["launchctl", "bootout", f"{job['domain']}/{job['label']}"],
                             capture_output=True, text=True, encoding="utf-8", errors="replace",
                    stdin=subprocess.DEVNULL, timeout=90, check=False)
-    _wait_gone([job["pid"]], 30.0)
+    _wait_gone([job["pid"]], 30.0, {job["pid"]: job.get("ct")})  # birth time: a recycled PID is not the gateway
     # KeepAlive may have respawned the drained gateway already: the job, not the old PID, decides.
     if result.returncode != 0 and (_locate_launchd_gateway_service(job["label"])[1] or 0) > 0:
         raise PauseRefused(f"launchctl bootout {job['label']} failed: {(result.stderr or '').strip()}", [job["label"]])
diff --git a/tests/hermes_cli/test_update_force_stop.py b/tests/hermes_cli/test_update_force_stop.py
index fe946aca33..d733b95ed2 100644
--- a/tests/hermes_cli/test_update_force_stop.py
+++ b/tests/hermes_cli/test_update_force_stop.py
@@ -233,9 +233,12 @@ def test_force_stops_a_launchd_gateway_through_the_real_stop_job(monkeypatch, tm
     proc = _child(ignore_term=False)
     calls = []
 
+    real_run = subprocess.run
+
     def run(cmd, **kw):
+        if cmd[:1] != ["launchctl"]:
+            return real_run(cmd, **kw)  # only launchctl is stood in
         calls.append(cmd)
-        assert cmd[:2] == ["launchctl", "bootout"], cmd
         proc.terminate()
         return subprocess.CompletedProcess(cmd, 0, "", "")
 
@@ -258,7 +261,11 @@ def test_a_failed_launchd_bootout_with_a_respawned_gateway_is_refused(monkeypatc
     from hermes_cli import gateway as gateway_mod
     proc = _child(ignore_term=False)
 
+    real_run = subprocess.run
+
     def run(cmd, **kw):
+        if cmd[:1] != ["launchctl"]:
+            return real_run(cmd, **kw)  # only launchctl is stood in
         proc.terminate()  # the old PID goes away...
         return subprocess.CompletedProcess(cmd, 5, "", "Boot-out failed: 5: Input/output error")
 
