From 15bd9424c066655b58355ffd4904c2049ad7b18c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:17:40 +0000
Subject: [PATCH] ci: give pushes to main their own concurrency group so a
 newer push never cancels or replaces a run in flight (#29)

---
diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 6ee59983a3784f25266ab4f60ebad697973c2b14..71d045f468bcd69941560973c887fcc5caa531de 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -54,7 +54,7 @@ permissions:
 # cancelled: its group is github.run_id. PRs collapse per-PR; pushes use the
 # ref as before.
 concurrency:
-  group: ci-${{ inputs.release == true && github.run_id || (github.event_name == 'pull_request' && github.event.pull_request.number || github.ref) }}
+  group: ci-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || (github.event_name == 'pull_request' && github.event.pull_request.number || github.ref) }}
   cancel-in-progress: ${{ inputs.release != true && github.event_name == 'pull_request' }}
 
 jobs:
diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
index d049cce0124e6a1bbe7bc4048cff2adc4ce7eee2..c87e2614b05c098f68bb3c6b6d32b566ea7616e3 100644
--- a/.github/workflows/docker.yml
+++ b/.github/workflows/docker.yml
@@ -58,7 +58,7 @@ permissions:
 # (test/publish) of this workflow live inside ONE parent run, and a
 # shared group would cancel the parent mid-release.
 concurrency:
-  group: docker-${{ github.event.pull_request.number || github.ref }}-${{ inputs.release-phase || 'standalone' }}
+  group: docker-${{ github.event.pull_request.number || (github.ref == 'refs/heads/main' && github.run_id) || github.ref }}-${{ inputs.release-phase || 'standalone' }}
   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 env:
diff --git a/.github/workflows/install-e2e.yml b/.github/workflows/install-e2e.yml
index 409c63d964c63706ae09510a375da4110f6a73e1..84ecaa32dc92914db643b824cb328c53cdebd6a6 100644
--- a/.github/workflows/install-e2e.yml
+++ b/.github/workflows/install-e2e.yml
@@ -120,7 +120,7 @@ permissions:
 # github.run_id so a parent rerun cannot kill this child mid-flight. The
 # manual runs keep ref-scoped collapse.
 concurrency:
-  group: install-e2e-${{ inputs.release == true && github.run_id || github.ref }}
+  group: install-e2e-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || github.ref }}
   cancel-in-progress: ${{ inputs.release != true }}
 
 env:
diff --git a/.github/workflows/js-autofix.yml b/.github/workflows/js-autofix.yml
index 6359d284a527e7cc76d2d0a1323bf3cd7eb63fd6..e2ac04958da060b0e0ae8434eb47eb9a1f044b8a 100644
--- a/.github/workflows/js-autofix.yml
+++ b/.github/workflows/js-autofix.yml
@@ -51,7 +51,7 @@ permissions:
   contents: read # default; apply-patch job overrides to write
 
 concurrency:
-  group: ts-autofix-${{ github.ref }}
+  group: ts-autofix-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
   cancel-in-progress: true
 
 jobs:
diff --git a/.github/workflows/live-providers.yml b/.github/workflows/live-providers.yml
index 51417a911713d766e7b0e7e0dc29543944096522..3695838faae5d2aa156c05e897d2439137a12a40 100644
--- a/.github/workflows/live-providers.yml
+++ b/.github/workflows/live-providers.yml
@@ -27,7 +27,7 @@ permissions:
 
 # One live run per ref at a time; never cancel a release-tag gate half way.
 concurrency:
-  group: live-providers-${{ github.ref }}
+  group: live-providers-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
   cancel-in-progress: false
 
 jobs:
diff --git a/.github/workflows/nix.yml b/.github/workflows/nix.yml
index 41a6f08324ade6781c310e608ce3099ab0bbf8db..342d6abd852d9ce383e86472aaee6e391dd8d8d3 100644
--- a/.github/workflows/nix.yml
+++ b/.github/workflows/nix.yml
@@ -40,7 +40,7 @@ permissions:
 # cancel-in-progress is false there — each run saves the store cache that
 # later PRs restore from.
 concurrency:
-  group: nix-${{ inputs.release == true && github.run_id || github.event.pull_request.number || github.ref }}
+  group: nix-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || github.event.pull_request.number || github.ref }}
   cancel-in-progress: ${{ inputs.release != true && github.event_name == 'pull_request' }}
 
 env:
diff --git a/.github/workflows/pm-bundle.yml b/.github/workflows/pm-bundle.yml
index 686b5c83ecc6ed0a3c3c010094f3bfc5a3054dd3..62b990cacc84366c1b44190ffcf883830dda4b8e 100644
--- a/.github/workflows/pm-bundle.yml
+++ b/.github/workflows/pm-bundle.yml
@@ -51,7 +51,7 @@ permissions:
 # A workflow_call run (stable release) is never cancelled: its group uses
 # github.run_id so a parent rerun cannot kill this child mid-flight.
 concurrency:
-  group: pm-bundle-${{ inputs.release == true && github.run_id || github.ref }}
+  group: pm-bundle-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || github.ref }}
   cancel-in-progress: ${{ inputs.release != true }}
 
 jobs:
diff --git a/.github/workflows/sandbox-image.yml b/.github/workflows/sandbox-image.yml
index 742c76ff7ee472a0dd1ec7f8af65baf0eea28784..4e2dcbe6f6bd8b6c0c044faf81515ba95f2ebacf 100644
--- a/.github/workflows/sandbox-image.yml
+++ b/.github/workflows/sandbox-image.yml
@@ -30,7 +30,7 @@ permissions:
   contents: read
 
 concurrency:
-  group: sandbox-image-${{ github.event.pull_request.number || github.ref }}
+  group: sandbox-image-${{ github.event.pull_request.number || (github.ref == 'refs/heads/main' && github.run_id) || github.ref }}
   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 env:
diff --git a/.github/workflows/termux-verify.yml b/.github/workflows/termux-verify.yml
index 8cb11bdc66a6feee83fed6c4e20c5a069fa71571..564eb8863abf5dba9bde136c11805023978631b1 100644
--- a/.github/workflows/termux-verify.yml
+++ b/.github/workflows/termux-verify.yml
@@ -36,7 +36,7 @@ permissions:
 # A workflow_call run (stable release) is never cancelled: its group uses
 # github.run_id so a parent rerun cannot kill this child mid-flight.
 concurrency:
-  group: termux-verify-${{ inputs.release == true && github.run_id || github.ref }}
+  group: termux-verify-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || github.ref }}
   cancel-in-progress: ${{ inputs.release != true }}
 
 jobs:
diff --git a/.github/workflows/windows-bundle-sdk.yml b/.github/workflows/windows-bundle-sdk.yml
index dc54b1d61b484dea78700734e358c78001ec10b6..a1f510de7d5bb2a3b44404139a1d9f200bccbc7e 100644
--- a/.github/workflows/windows-bundle-sdk.yml
+++ b/.github/workflows/windows-bundle-sdk.yml
@@ -18,7 +18,7 @@ on:
 permissions:
   contents: read
 concurrency:
-  group: windows-bundle-sdk-${{ github.ref }}
+  group: windows-bundle-sdk-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
   cancel-in-progress: true
 jobs:
   windows-bundle-tools:
diff --git a/.github/workflows/windows-venv-e2e.yml b/.github/workflows/windows-venv-e2e.yml
index a859d4fd237db2d04861388a27ad0b59b79be220..b2d9c8b8ef738c3b51ff8561cf2c69aa71aadb31 100644
--- a/.github/workflows/windows-venv-e2e.yml
+++ b/.github/workflows/windows-venv-e2e.yml
@@ -36,7 +36,7 @@ permissions:
 # of cancelling this child mid-flight. wine2e push runs keep ref-scoped
 # collapse as before.
 concurrency:
-  group: windows-venv-e2e-${{ inputs.release == true && github.run_id || github.ref }}
+  group: windows-venv-e2e-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || github.ref }}
   cancel-in-progress: ${{ inputs.release != true }}
 
 jobs:
-- 
