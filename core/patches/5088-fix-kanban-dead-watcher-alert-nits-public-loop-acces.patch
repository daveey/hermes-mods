From 5ed8e931ac05683bf38624b6560957db40b30952 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 08:42:54 +0000
Subject: [PATCH] fix(kanban): dead-watcher alert nits - public loop accessor,
 card body wording [daveey]

- kanban_sync_claims.loop_running_here(): the alert no longer reads claims._STATE.
- Card body: the sync loop crashed and has not completed a round for N min (the
  supervisor retries it every 5 min with #3759), not that the supervisor gave up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_sync_claims.py               |  6 ++++++
 hermes_cli/kanban_sync_watcher_alert.py        | 18 +++++++++---------
 .../test_kanban_sync_watcher_alert.py          |  6 ++++++
 3 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_sync_claims.py b/hermes_cli/kanban_sync_claims.py
index 1942dc4e60..cb688f5977 100644
--- a/hermes_cli/kanban_sync_claims.py
+++ b/hermes_cli/kanban_sync_claims.py
@@ -73,6 +73,12 @@ def loop_started() -> None:
     _write()
 
 
+def loop_running_here() -> bool:
+    """This process's sync loop is running now (between :func:`loop_started` and :func:`loop_stopped`)."""
+    with _STATE.lock:
+        return _STATE.loop
+
+
 def loop_stopped() -> None:
     """Release local readiness when a sync tenure ends, including normal return and crashes."""
     with _STATE.lock:
diff --git a/hermes_cli/kanban_sync_watcher_alert.py b/hermes_cli/kanban_sync_watcher_alert.py
index f9f98c7164..6349cf1461 100644
--- a/hermes_cli/kanban_sync_watcher_alert.py
+++ b/hermes_cli/kanban_sync_watcher_alert.py
@@ -71,11 +71,12 @@ def incident_key(host: str, since: float) -> str:
     return f"{KEY_PREFIX}:{host}:{int(since)}"
 
 
-def _body(host: str, why: str, since: float, info: dict) -> str:
+def _body(host: str, why: str, since: float, info: dict, now: float) -> str:
     when = time.strftime("%Y-%m-%d %H:%M:%S %Z", time.localtime(since))
+    minutes = max(0, int((now - since) // 60))
     return "\n".join([
-        f"The Kanban sync watcher on **{host}** has been down since {when} ({why}). The gateway supervisor "
-        "stopped restarting it, so this host neither pushes nor pulls; dispatch stays on "
+        f"The Kanban sync loop on **{host}** crashed at {when} ({why}) and has not completed a round for "
+        f"{minutes} min, so this host neither pushes nor pulls; dispatch stays on "
         "`claim_deferred(sync_first_round)`. The replica-stale alarm files through the local outbox, which "
         "cannot reach the Board while sync is dead — this card is the courier path that still can.",
         "",
@@ -84,7 +85,7 @@ def _body(host: str, why: str, since: float, info: dict) -> str:
         f"- origin/main: `{info.get('origin_main_sha') or 'unknown'}`",
         "",
         "Do: 1) `hermes kanban sync status` on that host; 2) recover with a core that includes the crash fix "
-        "(or restart the gateway once the cause is gone); 3) done when status shows `running: yes` and the "
+        "(the supervisor retries the loop, or restart the gateway once the cause is gone); 3) done when status shows `running: yes` and the "
         "dispatcher has spawned a card. Precedent: t_eeeeee000000001f.",
     ])
 
@@ -178,7 +179,7 @@ def _report(host, why, since, runner, hub_cli, info, now) -> Optional[str]:
         return rid
     rid = key
     title = f"Kanban sync watcher dead on {host} for 5+ min"
-    argv = [hub_cli, "create-task", HUB, title, "--body", _body(host, why, since, info), "--assignee", "default",
+    argv = [hub_cli, "create-task", HUB, title, "--body", _body(host, why, since, info, now), "--assignee", "default",
             "--origin-session", "", "--id", rid, "--option", f"idempotency_key={json.dumps(key)}",
             "--option", "priority=900"]
     rc, out, err = runner(argv)
@@ -203,10 +204,9 @@ def check(*, now: Optional[float] = None, runner: Optional[Callable[[list[str]],
 def loop_running() -> bool:
     """A sync loop runs now: this process's (the dispatcher and the sync watcher share the gateway process),
     or another live process holds the host ``.sync.lock``. A crashed loop releases that lock."""
-    from hermes_cli import kanban_sync_claims as claims
-    with claims._STATE.lock:
-        if claims._STATE.loop:
-            return True
+    from hermes_cli.kanban_sync_claims import loop_running_here
+    if loop_running_here():
+        return True
     try:
         from gateway.kanban_singleton import holder_info
         from hermes_cli import kanban_db as kb
diff --git a/tests/hermes_cli/test_kanban_sync_watcher_alert.py b/tests/hermes_cli/test_kanban_sync_watcher_alert.py
index 056268482e..a83ea7ba91 100644
--- a/tests/hermes_cli/test_kanban_sync_watcher_alert.py
+++ b/tests/hermes_cli/test_kanban_sync_watcher_alert.py
@@ -83,6 +83,7 @@ def test_crash_at_five_minutes_opens_one_hub_card_through_the_courier_only(home,
                       "--body", body, "--assignee", "default", "--origin-session", "", "--id", KEY,
                       "--option", f'idempotency_key="{KEY}"', "--option", "priority=900"]
     assert "ContainmentRefused" in body and "0362a20c0e" in body and "a99783a19e" in body
+    assert "has not completed a round for 5 min" in body and "stopped restarting" not in body
     # The local default-board outbox path (kanban_db.create_task) is not used.
     assert local == []
 
@@ -105,6 +106,11 @@ def test_no_card_while_a_sync_loop_is_running(home):
     assert _check(hub, SINCE + 900) == KEY
 
 
+def test_loop_running_here_follows_the_loop_lifecycle(home):
+    assert [claims.loop_running_here(), claims.loop_started(), claims.loop_running_here(), claims.loop_stopped(),
+            claims.loop_running_here()] == [False, None, True, None, False]
+
+
 def test_no_card_while_another_process_holds_the_sync_lock(home, monkeypatch):
     from gateway import kanban_singleton
     _crash()
-- 
2.43.0

