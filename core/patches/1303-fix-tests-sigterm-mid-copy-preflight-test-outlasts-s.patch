From 7f5538e27a26a415b8bcf0057e438389fa52e61d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 17:37:20 +0000
Subject: [PATCH] fix(tests): sigterm-mid-copy preflight test outlasts starved
 runner; lock wait configurable for the standalone script

---
 hermes_cli/backup_sqlite.py                       | 8 +++++---
 tests/hermes_cli/test_backup_preflight_staging.py | 4 +++-
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/backup_sqlite.py b/hermes_cli/backup_sqlite.py
index 2ea33a855d..3cfc66cc06 100644
--- a/hermes_cli/backup_sqlite.py
+++ b/hermes_cli/backup_sqlite.py
@@ -226,7 +226,7 @@ def _reclaim_abandoned_staging(home: Path, prefix: str) -> None:
                 staged.unlink()
 
 
-def preflight_state_db(home: Path) -> dict:
+def preflight_state_db(home: Path, *, busy_timeout_seconds: float = 10.0) -> dict:
     """Publish an emergency snapshot; do not prune recovery files on failure."""
     source = home / "state.db"
     if not source.exists():
@@ -239,7 +239,7 @@ def preflight_state_db(home: Path) -> dict:
     # cleanup below; _safe_copy_db creates it owner-only and refuses a symlink.
     staged = home / f"{prefix}{stamp}-{os.getpid()}.partial"
     try:
-        if not _safe_copy_db(source, staged):
+        if not _safe_copy_db(source, staged, timeout_seconds=busy_timeout_seconds):
             raise RuntimeError("SQLite safe copy failed; previous emergency snapshots were retained")
         connection = sqlite3.connect(str(staged))
         try:
@@ -266,4 +266,6 @@ if __name__ == "__main__":
     # The Desktop stops a pre-flight past its deadline with SIGTERM; exit through
     # the staging cleanup instead of dying with a full-size .partial left behind.
     signal.signal(signal.SIGTERM, lambda signum, _frame: sys.exit(128 + signum))
-    print(json.dumps(preflight_state_db(Path(sys.argv[1]))))
+    # Tests hold the source locked as a barrier and need the lock wait to outlast a starved runner.
+    _busy = float(os.environ.get("HERMES_PREFLIGHT_BUSY_TIMEOUT_SECONDS") or 10.0)
+    print(json.dumps(preflight_state_db(Path(sys.argv[1]), busy_timeout_seconds=_busy)))
diff --git a/tests/hermes_cli/test_backup_preflight_staging.py b/tests/hermes_cli/test_backup_preflight_staging.py
index 56ae824255..e020d080a5 100644
--- a/tests/hermes_cli/test_backup_preflight_staging.py
+++ b/tests/hermes_cli/test_backup_preflight_staging.py
@@ -41,8 +41,10 @@ def test_sigterm_mid_copy_removes_the_staging_copy(tmp_path):
     holder = sqlite3.connect(home / "state.db", isolation_level=None)
     holder.execute("BEGIN EXCLUSIVE")
     try:
+        # The child's own 10s lock deadline must not expire while a starved runner delays the SIGTERM.
+        env = {**os.environ, "HERMES_PREFLIGHT_BUSY_TIMEOUT_SECONDS": "600"}
         proc = subprocess.Popen([sys.executable, "-I", "-S", str(SCRIPT), str(home)],
-                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
         try:
             wait_until(lambda: _staging(home) or proc.poll() is not None, timeout=30, what="the staging copy")
             assert proc.poll() is None and _staging(home), "the pre-flight must still be copying"
-- 
