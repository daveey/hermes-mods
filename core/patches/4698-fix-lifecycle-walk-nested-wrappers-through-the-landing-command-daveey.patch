From ff9060bba0f0e05f19d411a6590e156ca1caa0e3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 05:56:27 +0000
Subject: [PATCH] fix(lifecycle): walk nested wrappers through the landing
 command [daveey]

---
 cron/lifecycle_guard_nested_shells.py          |  7 +++----
 .../test_lifecycle_guard_session_aliases.py    | 18 ++++++++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 6655d9d3703a537af44eb5d91108db4ebde0375e..35e5bac6f3114f45cec9d2205de4fdf5979cd9ff 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -15,7 +15,6 @@ from pathlib import Path
 from typing import TYPE_CHECKING, Optional
 
 from cron.lifecycle_guard import (
-    _MAX_PREFIX_PEELS,
     _REDIRECTION,
     _SHELL_EXECUTABLES,
     _command_token_index,
@@ -238,9 +237,9 @@ def _nested_shell_input(view: list[str]) -> Optional[tuple[str, Optional[str]]]:
     ``nice sudo -i``, ``sudo su - bob``): each may itself be the shell launcher."""
     index = _command_token_index(view)
     login_exec = False
-    for _ in range(_MAX_PREFIX_PEELS):
-        if index is None or index >= len(view):
-            return None
+    # Every peel advances index: input length bounds the walk without hiding a shell
+    # at (or beyond) an arbitrary wrapper-count limit.
+    while index is not None and index < len(view):
         name = _executable_name(view[index])
         found = _launcher_shell_input(view, index, name)
         if found is not None:
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 6864178cd44ccb6e99ae1dc17904e15ddd158986..62d7517221f01be57a039ba5de3b515ca6154fa8 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -412,6 +412,24 @@ def test_continued_process_opener_inert_text(tmp_path, live_kanban_db, count, wr
         assert scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=names) == (False, None)
 
 
+@pytest.mark.parametrize("count", [7, 8, 9, 16])
+@pytest.mark.parametrize("shape", [
+    "{prefix}bash -l < {script}",
+    "{prefix}su -l bob < {script}",
+    "{prefix}sudo -i < {script}",
+    "cat {script} | {prefix}su -l bob",
+    "{{ {prefix}su -l bob; }} < {script}",
+    "{prefix}su -l bob <<'EOF'\nt ( bash {db} )\nEOF",
+])
+def test_nested_shell_wrapper_boundary(tmp_path, live_kanban_db, count, shape):
+    script = tmp_path / "inner.sh"
+    script.write_text(f"t ( bash {live_kanban_db} )\n")
+    text = shape.format(prefix="nice " * count, script=script, db=live_kanban_db)
+    for names in (frozenset({"zz"}), None):
+        unsafe, refusal = scan_gateway_lifecycle(text, cwd=str(tmp_path), session_aliases=names)
+        assert unsafe and refusal and "SQLite" in refusal
+
+
 @pytest.mark.parametrize("shape", _NESTED_FOREIGN_SHELLS + [
     shape.replace("<(", "<" + "\\\n" * count + "(")
     for shape in _NESTED_FOREIGN_SHELLS if "<(" in shape
