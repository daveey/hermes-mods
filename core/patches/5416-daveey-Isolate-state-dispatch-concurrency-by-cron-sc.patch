---
 .github/workflows/state-contract-dispatch.yml | 6 +++---
 tests/ci/test_state_contract_dispatch.py      | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/state-contract-dispatch.yml b/.github/workflows/state-contract-dispatch.yml
index 126b3f3124..99d39b536c 100644
--- a/.github/workflows/state-contract-dispatch.yml
+++ b/.github/workflows/state-contract-dispatch.yml
@@ -62,9 +62,9 @@ permissions:
   contents: read
 
 concurrency:
-  # One group per event, so a scheduled or manual run never cancels a push run: ci_main_watch reads the newest
-  # push run on main, and a cancelled one with no newer push run reads as red.
-  group: state-contract-dispatch-${{ github.event_name }}
+  # Separate events and cron schedules: the hourly canary must not cancel the daily backstop.
+  # Keep push runs separate too: ci_main_watch reads a cancelled push with no newer push as red.
+  group: state-contract-dispatch-${{ github.event_name }}-${{ github.event.schedule }}
   cancel-in-progress: true
 
 jobs:
diff --git a/tests/ci/test_state_contract_dispatch.py b/tests/ci/test_state_contract_dispatch.py
index e5e06d7745..dff2e1c288 100644
--- a/tests/ci/test_state_contract_dispatch.py
+++ b/tests/ci/test_state_contract_dispatch.py
@@ -133,5 +133,5 @@ def test_workflow_wires_script_and_crons():
     assert re.search(r"- cron: '\d+ \* \* \* \*'", text), "hourly cron missing"
     assert "scripts/ci/state_contract_dispatch.sh" in text
     assert "SCHEDULE_CRON: ${{ github.event.schedule }}" in text
-    assert "group: state-contract-dispatch-${{ github.event_name }}" in text
+    assert "group: state-contract-dispatch-${{ github.event_name }}-${{ github.event.schedule }}" in text
     assert "'scripts/ci/state_contract_dispatch.sh'" in text, "script change must trigger a push dispatch"
