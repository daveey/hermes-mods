From 5d12ec01fca8e45061cd49fc9fd565690e1f8864 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:53:13 +0000
Subject: [PATCH] fix(desktop): preserve source-authority slot in external
 stripe callers [daveey]

---
 apps/desktop/src/store/session-dot-state.test.ts | 6 +++---
 apps/desktop/src/store/sidebar-automated.test.ts | 8 ++++++++
 apps/desktop/src/store/sidebar-automated.ts      | 3 ++-
 apps/desktop/src/store/sidebar-visible-order.ts  | 1 +
 4 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/store/session-dot-state.test.ts b/apps/desktop/src/store/session-dot-state.test.ts
index 61fe36eefc..6e63477baa 100644
--- a/apps/desktop/src/store/session-dot-state.test.ts
+++ b/apps/desktop/src/store/session-dot-state.test.ts
@@ -943,15 +943,15 @@ describe('sessionStatusStripe external-run precedence', () => {
   })
 
   it('stalled still beats waiting when there is no external work', () => {
-    expect(sessionStatusStripe(idle, true, false, 0, false, null, 0, 1, 1, null, 0, 0)).toBe('stalled')
+    expect(sessionStatusStripe(idle, true, false, 0, false, null, 0, 1, 1, null, false, 0, 0)).toBe('stalled')
   })
 
   it('waiting when parked with no external/stalled/red', () => {
-    expect(sessionStatusStripe(idle, true, false, 0, false, null, 0, 1, 0, null, 0, 0)).toBe('waiting')
+    expect(sessionStatusStripe(idle, true, false, 0, false, null, 0, 1, 0, null, false, 0, 0)).toBe('waiting')
   })
 
   it('done when the chat has turns and nothing is waiting', () => {
-    expect(sessionStatusStripe(idle, true, false, 0, false, null, 0, 0, 0, null, 0, 0)).toBe('done')
+    expect(sessionStatusStripe(idle, true, false, 0, false, null, 0, 0, 0, null, false, 0, 0)).toBe('done')
   })
 
   it('absent external fields keep today: parked-only is waiting, not external', () => {
diff --git a/apps/desktop/src/store/sidebar-automated.test.ts b/apps/desktop/src/store/sidebar-automated.test.ts
index 6ce5227cd5..e3f94ff152 100644
--- a/apps/desktop/src/store/sidebar-automated.test.ts
+++ b/apps/desktop/src/store/sidebar-automated.test.ts
@@ -33,6 +33,14 @@ describe('sessionHiddenAsAutomated [daveey]', () => {
     expect(sessionHiddenAsAutomated(legacy, false, { dotState: 'idle' })).toBe(false)
   })
 
+  it('resurfaces an automated row when external work is down, not when merely running', () => {
+    const row = { ...bot, kanban_active: 1, kanban_parked: 1, kanban_observed_at: 1000 }
+    const ctx = { dotState: 'idle' as const, nowSeconds: 1000 }
+
+    expect(sessionHiddenAsAutomated({ ...row, kanban_external: 1 }, false, ctx)).toBe(true)
+    expect(sessionHiddenAsAutomated({ ...row, kanban_external_down: 1 }, false, ctx)).toBe(false)
+  })
+
   it('shows automated rows when the toggle is on', () => {
     expect(sessionHiddenAsAutomated(bot, true, { dotState: 'idle' })).toBe(false)
     $sidebarShowAutomated.set(true)
diff --git a/apps/desktop/src/store/sidebar-automated.ts b/apps/desktop/src/store/sidebar-automated.ts
index 6a706b1e7e..3b17b317ff 100644
--- a/apps/desktop/src/store/sidebar-automated.ts
+++ b/apps/desktop/src/store/sidebar-automated.ts
@@ -33,7 +33,7 @@ type AutomatedRow = Pick<
   | 'pinned'
   | 'review_wait'
 > &
-  Partial<Pick<SessionInfo, 'execution_observations' | 'kanban_stalled' | 'muted'>>
+  Partial<Pick<SessionInfo, 'execution_observations' | 'kanban_stalled' | 'kanban_external' | 'kanban_external_down' | 'kanban_observed_at' | 'muted'>>
 
 export interface AutomatedRowContext {
   /** Explicit render clock for memoized filters; imperative callers use the current clock. */
@@ -67,6 +67,7 @@ export function automatedRowNeedsAttention(row: AutomatedRow, state: SessionDotS
     // stripe (e.g. `unresolved` → amber) on bot / smoke-test traffic would flood the sidebar with it.
     counts.stalled,
     undefined,
+    false,
     counts.external,
     counts.externalDown
   )
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
index d15b827461..213d785394 100644
--- a/apps/desktop/src/store/sidebar-visible-order.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.ts
@@ -153,6 +153,7 @@ export function sessionHasStatusStripe(id: string): boolean {
         kanbanStripeCounts(session ?? {}).waiting,
         kanbanStripeCounts(session ?? {}).stalled,
         session?.outcome,
+        false,
         kanbanStripeCounts(session ?? {}).external,
         kanbanStripeCounts(session ?? {}).externalDown
       )
-- 
2.43.0

