 tui_gateway/change_watcher.py                 |  13 +-
 tui_gateway/watch_store.py                    |  60 +++-
 3 files changed, 310 insertions(+), 19 deletions(-)
 create mode 100644 tests/tui_gateway/test_watch_store_release.py

diff --git a/tests/tui_gateway/test_watch_store_release.py b/tests/tui_gateway/test_watch_store_release.py
