From 96cef2c28453010008e635708b6dce63cf96c4d0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 22:35:51 +0000
Subject: [PATCH] fix(kanban-sync): re-check the batch fit after every trim
 [daveey]

Review of PR #3484: trimming the tail can drop a card own tasks row, so the
second parent pass returns more parents than the first and the request is
201 ops again. Loop until parents + rows fit; rows shrink every pass.
Test: a card whose own row is the 200th row, behind another unacked card.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 hermes_cli/kanban_sync_client.py              |  6 ++--
 .../test_kanban_sync_push_batch_cap.py        | 28 +++++++++++++++++++
 2 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 0e8f914041426338d1b5152a57ffc2ababe0996d..b3d4d1ead1ffaa5b16bdd4db05ba14d26ab84cd9 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -668,8 +668,10 @@ def _within_batch(conn: sqlite3.Connection, rows: list[dict], wire: list[dict],
     ops (400), and the parents ride on top of a full batch: one unacknowledged card behind 200 pending rows failed
     every round with 201 ops and nothing left the hub for 7 h (2026-11-17). The dropped rows go in the next batch."""
     parents = _unacked_parents(conn, rows, gateway)
-    if len(parents) + len(rows) > PUSH_BATCH:
-        rows = rows[:max(1, PUSH_BATCH - len(parents))]
+    # Re-checked after every trim: a card whose own tasks row fell off the tail is no longer "in the batch", so
+    # the next pass can return more parents than the last. Rows shrink each pass; one row has at most two parents.
+    while len(parents) + len(rows) > PUSH_BATCH and len(rows) > 1:
+        rows = rows[:max(1, min(len(rows) - 1, PUSH_BATCH - len(parents)))]
         wire = wire[:len(rows)]
         parents = _unacked_parents(conn, rows, gateway)
     return rows, wire, parents
diff --git a/tests/hermes_cli/test_kanban_sync_push_batch_cap.py b/tests/hermes_cli/test_kanban_sync_push_batch_cap.py
index 8abfbaf4fbe94ef0ff872a3e10f62d759008fc26..eafa0abd54e56ebfeff1633643b19ce0017de364 100644
--- a/tests/hermes_cli/test_kanban_sync_push_batch_cap.py
+++ b/tests/hermes_cli/test_kanban_sync_push_batch_cap.py
@@ -65,3 +65,31 @@ def test_full_batch_plus_unacked_parent_stays_within_the_limit_and_drains(live,
     assert out.sent == client.PUSH_BATCH + extra
     assert _pending(live) == 0
     assert tid in svc.board(BOARD)["rows"]["tasks"]
+
+
+def test_a_card_whose_own_row_is_trimmed_off_does_not_push_the_request_over_the_limit(live):
+    """Review of PR #3484: X is unacked with 100 comments and no outbox row of its own; T is unacked with 99
+    comments and its own tasks upsert as the 200th row. The first parent pass finds 1 parent (X), the trim to 199
+    rows drops T's own row, and T then needs a synthesized parent too: 199 + 2 = 201 unless the fit is re-checked."""
+    x = kb.create_task(live, title="x", assignee="worker")
+    for i in range(100):
+        kb.add_comment(live, x, "default", f"x {i}")
+    t = kb.create_task(live, title="t", assignee="worker")
+    for i in range(99):
+        kb.add_comment(live, t, "default", f"t {i}")
+    with kbc.write_txn(live):
+        own = dict(live.execute("SELECT * FROM kanban_sync_outbox WHERE table_name = 'tasks' AND row_uid = ? "
+                                "ORDER BY created_at, rowid LIMIT 1", (t,)).fetchone())
+        live.execute("DELETE FROM kanban_sync_outbox WHERE table_name != 'task_comments'")
+        own["created_at"] = live.execute("SELECT MAX(created_at) FROM kanban_sync_outbox").fetchone()[0] + 1
+        live.execute(f"INSERT INTO kanban_sync_outbox ({', '.join(own)}) VALUES ({', '.join('?' * len(own))})",
+                     list(own.values()))
+        live.execute("UPDATE tasks SET sync_version = NULL WHERE id IN (?, ?)", (x, t))
+    assert _pending(live) == client.PUSH_BATCH
+    svc = FakeService()
+    client.push(live, svc.hub(ME), BOARD, ME, primary=False)
+    client.push(live, svc.hub(ME), BOARD, ME, primary=False)  # a trimmed short selection finishes next round
+    sizes = [len(ops) for kind, _board, ops in svc.calls if kind == "ops"]
+    assert sizes and max(sizes) <= client.PUSH_BATCH
+    assert _pending(live) == 0
+    assert {x, t} <= set(svc.board(BOARD)["rows"]["tasks"])
-- 
