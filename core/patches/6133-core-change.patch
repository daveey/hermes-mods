Subject: [PATCH 6133] Kanban actionability: frozen obligations and administrative deadlines

Public mirror of source commit 98a5149daf94dc5c0eca118f182141a482473460.

---
diff --git a/tests/tools/test_kanban_actionability_creation_entry.py b/tests/tools/test_kanban_actionability_creation_entry.py
new file mode 100644
index 00000000000..3fc21ec14e2
--- /dev/null
+++ b/tests/tools/test_kanban_actionability_creation_entry.py
@@ -0,0 +1,65 @@
+"""Public lifecycle entry points retain creation-time source custody. [daveey]"""
+import argparse
+import json
+
+import pytest
+
+from hermes_cli import kanban as cli
+from hermes_cli import kanban_db as kb
+from tests.tools import test_kanban_blocker_metadata as support
+from tools.registry import registry
+
+board = support.board
+
+
+@pytest.mark.parametrize('tool', ['kanban_schedule', 'kanban_block', 'kanban_continue'])
+def test_real_tool_timed_source_freezes_final_wake(board, tool):
+    conn, tid = board
+    args = {'task_id': tid, 'clock_only': True,
+            'awaiting': {'kind': 'clock', 'why': 'bounded creation-source test'}}
+    if tool == 'kanban_continue':
+        args.update(checkpoint='Retain fixture state', resume_after_seconds=600)
+    else:
+        args['reason'] = 'Bounded observation'
+    if tool == 'kanban_block':
+        args['kind'] = 'time'
+    result = json.loads(registry.dispatch(tool, args))
+    assert result.get('ok'), result
+    source = [e for e in kb.list_events(conn, tid) if e.kind in ('scheduled', 'continued')][-1]
+    intent = source.payload['actionability_intent']
+    assert intent['deadline_at'] == source.payload['wake_at'] + 600
+    assert intent['first_observed'] == source.created_at
+    assert intent['owner'] == {'kind': 'assignee', 'refs': ['default']}
+    assert intent['execution_authority'] is False
+    assert kb.get_task(conn, tid).status == 'scheduled'
+
+
+def test_real_tool_human_block_records_assignee_review_not_human_sla(board):
+    conn, tid = board
+    request = {'action': 'Reply A or B. Unblock = implement; archive = drop.',
+               'why_human': 'Only owner selects scope', 'interaction': 'reply',
+               'scope': 'isolated test', 'evidence': 'equivalent options'}
+    result = json.loads(registry.dispatch('kanban_block', {
+        'task_id': tid, 'kind': 'needs_input', 'reason': 'Select fixture scope',
+        'human_request': request}))
+    assert result.get('ok'), result
+    source = [e for e in kb.list_events(conn, tid) if e.kind == 'blocked'][-1]
+    intent = source.payload['actionability_intent']
+    assert intent['deadline_at'] == source.created_at + 86400
+    assert intent['policy'] == 'blocked-admin-review-v1'
+    assert request['action'] in intent['blocker']['trigger']
+    assert intent['execution_authority'] is False
+    assert kb.get_task(conn, tid).status == 'blocked'
+
+
+def test_real_cli_parser_dispatch_schedule_stamps_source(board):
+    conn, tid = board
+    parser = argparse.ArgumentParser()
+    cli.build_parser(parser.add_subparsers())
+    args = parser.parse_args(['kanban', '--board', 'default', 'schedule', tid,
+                              'Bounded observation', '--clock-only', '--awaiting', 'clock:',
+                              '--awaiting-why', 'bounded source proof'])
+    assert cli.kanban_command(args) == 0
+    source = [e for e in kb.list_events(conn, tid) if e.kind == 'scheduled'][-1]
+    assert source.payload['actionability_intent']['deadline_at'] == source.payload['wake_at'] + 600
+    assert source.payload['actionability_intent']['execution_authority'] is False
