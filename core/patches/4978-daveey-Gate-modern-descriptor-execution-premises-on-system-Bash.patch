From dedb010257e17a39d77836312e872da669120e15 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 07:35:03 +0000
Subject: [PATCH] [daveey] Gate modern descriptor execution premises on system
 Bash

Keep scanner assertions before the Bash >=4 execution gate for |& only. Portable pipe/background cases remain executable on Bash 3.2; the shell matches the shared /bin/bash probe.

Proof: native CI job135297561662 has exactly three |& syntax errors. GNU Bash 3.2 reproduces frozen failures and validates repaired gates plus portable parent-fd controls (12/12). Focused regression/mutation receipts pending on repair card t_375eb4ace93e73d7. No production source changes.
---
 tests/cron/test_descriptor_execution_gates.py | 52 +++++++++++++++++++
 .../test_lifecycle_guard_descriptor_async.py  |  9 +++-
 ...est_lifecycle_guard_descriptor_keywords.py |  7 ++-
 3 files changed, 65 insertions(+), 3 deletions(-)
 create mode 100644 tests/cron/test_descriptor_execution_gates.py

diff --git a/tests/cron/test_descriptor_execution_gates.py b/tests/cron/test_descriptor_execution_gates.py
new file mode 100644
index 0000000000000000000000000000000000000000..d233ea42e8fbc99c02fa6b18c89464bb964e3cbc
--- /dev/null
+++ b/tests/cron/test_descriptor_execution_gates.py
@@ -0,0 +1,52 @@
+"""Descriptor fixtures retain scanner and portable execution on old Bash."""
+import pytest
+
+from tests.cron import bash_execution
+from tests.cron import test_lifecycle_guard_descriptor_async as async_cases
+from tests.cron import test_lifecycle_guard_descriptor_keywords as keyword_cases
+
+
+@pytest.mark.parametrize("major", [3, 4])
+@pytest.mark.parametrize("operator", ["|", "|&"])
+@pytest.mark.parametrize("case", ["async-clean", "async-dangerous", "child"])
+def test_descriptor_execution_gate(monkeypatch, tmp_path, major, operator, case):
+    if major >= 4 and operator == "|&":
+        bash_execution.require_modern_system_bash()
+    module = keyword_cases if case == "child" else async_cases
+    scan = module.scan_gateway_lifecycle
+    run = module.subprocess.run
+    scanned = []
+    executed = []
+
+    def record_scan(command):
+        result = scan(command)
+        scanned.append(result)
+        return result
+
+    def record_run(argv, **kwargs):
+        assert scanned, "scanner assertion must precede the execution gate"
+        assert argv[0] == "/bin/bash"
+        executed.append(argv)
+        return run(argv, **kwargs)
+
+    monkeypatch.setattr(bash_execution, "system_bash_major", lambda: major)
+    monkeypatch.setattr(module, "scan_gateway_lifecycle", record_scan)
+    monkeypatch.setattr(module.subprocess, "run", record_run)
+
+    def original():
+        if case == "child":
+            keyword_cases.test_child_close_keeps_parent_descriptor(tmp_path, f"exec 3<&- {operator} cat;")
+        else:
+            async_cases.test_async_list_preserves_parent(
+                tmp_path, f"&& true {operator} cat & wait;", case == "async-clean",
+            )
+
+    if major < 4 and operator == "|&":
+        with pytest.raises(pytest.skip.Exception, match="requires /bin/bash >= 4"):
+            original()
+        assert not executed
+    else:
+        # The supported premise runs the real host shell, not a fabricated result.
+        original()
+        assert len(executed) == 1
+    assert scanned == [(case != "async-clean", None)]
diff --git a/tests/cron/test_lifecycle_guard_descriptor_async.py b/tests/cron/test_lifecycle_guard_descriptor_async.py
index 8f28f2a2dc67e44ea22db1e41f5115eea9cd28b5..ad139074771cf7bfe7cc3cfc35675b1acdb4010f 100644
--- a/tests/cron/test_lifecycle_guard_descriptor_async.py
+++ b/tests/cron/test_lifecycle_guard_descriptor_async.py
@@ -26,13 +26,18 @@ def test_async_list_preserves_parent(tmp_path, tail, clean):
     fake.write_text("#!/bin/sh\nprintf MARKER")
     fake.chmod(0o700)
     command = f"exec 3<{shlex.quote(str(script))}; exec 3<&- {tail} bash <&3"
+    assert scan_gateway_lifecycle(command) == (not clean, None)
+    # Keep scanner coverage on Bash 3, which cannot execute the |& grammar.
+    if "|&" in tail:
+        from tests.cron.bash_execution import require_modern_system_bash
+
+        require_modern_system_bash()
     result = subprocess.run(
-        ["bash", "--noprofile", "--norc", "-c", f"PATH={shlex.quote(str(tmp_path))}:$PATH; " + command],
+        ["/bin/bash", "--noprofile", "--norc", "-c", f"PATH={shlex.quote(str(tmp_path))}:$PATH; " + command],
         capture_output=True, text=True, encoding="utf-8", check=False,
     )
     assert result.returncode == 0, result.stderr
     assert result.stdout == ("CLEAN" if clean else "MARKER")
-    assert scan_gateway_lifecycle(command) == (not clean, None)
 
 
 @pytest.mark.parametrize("tail", ["&& true;", "|| false;", "&& true || false;", "&& true; true & wait;"])
diff --git a/tests/cron/test_lifecycle_guard_descriptor_keywords.py b/tests/cron/test_lifecycle_guard_descriptor_keywords.py
index 3f2a111446451827720e5b3aa2978341107df9e4..df49197f6c81cd8e5f72be956ca264e62f19b2fb 100644
--- a/tests/cron/test_lifecycle_guard_descriptor_keywords.py
+++ b/tests/cron/test_lifecycle_guard_descriptor_keywords.py
@@ -57,11 +57,16 @@ def test_child_close_keeps_parent_descriptor(tmp_path, close):
     script.write_text("hermes gateway " + "restart\n")
     command = f"exec 3<{shlex.quote(str(script))}; {close} bash <&3"
     assert scan_gateway_lifecycle(command) == (True, None)
+    # Only the execution premise needs modern Bash; the scanner is portable.
+    if "|&" in close:
+        from tests.cron.bash_execution import require_modern_system_bash
+
+        require_modern_system_bash()
     fake = tmp_path / "hermes"
     fake.write_text("#!/bin/sh\nprintf MARKER\n")
     fake.chmod(0o700)
     result = subprocess.run(
-        ["bash", "--noprofile", "--norc", "-c", f"PATH={shlex.quote(str(tmp_path))}:$PATH; " + command],
+        ["/bin/bash", "--noprofile", "--norc", "-c", f"PATH={shlex.quote(str(tmp_path))}:$PATH; " + command],
         capture_output=True, text=True, encoding="utf-8", check=False,
     )
     assert result.returncode == 0, result.stderr
