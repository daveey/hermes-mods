From db733d2c56819b8700954c81bd24824bdf695787 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:15:13 -0700
Subject: [PATCH] fix(kanban): kanban_db_schedule binds kanban_db last, so it
 imports first without a cycle [daveey]

kanban_db_schedule imported kanban_db at the top while kanban_db imports schedule_task back from
it, so importing the split module first raised a circular ImportError (release run 40717630046,
e2e-upgrade core, test_every_shipped_module_imports_from_a_clean_first_party_graph). The other
split modules already bind _kb at the bottom; this one now does too.

Tests: tests/hermes_cli/test_kanban_db_split_imports.py imports every kanban_db_* module first in a
fresh interpreter (red on kanban_db_schedule before this change; runs on every platform, unlike the
Linux-only fresh-process e2e that caught it).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_db_schedule.py              |  7 ++++--
 .../test_kanban_db_split_imports.py           | 23 +++++++++++++++++++
 2 files changed, 28 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_db_split_imports.py

diff --git a/hermes_cli/kanban_db_schedule.py b/hermes_cli/kanban_db_schedule.py
index 9d149e4661..7d1a644557 100644
--- a/hermes_cli/kanban_db_schedule.py
+++ b/hermes_cli/kanban_db_schedule.py
@@ -8,8 +8,6 @@ from __future__ import annotations
 import sqlite3
 from typing import Any, Optional
 
-from hermes_cli import kanban_db as _kb
-
 
 def schedule_task(
     conn: sqlite3.Connection, task_id: str, *, reason: Optional[str] = None,
@@ -72,3 +70,8 @@ def schedule_task(
         }, run_id=run_id)
         kwc.set_check(conn, task_id, wake_check, check_every)
         return True
+
+
+# Late-bound origin namespace (see module docstring); imported LAST so this
+# module is fully populated before ``kanban_db`` imports from it.
+from hermes_cli import kanban_db as _kb
diff --git a/tests/hermes_cli/test_kanban_db_split_imports.py b/tests/hermes_cli/test_kanban_db_split_imports.py
new file mode 100644
index 0000000000..d572b80428
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_db_split_imports.py
@@ -0,0 +1,23 @@
+"""Every ``kanban_db_*`` split module imports first, in a fresh interpreter.
+
+Regression (release run 40717630046, e2e-upgrade core): ``kanban_db_schedule`` imported
+``kanban_db`` at the top, and ``kanban_db`` imports ``schedule_task`` back from it, so importing the
+split module before ``kanban_db`` raised a circular ImportError. The Linux-only fresh-process e2e
+caught it in release lanes only; this runs everywhere.
+"""
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+MODULES = sorted(f"hermes_cli.{p.stem}" for p in (ROOT / "hermes_cli").glob("kanban_db_*.py"))
+
+
+@pytest.mark.parametrize("module", MODULES)
+def test_split_module_imports_first(module):
+    proc = subprocess.run([sys.executable, "-c", f"import {module}"], cwd=ROOT, capture_output=True,
+                          text=True, timeout=120, check=False)
+    assert proc.returncode == 0, proc.stderr[-2000:]
-- 
