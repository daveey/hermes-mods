diff --git a/hermes_cli/kanban_wait_episode.py b/hermes_cli/kanban_wait_episode.py
index 7e2e2b3d18..9771be41e3 100644
--- a/hermes_cli/kanban_wait_episode.py
+++ b/hermes_cli/kanban_wait_episode.py
@@ -11,6 +11,8 @@ import math
 import re
 import sqlite3
 
+from hermes_cli.kanban_awaiting import run_heads
+
 HISTORY_LIMIT = 512
 PARKS = ("scheduled", "continued", "blocked")
 EXITS = ("completed", "archived", "reopened", "gave_up", "triage_swept",
@@ -27,11 +29,13 @@ def _identity(payload):
             match = re.match(r"(ci|git-ci|deploy)\b", ref, re.IGNORECASE)
             kind = ("deploy" if match[1].lower() == "deploy" else "ci") if match else kind
         if kind in ("ci", "deploy") and isinstance(ref, str) and ref.strip():
-            return kind, ref.strip(), str(awaiting.get("gateway") or "")
+            # Commit heads are part of identity: a new head is a new CI/deploy run.
+            heads = tuple(run_heads({"ref": ref}, payload.get("wake_check")))
+            return kind, ref.strip(), str(awaiting.get("gateway") or ""), heads
         return None
     check = payload.get("wake_check")
     if isinstance(check, str) and re.search(r"\bgit-ci\b", check):
-        return "ci", check.strip(), ""
+        return "ci", check.strip(), "", tuple(run_heads({}, check))
     return None
 
 
diff --git a/tests/hermes_cli/test_kanban_wait_episode_heads.py b/tests/hermes_cli/test_kanban_wait_episode_heads.py
new file mode 100644
index 0000000000..00c68e0603
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_wait_episode_heads.py
@@ -0,0 +1,31 @@
+"""Changed commit head starts a new CI/deploy wait episode; unchanged head keeps it."""
+import json
+from pathlib import Path
+import pytest
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_wait_episode as episode
+
+@pytest.mark.parametrize('kind', ['ci', 'deploy'])
+@pytest.mark.parametrize('changed_head', [False, True])
+def test_actual_schedule_head_identity(tmp_path, monkeypatch, kind, changed_head):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    kb.init_db()
+    awaiting = {'kind': kind, 'ref': 'https://github.com/example/repo/pull/123'}
+    with kbc.connect_closing() as db:
+        tid = kb.create_task(db, title='Review wait fixture', assignee='alice')
+        for at, sha in [(100, 'a' * 40), (200, ('b' if changed_head else 'a') * 40)]:
+            if at == 200:
+                assert kb.unblock_task(db, tid)
+            assert kb.schedule_task(db, tid, reason='CI pending', awaiting=awaiting,
+                                    wake_check=f'test -f {home}/{sha}')
+            # Deterministic times on real lifecycle-emitted events.
+            db.execute("UPDATE task_events SET created_at=? WHERE id=(SELECT MAX(id) FROM task_events WHERE task_id=? AND kind='scheduled')", (at, tid))
+        rows = db.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='scheduled' ORDER BY id", (tid,)).fetchall()
+        premises = [json.loads(row[0])['awaiting']['premise'] for row in rows]
+        assert (premises[0] != premises[1]) == changed_head
+        actual = episode.read(db, tid)
+        assert actual == {'kind': kind, 'since': 200.0 if changed_head else 100.0}, (premises, actual)
