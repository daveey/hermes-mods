From 8dad79cbbc7c01cfd60eb328c8a008415a30b743 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 09:48:37 +0000
Subject: [PATCH] test(kanban): bind moved dev owners to real per-gateway class
 registries [daveey]

Retained 74-identity shared cascade was preclaim config_unavailable, not a parent custody defect. Actual focused diagnostic proved that skip. Add isolated real dev profile configs and read effective config per gateway; preserve all original move, checkpoint, parent-refresh, no-write and active-PR assertions. Six focused files136/0, retries disabled. Not live canonical admission proof.
---
 tests/hermes_cli/test_kanban_dependency_pr_handoff.py | 7 +++++++
 tests/hermes_cli/test_kanban_move.py                  | 8 ++++++++
 tests/hermes_cli/test_kanban_move_parent_evidence.py  | 3 ++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_dependency_pr_handoff.py b/tests/hermes_cli/test_kanban_dependency_pr_handoff.py
index 06a45efd37..658ae95cf1 100644
--- a/tests/hermes_cli/test_kanban_dependency_pr_handoff.py
+++ b/tests/hermes_cli/test_kanban_dependency_pr_handoff.py
@@ -17,6 +17,13 @@ def board(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
     monkeypatch.setattr(prs, "pr_state", lambda _: "OPEN")
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
+    profile = tmp_path / "profiles" / "dev"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
+    assert _assignee_config("dev")["model_routing"]["enabled"] is True
     kb.init_db()
     with kbc.connect() as conn:
         assert str(conn.execute("PRAGMA database_list").fetchone()[2]).startswith(str(tmp_path))
diff --git a/tests/hermes_cli/test_kanban_move.py b/tests/hermes_cli/test_kanban_move.py
index 46f1576ee5..41e38878ce 100644
--- a/tests/hermes_cli/test_kanban_move.py
+++ b/tests/hermes_cli/test_kanban_move.py
@@ -34,6 +34,14 @@ def gws(tmp_path, monkeypatch, svc):
     sync.consume_dispatcher_wake()
     hub = Gateway(tmp_path, HUB, svc, monkeypatch, pickup=False)
     worker = Gateway(tmp_path, WORKER, svc, monkeypatch, pickup="true")
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    for gateway in (hub, worker):
+        profile = gateway.home / "profiles" / "dev"
+        profile.mkdir(parents=True)
+        (profile / "config.yaml").write_text(_managed_yaml())
+        gateway.enter()
+        assert _assignee_config("dev")["model_routing"]["enabled"] is True
     yield hub, worker
     for g in (hub, worker):
         g.conn.close()
diff --git a/tests/hermes_cli/test_kanban_move_parent_evidence.py b/tests/hermes_cli/test_kanban_move_parent_evidence.py
index 17edc952b1..530ae84d21 100644
--- a/tests/hermes_cli/test_kanban_move_parent_evidence.py
+++ b/tests/hermes_cli/test_kanban_move_parent_evidence.py
@@ -39,7 +39,8 @@ def moved_parent(gws, monkeypatch):
                          (json.dumps({"verdict": "approve", "reviewed_sha": "short", "pr": helpers.PR}), parent))
     hub.round()
     worker.round()
-    assert (task, "active_pr") in worker.tick().respawn_guarded
+    tick = worker.tick()
+    assert (task, "active_pr") in tick.respawn_guarded, repr(tick)
     assert evidence.result(worker.conn, task, parent)
     return hub, worker, task, parent
 
