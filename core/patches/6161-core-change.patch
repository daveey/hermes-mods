diff --git a/hermes_cli/kanban_rejected_retain_history.py b/hermes_cli/kanban_rejected_retain_history.py
new file mode 100644
index 00000000000..ac4020fc8e7
--- /dev/null
+++ b/hermes_cli/kanban_rejected_retain_history.py
@@ -0,0 +1,137 @@
+"""Archive rejected transport with historical correlation, never lifecycle authority.
+
+Separate from live command custody. Only evicted terminal tasks/runs qualify;
+no command reconstruction, task projection, canonical write or original replay.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import sqlite3
+from pathlib import Path
+
+from hermes_cli.kanban_db_connect import write_txn
+from hermes_cli.kanban_retain_transport import canonical, frozen_wire
+from hermes_cli import kanban_rejected_retain_source as source
+
+
+def _typed(value):
+    """Injective JSON encoding preserves SQLite BLOBs without reserved-key collisions."""
+    if isinstance(value, bytes):
+        return ['bytes', base64.b64encode(value).decode('ascii')]
+    if isinstance(value, dict):
+        return ['dict', [[k, _typed(v)] for k, v in sorted(value.items())]]
+    if isinstance(value, list):
+        return ['list', [_typed(v) for v in value]]
+    return ['scalar', value]
+
+
+def _local(conn, wire):
+    task, run, event = wire['task'], wire['run_uid'], wire['event_uid']
+    rows = []
+    for table, column, uid in (('tasks', 'id', task), ('task_runs', 'uid', run),
+                               ('task_events', 'uid', event)):
+        rows.extend(tuple(r) for r in conn.execute(f'SELECT * FROM {table} WHERE {column}=?', (uid,)))
+        rows.extend(tuple(r) for r in conn.execute(
+            'SELECT * FROM kanban_sync_outbox WHERE table_name=? AND row_uid=? AND op_id<>?',
+            (table, uid, wire['client_op_id'])))
+        rows.extend(tuple(r) for r in conn.execute(
+            'SELECT * FROM kanban_sync_tombstones WHERE table_name=? AND row_uid=?', (table, uid)))
+    # Any surviving current command keeps the existing live-custody contract.
+    if conn.execute("SELECT 1 FROM sqlite_master WHERE name='kanban_failure_commands'").fetchone():
+        rows.extend(tuple(r) for r in conn.execute(
+            'SELECT * FROM kanban_failure_commands WHERE run_uid=? OR task_id=? OR op_id=? OR event_uid=?',
+            (run, task, wire['client_op_id'], event)))
+    return rows
+
+
+def _evidence(hub, board, table, uid):
+    value = hub.row_evidence(board, table, uid)
+    if (not isinstance(value, dict) or value.get('board') != board
+            or value.get('table') != table or value.get('uid') != uid
+            or type(value.get('head')) is not int or value['head'] < 0
+            or type(value.get('floor')) is not int or value['floor'] < 0):
+        raise ValueError('historical retain evidence identity unavailable')
+    return value
+
+
+def _command(wire):
+    text = canonical(wire)
+    return dict(op_id=wire['client_op_id'], request_uid=wire['client_op_id'], task_id=wire['task'],
+                run_uid=wire['run_uid'], event_uid=wire['event_uid'], operation_kind='retain',
+                delivery_state='rejected', canonical_receipt_json=None, rejected_release_op_id=None,
+                request_json=text, request_sha256=hashlib.sha256(text.encode('utf-8')).hexdigest())
+
+
+def _remote(hub, board, wire):
+    task = _evidence(hub, board, 'tasks', wire['task'])
+    run = _evidence(hub, board, 'task_runs', wire['run_uid'])
+    event = _evidence(hub, board, 'task_events', wire['event_uid'])
+    tr, rr = task.get('row'), run.get('row')
+    if (task.get('state') != 'live' or task.get('tombstone') is not None
+            or not isinstance(tr, dict) or tr.get('uid') != wire['task']
+            or not {'current_run_uid', 'lease_run_uid'} <= tr.keys() or tr.get('status') != 'done'
+            or tr.get('current_run_uid') is not None or tr.get('lease_run_uid') is not None
+            or run.get('state') != 'live' or run.get('tombstone') is not None
+            or not isinstance(rr, dict) or rr.get('uid') != wire['run_uid']
+            or rr.get('task_id') != wire['task'] or type(rr.get('ended_at')) is not int
+            or rr['ended_at'] <= 0 or rr.get('status') != 'blocked'
+            or event.get('state') != 'never_existed' or type(event.get('floor')) is not int
+            or event['floor'] != 0 or event.get('row') is not None or event.get('tombstone') is not None):
+        return None
+    return dict(task=task, run=run, event=event)
+
+
+def _archive(conn, op, text, evidence):
+    conn.execute('''CREATE TABLE IF NOT EXISTS kanban_rejected_retain_history_receipts (
+        op_id TEXT PRIMARY KEY, snapshot_json TEXT NOT NULL, snapshot_sha256 TEXT NOT NULL,
+        evidence_json TEXT NOT NULL)''')
+    for operation in ('UPDATE', 'DELETE'):
+        conn.execute(f'CREATE TRIGGER IF NOT EXISTS rejected_retain_history_{operation.lower()} '
+                     f'BEFORE {operation} ON kanban_rejected_retain_history_receipts BEGIN '
+                     "SELECT RAISE(ABORT,'rejected_retain_history_immutable'); END")
+    conn.execute('CREATE TRIGGER IF NOT EXISTS rejected_retain_history_insert BEFORE INSERT '
+                 'ON kanban_rejected_retain_history_receipts WHEN EXISTS '
+                 '(SELECT 1 FROM kanban_rejected_retain_history_receipts WHERE op_id=NEW.op_id) BEGIN '
+                 "SELECT RAISE(ABORT,'rejected_retain_history_immutable'); END")
+    digest = hashlib.sha256(text.encode('utf-8')).hexdigest()
+    existing = conn.execute('SELECT * FROM kanban_rejected_retain_history_receipts WHERE op_id=?', (op['op_id'],)).fetchone()
+    if existing is not None:
+        return False  # Never replace or reinterpret an existing historical receipt.
+    conn.execute('INSERT INTO kanban_rejected_retain_history_receipts VALUES (?,?,?,?)',
+                 (op['op_id'], text, digest, canonical(evidence)))
+    conn.execute("DELETE FROM kanban_sync_outbox WHERE op_id=? AND state='rejected'", (op['op_id'],))
+    return True
+
+
+def retire(conn: sqlite3.Connection, hub, board: str, op: dict, state_path: Path) -> dict:
+    report: dict = dict(op_id=op['op_id'], table=op['table_name'], row_uid=op['row_uid'],
+                  classification='unresolved', action='retained', proof='historical rejected source not proven')
+    if (op.get('table_name') != 'tasks' or op.get('op') != 'retain' or op.get('state') != 'rejected'
+            or op.get('last_error') != 'missing_decision_episode'):
+        return report
+    try:
+        wire = frozen_wire(op)
+        if op['fields'] != canonical(wire) or _local(conn, wire):
+            return report
+        expected = _command(wire)  # Correlation only; never inserted as command custody.
+        before = source.discover(state_path, board, expected, wire)
+        if before is None:
+            return report
+        evidence = _remote(hub, board, wire)
+        if evidence is None:
+            return report
+        snapshot = dict(operation=op, source_encoding='typed-json-v1', source=_typed(before), lifecycle_authority=False)
+        text = canonical(snapshot)
+        with write_txn(conn):
+            current = conn.execute('SELECT * FROM kanban_sync_outbox WHERE op_id=?', (op['op_id'],)).fetchone()
+            if (current is None or dict(current) != op or _local(conn, wire)
+                    or source.discover(state_path, board, expected, wire) != before):
+                return report
+            if not _archive(conn, op, text, evidence):
+                return report
+        report.update(classification='historical_rejected_source', action='retired', evidence=evidence,
+                      proof='rejected transport archived; historical source is not an applied retain receipt')
+    except (sqlite3.Error, ValueError, TypeError, KeyError, OSError):
+        return report
+    return report
diff --git a/hermes_cli/kanban_rejected_retain_source.py b/hermes_cli/kanban_rejected_retain_source.py
new file mode 100644
index 00000000000..517cd7e4668
--- /dev/null
+++ b/hermes_cli/kanban_rejected_retain_source.py
@@ -0,0 +1,216 @@
+"""Bounded persisted-source correlation, NOT admission or lifecycle authority.
+
+Only reads SQLite; no gateway state constructor, custody restoration, or network.
+Persisted admission/tool records are independent correlation, not signed proof.
+Returned rows retain every original column (including BLOB bytes).
+"""
+from __future__ import annotations
+
+import hashlib
+from itertools import pairwise
+import json
+import math
+from pathlib import Path
+import sqlite3
+
+from hermes_cli.kanban_retain_transport import canonical
+
+MAX_CANDIDATES = 20
+MAX_MESSAGES = 2000
+MAX_BYTES = 4 * 1024 * 1024
+REJECTION = 'retain rejected: immutable custody retained; ordinary failure recovery owns this run'
+
+
+def _pairs(items):
+    result = {}
+    for key, value in items:
+        if key in result:
+            raise ValueError('duplicate JSON key')
+        result[key] = value
+    return result
+
+
+def _json(text):
+    return json.loads(text, object_pairs_hook=_pairs,
+                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
+
+
+def _size(row):
+    return sum(len(v) if isinstance(v, bytes) else len(str(v).encode('utf-8'))
+               for v in row.values() if v is not None)
+
+
+def _command(value, op, wire):
+    expected = {'op_id': wire['client_op_id'], 'request_uid': wire['client_op_id'],
+                'run_uid': wire['run_uid'], 'task_id': wire['task'],
+                'event_uid': wire['event_uid'], 'operation_kind': 'retain',
+                'delivery_state': 'rejected', 'canonical_receipt_json': None,
+                'rejected_release_op_id': None, 'request_json': canonical(wire),
+                'request_sha256': hashlib.sha256(canonical(wire).encode('utf-8')).hexdigest()}
+    return isinstance(value, dict) and all(k in value and value[k] == v for k, v in expected.items()) and all(
+        k in op and op[k] == v for k, v in expected.items())
+
+
+def _ordered(*messages):
+    return all(a['id'] < b['id'] and a['timestamp'] < b['timestamp']
+               for a, b in pairwise(messages))
+
+
+def _source(admission, session, messages, board, op, wire):
+    payload = _json(admission['payload_json'])
+    card = payload['kanban_card_v1']
+    run = card['run_id']
+    request = 'kanban:' + json.dumps([board, wire['task'], run], separators=(',', ':'))
+    if (payload.get('finite') is not True or type(run) is not int or run <= 0
+            or card['board'] != board or card['task_id'] != wire['task']
+            or admission['request_id'] != request or admission['status'] != 'terminal'
+            or not admission['admission_id'] or not admission['principal_id']
+            or admission['principal_id'] != session['user_id']
+            or session['source'] != 'kanban' or session['created_source'] != 'kanban'
+            or admission['target_session_id'] != session['id']
+            or type(session['ended_at']) not in (int, float)
+            or not math.isfinite(session['ended_at'])
+            or session['ended_at'] <= session['started_at']):
+        return []
+    shows, calls, results, commands = _messages(session, messages, request, run, op, wire)
+    return _matches(admission, session, shows, calls, results, commands)
+
+
+def _messages(session, messages, request, run, op, wire):
+    shows, calls, results, commands = [], [], [], []
+    for message in messages:
+        if (message['session_id'] != session['id'] or type(message['id']) is not int
+                or type(message['timestamp']) not in (int, float)
+                or not math.isfinite(message['timestamp'])
+                or not session['started_at'] <= message['timestamp'] <= session['ended_at']):
+            raise ValueError('invalid source message')
+        if message['role'] == 'assistant' and message['tool_calls']:
+            entries = _json(message['tool_calls'])
+            if not isinstance(entries, list):
+                raise ValueError('invalid tool calls')
+            for entry in entries:
+                fn = entry['function']
+                if fn['name'] == 'kanban_retain':
+                    args = _json(fn['arguments'])
+                    call_id = entry.get('id')
+                    if (call_id and entry.get('call_id', call_id) == call_id
+                            and args == {k: v for k, v in wire['payload'].items() if k != 'version'}):
+                        calls.append((message, call_id))
+        if message['role'] != 'tool':
+            continue
+        name = message['tool_name']
+        if name not in ('kanban_show', 'kanban_retain', 'terminal'):
+            continue
+        try:
+            value = _json(message['content'])
+        except json.JSONDecodeError:
+            if name == 'terminal':
+                continue  # Ordinary terminal notices are not structured evidence.
+            raise
+        if name == 'kanban_show':
+            task = value['task']
+            events = value['events']
+            claimed = any(e['kind'] == 'claimed' and e['run_id'] == run
+                          and isinstance(e.get('payload'), dict)
+                          and e['payload'].get('run_uid') == wire['run_uid']
+                          and e['created_at'] <= message['timestamp'] for e in events)
+            admitted = any(e['kind'] == 'owner_admitted' and e['run_id'] == run
+                           and e['payload'].get('request_id') == request
+                           and e['payload'].get('session_id') == session['id']
+                           and e['created_at'] <= message['timestamp'] for e in events)
+            if task['id'] == wire['task'] and task['current_run_id'] == run and claimed and admitted:
+                shows.append(message)
+        elif name == 'kanban_retain':
+            if value.get('ok') is False and value.get('terminal_for_run') is False and value.get('error') == REJECTION:
+                results.append(message)
+        elif value.get('exit_code') == 0 and value.get('error') is None:
+            try:
+                rows = _json(value.get('output', ''))
+            except (ValueError, TypeError):
+                continue  # Most terminal output is not JSON command evidence.
+            if isinstance(rows, list) and len(rows) == 1 and _command(rows[0], op, wire):
+                commands.append((message, rows[0]))
+    return shows, calls, results, commands
+
+
+def _matches(admission, session, shows, calls, results, commands):
+    # Refuse dense/ambiguous histories rather than doing a Cartesian scan.
+    if len(shows) * len(calls) * len(results) * len(commands) > MAX_MESSAGES:
+        return []
+    matches = []
+    for show in shows:
+        for call, call_id in calls:
+            for result in results:
+                for evidence, command in commands:
+                    if result['tool_call_id'] == call_id and _ordered(show, call, result, evidence):
+                        matches.append({'kind': 'historical_rejected_source', 'lifecycle_authority': False,
+                                        'admission': admission, 'session': session, 'command': command,
+                                        'messages': [show, call, result, evidence]})
+                        if len(matches) > 1:
+                            return matches
+    return matches
+
+
+def discover(state_path: Path, board: str, op: dict, wire: dict) -> dict | None:
+    """Return one unique historical source, else None; fail closed on bounds/schema.
+
+    Re-run and compare the complete object after external reads to revalidate.
+    No observed_at or current run interpretation is included. BLOBs remain bytes.
+    """
+    conn = None
+    try:
+        if (not isinstance(board, str) or not board or wire['op'] != 'retain'
+                or type(wire['payload']['version']) is not int or wire['payload']['version'] != 1
+                or not _command(op, op, wire)):
+            return None
+        conn = sqlite3.connect(Path(state_path).resolve().as_uri() + '?mode=ro', uri=True)
+        conn.row_factory = sqlite3.Row
+        conn.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, MAX_BYTES)
+        conn.execute('PRAGMA query_only=ON')
+        conn.execute('BEGIN')  # One consistent read snapshot across all selected rows.
+        conn.set_authorizer(lambda action, *args: sqlite3.SQLITE_OK if action in (
+            sqlite3.SQLITE_SELECT, sqlite3.SQLITE_READ, sqlite3.SQLITE_FUNCTION) else sqlite3.SQLITE_DENY)
+        # A VM budget also bounds scans on older state schemas without JSON indexes.
+        budget = [10000]
+        def progress():
+            budget[0] -= 1
+            return budget[0] <= 0
+        conn.set_progress_handler(progress, 1000)
+        admissions = conn.execute("""SELECT * FROM session_admissions
+            WHERE CASE WHEN json_valid(payload_json) THEN
+            json_extract(payload_json,'$.kanban_card_v1.board')=?
+            AND json_extract(payload_json,'$.kanban_card_v1.task_id')=? ELSE 0 END LIMIT ?""",
+                                  (board, wire['task'], MAX_CANDIDATES + 1)).fetchall()
+        if len(admissions) > MAX_CANDIDATES:
+            return None
+        matches, used = [], 0
+        for row in admissions:
+            admission = dict(row)
+            session_rows = conn.execute('SELECT * FROM sessions WHERE id=? LIMIT 2',
+                                        (admission['target_session_id'],)).fetchall()
+            if len(session_rows) != 1:
+                return None
+            session = dict(session_rows[0])
+            used += _size(admission) + _size(session)
+            messages = []
+            cursor = conn.execute('SELECT * FROM messages WHERE session_id=? ORDER BY id LIMIT ?',
+                                  (session['id'], MAX_MESSAGES + 1))
+            for message in cursor:
+                message = dict(message)
+                used += _size(message)
+                messages.append(message)
+                if used > MAX_BYTES or len(messages) > MAX_MESSAGES:
+                    return None
+            try:
+                candidate = _source(admission, session, messages, board, op, wire)
+            except (ValueError, TypeError, KeyError, AttributeError, OverflowError, RecursionError):
+                candidate = []  # Malformed records cannot supply a matching source.
+            matches.extend(candidate)
+            if len(matches) > 1:
+                return None
+        return matches[0] if len(matches) == 1 else None
+    except (sqlite3.Error, ValueError, TypeError, KeyError, AttributeError, OverflowError, OSError, RecursionError):
+        return None
+    finally:
+        if conn is not None:
+            conn.close()
