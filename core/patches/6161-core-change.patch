+    value = {'task_id':wire['task'], 'run_uid':wire['run_uid'], 'op_id':op['op_id'], 'event_uid':wire['event_uid']}[column]
+    db.execute(f'INSERT INTO kanban_failure_commands ({column}) VALUES (?)', (value,))
