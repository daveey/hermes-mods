From 9ebbac8550ec4c5d902b5bc9546755b9cf4b16c9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:13:47 +0000
Subject: [PATCH] [daveey] tests: preserve hang diagnostics across pytest
 capture

The prior timer wrote into pytest capture, which a hard-killed file never flushes. Duplicate the runner stderr while capture is disabled, then close it after cancellation. Controlled 42s runner timeout with a 60s Event wait: previous fixture lost the stack; preserved FD emits the complete 30s traceback. No production behavior or assertions changed. Focused cursor and loop suites: 31 passed.
---
 tests/tui_gateway/test_loop_command.py | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_loop_command.py b/tests/tui_gateway/test_loop_command.py
index fcf0c980fa..e6ff0f5586 100644
--- a/tests/tui_gateway/test_loop_command.py
+++ b/tests/tui_gateway/test_loop_command.py
@@ -11,6 +11,8 @@ from __future__ import annotations
 
 import faulthandler
 import importlib
+import os
+import sys
 import threading
 import time
 from pathlib import Path
@@ -20,13 +22,16 @@ import pytest
 
 
 @pytest.fixture(autouse=True)
-def _diagnose_loop_command_hang():
-    """Keep blocked-thread evidence before the per-file runner's hard timeout."""
-    faulthandler.dump_traceback_later(30)
+def _diagnose_loop_command_hang(capfd):
+    """A hard-killed pytest never flushes capture: preserve the runner's stderr FD."""
+    with capfd.disabled():
+        fd = os.dup(sys.stderr.fileno())
     try:
+        faulthandler.dump_traceback_later(30, file=fd)
         yield
     finally:
         faulthandler.cancel_dump_traceback_later()
+        os.close(fd)
 
 
 @pytest.fixture()
