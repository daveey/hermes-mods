From b23ad074bedf47d6c625c95d3e31b82ecd2c2651 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 12:34:33 -0700
Subject: [PATCH] fix(kanban): links-diff keeps every chat of a shared card;
 link-only boards [daveey]

links-diff on the live fleet (ledger 955 vs replica 46 on one gateway):
- replica_cards deduplicated by card, so a card with several chats kept only
  the first; it now keeps one row per chat and card (session_tasks still
  dedupes by card for a lineage).
- links to cards on a board this host does not have (a board only another
  gateway runs) had no board file to be written to or a replica to be read
  from. A link-only board (<root>/kanban/sync-links/<board>.db, outside
  boards/, never dispatched or listed) now holds this gateway's links for it
  and syncs its replica.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_chat_links.py            | 13 +++++++--
 hermes_cli/kanban_db_sync.py               | 11 ++++++--
 hermes_cli/kanban_sync_client.py           | 33 +++++++++++++++++++++-
 tests/hermes_cli/test_kanban_chat_links.py | 24 ++++++++++++++++
 4 files changed, 74 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_chat_links.py b/hermes_cli/kanban_chat_links.py
index 79051a56ec..ac52e0ae57 100644
--- a/hermes_cli/kanban_chat_links.py
+++ b/hermes_cli/kanban_chat_links.py
@@ -73,6 +73,12 @@ def _ledger_links(board: str, gateway: str) -> dict[str, dict[str, Any]]:
     return out
 
 
+def ledger_boards(gateway: str) -> set[str]:
+    """Boards on which this gateway's chats have cards, per the origin-ledger projection."""
+    from hermes_cli.kanban_session_activity import _remote_links
+    return {c["board"] for c in _remote_links() if c.get("board") and c.get("origin_gateway") in (None, gateway)}
+
+
 def reconcile(conn: sqlite3.Connection, board: str, gateway: str, *, ledger: bool = True) -> dict[str, int]:
     """Bring this gateway's links in ``conn`` (one board file) up to date. Writes go through the capture triggers,
     so every new or changed link is pushed to the service. Returns counts of added/changed/released links."""
@@ -114,7 +120,7 @@ def replica_cards(session_ids: Iterable[str], gateway: str, statuses: tuple[str,
     ph = ",".join("?" for _ in ids)
     st = ",".join("?" for _ in statuses)
     now = time.time()
-    out: dict[str, dict[str, Any]] = {}
+    out: dict[tuple[str, str], dict[str, Any]] = {}
     for board, path in replicas:
         if not path.exists():
             continue
@@ -136,9 +142,10 @@ def replica_cards(session_ids: Iterable[str], gateway: str, statuses: tuple[str,
         for r in rows:
             owner = r["created_on"]
             key = f"{owner}/default/{board}/{r['id']}"
-            if key in out:
+            pair = (r["chat_session"], key)  # one row per chat and card: a card often has several chats
+            if pair in out:
                 continue
-            out[key] = {
+            out[pair] = {
                 "title": r["title"], "status": r["status"], "assignee": r["assignee"], "created_at": r["created_at"],
                 "started_at": r["started_at"], "priority": r["priority"], "block_kind": r["block_kind"],
                 "human_request": r["human_request"], "id": r["id"], "board": board, "gateway": owner, "key": key,
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 627ca6f80e..9b69c627a5 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -207,6 +207,10 @@ def sync_enabled() -> bool:
 
 
 SHADOW_DIR = "sync-shadow"
+# Link-only boards: a board another gateway owns that this gateway's chats have cards on. The file holds no cards,
+# only this gateway's chat links (pushed); its replica holds the whole board. Outside ``boards/``, so the dispatcher
+# and the board list never see it.
+LINKS_DIR = "sync-links"
 
 
 def board_slug_for_path(db_path: str) -> str:
@@ -214,7 +218,7 @@ def board_slug_for_path(db_path: str) -> str:
     a shadow copy ``.../sync-shadow/<slug>.db`` -> ``<slug>``."""
     from pathlib import Path
     p = Path(db_path)
-    if p.parent.name == SHADOW_DIR:
+    if p.parent.name in (SHADOW_DIR, LINKS_DIR):
         return p.stem
     if p.name == "kanban.db" and p.parent.parent.name == "boards":
         return p.parent.name
@@ -222,9 +226,10 @@ def board_slug_for_path(db_path: str) -> str:
 
 
 def board_selected(db_path: str) -> bool:
-    """``kanban.sync.boards`` lists the boards that sync (absent = every board). A shadow copy always does."""
+    """``kanban.sync.boards`` lists the boards that sync (absent = every board). A shadow copy and a link-only board
+    always do."""
     from pathlib import Path
-    if Path(db_path).parent.name == SHADOW_DIR:
+    if Path(db_path).parent.name in (SHADOW_DIR, LINKS_DIR):
         return True
     boards = sync_config().get("boards")
     if not isinstance(boards, (list, tuple)):
diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index ad3308009c..e4b23fdebf 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -140,9 +140,32 @@ def board_paths() -> list[tuple[str, Path]]:
         # Only real board slugs (the service's board-id rule): ``_archived/`` holds archived boards, not a board.
         found += [(p.parent.name, p) for p in sorted(boards.glob("*/kanban.db"))
                   if p.is_file() and BOARD_ID_RE.match(p.parent.name)]
+    local = {slug for slug, _ in found}
+    links_dir = root / "kanban" / sync.LINKS_DIR
+    if links_dir.is_dir():  # boards only another gateway has, where this gateway's chats have cards
+        found += [(p.stem, p) for p in sorted(links_dir.glob("*.db")) if BOARD_ID_RE.match(p.stem) and p.stem not in local]
     return [(slug, path) for slug, path in found if sync.board_selected(str(path))]
 
 
+def ensure_link_boards(slugs: Iterable[str], gateway: str) -> list[str]:
+    """Create a link-only board file for each slug this host has no board for (kanban_db_sync.LINKS_DIR)."""
+    from hermes_cli import kanban_db
+    local = {slug for slug, _ in board_paths()}
+    created = []
+    for slug in sorted(set(slugs) - local):
+        if not BOARD_ID_RE.match(slug):
+            continue
+        path = kanban_db.kanban_home() / "kanban" / sync.LINKS_DIR / f"{slug}.db"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        conn = _connect(path)
+        try:
+            ensure_identity(conn, slug, gateway)
+        finally:
+            conn.close()
+        created.append(slug)
+    return created
+
+
 def shadow_path(slug: str) -> Path:
     from hermes_cli import kanban_db
     return kanban_db.kanban_home() / "kanban" / sync.SHADOW_DIR / f"{slug}.db"
@@ -598,8 +621,16 @@ LINKS_EVERY_S = 60.0
 
 
 def reconcile_links(boards: list[tuple[str, Path]], gateway: str) -> None:
-    """Bring this gateway's chat links up to date in every synced board (kanban_chat_links.reconcile)."""
+    """Bring this gateway's chat links up to date in every synced board (kanban_chat_links.reconcile), creating a
+    link-only board for each board this gateway's chats have cards on but this host does not have."""
     from hermes_cli import kanban_chat_links
+    try:
+        created = ensure_link_boards(kanban_chat_links.ledger_boards(gateway), gateway)
+        if created:
+            _log.info("kanban sync: link-only boards %s", created)
+            boards = board_paths()
+    except Exception as exc:  # health: allow BLE001 -- link-only boards are best effort; local links still reconcile
+        _log.warning("kanban sync: link-only boards failed (%s: %s)", type(exc).__name__, exc)
     for slug, path in boards:
         try:
             conn = _connect(path)
diff --git a/tests/hermes_cli/test_kanban_chat_links.py b/tests/hermes_cli/test_kanban_chat_links.py
index 829e4078ab..858d34e2d2 100644
--- a/tests/hermes_cli/test_kanban_chat_links.py
+++ b/tests/hermes_cli/test_kanban_chat_links.py
@@ -154,3 +154,27 @@ def test_cli_links_and_links_diff(live, kanban_home, monkeypatch, capsys, tmp_pa
     capsys.readouterr()
     assert cli("sync", "links-diff", "--json") == 0  # no remote links on either side
     assert json.loads(capsys.readouterr().out)["clean"] is True
+
+
+def test_replica_keeps_every_chat_of_a_card_shared_by_several(tmp_path):
+    rep = tmp_path / "default.db"
+    _replica(rep, [("t_shared", "shared", "running", OTHER)],
+             [("t_shared", ME, "s1", "shepherd", 0), ("t_shared", ME, "s2", "shepherd", 0)])
+    got = links.replica_cards(["s1", "s2"], ME, replicas=[("default", rep)])
+    assert sorted(c["session"] for c in got) == ["s1", "s2"]
+
+
+def test_a_board_only_another_gateway_has_gets_a_link_only_file(live, kanban_home, monkeypatch):
+    monkeypatch.setattr(ksa, "_remote_links", lambda stale_ok=False: [_ledger_row("t_run", "s_chat", board="runners")])
+    ksc.reconcile_links(ksc.board_paths(), ME)
+    boards = dict(ksc.board_paths())
+    assert boards["runners"] == kanban_home / "kanban" / sync.LINKS_DIR / "runners.db"
+    conn = kbc.connect(boards["runners"])
+    try:
+        assert _links(conn) == {("t_run", "s_chat", "shepherd", 0)}
+        assert sync.sync_state(conn)["board_id"] == "runners" and sync.board_mode(conn) == "shadow"
+        assert conn.execute("SELECT COUNT(*) FROM kanban_sync_outbox WHERE table_name = 'task_chat_links'").fetchone()[0] == 1
+    finally:
+        conn.close()
+    from hermes_cli import kanban_db
+    assert "runners" not in {b.get("slug") for b in kanban_db.list_boards()}  # never a board in the UI
