 regression

---
 hermes_cli/kanban_output.py                   |  2 +-
 .../test_kanban_show_current_run.py           | 26 +++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_show_current_run.py

diff --git a/hermes_cli/kanban_output.py b/hermes_cli/kanban_output.py
index 17634985c59..24132a63f3c 100644
--- a/hermes_cli/kanban_output.py
+++ b/hermes_cli/kanban_output.py
@@ -15,7 +15,7 @@ _STATUS_ICONS = {c.key: c.icon for c in kanban_workflow.DEFAULT_WORKFLOW} | {kan
 
 _TASK_DICT_FIELDS = (
     "id", "title", "body", "assignee", "status", "priority", "tenant",
-    "human_request",
+    "human_request", "current_run_id",
     "workspace_kind", "workspace_path", "branch_name", "project_id",
     "created_by", "created_at", "started_at", "completed_at", "result",
     "skills", "max_runtime_seconds", "max_retries", "goal_mode", "goal_max_turns",
diff --git a/tests/hermes_cli/test_kanban_show_current_run.py b/tests/hermes_cli/test_kanban_show_current_run.py
new file mode 100644
index 00000000000..49e5bb22f20
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_show_current_run.py
@@ -0,0 +1,26 @@
+"""The real show JSON must expose the owner-run identity consumed by nightly e2e."""
+
+import json
+from pathlib import Path
+
+from hermes_cli import kanban as kc
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+
+def test_show_json_round_trips_current_run_id(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="acceptance owner")
+        assert json.loads(kc.run_slash(f"show {tid} --json"))["task"]["current_run_id"] is None
+        kb.recompute_ready(conn)
+        task = kb.claim_task(conn, tid, claimer="test:owner")
+        assert task is not None and task.current_run_id is not None
+        run_id = task.current_run_id
+    shown = json.loads(kc.run_slash(f"show {tid} --json"))
+    assert shown["task"]["current_run_id"] == run_id
+    assert any(r["id"] == run_id and r["status"] == "running" for r in shown["runs"])
