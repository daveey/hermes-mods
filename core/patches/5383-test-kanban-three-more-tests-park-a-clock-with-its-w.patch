From 8ed05ca9d7bec7de83c3bb920d7c825e4489f247 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 19:39:02 -0800
Subject: [PATCH] test(kanban): three more tests park a clock with its wake
 reason [daveey]

CI on #3870 found three test files outside the branch's earlier sweep that park a bare clock, which is now
refused with no_wake_reason: continuation_exhaustion (a time block), done_tail (schedule/block parks) and
source_ending_initial (the block/schedule endings). Each now declares awaiting={kind:'clock', why:...}. No
assertion changed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/hermes_cli/test_kanban_continuation_exhaustion.py | 3 ++-
 tests/tools/test_kanban_done_tail.py                    | 4 ++--
 tests/tools/test_kanban_source_ending_initial.py        | 4 ++--
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_continuation_exhaustion.py b/tests/hermes_cli/test_kanban_continuation_exhaustion.py
index 7d5a002d64..032df0547e 100644
--- a/tests/hermes_cli/test_kanban_continuation_exhaustion.py
+++ b/tests/hermes_cli/test_kanban_continuation_exhaustion.py
@@ -69,7 +69,8 @@ def test_real_human_questions_and_clock_waits_keep_their_kind(board, kind, reaso
         "evidence": "Release policy reserves target selection and credential recovery to the owner.",
     } if human else None
     assert kb.block_task(conn, tid, kind=kind, reason=reason, clock_only=kind == "time",
-                         human_request=request)
+                         human_request=request,
+                         awaiting={"kind": "clock", "why": "the release window"} if kind == "time" else None)
     task = kb.get_task(conn, tid)
     assert bool(activity._read_counts(path, activity.BLOCKED_STATUSES)) == human
     replica = {"status": task.status, "block_kind": task.block_kind,
diff --git a/tests/tools/test_kanban_done_tail.py b/tests/tools/test_kanban_done_tail.py
index 81ae553954..45cd4c2deb 100644
--- a/tests/tools/test_kanban_done_tail.py
+++ b/tests/tools/test_kanban_done_tail.py
@@ -91,7 +91,7 @@ def test_failed_park_does_not_publish_notice(board, operation):
     from hermes_cli import kanban_db_connect as kbc
     tid = helpers._chat_card(board)
     with kbc.connect() as conn:
-        args = dict(reason=REASON, clock_only=True, expected_run_id=999)
+        args = dict(reason=REASON, clock_only=True, expected_run_id=999, awaiting={'kind': 'clock', 'why': 'test release window'})
         if operation == 'block':
             args['kind'] = 'time'
         assert not getattr(board, operation + '_task')(conn, tid, **args)
@@ -112,7 +112,7 @@ def test_notice_failure_rolls_back_park_and_comment(board, monkeypatch, operatio
 
     monkeypatch.setattr(board, '_append_event', fail_notice)
     with kbc.connect() as conn:
-        args = dict(reason=REASON, clock_only=True)
+        args = dict(reason=REASON, clock_only=True, awaiting={'kind': 'clock', 'why': 'test release window'})
         if operation == 'block':
             args['kind'] = 'time'
         with pytest.raises(RuntimeError, match='injected notice'):
diff --git a/tests/tools/test_kanban_source_ending_initial.py b/tests/tools/test_kanban_source_ending_initial.py
index 25ef691937..dded4de11e 100644
--- a/tests/tools/test_kanban_source_ending_initial.py
+++ b/tests/tools/test_kanban_source_ending_initial.py
@@ -26,9 +26,9 @@ ENDINGS = {
                  "hermes_cli.kanban_db", "complete_task", "done", True),
     "request_review": ("_handle_request_review", {"summary": "Implemented; please review"},
                        "hermes_cli.kanban_db", "request_review", "review", True),
-    "block": ("_handle_block", {"kind": "time", "reason": _PARK, "clock_only": True},
+    "block": ("_handle_block", {"kind": "time", "reason": _PARK, "clock_only": True, "awaiting": {"kind": "clock", "why": "test window"}},
               "hermes_cli.kanban_db", "block_task", "scheduled", False),
-    "schedule": ("_handle_schedule", {"reason": _PARK, "clock_only": True},
+    "schedule": ("_handle_schedule", {"reason": _PARK, "clock_only": True, "awaiting": {"kind": "clock", "why": "test window"}},
                  "hermes_cli.kanban_db", "schedule_task", "scheduled", False),
     "continue": ("_handle_continue", {"checkpoint": "done so far; resume later"},
                  "hermes_cli.kanban_continuation", "continue_task", "ready", False),
-- 
