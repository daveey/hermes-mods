From 19178122fceb8b23c0d15d76908b1142a237112b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 12 Oct 2026 16:18:05 -0700
Subject: [PATCH] [daveey] re-exec into Developer-ID-signed Hermes Python.app
 when it matches the store Python (stable macOS TCC grants)

---
 hermes_cli/_launchers.py                   | 24 +++++++++++++++++++
 hermes_cli/venv_sync.py                    |  3 +++
 tests/hermes_cli/test_signed_python_app.py | 28 ++++++++++++++++++++++
 3 files changed, 55 insertions(+)
 create mode 100644 tests/hermes_cli/test_signed_python_app.py

diff --git a/hermes_cli/_launchers.py b/hermes_cli/_launchers.py
index 61ca4d8ef7..b09272a872 100644
--- a/hermes_cli/_launchers.py
+++ b/hermes_cli/_launchers.py
@@ -150,6 +150,30 @@ def _store_python(runtime: Path) -> Path | None:
     return None
 
 
+def signed_python_app(store_python: Path) -> Path | None:
+    """[daveey] A Developer-ID-signed twin of the store Python (``~/Applications/Hermes Python.app``,
+    built by ``~/.hermes/bin/hermes-python-app``), used when its version matches the store's.
+
+    macOS TCC keys an ad-hoc binary by path + cdhash, so grants (Full Disk Access, Automation,
+    Photos) drop on every Python upgrade; a signed bundle is keyed by bundle id + team. Running
+    processes re-exec into it; persisted launchers keep the store path (the bundle may vanish).
+    """
+    if sys.platform != "darwin":
+        return None
+    contents = Path.home() / "Applications" / "Hermes Python.app" / "Contents"
+    try:
+        import plistlib
+
+        info = plistlib.loads((contents / "Info.plist").read_bytes())
+    except (OSError, ValueError):
+        return None
+    version = str(info.get("CFBundleShortVersionString", ""))
+    exe = contents / "MacOS" / str(info.get("CFBundleExecutable", ""))
+    if version and f"python-{version}+" in str(store_python) and exe.is_file():
+        return exe
+    return None
+
+
 def _load_script_maker():
     """distlib's ScriptMaker — standalone first, then pip's vendored copy."""
     try:
diff --git a/hermes_cli/venv_sync.py b/hermes_cli/venv_sync.py
index d962badd1f..86a9b0ee85 100644
--- a/hermes_cli/venv_sync.py
+++ b/hermes_cli/venv_sync.py
@@ -432,6 +432,9 @@ def prepare_launch(project_root: Path, argv: list[str]) -> Path | None:
     python = resolve_store_python(root)
     if python is None:
         raise RuntimeError("source update has no managed Python; run `hermes pm install`")
+    from hermes_cli._launchers import signed_python_app
+
+    python = signed_python_app(python) or python  # [daveey] stable macOS TCC identity
     # Lexical identity, never resolve(): PM spells the store path through
     # HERMES_HOME (which may carry '..') while sys.executable arrives
     # normalized, so a raw compare re-execs every child forever (#122513). A
diff --git a/tests/hermes_cli/test_signed_python_app.py b/tests/hermes_cli/test_signed_python_app.py
new file mode 100644
index 0000000000..f14a5683f2
--- /dev/null
+++ b/tests/hermes_cli/test_signed_python_app.py
@@ -0,0 +1,28 @@
+"""[daveey] signed_python_app: the Developer-ID twin replaces the store Python only on a version match."""
+import plistlib
+from pathlib import Path
+
+import pytest
+
+from hermes_cli._launchers import signed_python_app
+
+
+def _bundle(home: Path, version: str) -> Path:
+    contents = home / "Applications" / "Hermes Python.app" / "Contents"
+    (contents / "MacOS").mkdir(parents=True)
+    exe = contents / "MacOS" / "python3.14"
+    exe.write_bytes(b"")
+    (contents / "Info.plist").write_bytes(plistlib.dumps(
+        {"CFBundleShortVersionString": version, "CFBundleExecutable": "python3.14"}))
+    return exe
+
+
+@pytest.mark.platforms("macos")
+def test_twin_used_only_for_matching_store_version(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    store = tmp_path / "tools" / "python-3.14.7+20260901-darwin-arm64" / "bin" / "python3"
+    assert signed_python_app(store) is None  # no bundle: keep the store
+    exe = _bundle(tmp_path, "3.14.7")
+    assert signed_python_app(store) == exe
+    newer = tmp_path / "tools" / "python-3.14.8+20261001-darwin-arm64" / "bin" / "python3"
+    assert signed_python_app(newer) is None  # stale bundle never runs a newer store's deps
