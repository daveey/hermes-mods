From 527f318a8455a23c22ea6110fcc962edba7744c1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 05:07:35 +0000
Subject: [PATCH] [daveey] fix(kanban): Desktop named in a card body no longer
 keeps the card on its origin

A core fix whose body began "Desktop chat turns are held at their start and end
by plugin hooks" was kept on a full hub as `local marker: mentions 'desktop
chat'`, although it was a repo change landed by push. The Desktop-surface
markers ("hermes desktop", "desktop app/backend/chat/sidebar/...") now pin only
from the title, like host names. A chat or window the card itself drives in the
live app ("a throwaway Desktop chat", "a fresh Desktop window") still pins from
the body, as do Desktop DOM, CDP and hermes.app.

Proof: replay of old vs new over 10,339 cards in the hub's 20 kanban and
sync-shadow DBs (read-only): 150 cards lose the marker pin, 13 that drive a live
Desktop chat keep it. New tests: 15 of 23 fail on the base, 23 pass here; the 40
test files that touch placement pass (1046 tests).
---
 hermes_cli/kanban_placement.py                | 15 +++-
 .../test_kanban_placement_desktop_surface.py  | 83 +++++++++++++++++++
 2 files changed, 96 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_placement_desktop_surface.py

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 7b8c148878..d7abf15e72 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -87,24 +87,35 @@ MACOS_MARKER = r"(?<![\w/.-])mac ?os(?![\w/-]|\.\w)"
 # checked out on the hub and its devices are reached over ssh:mini, so a body that loads a BB skill
 # (e.g. a metta disk check) is not Mac work. Mac-only BB work still hits xcode/simulator/codesign.
 BABYBEAR_MARKER = r"(?<![\w/.~-])baby ?bear(?![\w/-]|\.\w)"
+# The Desktop app named as a product surface ("Desktop chats are slow", "the Desktop backend"). In the TITLE
+# (see TITLE_ONLY_LOCAL_MARKERS) it says the work is on the app; in the body it is usually the symptom or the
+# users affected. A core fix whose body said "Desktop chat turns are held" stayed on a full hub although it
+# was a repo change landed by push. Work that reads the live app still hits "desktop dom", cdp or hermes.app.
+HERMES_DESKTOP_MARKER = r"\bhermes desktop\b"
+DESKTOP_SURFACE_MARKER = r"\bdesktop (app|backend|backends|renderer|window|chat|chats|sidebar|ui)\b"
+# A chat or window the card itself opens or drives in the live app ("a throwaway Desktop chat runs the CLI"):
+# that is work on the machine with the app, wherever in the card it is said.
+LIVE_DESKTOP_MARKER = (r"\b(throwaway|scratch|disposable|hidden|fixture|fresh|new|real|live) "
+                       r"desktop (chat|chats|session|sessions|window)\b")
 # Phrases that mean the work needs this machine (a Mac the user works on). Case-insensitive.
 DEFAULT_LOCAL_MARKERS = (
     r"\bchrome\b", r"\bcdp\b", r"\bkeychain\b", r"\bcodesign", r"\bnotari[sz]", r"\btcc\b",
     r"\bosascript\b", r"\bapple ?script\b", r"\bapple (photos|notes|reminders|contacts|calendar|music)\b",
     r"\bphotos\.app\b", r"\bimessage\b", r"\bfind ?my\b", r"\bremindctl\b", r"\bshortcuts? app\b",
     r"\blaunchd\b", r"\blaunchctl\b", r"launchagents", r"~/library/", r"\bhermes\.app\b",
-    r"\bhermes desktop\b", r"\bdesktop (app|backend|backends|renderer|window|chat|chats|sidebar|ui)\b",
+    HERMES_DESKTOP_MARKER, DESKTOP_SURFACE_MARKER, LIVE_DESKTOP_MARKER,
     r"\bdesktop\s+dom\b",
     r"\bmacbook\b", MACOS_MARKER, r"\bmac ?mini\b", r"\bthe mini\b", r"\mini-1\b",
     BABYBEAR_MARKER, r"\bxcode\b", r"\bsimulator\b", r"\bwhatsapp\b", r"\bscreen ?shot",
     r"\bexample-org\b", r"\bdavid-bloomin-sso\b", r"--profile softmax",
 )
-# Host names that mean "the work is on that machine" only when they are the subject of the
+# Host and Desktop-surface names that mean "the work is on that machine" only when they are the subject of the
 # title. A body mention is a repro or a verification step ("verify live on the hub and the
 # MacBook"), which is not a reason to keep a core-code card on the laptop. A caller who replaces
 # ``local_markers`` owns the list and every pattern scans the whole text.
 TITLE_ONLY_LOCAL_MARKERS = frozenset({
     r"\bmacbook\b", r"\bmac ?mini\b", r"\bthe mini\b", r"\mini-1\b", BABYBEAR_MARKER,
+    HERMES_DESKTOP_MARKER, DESKTOP_SURFACE_MARKER,
 })
 # Product names (not hosts, not Apple tech): a product with Linux parts (BB pods, their CI on
 # self-hosted Linux runners) is not an Apple/local need by name alone. With the built-in list, a
diff --git a/tests/hermes_cli/test_kanban_placement_desktop_surface.py b/tests/hermes_cli/test_kanban_placement_desktop_surface.py
new file mode 100644
index 0000000000..2cbc41034b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_placement_desktop_surface.py
@@ -0,0 +1,83 @@
+"""The Desktop app named in a card body is a symptom, not a need for the machine with the app. [daveey]
+
+A core fix whose body began "Desktop chat turns are held at their start and end by plugin hooks" was kept on
+a full hub as ``local marker: mentions 'desktop chat'`` although it was a repo change landed by push.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_placement as kp
+from tests.hermes_cli import test_kanban_placement as helpers
+
+mac = helpers.mac
+decide = helpers.decide
+
+_TITLE = "Core: replica task reads fetch 12.5k rows one sqlite step at a time and stall turns 20-90 s"
+_BODY = ("Desktop chat turns are held at their start and end by plugin hooks that wait on a lock.\n"
+         "The serve/dashboard process that hosts Desktop chats never sets the switch interval.\n"
+         "Read the rows in a bounded number of sqlite steps and push the branch.")
+
+_SYMPTOM_BODIES = [
+    _BODY,
+    "The Desktop backend pid 2884099 held deleted -wal files for all 5 boards. Fix the reopen path.",
+    "David reported that Hermes Desktop loads as if getting started again. Fix the default-model write.",
+    "Its completion notice is delivered to the owning session (Desktop chat or Kanban run) exactly once.",
+    "Rows created as source=cli show in the Desktop sidebar. Create them as source=tool.",
+    "The desktop app for b2bcf494ad was copied from a peer in 205 s while admission was held.",
+]
+
+
+@pytest.mark.parametrize("body", _SYMPTOM_BODIES)
+def test_desktop_surface_in_the_body_does_not_keep_the_card_local(body):
+    d = decide({"title": "Fix the session-activity projection", "body": body})
+    assert d["where"] == "hub", d
+
+
+@pytest.mark.parametrize("body", _SYMPTOM_BODIES)
+def test_desktop_surface_in_the_body_is_portable_to_the_worker_pool(body):
+    assert kp.portable_reason({"title": "Fix the session-activity projection", "body": body}, {}) is None
+
+
+@pytest.mark.parametrize("title", [
+    "Hermes Desktop sidebar shows red on idle sessions",
+    "Desktop app: composer loses focus after a model switch",
+    "Fix Desktop chats discarded as headless owners",
+    "Desktop renderer crashes on a long diff",
+])
+def test_desktop_surface_in_the_title_still_pins(title):
+    d = decide({"title": title, "body": "Push the fix."})
+    assert d["where"] == "local" and d["why"].startswith("local marker"), d
+    assert kp.portable_reason({"title": title, "body": "Push the fix."}, {}) == "local marker"
+
+
+@pytest.mark.parametrize("body", [
+    "Live on the MacBook: a throwaway desktop chat runs the CLI block on a fixture card.",
+    "A hidden scratch Desktop chat will subscribe and complete this card mid-turn.\nThen read the notice.",
+    "Open a fresh Desktop window and read the status bar.",
+    "Start a new Desktop session and send one prompt.",
+    "Needs a Desktop DOM readback of the composer",
+])
+def test_a_chat_or_window_the_card_drives_in_the_live_app_still_pins(body):
+    d = decide({"title": "Prove the notice text", "body": body})
+    assert d["where"] == "local" and d["why"].startswith("local marker"), (body, d)
+    assert kp.portable_reason({"title": "Prove the notice text", "body": body}, {}) == "local marker"
+
+
+def test_a_replaced_marker_list_scans_the_body_for_the_desktop_surface():
+    """A caller who replaces ``local_markers`` owns the list: every pattern scans the whole text."""
+    cfg = {**helpers.ROUTE, "local_markers": [kp.DESKTOP_SURFACE_MARKER]}
+    d = decide({"title": "Fix the projection", "body": _BODY}, cfg=cfg)
+    assert d["where"] == "local" and "desktop chat" in d["why"], d
+
+
+def test_create_tool_sends_a_card_that_describes_desktop_chats_to_the_hub(mac):
+    """Through ``kanban_create``: the verbatim card that stayed on the hub leaves the origin."""
+    from tools import kanban_tools as kt
+    out = json.loads(kt._handle_create({"title": _TITLE, "body": _BODY}))
+    assert out.get("placed", {}).get("gateway") == "hub" and "placement" not in out, out
+    assert helpers._local_count() == 0
+    pinned = json.loads(kt._handle_create({"title": "Desktop app: composer loses focus", "body": "Push the fix."}))
+    assert pinned["placement"] == {"where": "local", "why": "local marker: mentions 'desktop app'"}, pinned
-- 
2.43.0

