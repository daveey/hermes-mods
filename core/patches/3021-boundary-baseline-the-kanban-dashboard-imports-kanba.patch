From 401180b9e517d464721716fd52cab82c1c656032 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:31:57 +0000
Subject: [PATCH] boundary baseline: the kanban dashboard imports
 kanban_review_contract

Intended: the dashboard 'done' verb completes a card outside any worker run, so it must apply the
same review_independence gate as kanban_complete and the CLI (agent-9eea612942). The dashboard is the
kanban plugin's own UI and already imports a dozen hermes_cli.kanban_* modules.
---
 scripts/boundary_lint_baseline.json | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/boundary_lint_baseline.json b/scripts/boundary_lint_baseline.json
index 9cd8c95cc2..482e039ac5 100644
--- a/scripts/boundary_lint_baseline.json
+++ b/scripts/boundary_lint_baseline.json
@@ -213,6 +213,7 @@
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_queue_position": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_remote_stop.RemoteArchiveRefused": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_remote_stop.archive": 1,
+    "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_review_contract": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_transfer": 2,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_wait_live.owner_proof": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_wake_check": 1,
-- 
