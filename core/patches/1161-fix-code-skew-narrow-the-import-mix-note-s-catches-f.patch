From 9c966a40f2c518683e61d0618f277c4961a147ff Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 06:55:55 +0000
Subject: [PATCH] fix(code-skew): narrow the import-mix note's catches for the
 code-health gate [daveey]

---
 gateway/code_skew.py | 40 ++++++++++++++++++++--------------------
 hermes_bootstrap.py  |  2 +-
 tools/code_kernel.py |  4 ++--
 tools/registry.py    |  4 ++--
 4 files changed, 25 insertions(+), 25 deletions(-)

diff --git a/gateway/code_skew.py b/gateway/code_skew.py
index 81c3531dffb..439921d7bf0 100644
--- a/gateway/code_skew.py
+++ b/gateway/code_skew.py
@@ -59,7 +59,7 @@ def _process_boot_fingerprint() -> str | None:
         from hermes_cli.git_fingerprint import process_boot_fingerprint
 
         return process_boot_fingerprint(_PROJECT_ROOT)
-    except Exception:
+    except ImportError:  # a tree from before the module existed
         return None
 
 
@@ -110,23 +110,23 @@ def note_import_error(exc: BaseException, where: str) -> bool:
 
     One ``code-skew import mix`` WARNING per (boot, disk) pair, so the error signal shows the cause
     (a process running two revisions; restart it) instead of a bare ``cannot import name``
-    (agent-529f2244ac). Returns True when the error happened under skew. Never raises."""
-    try:
-        if not isinstance(exc, ImportError):
-            return False
-        boot = _boot_fingerprint or _process_boot_fingerprint()
-        current = _fingerprint() if boot else None
-        if not current or current == boot:
-            return False
-        pair = (boot, current)
-        if pair not in _import_mix_noted:
-            _import_mix_noted.add(pair)
-            import logging
-
-            logging.getLogger(__name__).warning(
-                "code-skew import mix: %s raised %s: %s; this process booted on %s but the checkout "
-                "is now %s, so it runs two revisions — restart it to load one",
-                where, type(exc).__name__, exc, _short(boot), _short(current))
-        return True
-    except Exception:
+    (agent-529f2244ac). Returns True when the error happened under skew. Never raises: the
+    fingerprint readers swallow their own failures and the rest is string work."""
+    if not isinstance(exc, ImportError):
+        return False
+    boot = _boot_fingerprint or _process_boot_fingerprint()
+    if not boot:
+        return False
+    current = _fingerprint()
+    if not current or current == boot:
         return False
+    pair = (boot, current)
+    if pair not in _import_mix_noted:
+        _import_mix_noted.add(pair)
+        import logging
+
+        logging.getLogger(__name__).warning(
+            "code-skew import mix: %s raised %s: %s; this process booted on %s but the checkout "
+            "is now %s, so it runs two revisions — restart it to load one",
+            where, type(exc).__name__, exc, _short(boot), _short(current))
+    return True
diff --git a/hermes_bootstrap.py b/hermes_bootstrap.py
index 3b8f689c852..3871ca73477 100644
--- a/hermes_bootstrap.py
+++ b/hermes_bootstrap.py
@@ -555,7 +555,7 @@ def _record_boot_revision() -> None:
         from hermes_cli.git_fingerprint import record_process_boot_fingerprint
 
         record_process_boot_fingerprint(_root)
-    except Exception:
+    except Exception:  # health: allow BLE001 -- a fingerprint read must never fail a launch; the guard falls back to recording late
         return  # older tree (mid-update) or unreadable .git: the guard records late, as before
 
 
diff --git a/tools/code_kernel.py b/tools/code_kernel.py
index f1db91abab8..82f928a877b 100644
--- a/tools/code_kernel.py
+++ b/tools/code_kernel.py
@@ -862,8 +862,8 @@ def _run_cell(kernel: SessionKernel, key: tuple, code: str, *, task_id: str, chi
             try:
                 from gateway.code_skew import note_import_error
                 note_import_error(exc, "execute_code session kernel")
-            except Exception:
-                pass  # the skew note must never mask the cell's own error
+            except ImportError:  # gateway package absent: the cell's own error still returns
+                logger.debug("code-skew note unavailable", exc_info=True)
             _REGISTRY.discard(key, kernel)
             return _error_result(str(exc), tool_calls_made=kernel.tool_call_counter[0],
                                  duration=round(time.monotonic() - exec_start, 2))
diff --git a/tools/registry.py b/tools/registry.py
index 5facbbcfd69..e0c6ebe263a 100644
--- a/tools/registry.py
+++ b/tools/registry.py
@@ -950,8 +950,8 @@ class ToolRegistry:
                 try:
                     from gateway.code_skew import note_import_error
                     note_import_error(e, f"tool {name}")
-                except Exception:
-                    pass  # a skew note must never change how the tool error is returned
+                except ImportError:  # gateway package absent: the tool error still returns
+                    logger.debug("code-skew note unavailable", exc_info=True)
             # Sanitize so framing tokens/CDATA/fences in exception text aren't structural noise.
             raw = f"Tool execution failed: {type(e).__name__}: {e}"
             try:
-- 
2.55.0

