From 3f166adee6d66385d8598a58ac059cd7c89e5612 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:28:09 +0000
Subject: [PATCH] feat(state): warn with the callback name when a write txn is
 held >=5s [daveey]

---
 hermes_state.py                             |  9 +++++++++
 tests/test_kanban_notice_write_lock_hold.py | 13 +++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/hermes_state.py b/hermes_state.py
index 2dddc221bd..944f521831 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -492,6 +492,10 @@ def _foreign_state_db_holders(db_path: Path) -> list[tuple[int, str]]:
 # one-shots, recovery flows, and read-only cross-profile opens use SessionDB() directly with their own close().
 
 
+# A writer txn open longer than this is logged with its callback name: lockowner warnings name only the
+# process, so slow transactions were otherwise anonymous. [daveey]
+_WRITE_HOLD_WARN_S = 5.0
+
 class SessionDB(
     SessionSessionsMixin, SessionFtsSetupMixin, SessionSearchMixin, SessionSchemaMixin,
     SessionPortabilityMixin, SessionTelegramTopicsMixin, SessionCompressionMixin,
@@ -1065,10 +1069,15 @@ class SessionDB(
                     if self._conn is None:  # close() raced this writer
                         self._reopen_after_close_locked(context="write")
                     self._conn.execute("BEGIN IMMEDIATE")
+                    held_since = time.monotonic()
                     try:
                         fn_started = True
                         result = fn(self._conn)
                         self._conn.commit()
+                        held_s = time.monotonic() - held_since
+                        if held_s >= _WRITE_HOLD_WARN_S:  # the log names waiters; this names the holder's code
+                            logger.warning("state.db write lock held %.1fs by %s (pid %d)", held_s,
+                                           getattr(fn, "__qualname__", repr(fn)), os.getpid())
                     except BaseException:
                         try:
                             self._conn.rollback()
diff --git a/tests/test_kanban_notice_write_lock_hold.py b/tests/test_kanban_notice_write_lock_hold.py
index e46231ceb4..c730993402 100644
--- a/tests/test_kanban_notice_write_lock_hold.py
+++ b/tests/test_kanban_notice_write_lock_hold.py
@@ -53,3 +53,16 @@ def test_duplicate_notice_while_another_process_holds_write_lock(db, tmp_path):
     finally:
         other.execute("ROLLBACK")
         other.close()
+
+
+def test_slow_write_txn_logs_its_callback_name(db, caplog, monkeypatch):
+    import hermes_state
+
+    monkeypatch.setattr(hermes_state, "_WRITE_HOLD_WARN_S", 0.0)
+
+    def my_slow_callback(conn):
+        return conn.execute("SELECT 1").fetchone()[0]
+
+    with caplog.at_level("WARNING", logger="hermes_state"):
+        assert db._execute_write(my_slow_callback) == 1
+    assert any("write lock held" in r.getMessage() and "my_slow_callback" in r.getMessage() for r in caplog.records)
-- 
