 .../src/app/chat/composer/model-pill.test.tsx | 21 ++++++++++++++
 .../src/app/chat/composer/model-pill.tsx      | 28 +------------------
 ..._session_resume_materializes_minted_key.py | 13 +++++++++
 tui_gateway/methods_session.py                |  6 ++--
 4 files changed, 39 insertions(+), 29 deletions(-)

diff --git a/apps/desktop/src/app/chat/composer/model-pill.test.tsx b/apps/desktop/src/app/chat/composer/model-pill.test.tsx
index 5894b3c558..6115974dc5 100644
--- a/apps/desktop/src/app/chat/composer/model-pill.test.tsx
+++ b/apps/desktop/src/app/chat/composer/model-pill.test.tsx
@@ -324,6 +324,27 @@ describe('ModelPill with a stored model and no live agent', () => {
     }
   })
 
+  it.each([false, true])('names an empty draft immediately (live menu: %s)', liveMenu => {
+    const view = unloadedView()
+    const liveModel = atom('')
+    view.$model = liveModel
+    view.$storedId = atom<string | null>(null)
+
+    const { container } = render(
+      <SessionViewProvider value={view}>
+        <ModelPill disabled={false} model={modelState({ model: '', provider: '', modelMenuContent: liveMenu ? <div /> : undefined })} />
+      </SessionViewProvider>
+    )
+
+    expect(container.querySelector('.glyph-spinner')).toBeNull()
+    expect(container.textContent).toContain('Switch model')
+    act(() => liveModel.set('claude-opus-5-5'))
+    expect(container.textContent).toContain('Opus 5.5')
+    act(() => liveModel.set(''))
+    expect(container.querySelector('.glyph-spinner')).toBeNull()
+    expect(container.textContent).toContain('Switch model')
+  })
+
   it('never spins for a stored chat whose row is not loaded; names itself as the picker', () => {
     const { container } = render(
       <SessionViewProvider value={unloadedView()}>
diff --git a/apps/desktop/src/app/chat/composer/model-pill.tsx b/apps/desktop/src/app/chat/composer/model-pill.tsx
index b972d42c6e..cc43866aee 100644
--- a/apps/desktop/src/app/chat/composer/model-pill.tsx
+++ b/apps/desktop/src/app/chat/composer/model-pill.tsx
@@ -9,7 +9,6 @@ import { ModelMenuCloseContext } from '@/app/shell/model-menu-panel'
 import { isElementInHiddenPane } from '@/components/pane-shell/pane-visibility'
 import { Button } from '@/components/ui/button'
 import { DropdownMenu, DropdownMenuContent, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'
-import { GlyphSpinner } from '@/components/ui/glyph-spinner'
 import { releaseTypingFocus } from '@/components/ui/keyboard-first'
 import { Tip } from '@/components/ui/tooltip'
 import { useI18n } from '@/i18n'
@@ -32,11 +31,6 @@ import type { ChatBarState } from './types'
 // arbitrary 160px.
 const UNKNOWN_TIER = atom('')
 
-// How long a brand-new draft may show the bare loader while its default model
-// resolves. Past this nothing is plausibly in flight, so the pill names itself
-// as the picker instead of spinning forever (it read as a grip icon).
-const DRAFT_SPINNER_MS = 5_000
-
 const PILL = cn(
   'h-(--composer-control-size) min-w-0 shrink gap-1 rounded-md px-2 text-xs font-normal',
   'text-(--ui-text-tertiary) hover:bg-(--chrome-action-hover) hover:text-foreground'
@@ -71,7 +65,6 @@ export function ModelPill({
   // No live model yet (agent not loaded): fall back to the chat's STORED model
   // rather than a bare spinner — the chat is still on it (#t_b319a52a).
   const stored = useStoredModelSelection(view)
-  const storedId = useStore(view.$storedId)
   const loadingStored = !liveModel.trim() && Boolean(stored.model.trim())
   const currentModel = liveModel || stored.model
   const currentProvider = (liveModel ? model.provider || viewProvider : stored.provider) || viewProvider
@@ -81,21 +74,6 @@ export function ModelPill({
   const modelSource = useStore($currentModelSource)
   const runtimeId = useStore(view.$runtimeId)
   const [open, setOpen] = useState(false)
-  const [draftSpinnerExpired, setDraftSpinnerExpired] = useState(false)
-  // A bare loader only for a draft (no stored chat) and only briefly.
-  const showSpinner = !currentModel.trim() && !storedId && !draftSpinnerExpired
-
-  useEffect(() => {
-    if (currentModel.trim() || storedId) {
-      setDraftSpinnerExpired(false)
-
-      return
-    }
-
-    const timer = window.setTimeout(() => setDraftSpinnerExpired(true), DRAFT_SPINNER_MS)
-
-    return () => window.clearTimeout(timer)
-  }, [currentModel, storedId])
   const restoreSelection = useRef<(() => void) | null>(null)
   const scope = useComposerScope()
   const hasLiveMenu = Boolean(model.modelMenuContent)
@@ -157,9 +135,7 @@ export function ModelPill({
   const pinnedOverride =
     view.kind === 'primary' && !runtimeId && modelSource === 'manual' && Boolean(liveModel.trim())
 
-  // The model resolves a beat after the gateway/session comes up. Rather than
-  // flash a literal "No model", show a quiet loader (inherits the pill text
-  // color at half opacity) until a model lands.
+  // Unknown does not imply a request is pending: keep the picker named.
   //
   // A `composer.modelPill` provider may override the LABEL (compact reasoning
   // label, custom naming) — the pill keeps its chrome, pin dot, and menu; only
@@ -178,8 +154,6 @@ export function ModelPill({
         >
           {pillLabel ?? formatModelPillLabel(currentModel, { fastMode, serviceTier })}
         </span>
-      ) : showSpinner ? (
-        <GlyphSpinner className="opacity-50" spinner="braille" />
       ) : (
         <span className="truncate">{copy.switchModel}</span>
       )}
diff --git a/tests/tui_gateway/test_session_resume_materializes_minted_key.py b/tests/tui_gateway/test_session_resume_materializes_minted_key.py
index c36e2c3c94..592c9763f8 100644
--- a/tests/tui_gateway/test_session_resume_materializes_minted_key.py
+++ b/tests/tui_gateway/test_session_resume_materializes_minted_key.py
@@ -155,6 +155,19 @@ def test_resume_8hex_runtime_id_still_4007(real_db):
     assert len(real_db.list_sessions_rich(source="tui")) == 0
 
 
+def test_lazy_resume_preserves_stored_model_without_building(real_db):
+    real_db.create_session(EXISTING_KEY, source="desktop", model="claude-opus-5-5",
+                           model_config={"provider": "anthropic", "model": "claude-opus-5-5"})
+    resp = _resume(session_id=EXISTING_KEY, lazy=True)
+    _assert_resumed_ok(resp, EXISTING_KEY)
+    result = resp["result"]
+    assert result["info"]["model"] == "claude-opus-5-5"
+    assert result["info"]["provider"] == "anthropic"
+    record = server._sessions[result["session_id"]]
+    assert record["agent"] is None
+    assert record["model_override"]["model"] == "claude-opus-5-5"
+
+
 def test_resume_lazy_watch_missing_key_still_4007(real_db):
     """Lazy subagent watch windows must not mint phantom rows for dead children."""
     real_db.record_minted_session_key(MINTED_KEY)  # isolate the lazy gate
diff --git a/tui_gateway/methods_session.py b/tui_gateway/methods_session.py
index dd6615bc8a..16a33259b5 100644
--- a/tui_gateway/methods_session.py
+++ b/tui_gateway/methods_session.py
@@ -954,7 +954,9 @@ def _resume_lazy(ctx: _Resume) -> dict:
         history = ctx.child_history(repair=True)
     except Exception as e:
         return _err(ctx.rid, 5000, resume_failed_message(e))
-    record = ctx.record(source, cwd, history, lazy=True, todo_state=_todo_state_from_history(history))
+    with _profile_build_scope(ctx.profile_home):
+        overrides = _stored_session_runtime_overrides(ctx.found)
+    record = ctx.record(source, cwd, history, overrides, lazy=True, todo_state=_todo_state_from_history(history))
     if (reused := ctx.claim(sid, record)) is not None:
         return reused
     # A child mid-run emits no session events — liveness comes from the relay registry.
@@ -966,7 +968,7 @@ def _resume_lazy(ctx: _Resume) -> dict:
         display = ctx.child_history(repair=False)
     except Exception:
         logger.debug("child-watch display projection read failed", exc_info=True)
-    return _resume_response(ctx, sid, record, info=_lazy_resume_info(cwd, profile=ctx.profile), display=display,
+    return _resume_response(ctx, sid, record, info=ctx.info(cwd, overrides), display=display,
                             count_source=display, running=running, status="streaming" if running else "idle")
 
 
