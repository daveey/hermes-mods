From 033116e76a46783781b809379bbed1c53ee6a8bc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:50:32 +0000
Subject: [PATCH] [daveey] kanban operator claims: hyphen prefix stays under
 be/being; common -ly non-adverbs don't govern; glued 2+ hyphen run is a dash

Follow-up to PR #2090 review nits (review 5889559259, card t_01a1d4764459aba8):

1. A hyphen-joined prefix is part of the verb in the be/being adverb scan:
   "to be re-posted to t_X" and "to be cross-posted to t_X" are non-claims
   again (as on main before #2090). "Re-posted ..." / "Cross-posted ..."
   alone stay claims. _WORD captures a word glued by one hyphen to the next
   in group 1; the token list is unchanged, only the glued indices are new.
2. -ly heuristic: _NOT_ADVERBS lists common -ly nouns/verbs/adjectives
   (reply, supply, family, early, ...), so "Being early posted to t_X" is a
   claim (fail closed). Other -ly non-adverbs remain a documented fail-open.
3. A run of 2+ hyphens is a dash boundary even glued on both sides
   ("Not done--posted to t_X" is a claim); a single intra-word hyphen is not.

Proof: RED at 6a12fa724e: 9 of 11 new cases fail. GREEN: 9 operator/consent
files 281 passed; receipt/schema consumers 224 passed. scripts/check ok.
Replay over the local corpus (1,611 kanban/state texts with card ids):
0 changed vs #2090 head and vs main. Clause-level replay (2,468 claim-verb
clauses, synthetic id): only the 6 review-discussion clauses quoting these
nits change vs #2090 head.
---
 hermes_cli/kanban_operator_delivery.py        | 24 +++++++++++++------
 .../test_kanban_operator_delivery.py          | 14 +++++++++++
 2 files changed, 31 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_operator_delivery.py b/hermes_cli/kanban_operator_delivery.py
index 20177fb2d7..ea4061b719 100644
--- a/hermes_cli/kanban_operator_delivery.py
+++ b/hermes_cli/kanban_operator_delivery.py
@@ -20,16 +20,22 @@ _GOVERN_WINDOW = 3  # words before the verb: "has not yet been posted", "will la
 # A comma, ':', a dash, '(' or a conjunction ends the governing span: "filed no card, so I posted ..." and "No
 # longer pending - posted to ..." are claims. A dash is an em/en dash, U+2212, or an ASCII hyphen run of any length
 # that touches a space or the clause edge on either side ("pending - posted", "pending --- posted", "pending -posted",
-# "pending- posted"); an intra-word hyphen ("re-posted") is no dash.
+# "pending- posted"), or a run of 2+ hyphens even glued on both sides ("pending--posted"); a single intra-word
+# hyphen ("re-posted") is no dash.
 _BOUNDARY = frozenset({",", ":", "—", "–", "−", "(", "so", "and", "but", "then", "after", "before",
                        "because", "which", "while", "that"})
-_WORD = re.compile(r"[\w’']+|[,:—–−(]|(?<!\S)-+|-+(?!\S)")
+# Group 1 is a word glued by one hyphen to the next ("re" in "re-posted", "cross" in "cross-posted").
+_WORD = re.compile(r"([\w’']+)-(?=[\w’'])|[\w’']+|[,:—–−(]|(?<!\S)-+|-+(?!\S)|-{2,}")
 _TASK_ID = re.compile(r"\bt_[0-9a-f]{8}(?:[0-9a-f]{8})?\b")
 _BE = ("be", "being")
 # Only adverbs may stand between be/being and the verb for it to govern ("to be soon posted", "is being quickly
 # sent"); "To be safe I posted ..." and "Being thorough I posted ..." stay claims (fail closed).
 _ADVERBS = frozenset({"soon", "later", "eventually", "still", "also", "again", "just", "now", "only", "first",
                       "properly", "manually", "automatically"})
+# Common -ly words that are no adverbs: be/being does not govern across them ("Being early posted to t_X" is a
+# claim, fail closed). Known fail-open: any other -ly non-adverb between be/being and the verb still governs.
+_NOT_ADVERBS = frozenset({"reply", "supply", "apply", "comply", "imply", "multiply", "rely", "ally", "rally",
+                          "family", "assembly", "anomaly", "early", "friendly", "costly", "timely", "july", "italy"})
 
 
 def _is_boundary(w):
@@ -37,18 +43,20 @@ def _is_boundary(w):
 
 
 def _adverb(w):
-    return w in _ADVERBS or (len(w) > 3 and w.endswith("ly"))
+    return w in _ADVERBS or (len(w) > 3 and w.endswith("ly") and w not in _NOT_ADVERBS)
 
 
-def _governed(words, i):
+def _governed(words, i, glued=frozenset()):
     lo = max(0, i - _GOVERN_WINDOW)
     for j in range(i - 1, -1, -1):
         # "to be posted", "will be sent", "is being posted", "to be later posted": an infinitive, future or
         # progressive form is never a past claim, whatever boundary cuts it from its queue word ("Queued: to be
         # posted to ..."). Known fail-open: the rare past-tense infinitive "it turned out to be posted twice to
-        # t_X" is not a claim.
+        # t_X" is not a claim. A hyphen-joined prefix is part of the word after it ("to be re-posted").
         if words[j] in _BE:
             return True
+        if j in glued:
+            continue
         if not _adverb(words[j]):
             break
     for w in reversed(words[lo:i]):
@@ -68,8 +76,10 @@ def claimed_targets(text):
     """
     targets = set()
     for clause in re.split(r"[.!?;\n]", text if isinstance(text, str) else ""):
-        words = [w.lower() for w in _WORD.findall(clause)]
-        if any(w in _CLAIM and not _governed(words, i) for i, w in enumerate(words)):
+        matches = list(_WORD.finditer(clause))
+        words = [(m.group(1) or m.group(0)).lower() for m in matches]
+        glued = frozenset(i for i, m in enumerate(matches) if m.group(1))
+        if any(w in _CLAIM and not _governed(words, i, glued) for i, w in enumerate(words)):
             targets.update(_TASK_ID.findall(clause))
     return targets
 
diff --git a/tests/hermes_cli/test_kanban_operator_delivery.py b/tests/hermes_cli/test_kanban_operator_delivery.py
index 83c9ff79dc..0d86cb6a4d 100644
--- a/tests/hermes_cli/test_kanban_operator_delivery.py
+++ b/tests/hermes_cli/test_kanban_operator_delivery.py
@@ -317,6 +317,20 @@ def test_negation_outside_the_claim_verb_still_needs_a_receipt(fleet, summary):
     ("Comment to t_0123456789abcdef --- not posted.", False),
     ("Comment to t_0123456789abcdef -not posted.", False),
     ("The note to t_0123456789abcdef was never re-posted.", False),
+    # A hyphen-joined prefix is part of the verb, so be/being still governs it; alone it stays a claim.
+    ("The note is to be re-posted to t_0123456789abcdef.", False),
+    ("The note is to be cross-posted to t_0123456789abcdef.", False),
+    ("The note to t_0123456789abcdef is being soon re-sent.", False),
+    ("Cross-posted the note to t_0123456789abcdef.", True),
+    # Common -ly nouns, verbs and adjectives are no adverbs: be/being does not govern across them (fail closed).
+    ("Being early posted to t_0123456789abcdef.", True),
+    ("Being family posted to t_0123456789abcdef.", True),
+    ("To be supply posted to t_0123456789abcdef.", True),
+    ("Queued to be manually re-posted to t_0123456789abcdef.", False),
+    # A run of 2+ hyphens is a dash even glued on both sides; a single intra-word hyphen is not.
+    ("Not done--posted to t_0123456789abcdef.", True),
+    ("Not done---posted to t_0123456789abcdef.", True),
+    ("Comment to t_0123456789abcdef--not posted.", False),
 ])
 def test_claimed_targets_scopes_negation_to_the_verb(text, claimed):
     from hermes_cli.kanban_operator_delivery import claimed_targets
