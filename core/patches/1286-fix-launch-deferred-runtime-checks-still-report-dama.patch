From 17cda680e6e75f0804e6aa9163e65a1ff68f03dd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 13:08:05 +0000
Subject: [PATCH] fix(launch): deferred runtime checks still report damaged
 store tools

check_runtime's opt-out, already-current, timed-out and probe-error paths activated
the store's tools with allow_incomplete but dropped the returned problems, so a
damaged bundled tool went unreported (tests/pm/test_startup_activation.py
test_startup_uses_one_verdict[True-*] failed in CI). That check reads no
plugin-union inputs and starts no PM, so report it on every path; only the venv
verdict is deferred. [daveey]
---
 hermes_cli/venv_sync.py                       | 24 +++++++++----------
 .../hermes_cli/test_launch_preflight_bound.py | 14 +++++++----
 2 files changed, 22 insertions(+), 16 deletions(-)

diff --git a/hermes_cli/venv_sync.py b/hermes_cli/venv_sync.py
index 13c88219799..6883a4f7311 100644
--- a/hermes_cli/venv_sync.py
+++ b/hermes_cli/venv_sync.py
@@ -56,19 +56,17 @@ def check_runtime(project_root: Path) -> str | None:
     if (Path(project_root) / ".git").exists() and read_install_stamp(project_root).get("updateMechanism") != "self":
         return None  # A developer's checkout does not owe managed products.
 
+    # Each shortcut below still activates and reports the store's tools: that check
+    # reads no plugin-union inputs and starts no PM, so only the venv verdict is skipped.
     if os.environ.get("HERMES_DISABLE_LAZY_INSTALLS", "").lower() in ("1", "true", "yes"):
-        pm.activate(allow_incomplete=True)  # keep tool PATH without reading plugin-union inputs
-        return None
+        return _runtime_problem(project_root, pm.activate(allow_incomplete=True))
     if Path(project_root).resolve() in _current_roots:
-        # prepare_launch just found the dependencies current in this process: only the
-        # store's tools remain to check, which reads no plugin-union inputs and starts no PM.
-        problems = pm.activate(allow_incomplete=True)
-        return _runtime_problem(project_root, problems)
+        # prepare_launch just found the dependencies current in this process.
+        return _runtime_problem(project_root, pm.activate(allow_incomplete=True))
     if Path(project_root).resolve() in _unknown_roots:
-        # This launch's currency probe already ran out of time; the runtime diagnostic
-        # reads the same inputs, so defer it to a later launch rather than wait again.
-        pm.activate(allow_incomplete=True)
-        return None
+        # This launch's currency probe already ran out of time; the venv verdict reads
+        # the same inputs, so defer it to a later launch rather than wait again.
+        return _runtime_problem(project_root, pm.activate(allow_incomplete=True))
     from hermes_cli.launch_probe import probe
 
     # The diagnostic computes plugin-union inputs (including YAML) and may start PM.
@@ -80,8 +78,10 @@ def check_runtime(project_root: Path) -> str | None:
         if result is None or result["state"] == "error":
             # Tool activation has no worker or plugin-union/YAML read; keep bundled
             # executables available even when the advisory diagnostic times out.
-            pm.activate(allow_incomplete=True)
-            return None if result is None else f"runtime check deferred: {result['detail']}"
+            problem = _runtime_problem(project_root, pm.activate(allow_incomplete=True))
+            if problem or result is None:
+                return problem
+            return f"runtime check deferred: {result['detail']}"
         os.environ["PATH"] = result["path"]
         problems = result["problems"]
     return _runtime_problem(project_root, problems)
diff --git a/tests/hermes_cli/test_launch_preflight_bound.py b/tests/hermes_cli/test_launch_preflight_bound.py
index 6a530b90f27..78cf64224ca 100644
--- a/tests/hermes_cli/test_launch_preflight_bound.py
+++ b/tests/hermes_cli/test_launch_preflight_bound.py
@@ -99,16 +99,21 @@ print(json.dumps({{'prepare': prepared - started, 'runtime': time.monotonic() -
                    timeout=3, what="blocked PM descendant terminated")
 
 
-def test_runtime_opt_out_does_not_probe(tmp_path, monkeypatch):
+def test_runtime_opt_out_does_not_probe_but_reports_tools(tmp_path, monkeypatch):
     import pm
+    from hermes_cli import launch_probe
     root = tmp_path / "checkout"
     (root / ".git").mkdir(parents=True)
     (root / "install-stamp.json").write_text(json.dumps({"updateMechanism": "self"}))
     monkeypatch.setenv("HERMES_DISABLE_LAZY_INSTALLS", "1")
+    monkeypatch.setattr(launch_probe, "probe", lambda *a, **k: pytest.fail("probed under the opt-out"))
     activated = []
-    monkeypatch.setattr(pm, "activate", lambda **kw: activated.append(kw))
+    monkeypatch.setattr(pm, "activate", lambda **kw: activated.append(kw) or [])
     assert venv_sync.check_runtime(root) is None
-    assert activated == [{"allow_incomplete": True}]
+    monkeypatch.setattr(pm, "activate", lambda **kw: activated.append(kw) or ["git: missing"])
+    problem = venv_sync.check_runtime(root)
+    assert problem is not None and "git: missing" in problem, "a damaged store tool is still reported"
+    assert activated == [{"allow_incomplete": True}] * 2
 
 
 def test_runtime_check_reuses_this_launchs_current_verdict(tmp_path, monkeypatch):
@@ -140,8 +145,9 @@ def test_runtime_check_defers_after_this_launchs_probe_timed_out(tmp_path, monke
     activated = []
     monkeypatch.setattr(pm, "activate", lambda **kw: activated.append(kw) or ["git: missing"])
     monkeypatch.setattr(venv_sync, "_unknown_roots", {root.resolve()})
-    assert venv_sync.check_runtime(root) is None
+    problem = venv_sync.check_runtime(root)
     assert activated == [{"allow_incomplete": True}], "bundled tools must stay on PATH"
+    assert problem is not None and "git: missing" in problem, "a damaged store tool is still reported"
 
 
 @pytest.mark.platforms("posix")
-- 
