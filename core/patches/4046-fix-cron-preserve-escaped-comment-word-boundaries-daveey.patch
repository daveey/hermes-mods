From ac1098e9cb59f6b7293a8b26d237e09f06300216 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:56:15 +0000
Subject: [PATCH] fix(cron): preserve escaped comment word boundaries [daveey]

Track lexical word-start state rather than the previous character: escaped delimiters and bare CR are word content in bash. Both independent-review P1 findings reproduced red before this fix. Add five real-bash RUN rows and allowed twins, plus the original fd-allocation compositions now that #2523 is on main. All 75 focused tests and 1587 guard consumer tests pass; scripts/check passes. Frozen main 4dc17201 reproduces 31/33 RUN fail-opens; all 20 allowed rows stay allowed.
---
 cron/lifecycle_guard_lines.py                   | 13 ++++++++-----
 .../cron/test_lifecycle_guard_comment_words.py  | 17 +++++++++++++++++
 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/cron/lifecycle_guard_lines.py b/cron/lifecycle_guard_lines.py
index bfc1c11cb4..1c9d0205ad 100644
--- a/cron/lifecycle_guard_lines.py
+++ b/cron/lifecycle_guard_lines.py
@@ -13,7 +13,7 @@ from __future__ import annotations
 import re
 
 # Characters after which an unquoted `#` starts a word, so a comment (bash's metacharacters).
-_WORD_BREAKS = frozenset(" \t\r\n;&|()<>")
+_WORD_BREAKS = frozenset(" \t\n;&|()<>")
 # A backslash-newline continuation and the indentation after it (what the regex scans collapse).
 _CONTINUATION = re.compile(r"\\\r?\n[ \t]*")
 
@@ -26,7 +26,7 @@ def _scan(text: str, *, split: bool, keep_comments: bool) -> list[str]:
     current: list[str] = []
     comment: list[str] = []
     in_single = in_double = escape = in_comment = False
-    previous = "\n"
+    word_start = True
     for ch in text:
         if in_comment:
             if ch != "\n":
@@ -41,24 +41,27 @@ def _scan(text: str, *, split: bool, keep_comments: bool) -> list[str]:
             if ch == "\n":  # a continuation joins the word: `a\<newline>#b` is `a#b`
                 current.append(ch)
                 continue
+            current.append(ch)
+            word_start = False  # escaped metacharacters are word content
+            continue
         elif ch == "\\" and not in_single:
             escape = True
         elif ch == "'" and not in_double:
             in_single = not in_single
         elif ch == '"' and not in_single:
             in_double = not in_double
-        elif ch == "#" and not in_single and not in_double and previous in _WORD_BREAKS:
+        elif ch == "#" and not in_single and not in_double and word_start:
             in_comment = True
             comment = [ch]
             continue
         elif split and ch == "\n" and not in_single and not in_double:
             lines.append("".join(current))
             current = []
-            previous = ch
+            word_start = True
             continue
         current.append(ch)
         if not escape:
-            previous = ch
+            word_start = not in_single and not in_double and ch in _WORD_BREAKS
     if in_comment and keep_comments:
         current.append("".join(comment))
     if current or not split:
diff --git a/tests/cron/test_lifecycle_guard_comment_words.py b/tests/cron/test_lifecycle_guard_comment_words.py
index aefb0bc43e..0b66b5b0f5 100644
--- a/tests/cron/test_lifecycle_guard_comment_words.py
+++ b/tests/cron/test_lifecycle_guard_comment_words.py
@@ -19,6 +19,12 @@ from cron.lifecycle_guard_lines import (
 )
 
 RUN = [
+    # Escaped separators and a bare CR are word content, not comment boundaries.
+    "echo a\\ #b; bash ./r.sh",
+    "echo a\\;#b; bash ./r.sh",
+    "echo a\\|#b; bash ./r.sh",
+    "echo a\\<#b; bash ./r.sh",
+    "echo a\r#b; bash ./r.sh",
     # A `#` inside a word is text.
     "echo a#b; bash ./r.sh",
     "echo a#b && bash ./r.sh",
@@ -30,6 +36,8 @@ RUN = [
     "echo a#b; hermes gateway \"restart\"",
     "echo a#b; hermes gateway re\"start\"",
     "echo a#b 2>/dev/null; bash ./r.sh",
+    "x=1#2 {fd}>/dev/null bash ./r.sh",
+    "echo a#b {fd}>/dev/null; bash ./r.sh",
     # A quote inside a comment is text: the next line is its own command.
     "echo hi # it's\nbash -s -<./r.sh",
     "echo # it's\nbash<./r.sh",
@@ -52,6 +60,15 @@ RUN = [
     "grep x /dev/null a\\\n#b; hermes gateway \"restart\"",
 ]
 ALLOWED = [
+    "echo a\\ #b; python3 ./clean.py",
+    "echo a\\;#b; python3 ./clean.py",
+    "echo a\\|#b; python3 ./clean.py",
+    "echo a\\<#b; python3 ./clean.py",
+    "echo a\r#b; python3 ./clean.py",
+    "x=1#2 {fd}>/dev/null python3 ./clean.py",
+    "echo a#b {fd}>/dev/null; python3 ./clean.py",
+    "echo ''#b; python3 ./clean.py",
+    "echo a\\ #b # bash ./r.sh",
     "echo a#b; python3 ./clean.py",
     "x=1#2 python3 ./clean.py",
     "echo hi # it's\npython3 ./clean.py",
