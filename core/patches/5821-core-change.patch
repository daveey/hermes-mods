From 4ef3442a5ec87812d4183d6bc00fb605531d9a5f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:35:12 +0000
Subject: [PATCH] [daveey] kanban renew-scope: open the board through
 kanban_db_connect, test the argv path

Review t_fdc4cbdc49602715 (request_changes at cef290a3e5): command() called
hermes_cli.kanban_db.connect_closing, which does not exist (it lives in
kanban_db_connect), so every `hermes kanban renew-scope` raised AttributeError,
rc 1. No test went through command(), so CI was green on a dead entry point.

Fix: import kanban_db_connect and use its connect_closing, as kanban.py does.

Test: test_j_the_command_line_renews_and_refuses_through_its_own_connection
drives argparse, the dispatcher table and command()'s own connection: own_run
refusal (rc 1, JSON), owning-chat renewal (rc 0, one scope_renewed event),
repeat refused (rc 1, text). Red on cef290a3e5 with the AttributeError; green
here (35 passed in the two renewal files). Real process: `python -m
hermes_cli.main kanban renew-scope` from a worker shell now prints a
not_scope_authority refusal instead of a traceback.
---
 hermes_cli/kanban_scope_renewal_cli.py        |  4 +--
 tests/hermes_cli/test_kanban_scope_renewal.py | 31 +++++++++++++++++++
 2 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_scope_renewal_cli.py b/hermes_cli/kanban_scope_renewal_cli.py
index 01c9f4e270..4f2797d78c 100644
--- a/hermes_cli/kanban_scope_renewal_cli.py
+++ b/hermes_cli/kanban_scope_renewal_cli.py
@@ -167,9 +167,9 @@ def renew(conn: sqlite3.Connection, task_id: str, *, episode: str, comment_id: i
 
 
 def command(args: argparse.Namespace) -> int:
-    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
     try:
-        with kb.connect_closing() as conn:
+        with kbc.connect_closing() as conn:
             payload = renew(conn, args.task_id, episode=args.episode, comment_id=args.mandate_comment,
                             reason=args.reason)
     except RenewalRefused as exc:
diff --git a/tests/hermes_cli/test_kanban_scope_renewal.py b/tests/hermes_cli/test_kanban_scope_renewal.py
index 4e847f169a..1bd11f9bed 100644
--- a/tests/hermes_cli/test_kanban_scope_renewal.py
+++ b/tests/hermes_cli/test_kanban_scope_renewal.py
@@ -342,3 +342,34 @@ def test_i_renewal_leaves_the_spend_window_runs_and_tokens_unchanged(board, monk
     assert budget._window_start(board, tid, 2999999999) == since
     assert budget.spend(board, tid) == spent
     assert decision.restricted_floor(board, tid) == floor and decision.restricted_since(board, tid) is None
+
+
+def argv(*args):
+    """The installed entry point: argparse, the dispatcher table and the command's own database connection."""
+    import argparse
+    from hermes_cli import kanban
+    from hermes_cli.kanban_parser import build_parser
+    parser = argparse.ArgumentParser()
+    build_parser(parser.add_subparsers())
+    return kanban.kanban_command(parser.parse_args(['kanban', 'renew-scope', *args]))
+
+
+def test_j_the_command_line_renews_and_refuses_through_its_own_connection(board, monkeypatch, capsys):
+    tid, session, episode = stopped(board, monkeypatch)
+    link(board, tid)
+    comment = mandate(board, tid)
+    request = (tid, '--episode', episode, '--mandate-comment', str(comment), '--reason', 'origin chat authorized', '--json')
+    ancestry(monkeypatch, {'HERMES_SESSION_ID': CHAT}, {'HERMES_KANBAN_TASK': tid, 'HERMES_SESSION_ID': session}, {})
+    monkeypatch.setenv('HERMES_SESSION_ID', CHAT)
+    assert argv(*request) == 1
+    assert json.loads(capsys.readouterr().out.strip().splitlines()[-1])['error'] == 'own_run'
+    assert decision.execution_restricted(board, tid)
+    ancestry(monkeypatch, {'HERMES_SESSION_ID': CHAT, 'HERMES_AGENT': '1'}, {'HERMES_SESSION_ID': CHAT}, {})
+    assert argv(*request) == 0
+    reply = json.loads(capsys.readouterr().out.strip().splitlines()[-1])
+    assert reply['ok'] and reply['episode'] == episode and reply['authority_kind'] == 'chat'
+    assert board.execute("SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind='scope_renewed'", (tid,)).fetchone()[0] == 1
+    assert decision.restricted_since(board, tid) is None
+    assert argv(*request[:-1]) == 1  # the stop is already renewed: text output, nothing written twice
+    assert 'renew-scope refused' in capsys.readouterr().out
+    assert board.execute("SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind='scope_renewed'", (tid,)).fetchone()[0] == 1
-- 
