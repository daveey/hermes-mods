@@ -0,0 +1,702 @@
+"""Passive ASGI HTTP lifecycle / body-byte diagnostics (http_body_accounting)."""
+
+from __future__ import annotations
+
+import asyncio
+import itertools
+import threading
+import time
+
+import pytest
+
+from hermes_cli import http_body_accounting as hba
+from hermes_cli import loop_accounting as la
+from hermes_cli.web_server_transport import transport_observed_app
+
+
+COUNTERS = (
+    "requests_started",
+    "response_finished",
+    "failed",
+    "cancelled",
+    "inflight",
+    "request_body_bytes",
+    "response_body_bytes",
+)
+
+
+@pytest.fixture(autouse=True)
+def _fresh():
+    hba.reset()
+    la.reset()
+    yield
+    hba.reset()
+    la.reset()
+
+
+def _scope(method: str, path: str, *, query: bytes = b"", headers=None):
+    return {
+        "type": "http",
+        "asgi": {"version": "3.0"},
+        "http_version": "1.1",
+        "method": method,
+        "path": path,
+        "raw_path": path.encode("ascii"),
+        "query_string": query,
+        "headers": headers or [],
+        "client": ("127.0.0.1", 9),
+        "server": ("127.0.0.1", 80),
+        "scheme": "http",
+    }
+
+
+def _receive_body(body: bytes = b"", *, disconnect: bool = False):
+    sent = {"n": 0}
+
+    async def receive():
+        sent["n"] += 1
+        if disconnect and sent["n"] == 1:
+            return {"type": "http.disconnect"}
+        return {"type": "http.request", "body": body, "more_body": False}
+
+    return receive
+
+
+async def _ok_app(scope, receive, send, *, body=b"ok", status=200, chunks=None):
+    await send({"type": "http.response.start", "status": status, "headers": []})
+    if chunks is None:
+        await send({"type": "http.response.body", "body": body, "more_body": False})
+        return
+    for i, chunk in enumerate(chunks):
+        last = i == len(chunks) - 1
+        await send(
+            {"type": "http.response.body", "body": chunk, "more_body": not last}
+        )
