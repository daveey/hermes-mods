+def _run(app, scope, receive=None, send=None):
+    receive = receive or _receive_body()
+    sent = []
+
+    async def _send(message):
+        sent.append(message)
+        if send is not None:
+            await send(message)
+
+    async def main():
+        await app(scope, receive, _send)
+
+    asyncio.run(main())
+    return sent
+
+
+def _wrap(inner):
+    return hba.wrap_http_body_accounting(inner)
+
