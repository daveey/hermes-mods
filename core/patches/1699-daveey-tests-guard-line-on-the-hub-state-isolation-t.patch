From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 07:55:39 -0800
Subject: [PATCH] [daveey] tests: guard line on the hub-state isolation test;
 keep test_tui_gateway_server.py at its line cap

---
 tests/test_conftest_hub_state_isolation.py   | 1 +
 tests/tui_gateway/test_tui_gateway_server.py | 9 ++-------
 2 files changed, 3 insertions(+), 7 deletions(-)

diff --git a/tests/test_conftest_hub_state_isolation.py b/tests/test_conftest_hub_state_isolation.py
index 91dd9eb1c91..aa4a4bb759f 100644
--- a/tests/test_conftest_hub_state_isolation.py
+++ b/tests/test_conftest_hub_state_isolation.py
@@ -6,6 +6,7 @@ process-wide default, such a thread on hermes-hub loaded the host's live ``hub.d
 rows per read) and pushed tests/tui_gateway/test_tui_gateway_server.py past the 512 MB per-file budget.
 """
 
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 import os
 import threading
 from pathlib import Path
diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index 492b2ce15c2..fd39b26e4a2 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -14222,19 +14222,14 @@ def test_interrupt_error_after_tts_stop_still_resumes_wake(monkeypatch):
     monkeypatch.setattr(wake_word, "resume_listening", resume_listening)
     monkeypatch.setattr(server, "_voice_wake_owner", None)
     monkeypatch.setattr(server, "_session_uses_compute_host", lambda _session: True)
-    # The failed host call reaches _recover_unreachable_compute_host_turn's pending-turn probe; without a stub
-    # it builds a REAL HostSupervisor, i.e. spawns a compute-host process that outlives the test. [daveey]
-    monkeypatch.setattr(server, "_get_compute_host_supervisor",
-                        lambda _cfg=None: types.SimpleNamespace(has_pending_turn=lambda _sid: False))
+    monkeypatch.setattr(server, "_get_compute_host_supervisor", lambda _cfg=None: types.SimpleNamespace(has_pending_turn=lambda _sid: False))  # else a REAL HostSupervisor spawns a compute-host process [daveey]
 
     def _host_failed(*_args, **_kwargs):
         raise RuntimeError("host failed")
 
     monkeypatch.setattr(server, "_interrupt_session_turn", _host_failed)
     try:
-        paused = _dispatch_sync(
-            {"id": "pause", "method": "wake.pause", "params": {}}, transport=owner
-        )
+        paused = _dispatch_sync({"id": "pause", "method": "wake.pause", "params": {}}, transport=owner)
         missing = _dispatch_sync(
             {"id": "missing", "method": "session.interrupt", "params": {"session_id": "gone"}},
             transport=owner,
