From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 05:57:45 +0000
Subject: [PATCH] [daveey] Identify demand owner without exporting fact
 snapshots

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/fact_demand.py                     | 16 +++++------
 hermes_cli/fact_host.py                       |  2 +-
 .../hermes_cli/test_fact_demand_transport.py  | 27 +++++++++++++++++++
 3 files changed, 36 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/fact_demand.py b/hermes_cli/fact_demand.py
index 86b43e59fe8..2afeedff309 100644
--- a/hermes_cli/fact_demand.py
+++ b/hermes_cli/fact_demand.py
@@ -93,16 +93,16 @@ class DemandChannel:
         with connect(self.endpoint.path) as sock:
             sock.settimeout(1)
             send(sock, {"version": 1, "token": self.endpoint.token, "after": None})
-            if receive(sock)["scope"] != self.scope:
+            hello = receive(sock)
+            if hello["scope"] != self.scope:
                 raise ValueError("unauthorized_scope")
-            # The v1 hello has no epoch. Read a reset identity on this same
-            # connection so an ACK is never attributed to a different owner.
-            send(sock, {"op": "next"})
-            pin = receive(sock)["pin"]
-            send(sock, {"op": "release", "token": pin["token"]})
-            receive(sock)
+            # Authenticate the ACK's owner on this connection without exporting
+            # any facts. Older owners lacking epoch fail closed and retry.
+            epoch = hello["epoch"]
+            if not isinstance(epoch, str) or not epoch:
+                raise ValueError("invalid_owner_epoch")
             send(sock, command)
-            return pin["epoch"], receive(sock)["accepted"] is True
+            return epoch, receive(sock)["accepted"] is True
 
     def close(self):
         with self._lock:
diff --git a/hermes_cli/fact_host.py b/hermes_cli/fact_host.py
index 418209ff3d8..a0173ffebb5 100644
--- a/hermes_cli/fact_host.py
+++ b/hermes_cli/fact_host.py
@@ -55,7 +55,7 @@ class _Handler(socketserver.BaseRequestHandler):
             scope = owner.authorize(hello["token"])
             subscription = owner.store.subscribe(scope, (), None, hello.get("after"), lambda _: None)
             self.request.settimeout(60)
-            send(self.request, {"scope": scope})
+            send(self.request, {"scope": scope, "epoch": owner.store.snapshot(scope).epoch})
             while not owner.closed.is_set():
                 command = receive(self.request)
                 if owner.closed.is_set():
diff --git a/tests/hermes_cli/test_fact_demand_transport.py b/tests/hermes_cli/test_fact_demand_transport.py
index f5318c9726b..5db3f605de9 100644
--- a/tests/hermes_cli/test_fact_demand_transport.py
+++ b/tests/hermes_cli/test_fact_demand_transport.py
@@ -89,6 +89,33 @@ def test_old_ack_after_new_owner_reset_replays(tmp_path, monkeypatch):
         owner.close()
 
 
+@pytest.mark.platforms('posix')
+def test_demand_control_never_exports_fact_snapshot(tmp_path, monkeypatch):
+    from hermes_cli.fact_demand import DemandChannel
+    scope = Scope('install', 'profile')
+    token = 't' * 32
+    monkeypatch.chdir(tmp_path)
+    exported, delivered = threading.Event(), threading.Event()
+    owner = FactHost('owner', {token: scope}, demand=lambda *args: delivered.set())
+
+    def forbidden_export(subscription):
+        exported.set()
+        raise ValueError('demand_must_not_export_snapshot')
+
+    monkeypatch.setattr(owner, 'next', forbidden_export)
+    owner.start()
+    channel = DemandChannel(scope, Endpoint('owner/facts.sock', token))
+    try:
+        channel.put('title', {})
+        assert delivered.wait(2), 'demand stalled behind snapshot export'
+        assert not exported.is_set()
+        assert wait_until(lambda: all(not e.pending for e in channel._active.values()), timeout=2)
+        assert next(iter(channel._active.values())).epoch == owner.store.snapshot(scope).epoch
+    finally:
+        channel.close()
+        owner.close()
+
+
 def test_active_demand_bound_expiry_rejection_and_shutdown(monkeypatch):
     from hermes_cli import fact_demand
     now = [0.0]
