From fdd65e4211e2987001b40eabf69ca65fdd35bbf8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 08:36:16 +0000
Subject: [PATCH] fix(kanban): preserve human blocks and moved helper callers
 [daveey]


Public-series adaptation: preserve merged preceding changes.

---
diff --git a/hermes_cli/kanban_continuation.py b/hermes_cli/kanban_continuation.py
index deb60dfe52..f1bd40d4ae 100644
--- a/hermes_cli/kanban_continuation.py
+++ b/hermes_cli/kanban_continuation.py
@@ -282,7 +282,9 @@ def _enforce_wake_invariant(conn, tid: str, block_kind: Optional[str], now: int,
     if info is None:
         return False
     if block_kind in HUMAN_BLOCK_KINDS:
-        reason = kb._latest_block_reason(conn, tid) or info["reason"] or (
+        from hermes_cli.kanban_block_routing import latest_block_reason
+
+        reason = latest_block_reason(conn, tid) or info["reason"] or (
             "Parked in scheduled with no wake while waiting on a human answer.")
         with kb.write_txn(conn):
             cur = conn.execute(
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index cf6611da80..5f1fc00eb8 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -3248,6 +3248,7 @@ def block_task(
         ).fetchone()
         if cur_row is None:
             return False
+        from hermes_cli import kanban_assignment_routing as assignment_routing
         # The breaker (``_record_task_failure``) parks cards ``blocked`` with no
         # ``block_kind`` and no ``blocked`` event -- the policy is the
         # supervisor's, not the kernel's -- but the transition guard below only
@@ -3265,6 +3266,9 @@ def block_task(
             if not blocker_id and ktp.is_timed_park(kind, reason, parents_satisfied=_parents_satisfied(conn, task_id)):
                 return ktp.park(conn, task_id, reason=reason, requested_kind=kind, source_status="ready",
                                 from_untyped_block=True)
+            requested_kind, rekind_reason = kind, None
+            if kind == "assignment":
+                kind, rekind_reason = assignment_routing.classify(get_task(conn, task_id), kind, reason)
             classified = conn.execute(
                 "UPDATE tasks SET block_kind = ?, block_recurrences = 1 "
                 "WHERE id = ? AND status = 'blocked' AND block_kind IS NULL "
@@ -3274,9 +3278,9 @@ def block_task(
             if classified != 1:
                 return False
             payload = {"kind": kind, "reason": reason, "classified_in_place": True}
+            if requested_kind == "assignment":
+                payload.update(requested_kind=requested_kind, rekind_reason=rekind_reason)
             if kind == "assignment":
-                from hermes_cli import kanban_assignment_routing as assignment_routing
-                payload.update(requested_kind=kind, rekind_reason=None)
                 assignment_routing.route(conn, get_task(conn, task_id), payload)
             _append_event(conn, task_id, "blocked", payload)
             return True
diff --git a/hermes_cli/kanban_db_dispatch_quota.py b/hermes_cli/kanban_db_dispatch_quota.py
index b520c9c603..9c1588652f 100644
--- a/hermes_cli/kanban_db_dispatch_quota.py
+++ b/hermes_cli/kanban_db_dispatch_quota.py
@@ -95,7 +95,9 @@ def release_recovered_quota_blocks(conn: sqlite3.Connection) -> list[str]:
     ).fetchall()
     for row in rows:
         task_id = row["id"]
-        parsed = _parse_hold_block(_kb._latest_block_reason(conn, task_id))
+        from hermes_cli.kanban_block_routing import latest_block_reason
+
+        parsed = _parse_hold_block(latest_block_reason(conn, task_id))
         if parsed is None:
             continue
         guard_reason, err = parsed
diff --git a/tests/hermes_cli/test_kanban_assignment_routing.py b/tests/hermes_cli/test_kanban_assignment_routing.py
index b8b905537d..f90604bedc 100644
--- a/tests/hermes_cli/test_kanban_assignment_routing.py
+++ b/tests/hermes_cli/test_kanban_assignment_routing.py
@@ -63,14 +63,30 @@ def test_routes_real_mismatch_to_durable_supervisor(board, kind):
     assert conn.execute('SELECT count(*) FROM tasks').fetchone()[0] == 2
 
 
+@pytest.mark.parametrize('parked', [False, True], ids=['ready', 'breaker-parked'])
 @pytest.mark.parametrize('kind', ['capability', 'assignment'])
 @pytest.mark.parametrize('reason', ['Need credentials', 'Please sign in to GitHub', 'Need API key',
                                   'Need user approval', 'Payment method expired', 'Policy decision required'])
-def test_real_human_access_request_not_rekinded(board, reason, kind):
+def test_real_human_access_request_not_rekinded(board, reason, kind, parked):
     conn, _ = board
     tid = task_with_drift(board)
+    if parked:
+        conn.execute("UPDATE tasks SET status='blocked' WHERE id=?", (tid,))
+        conn.commit()
     assert kb.block_task(conn, tid, kind=kind, reason=reason)
-    assert kb.get_task(conn, tid).block_kind == 'capability'
+    task = kb.get_task(conn, tid)
+    assert task is not None
+    assert task.block_kind == 'capability'
+    assert task.status == 'blocked'
+    assert task.assignee == 'worker'
+    audit = payload(conn, tid)
+    assert audit['kind'] == 'capability'
+    assert 'supervisor_task_id' not in audit
+    if kind == 'assignment':
+        assert audit['requested_kind'] == 'assignment'
+        assert audit['rekind_reason'] == 'human_access_request'
+    if parked:
+        assert audit['classified_in_place'] is True
     assert conn.execute('SELECT count(*) FROM tasks').fetchone()[0] == 1
 
 
