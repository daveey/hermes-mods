From 0397ba2abd1be2b28c41626152696f0901acab4f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 03:26:32 +0000
Subject: [PATCH] [daveey] Recover committed card answer after verification
 race

---
 hermes_cli/kanban_card_answer.py              | 10 ++++++-
 .../test_kanban_card_answer_verify_race.py    | 26 +++++++++++++++++++
 2 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_card_answer_verify_race.py

diff --git a/hermes_cli/kanban_card_answer.py b/hermes_cli/kanban_card_answer.py
index dae8c18d51..617af7f1c1 100644
--- a/hermes_cli/kanban_card_answer.py
+++ b/hermes_cli/kanban_card_answer.py
@@ -184,7 +184,15 @@ def apply(conn, request: dict, *, owner_gateway: str, owner_profile: str, board:
         raise AnswerRefused("unverified_user_decision")
     current = snapshot(conn, request["task"])
     if current is None or current["generation"] != request["generation"]:
-        raise AnswerRefused("stale_ask")
+        # Another delivery may commit while source verification is in flight.
+        # Resolve its fully validated receipt under the same owner write lock
+        # before interpreting the resulting lifecycle change as a stale ask.
+        with kb.write_txn(conn):
+            _owner(conn, request['task'], owner_gateway, require_primary=require_primary)
+            old = _receipt(conn, request, fingerprint)
+            if old is not None:
+                return old
+            raise AnswerRefused("stale_ask")
     options = current["ask"].get("choices") or [
         {"label": "Unblock", "value": "unblock"}, {"label": "Archive", "value": "archive"},
     ]
diff --git a/tests/hermes_cli/test_kanban_card_answer_verify_race.py b/tests/hermes_cli/test_kanban_card_answer_verify_race.py
new file mode 100644
index 0000000000..d238c46c80
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_card_answer_verify_race.py
@@ -0,0 +1,26 @@
+"""A duplicate committed during source verification retains its original receipt."""
+import pytest
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli import test_kanban_card_answer as helpers
+
+kanban_home = helpers.kanban_home
+
+
+@pytest.mark.parametrize('mode', ['choice', 'archive', 'comment'])
+def test_duplicate_commits_during_source_read_returns_winner(kanban_home, mode):
+    with kbc.connect_closing() as conn:
+        answer = helpers.setup_answer(conn, choices=mode != 'archive')
+        if mode == 'archive':
+            answer['choice'] = 'archive'
+        elif mode == 'comment':
+            answer.update(mode='comment', choice='Need context')
+        winner = []
+
+        def source(request):
+            with kbc.connect_closing() as other:
+                winner.append(helpers.apply(other, answer))
+            return helpers.verified(request)
+
+        loser = helpers.apply(conn, answer, source)
+        assert loser == winner[0]
+        assert len(helpers.comments(conn, answer['task'])) == 1
