From 49f25091b12cb891a4c62f30359f19929efdecfd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 17:38:55 +0000
Subject: [PATCH] fix(tests): pass lock wait by argv, not env

---
 hermes_cli/backup_sqlite.py                       | 4 ++--
 tests/hermes_cli/test_backup_preflight_staging.py | 5 ++---
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/backup_sqlite.py b/hermes_cli/backup_sqlite.py
index 3cfc66cc06..dbe58cdffa 100644
--- a/hermes_cli/backup_sqlite.py
+++ b/hermes_cli/backup_sqlite.py
@@ -266,6 +266,6 @@ if __name__ == "__main__":
     # The Desktop stops a pre-flight past its deadline with SIGTERM; exit through
     # the staging cleanup instead of dying with a full-size .partial left behind.
     signal.signal(signal.SIGTERM, lambda signum, _frame: sys.exit(128 + signum))
-    # Tests hold the source locked as a barrier and need the lock wait to outlast a starved runner.
-    _busy = float(os.environ.get("HERMES_PREFLIGHT_BUSY_TIMEOUT_SECONDS") or 10.0)
+    # Optional argv[2]: tests hold the source locked as a barrier and need the lock wait to outlast a starved runner.
+    _busy = float(sys.argv[2]) if len(sys.argv) > 2 else 10.0
     print(json.dumps(preflight_state_db(Path(sys.argv[1]), busy_timeout_seconds=_busy)))
diff --git a/tests/hermes_cli/test_backup_preflight_staging.py b/tests/hermes_cli/test_backup_preflight_staging.py
index e020d080a5..46719653cd 100644
--- a/tests/hermes_cli/test_backup_preflight_staging.py
+++ b/tests/hermes_cli/test_backup_preflight_staging.py
@@ -42,9 +42,8 @@ def test_sigterm_mid_copy_removes_the_staging_copy(tmp_path):
     holder.execute("BEGIN EXCLUSIVE")
     try:
         # The child's own 10s lock deadline must not expire while a starved runner delays the SIGTERM.
-        env = {**os.environ, "HERMES_PREFLIGHT_BUSY_TIMEOUT_SECONDS": "600"}
-        proc = subprocess.Popen([sys.executable, "-I", "-S", str(SCRIPT), str(home)],
-                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+        proc = subprocess.Popen([sys.executable, "-I", "-S", str(SCRIPT), str(home), "600"],
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
         try:
             wait_until(lambda: _staging(home) or proc.poll() is not None, timeout=30, what="the staging copy")
             assert proc.poll() is None and _staging(home), "the pre-flight must still be copying"
-- 
