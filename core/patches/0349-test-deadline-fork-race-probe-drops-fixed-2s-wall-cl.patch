From c35d1c0a68ee7bacff944f117346d58c10c1cd39 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:46:50 -0700
Subject: [PATCH] test(deadline): fork-race probe drops fixed 2s wall-clock
 budgets (load-proof timeout, event waits)

---
diff --git a/tests/agent/test_deadline_fork_race.py b/tests/agent/test_deadline_fork_race.py
index 1e784a305a80f4c9751e337dd95407f302287537..b83bf8625a8d457ef326b66b10c89bbbce1a7c8f 100644
--- a/tests/agent/test_deadline_fork_race.py
+++ b/tests/agent/test_deadline_fork_race.py
@@ -19,7 +19,7 @@ def test_cron_timeout_closes_the_descendant_snapshot_fork_window(tmp_path, stop_
     result = subprocess.run(
         [sys.executable, str(probe)],
         env={**os.environ, "HOME": str(tmp_path), "HERMES_HOME": str(tmp_path), **extra},
-        stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=35,
+        stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=180,
         check=False,
     )
     assert result.returncode == 0, result.stdout + result.stderr
