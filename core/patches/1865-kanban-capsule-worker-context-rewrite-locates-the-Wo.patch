 gateway/session_kanban_capsule.py           | 45 +++++++++++++++----
 hermes_cli/kanban_db_context.py             | 11 +++++
 tests/tools/test_capsule_worker_contract.py | 48 ++++++++++++++++++++-
 tools/kanban_tools_capsule.py               |  4 +-
 5 files changed, 107 insertions(+), 14 deletions(-)

