From 2c8dfd004b4a8562b6c2f0d8072f9a01740e6c71 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:47:09 -0700
Subject: [PATCH] test: autouse guard fails and undoes any test that writes
 user.* into a live checkout's .git/config

---
 tests/conftest.py                   | 94 +++++++++++++++++++++++++++++
 tests/test_live_git_config_guard.py | 38 ++++++++++++
 2 files changed, 132 insertions(+)
 create mode 100644 tests/test_live_git_config_guard.py

diff --git a/tests/conftest.py b/tests/conftest.py
index d1620cb2cd..838a7276a5 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -468,6 +468,96 @@ def _neutralize_kanban_memory_guard(request, monkeypatch):
     monkeypatch.setattr(_kbd_mod, "_system_memory_sample", dict, raising=False)
 
 
+_LIVE_GIT_CONFIGS: list | None = None
+
+
+def _live_git_config_paths() -> list:
+    """Shared ``.git/config`` files of the checkout under test and the live install.
+
+    Resolved once with plain subprocesses: the per-test home-I/O guard refuses
+    in-process file access to the real ``~/.hermes`` tree, and this guard must
+    still watch it.
+    """
+    global _LIVE_GIT_CONFIGS
+    if _LIVE_GIT_CONFIGS is not None:
+        return _LIVE_GIT_CONFIGS
+    paths: dict = {}
+    for root in (PROJECT_ROOT, Path.home() / ".hermes" / "hermes-agent"):
+        try:
+            rc, raw = _plain_run(
+                ["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"]
+            )
+            out = raw.decode().strip() if rc == 0 else ""
+        except Exception:
+            continue
+        if out:
+            paths[out] = Path(out) / "config"
+    _LIVE_GIT_CONFIGS = list(paths.values())
+    return _LIVE_GIT_CONFIGS
+
+
+def _plain_run(argv: list):
+    """``(returncode, stdout)`` via Popen, immune to tests that fake ``subprocess.run``."""
+    import subprocess
+
+    proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+    out, _ = proc.communicate()
+    return proc.returncode, out
+
+
+def _read_bytes_or_none(path: Path):
+    """Identity (``user.*``) entries of a git config file, or None if it is absent.
+
+    Read through ``git config --file`` so the in-process home-I/O guard is not
+    involved. Only ``user.*`` is compared: branch/remote entries in the shared
+    config legitimately change whenever any worktree or branch is created.
+    """
+    import subprocess
+
+    if _plain_run(["test", "-f", str(path)])[0] != 0:
+        return None
+    return _plain_run(["git", "config", "--file", str(path), "--get-regexp", r"^user\."])[1]
+
+
+def _assert_git_configs_unchanged(snapshots: dict) -> None:
+    """Remove identity entries added to a config since *snapshots* and fail naming it."""
+    changed = []
+    for path, before in snapshots.items():
+        after = _read_bytes_or_none(path)
+        if after == before:
+            continue
+        changed.append(str(path))
+        before_keys = {ln.split(b" ", 1)[0] for ln in (before or b"").splitlines()}
+        for ln in (after or b"").splitlines():
+            key = ln.split(b" ", 1)[0]
+            if key not in before_keys:
+                _plain_run(["git", "config", "--file", str(path), "--unset-all", key.decode()])
+    if changed:
+        pytest.fail(
+            "test wrote user.* into a live checkout's git config (removed): "
+            + ", ".join(changed)
+            + " - run git config only inside a tmp_path repo",
+            pytrace=False,
+        )
+
+
+@pytest.fixture(autouse=True)
+def _live_git_config_guard(request):
+    """Fail (and undo) any test that rewrites a real checkout's ``.git/config``.
+
+    A test that runs ``git config user.email t@example.com`` with a cwd inside
+    the live checkout writes the identity into the config every linked worktree
+    shares, so later commits get authored as the fixture. Such a test must init
+    its own repo under ``tmp_path``.
+    """
+    if request.node.get_closest_marker("allow_live_git_config"):
+        yield
+        return
+    snapshots = {path: _read_bytes_or_none(path) for path in _live_git_config_paths()}
+    yield
+    _assert_git_configs_unchanged(snapshots)
+
+
 @pytest.fixture(autouse=True)
 def _neutralize_git_safe_directory_read(request, monkeypatch):
     """Skip the ``git config --get-all safe.directory`` pre-read in ``noninteractive_git_env()``.
@@ -1174,6 +1264,10 @@ def pytest_configure(config):
         "created in the current environment (needs admin/developer mode "
         "on Windows).",
     )
+    config.addinivalue_line(
+        "markers",
+        "allow_live_git_config: bypass the autouse guard that fails tests changing the live checkout .git/config",
+    )
     config.addinivalue_line(
         "markers",
         "real_memory_guard: bypass the autouse fixture that pins the kanban "
diff --git a/tests/test_live_git_config_guard.py b/tests/test_live_git_config_guard.py
new file mode 100644
index 0000000000..df9fae91ed
--- /dev/null
+++ b/tests/test_live_git_config_guard.py
@@ -0,0 +1,38 @@
+"""Regression: the conftest guard catches writes to a checkout's shared .git/config."""
+
+import subprocess
+
+import pytest
+
+from tests.conftest import _assert_git_configs_unchanged, _live_git_config_paths, _read_bytes_or_none
+
+
+def _init(path):
+    subprocess.run(["git", "init", "-q", str(path)], check=True)
+    return path / ".git" / "config"
+
+
+def test_guard_watches_the_checkout_under_test():
+    assert _live_git_config_paths()
+
+
+def test_guard_fails_and_restores_when_identity_is_written(tmp_path):
+    cfg = _init(tmp_path)
+    snapshots = {cfg: _read_bytes_or_none(cfg)}
+    subprocess.run(["git", "-C", str(tmp_path), "config", "user.email", "t@example.com"], check=True)
+    assert b"t@example.com" in _read_bytes_or_none(cfg)
+    with pytest.raises(pytest.fail.Exception, match="wrote user"):
+        _assert_git_configs_unchanged(snapshots)
+    assert b"t@example.com" not in _read_bytes_or_none(cfg)
+
+
+def test_guard_is_quiet_when_config_is_untouched(tmp_path):
+    cfg = _init(tmp_path)
+    _assert_git_configs_unchanged({cfg: _read_bytes_or_none(cfg)})
+
+
+def test_guard_ignores_branch_and_remote_entries(tmp_path):
+    cfg = _init(tmp_path)
+    snapshots = {cfg: _read_bytes_or_none(cfg)}
+    subprocess.run(["git", "-C", str(tmp_path), "config", "branch.x.remote", "origin"], check=True)
+    _assert_git_configs_unchanged(snapshots)
-- 
