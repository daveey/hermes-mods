+def test_counts_are_logged_at_most_every_60_s(caplog):
+    clock = FakeClock()
+    sender = None
+    n = [0]
+
+    class Reporter:
+        def report_tick(self, send):
+            n[0] += 1
+            if n[0] == 30:  # 300 s of ticks
+                sender._stop.set()
+            return True
