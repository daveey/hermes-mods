From 477a897a900b6a07c90d62c7583b2535759cf36b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:27:50 +0000
Subject: [PATCH] [daveey] fix(guard): name the sanctioned deploy route when
 refusing hermes-sync in the gateway

A refused hermes-sync run (lifecycle content or over the scan budget) now says
hermes-sync runs only from its scheduled pass, names the ff-only hermes-mods merge
plus the mods-reload: log line, and forbids systemd-run/nohup/setsid wrappers.
Other refusals keep today's text. Self-heal defect agent-d48ea04d62.
---
 .../test_lifecycle_guard_hermes_sync_hint.py  | 58 +++++++++++++++++++
 tools/terminal_tool_guards.py                 | 27 ++++++++-
 2 files changed, 83 insertions(+), 2 deletions(-)
 create mode 100644 tests/tools/test_lifecycle_guard_hermes_sync_hint.py

diff --git a/tests/tools/test_lifecycle_guard_hermes_sync_hint.py b/tests/tools/test_lifecycle_guard_hermes_sync_hint.py
new file mode 100644
index 0000000000..9934cc381a
--- /dev/null
+++ b/tests/tools/test_lifecycle_guard_hermes_sync_hint.py
@@ -0,0 +1,58 @@
+"""A refused hermes-sync run names the sanctioned in-gateway deploy route.
+
+Regression for self-heal defect agent-d48ea04d62: hub chats ran
+``~/.hermes/sync-runner/hermes-sync mods-pull`` inside the gateway, got the generic
+"run it from a separate shell" refusal, and retried it wrapped in ``systemd-run``.
+"""
+
+import json
+
+import pytest
+
+from tools.terminal_tool_guards import gateway_lifecycle_block
+
+_ROUTE = "git -C ~/code/hermes-mods merge --ff-only origin/main"
+
+
+def _script(tmp_path, name, body):
+    path = tmp_path / "sync-runner" / name
+    path.parent.mkdir(exist_ok=True)
+    path.write_text(body)
+    path.chmod(0o755)
+    return path
+
+
+def _refuse(tmp_path, monkeypatch, command):
+    from tools import process_registry
+
+    monkeypatch.setattr(process_registry, "_is_supervised_gateway_process", lambda: True)
+    blocked = gateway_lifecycle_block(
+        command=command, env=None, env_type="local", cwd=str(tmp_path), workdir=None,
+        session_key="hermes-sync-hint-test",
+    )
+    assert blocked is not None
+    return json.loads(blocked)["error"]
+
+
+@pytest.mark.parametrize("kind", ["restart", "unscannable"])
+def test_refused_hermes_sync_names_the_sanctioned_route(tmp_path, monkeypatch, kind):
+    if kind == "restart":
+        body = "#!/bin/sh\nhermes gateway restart\n"
+    else:  # over the scan line cap, as the hub's 17962-line hermes-sync is
+        body = "#!/bin/sh\n" + "true\n" * 20000
+    script = _script(tmp_path, "hermes-sync", body)
+
+    error = _refuse(tmp_path, monkeypatch, f"{script} mods-pull")
+
+    assert _ROUTE in error
+    assert "mods-reload:" in error
+    assert "systemd-run" in error
+
+
+def test_other_refusals_keep_the_generic_text(tmp_path, monkeypatch):
+    script = _script(tmp_path, "deploy.sh", "#!/bin/sh\nhermes gateway restart\n")
+
+    error = _refuse(tmp_path, monkeypatch, str(script))
+
+    assert _ROUTE not in error
+    assert "hermes gateway restart" in error
diff --git a/tools/terminal_tool_guards.py b/tools/terminal_tool_guards.py
index aaab6004b7..01c0521851 100644
--- a/tools/terminal_tool_guards.py
+++ b/tools/terminal_tool_guards.py
@@ -578,6 +578,28 @@ def _session_aliases_for_guard(env: Any) -> Optional[frozenset[str]]:
     return None
 
 
+# hermes-sync can idle-restart the gateway it runs under, so the guard refuses it inside the
+# gateway (by lifecycle content, or because the script is over the scan budget). The generic
+# "separate shell" advice made agents wrap it in systemd-run/nohup; name the sanctioned route.
+_HERMES_SYNC_WORD = re.compile(r"(?:^|[\s/;&|(`'\"])hermes-sync(?=$|[\s;&|)`'\"])")
+
+
+def _refusal_hint(command: str) -> str:
+    if not _HERMES_SYNC_WORD.search(command):
+        return ""
+    from hermes_constants import display_hermes_home
+
+    return (
+        " hermes-sync runs only from its scheduled cron/systemd pass, never from a gateway chat. "
+        "To deploy a pushed hermes-mods commit from here, run "
+        "`git -C ~/code/hermes-mods fetch -q origin && git -C ~/code/hermes-mods merge --ff-only origin/main`, "
+        "then wait for the next scheduled "
+        f"sync pass and read its `mods-reload:` line in {display_hermes_home()}/logs/hermes-sync.log. "
+        "Do not wrap hermes-sync in systemd-run, nohup, setsid or a background shell to get past "
+        "this refusal."
+    )
+
+
 def gateway_lifecycle_block(
     *,
     command: str,
@@ -652,7 +674,8 @@ def gateway_lifecycle_block(
             f"Blocked: the lifecycle guard could not scan this command or referenced script: {refusal}. "
             "Nothing in the command is known to contain a gateway lifecycle command, but a "
             "script the command executes must be scannable (a regular text file "
-            f"{lifecycle_scan_budget_summary()}) before it can run inside the gateway process.",
+            f"{lifecycle_scan_budget_summary()}) before it can run inside the gateway process."
+            + _refusal_hint(command),
             "error",
         )
     if unsafe:
@@ -665,7 +688,7 @@ def gateway_lifecycle_block(
             "uninstall the gateway from inside the gateway process. The gateway would "
             "kill this command before it could complete (SIGTERM propagates "
             "to child processes). Run `hermes gateway restart` from a "
-            "separate shell outside the running gateway.",
+            "separate shell outside the running gateway." + _refusal_hint(command),
             "error",
         )
     return None
-- 
2.51.0

