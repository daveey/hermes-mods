From 689616c674322b9e9255a9bf0d6edf8482e2585a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 08:47:39 +0000
Subject: [PATCH] fix(kanban): bounded CPU metrics POST shuts its socket on
 expiry so a trickling Board cannot keep the abandoned thread alive (HX012
 trace) [daveey]

---
 hermes_cli/kanban_sync_client.py              | 38 +++++++++++++++++-
 .../test_kanban_sync_metrics_budget.py        | 40 +++++++++++++++++++
 2 files changed, 76 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index a250ff825f1..01a53a038a9 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -170,10 +170,40 @@ def _bounded_call(ident: Identity, method: str, path: str, body: Optional[dict],
     The request runs on a daemon thread whose own Hub carries the absolute deadline (every attempt's socket timeout
     is recomputed by ``Hub._remaining``). Waiting for that thread is bounded by the same deadline, so a response
     that trickles in byte by byte, each recv inside its timeout, still cannot hold the caller past ``budget_s``.
-    An abandoned thread ends at its next socket timeout (<= budget_s) and closes its connection."""
+    A trickle never trips a socket timeout, so on expiry the caller also shuts the request's socket down (or, if it
+    is still connecting, the connect does so itself): the abandoned thread's blocked recv returns at once and the
+    thread closes its connection. A POST is never resent, so nothing is retried on that socket. Name resolution
+    (getaddrinfo) cannot be interrupted; it is bounded by the system resolver's own timeouts."""
     deadline = time.monotonic() + budget_s
-    hub = Hub(ident, timeout=budget_s, deadline=deadline)
     box: dict = {}
+    expiry = _hub_threading.Lock()
+
+    def cut(conn) -> None:
+        import socket
+        sock = getattr(conn, "sock", None)
+        if sock is not None:
+            try:  # the base method: never touches an SSL object another thread is reading through
+                socket.socket.shutdown(sock, socket.SHUT_RDWR)
+            except OSError:
+                pass
+
+    class _Bounded(Hub):
+        def _connection(self, parts, timeout=None):
+            pair = super()._connection(parts, timeout)
+            conn = pair[0]
+            connect = conn.connect
+
+            def connect_then_check() -> None:
+                connect()
+                with expiry:
+                    if box.get("expired"):
+                        cut(conn)
+            conn.connect = connect_then_check
+            with expiry:
+                box["conn"] = conn
+            return pair
+
+    hub = _Bounded(ident, timeout=budget_s, deadline=deadline)
 
     def run() -> None:
         try:
@@ -187,6 +217,10 @@ def _bounded_call(ident: Identity, method: str, path: str, body: Optional[dict],
     worker.start()
     worker.join(max(0.0, deadline - time.monotonic()))
     if worker.is_alive():
+        with expiry:
+            box["expired"] = True
+            if "conn" in box:
+                cut(box["conn"])
         raise TimeoutError(f"Board request exceeded its {budget_s:g} s total budget")
     if "error" in box:
         raise box["error"]
diff --git a/tests/hermes_cli/test_kanban_sync_metrics_budget.py b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
index 366d8387c90..04cff646373 100644
--- a/tests/hermes_cli/test_kanban_sync_metrics_budget.py
+++ b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
@@ -92,3 +92,43 @@ def test_cpu_report_succeeds_inside_budget_and_plain_report_keeps_normal_path(se
 
 def test_cpu_report_budget_is_two_seconds():
     assert ksc.CPU_REPORT_BUDGET_S == 2.0
+
+
+@pytest.mark.parametrize("server", ["stall", "trickle"], indirect=True)
+def test_abandoned_bounded_call_thread_ends_promptly_after_the_budget(server, monkeypatch):
+    """HX012 trace: a trickling response keeps every recv inside its socket timeout, so the abandoned request thread
+    is not ended by a timeout. The caller's expiry must end it (and close its socket), or one thread and connection
+    leaks per 10 s report for as long as the server trickles."""
+    monkeypatch.setattr(ksc.urllib.request, "getproxies", dict)
+    before = {t for t in threading.enumerate() if t.name == "kanban-bounded-call"}
+    with pytest.raises(TimeoutError):
+        ksc._bounded_call(ksc.Identity(url=server.url, key="k" * 16, gateway="gw"), "POST",
+                          "/v2/machines/me/metrics", {"cpus": 4, **CPU}, 1.0)
+    expired = time.monotonic()
+    left = [t for t in threading.enumerate() if t.name == "kanban-bounded-call" and t not in before]
+    for t in left:
+        t.join(1.0)
+    assert not any(t.is_alive() for t in left), "abandoned request thread outlived the budget by > 1 s"
+    assert time.monotonic() - expired <= 1.0
+
+
+@pytest.mark.parametrize("server", ["trickle"], indirect=True)
+def test_connect_finishing_after_expiry_cuts_its_own_socket(server, monkeypatch):
+    """Race arm: the budget expires while the request thread is still connecting (no socket for the caller to cut).
+    The connect must then shut its new socket itself, so the trickle cannot keep the thread alive."""
+    import http.client
+    monkeypatch.setattr(ksc.urllib.request, "getproxies", dict)
+    real_connect = http.client.HTTPConnection.connect
+
+    def slow_connect(self):
+        time.sleep(1.3)  # health: allow HX013 -- a connect still in progress when the 1 s budget expires
+        real_connect(self)
+    monkeypatch.setattr(http.client.HTTPConnection, "connect", slow_connect)
+    before = {t for t in threading.enumerate() if t.name == "kanban-bounded-call"}
+    with pytest.raises(TimeoutError):
+        ksc._bounded_call(ksc.Identity(url=server.url, key="k" * 16, gateway="gw"), "POST",
+                          "/v2/machines/me/metrics", {"cpus": 4, **CPU}, 1.0)
+    left = [t for t in threading.enumerate() if t.name == "kanban-bounded-call" and t not in before]
+    for t in left:
+        t.join(1.5)
+    assert not any(t.is_alive() for t in left), "a connect that finished after expiry left a trickling thread alive"
-- 
