From 6413c4d5bf3cc08a6750b3473410699d4fdbdd94 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 09:16:00 +0000
Subject: [PATCH] [daveey] match Bash control-backslash and overflow delimiter
 escapes

Consume the paired backslash control operand and drop signed-32-bit Unicode overflow escapes. Preserve fragment-local NUL truncation and legacy non-Unicode fallback. Proof: baseline cbc4fa05 regression matrix 36 RED / 62 controls passed; both fixes 98 GREEN plus 45 existing NUL cases. Real Bash harmless-marker and byte-boundary oracles; lifecycle payloads never executed. Full gates and independent exact-head review pending; no landing authorization.
---
 .../test_lifecycle_guard_heredoc_escapes.py   | 88 +++++++++++++++++++
 tools/shell_heredoc_words.py                  |  9 +-
 2 files changed, 94 insertions(+), 3 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_heredoc_escapes.py

diff --git a/tests/cron/test_lifecycle_guard_heredoc_escapes.py b/tests/cron/test_lifecycle_guard_heredoc_escapes.py
new file mode 100644
index 0000000000000000000000000000000000000000..697dd67765a3b894f9b02c4c4e5e177482f8bebe
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_heredoc_escapes.py
@@ -0,0 +1,88 @@
+"""Bash control-backslash and unencodable ANSI-C delimiter regressions."""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+from tests.cron.test_lifecycle_guard_heredoc_nul import LIFECYCLE, _group
+from tools.shell_heredoc import _parse_heredoc_operator
+from tools.shell_heredoc_words import _decode_ansi_c
+
+CASES = [
+    (r"E\c\\", "E\x1c"),
+    (r"E\c\\x", "E\x1cx"),
+    (r"E\U80000000", "E"),
+    (r"E\UFFFFFFFE", "E"),
+    (r"E\UFFFFFFFF", "E"),
+    (r"E\UFFFFFFFFZ", "EZ"),
+    (r"E\UFFFFFFFFF", "EF"),
+    (r"E\U0010FFFF", "E\U0010FFFF"),
+    (r"E\uD7FF", "E\uD7FF"),
+    (r"E\uE000", "E\uE000"),
+    (r"E\0ignored", "E"),
+    (r"E\c\\\0ignored", "E\x1c"),
+    (r"E\UFFFFFFFF\0ignored", "E"),
+]
+
+
+@pytest.mark.parametrize(("fragment", "decoded"), CASES)
+def test_decoder(fragment, decoded):
+    assert _decode_ansi_c(fragment) == decoded
+    opener = f"<<$'{fragment}'"
+    assert _parse_heredoc_operator(opener, 0) == (len(opener), decoded, False, True)
+
+
+@pytest.mark.parametrize(("fragment", "decoded"), CASES)
+@pytest.mark.parametrize("suffix", ["", "tail", "$'F'"])
+def test_group_feed(tmp_path, fragment, decoded, suffix):
+    word = f"$'{fragment}'{suffix}"
+    terminator = decoded + ("F" if suffix == "$'F'" else suffix)
+    script = tmp_path / "f.py"
+    script.write_text(f"import os\nos.system({LIFECYCLE!r})\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(_group(word, terminator, script, "python3")) == (True, None)
+
+
+@pytest.mark.skipif(shutil.which("bash") is None, reason="needs bash")
+@pytest.mark.parametrize(("fragment", "decoded"), CASES)
+@pytest.mark.parametrize("suffix", ["", "tail", "$'F'"])
+def test_bash_marker_and_harmless_controls(tmp_path, fragment, decoded, suffix):
+    word = f"$'{fragment}'{suffix}"
+    terminator = decoded + ("F" if suffix == "$'F'" else suffix)
+    marker = tmp_path / "marker.py"
+    marker.write_text("print('MARKER_EXECUTED')\n", encoding="utf-8")
+    command = _group(word, terminator, marker, "python3")
+    result = subprocess.run(["bash", "--noprofile", "--norc"], input=command,
+                            capture_output=True, text=True, encoding="utf-8", timeout=20,
+                            env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"}, check=False)
+    assert (result.returncode, result.stdout, result.stderr) == (0, "MARKER_EXECUTED\n", "")
+    assert scan_gateway_lifecycle(command) == (False, None)
+    marker.write_text(f"import os\nos.system({LIFECYCLE!r})\n", encoding="utf-8")
+    # Never execute this file: a non-interpreter sink only prints its source.
+    assert scan_gateway_lifecycle(_group(word, terminator, marker, "cat")) == (False, None)
+
+
+@pytest.mark.skipif(shutil.which("bash") is None, reason="needs bash")
+@pytest.mark.parametrize(("escape", "hex_bytes"), [
+    (r"\U0010FFFF", "f48fbfbf"),
+    (r"\U00110000", "f4908080"),
+    (r"\U7FFFFFFF", "fdbfbfbfbfbf"),
+    (r"\U80000000", ""),
+    (r"\UFFFFFFFF", ""),
+    (r"\uD800", "eda080"),
+    (r"\uDFFF", "edbfbf"),
+])
+def test_bash_byte_boundaries(escape, hex_bytes):
+    # Bash supports legacy UTF-8 above Unicode's limit until signed 32-bit overflow.
+    # Those non-Unicode bytes cannot be a terminator in a UTF-8 str command.
+    result = subprocess.run(["bash", "--noprofile", "--norc"],
+                            input=f"printf %s $'{escape}'\n".encode(), capture_output=True,
+                            timeout=20, env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"},
+                            check=False)
+    assert (result.returncode, result.stdout, result.stderr) == (0, bytes.fromhex(hex_bytes), b"")
+    if escape in (r"\U00110000", r"\U7FFFFFFF"):
+        assert _decode_ansi_c(escape) == escape
+
diff --git a/tools/shell_heredoc_words.py b/tools/shell_heredoc_words.py
index 3d073a54e20d8dbf316c09094509444d7b539eac..dc186a9bd476100c5f0f971ed0e61abd60ef7e93 100644
--- a/tools/shell_heredoc_words.py
+++ b/tools/shell_heredoc_words.py
@@ -24,7 +24,7 @@ _ANSI_C_SIMPLE = {
 }
 _ANSI_C_ESCAPE_RE = re.compile(
     r"\\(?:(?P<simple>[abeEfnrtv\\'\"?])|(?P<octal>[0-7]{1,3})|x(?P<hex>[0-9A-Fa-f]{1,2})"
-    r"|u(?P<u4>[0-9A-Fa-f]{1,4})|U(?P<u8>[0-9A-Fa-f]{1,8})|c(?P<control>.))", re.DOTALL)
+    r"|u(?P<u4>[0-9A-Fa-f]{1,4})|U(?P<u8>[0-9A-Fa-f]{1,8})|c(?P<control>\\\\|.))", re.DOTALL)
 # A command substitution: ``$(`` that does not open arithmetic ``$((``.
 _COMMAND_SUBSTITUTION_RE = re.compile(r"\$\((?!\()")
 
@@ -41,13 +41,16 @@ def _decode_ansi_c(text: str) -> str:
         if match["simple"]:
             return _ANSI_C_SIMPLE[match["simple"]]
         if match["control"]:
-            return chr(ord(match["control"]) & 0x1F)
+            # A doubled backslash is one control operand, consumed as a pair.
+            return chr(ord(match["control"][0]) & 0x1F)
         code = (int(match["octal"], 8) if match["octal"] else
                 int(match["hex"] or match["u4"] or match["u8"], 16))
         try:
             return chr(code & 0xFF if match["octal"] else code)
         except (ValueError, OverflowError):
-            return match.group()
+            # Bash drops values overflowing its signed 32-bit character range.
+            # Legacy UTF-8 above Unicode's limit cannot match a str terminator.
+            return "" if code > 0x7FFFFFFF else match.group()
     # Bash truncates this ANSI-C fragment at NUL, not the concatenated shell word.
     # The caller still consumes its entire quoted span and reads subsequent fragments.
     return _ANSI_C_ESCAPE_RE.sub(replace, text).split("\0", 1)[0]
