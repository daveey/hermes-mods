From 2b74fc45ece647eec95fbda1078e6be6ffad0b5f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 8 Nov 2026 19:38:34 +0000
Subject: [PATCH] [daveey] Seed reserved child configuration through owner API

---
 run_agent.py                                  |  8 +++--
 .../test_delegate_transcript_readiness.py     | 30 +++++++++++++++++++
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/run_agent.py b/run_agent.py
index 1a7faa58f65..6386f18163e 100644
--- a/run_agent.py
+++ b/run_agent.py
@@ -346,9 +346,11 @@ class AIAgent(
                 # A reserved child row already exists, and first-turn writers (prompt-refresh epoch,
                 # usage anchor) may have patched its model_config before this create, so the
                 # keep-existing upsert dropped the constructor config. Merge it beside them.
-                patch = {k: v for k, v in (self._session_row_model_config() or {}).items() if v is not None}
-                if patch:
-                    self._session_db.patch_session_model_config(self.session_id, patch)
+                # [daveey] Only owner stores reserve rows. Constructor lineage/non-sidecar keys
+                # belong in the owner seed API; preserve any authoritative first-turn values.
+                seed = {k: v for k, v in (self._session_row_model_config() or {}).items() if v is not None}
+                if seed:
+                    self._session_db.seed_session_model_config(self.session_id, seed)
             self._session_db_created = True
             if source == "kanban":
                 from hermes_cli.kanban_worker_recovery import register_worker_session
diff --git a/tests/tools/test_delegate_transcript_readiness.py b/tests/tools/test_delegate_transcript_readiness.py
index 24b50646afe..804950e7956 100644
--- a/tests/tools/test_delegate_transcript_readiness.py
+++ b/tests/tools/test_delegate_transcript_readiness.py
@@ -157,6 +157,36 @@ async def test_published_children_open_before_any_child_starts(
             child.close()
 
 
+@pytest.mark.asyncio
+async def test_reserved_child_init_preserves_early_owner_config(
+    tmp_path, monkeypatch, offline_children
+):
+    connection, parent_ref = await _connect(tmp_path, monkeypatch, "sub-1")
+    db = connection.authority.db
+    child = _build_child_agent(
+        task_index=0, goal="Synthetic inspection", context=None, toolsets=["file"],
+        model=None, max_iterations=2, task_count=1,
+        parent_agent=_parent(db, parent_ref.session_id, lambda *a, **kw: None),
+    )
+    try:
+        # A first-turn owner write is authoritative over stale constructor defaults.
+        db.seed_session_model_config(child.session_id, {"max_iterations": 7, "max_tokens": None})
+        early = json.loads(db.get_session(child.session_id)["model_config"])
+        assert early["max_iterations"] == 7 and early["max_tokens"] is None
+        child._session_init_model_config["max_tokens"] = 128
+        child._cached_system_prompt = "Synthetic completed prompt"
+        stamp_prompt_epoch(child, 17)
+        child._ensure_db_session()
+        config = json.loads(db.get_session(child.session_id)["model_config"])
+        assert config["max_iterations"] == 7
+        assert config["max_tokens"] is None
+        assert config["_delegate_from"] == parent_ref.session_id
+        assert config["prompt_refresh_epoch"] == 17
+        assert child._session_db_created
+    finally:
+        child.close()
+
+
 @pytest.mark.asyncio
 async def test_failed_reservation_closes_unpublished_child_and_a_later_build_can_retry(
     tmp_path,
