From 37c6bc69a0c6318390f8743c9a9880393404f566 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 03:44:03 +0000
Subject: [PATCH 6924] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit 37c6bc69a0c6318390f8743c9a9880393404f566.

---
diff --git a/hermes_cli/kanban_replay_sender.py b/hermes_cli/kanban_replay_sender.py
index c630338c87fc6543984a20c54e5f04db0a7e5f57..e10e27153cba03578ec8d26b841c74fd01ed4858 100644
--- a/hermes_cli/kanban_replay_sender.py
+++ b/hermes_cli/kanban_replay_sender.py
@@ -76,8 +76,12 @@
     path = _main_db_file(conn)
     if path is None:
         raise ValueError('sender requires an on-disk board')
-    client.refuse_if_schema_ahead(conn)
-    if not journal.bound_custody(conn):
+    try:
+        client.refuse_if_schema_ahead(conn)
+        bound = journal.bound_custody(conn)
+    except ValueError:
+        bound = True  # Loss/invalid anchors are judged, and held, by _push under the fence.
+    if not bound:
         return _push(conn, hub, board, gateway, primary=primary, max_batches=max_batches,
                      before_head=before_head, seen=seen)
     with _sender_fence(path):
diff --git a/tests/hermes_cli/test_kanban_replay_sender_process.py b/tests/hermes_cli/test_kanban_replay_sender_process.py
index e4650a506e8a9e0bac3ba1cfcb1cf45c319ef9e4..3cfaaa6ddf454a95056fa8eb40f2c86162c012a5 100644
--- a/tests/hermes_cli/test_kanban_replay_sender_process.py
+++ b/tests/hermes_cli/test_kanban_replay_sender_process.py
@@ -140,3 +140,29 @@
         assert receiver.calls == []
     finally:
         conn.close()
+
+
+def test_direct_push_on_bound_board_waits_for_a_briefly_held_fence(live, monkeypatch):
+    from hermes_cli import kanban_replay_sender
+    from hermes_cli.kanban_sync_guard import sender_lock
+    kb.create_task(live, title='direct caller', assignee='worker')
+    path = Path(live.execute('PRAGMA database_list').fetchone()[2])
+    monkeypatch.setattr(kanban_replay_sender, 'DIRECT_WAIT_S', 20)
+    held, release = threading.Event(), threading.Event()
+
+    def hold():
+        with sender_lock(path):
+            held.set()
+            release.wait(30)
+
+    thread = threading.Thread(target=hold)
+    thread.start()
+    try:
+        assert held.wait(10)
+        threading.Timer(0.5, release.set).start()
+        receiver = helpers.Receiver()
+        result = client.push(live, receiver, 'default', 'macbook', primary=False, max_batches=1)
+        assert result.applied == 1
+    finally:
+        release.set()
+        thread.join(10)
