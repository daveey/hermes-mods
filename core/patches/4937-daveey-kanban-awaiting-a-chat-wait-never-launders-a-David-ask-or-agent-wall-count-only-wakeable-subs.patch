From 543ed1a3bc4bd5627d37c1f0a0517e596754b03a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 06:25:19 +0000
Subject: [PATCH] [daveey] kanban awaiting: a chat wait never launders a David
 ask or agent wall; count only wakeable subs

Adversarial review of the previous head: _check_chat skipped text_wall, so a
wait on David or an agent wall parked as a chat notice once it named the
orchestrator (declared kind 'chat', or an external ref/reason reclassified),
including a park refused today as human_wait. And has_chat_subscriber counted
any subscription, so a plain notify messaging row (a passive ping, maybe to a
person) or a hub relay row (carries only cards that turned terminal) passed
although nothing would wake an orchestrator.

- _check_chat runs text_wall and refuses with human_wait / agent_action_wait,
  as a clock wait does.
- has_chat_subscriber counts only tui rows and notify+wake / wake rows.

Tests: the adversary's five rows (tool path) and four subscription shapes;
7 of them fail on the previous head.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_awaiting.py                | 20 ++++++--
 tests/hermes_cli/test_kanban_decision_ask.py | 49 ++++++++++++++++++++
 2 files changed, 66 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_awaiting.py b/hermes_cli/kanban_awaiting.py
index 5155e687c2a2097fab048669fbbeb8488e0d9aa8..c92d86f57b73eafd1960292ee9e6881c0cf287b7 100644
--- a/hermes_cli/kanban_awaiting.py
+++ b/hermes_cli/kanban_awaiting.py
@@ -491,9 +491,16 @@ def orchestrator_wait(text: Optional[str], ref: Optional[str] = None) -> bool:
 
 
 def has_chat_subscriber(conn: sqlite3.Connection, task_id: str) -> bool:
-    """A chat that would receive the card's notices: any notify subscription on the card."""
+    """A subscribed chat that ``decision_requested`` can wake.
+
+    A ``tui`` row: the live poller queues it and the unloaded sweeper starts a turn in a dormant chat. A
+    ``notify+wake`` / ``wake`` row: the gateway notifier wakes the agent. Not a plain ``notify`` messaging row
+    (a passive ping, possibly to a person rather than the orchestrator) and not a ``hub`` relay row, which
+    carries only cards that turned terminal, never a parked card's events."""
     try:
-        return conn.execute("SELECT 1 FROM kanban_notify_subs WHERE task_id = ? LIMIT 1", (task_id,)).fetchone() is not None
+        return conn.execute(
+            "SELECT 1 FROM kanban_notify_subs WHERE task_id = ? AND (platform = 'tui' "
+            "OR delivery_mode IN ('notify+wake', 'wake')) LIMIT 1", (task_id,)).fetchone() is not None
     except sqlite3.OperationalError:
         return False
 
@@ -501,9 +508,16 @@ def has_chat_subscriber(conn: sqlite3.Connection, task_id: str) -> bool:
 def _check_chat(conn, task_id, awaiting, text) -> None:
     if not awaiting.get("why"):
         raise AwaitingError(INVALID_AWAITING, "awaiting kind='chat' needs why=<the question the orchestrator must answer>")
+    # Relabelling a park as a chat wait never excuses a wait on David or an agent wall: those stay refused
+    # (human_wait / agent_action_wait), as for a clock wait. Review of #3647: a David ask phrased as
+    # "awaiting the owning orchestrator's go-ahead" otherwise parked as a chat notice.
+    wall = text_wall(text)
+    if wall:
+        raise wall_error(task_id, wall, text)
     if not has_chat_subscriber(conn, task_id):
         raise AwaitingError(NO_CHAT_SUBSCRIBER, (
-            f"{task_id} has no chat subscribed to it, so no orchestrator would be told about this wait. "
+            f"{task_id} has no chat subscription that a decision_requested notice can wake (a tui row, or a "
+            "notify+wake row), so no orchestrator would be told about this wait. "
             "A decision only David can make is kanban_block kind='needs_input' with human_request; agent work is "
             "an owner card you create and park on (awaiting kind='card')."))
 
diff --git a/tests/hermes_cli/test_kanban_decision_ask.py b/tests/hermes_cli/test_kanban_decision_ask.py
index 25eb9e8087e850cf6455083e57dc66d63e64b520..db464de4af33a5eaf739051a47c78a12962f3dfd 100644
--- a/tests/hermes_cli/test_kanban_decision_ask.py
+++ b/tests/hermes_cli/test_kanban_decision_ask.py
@@ -162,3 +162,52 @@ def test_orchestrator_wait_matcher() -> None:
     assert kaw.orchestrator_wait("Parked pending the orchestrator's go-ahead on phase B.")
     assert not kaw.orchestrator_wait("Per the orchestrator's decision, waiting for CI run 40443505012.")
     assert not kaw.orchestrator_wait("Orchestrator decision recorded; waiting for the release build.")
+
+
+WHY_DAVID = "David's approval of the $400 GPU spend is pending"
+WHY_WALL = "needs the IAM permission grant on s3://prod-bucket"
+DAVID_REASON = "SCHEDULED_UNTIL=2099-01-01T00:00:00Z waiting for David's approval of the $400 GPU spend"
+
+
+@pytest.mark.parametrize("reason,awaiting,code", [
+    (DAVID_REASON, {"kind": "chat", "ref": "owning orchestrator", "why": WHY_DAVID}, kaw.HUMAN_WAIT),
+    (DAVID_REASON, {"kind": "external", "ref": "Owning orchestrator", "why": WHY_DAVID}, kaw.HUMAN_WAIT),
+    (DAVID_REASON + "; awaiting the owning orchestrator's go-ahead",
+     {"kind": "external", "ref": "AWS case 17722033541", "why": WHY_DAVID}, kaw.HUMAN_WAIT),
+    ("SCHEDULED_UNTIL=2099-01-01T00:00:00Z " + WHY_WALL, {"kind": "chat", "why": WHY_WALL}, kaw.AGENT_ACTION_WAIT),
+    ("SCHEDULED_UNTIL=2099-01-01T00:00:00Z " + WHY_WALL,
+     {"kind": "external", "ref": "Owning orchestrator", "why": WHY_WALL}, kaw.AGENT_ACTION_WAIT),
+])
+def test_chat_wait_never_launders_a_david_ask_or_an_agent_wall(kanban_home, monkeypatch, reason, awaiting,
+                                                                 code) -> None:
+    """Adversarial review of #3647: each row parked as a chat wait before the wall check in _check_chat."""
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+        _subscribe(conn, tid)
+        _as_worker(monkeypatch, conn, tid)
+        out = _tool("schedule", {"reason": reason, "clock_only": True, "awaiting": awaiting})
+        assert out.get("code") == code or code in out.get("error", ""), out
+        assert kb.get_task(conn, tid).status == "running" and not _asks(conn, tid)
+
+
+@pytest.mark.parametrize("platform,mode,parks", [
+    ("tui", None, True),
+    ("telegram", "notify+wake", True),
+    ("telegram", None, False),  # a passive ping, maybe to a person: no orchestrator is woken
+    ("hub", None, False),       # the hub relay carries only cards that turned terminal
+])
+def test_only_a_subscription_the_notice_can_wake_counts(kanban_home, monkeypatch, platform, mode, parks) -> None:
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+        kbn.add_notify_sub(conn, task_id=tid, platform=platform,
+                           chat_id="macbook/default/20261026_235722_bef6c6" if platform == "hub" else "chat-1",
+                           notifier_profile="default", delivery_mode=mode,
+                           delivery_metadata={"reason": "shepherd"})
+        _as_worker(monkeypatch, conn, tid)
+        out = _tool("schedule", {"reason": LIVE_REASON, "clock_only": True, "awaiting": LIVE_AWAITING})
+        if parks:
+            assert out.get("ok") is not False and "error" not in out, out
+            assert len(_asks(conn, tid)) == 1
+        else:
+            assert kaw.NO_CHAT_SUBSCRIBER in (out.get("code") or "") + out.get("error", ""), out
+            assert kb.get_task(conn, tid).status == "running"
-- 
2.43.0

