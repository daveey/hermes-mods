From 5dbfc07e8254d132ea602790a59b2dbb7e15c7eb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 14:08:41 -0700
Subject: [PATCH] [daveey] goals: continuation prompts say a status-only turn
 is not progress

---
 hermes_cli/goals.py            | 18 ++++++++++++++++--
 tests/hermes_cli/test_goals.py | 19 +++++++++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/goals.py b/hermes_cli/goals.py
index 087199c3b6..dd89ef650f 100644
--- a/hermes_cli/goals.py
+++ b/hermes_cli/goals.py
@@ -61,6 +61,9 @@ CONTINUATION_PROMPT_TEMPLATE = (
     "[Continuing toward your standing goal]\n"
     "Goal: {goal}\n\n"
     "Continue working toward this goal. Take the next concrete step. "
+    # [daveey] status-only turns count as no progress
+    "A turn that only restates status is not progress. Take the next "
+    "concrete action, or say exactly what blocks it. "
     "If you believe the goal is complete, state so explicitly and stop. "
     "If you are blocked and need input from the user, say so clearly and stop."
 )
@@ -73,6 +76,9 @@ CONTINUATION_PROMPT_WITH_CONTRACT_TEMPLATE = (
     "Completion contract:\n"
     "{contract_block}\n\n"
     "Continue working toward the outcome above. Take the next concrete step. "
+    # [daveey] status-only turns count as no progress
+    "A turn that only restates status is not progress. Take the next "
+    "concrete action, or say exactly what blocks it. "
     "Stay within the stated boundaries and do not violate the constraints. "
     "Before claiming the goal is done, satisfy the Verification criterion and "
     "show the concrete evidence (command output, file contents, test result). "
@@ -87,7 +93,11 @@ CONTINUATION_PROMPT_WITH_SUBGOALS_TEMPLATE = (
     "Additional criteria the user added mid-loop:\n"
     "{subgoals_block}\n\n"
     "Continue working toward the goal AND all additional criteria. Take "
-    "the next concrete step. If you believe the goal and every "
+    "the next concrete step. "
+    # [daveey] status-only turns count as no progress
+    "A turn that only restates status is not progress. Take the next "
+    "concrete action, or say exactly what blocks it. "
+    "If you believe the goal and every "
     "additional criterion are complete, state so explicitly and stop. "
     "If you are blocked and need input from the user, say so clearly "
     "and stop."
@@ -1611,7 +1621,11 @@ class GoalManager:
 KANBAN_GOAL_CONTINUATION_TEMPLATE = (
     "[Continuing toward this kanban task — judge says it is not done yet]\n"
     "Reason: {reason}\n\n"
-    "Take the next concrete step toward completing the task. When the work "
+    "Take the next concrete step toward completing the task. "
+    # [daveey] status-only turns count as no progress
+    "A turn that only restates status is not progress. Take the next "
+    "concrete action, or say exactly what blocks it. "
+    "When the work "
     "is genuinely finished, call kanban_complete with a summary. If it is a "
     "code change that needs same-card review before counting as done, call "
     "kanban_request_review with a summary instead. If you are blocked and "
diff --git a/tests/hermes_cli/test_goals.py b/tests/hermes_cli/test_goals.py
index 32113fbdcd..bcb5c569a2 100644
--- a/tests/hermes_cli/test_goals.py
+++ b/tests/hermes_cli/test_goals.py
@@ -138,6 +138,25 @@ class TestGoalManager:
         assert "port goal command to hermes" in prompt
         assert prompt.strip()  # non-empty
 
+    def test_continuation_prompts_reject_status_only_turns(self, hermes_home):
+        """[daveey] Every goal continuation says a status-only turn is not progress."""
+        from hermes_cli import goals
+
+        rule = (
+            "A turn that only restates status is not progress. Take the next "
+            "concrete action, or say exactly what blocks it."
+        )
+        for name in (
+            "CONTINUATION_PROMPT_TEMPLATE",
+            "CONTINUATION_PROMPT_WITH_CONTRACT_TEMPLATE",
+            "CONTINUATION_PROMPT_WITH_SUBGOALS_TEMPLATE",
+            "KANBAN_GOAL_CONTINUATION_TEMPLATE",
+        ):
+            assert rule in getattr(goals, name), name
+        mgr = goals.GoalManager(session_id="status-only-sid")
+        mgr.set("ship the thing")
+        assert rule in mgr.next_continuation_prompt()
+
 
 # ──────────────────────────────────────────────────────────────────────
 # Smoke: CommandDef is wired
-- 
2.54.0 (Apple Git-157)

