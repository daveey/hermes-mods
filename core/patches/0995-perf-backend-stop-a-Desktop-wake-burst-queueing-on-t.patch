From 24c3eda1034ba6447bfe6263e4f04de11a255362 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:46:59 +0000
Subject: [PATCH] perf(backend): stop a Desktop wake burst queueing on the
 config parse and the ledger rebuild [daveey]

A wake burst (/api/sessions/<id>, /api/session-kanban-tasks, kanban boards,
profiles sessions, /api/status at once) ran 6-9 s on a loaded Mac and tripped
the Desktop's 5 s timeouts. py-spy on a hub backend under the same burst:

- /api/status parsed the ~2500-line config.yaml on every call for the
  _config_version stamp (~40 ms of GIL-held YAML each, 101 samples/burst).
  read_config_version_stamp now caches the parse on the file signature;
  parse errors still re-read, warn and raise. -> 5 samples/burst.
- /api/session-kanban-tasks asks for stale_ok, but in links_reader=replica
  mode replica_cards -> _ledger_owners called _remote_links() without it, so
  the strip waited on _links_lock for every ledger rebuild (any board write).
  stale_ok now reaches _ledger_owners. -> 143 -> 21 samples/burst.

Tests: test_config_version_stamp_cache.py (new), two stale_ok tests in
test_kanban_chat_links.py; red on the old code, green now.
---
diff --git a/hermes_cli/kanban_chat_links.py b/hermes_cli/kanban_chat_links.py
index a16c7162e7650d4159e4abafc76aedc2d332f7db..b6996a8768b51b44e8959a08b378ec3a2295aa69 100644
--- a/hermes_cli/kanban_chat_links.py
+++ b/hermes_cli/kanban_chat_links.py
@@ -152,13 +152,14 @@ def _read_replica(path: Path, gateway: str, profile: str) -> tuple[list[dict[str
     return rows, pulled
 
 
-def _ledger_owners() -> dict[tuple[str, str], list[tuple[str, str, str, bool]]]:
+def _ledger_owners(stale_ok: bool = False) -> dict[tuple[str, str], list[tuple[str, str, str, bool]]]:
     """``(board, id) -> [(owner gateway, owner profile, session, released)]`` from the origin-ledger projection. A
     synced board is one file per gateway with one row per id, shared by that gateway's profiles, so the replica
-    row carries no owner profile: the ledger only labels it (``_owner_of``)."""
+    row carries no owner profile: the ledger only labels it (``_owner_of``). ``stale_ok`` is ``_remote_links``'s:
+    take the last projection instead of waiting on a rebuild."""
     from hermes_cli.kanban_session_activity import _remote_links
     try:
-        cards = _remote_links()
+        cards = _remote_links(stale_ok=True) if stale_ok else _remote_links()
     except Exception as exc:  # health: allow BLE001 -- the profile is a label; a failed ledger read must not hide cards
         _log.info("kanban chat links: owner profiles unavailable (%s: %s)", type(exc).__name__, exc)
         return {}
@@ -204,7 +205,8 @@ def _ledger_fallback(board: str, gateway: str, profile: str, statuses: tuple[str
 
 def replica_cards(session_ids: Optional[Iterable[str]], gateway: str, statuses: tuple[str, ...] = OPEN_STATUSES,
                   replicas: Optional[list[tuple[str, Path]]] = None, *, now: Optional[float] = None,
-                  ledger_fallback: bool = True, unreadable_out: Optional[list[str]] = None) -> list[dict[str, Any]]:
+                  ledger_fallback: bool = True, unreadable_out: Optional[list[str]] = None,
+                  stale_ok: bool = False) -> list[dict[str, Any]]:
     """This gateway's chats' (``session_ids``, one lineage; ``None`` = every chat) unreleased links to cards created
     on OTHER gateways, from every board's replica, shaped like the origin-ledger rows ``session_tasks`` appends.
 
@@ -216,7 +218,10 @@ def replica_cards(session_ids: Optional[Iterable[str]], gateway: str, statuses:
     - an unreadable replica keeps its last rows, stale; on a cold start the ledger's rows for that board, stale.
       ``ledger_fallback=False`` (links_diff) skips both, so a diff never compares the ledger with itself;
       ``unreadable_out`` collects the boards whose replica could not be read;
-    - one row per (chat, card); the key carries the owner profile the ledger names for it, else ``default``."""
+    - one row per (chat, card); the key carries the owner profile the ledger names for it, else ``default``;
+    - ``stale_ok`` (the Desktop linked-card strip): the owner labels come from the last ledger projection rather
+      than waiting behind a rebuild of it. [daveey] Without it the strip's ``stale_ok`` stopped at this call and
+      ``/api/session-kanban-tasks`` queued on ``_links_lock`` for every board write (3-7 s in a wake burst)."""
     from hermes_cli.profiles import get_active_profile_name
     ids = None if session_ids is None else set(str(s) for s in session_ids if s)
     if ids is not None and not ids:
@@ -251,7 +256,7 @@ def replica_cards(session_ids: Optional[Iterable[str]], gateway: str, statuses:
             rows, pulled = hit
             stale = True
         if owners is None and rows:
-            owners = _ledger_owners()
+            owners = _ledger_owners(stale_ok)
         for r in rows:
             if ids is not None and r["chat_session"] not in ids:
                 continue
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index b2502fc8c55fd5a17e1a9126c280387d4803f285..30f952243804a30592284afddb3a8c044eb17556 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -1738,7 +1738,7 @@ def _remote_cards(ids: list[str] | None, statuses: tuple[str, ...], stale_ok: bo
         except _ksc.SyncUnavailable:
             gateway = None
         if gateway:
-            return _links.replica_cards(ids, gateway, statuses)
+            return _links.replica_cards(ids, gateway, statuses, stale_ok=stale_ok)
     return _remote_links(stale_ok=True) if stale_ok else _remote_links()
 
 
diff --git a/tests/hermes_cli/test_config_version_stamp_cache.py b/tests/hermes_cli/test_config_version_stamp_cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..94049771d799881dede2835efb72cedbc21fee4d
--- /dev/null
+++ b/tests/hermes_cli/test_config_version_stamp_cache.py
@@ -0,0 +1,83 @@
+"""``read_config_version_stamp`` re-parses config.yaml only when the file changes.
+
+``/api/status`` reads the stamp on every Desktop poll. A full YAML parse of a ~2500-line config there
+held the GIL ~40 ms per call and stretched every request queued behind it in a wake burst. [daveey]
+"""
+
+import os
+
+import pytest
+
+from hermes_cli import config_version_stamp as cvs
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    getattr(cvs, "_stamp_cache", {}).clear()
+    yield home
+    getattr(cvs, "_stamp_cache", {}).clear()
+
+
+@pytest.fixture
+def parses(monkeypatch):
+    from hermes_cli import config
+
+    real = config.fast_safe_load
+    count = [0]
+
+    def counting(stream):
+        count[0] += 1
+        return real(stream)
+
+    monkeypatch.setattr(config, "fast_safe_load", counting)
+    return count
+
+
+def _write(home, text):
+    path = home / "config.yaml"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def test_an_unchanged_config_is_parsed_once(hermes_home, parses):
+    _write(hermes_home, "_config_version: 7\nmodel:\n  default: x\n")
+    assert cvs.check_config_version()[0] == 7
+    assert cvs.check_config_version()[0] == 7
+    assert cvs.read_config_version_stamp()[0] == 7
+    assert parses[0] == 1
+
+
+def test_a_rewrite_is_seen_on_the_next_read(hermes_home, parses):
+    path = _write(hermes_home, "_config_version: 7\n")
+    assert cvs.check_config_version()[0] == 7
+    path.write_text("_config_version: 9\n", encoding="utf-8")  # same size
+    st = path.stat()
+    os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns + 1_000_000))
+    assert cvs.check_config_version()[0] == 9
+    _write(hermes_home, "model: {}\n")  # stamp removed
+    assert cvs.read_config_version_stamp()[0] is None
+    assert parses[0] == 3
+
+
+def test_parse_errors_are_not_cached_and_still_raise_for_strict_callers(hermes_home, parses):
+    from hermes_cli.config import InvalidUserConfigError
+
+    _write(hermes_home, "_config_version: [unclosed\n")
+    _, latest = cvs.check_config_version()
+    assert cvs.check_config_version() == (latest, latest)  # tolerant: latest/latest, as before
+    with pytest.raises(InvalidUserConfigError):
+        cvs.check_config_version(raise_on_parse_error=True)
+    assert parses[0] >= 3  # every call re-read the broken file
+
+
+def test_a_non_mapping_root_stays_unusable_from_the_cache(hermes_home, parses):
+    from hermes_cli.config import InvalidUserConfigError
+
+    _write(hermes_home, "- a\n- b\n")
+    assert cvs.read_config_version_stamp()[0] is None
+    with pytest.raises(InvalidUserConfigError, match="must be a mapping, got list"):
+        cvs.check_config_version(raise_on_parse_error=True)
+    assert parses[0] == 1
diff --git a/tests/hermes_cli/test_kanban_chat_links.py b/tests/hermes_cli/test_kanban_chat_links.py
index ac8e33b43b845a1c57f7da88c47a65ce1d7e97bf..16333d1007e7754977c1b9fcbf39a560040ebea6 100644
--- a/tests/hermes_cli/test_kanban_chat_links.py
+++ b/tests/hermes_cli/test_kanban_chat_links.py
@@ -251,3 +251,49 @@ def test_unknown_replica_card_waits_like_a_parked_one(live, kanban_home, monkeyp
     assert ksa.active_task_counts() == {"s1": 2, "s2": 1}
     parked, held = ksa.parked_task_counts()
     assert parked == {"s1": 2} and held == {}
+
+
+def test_session_tasks_stale_ok_reaches_the_replica_owner_labels(live, kanban_home, monkeypatch, tmp_path):
+    """[daveey] The Desktop strip's ``stale_ok`` must reach ``_ledger_owners``: it used to stop at
+    ``replica_cards``, so ``/api/session-kanban-tasks`` waited on every ledger rebuild in replica mode."""
+    rep = tmp_path / "default.db"
+    _replica(rep, [("t_remote", "from replica", "running", OTHER)], [("t_remote", ME, "s1", "shepherd", 0)])
+    _switch_to_replica(kanban_home, monkeypatch, rep)
+    calls = []
+
+    def remote_links(stale_ok=False):
+        calls.append(stale_ok)
+        return [_ledger_row("t_remote", "s1")]
+
+    monkeypatch.setattr(ksa, "_remote_links", remote_links)
+    assert [t["id"] for t in ksa.session_tasks(["s1"], stale_ok=True)] == ["t_remote"]
+    assert calls == [True]
+    calls.clear()
+    assert [t["id"] for t in ksa.session_tasks(["s1"])] == ["t_remote"]
+    assert calls == [False]  # every other reader keeps read-your-writes
+
+
+def test_session_tasks_stale_ok_does_not_wait_behind_a_ledger_rebuild(live, kanban_home, monkeypatch, tmp_path):
+    """A rebuild holding ``_links_lock`` (a board write moved the fingerprint) must not hold the strip."""
+    import threading
+    rep = tmp_path / "default.db"
+    _replica(rep, [("t_remote", "from replica", "running", OTHER)], [("t_remote", ME, "s1", "shepherd", 0)])
+    _switch_to_replica(kanban_home, monkeypatch, rep)
+    monkeypatch.setattr(ksa, "_remote_links", _real_remote_links)  # the real cache + lock, not the stub
+    monkeypatch.setattr(ksa, "_project_remote_links", lambda: [_ledger_row("t_remote", "s1")])
+    fp = ["v1"]
+    monkeypatch.setattr(ksa, "_links_fingerprint", lambda: (fp[0],))
+    assert [t["id"] for t in ksa.session_tasks(["s1"], stale_ok=True)] == ["t_remote"]  # primes the projection
+    fp[0] = "v2"  # a board write: the projection is stale and a rebuild is due
+    out: list = []
+    with ksa._links_lock:  # a rebuild in flight
+        th = threading.Thread(target=lambda: out.append(ksa.session_tasks(["s1"], stale_ok=True)), daemon=True)
+        th.start()
+        th.join(timeout=3)
+        finished = not th.is_alive()
+    th.join(timeout=5)
+    assert finished, "stale_ok session_tasks waited on _links_lock"
+    assert [t["id"] for t in out[0]] == ["t_remote"]
+
+
+_real_remote_links = ksa._remote_links
-- 
