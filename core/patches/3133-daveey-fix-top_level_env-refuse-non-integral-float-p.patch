From 4995d21de7c7289566aabe40abd0bd0e3dfb2801 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 04:17:31 +0000
Subject: [PATCH] [daveey] fix(top_level_env): refuse non-integral float pids;
 skip pid test under init parent

PR #1836 review nits (t_01a1d2da9cda8b5a):

1. descends_from_live_pid said anything int() refuses is False, but int()
   silently truncated a float: descends_from_live_pid(getpid() + 0.5) vouched
   for this process, and float('inf') raised OverflowError despite the
   "never raises" contract. A non-integral float spells no pid, and truncation
   names one the caller never gave, so refuse it (False) rather than only
   rewording the docstring. Integral floats (4242.0, e.g. from a JSON writer)
   stay accepted like decimal strings. Docstring now says "an integral number
   or its decimal string"; pinned by
   test_descends_from_live_pid_refuses_non_integral_floats_rather_than_truncating.
2. test_descends_from_live_pid_accepts_a_pid_or_its_decimal_string assumed
   os.getppid() > 1; skip it when the test process's parent is init (pid-1
   container child / pid-namespace init) so it is host-independent.
---
 hermes_cli/top_level_env.py                | 18 +++++++++++-------
 tests/hermes_cli/test_leaked_worker_env.py | 16 +++++++++++++---
 2 files changed, 24 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/top_level_env.py b/hermes_cli/top_level_env.py
index 072353e0be..6f9af24f24 100644
--- a/hermes_cli/top_level_env.py
+++ b/hermes_cli/top_level_env.py
@@ -277,15 +277,19 @@ def descends_from_live_pid(pid) -> bool:
     """Whether this process descends from ``pid`` while it is alive. pid 0/1 never count: every process
     descends from init, so it vouches for nothing. [daveey]
 
-    ``pid`` is coerced with ``int()``: a decimal string (``"4242"``) is accepted as that pid, and ``None``,
-    ``""`` or anything ``int()`` refuses is ``False`` rather than a ``TypeError``. This is deliberate: callers
-    pass pids read from board rows and JSON event payloads (``worker_bound``, ``tasks.worker_pid``), whose
-    type depends on the writer, and the proof is the live-ancestor check on that exact pid, so accepting
-    its string spelling vouches for nothing extra. Rejecting it would refuse a real worker's shell (or call
-    it a leaked env) over serialization alone."""
+    ``pid`` must be an integral number or its decimal string: ``4242``, ``"4242"`` and ``4242.0`` are accepted
+    as that pid, and ``None``, ``""``, a non-integral float (``4242.7``, ``inf``, ``nan``) or anything ``int()``
+    refuses is ``False`` rather than an exception. This is deliberate: callers pass pids read from board rows
+    and JSON event payloads (``worker_bound``, ``tasks.worker_pid``), whose type depends on the writer, and the
+    proof is the live-ancestor check on that exact pid, so accepting its string or float spelling vouches for
+    nothing extra. Rejecting those would refuse a real worker's shell (or call it a leaked env) over
+    serialization alone. A non-integral float spells no pid at all, and ``int()`` would truncate it to a
+    different one the caller never named, so it is refused instead."""
+    if isinstance(pid, float) and not pid.is_integer():
+        return False
     try:
         pid = int(pid or 0)
-    except (TypeError, ValueError):
+    except (TypeError, ValueError, OverflowError):
         return False
     return pid > 1 and _pid_alive(pid) and _is_ancestor(pid)
 
diff --git a/tests/hermes_cli/test_leaked_worker_env.py b/tests/hermes_cli/test_leaked_worker_env.py
index 8775df1612..c98ba45559 100644
--- a/tests/hermes_cli/test_leaked_worker_env.py
+++ b/tests/hermes_cli/test_leaked_worker_env.py
@@ -443,11 +443,14 @@ def test_finished_worker_shell_cli_refusal_points_at_kanban_comment(monkeypatch,
 
 
 # descends_from_live_pid coerces with int(): pids come from board rows and JSON event payloads whose type depends
-# on the writer, so a decimal string names the same pid (the live-ancestor check is the proof), and an unparseable
-# value is False, never a TypeError.
+# on the writer, so a decimal string or an integral float names the same pid (the live-ancestor check is the proof),
+# and an unparseable value is False, never a TypeError. A non-integral float names no pid: int() would truncate it
+# to a different one, so it is refused like any other non-pid.
 
-@pytest.mark.parametrize("spell", [int, str], ids=["int", "str"])
+@pytest.mark.parametrize("spell", [int, str, float], ids=["int", "str", "integral_float"])
 def test_descends_from_live_pid_accepts_a_pid_or_its_decimal_string(spell):
+    if os.getppid() <= 1:  # a pid-1 container child (or a pid-namespace init): its parent is init, which never counts
+        pytest.skip("test process's parent is init; no live non-init ancestor to check")
     assert tle.descends_from_live_pid(spell(os.getpid())) is True
     assert tle.descends_from_live_pid(spell(os.getppid())) is True
     assert tle._descends_from_live_agent({}, spell(os.getppid())) is True
@@ -457,3 +460,10 @@ def test_descends_from_live_pid_accepts_a_pid_or_its_decimal_string(spell):
                          ids=["none", "empty", "word", "decimal", "zero", "init", "init_str", "bool", "object"])
 def test_descends_from_live_pid_refuses_init_and_non_numbers_without_raising(pid):
     assert tle.descends_from_live_pid(pid) is False
+
+
+@pytest.mark.parametrize("offset", [0.5, 0.999, float("inf"), float("-inf"), float("nan")],
+                         ids=["half", "almost_next", "inf", "neg_inf", "nan"])
+def test_descends_from_live_pid_refuses_non_integral_floats_rather_than_truncating(offset):
+    # int(getpid() + 0.5) is this process's own pid: truncating would vouch for a pid the caller never named.
+    assert tle.descends_from_live_pid(os.getpid() + offset) is False
-- 
2.51.0

