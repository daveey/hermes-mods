From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 01:45:41 +0000
Subject: [PATCH 6678] File-descriptor headroom guard and incident reporting

Public mirror of source commit 99c125db5f8441b7855ae4fcbe82f0d58068f2ab.

---
diff --git a/hermes_cli/resource_limits.py b/hermes_cli/resource_limits.py
index c417a1df03b0958b1510280c41be504c710b36fe..1a2e9e88d9eaa36b59a7fe9ef66239c75d29e3a0 100644
--- a/hermes_cli/resource_limits.py
+++ b/hermes_cli/resource_limits.py
@@ -227,7 +227,9 @@
                         'failure_since': incident.get('failure_since', time.time())}
     from hermes_cli.fd_headroom_incident import failure_note
     note = failure_note(incident)
-    _fd_status.update(sample, incident=incident, card_error=note)
+    _fd_status.update(sample, sampled_at=time.time(), ratio=count / soft, incident=incident,
+                      last_card_id=incident.get('task_id'), create_error=incident.get('error'),
+                      failure_since=incident.get('failure_since'), card_error=note)
     log = logger.warning if warn or note else logger.info
     log('fd-headroom: host=%s pid=%s role=%s count=%s soft=%s hard=%s census=%s slope=%.6f fd/s core=%s %s',
         sample['host'], sample['pid'], role, count, soft, hard, census, slope, sample['core'], note)
diff --git a/tests/hermes_cli/test_fd_headroom.py b/tests/hermes_cli/test_fd_headroom.py
index 6bd63517c4b7f92bb6e9b92581c1adb84cad9ddd..9da5ed920f8cc945824938f7111f7b8f476d710d 100644
--- a/tests/hermes_cli/test_fd_headroom.py
+++ b/tests/hermes_cli/test_fd_headroom.py
@@ -28,6 +28,21 @@
                                     role='gateway', now=now, **kwargs)
 
 
+def test_below_both_updates_status_without_warning_card_or_limit_change(guard, caplog):
+    resource, snapshot, notify = guard
+    snapshot.return_value = (100, {})
+    with caplog.at_level(logging.WARNING):
+        check(0)
+        check(300)
+    assert 'fd-headroom:' not in caplog.text
+    notify.assert_not_called()
+    resource.setrlimit.assert_not_called()
+    state = limits.fd_headroom_status()
+    assert state['sampled_at'] > 0
+    assert (state['count'], state['soft'], state['hard'], state['ratio']) == (100, 1000, 10000, 0.1)
+    assert state['last_card_id'] is None and state['create_error'] is None
+
+
 def test_ratio_trigger(guard, caplog):
     resource, _, notify = guard
     with caplog.at_level(logging.INFO):
