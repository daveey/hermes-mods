From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:46:39 +0000
Subject: [PATCH] test(kanban): retain eligible drain release and independent
 review controls [daveey]

---
 tests/agent/test_core_update_drain.py                    | 4 ++++
 tests/gateway/test_kanban_external_drain_hold.py         | 2 ++
 tests/hermes_cli/test_kanban_dispatch_core_drain_hold.py | 9 +++++++--
 tests/hermes_cli/test_kanban_gateway_drain.py            | 2 ++
 4 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/tests/agent/test_core_update_drain.py b/tests/agent/test_core_update_drain.py
index b0b6a4d916..5667ecca83 100644
--- a/tests/agent/test_core_update_drain.py
+++ b/tests/agent/test_core_update_drain.py
@@ -123,6 +123,8 @@ def _dispatcher_board(tmp_path, monkeypatch):
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
     monkeypatch.setattr("hermes_cli.profiles.list_profiles", lambda **kw: [SimpleNamespace(name="default")])
@@ -248,6 +250,8 @@ def test_hold_requeues_a_dead_worker_and_does_not_claim_until_the_hold_lifts(tmp
 
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.setattr(drain, "_hermes_home", lambda: tmp_path)
     monkeypatch.setattr(drain, "_canonical_root", lambda: tmp_path)
diff --git a/tests/gateway/test_kanban_external_drain_hold.py b/tests/gateway/test_kanban_external_drain_hold.py
index 3dc56c8ae3..d80c5972b6 100644
--- a/tests/gateway/test_kanban_external_drain_hold.py
+++ b/tests/gateway/test_kanban_external_drain_hold.py
@@ -29,6 +29,8 @@ def home(tmp_path, monkeypatch):
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
     return tmp_path
diff --git a/tests/hermes_cli/test_kanban_dispatch_core_drain_hold.py b/tests/hermes_cli/test_kanban_dispatch_core_drain_hold.py
index 9688e5f4a8..b58e5b72c1 100644
--- a/tests/hermes_cli/test_kanban_dispatch_core_drain_hold.py
+++ b/tests/hermes_cli/test_kanban_dispatch_core_drain_hold.py
@@ -44,6 +44,8 @@ def board(tmp_path, monkeypatch):
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
     monkeypatch.setattr(drain, "_hermes_home", lambda: tmp_path)
@@ -64,8 +66,8 @@ def _make_card(monkeypatch, lane: str) -> str:
     with kbc.connect_closing(board="default") as conn:
         tid = kb.create_task(conn, title=f"{lane} card", assignee="default")
         if lane == "review":
-            assert kb.claim_task(conn, tid) is not None
-            assert kb.request_review(conn, tid, summary="ready for review") is True
+            from tests.hermes_cli.test_kanban_model_tier import _review_source
+            _review_source(conn, tid)
         task = kb.get_task(conn, tid)
         assert task.status == lane and task.claim_lock is None
     return tid
@@ -115,6 +117,7 @@ def _dispatch(entry: str, monkeypatch, capsys) -> dict:
 @pytest.mark.parametrize("entry", ["cli", "dashboard"])
 def test_live_hold_refuses_claim(board, monkeypatch, capsys, entry, lane):
     tid = _make_card(monkeypatch, lane)
+    board.spawned.clear()  # exclude the authenticated implementation run
     _write_hold(board.home, os.getpid())
     out = _dispatch(entry, monkeypatch, capsys)
     assert board.spawned == []
@@ -130,6 +133,7 @@ def test_live_hold_refuses_claim(board, monkeypatch, capsys, entry, lane):
 @pytest.mark.parametrize("entry", ["cli", "dashboard"])
 def test_dead_writer_hold_does_not_block(board, monkeypatch, capsys, entry, lane):
     tid = _make_card(monkeypatch, lane)
+    board.spawned.clear()  # exclude the authenticated implementation run
     _write_hold(board.home, _dead_pid())
     out = _dispatch(entry, monkeypatch, capsys)
     assert board.spawned == [tid]
@@ -172,6 +176,7 @@ def test_hold_that_starts_mid_tick_still_refuses_the_claim(board, monkeypatch, c
     from hermes_cli import kanban_gateway_drain as kgd
 
     tid = _make_card(monkeypatch, lane)
+    board.spawned.clear()  # exclude the authenticated implementation run
     calls = []
     real = kgd.core_update_hold
 
