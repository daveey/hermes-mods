+    try:
+        plan(journal)
+        journal.deliver(REPO, ProducerBoard())
+        assert journal.deliver(REPO, object())[0].startswith('FAILED')
+        assert journal.db.execute('SELECT delivered FROM occurrences').fetchone()[0] == 0
+    finally:
+        journal.close()
