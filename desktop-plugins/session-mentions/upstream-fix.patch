+
+describe('classify — @session rows', () => {
+  it('splits the kind off a session link and keeps the row title', async () => {
+    const { classify } = await import('./use-at-completions')
+    const { hermesDirectiveFormatter } = await import('@/components/assistant-ui/directive-text')
+
+    const c = classify({ text: '@session:default/20261008_152759_c64624', display: 'Example session title' } as never)
+
+    expect(c).toMatchObject({ type: 'session', insertId: 'default/20261008_152759_c64624', display: 'Example session title' })
+
+    const serialized = hermesDirectiveFormatter.serialize({
+      id: 'x',
+      type: c.type,
+      label: c.display,
+      metadata: { rawText: '@session:default/20261008_152759_c64624', insertId: c.insertId }
+    } as never)
+
+    expect(serialized).toBe('@session:default/20261008_152759_c64624')
+  })
+})
