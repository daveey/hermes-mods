#!/usr/bin/env python3
"""Run every hermes-mods Python test suite, each in its own process, and summarize.

A bare repo-wide `pytest` cannot work here: ~50 plugin dirs reuse test-module basenames
(`test_load.py`...), some suites need a core checkout, and a test that imports core's
`hermes_bootstrap` can re-exec the interpreter and kill pytest mid-collection with exit 1
and no output. So this runner:

* gives each suite its own process and its own rootdir (no basename collisions),
* sets HERMES_DISABLE_LAZY_INSTALLS=1 (stops that re-exec) and PYTHONPATH to core, and names
  that core in HERMES_CORE_CHECKOUT and HERMES_CORE_SOURCE (core-backed plugin tests skip without it),
* never lets a failure be silent: every non-zero suite is listed with its exit code and
  the last lines of output, and a death without a pytest summary is labelled SILENT-EXIT,
* exits 0 only if every suite passed (or was skipped for a stated reason).

Usage:
  scripts/test-all                      all suites, 4 at a time
  scripts/test-all -k hub-sync          only suites whose name contains the substring (plus repo-guards)
  scripts/test-all --exact -k plugins/coach -k tools/tailnet --json out.json
                                        exactly those suites (CI: .github/workflows/plugin-suites.yml);
                                        --json writes each suite's status and passed/failed/errors/skipped
  scripts/test-all -j 8 --timeout 900
  scripts/test-all --list
  scripts/test-all --hermes-core PATH   override the core checkout (default $HERMES_CORE_CHECKOUT,
                                        then ~/.hermes/hermes-agent); F3 runs whenever core is found

Python: $HERMES_MODS_PYTHON, else <core>/.venv/bin/python, else production
(macOS signed Python 3.14 / Linux gateway launcher), else the current interpreter (warned; refused with
exit 2 when it is below the Python that core gates its runtime dependencies on, today 3.14).
The driver itself needs Python >= 3.11 (tomllib): started by an older python3 (macOS /usr/bin/python3
is 3.9), it re-runs itself under the first newer one of those it finds.
Test tools go in ~/.cache/hermes-mods-test-site/python-X.Y/site-packages (outside the Hermes home). For an
interpreter outside core's own venv (the macOS production one) that site also gets core's runtime dependencies,
resolved with core's [tool.uv] overrides, so suites import core there as they do under the hub's core venv.
Suites are discovered from the tree (plugins/*, tools/*, tests/, and one per skill dir holding
SKILL.md under skills/ with test_*.py, e.g. `-k hermes-coach`); SUITE_OVERRIDES below holds the few that need a
different command or are skipped with a reason.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
from importlib.metadata import distributions
import json
import os
import shlex
import re
import shutil
import subprocess
import sys
import time

if sys.version_info < (3, 11):
    # The driver needs tomllib (3.11+), but `#!/usr/bin/env python3` is macOS's 3.9 wherever /usr/bin
    # comes first on PATH. Re-run under a newer interpreter instead of dying on the import below.
    # Suites still use select_python(); HERMES_TEST_ALL_REEXEC stops a second hop.
    if os.environ.get("HERMES_TEST_ALL_REEXEC") != "1":
        _home = os.path.expanduser("~")
        for _cand in (os.environ.get("HERMES_MODS_PYTHON"),
                      os.path.join(_home, "Applications/Hermes Python.app/Contents/MacOS/python3.14"),
                      os.path.join(_home, ".hermes/hermes-agent/.venv/bin/python"),
                      os.path.join(_home, ".hermes/hermes-agent/venv/bin/python"),
                      *(f"python3.{minor}" for minor in range(14, 10, -1))):
            _path = _cand and (shutil.which(_cand) or _cand)
            if not (_path and os.path.isfile(_path) and os.access(_path, os.X_OK)):
                continue
            try:
                _ok = subprocess.run([_path, "-c", "import tomllib"], capture_output=True,
                                     timeout=30).returncode == 0
            except (OSError, subprocess.SubprocessError):
                _ok = False
            if _ok:
                os.environ["HERMES_TEST_ALL_REEXEC"] = "1"
                os.execv(_path, [_path, os.path.abspath(__file__), *sys.argv[1:]])
    sys.stderr.write(f"test-all: needs Python >= 3.11 (tomllib); {sys.executable} is "
                     f"{sys.version.split()[0]} and no newer interpreter was found. "
                     "Set HERMES_MODS_PYTHON to one.\n")
    sys.exit(2)
os.environ.pop("HERMES_TEST_ALL_REEXEC", None)

import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# name -> {"skip": reason} | {"cmd": [argv...] (relative to the suite dir; {py} = interpreter)}
# Repo-wide guards (a pattern banned in every plugin): their own suite, added to every -k run, so a
# plugin-scoped run (what a worker runs before pushing) still trips them.
GUARD_SUITE = "repo-guards"
GUARD_TESTS = ("test_sqlite_ro_guard.py", "test_card_id_regex_guard.py", "test_plugin_suites_ci.py")

SUITE_OVERRIDES: dict[str, dict] = {
    # Required real-core coverage must be visible even when the suite succeeds.
    "plugins/session-outcome": {"args": ["-vv", "-rs"], "show_output": True},
    # Its tests run against a disposable snapshot of core's HEAD (its README), not in place, and
    # need a pytest site dir outside the Hermes home (TEST_SITE, made once by ensure_test_site()).
    "plugins/fast-rate-limit-fallback": {
        "cmd": ["sh", "-ec",
                '{py} -I run_tests.py --repo "{core}" --test-site-packages "{site}" '
                '&& {py} -m unittest discover -s harness_tests'],
        "cwd": "plugins/fast-rate-limit-fallback",
        # Every test runs inside a snapshot of core: without one, run_tests.py dies on `--repo ""`.
        "needs_core": True,
    },
    # unittest suite (its README); pytest mistakes the plugin's package __init__ for a test module.
    "plugins/mcp-file-access": {
        "cmd": ["{py}", "-m", "unittest", "discover", "-s", "tests"],
        "cwd": "plugins/mcp-file-access",
    },
    # CI runs it standalone (.github/workflows/runners.yml): core's own `plugins` package would
    # shadow plugins/ on the path, and it needs jsonschema + yaml, which core's venv lacks.
    "plugins/runners": {
        "cmd": ["uv", "run", "--no-project", "--python", "3.14", "--with", "pytest",
                "--with", "jsonschema[format-nongpl]", "--with", "pyyaml", "--with", "fastapi",
                "--with", "httpx", "python", "-m", "pytest", "-q", "-p", "no:cacheprovider",
                "plugins/runners/tests"],
        "no_core_path": True,
    },
}

# pyyaml etc. that core's venv lacks but several suites import. Appended LAST on PYTHONPATH, so it
# follows repo/core imports. Isolated override environments opt out via no_core_path.
# Env that marks "this process is an agent worker": a test that builds its own temp Kanban board
# or hermes home must not inherit it (core fences Kanban writes of delegated children).
SCRUB_ENV_PREFIXES = ("HERMES_KANBAN", "HERMES_DELEGATED", "HERMES_SUPERVISED", "HERMES_ORIGIN")
TEST_SITE = Path.home() / ".cache" / "hermes-mods-test-site"  # must be outside the Hermes home
# Fallback only when selected core has no exact SDK pin. New major SDKs
# change the HTTP transport and cannot be substituted into real-wire tests.
ANTHROPIC_VERSION = "0.125.0"


def anthropic_version(core: Path | None) -> str:
    """Prefer the resolved lock version, then core's exact optional-extra pin."""
    def read_toml(name: str) -> dict:
        if core is None:
            return {}
        try:
            return tomllib.loads((core / name).read_text())
        except (OSError, ValueError):
            return {}

    versions = {p['version'] for p in read_toml('uv.lock').get('package', [])
                if p.get('name') == 'anthropic' and isinstance(p.get('version'), str)}
    if len(versions) == 1:
        return versions.pop()
    extras = read_toml('pyproject.toml').get('project', {}).get('optional-dependencies', {})
    for requirement in extras.get('anthropic', []):
        match = re.fullmatch(r'anthropic\s*==\s*([0-9][A-Za-z0-9.!+_-]*)', requirement.strip(), re.I)
        if match:
            return match[1]
    print(f"test-all: WARNING: no exact anthropic pin in core={core}; "
          f"using fallback anthropic=={ANTHROPIC_VERSION}", file=sys.stderr, flush=True)
    return ANTHROPIC_VERSION


def python_version(py: str) -> str:
    return subprocess.check_output(
        [py, "-c", "import platform; print(platform.python_version())"], text=True).strip()


def test_site(py: str) -> Path:
    # Never reuse extension modules built for a different Python minor version. The leaf is a real
    # `site-packages` component: coach's transport tests forward only such sys.path entries to the child
    # processes they spawn, and on the macOS production interpreter this site holds core's dependencies.
    return TEST_SITE / ("python-" + ".".join(python_version(py).split(".")[:2])) / "site-packages"


def find_uv() -> str | None:
    return shutil.which('uv') or (str(Path.home() / '.local/bin/uv')
                                 if (Path.home() / '.local/bin/uv').is_file() else None)


CORE_DEPS_STAMP = ".core-deps"
CORE_OVERRIDES = ".core-overrides.txt"


def core_runtime_deps(py: str, core: Path | None) -> tuple[list[str], list[str]]:
    """Core's declared runtime deps and its uv overrides, unless `py` lives inside core (core's own venv).

    Core's venv already has them. Any other interpreter (the macOS production one, a Linux tools python, an
    override) has only this site: core's installed env lives under the Hermes home, which coach's home guard
    forbids tests to open. Without them suites fail at collection there (dotenv, requests, cryptography) while
    passing on the hub's core venv. The overrides are core's [tool.uv] override-dependencies: its exact pins
    only resolve with them (browser-harness pins pillow==12.3.0, core overrides it to 13.0.0). Paths are
    compared unresolved: a venv's python symlinks to the very interpreter that lacks the venv's packages.
    """
    if core is None or os.path.abspath(py).startswith(os.path.abspath(core) + os.sep):
        return [], []
    try:
        project = tomllib.loads((core / "pyproject.toml").read_text())
    except (OSError, ValueError):
        return [], []

    def strings(items: object) -> list[str]:
        return [s.strip() for s in items if isinstance(s, str) and s.strip()] if isinstance(items, list) else []

    deps = strings(project.get("project", {}).get("dependencies"))
    overrides = strings(project.get("tool", {}).get("uv", {}).get("override-dependencies")) if deps else []
    return deps, [_inherit_markers(o, deps) for o in overrides]


def core_python_floor(core: Path | None) -> tuple[int, int] | None:
    """The lowest Python that core installs its runtime dependencies for, or None if core sets no floor.

    Core's requires-python admits 3.11 only so old installs can finish their updater step; every runtime dep
    carries `python_version >= '3.14'`, so a site built for an older interpreter holds none of them and every
    suite that imports core dies with `No module named 'dotenv'`. The floor is the highest such bound: below
    it at least one declared dependency is missing.
    """
    if core is None:
        return None
    try:
        deps = tomllib.loads((core / "pyproject.toml").read_text()).get("project", {}).get("dependencies")
    except (OSError, ValueError):
        return None
    bounds = [(int(m[1]), int(m[2])) for dep in (deps if isinstance(deps, list) else []) if isinstance(dep, str)
              for m in re.finditer(r"python_version\s*>=\s*['\"](\d+)\.(\d+)['\"]", dep)]
    return max(bounds) if bounds else None


def _req_name(requirement: str) -> str:
    match = re.match(r"\s*([A-Za-z0-9][A-Za-z0-9._-]*)", requirement)
    return re.sub(r"[-_.]+", "-", match.group(1)).lower() if match else ""


def _inherit_markers(override: str, deps: list[str]) -> str:
    """A uv override replaces the whole requirement, marker included: core's unconditional
    `Pillow==13.0.0` override turned its `Pillow==13.0.0; python_version >= '3.14'` dep into an
    unconditional one, so no site could be built for Python 3.9-3.10 (Pillow 13 needs 3.11). The
    override keeps the markers of the deps it replaces (any unmarked dep: nothing to inherit)."""
    name = _req_name(override)
    markers = [d.split(";", 1)[1].strip() if ";" in d else "" for d in deps if _req_name(d) == name]
    if not markers or "" in markers:
        return override
    inherited = " or ".join(f"({m})" for m in markers)
    if ";" in override:
        spec, own = override.split(";", 1)
        return f"{spec.strip()}; ({own.strip()}) and ({inherited})"
    return f"{override}; {inherited}"


def ensure_test_site(py: str, core: Path | None = None, uv: str | None = '') -> Path:
    version = anthropic_version(core)
    site = test_site(py)
    sdk_versions = {d.version for d in distributions(path=[str(site)])
                    if d.metadata['Name'].lower() == 'anthropic'}
    # ruamel: core's hermes_yaml imports it. xdist: coach tests run a nested `pytest -n 2`. cryptography, pillow:
    # remote-screen's runtime deps (rfb.py's RFB auth, Frame.to_image); without core (plugin-suites CI) nothing else
    # brings them and the suite didn't even collect. jsonschema: coach's provenance tests import the
    # real runners brief generator, whose models module imports the schema validator.
    core_deps, core_overrides = core_runtime_deps(py, core)
    wanted = "\n".join(["[dependencies]", *core_deps, "[overrides]", *core_overrides, ""]) if core_deps else None
    stamp = site / CORE_DEPS_STAMP
    try:
        stamped = stamp.read_text()
    except OSError:
        stamped = None
    if sdk_versions != {version} or (wanted is not None and stamped != wanted) or not all(
            (site / name).is_dir() for name in (
                "pytest", "pytest_asyncio", "xdist", "yaml", "ruamel", "fastapi", "httpx", "psutil", "cryptography",
                "PIL", "jsonschema", "anthropic")):
        if uv == '':
            uv = find_uv()
        if not uv:
            raise RuntimeError("test-all: uv is required to build the selected Python's test dependencies")
        cmd = [uv, "pip", "install", "-q", "--python", py, "--target", str(site),
               "pytest", "pytest-asyncio", "pytest-xdist", "pyyaml", "ruamel.yaml", "fastapi", "httpx", "psutil",
               "cryptography", "pillow", "jsonschema", f"anthropic=={version}", *core_deps]
        if core_overrides:
            site.mkdir(parents=True, exist_ok=True)
            (site / CORE_OVERRIDES).write_text("".join(f"{line}\n" for line in core_overrides))
            cmd += ["--override", str(site / CORE_OVERRIDES)]
        subprocess.run(cmd, check=True)
        if wanted is not None:
            site.mkdir(parents=True, exist_ok=True)
            stamp.write_text(wanted)
    return site


SUMMARY_RE = re.compile(r"\b\d+ (passed|failed|error|errors|skipped|deselected|xfailed)\b|no tests ran|^Ran \d+ tests?")
# pytest's final line ("3 failed, 10 passed, 2 skipped in 1.20s", optionally framed by ===) and unittest's
# "Ran N tests in 0.1s" ... "OK (skipped=2)" / "FAILED (failures=1, errors=2)" pair. An item may be two words
# ("9 subtests passed", pytest's subtests plugin); counts() reads only the one-word test items from it.
PYTEST_FINAL_RE = re.compile(r"^=*\s*((?:\d+ [a-z]+(?: [a-z]+)?(?:, )?)+|no tests ran) in [\d.]+s\b.*$")
UNITTEST_RAN_RE = re.compile(r"^Ran (\d+) tests? in [\d.]+s$")
UNITTEST_RESULT_RE = re.compile(r"^(OK|FAILED)(?: \((.*)\))?$")


def counts(out: str) -> dict:
    """passed/failed/errors/skipped from a suite's output (all 0 when no summary was printed).

    The LAST pytest final line counts (a failing test's captured output may hold a nested run's summary
    earlier on). A unittest block counts too when it comes after that line, so a suite that runs pytest and
    then unittest (fast-rate-limit-fallback) reports both."""
    c = {"passed": 0, "failed": 0, "errors": 0, "skipped": 0}
    lines = [ln.strip() for ln in out.splitlines()]
    py_at = next((i for i in range(len(lines) - 1, -1, -1) if PYTEST_FINAL_RE.match(lines[i])), None)
    if py_at is not None:
        for n, word in re.findall(r"(\d+) ([a-z]+)", PYTEST_FINAL_RE.match(lines[py_at]).group(1)):
            key = {"passed": "passed", "failed": "failed", "error": "errors", "errors": "errors",
                   "skipped": "skipped"}.get(word)
            if key:
                c[key] += int(n)
    ran_at = next((i for i in range(len(lines) - 1, -1, -1) if UNITTEST_RAN_RE.match(lines[i])), None)
    if ran_at is not None and (py_at is None or ran_at > py_at):
        total = int(UNITTEST_RAN_RE.match(lines[ran_at]).group(1))
        res = next((UNITTEST_RESULT_RE.match(ln) for ln in lines[ran_at + 1:] if UNITTEST_RESULT_RE.match(ln)), None)
        detail = dict((k, int(v)) for k, v in re.findall(r"(\w+)=(\d+)", (res.group(2) or "") if res else ""))
        failed, errors, skipped = detail.get("failures", 0), detail.get("errors", 0), detail.get("skipped", 0)
        c["failed"] += failed
        c["errors"] += errors
        c["skipped"] += skipped
        c["passed"] += max(0, total - failed - errors - skipped - detail.get("expected_failures", 0))
    return c


def find_core(arg: str | None) -> tuple[Path | None, bool]:
    """(core checkout, whether it was named explicitly rather than found at the default path)."""
    for i, cand in enumerate((arg, os.environ.get("HERMES_CORE_CHECKOUT"), str(Path.home() / ".hermes" / "hermes-agent"))):
        if cand and (Path(cand) / "hermes_bootstrap.py").is_file():
            return Path(cand).resolve(), i < 2
    return None, False


def production_python(core: Path | None) -> str | None:
    if sys.platform == "darwin":
        candidate = Path.home() / "Applications/Hermes Python.app/Contents/MacOS/python3.14"
        return str(candidate) if candidate.is_file() else None
    if sys.platform.startswith("linux") and core:
        launcher = core / ".hermes/bin/hermes"
        if launcher.is_file():
            try:
                # Use the gateway's published resolution boundary, not a guessed venv/cache path.
                command = json.loads(subprocess.check_output(
                    [str(launcher), "--print-runtime-command"], text=True, timeout=30))
                if isinstance(command, list) and command and isinstance(command[0], str):
                    if Path(command[0]).is_file():
                        return command[0]
            except (OSError, ValueError, subprocess.SubprocessError):
                pass  # The visibly labelled current-interpreter fallback below remains usable.
    return None


def select_python(core: Path | None) -> tuple[str, bool]:
    override = os.environ.get("HERMES_MODS_PYTHON")
    if override:
        candidate = str(Path(override).expanduser())
        if Path(candidate).is_file():
            return candidate, False
        if found := shutil.which(override):
            return found, False
    if core and (core / ".venv" / "bin" / "python").is_file():
        return str(core / ".venv" / "bin" / "python"), False
    if production := production_python(core):
        return production, False
    return sys.executable, True


def find_python(core: Path | None) -> str:
    return select_python(core)[0]


def test_files(d: Path) -> list[Path]:
    found = set()
    for pat in ("test_*.py", "*_test.py", "tests_*.py"):
        for p in d.rglob(pat):
            if not {"node_modules", "__pycache__", ".git"} & set(p.parts):
                found.add(p)
    return sorted(found)


def has_tests(d: Path) -> bool:
    return bool(test_files(d))


def discover(root: Path, core: Path | None, explicit_core: bool) -> list[dict]:
    suites = []
    top = root / "tests"
    if top.is_dir():
        guards = [top / n for n in GUARD_TESTS if (top / n).is_file()]
        rest = [str(p) for p in test_files(top) if "integration_f3" not in p.parts and p not in guards]
        if rest:
            suites.append({"name": "tests", "dir": top, "args": ["--ignore=" + str(top / "integration_f3")],
                           "targets": rest})
        if guards:
            suites.append({"name": GUARD_SUITE, "dir": top, "args": [], "targets": [str(p) for p in guards]})
        f3 = top / "integration_f3"
        if f3.is_dir():
            if core:
                suites.append({"name": "tests/integration_f3", "dir": f3, "args": ["--hermes-core", str(core), "--confcutdir", str(f3)],
                               "targets": [str(f3)]})
            else:
                suites.append({"name": "tests/integration_f3", "dir": f3,
                               "skip": "needs a core checkout: pass --hermes-core PATH or set HERMES_CORE_CHECKOUT"})
    for p in sorted((root / "plugins").iterdir()) if (root / "plugins").is_dir() else []:
        if p.is_dir() and has_tests(p):
            suites.append({"name": f"plugins/{p.name}", "dir": p, "args": [], "targets": [str(f) for f in test_files(p)]})
    for p in sorted((root / "tools").iterdir()) if (root / "tools").is_dir() else []:
        if p.is_dir() and has_tests(p):
            suites.append({"name": f"tools/{p.name}", "dir": p, "args": [], "targets": [str(f) for f in test_files(p)]})
    # Skill tests (skills/<cat>/<name>/scripts/test_*.py, .../tests/test_*.py): one suite per skill dir
    # (the dir holding SKILL.md), named by its path so `-k <skill>` selects it. They are mostly stdlib
    # unittest modules that put their own dir on sys.path; pytest collects those unchanged.
    skills = root / "skills"
    for md in sorted(skills.rglob("SKILL.md")) if skills.is_dir() else []:
        p = md.parent
        if {"node_modules", "__pycache__", ".git"} & set(p.parts):
            continue
        files = test_files(p)
        if files:
            suites.append({"name": p.relative_to(root).as_posix(), "dir": p, "args": [],
                           "targets": [str(f) for f in files]})
    for s in suites:
        s.update(SUITE_OVERRIDES.get(s["name"], {}))
        if s.get("needs_core") and not core and not s.get("skip"):
            s["skip"] = "needs a core checkout: pass --hermes-core PATH or set HERMES_CORE_CHECKOUT"
    return suites


def run_suite(s: dict, py: str, core: Path | None, timeout: int, root: Path = ROOT, site: Path | None = None, uv: str | None = None) -> dict:
    res = {"name": s["name"], "status": "", "rc": None, "secs": 0.0, "tail": "", "reason": s.get("skip", ""),
           "passed": 0, "failed": 0, "errors": 0, "skipped": 0}
    if s.get("skip"):
        res["status"] = "SKIP"
        return res
    site = site or test_site(py)
    env = {k: v for k, v in os.environ.items() if not k.startswith(SCRUB_ENV_PREFIXES)}
    env["HERMES_DISABLE_LAZY_INSTALLS"] = "1"  # core's bootstrap otherwise re-execs the interpreter: silent exit 1
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    # cwd is the repo root (as in CI), so `from plugins.<name> import ...` resolves; each suite
    # still gets its own process, so same-named test modules in different plugins never collide.
    use_core = bool(core) and not s.get("no_core_path")
    env["PYTHONPATH"] = os.pathsep.join(filter(None, [str(root), str(core) if use_core else "", str(site) if not s.get("no_core_path") else ""]))
    hub = next((c for c in (root.parent / "hermes-hub", root.parent / "hub") if (c / "client/hermes_hub.py").is_file()), None)
    if hub:
        env.setdefault("HERMES_HUB_CLIENT_REAL", str(hub / "client/hermes_hub.py"))
    if core:
        env.setdefault("HERMES_CORE_CHECKOUT", str(core))
        # chat-closeout's core-backed tests skip unless this names a core checkout. Always the core this run
        # selected, never an inherited value, so those tests exercise the core that PYTHONPATH imports.
        env["HERMES_CORE_SOURCE"] = str(core)
    cwd = root / s["cwd"] if s.get("cwd") else root
    cmd = [x.replace("{py}", shlex.quote(py) if s["cmd"][0] == "sh" else py).replace("{core}", str(core or "")).replace("{site}", str(site)) for x in s["cmd"]] if s.get("cmd") else \
        [py, "-m", "pytest", "-q", "-p", "no:cacheprovider", "--rootdir", str(s["dir"]), *s["args"], *s["targets"]]
    t0 = time.time()
    if cmd[0] == 'uv':
        if not uv:
            res.update(status='FAIL', reason='executable not found: uv')
            return res
        cmd[0] = uv
    try:
        cp = subprocess.run(cmd, cwd=cwd, env=env, text=True, errors="replace", timeout=timeout,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
        out, rc = cp.stdout or "", cp.returncode
    except OSError as e:
        res.update(status='FAIL', reason=f"cannot execute {cmd[0]}: {e.strerror}")
        return res
    except subprocess.TimeoutExpired as e:
        out = (e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else e.stdout) or ""
        rc = None
        res["status"] = "TIMEOUT"
        res["reason"] = f"no result within {timeout}s"
    res["secs"] = time.time() - t0
    res["rc"] = rc
    lines = [ln for ln in out.splitlines() if ln.strip()]
    res["tail"] = "\n".join(lines if s.get("show_output") else lines[-40:])
    res.update(counts(out))
    if res["status"]:
        return res
    summarized = bool(SUMMARY_RE.search(out))
    if rc == 0:
        res["status"] = "PASS"
    elif rc == 5:
        res["status"] = "PASS"
        res["reason"] = "no tests collected"
    elif not summarized:
        res["status"] = "SILENT-EXIT"
        res["reason"] = (f"exit {rc} with no pytest summary: the process died or exited during collection "
                         "(e.g. a module-level sys.exit/os.exec); output tail below")
    else:
        res["status"] = "FAIL"
    return res


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-k", dest="match", action="append", default=[], help="only suites whose name contains this")
    ap.add_argument("-j", dest="jobs", type=int, default=4)
    ap.add_argument("--timeout", type=int, default=1500, help="per-suite seconds (default 1500)")
    ap.add_argument("--hermes-core", dest="core")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--exact", action="store_true",
                    help="-k names whole suites (as printed by --list), and repo-guards is not added")
    ap.add_argument("--json", dest="json_out", help="also write per-suite results (status, counts, tail) here")
    ap.add_argument("--root", default=str(ROOT), help=argparse.SUPPRESS)  # tests point this at a fixture tree
    a = ap.parse_args(argv)

    root = Path(a.root).resolve()
    core, explicit_core = find_core(a.core)
    py, fallback = select_python(core)
    suites = discover(root, core, explicit_core=explicit_core)
    if a.match and a.exact:
        unknown = sorted(set(a.match) - {s["name"] for s in suites})
        if unknown:
            print("test-all: no such suite(s): " + ", ".join(unknown), file=sys.stderr)
            return 2
        suites = [s for s in suites if s["name"] in a.match]
    elif a.match:
        picked = [s for s in suites if any(m in s["name"] for m in a.match)]
        guards = next((s for s in suites if s["name"] == GUARD_SUITE), None)
        if picked and guards and guards not in picked:
            picked.append(guards)
        suites = picked
    if a.list:
        for s in suites:
            print(s["name"] + (f"  [skip: {s['skip']}]" if s.get("skip") else ""))
        return 0
    if not suites:
        print("test-all: no suites matched", file=sys.stderr)
        return 2
    version = python_version(py)
    floor = core_python_floor(core)
    if fallback and floor and tuple(int(p) for p in version.split(".")[:2]) < floor:
        # Running anyway reports dozens of ModuleNotFoundError failures that say nothing about the mods.
        want = ".".join(map(str, floor))
        print(f"test-all: refusing fallback python={py} ({version}): core={core} installs its runtime "
              f"dependencies only for Python >= {want}, so every suite importing core would fail on a missing "
              f"module, not on the mods. Set HERMES_MODS_PYTHON to a Python >= {want} (e.g. `uv python install "
              f"{want}` then HERMES_MODS_PYTHON=$(uv python find {want})), or pass a core with a .venv.",
              file=sys.stderr, flush=True)
        return 2
    uv = find_uv()
    site = ensure_test_site(py, core, uv) if any(not s.get("skip") for s in suites) else test_site(py)
    warning = f"NOT the production interpreter ({version})" if fallback else ""
    print(f"test-all: {len(suites)} suites, -j{a.jobs}, python={py} ({version}), core={core}", flush=True)
    if warning:
        print(warning, flush=True)

    results = []
    with cf.ThreadPoolExecutor(max_workers=max(1, a.jobs)) as ex:
        futs = [ex.submit(run_suite, s, py, core, a.timeout, root, site, uv) for s in suites]
        for f in cf.as_completed(futs):
            r = f.result()
            results.append(r)
            print(f"  {r['status']:<11} {r['name']}  ({r['secs']:.0f}s)", flush=True)

    results.sort(key=lambda r: r["name"])
    bad = [r for r in results if r["status"] not in ("PASS", "SKIP")]
    for r in bad:
        print(f"\n=== {r['status']}: {r['name']} (exit {r['rc']}) ===")
        if r["reason"]:
            print(r["reason"])
        print(r["tail"])
    for r in results:
        if r["status"] == "PASS" and SUITE_OVERRIDES.get(r["name"], {}).get("show_output"):
            print(f"\n=== {r['name']} ===\n{r['tail']}")
        if r["status"] == "SKIP":
            print(f"skipped {r['name']}: {r['reason']}")
    counts = {k: sum(1 for r in results if r["status"] == k) for k in ("PASS", "SKIP", "FAIL", "SILENT-EXIT", "TIMEOUT")}
    print("\ntest-all: " + ", ".join(f"{v} {k}" for k, v in counts.items() if v)
          + (" -- FAILED: " + ", ".join(r["name"] for r in bad) if bad else " -- OK"))
    if warning:
        print(warning)
    if a.json_out:
        Path(a.json_out).write_text(json.dumps({"python": version, "core": str(core) if core else None,
                                                "suites": results}, indent=2) + "\n")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
